# -----------------------------------------------------------------------------
# Bounded fuzzy file search
# -----------------------------------------------------------------------------

# Search is lazy: sourcing this peer only defines state and functions. A public
# workspace search captures one bounded snapshot, and picker refinement thereafter
# performs no filesystem access or subprocess work.
typeset -g ZSH_FILE_SEARCH_MAX_RESULTS=${ZSH_FILE_SEARCH_MAX_RESULTS:-10}
typeset -g ZSH_FILE_SEARCH_MAX_VISITED=${ZSH_FILE_SEARCH_MAX_VISITED:-20000}
typeset -g ZSH_FILE_SEARCH_MAX_CANDIDATES=${ZSH_FILE_SEARCH_MAX_CANDIDATES:-2000}
typeset -ga _FILE_SEARCH_VALUES=()
typeset -ga _FILE_SEARCH_LABELS=()
typeset -ga _FILE_SEARCH_MATCH_TEXTS=()
typeset -ga _FILE_SEARCH_RANKS=()
typeset -gA _FILE_SEARCH_SEEN=()
typeset -g _FILE_SEARCH_LITERAL_QUERY=''
typeset -g _FILE_SEARCH_LITERAL_FILTER_PATTERN=''
typeset -g _FILE_SEARCH_FILTER_PATTERN=''
typeset -g _FILE_SEARCH_ROOT=''
typeset -g _FILE_SEARCH_SOURCE=''
typeset -gi _FILE_SEARCH_TRUNCATED=0
typeset -gi _FILE_SEARCH_VISITED=0


_file_search_compile_query() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local query=$1
  local -a reply=()
  _FILE_SEARCH_LITERAL_QUERY=''
  _FILE_SEARCH_LITERAL_FILTER_PATTERN=''
  _FILE_SEARCH_FILTER_PATTERN=''

  (( ${+functions[_matching_compile_fragments]} )) || return 1
  _matching_compile_fragments "$query"
  _FILE_SEARCH_LITERAL_QUERY=$reply[1]
  # Files handles empty queries before collection. A whitespace-only filter
  # retains its existing whole-literal behavior without adding a broad tier.
  if [[ -n ${query//[$' \t\n']/} ]]; then
    _FILE_SEARCH_LITERAL_FILTER_PATTERN=$reply[2]
    _FILE_SEARCH_FILTER_PATTERN=$reply[3]
  elif [[ -n ${_file_search_capture_exclude:-} ]]; then
    _FILE_SEARCH_FILTER_PATTERN='(#i)*'
  fi
  return 0
}

# Return a stable relevance tier through REPLY: basename prefix, complete
# literal path, unordered literal fragments, then character-ordered fragments.
_file_search_match_rank() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local text=$1 basename=${1:t} exclusion_pattern=${_file_search_capture_exclusion_pattern:-*}
  REPLY=0
  [[ $text == ${~exclusion_pattern} ]] || return 1

  if [[ -n $_FILE_SEARCH_LITERAL_QUERY &&
        $basename == (#i)${~_FILE_SEARCH_LITERAL_QUERY}* ]]; then
    REPLY=1
    return 0
  fi
  if [[ -n $_FILE_SEARCH_LITERAL_QUERY &&
        $text == (#i)*${~_FILE_SEARCH_LITERAL_QUERY}* ]]; then
    REPLY=2
    return 0
  fi

  if [[ -n $_FILE_SEARCH_LITERAL_FILTER_PATTERN &&
        $text == ${~_FILE_SEARCH_LITERAL_FILTER_PATTERN} ]]; then
    REPLY=3
    return 0
  fi

  [[ -n $_FILE_SEARCH_FILTER_PATTERN && $text == ${~_FILE_SEARCH_FILTER_PATTERN} ]] || return 1
  REPLY=4
}

_file_search_reset() {
  typeset -ga _FILE_SEARCH_VALUES=()
  typeset -ga _FILE_SEARCH_LABELS=()
  typeset -ga _FILE_SEARCH_MATCH_TEXTS=()
  typeset -ga _FILE_SEARCH_RANKS=()
  typeset -gA _FILE_SEARCH_SEEN=()
  _FILE_SEARCH_TRUNCATED=0
  _FILE_SEARCH_VISITED=0
}

# Validate settings as text: at most nine digits never wraps in arithmetic and
# keeps the walk's `Y` glob count below 2^31.
_file_search_limit() {
  local raw_value=$1 fallback=$2
  if [[ $raw_value == <-> && ${#raw_value} -le 9 ]] && (( raw_value > 0 )); then
    REPLY=$raw_value
  else
    REPLY=$fallback
  fi
}

_file_search_consider() {
  emulate -L zsh

  local path=$1 display=$2 match_text=$3 label='' kind=''
  local -i max_candidates=2000 rank=0
  [[ -n $path && -z ${_FILE_SEARCH_SEEN[$path]-} ]] || return 1
  [[ -f $path || -d $path || -L $path ]] || return 1

  _file_search_match_rank "$match_text" || return 1
  rank=$REPLY
  _file_search_limit "${ZSH_FILE_SEARCH_MAX_CANDIDATES:-2000}" 2000
  max_candidates=$REPLY
  if (( ${#_FILE_SEARCH_VALUES} >= max_candidates )); then
    _FILE_SEARCH_TRUNCATED=1
    return 2
  fi

  if [[ -L $path ]]; then
    kind='↗'
  elif [[ -d $path ]]; then
    kind='▸'
    display=${display%/}/
  else
    kind='·'
  fi
  label="$kind $display"
  _FILE_SEARCH_VALUES+=("$path")
  _FILE_SEARCH_LABELS+=("$label")
  _FILE_SEARCH_MATCH_TEXTS+=("$match_text")
  _FILE_SEARCH_RANKS+=($rank)
  _FILE_SEARCH_SEEN[$path]=1
}

_file_search_sort_matches() {
  emulate -L zsh

  local -a values=("${_FILE_SEARCH_VALUES[@]}")
  local -a labels=("${_FILE_SEARCH_LABELS[@]}")
  local -a texts=("${_FILE_SEARCH_MATCH_TEXTS[@]}")
  local -a ranks=("${_FILE_SEARCH_RANKS[@]}")
  local -i rank=0 index=0
  typeset -ga _FILE_SEARCH_VALUES=()
  typeset -ga _FILE_SEARCH_LABELS=()
  typeset -ga _FILE_SEARCH_MATCH_TEXTS=()
  typeset -ga _FILE_SEARCH_RANKS=()

  for rank in 1 2 3 4; do
    for (( index = 1; index <= ${#values}; ++index )); do
      (( ranks[index] == rank )) || continue
      _FILE_SEARCH_VALUES+=("${values[index]}")
      _FILE_SEARCH_LABELS+=("${labels[index]}")
      _FILE_SEARCH_MATCH_TEXTS+=("${texts[index]}")
      _FILE_SEARCH_RANKS+=($rank)
    done
  done
}

# Git discovery belongs to the displayed folder. Keep inherited repository
# selectors and configured monitor hooks from redirecting or executing a read.
_file_search_git() {
  emulate -L zsh
  local root=$1 git_binary=${commands[git]:-}
  shift
  [[ -n $git_binary ]] || return 127
  local GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
  local GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
  unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
  local -x GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 GIT_ALLOW_PROTOCOL=''
  command "$git_binary" -C "$root" -c core.fsmonitor=false "$@"
}

# Hand a provider's NUL-terminated stream on stdin to a handler in batches of
# complete records. `read -d ''` costs one read(2) per byte on a pipe; sysread
# takes up to <size> bytes and the split happens in memory, so memory stays
# bounded by one read plus a cut-off record. Providers end the stream with an
# empty record and then their NUL-terminated exit status, and a record cut off
# at the end is never handed on.
# Usage: _file_search_stream <size> <handler> [handler-arguments...]
# The handler receives its arguments, then the batch, and stops the stream by
# returning nonzero. Returns 0 when the stream ended with status 0, 1 when the
# handler stopped it, and 2 otherwise.
_file_search_stream() {
  emulate -L zsh

  [[ $1 == <1-1048576> ]] || return 2
  zmodload -F zsh/system b:sysread || return 2
  local -i size=$1 index=0 trailer=0
  local chunk='' carry='' empty=''
  local -a records=()
  shift
  while sysread -s $size chunk; do
    chunk=$carry$chunk
    records=("${(@0)chunk}")
    carry=$records[-1]
    records[-1]=()
    if (( !trailer )); then
      index=${records[(ie)$empty]}
      if (( index > 1 )); then
        "$@" "${(@)records[1,index-1]}" || return 1
      fi
      (( index <= ${#records} )) || continue
      trailer=1
      records=("${(@)records[index+1,-1]}")
    fi
    (( ${#records} )) || continue
    [[ $records[1] == 0 ]] && return 0
    return 2
  done
  return 2
}

# One batch of Git paths relative to the root. Returns 1 at the candidate cap.
# The `visited` folder map belongs to _file_search_capture_git and spans
# batches; without it a path subscript would be arithmetic, so stop instead.
_file_search_git_batch() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  [[ ${(t)visited-} == association* ]] || return 1
  local root=$1 relative='' parent=''
  shift
  for relative in "${(@M)@:#${~_FILE_SEARCH_FILTER_PATTERN}}"; do
    [[ $relative != /* ]] || continue
    _file_search_consider "$root/$relative" "$relative" "$relative"
    (( $? == 2 )) && return 1

    # Git lists only files, so derive their folders even when the exclusion
    # or a missing worktree file rejects the file itself: a folder is judged on
    # its own path. The prefilter stays sound because a file path contains its
    # ancestors' paths. A visited folder's ancestors were already walked.
    parent=${relative:h}
    while [[ $parent != . && -n $parent && -z ${visited[$parent]-} ]]; do
      visited[$parent]=1
      _file_search_consider "$root/$parent" "$parent" "$parent"
      (( $? == 2 )) && return 1
      parent=${parent:h}
    done
  done
  return 0
}

_file_search_capture_git() {
  emulate -L zsh

  local root=${1:A} query=$2
  local -i stream_status=0
  local -A visited=()
  [[ -d $root ]] || return 2
  _file_search_git "$root" rev-parse --is-inside-work-tree \
    >/dev/null 2>&1 || return 2

  _file_search_reset
  _file_search_compile_query "$query"
  _FILE_SEARCH_ROOT=$root
  _FILE_SEARCH_SOURCE=git
  _file_search_stream 65536 _file_search_git_batch "$root" < <(
    _file_search_git "$root" ls-files -z \
      --cached --others --exclude-standard 2>/dev/null
    # Empty paths cannot occur: terminate the NUL stream with its exit status.
    print -rn -- $'\0'"$?"$'\0' 2>/dev/null)
  stream_status=$?

  _file_search_sort_matches
  if (( stream_status == 2 )); then
    (( ${#_FILE_SEARCH_VALUES} )) && _FILE_SEARCH_TRUNCATED=1
    return 2
  fi
  (( ${#_FILE_SEARCH_VALUES} ))
}

_file_search_capture_local() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local root=${1:A} query=$2 directory='' entry='' relative=''
  local -a queue=()
  local -a entries=()
  local -i position=1 max_visited=20000 consider_status=0 stop=0
  local -i remaining=0 enumeration_limit=0
  [[ -d $root && -r $root && -x $root ]] || return 2

  _file_search_reset
  _file_search_compile_query "$query"
  _file_search_limit "${ZSH_FILE_SEARCH_MAX_VISITED:-20000}" 20000
  max_visited=$REPLY
  _FILE_SEARCH_ROOT=$root
  _FILE_SEARCH_SOURCE=local
  queue=("$root")

  while (( position <= ${#queue} && !stop )); do
    directory=${queue[position++]}
    [[ -d $directory && -r $directory && -x $directory ]] || continue
    remaining=$(( max_visited - _FILE_SEARCH_VISITED ))
    (( remaining > 0 )) || { _FILE_SEARCH_TRUNCATED=1; break; }
    enumeration_limit=$(( remaining + 1 ))
    # Y stops native enumeration after the remaining budget plus one
    # lookahead, avoiding a full allocation/sort for a saturated directory.
    entries=("$directory"/*(NDY$enumeration_limit))
    # `Y` stops before glob sorting. Restore deterministic order for the
    # bounded batch so paging and visible-slot selection remain stable.
    entries=("${(on)entries[@]}")
    for entry in "${entries[@]}"; do
      if (( _FILE_SEARCH_VISITED >= max_visited )); then
        _FILE_SEARCH_TRUNCATED=1
        stop=1
        break
      fi
      (( ++_FILE_SEARCH_VISITED ))
      # Repository metadata at any depth (a gitdir or a worktree/submodule
      # gitfile) counts as inspected but is never matched or queued.
      [[ ${entry:t} == .git ]] && continue
      relative=${entry#$root/}

      if [[ $relative == ${~_FILE_SEARCH_FILTER_PATTERN} ]]; then
        _file_search_consider "$entry" "$relative" "$relative"
        consider_status=$?
        (( consider_status == 2 )) && {
          stop=1
          break
        }
      fi
      [[ -d $entry && ! -L $entry ]] && queue+=("$entry")
    done
  done

  _file_search_sort_matches
  (( ${#_FILE_SEARCH_VALUES} ))
}

_file_search_spotlight_seed() {
  emulate -L zsh

  local query=$1 fragment='' seed=''
  local -a fragments=( ${=query} )
  for fragment in "${fragments[@]}"; do
    (( ${#fragment} > ${#seed} )) && seed=$fragment
  done
  REPLY=$seed
  [[ -n $seed ]]
}

# One batch of indexed paths for the resolved root (empty for no scope). The
# query matches the home-relative display text, so the batch is never
# prefiltered on raw paths; the text check runs before any filesystem check.
# Returns 1 at the candidate cap.
_file_search_spotlight_batch() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local root=$1 candidate='' resolved='' display=''
  shift
  for candidate in "$@"; do
    if [[ $candidate == $HOME ]]; then
      display='~'
    elif [[ $candidate == $HOME/* ]]; then
      display="~${candidate#$HOME}"
    else
      display=$candidate
    fi
    [[ $display == ${~_FILE_SEARCH_FILTER_PATTERN} ]] || continue
    [[ $candidate == /* && ( -e $candidate || -L $candidate ) ]] || continue
    resolved=${candidate:A}
    # `/` contains every absolute path; `$root/*` would become `//*` there.
    if [[ -n $root && $root != / && $resolved != $root && $resolved != $root/* ]]; then
      continue
    fi
    _file_search_consider "$candidate" "$display" "$display"
    (( $? == 2 )) && return 1
  done
  return 0
}

_file_search_capture_spotlight() {
  emulate -L zsh

  local raw_root=$1 query=$2 binary=${3:-${commands[mdfind]:-}}
  local root=''
  # `-name` consumes the seed as one argv value. Do not combine it with
  # `-literal`: macOS mdfind applies that mode to raw query expressions and
  # rejects the combination instead of producing filename results.
  local -a command_args=(-0)
  local -i stream_status=0
  [[ -n $binary && -x $binary ]] || return 2

  if [[ -n $raw_root ]]; then
    root=${raw_root:A}
    [[ -d $root ]] || return 2
  fi
  _file_search_spotlight_seed "$query" || return 2
  local seed=$REPLY
  [[ -n $root ]] && command_args+=(-onlyin "$root")
  command_args+=(-name "$seed")

  _file_search_reset
  _file_search_compile_query "$query"
  _FILE_SEARCH_ROOT=$root
  _FILE_SEARCH_SOURCE=spotlight
  _file_search_stream 65536 _file_search_spotlight_batch "$root" < <(
    command "$binary" "${command_args[@]}" 2>/dev/null
    print -rn -- $'\0'"$?"$'\0' 2>/dev/null)
  stream_status=$?

  _file_search_sort_matches
  if (( stream_status == 2 )); then
    (( ${#_FILE_SEARCH_VALUES} )) && _FILE_SEARCH_TRUNCATED=1
    return 2
  fi
  (( ${#_FILE_SEARCH_VALUES} ))
}

# Keep presentation labels separate from the exact path used for actions.
_file_search_picker_add_result() {
  emulate -L zsh
  local -i index=$1
  local value=${_FILE_SEARCH_VALUES[index]} label=${_FILE_SEARCH_LABELS[index]}
  if (( ${+_ZLE_PICKER_CONTEXTS} )) && [[ -n ${_ZLE_PICKER_CONTEXTS[$value]-} ]]; then
    label="${label%% *} ${value:t}"
    [[ ${_FILE_SEARCH_LABELS[index]} == '▸ '* ]] && label+=/
  fi
  _ZLE_PICKER_RESULTS+=("$value")
  _ZLE_PICKER_LABELS+=("$label")
  _ZLE_PICKER_RESULT_INDEXES+=(${#_ZLE_PICKER_RESULTS})
}

_file_search_picker_append_matches() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local pattern=$1 raw_limit=$2 field=$3 exclusion_pattern=$4
  local text='' candidate='' value=''
  local -i limit=$raw_limit index=0
  for (( index = 1; index <= ${#_FILE_SEARCH_VALUES}; ++index )); do
    text=${_FILE_SEARCH_MATCH_TEXTS[index]}
    [[ $text == ${~exclusion_pattern} ]] || continue
    candidate=$text
    [[ $field == basename ]] && candidate=${text:t}
    [[ $candidate == ${~pattern} ]] || continue
    value=${_FILE_SEARCH_VALUES[index]}
    (( ${_ZLE_PICKER_RESULTS[(Ie)$value]} )) && continue
    _file_search_picker_add_result $index
    (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  done
}

_file_search_picker_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local query=$1 raw_limit=$2
  local exclusion_pattern='*' REPLY=''
  if [[ -n ${_ZLE_PICKER_EXCLUDE:-} ]]; then
    (( ${+functions[_matching_exclusion]} )) || return 1
    _matching_exclusion "$_ZLE_PICKER_EXCLUDE" || return
    exclusion_pattern=$REPLY
  fi
  local -i limit=$raw_limit index=0
  typeset -ga _ZLE_PICKER_RESULTS=()
  typeset -ga _ZLE_PICKER_LABELS=()
  typeset -ga _ZLE_PICKER_RESULT_INDEXES=()

  if [[ -z $query ]]; then
    for (( index = 1; index <= ${#_FILE_SEARCH_VALUES}; ++index )); do
      [[ ${_FILE_SEARCH_MATCH_TEXTS[index]} == ${~exclusion_pattern} ]] || continue
      _file_search_picker_add_result $index
      (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
    done
    return 0
  fi

  _file_search_compile_query "$query"
  _file_search_picker_append_matches \
    "(#i)${_FILE_SEARCH_LITERAL_QUERY}*" $limit basename "$exclusion_pattern"
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  _file_search_picker_append_matches \
    "(#i)*${_FILE_SEARCH_LITERAL_QUERY}*" $limit path "$exclusion_pattern"
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  _file_search_picker_append_matches \
    "$_FILE_SEARCH_LITERAL_FILTER_PATTERN" $limit path "$exclusion_pattern"
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  _file_search_picker_append_matches \
    "$_FILE_SEARCH_FILTER_PATTERN" $limit path "$exclusion_pattern"
}

# Format only facts already captured by the search. In particular, do not stat,
# resolve symlinks, read contents, or execute a result to populate its panel.
_file_search_inspector_capture() {
  emulate -L zsh
  local value='' label='' kind='' parent=''
  local -i index=0
  typeset -gA _ZLE_PICKER_INSPECT_TEXTS=()
  typeset -gA _ZLE_PICKER_CONTEXTS=()
  typeset -gA _ZLE_PICKER_ACCEPT_LABELS=()
  for value in "${_FILE_SEARCH_VALUES[@]}"; do
    (( ++index ))
    label=${_FILE_SEARCH_LABELS[index]}
    case $label in
      ('▸ '*) kind=Directory ;;
      ('↗ '*) kind='Symbolic link' ;;
      (*) kind=File ;;
    esac
    # A folder result inserts its path; only an explicit action changes directory.
    if [[ $kind == Directory ]]; then
      _ZLE_PICKER_ACCEPT_LABELS[$value]=insert
    else
      _ZLE_PICKER_ACCEPT_LABELS[$value]='file actions'
    fi
    parent=${label#* }
    [[ $parent == / ]] || parent=${parent%/}
    parent=${parent:h}
    [[ $parent == / ]] || parent+=/
    _ZLE_PICKER_CONTEXTS[$value]=$parent
    # One complete path; type is the only extra per-result fact. Scope belongs
    # to the picker header and actions to its footer, rather than every preview.
    _ZLE_PICKER_INSPECT_TEXTS[$value]="$kind"$'\n\n  '"${(V)value}"
  done
  return 0
}

# The action menu is another shared picker. Its tiny caller-owned catalog is
# filtered in memory; dispatch happens only after the line editor is closed.
_file_search_actions_collect() {
  (( ${+functions[_zle_ui_collect]} )) || {
    _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
    return 1
  }
  _zle_ui_collect source "$1" "$2" _file_action_values _file_action_labels \
    _file_action_labels "" text source
}

_file_search_actions() {
  _zle_ui_view action _file_search_actions_view "$@"
}

_file_search_actions_view() {
  emulate -L zsh
  _ZLE_PICKER_QUERY_LABEL='Filter actions'
  local selected=$1 clipboard_binary=$2 open_binary=$3 kind=File
  local -a _file_action_values=() _file_action_labels=()
  _ZLE_PICKER_INSPECT_TITLE=Action _ZLE_PICKER_INSPECT_ACTION=apply
  _ZLE_PICKER_SUBTITLE=${selected:t}
  local action='' label='' detail='' accept='' display_path=${(V)selected}
  local -i can_open=0 can_enter=0 can_reveal=0 can_copy=0
  local -a reply=()
  _ZLE_PICKER_ACTION_CONTEXT="TARGET"$'\n'"$selected"
  if [[ -L $selected ]]; then
    kind='Symbolic link'
    [[ -d $selected ]] && can_enter=1
  fi
  [[ -n $open_binary ]] && (( ${+functions[_compozsh_effect_open]} )) && can_reveal=1
  (( can_reveal )) && [[ -f $selected || -d $selected ]] && can_open=1
  [[ -n $clipboard_binary ]] && (( ${+functions[_compozsh_effect_copy]} )) && can_copy=1
  _zle_ui_path_actions $can_open $can_reveal $can_copy $can_enter 'Copy path' \
    enter-link open reveal copy insert
  for action label detail accept in "${reply[@]}"; do
    _file_action_values+=("$action") _file_action_labels+=("$label")
    _ZLE_PICKER_INSPECT_TEXTS[$action]="$kind"$'\n\n'"$detail"$'\n\n  '"$display_path"
    _ZLE_PICKER_DESCRIPTIONS[$action]=$detail
    _ZLE_PICKER_ACCEPT_LABELS[$action]=$accept
  done
  _ZLE_PICKER_TITLE='File actions'
  _ZLE_PICKER_BROWSE_LABEL=$kind
  _ZLE_PICKER_EMPTY_LABEL='no matching actions'
  _ZLE_PICKER_COLLECTOR=_file_search_actions_collect
  if (( ${_ZLE_PICKER_SESSION:-0} )); then
    _zle_picker_loop '' 10
  else
    _zle_picker_run 10
  fi
}

# The editor's post-cleanup dispatcher calls this for the actions that depend on
# a captured type. Check mutable filesystem facts again at the action boundary;
# never feed a selected path to a shell interpreter. A refused directory or open
# effect sets the caller's REPLY to stale or unavailable and prints nothing: the
# caller reports it after screen cleanup.
# Usage: _file_search_apply <directory|enter-link|open> <absolute-path> <open-binary>
_file_search_apply() {
  emulate -L zsh
  local action=$1 selected=$2 open_binary=$3
  local -i result=0
  REPLY=''
  [[ $selected == /* ]] || return 2
  case $action in
    (directory|enter-link)
      REPLY=stale
      [[ -d $selected && -x $selected &&
         ( $action == directory && ! -L $selected || $action == enter-link && -L $selected ) ]] || return 1
      REPLY=''
      builtin cd -- "$selected" || { result=$?; REPLY=stale; }
      return $result ;;
    (open)
      REPLY=unavailable
      (( ${+functions[_compozsh_effect_open]} )) || return 1
      _compozsh_effect_open open "$selected" "$open_binary" ;;
    (*) return 2 ;;
  esac
}


_file_search_candidate_summary() {
  local query=$1 noun=candidates
  (( ${#_FILE_SEARCH_VALUES} == 1 )) && noun=candidate
  REPLY="${#_FILE_SEARCH_VALUES} ${noun} for ${query}"
  (( _FILE_SEARCH_TRUNCATED )) && REPLY+=' · partial'
}

# Explicit workspace capture. The opened folder is always the scope, including
# a subfolder of a repository; never silently widen it to the Git root.
_file_search_capture() {
  emulate -L zsh
  local root=$1 query=$2 provider=$3 _file_search_capture_exclude=${4:-}
  local _file_search_capture_exclusion_pattern='*' REPLY=''
  if [[ -n $_file_search_capture_exclude ]]; then
    (( ${+functions[_matching_exclusion]} )) || return 2
    _matching_exclusion "$_file_search_capture_exclude" || return 2
    _file_search_capture_exclusion_pattern=$REPLY
  fi
  _file_search_reset
  [[ -d $root && ( -n ${query//[[:space:]]/} || -n $_file_search_capture_exclude ) ]] || return 2
  case $provider in
    (local) _file_search_capture_local "$root" "$query" ;;
    (git) _file_search_capture_git "$root" "$query" ;;
    (spotlight) _file_search_capture_spotlight "$root" "$query" ;;
    (*) return 2 ;;
  esac
}

# Resolve once on explicit Search entry, never on startup or keystrokes. Broad
# macOS scopes stay index-backed even when mdfind is unavailable: the user may
# choose a walk explicitly, but a missing/failed index must not trigger one.
_file_search_default_provider() {
  emulate -L zsh
  local root=$1
  if (( ${+commands[git]} )) &&
     [[ $(_file_search_git "$root" rev-parse --is-inside-work-tree 2>/dev/null) == true ]]; then
    REPLY=git
  elif [[ $OSTYPE == darwin* && ( ${root:A} == ${HOME:A} || ${root:A} == / ) ]]; then
    REPLY=spotlight
  else
    REPLY=local
  fi
}

# Called only inside the filesystem workspace's owned screen. Query submission
# captures once; refinement and paging operate solely on that snapshot.
_file_search_choose() {
  emulate -L zsh
  local root=$1 query=${2:-} provider=${3:-auto} exclusion='' selected='' action='' kind=''
  if [[ $provider == auto ]]; then
    _file_search_default_provider "$root"
    provider=$REPLY
  fi
  local -i result=0 capture_status=0 refresh=1 _zle_picker_start_focus=0 return_focus=0
  local -a bookmark=('' 1 0)
  local _ZLE_PICKER_QUERY_LABEL='Filter results' _ZLE_PICKER_SEARCH_ACTION="search-$provider"
  local summary=''
  local _ZLE_PICKER_TITLE=Files _ZLE_PICKER_SUBTITLE="$provider · $root"
  local _ZLE_PICKER_INSPECT_TITLE=Path _ZLE_PICKER_INSPECT_ACTION=insert
  local _ZLE_PICKER_CANCEL_LABEL=back
  local -a _ZLE_PICKER_TRAIL=() _ZLE_PICKER_EMPTY_LINES=()
  local _ZLE_PICKER_INSPECT_FALLBACK=''
  local -A _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -a _FILE_SEARCH_VALUES=() _FILE_SEARCH_LABELS=() _FILE_SEARCH_MATCH_TEXTS=() _FILE_SEARCH_RANKS=()
  local -A _FILE_SEARCH_SEEN=()
  local _FILE_SEARCH_ROOT='' _FILE_SEARCH_SOURCE=''
  local _FILE_SEARCH_LITERAL_QUERY='' _FILE_SEARCH_LITERAL_FILTER_PATTERN='' _FILE_SEARCH_FILTER_PATTERN=''
  local -i _FILE_SEARCH_TRUNCATED=0 _FILE_SEARCH_VISITED=0
  if [[ -z $query ]]; then
    _files_read_query 'Search descendants' "$provider · $root" '' '' "$provider" || return $?
    query=$_ZLE_PICKER_SELECTED_VALUE exclusion=${_ZLE_PICKER_BOOKMARK[4]-}
  fi
  while true; do
    if (( refresh )); then
      if (( ${+functions[_zle_picker_capture]} )); then
        # The busy frame shows the submitted fields. Its display state ends
        # before the independent refinement filter over captured results.
        () {
          local _ZLE_PICKER_EXCLUDE=$exclusion
          local -i _ZLE_PICKER_EXCLUDE_SHOWN=$(( ${#exclusion} > 0 ))
          local -i _ZLE_PICKER_EXCLUDE_FOCUS=0
          _zle_picker_capture Files "$provider · $root" "$query" \
            _file_search_capture "$root" "$query" "$provider" "$exclusion"
        }
      else
        _file_search_capture "$root" "$query" "$provider" "$exclusion"
      fi
      capture_status=$?
      _file_search_candidate_summary "${query:-all}"
      summary=$REPLY
      [[ -n $exclusion ]] && summary+=" · exclude contains: $exclusion"
      (( capture_status == 2 )) && summary="Source failed or unavailable · $summary"
      _file_search_inspector_capture
      bookmark=('' 1 0)
      _zle_picker_start_focus=0
      refresh=0
    fi
    _ZLE_PICKER_TITLE=Files
    _ZLE_PICKER_BROWSE_LABEL=$summary
    _ZLE_PICKER_EMPTY_LABEL='no matching captured paths'
    _ZLE_PICKER_EMPTY_LINES=('No matching captured paths'
      'Ctrl-F edits the search; Ctrl-X chooses a source or another view.'
      'Search covers filenames/paths, not file contents.'
      'Spotlight may omit unindexed paths; filesystem walks are bounded.')
    (( capture_status == 2 )) && _ZLE_PICKER_EMPTY_LINES=(
      'The search source failed or is unavailable'
      'Check source availability and folder permissions; Ctrl-F retries.'
      'Ctrl-X lets you choose another source explicitly. No fallback scan ran.')
    _ZLE_PICKER_COLLECTOR=_file_search_picker_collect
    _ZLE_PICKER_DIGIT_SELECT=1
    _ZLE_PICKER_HIERARCHY_ENABLED=0
    _ZLE_PICKER_DIRECTORY_ACTIONS=0
    _ZLE_PICKER_COPY_ENABLED=$(( ${#_directory_browser_clipboard} > 0 ))
    _zle_picker_loop "${bookmark[1]}" "${ZSH_FILE_SEARCH_MAX_RESULTS:-10}" "${bookmark[2]}" "${bookmark[3]}" "${bookmark[4]-}" "${bookmark[5]:-0}" "${bookmark[6]:-0}"
    result=$?
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    bookmark=("${_ZLE_PICKER_BOOKMARK[@]}")
    return_focus=${_ZLE_PICKER_BOOKMARK_FOCUS:-0}
    _zle_picker_start_focus=$return_focus
    if [[ $_ZLE_PICKER_ACTION == "search-$provider" ]]; then
      _files_read_query 'Search descendants' "$provider · $root" "$query" "$exclusion" "$provider"
      result=$?
      (( result == 1 )) && continue
      (( result == 0 )) || return $result
      query=$_ZLE_PICKER_SELECTED_VALUE exclusion=${_ZLE_PICKER_BOOKMARK[4]-}
      refresh=1
      continue
    fi
    if [[ $_ZLE_PICKER_ACTION == actions ]]; then
      # Keep the selected object distinct from the search scope. Its captured
      # type controls menu intent; dispatch still rechecks mutable paths.
      kind=${_FILE_SEARCH_LABELS[${_FILE_SEARCH_VALUES[(Ie)$selected]}]}
      case $kind in
        ('▸ '*) kind=directory ;;
        ('↗ '*) kind=link ;;
        (*) kind=file ;;
      esac
      _directory_browser_actions "$selected" "$mode" "$kind"
      result=$?
      (( result == 1 )) && continue
      # Change directory keeps the captured promise of an ordinary folder:
      # the directory action rechecks that it has not become a link. Browse
      # rows and the current folder may be links and keep the plain cd.
      if (( result == 0 )) && [[ $kind == directory && $_ZLE_PICKER_SELECTED_VALUE == "$selected" &&
            ( $_ZLE_PICKER_ACTION == cd || $mode == cd && $_ZLE_PICKER_ACTION == select ) ]]; then
        _ZLE_PICKER_ACTION=directory
      fi
      return $result
    fi
    [[ $_ZLE_PICKER_ACTION == copy ]] && return 0
    kind=${_FILE_SEARCH_LABELS[${_FILE_SEARCH_VALUES[(Ie)$selected]}]}
    [[ $kind == '▸ '* ]] && { _ZLE_PICKER_ACTION=insert; return 0; }
    [[ -f $selected || -L $selected ]] || return 4
    _file_search_actions "$selected" "$_directory_browser_clipboard" "$_directory_browser_open"
    result=$?
    (( result == 1 )) && continue
    (( result == 0 )) || return $result
    action=$_ZLE_PICKER_SELECTED_VALUE
    _ZLE_PICKER_ACTION=$action
    _ZLE_PICKER_SELECTED_VALUE=$selected
    return 0
  done
}

# Search owns its scope and instructions; UI owns the query interaction.
_files_read_query() {
  _zle_ui_view query _files_query_content "$@"
}

_files_query_content() {
  local _ZLE_PICKER_TITLE=$1 _ZLE_PICKER_SUBTITLE=$2
  local _ZLE_PICKER_QUERY_LABEL='Search descendants'
  local -i _ZLE_PICKER_EXCLUSION_ENABLED=1 query_status=0
  local -a discovery=("${3:-}" 1 0 "${4:-}" 0 0)
  local _ZLE_PICKER_INSPECT_ACTION=search
  local _ZLE_PICKER_BROWSE_LABEL='Enter fragments, then press Return to search'
  local -a _ZLE_PICKER_EMPTY_LINES=(
    'Search descendants of the displayed folder'
    'Space-separated fragments may match in any order, case-insensitively.'
    'Each fragment may abbreviate characters in order. Example: net cli'
    'Ctrl-] edits Exclude contains: one case-insensitive literal phrase.'
    'Empty search plus an exclusion captures eligible paths without that phrase.'
    'Spotlight seeds filenames with the longest fragment; use recognizable text.'
    'Filesystem: 20,000 inspected entries; all sources: 2,000 captured matches.'
    'Unreadable/unindexed locations may be absent. Mounted drives may be slow.'
    'After capture, Filter results refines that snapshot. Ctrl-F edits the search.'
    'Ctrl-X in Browse or results chooses another discovery source.')
  while true; do
    _zle_picker_loop "$discovery[1]" 10 "$discovery[2]" "$discovery[3]" "${discovery[4]-}" "${discovery[5]:-0}" "${discovery[6]:-0}"
    query_status=$?
    (( query_status == 0 )) || return $query_status
    discovery=("${_ZLE_PICKER_BOOKMARK[@]}")
    if [[ ${5:-} == spotlight && -z ${discovery[1]//[[:space:]]/} ]]; then
      _ZLE_PICKER_BROWSE_LABEL='Spotlight needs positive filename text'
      _ZLE_PICKER_EMPTY_LINES=('Add filename text, or go Back and choose Search filesystem in Options.'
        'The source stays Spotlight; no fallback scan has run.')
      continue
    fi
    return 0
  done
}

:
