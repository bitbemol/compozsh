# -----------------------------------------------------------------------------
# Shell behaviour
# -----------------------------------------------------------------------------

setopt PROMPT_SUBST          # Expand variables in the prompt.
setopt INTERACTIVE_COMMENTS  # Allow comments at the command line.
setopt AUTO_CD               # Enter a directory by typing its path.
setopt AUTO_PUSHD            # Keep visited directories in a stack.
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt CORRECT               # Offer to correct a misspelled command.
setopt NO_BEEP
setopt NO_CLOBBER            # Refuse to overwrite non-empty files with >.
setopt CLOBBER_EMPTY         # Zsh 5.9: allow > to reuse an empty file.

# Share history across terminal windows. HISTSIZE and SAVEHIST always exist,
# so their limits come from Zsh, macOS /etc/zshrc or the local initializer;
# only the history file needs a default, for shells that skip global rc files.
HISTFILE=${HISTFILE:-${ZDOTDIR:-$HOME}/.zsh_history}
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_SAVE_NO_DUPS

# Let BSD/macOS tools color semantic output only when stdout is a terminal.
typeset -gx CLICOLOR=${CLICOLOR:-1}

:
