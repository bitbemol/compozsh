# Terminal color-scheme selection and coherent palette defaults.

# A local initializer may select `light` or `dark` explicitly. Automatic
# selection uses only passive terminal metadata: querying the terminal during
# startup can race with user input and leave delayed replies in ZLE's buffer.
(( ${+ZSH_COLOR_SCHEME} )) || typeset -g ZSH_COLOR_SCHEME=auto

# Classify COLORFGBG's final indexed-color field. The first 16 colors retain
# the conventional dark/light grouping; extended xterm colors use their
# standard cube or grayscale luminance. Terminal palettes remain customizable,
# so an explicit ZSH_COLOR_SCHEME is authoritative.
_appearance_scheme_from_color_index() {
  emulate -L zsh

  local -i index=$1 red=0 green=0 blue=0 cube=0 brightness=0
  local -a levels=(0 95 135 175 215 255)

  if (( index < 16 )); then
    case $index in
      0|1|2|3|4|5|6|8|9|12|13) REPLY=dark ;;
      *) REPLY=light ;;
    esac
    return
  elif (( index < 232 )); then
    cube=$(( index - 16 ))
    red=${levels[cube / 36 + 1]}
    green=${levels[(cube / 6) % 6 + 1]}
    blue=${levels[cube % 6 + 1]}
  else
    red=$(( 8 + (index - 232) * 10 ))
    green=$red
    blue=$red
  fi

  brightness=$(( (299 * red + 587 * green + 114 * blue) / 1000 ))
  (( brightness >= 128 )) && REPLY=light || REPLY=dark
}

_appearance_detect_color_scheme() {
  emulate -L zsh

  case ${ZSH_COLOR_SCHEME:l} in
    light|dark)
      REPLY=${ZSH_COLOR_SCHEME:l}
      return
      ;;
    auto)
      # COLORFGBG is a best-effort hint because indexed colors are customizable.
      # Its final field is the background index.
      local background=${COLORFGBG##*;}
      if [[ $background == <0-255> ]]; then
        _appearance_scheme_from_color_index "$background"
        return
      fi
      ;;
  esac

  # Preserve the established palette when detection is unavailable or an
  # initializer supplied an unsupported value.
  REPLY=dark
}

# Values recorded here were installed by a shipped peer, so the appearance
# peer may replace them regardless of load order. An empty record means the
# value came from the local initializer or was changed by the user.
typeset -gA _COMPOZSH_COLOR_MANAGED _COMPOZSH_COLOR_FALLBACKS

_appearance_apply_light_defaults() {
  emulate -L zsh

  local -A highlight_defaults=(
    alias              'fg=127,bold'
    global-alias       'fg=91,bold,underline'
    suffix-alias       'fg=130,bold'
    function           'fg=25,bold'
    builtin            'fg=30,bold'
    command            'fg=28,bold'
    directory          'fg=25,bold,underline'
    executable         'fg=28,bold,underline'
    symlink            'fg=126,underline'
    symlink-directory  'fg=91,bold,underline'
    hardlink           'fg=130,underline'
    file               'fg=240,underline'
    special-file       'fg=160,bold,underline'
    argument           'fg=236'
    option             'fg=25'
    keyword            'fg=94,bold'
    pipeline           'fg=127,bold'
    logical            'fg=160,bold'
    separator          'fg=240,bold'
    structure          'fg=58,underline'
    conditional        'fg=130'
    arithmetic         'fg=130,bold'
    redirection        'fg=25,bold'
    redirection-target 'fg=94,underline'
    assignment         'fg=61'
    string             'fg=58'
    variable           'fg=24'
    substitution       'fg=90'
    glob               'fg=95'
    history            'fg=161,bold'
    escape             'fg=23'
    number             'fg=130'
    comment            'fg=240'
    autosuggestion     'fg=243'
    picker-header       'fg=25,bold'
    picker-location     'fg=25'
    picker-query        'fg=231,bg=24,bold'
    picker-match        'fg=25,bold,underline'
    picker-index        'fg=30,bold'
    picker-selected     'fg=231,bg=25,bold'
    picker-selected-inactive 'fg=236,bg=250'
    picker-focus        'fg=25,bold'
    picker-text         'fg=236'
    picker-architecture 'fg=25,bold'
    picker-architecture-selected 'fg=231,bold'
    picker-size         'fg=130'
    picker-size-selected 'fg=229,bold'
    picker-error        'fg=160,bold'
    picker-error-selected 'fg=224,bold'
    picker-success      'fg=28,bold'
    picker-success-selected 'fg=120,bold'
    picker-muted        'fg=243'
    picker-empty        'fg=160,bold'
    review-added        'fg=236,bg=194'
    review-removed      'fg=236,bg=224'
    review-keyword      'fg=94,bold'
    review-string       'fg=58'
    review-number       'fg=130'
    review-comment      'fg=240'
    review-type         'fg=24'
    review-function     'fg=25'
    review-variable     'fg=24'
  )
  local -A prompt_defaults=(
    frame       240
    identity    24
    path        25
    project     240
    symbol      30
    success     28
    warning     130
    danger      160
    info        25
    detached    89
    duration    90
    environment 61
    jobs        130
    tool        25
    framework   90
    container   30
  )
  local -A output_defaults=(
    heading  25
    accent   24
    success  28
    warning  130
    error    160
    info     24
    muted    240
    match    127
    text     236
  )
  local -a completion_defaults=(
      'di=1;38;5;25' 'ln=38;5;126' 'so=38;5;30' 'pi=38;5;94'
      'ex=1;38;5;28' 'bd=1;38;5;160' 'cd=38;5;95'
      'or=1;4;38;5;160' 'mi=1;38;5;160'
      'su=1;38;5;231;48;5;160' 'sg=1;38;5;231;48;5;90'
      'tw=38;5;236;48;5;186' 'ow=38;5;231;48;5;160'
      'st=38;5;236;48;5;179' 'ca=1;38;5;94'
  )
  local lscolors_default=exfxgxdxcxbxbxhbhfadabdx
  local role='' key='' current=''

  typeset -gA ZSH_HIGHLIGHT_STYLES ZSH_PROMPT_COLORS ZSH_OUTPUT_COLORS
  for role in ${(k)highlight_defaults}; do
    key="highlight:$role"
    if (( ${+ZSH_HIGHLIGHT_STYLES[$role]} )); then
      current=${ZSH_HIGHLIGHT_STYLES[$role]}
      if (( !${+_COMPOZSH_COLOR_MANAGED[$key]} )) ||
         [[ -n ${_COMPOZSH_COLOR_MANAGED[$key]} &&
            $current != ${_COMPOZSH_COLOR_MANAGED[$key]} ]]; then
        _COMPOZSH_COLOR_MANAGED[$key]=''
      fi
    fi
    _COMPOZSH_COLOR_FALLBACKS[$key]=${highlight_defaults[$role]}
    if (( !${+ZSH_HIGHLIGHT_STYLES[$role]} )) ||
       [[ -n ${_COMPOZSH_COLOR_MANAGED[$key]} ]]; then
      ZSH_HIGHLIGHT_STYLES[$role]=${highlight_defaults[$role]}
      _COMPOZSH_COLOR_MANAGED[$key]=${highlight_defaults[$role]}
    fi
  done

  for role in ${(k)prompt_defaults}; do
    key="prompt:$role"
    if (( ${+ZSH_PROMPT_COLORS[$role]} )); then
      current=${ZSH_PROMPT_COLORS[$role]}
      if (( !${+_COMPOZSH_COLOR_MANAGED[$key]} )) ||
         [[ -n ${_COMPOZSH_COLOR_MANAGED[$key]} &&
            $current != ${_COMPOZSH_COLOR_MANAGED[$key]} ]]; then
        _COMPOZSH_COLOR_MANAGED[$key]=''
      fi
    fi
    _COMPOZSH_COLOR_FALLBACKS[$key]=${prompt_defaults[$role]}
    if (( !${+ZSH_PROMPT_COLORS[$role]} )) ||
       [[ -n ${_COMPOZSH_COLOR_MANAGED[$key]} ]]; then
      ZSH_PROMPT_COLORS[$role]=${prompt_defaults[$role]}
      _COMPOZSH_COLOR_MANAGED[$key]=${prompt_defaults[$role]}
    fi
  done

  for role in ${(k)output_defaults}; do
    key="output:$role"
    if (( ${+ZSH_OUTPUT_COLORS[$role]} )); then
      current=${ZSH_OUTPUT_COLORS[$role]}
      if (( !${+_COMPOZSH_COLOR_MANAGED[$key]} )) ||
         [[ -n ${_COMPOZSH_COLOR_MANAGED[$key]} &&
            $current != ${_COMPOZSH_COLOR_MANAGED[$key]} ]]; then
        _COMPOZSH_COLOR_MANAGED[$key]=''
      fi
    fi
    _COMPOZSH_COLOR_FALLBACKS[$key]=${output_defaults[$role]}
    if (( !${+ZSH_OUTPUT_COLORS[$role]} )) ||
       [[ -n ${_COMPOZSH_COLOR_MANAGED[$key]} ]]; then
      ZSH_OUTPUT_COLORS[$role]=${output_defaults[$role]}
      _COMPOZSH_COLOR_MANAGED[$key]=${output_defaults[$role]}
    fi
  done

  if [[ -n ${LS_COLORS:-} ]]; then
    typeset -gi _COMPOZSH_COMPLETION_COLORS_CUSTOM=1
  elif (( !${_COMPOZSH_COMPLETION_COLORS_CUSTOM:-0} )); then
    typeset -ga _COMPOZSH_COMPLETION_LIST_COLORS=("${completion_defaults[@]}")
    zstyle ':completion:*' list-colors "${_COMPOZSH_COMPLETION_LIST_COLORS[@]}"
  fi

  key=lscolors
  if (( ${+LSCOLORS} )); then
    current=$LSCOLORS
    if (( !${+_COMPOZSH_COLOR_MANAGED[$key]} )) ||
       [[ -n ${_COMPOZSH_COLOR_MANAGED[$key]} &&
          $current != ${_COMPOZSH_COLOR_MANAGED[$key]} ]]; then
      _COMPOZSH_COLOR_MANAGED[$key]=''
    fi
  fi
  _COMPOZSH_COLOR_FALLBACKS[$key]=$lscolors_default
  if (( !${+LSCOLORS} )) || [[ -n ${_COMPOZSH_COLOR_MANAGED[$key]} ]]; then
    typeset -gx LSCOLORS=$lscolors_default
    _COMPOZSH_COLOR_MANAGED[$key]=$LSCOLORS
  fi
  return 0
}

if (( !${+_COMPOZSH_COLOR_SCHEME} )); then
  _appearance_detect_color_scheme
  typeset -g _COMPOZSH_COLOR_SCHEME=$REPLY
fi
[[ $_COMPOZSH_COLOR_SCHEME == light ]] && _appearance_apply_light_defaults
:
