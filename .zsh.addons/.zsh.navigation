# -----------------------------------------------------------------------------
# Small conveniences
# -----------------------------------------------------------------------------

(( ${+aliases[..]} )) || alias ..='cd ..'
(( ${+aliases[...]} )) || alias ...='cd ../..'
(( ${+aliases[....]} )) || alias ....='cd ../../..'
(( ${+aliases[ll]} )) || alias ll='ls -lah'
(( ${+aliases[la]} )) || alias la='ls -A'

# Directory and branch selectors share the same bounded ZLE picker. Their
# source data is captured once before opening; refinement launches no commands.
typeset -g ZSH_NAVIGATION_PICKER_MAX_RESULTS=${ZSH_NAVIGATION_PICKER_MAX_RESULTS:-10}
typeset -ga _NAVIGATION_PICKER_VALUES=()
typeset -ga _NAVIGATION_PICKER_LABELS=()
typeset -ga _NAVIGATION_PICKER_INDEXES=()
typeset -ga _NAVIGATION_PICKER_SEARCH_LABELS=()

# Navigation remains usable without the prompt add-on. Keep these display
# helpers private to this unit so peer add-on order never becomes a dependency.
_navigation_sanitize() {
  REPLY=${1//[[:cntrl:]]/?}
}

_navigation_abbreviate() {
  local text=$1
  local -i max_width=$2 left_width=0 right_width=0

  if (( max_width <= 0 )); then
    REPLY=''
    return
  fi
  if (( ${#text} <= max_width )); then
    REPLY=$text
    return
  fi
  if (( max_width < 5 )); then
    REPLY='…'
    return
  fi

  left_width=$(( (max_width - 1) / 3 ))
  right_width=$(( max_width - 1 - left_width ))
  REPLY="${text[1,left_width]}…${text[-right_width,-1]}"
}

_navigation_picker_append_matches() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local pattern=$1 raw_limit=$2 value='' label=''
  local -i limit=$raw_limit index=0

  for (( index = 1; index <= ${#_NAVIGATION_PICKER_VALUES}; ++index )); do
    label=${_NAVIGATION_PICKER_LABELS[index]}
    [[ ${_NAVIGATION_PICKER_SEARCH_LABELS[index]:-$label} == ${~pattern} ]] || continue
    value=${_NAVIGATION_PICKER_VALUES[index]}
    (( ${_ZLE_PICKER_RESULTS[(Ie)$value]} )) && continue
    _ZLE_PICKER_RESULTS+=("$value")
    _ZLE_PICKER_LABELS+=("$label")
    _ZLE_PICKER_RESULT_INDEXES+=("${_NAVIGATION_PICKER_INDEXES[index]}")
    (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  done
}

# Rank literal prefix and substring matches before character-ordered fuzzy ones.
_navigation_picker_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local query=$1 raw_limit=$2 literal='' pattern=''
  local -a reply=()
  local -i limit=$raw_limit index=0
  typeset -ga _ZLE_PICKER_RESULTS=()
  typeset -ga _ZLE_PICKER_LABELS=()
  typeset -ga _ZLE_PICKER_RESULT_INDEXES=()

  if [[ -z $query ]]; then
    for (( index = 1; index <= ${#_NAVIGATION_PICKER_VALUES}; ++index )); do
      _ZLE_PICKER_RESULTS+=("${_NAVIGATION_PICKER_VALUES[index]}")
      _ZLE_PICKER_LABELS+=("${_NAVIGATION_PICKER_LABELS[index]}")
      _ZLE_PICKER_RESULT_INDEXES+=("${_NAVIGATION_PICKER_INDEXES[index]}")
      (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
    done
    return 0
  fi

  (( ${+functions[_matching_compile]} )) || return 1
  _matching_compile "$query"
  literal=$reply[1] pattern=$reply[2]
  _navigation_picker_append_matches "(#i)${literal}*" $limit
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  _navigation_picker_append_matches "(#i)*${literal}*" $limit
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0

  _navigation_picker_append_matches "$pattern" $limit
}

# The optional output peer validates colors at invocation; standalone stacks
# stay plain without a second palette or a source-time ordering dependency.
_navigation_color_style() {
  emulate -L zsh
  local role=$1
  REPLY=''
  [[ -t 1 && -n $TERM && $TERM != dumb && -z ${NO_COLOR:-} ]] || return 0
  (( ${+functions[_output_color]} )) || return 0
  zmodload -F zsh/terminfo p:terminfo 2>/dev/null || return 0
  (( ${terminfo[colors]:-0} >= 256 )) || return 0
  _output_color "$role" || return 0
  REPLY=$'\e[38;5;'"${REPLY}m"
}

# Fixed-width indexes keep selectors and targets clear beside long labels.
_stack_print_entry() {
  emulate -L zsh

  local index=$1 marker=$2 label=$3 index_style='' marker_style='' reset=''
  local marker_text='↳'
  local -i columns=${COLUMNS:-80} label_width=0
  (( columns > 0 )) || columns=80
  label_width=$(( columns - ${#index} - 5 ))
  (( label_width > 0 )) || label_width=1
  _navigation_sanitize "$label"
  label=$REPLY
  _navigation_abbreviate "$label" $label_width
  label=$REPLY

  _navigation_color_style accent
  index_style=$REPLY
  if [[ $marker == current ]]; then
    marker_text='●'
    _navigation_color_style success
  else
    _navigation_color_style muted
  fi
  marker_style=$REPLY
  [[ -n $index_style || -n $marker_style ]] && reset=$'\e[0m'
  print -r -- "${index_style}[${index}]${reset} ${marker_style}${marker_text}${reset} $label"
}

# Capture Zsh's native directory stack once for either the selector or the
# printable fallback. Indexes retain their standard ~0, ~1, ... meanings.
_directory_stack_capture() {
  emulate -L zsh

  local path='' display=''
  local -a entries=("$PWD" "${dirstack[@]}")
  local -i index=0
  _NAVIGATION_PICKER_VALUES=()
  _NAVIGATION_PICKER_LABELS=()
  _NAVIGATION_PICKER_INDEXES=()
  _NAVIGATION_PICKER_SEARCH_LABELS=()

  for path in "${entries[@]}"; do
    if [[ $path == $HOME || $path == $HOME/* ]]; then
      display="~${path#$HOME}"
    else
      display=$path
    fi
    _NAVIGATION_PICKER_VALUES+=("$path")
    _NAVIGATION_PICKER_LABELS+=("$display")
    _NAVIGATION_PICKER_INDEXES+=($index)
    (( ++index ))
  done
}

# A bounded snapshot of visited locations, not another filesystem browser.
# Short names aid recognition; matching retains the complete original paths.
_directory_stack_describe() {
  emulate -L zsh
  local value='' display='' name='' parent='' role='' availability='' kind=''
  local -i index=0
  _NAVIGATION_PICKER_SEARCH_LABELS=("${_NAVIGATION_PICKER_LABELS[@]}")
  for value in "${_NAVIGATION_PICKER_VALUES[@]}"; do
    (( ++index ))
    display=${_NAVIGATION_PICKER_SEARCH_LABELS[index]}
    name=${display:t}
    [[ $display == / ]] && name=/
    [[ $display == '~' ]] && name='~'
    [[ $name == / ]] || name+=/
    parent=${display:h}
    [[ $display == '~' ]] && parent=home
    [[ $display == / ]] && parent='filesystem root'
    role='visited'
    (( index == 1 )) && role=current
    (( index == 2 )) && role=previous
    availability='Not checked'
    kind='Stack entry · Not checked'
    # A huge user-managed stack must not cause unbounded filesystem probes.
    # Every path remains searchable; only the first 200 receive these facts.
    if (( index <= 200 )); then
      availability='Available'
      [[ -d $value && -x $value ]] || availability='Unavailable'
      kind=Directory
      [[ -L $value ]] && kind='Linked directory'
    fi
    _NAVIGATION_PICKER_LABELS[index]=$name
    _ZLE_PICKER_CONTEXTS[$value]="${role} · ${parent}"
    [[ $availability == Unavailable ]] && _ZLE_PICKER_CONTEXTS[$value]="unavailable · ${parent}"
    _ZLE_PICKER_INSPECT_TEXTS[$value]="${(C)role} location · ~${_NAVIGATION_PICKER_INDEXES[index]}"$'\n'"${kind}"
    if [[ $availability == Unavailable ]]; then
      _ZLE_PICKER_INSPECT_TEXTS[$value]+=$'\n\nUnavailable: checked when opened.'
    fi
    _ZLE_PICKER_INSPECT_TEXTS[$value]+=$'\n\n  '"${value}"
  done
}

# Recents is an explicit workspace view, never injected into child listings.
# Snapshot Zsh's native stack; it needs no separate directory history or scan.
_directory_recents_choose() {
  emulate -L zsh
  local _ZLE_PICKER_TITLE='Recent directories' _ZLE_PICKER_SUBTITLE='This shell · native directory stack'
  local _ZLE_PICKER_INSPECT_TITLE=Location _ZLE_PICKER_INSPECT_ACTION=${mode:-insert}
  local _ZLE_PICKER_CANCEL_LABEL=back
  local -a _NAVIGATION_PICKER_VALUES=() _NAVIGATION_PICKER_LABELS=()
  local -a _NAVIGATION_PICKER_INDEXES=() _NAVIGATION_PICKER_SEARCH_LABELS=()
  local -a _ZLE_PICKER_TRAIL=() _ZLE_PICKER_EMPTY_LINES=()
  local _ZLE_PICKER_INSPECT_FALLBACK=''
  local -A _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -a bookmark=("${_FILES_RECENTS_BOOKMARK[@]}")
  (( ${#bookmark} == 3 )) || bookmark=('' 1 0)
  local -i result=0
  _directory_stack_capture
  _directory_stack_describe
  while true; do
    _ZLE_PICKER_TITLE='Recent directories'
    _ZLE_PICKER_BROWSE_LABEL='this shell'
    _ZLE_PICKER_EMPTY_LABEL='no matching visited locations'
    _ZLE_PICKER_COLLECTOR=_navigation_picker_collect
    _ZLE_PICKER_DIGIT_SELECT=1
    _ZLE_PICKER_HIERARCHY_ENABLED=0
    _ZLE_PICKER_COPY_ENABLED=$(( ${#_directory_browser_clipboard} > 0 ))
    _ZLE_PICKER_DIRECTORY_ACTIONS=2
    _zle_picker_loop "${bookmark[1]}" "${ZSH_NAVIGATION_PICKER_MAX_RESULTS:-10}" "${bookmark[2]}" "${bookmark[3]}"
    result=$?
    (( result == 0 )) || return $result
    bookmark=("${_ZLE_PICKER_BOOKMARK[@]}")
    _FILES_RECENTS_BOOKMARK=("${bookmark[@]}")
    if [[ $_ZLE_PICKER_ACTION == actions ]]; then
      _directory_browser_actions '' "$mode"
      result=$?
      (( result == 1 )) && continue
      return $result
    fi
    # Keep the caller's acceptance intent: prompt entry inserts the same
    # editable, quoted path as Browse. Only submission at the prompt runs it.
    return 0
  done
}

# Build a most-recently-used list from Git's own checkout reflog. Keeping this
# derived avoids a second history file and also sees switches made by IDEs or
# other shells. Deleted branches and detached commit IDs are filtered out.
# Branch snapshots inspect local objects only. Keep these controls scoped to
# providers so explicit switching and transparent Git arguments retain semantics.
_git_branch_read() {
  emulate -L zsh
  local root=$1
  shift
  local -x GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0
  local -x GIT_ALLOW_PROTOCOL=''
  command git --no-pager --no-replace-objects -C "$root" \
    -c core.fsmonitor=false -c core.hooksPath=/dev/null \
    -c maintenance.auto=false -c gc.auto=0 "$@"
}

_git_recent_branches() {
  emulate -L zsh

  local root=$1 current='' refs='' ref_marker='' ref=''
  local subject='' transition='' from='' to='' candidate=''
  local -a local_branches=()
  local -A local_branch_set=() recent_branch_set=()
  typeset -ga _GIT_RECENT_BRANCHES=()
  typeset -g _GIT_RECENT_CURRENT=''

  refs=$(_git_branch_read "$root" for-each-ref \
    --format='%(HEAD)%09%(refname)' refs/heads/ 2>/dev/null) || return 1
  while IFS=$'\t' read -r ref_marker ref; do
    [[ $ref == refs/heads/* ]] || continue
    ref=${ref#refs/heads/}
    local_branches+=("$ref")
    local_branch_set[$ref]=1
    [[ $ref_marker == '*' ]] && current=$ref
  done <<< "$refs"

  [[ -n $current ]] && {
    _GIT_RECENT_BRANCHES+=("$current")
    recent_branch_set[$current]=1
    _GIT_RECENT_CURRENT=$current
  }
  (( ${#_GIT_RECENT_BRANCHES} == ${#local_branches} )) && return 0

  while IFS= read -r subject; do
    [[ $subject == 'checkout: moving from '*' to '* ]] || continue
    transition=${subject#checkout: moving from }
    from=${transition%% to *}
    to=${transition#* to }

    for candidate in "$to" "$from"; do
      [[ -n $candidate ]] || continue

      [[ -n ${local_branch_set[$candidate]-} ]] || continue
      [[ -z ${recent_branch_set[$candidate]-} ]] || continue
      _GIT_RECENT_BRANCHES+=("$candidate")
      recent_branch_set[$candidate]=1
    done

    (( ${#_GIT_RECENT_BRANCHES} == ${#local_branches} )) && break
  done < <(_git_branch_read "$root" reflog show --format='%gs' \
    --grep-reflog='^checkout: moving from ' --max-count=200 HEAD 2>/dev/null)

  # Local branches absent from the bounded checkout reflog are simply not
  # recent; a partial recency list is still a successful inspection.
  return 0
}

# Optional details use one bounded bulk read, never a Git call per selection.
# NUL fields preserve tabs in commit subjects and empty upstreams. An incomplete
# record (including a failed Git command) leaves the useful branch-only fallback.
_git_branch_inspector_capture() {
  emulate -L zsh
  local root=$1 branch='' state='' data='' ref='' upstream='' oid='' subject='' text=''
  local -a refs=()
  typeset -gA _ZLE_PICKER_INSPECT_TEXTS=()
  for branch in "${_GIT_RECENT_BRANCHES[@]}"; do
    state='Recent local branch'
    [[ $branch == "$_GIT_RECENT_CURRENT" ]] && state='Current branch'
    _ZLE_PICKER_INSPECT_TEXTS[$branch]="${(V)branch}"$'\n'"$state"$'\n\nCommit details unavailable (read limit or Git error).'
    refs+=("refs/heads/$branch")
  done
  (( ${#refs} )) || return 0
  # 200 checkout transitions yield at most 401 distinct recent branches.
  # The byte/character cap also bounds unusually large commit messages.
  IFS= read -r -u 0 -k 262144 data < <(_git_branch_read "$root" for-each-ref \
    --count=401 --format='%(refname)%00%(upstream:short)%00%(objectname:short)%00%(subject)%00' \
    "${refs[@]}" 2>/dev/null) || :
  while IFS= read -r -d '' ref && IFS= read -r -d '' upstream &&
        IFS= read -r -d '' oid && IFS= read -r -d '' subject; do
    ref=${ref#$'\n'}
    branch=${ref#refs/heads/}
    (( ${+_ZLE_PICKER_INSPECT_TEXTS[$branch]} )) || continue
    state='Recent local branch'
    [[ $branch == "$_GIT_RECENT_CURRENT" ]] && state='Current branch'
    (( ${#subject} > 512 )) && subject="${subject[1,512]}… [truncated]"
    text="${(V)branch}"$'\n'"$state"
    text+=$'\n\nLatest commit:\n  '"${(V)oid}"$'\n  '"${(V)subject}"
    text+=$'\n\nUpstream:\n  '"${(V)upstream:-not configured}"
    text+=$'\n\n  Enter switches to this branch.\n  Snapshot captured when g opened; no fetch.'
    _ZLE_PICKER_INSPECT_TEXTS[$branch]=$text
  done <<< "$data"
  return 0
}

# Resolve and populate the branch-picker context behind one Git boundary.
_git_branch_stack_load() {
  emulate -L zsh

  local root=''
  root=$(_git_branch_read "$PWD" rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 'g: not inside a Git working tree'
    return 1
  }
  _git_recent_branches "$root" || {
    print -u2 'g: could not inspect local branches'
    return 1
  }
  (( ${#_GIT_RECENT_BRANCHES} ||
     (${+functions[_git_review_branch_choose]} && ${+functions[_zle_picker_loop]}) )) || {
    print -u2 'g: this repository has no local branch history yet'
    return 1
  }
  REPLY=$root
}

# Copy a path or ref as inert stdin data. `pbcopy` is resolved by the caller so
# unsupported hosts never advertise or enter this action path.
_navigation_copy() {
  emulate -L zsh

  local value=$1 clipboard_binary=$2 noun=$3 owner=$4 display=''
  [[ -n $clipboard_binary && -x $clipboard_binary ]] || {
    print -u2 -r -- "$owner: clipboard support is unavailable on this host"
    return 1
  }
  print -rn -- "$value" | command "$clipboard_binary" || {
    print -u2 -r -- "$owner: could not copy the selected $noun"
    return 1
  }
  _navigation_sanitize "$value"
  display=$REPLY
  print -r -- "Copied $noun ${display}."
}

_git_branch_stack_print() {
  emulate -L zsh

  local branch='' marker='recent' heading_style='' reset=''
  local -i index=0

  _navigation_color_style heading
  heading_style=$REPLY
  [[ -n $heading_style ]] && reset=$'\e[0m'
  print -r -- "${heading_style}Branch stack${reset}"
  for branch in "${_GIT_RECENT_BRANCHES[@]}"; do
    marker='recent'
    [[ $branch == $_GIT_RECENT_CURRENT ]] && marker='current'
    _stack_print_entry $index "$marker" "$branch"
    (( ++index ))
  done
}

# Keep ordinary Git arguments transparent; --review, --worktree, --discard-all and --help
# invocations are Compozsh modes. Bare g opens the recent-branch picker.
_compozsh_template_g() { REPLY=git-review; }

_compozsh_help_g() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: g [git-arguments ...]' \
    'Open branches, review changes, manage worktrees, discard edits, or run Git.' \
    '' \
    'Options:' \
    '  --review [base head]  Open read-only review; optionally compare two local refs.' \
    '  --review --merge-base <base> <head>  Compare their common ancestor to head.' \
    '  --worktree  Create, enter, move, or remove a linked worktree.' \
    '  --discard-all  Preview and confirm loss of tracked edits and untracked files.' \
    '  --help  Read this guide without inspecting or changing a repository.' \
    '  Other arguments retain native Git syntax; use git --help for that reference.' \
    '' \
    'Discard all changes:' \
    '  g --discard-all requires .zsh.tools and accepts no extra action arguments.' \
    '  g --discard-all --help shows this complete guide without reads or writes.' \
    '  Operates from this folder’s repository root, including from a subfolder.' \
    '  Inherited Git directory/index/object selectors cannot redirect this task.' \
    '  Restores tracked files and the index to HEAD, discarding both staged' \
    '  and unstaged edits, then deletes untracked files and directories.' \
    '  Prints Git status before asking [y/N]; only y or Y confirms.' \
    '  With shared UI in an interactive terminal, confirmation uses a scoped' \
    '  screen and a bounded status inspector. Empty Return or Escape cancels.' \
    '  The complete status remains in scrollback. Without UI, confirmation is plain.' \
    '  Empty Return or any other answer cancels. No force/yes option is provided.' \
    '  A clean working tree needs no confirmation and returns success.' \
    '' \
    'Safety and limitations:' \
    '  Keeps ignored files, commits, stashes, nested repositories, and' \
    '  submodule contents. Refuses a repository with no HEAD commit or an' \
    '  active merge, rebase, cherry-pick, revert, or bisect operation.' \
    '  Repository content filters, hooks, filesystem monitors, lazy fetches,' \
    '  and required-filter enforcement are disabled for inspection/restore.' \
    '  After confirmation, the target, HEAD, operation, filter names, and' \
    '  listed path states are revalidated before any change is applied.' \
    '  Discarded work has no automatic backup or rollback. If a later step' \
    '  fails, earlier changes can already have been applied; inspect status.' \
    '  Remaining nested-repository/submodule changes are reported as failure.' \
    '  Requires Git. Cancellation or failure returns nonzero.' \
    '  --help shows this guide without inspecting or modifying a repository.' \
    '' \
    'Examples:' \
    '  g --discard-all              Preview and confirm repository-wide loss.' \
    '  git stash --include-untracked  Use instead to save work for later.' \
    '' \
    'Worktrees:' \
    '  g --worktree opens the worktree workspace.' \
    '  Requires .zsh.git-worktree; g worktree ... still delegates to Git.' \
    '  Run inside a working tree with a commit. Scope is its one repository,' \
    '  including all registered linked worktrees. No global directory scan.' \
    '  The main menu offers Create, Enter, Move / rename, Remove and Refresh.' \
    '  Each action opens its own fuzzy choices. Enter worktree lists captured' \
    '  checkouts with details; accepting one changes this shell to its folder.' \
    '  Create worktree chooses New branch or Existing local branch.' \
    '  New defaults to the captured current HEAD commit; local edits stay put.' \
    '  Existing offers all captured local branches unused by a worktree,' \
    '  including branches absent from the recent picker. Remote-only refs' \
    '  are excluded; missing worktrees still reserve their branches/paths.' \
    '  The summary edits branch, starting point, parent, folder name and' \
    '  Create and enter / Create and stay. Default is Create and enter.' \
    '  The suggested folder is a sibling of the main checkout, named from' \
    '  that checkout and branch (slashes become hyphens only in the folder).' \
    '  Choose a new absent folder outside registered worktrees. No overwrite,' \
    '  automatic stash, forced checkout, branch reset or dependency setup.' \
    '  Inspect Git operation shows quoted arguments; it never evaluates text.' \
    '  Move / rename chooses a linked checkout, then edits its parent or name.' \
    '  Review the old and new paths before choosing Move worktree. Its branch,' \
    '  tracked edits, untracked and ignored files travel with the checkout.' \
    '  The shell stays here. The new folder must be absent on the same' \
    '  filesystem. Main/current, locked, missing, active-operation and' \
    '  submodule checkouts cannot be moved here. No copy or force fallback.' \
    '  Move does not run checkout filters. Stop other writers before moving;' \
    '  failed moves can leave changed paths/registration. Inspect both paths' \
    '  and g worktree list before retrying; there is no automatic rollback.' \
    '  Remove worktree in the main menu opens a fuzzy checkout chooser.' \
    '  Main/current, locked, missing and detached entries are excluded there.' \
    '  Type delete to find the removal action too. Ctrl-X on a worktree still' \
    '  opens its options. Selecting a removal target checks then confirms' \
    '  the exact folder; its branch and commits remain. Removal has no Undo.' \
    '  Main/current, locked, missing and detached worktrees cannot be removed.' \
    '  Changes, untracked/ignored files, active Git operations and hidden-index' \
    '  flags block removal. Sparse/unmerged indexes and submodules are refused.' \
    '  Creation and removal refuse configured checkout filters, including LFS,' \
    '  instead of running them or silently producing unfiltered checkouts.' \
    '  Creation registers without checkout, checks the new branch’s effective' \
    '  configuration, then populates the full committed tree. A filter enabled' \
    '  only there can leave a registered, empty checkout when refused.' \
    '  Hooks, fsmonitor, lazy fetch and Git transport are disabled. No fetch.' \
    '  Captures are limited to 256 KiB, 1,000 worktrees / local branches and' \
    '  1,000 child folders per parent. Exceeding a bound refuses that capture;' \
    '  limits bound retained output, not Git or filesystem response time.' \
    '  Ten visible rows at most; arrows and paging reach later matches.' \
    '  Matching is the same case-insensitive, character-ordered fuzzy search' \
    '  as g, with prefix/substring priority. Worktrees match branch and path.' \
    '  Refresh worktrees replaces the catalog; reopen creation for new branches.' \
    '  Typing and resize use captured facts. Actions revalidate after cleanup.' \
    '  Digits apply visible rows only with empty filter and list focus.' \
    '  Branch/folder-name entry treats digits as text; no shell expansion.' \
    '  Parent browsing: Right/Tab enters, Left/Shift-Tab goes up; Ctrl-T toggles' \
    '  hidden folders. Choose Use this folder; child symlinks are excluded.' \
    '  Escape/Ctrl-G goes Back; Ctrl-C aborts. Ctrl-K shows shared keys.' \
    '  Ctrl-E/B or Tab focuses details/list outside parent browsing.' \
    '  Noninteractive, dumb-terminal or missing-picker calls only print the' \
    '  sanitized registered-worktree list; they never create, remove or cd.' \
    '  Files can change between checks and Git. Git action status is preserved;' \
    '  a failed creation may leave a branch or partial folder. Inspect before' \
    '  retrying; there is no automatic cleanup or rollback. If cd fails after' \
    '  creation, the new worktree is preserved and the failure is reported.' \
    '' \
    'Which branches appear?' \
    '  Requires Git and a working tree. Starts with the current local branch,' \
    '  then recent local checkouts from up to 200 matching HEAD reflog entries.' \
    '  IDE and terminal switches recorded there count too. Deleted branches,' \
    '  detached commit IDs, and remote-only branches are excluded.' \
    '  The current folder scopes branch capture, review and switching.' \
    '  Workspace modes ignore inherited Git repository/index/object selectors;' \
    '  caller settings are restored afterward. Ordinary g arguments preserve' \
    '  Git environment selection and native behavior.' \
    '  A local branch absent from that recent history may not appear. Use' \
    '  g branch to list all local branches; g branch -a also lists remote refs.' \
    '  Detached HEAD has no current-branch row. With the review peer enabled,' \
    '  an empty branch list still offers working changes through Ctrl-X.' \
    '  The picker does not fetch branches or create a history file.' \
    '' \
    'Picker:' \
    '  Ctrl-K opens the shared keyboard guide; Escape or Enter' \
    '  returns to the same filter and selection. A plain ? filters normally.' \
    '  Terminal.app uses a temporary alternate screen; closing restores' \
    '  your previous terminal output. Unsupported terminals stay inline.' \
    '  On usable full screens, search and its real typing cursor sit above' \
    '  the bottom action bar. Short and inline views keep search above results.' \
    '  Choices stay compact; descriptions appear when all visible slots fit.' \
    '  Missing descriptions leave no blank row. Visible matches' \
    '  are emphasized as you filter; row limits and number keys stay the same.' \
    '  Type to filter case-insensitively, in character order; literal prefix' \
    '  and substring matches rank before abbreviated ones.' \
    '  Arrows / Ctrl-P / Ctrl-N move; Enter switches. With an empty query,' \
    '  a visible digit 0-9 switches immediately; otherwise digits filter.' \
    '  Numbers label visible slots and update as the list scrolls.' \
    '  Arrows scroll through all captured matches and stop at either end.' \
    '  Fn-Up/Down or Option-Up/Down page the focused pane with one-line overlap.' \
    '  Ctrl-V pages down; Ctrl-D pages up without Option-as-Meta.' \
    '  Refining the query returns to the first match.' \
    '  Option-W / Ctrl-Y copies the branch name without switching when pbcopy' \
    '  is available. In SSH, copying targets the host running Zsh.' \
    '  Escape / Ctrl-G cancels; Ctrl-C aborts; Ctrl-U clears the filter.' \
    '  Selection uses git switch --no-guess, with no forced discard or stash.' \
    '  Git can refuse conflicting edits or a branch used by another worktree.' \
    '  Up to 10 rows appear by default, limited by terminal height. Set' \
    '  ZSH_NAVIGATION_PICKER_MAX_RESULTS in your initializer to adjust it.' \
    '  Filtering uses the captured recent list; rerun g to refresh it.' \
    '' \
    'Branch details:' \
    '  At 100 columns or wider, the selected branch has a side panel showing' \
    '  its full name, current-branch marker, tip commit, and upstream.' \
    '  The list gets most of the width; details are capped at 48 columns' \
    '  and stay compact until focused. Height adapts to the window and list.' \
    '  Focused details can use the full body height of the temporary screen.' \
    '  On that screen, focus expands reading width beside the retained branch' \
    '  selection. Returning restores the compact preview; the navigation strip' \
    '  marks focus. Rewrapping retains the source paragraph being read.' \
    '  Right / Ctrl-E focuses details; Left / Ctrl-B returns to the list.' \
    '  Tab switches panes; Up/Down scrolls the focused details. In narrower' \
    '  windows, details use a full-width view. Typing returns to filtering.' \
    '  Enter still switches; Ctrl-Y / Option-W still copies when available.' \
    '  Digits select only with an empty query and focus on the visible list.' \
    '  One extra read-only Git batch captures details when opening, capped at' \
    '  262,144 characters and 401 refs. Subjects are limited to 512 characters.' \
    '  Missing or capped metadata leaves the branch selectable with a notice.' \
    '  The upstream is local configuration; no fetch or network access occurs.' \
    '' \
    'Read-only Git review:' \
    '  Ctrl-X review opens the Git review chooser when .zsh.git-review is enabled.' \
    '  g --review opens these choices directly in the current checkout.' \
    '  Change atlas groups captured working changes by folder. Ctrl-X inside' \
    '  any file-review view opens an atlas of that captured list, including comparisons.' \
    '  Bars count change entries, not lines; staged/unstaged changes stay separate.' \
    '  Enter opens folders or reads one file; Right expands full context.' \
    '  Escape restores each map level and the original review position.' \
    '  The map inherits list bounds and partial notices. It performs no discovery' \
    '  or automatic refresh; return to review for Ctrl-R and automatic updates.' \
    '  Compare branches or commits shows Compare, Against, Show and Review differences.' \
    '  Compare starts at the highlighted branch, or the current checkout with' \
    '  g --review. Choose Against as the other branch or commit.' \
    '  Both choices can be changed: select Compare or Against and press Enter.' \
    '  Type a branch name, then Enter chooses the best matching ref on that side.' \
    '  Show defaults to All differences; Review differences opens the two-pane reader.' \
    '  No default comparison branch or upstream is assumed.' \
    '  g --review A B opens All differences directly: committed A -> committed B.' \
    '  In the setup this is Compare B against A. Additions belong to B.' \
    '  g --review --merge-base A B uses Changes since common ancestor: their unique' \
    '  local common ancestor -> B. This is not a merge/conflict preview.' \
    '  Names can be local branches, tags, remote-tracking refs or HEAD; full' \
    '  and unambiguous abbreviated commit IDs work too. Tags peel to commits.' \
    '  Input is limited to 512 characters; hex abbreviations need at least four.' \
    '  Remote-tracking refs are local observations; nothing is fetched.' \
    '  Ambiguous names require a full refs/heads/, refs/tags/ or refs/remotes/' \
    '  name, or choosing its exact ref. Noncommits and missing objects fail.' \
    '  One endpoint, ranges, revision expressions, paths and extra diff options' \
    '  are unsupported. Both endpoints belong to this one repository; a call' \
    '  from a subdirectory still compares the full repository. Dirty working' \
    '  files are excluded; Working changes remains the separate checkout view.' \
    '  The ref chooser captures at most 1,000 refs / 256 KiB, with partial notices.' \
    '  It uses the same case-insensitive character-ordered matching as g.' \
    '  Enter branch or commit stays second after the best ref, first with no matches.' \
    '  It opens literal input for a name or ID; its text entry preserves' \
    '  digits and paste, validates on Return, and keeps invalid input editable.' \
    '  Compare displays the method and actual captured endpoints.' \
    '  Ctrl-K includes full object IDs. Ctrl-R keeps these IDs, including after a branch' \
    '  moves. Choose a ref again in setup or rerun the command for newer tips.' \
    '  Missing or multiple common ancestors require another explicit choice;' \
    '  no automatic switch to All differences or fetch is performed.' \
    '  Escape from a guided comparison returns to setup with choices retained;' \
    '  a direct pair returns to the prompt. No checkout or confirmation occurs.' \
    '  --review requires an interactive non-dumb terminal and the shared picker;' \
    '  otherwise it fails clearly. Use git diff for plain output.' \
    '' \
    'Compose a comparison:' \
    '  Option-Return on a simple g --review draft offers Compose this command.' \
    '  Compose example in this help opens the same authored template when enabled.' \
    '  Edit Comparison, Against and Compare. The initial main / HEAD values are' \
    '  editable placeholders, not discovered defaults. Ref choices pin local IDs.' \
    '  Replace draft returns the quoted command to the prompt; it never runs it.' \
    '  Escape preserves the previous draft. Templates require .zsh.compose.' \
    '  Working changes belongs to the current checkout, even if you highlight' \
    '  another branch. Staged and unstaged changes are separate rows.' \
    '  Status codes: M modified, A added, D deleted, T file-type change.' \
    '  Selected branch opens local commits, then a file-and-diff workspace.' \
    '  The tip is resolved once; commits compare with their first parent.' \
    '  Replacement refs are ignored so object IDs keep their literal meaning.' \
    '  A narrow file navigator sits beside the selected continuous diff.' \
    '  Selecting a file loads its diff automatically; Enter focuses reading.' \
    '  Focused diff is the default: changes with three context lines per side,' \
    '  old/new line numbers, and nearby hunks merged when their context meets.' \
    '  Green/red row backgrounds and +/- mark additions/removals.' \
    '  Optional .zsh.git-syntax adds code colors from system Vim; no setup needed.' \
    '  Prototype languages: Swift, Zsh, shell, JSON and Python. Status reports' \
    '  coverage or plain fallback. This is captured-fragment lexical highlighting:' \
    '  omitted multiline context can affect colors; full context can help.' \
    '  Vim uses only system definitions, with user config/plugins/modelines off.' \
    '  Source stays in pipes; scroll/resize never run Vim. Syntax is bounded to' \
    '  64 KiB input, 3,000 rows, 2,048 characters/line, 4,096 tokens, 800 ms child.' \
    '  Syntax limits retain readable diff text and backgrounds; Git limits below' \
    '  are separate. Refresh replaces both diff and syntax snapshots.' \
    '  Right: files -> focused diff -> full-file context. Left reverses the steps.' \
    '  Tab / Shift-Tab switches panes directly; Ctrl-E/B focuses reader/list.' \
    '  Direct pane focus preserves context mode; Right from files enters focused.' \
    '  Up/Down and page keys scroll each pane independently. Typing filters files.' \
    '  Reading never crosses into another file; each file remembers its position.' \
    '  Below 90 columns the focused pane uses the full width.' \
    '  Working changes rechecks local Git automatically while its screen is open.' \
    '  The status distinguishes the last completed check from the last snapshot' \
    '  update. Ctrl-A pauses/resumes automatic refresh for this screen session;' \
    '  set ZSH_GIT_REVIEW_AUTO_REFRESH=0 to make new sessions start paused.' \
    '  A changed surviving diff publishes in one repaint, retaining the filter,' \
    '  exact file/change kind, pane focus and source area. New/removed files' \
    '  replace the navigator and every older diff/syntax cache.' \
    '  If the selection disappears while reading, the old reader remains visible' \
    '  with update ready; returning to files applies the new snapshot. No focus' \
    '  is moved automatically. With list focus, the first filtered match is used.' \
    '  Ctrl-R refreshes immediately, even with no results or while auto is paused.' \
    '  Failed automatic refresh keeps the previous snapshot and pauses checks;' \
    '  Ctrl-R retries and resumes after a transient automatic failure. A pause' \
    '  you chose stays paused after either manual success or failure.' \
    '  Automatic checks use one bounded worker/provider pair and a private pipe.' \
    '  They are input-idle, time out at 30 seconds, adapt to slow Git, and stop' \
    '  on pause or when review closes. No daemon, persistent cache, hook, fetch' \
    '  or network request is introduced.' \
    '  Commit and comparison views keep captured IDs and refresh only on Ctrl-R.' \
    '  Failed safety-configuration refresh blocks uncached reads until retry.' \
    '  Ctrl-X is inactive here; it opens review only on the main branch screen.' \
    '  Each workspace starts focused; context mode stays until disclosure changes.' \
    '  Expansion keeps the current source area visible, including wrapped code.' \
    '  Collapse from omitted unchanged code finds the nearest retained context;' \
    '  ties prefer earlier context and the status reports the adjustment.' \
    '  Removed lines anchor to old-file numbers; other code uses new-file numbers.' \
    '  Refresh also seeks that source line. Concurrent edits are not content-tracked.' \
    '  Limits clamp to retained code; failed/metadata-only reads start at the notice.' \
    '  Escape goes Back, preserving filter, selection and list position.' \
    '  Ctrl-K shows keys. Review does not stage, discard, commit or checkout.' \
    '  File selection requests one bounded diff; four recent snapshots are reused.' \
    '  Scrolling, guide and resize never read Git. A filter selecting a different' \
    '  file can load that file. Refresh reloads only the selected diff eagerly;' \
    '  other files load on selection, with their old reading bookmarks cleared.' \
    '  Commit-file refresh retains the captured commit ID; reopen branch history' \
    '  to discover new commits. Working-file lists and diffs are separate reads.' \
    '  A later diff can reflect edits made since the file list was captured.' \
    '' \
    'Review coverage and limits:' \
    '  Captures retain at most 256 KiB, 1,000 change rows or 200 commits.' \
    '  Documents retain 10,000 logical / 20,000 wrapped lines, with notices.' \
    '  All hunks remain in one reader; large-file limits are explicitly labeled.' \
    '  Selected untracked regular text files show all their lines as additions,' \
    '  within the same limits. Untracked files and metadata have one reading level:' \
    '  Right reads, Left returns to files; no redundant context expansion.' \
    '  Ctrl-R refreshes that same new-file snapshot.' \
    '  No staging or execution occurs, even for executable source files.' \
    '  Empty files show a notice. NUL bytes in the captured prefix omit content.' \
    '  Symlinks are not followed; missing/special files report unavailable.' \
    '  Untracked files inside new directories appear individually, with parent' \
    '  folder labels; filter by their full paths. Ignored files remain excluded.' \
    '  Git enumerates on entry/refresh; huge untracked trees can take longer.' \
    '  Binary diffs and conflicts show notices. Nested repositories stay separate;' \
    '  submodules are excluded and renames appear as add/delete pairs.' \
    '  Review disables external diff/textconv, clean/process filters, fsmonitor,' \
    '  optional index writes and Git network transport. Filtered files may' \
    '  therefore differ from your usual configured diff. A filter driver name' \
    '  containing = cannot be overridden unambiguously, so review fails closed.' \
    '  No settings change.' \
    '  Bounds limit retained output, not elapsed time: large repositories or' \
    '  slow storage can delay synchronous reads. Failed captures show a notice.' \
    '' \
    'Git shorthand and fallback:' \
    '  Arguments other than --worktree, --review, --discard-all and --help delegate to Git.' \
    '  Git status is preserved. --worktree accepts no extra arguments.' \
    '  g --help is this guide; use git --help for Git itself.' \
    '  There is no Compozsh --list mode: g --list is passed to Git.' \
    '  A noninteractive or dumb-terminal g with no arguments runs plain git.' \
    '  If only the picker is unavailable, the recent stack is printed.' \
    '  Disabling only .zsh.git-review leaves switching/copying intact.' \
    '' \
    'Examples:' \
    '  g                       Open recent branches; type to filter.' \
    '  g --worktree            Create, enter, move or remove a worktree.' \
    '  g --review              Choose working changes, commits or comparisons.' \
    '  g --review main feature/search  Compare two committed versions.' \
    '  g --review 4e12ab7 93cd201  Compare two known commit IDs.' \
    '  g --review --merge-base main feature/search  Review since their ancestor.' \
    '  g worktree list         Ask Git for its native worktree list.' \
    '  g status                Inspect working-tree changes.' \
    '  g branch                List every local branch.' \
    '  g switch feature/search Switch a known branch outside the recent list.' \
    '  g switch --help         Read Git documentation for switch.'
}

_git_branch_choose() {
  _zle_ui_view choice _git_branch_view "$@"
}

_git_branch_view() {
  emulate -L zsh
  local root=$1 clipboard_binary=$2 repo=''
  local -i index=0
  local -a _NAVIGATION_PICKER_SEARCH_LABELS=()
  _ZLE_PICKER_INSPECT_TITLE=Branch _ZLE_PICKER_INSPECT_ACTION=switch
  _ZLE_PICKER_CANCEL_LABEL=''
  typeset -ga _NAVIGATION_PICKER_VALUES=("${_GIT_RECENT_BRANCHES[@]}")
  typeset -ga _NAVIGATION_PICKER_LABELS=("${_GIT_RECENT_BRANCHES[@]}")
  typeset -ga _NAVIGATION_PICKER_INDEXES=()
  for (( index = 0; index < ${#_GIT_RECENT_BRANCHES}; ++index )); do
    _NAVIGATION_PICKER_INDEXES+=($index)
  done

  repo=${root:t}
  _ZLE_PICKER_TITLE=Branches
  _ZLE_PICKER_SUBTITLE=$repo
  [[ -z $_GIT_RECENT_CURRENT ]] && _ZLE_PICKER_SUBTITLE+=' · no current local branch'
  _ZLE_PICKER_BROWSE_LABEL='recent checkouts'
  _ZLE_PICKER_EMPTY_LABEL='no matching branches'
  [[ -n $clipboard_binary ]] && _ZLE_PICKER_COPY_ENABLED=1
  _ZLE_PICKER_COLLECTOR='_navigation_picker_collect'
  {
    (( ${+functions[_zle_picker_inspect_render]} )) && _git_branch_inspector_capture "$root"
    if (( ${+functions[_git_review_branch_choose]} )); then
      _zle_picker_run "${ZSH_NAVIGATION_PICKER_MAX_RESULTS:-10}" '' 1 0 _git_review_branch_choose
    else
      _zle_picker_run "${ZSH_NAVIGATION_PICKER_MAX_RESULTS:-10}"
    fi
  } always {
    _ZLE_PICKER_INSPECT_TEXTS=()
  }
}

unalias g 2>/dev/null
g() {
  emulate -L zsh

  if { (( $# == 1 )) && [[ $1 == --help ]]; } ||
     { (( $# == 2 )) && [[ $1 == (--review|--discard-all) && $2 == --help ]]; }; then
    local -a help=(_compozsh_help_g)
    (( ${+functions[_compozsh_help_show]} )) && help=(_compozsh_help_show "${help[@]}")
    "${help[@]}"
    return 0
  fi

  if [[ ${1:-} == --review ]]; then
    shift
    local review_method=exact
    if [[ ${1:-} == --merge-base ]]; then
      review_method=ancestor
      shift
      (( $# == 2 )) || { print -u2 -r -- 'usage: g [git-arguments ...]'; return 2; }
    fi
    if (( $# != 0 && $# != 2 )) || [[ ${1:-} == -* || ${2:-} == -* ]]; then
      print -u2 -r -- 'usage: g [git-arguments ...]'
      return 2
    fi
    (( ${+functions[_git_review_session]} )) || {
      print -u2 -r -- 'g: review unavailable; enable .zsh.git-review'
      return 1
    }
    if (( $# )); then _git_review_session "$review_method" "$@"
    else _git_review_session; fi
    return $?
  fi

  if [[ ${1:-} == --discard-all ]]; then
    (( $# == 1 )) || { print -u2 -r -- 'usage: g [git-arguments ...]'; return 2; }
    (( ${+functions[_tools_git_discard_all]} )) || {
      print -u2 -r -- 'g: discard unavailable; enable .zsh.tools'
      return 1
    }
    # Like the other explicit g workspaces, target this folder's repository.
    # An inherited selector must not redirect a destructive task elsewhere.
    local GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
    local GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
    unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
    _tools_git_discard_all
    return $?
  fi

  if [[ ${1:-} == --worktree ]]; then
    (( $# == 1 )) || { print -u2 -r -- 'usage: g [git-arguments ...]'; return 2; }
    (( ${+functions[_git_worktree_session]} )) || {
      print -u2 -r -- 'g: worktrees unavailable; enable .zsh.git-worktree'
      return 1
    }
    _git_worktree_session
    return $?
  fi

  (( $# == 0 )) || {
    command git "$@"
    return $?
  }
  if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]]; then
    command git
    return $?
  fi

  # The visible workspace follows this folder throughout capture, review and
  # switching. Transparent Git arguments above preserve native environment use.
  local GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
  local GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
  unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE

  local root='' branch='' clipboard_binary=${commands[pbcopy]:-}
  local -i picker_status=0
  _git_branch_stack_load || return
  root=$REPLY

  if (( ! ${+functions[_zle_picker_loop]} || !${+functions[_matching_compile]} )); then
    _git_branch_stack_print
    return 0
  fi

  _git_branch_choose "$root" "$clipboard_binary"
  picker_status=$?
  (( picker_status == 1 )) && return 0
  (( picker_status == 0 )) || return $picker_status

  branch=$_ZLE_PICKER_SELECTED_VALUE
  if [[ $_ZLE_PICKER_ACTION == copy ]]; then
    _navigation_copy "$branch" "$clipboard_binary" branch g
    return $?
  fi
  [[ $branch == "$_GIT_RECENT_CURRENT" ]] && return 0
  command git -C "$root" switch --no-guess -- "$branch"
}

# Remove the former static branch-list helper when re-sourcing an older shell.
# `g` is now the single branch navigation interface.
unfunction b 2>/dev/null
unalias b 2>/dev/null

:
