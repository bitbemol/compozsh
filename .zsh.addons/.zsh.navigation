# -----------------------------------------------------------------------------
# Small conveniences
# -----------------------------------------------------------------------------

(( ${+aliases[..]} )) || alias ..='cd ..'
(( ${+aliases[...]} )) || alias ...='cd ../..'
(( ${+aliases[....]} )) || alias ....='cd ../../..'
(( ${+aliases[ll]} )) || alias ll='ls -lah'
(( ${+aliases[la]} )) || alias la='ls -A'

# Directory and branch selectors share the same bounded ZLE picker. Their
# source data is captured once before opening; refinement launches no commands.
typeset -g ZSH_NAVIGATION_PICKER_MAX_RESULTS=${ZSH_NAVIGATION_PICKER_MAX_RESULTS:-10}
typeset -ga _NAVIGATION_PICKER_VALUES=()
typeset -ga _NAVIGATION_PICKER_LABELS=()
typeset -ga _NAVIGATION_PICKER_INDEXES=()

# Navigation remains usable without the prompt add-on. Keep these display
# helpers private to this unit so peer add-on order never becomes a dependency.
_navigation_sanitize() {
  REPLY=${1//[[:cntrl:]]/?}
}

_navigation_abbreviate() {
  local text=$1
  local -i max_width=$2 left_width=0 right_width=0

  if (( max_width <= 0 )); then
    REPLY=''
    return
  fi
  if (( ${#text} <= max_width )); then
    REPLY=$text
    return
  fi
  if (( max_width < 5 )); then
    REPLY='…'
    return
  fi

  left_width=$(( (max_width - 1) / 3 ))
  right_width=$(( max_width - 1 - left_width ))
  REPLY="${text[1,left_width]}…${text[-right_width,-1]}"
}

# Navigation owns its pattern boundary so this add-on remains independently
# sourceable. A tiny repeated safety primitive is preferable to a hidden load-
# order dependency on another peer add-on's private implementation.
_navigation_escape_pattern() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local MATCH
  REPLY=${1//(#m)[\][|()\\*?#<>~^]/\\$MATCH}
}

_navigation_picker_append_matches() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local pattern=$1 raw_limit=$2 value='' label=''
  local -i limit=$raw_limit index=0

  for (( index = 1; index <= ${#_NAVIGATION_PICKER_VALUES}; ++index )); do
    label=${_NAVIGATION_PICKER_LABELS[index]}
    [[ $label == ${~pattern} ]] || continue
    value=${_NAVIGATION_PICKER_VALUES[index]}
    (( ${_ZLE_PICKER_RESULTS[(Ie)$value]} )) && continue
    _ZLE_PICKER_RESULTS+=("$value")
    _ZLE_PICKER_LABELS+=("$label")
    _ZLE_PICKER_RESULT_INDEXES+=("${_NAVIGATION_PICKER_INDEXES[index]}")
    (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  done
}

# Navigation lists are intentionally small and already ordered by recency.
# Rank literal prefix and substring matches before character-ordered fuzzy ones.
_navigation_picker_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local query=$1 raw_limit=$2 literal='' pattern='(#i)*' character=''
  local -i limit=$raw_limit index=0
  typeset -ga _ZLE_PICKER_RESULTS=()
  typeset -ga _ZLE_PICKER_LABELS=()
  typeset -ga _ZLE_PICKER_RESULT_INDEXES=()

  if [[ -z $query ]]; then
    for (( index = 1; index <= ${#_NAVIGATION_PICKER_VALUES}; ++index )); do
      _ZLE_PICKER_RESULTS+=("${_NAVIGATION_PICKER_VALUES[index]}")
      _ZLE_PICKER_LABELS+=("${_NAVIGATION_PICKER_LABELS[index]}")
      _ZLE_PICKER_RESULT_INDEXES+=("${_NAVIGATION_PICKER_INDEXES[index]}")
      (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
    done
    return 0
  fi

  _navigation_escape_pattern "$query"
  literal=$REPLY
  _navigation_picker_append_matches "(#i)${literal}*" $limit
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  _navigation_picker_append_matches "(#i)*${literal}*" $limit
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0

  for character in "${(s::)query}"; do
    _navigation_escape_pattern "$character"
    pattern+="${REPLY}*"
  done
  _navigation_picker_append_matches "$pattern" $limit
}

# Print navigation stacks with fixed-width indexes so the selector and its
# target remain visually obvious even when paths or branch names are long.
_stack_print_entry() {
  emulate -L zsh

  local index=$1 marker=$2 label=$3
  local -i columns=${COLUMNS:-80} label_width=0
  (( columns > 0 )) || columns=80
  label_width=$(( columns - ${#index} - 5 ))
  (( label_width > 0 )) || label_width=1
  _navigation_sanitize "$label"
  label=$REPLY
  _navigation_abbreviate "$label" $label_width
  label=$REPLY

  print -Pn -- "%F{cyan}[${index}]%f "
  if [[ $marker == current ]]; then
    print -Pn -- '%F{green}●%f '
  else
    print -Pn -- '%F{240}↳%f '
  fi
  print -r -- "$label"
}

# Capture Zsh's native directory stack once for either the selector or the
# printable fallback. Indexes retain their standard ~0, ~1, ... meanings.
_directory_stack_capture() {
  emulate -L zsh

  local path='' display=''
  local -a entries=("$PWD" "${dirstack[@]}")
  local -i index=0
  typeset -ga _NAVIGATION_PICKER_VALUES=()
  typeset -ga _NAVIGATION_PICKER_LABELS=()
  typeset -ga _NAVIGATION_PICKER_INDEXES=()

  for path in "${entries[@]}"; do
    if [[ $path == $HOME || $path == $HOME/* ]]; then
      display="~${path#$HOME}"
    else
      display=$path
    fi
    _NAVIGATION_PICKER_VALUES+=("$path")
    _NAVIGATION_PICKER_LABELS+=("$display")
    _NAVIGATION_PICKER_INDEXES+=($index)
    (( ++index ))
  done
}

_directory_stack_print() {
  emulate -L zsh

  local path='' marker=''
  local -i index=0

  print -P '%F{blue}Directory stack%f'
  for path in "${_NAVIGATION_PICKER_LABELS[@]}"; do
    marker='recent'
    (( index == 0 )) && marker='current'
    _stack_print_entry $index "$marker" "$path"
    (( ++index ))
  done
  if (( ${#_NAVIGATION_PICKER_VALUES} > 1 )); then
    print -P '%F{240}Run %F{cyan}d%F{240} to jump interactively.%f'
  else
    print -P '%F{240}Previous directories will appear here as you move around.%f'
  fi
}

# Open the visual selector with `d`; `d --list` keeps a printable view for
# copyable output. Native ~N expansion remains available as standard Zsh
# syntax, but the selector's visible digits are the primary direct interface.
_compozsh_help_d() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: d [--list]' \
    'With no arguments, open the recent-directory picker.' \
    '' \
    'Where do the entries come from?' \
    '  Captures the current shell directory stack, including $PWD at index 0.' \
    '  It contains visited locations, not a search of the filesystem. Other' \
    '  terminals have separate stacks; a new shell starts its own stack.' \
    '  An empty history can therefore show just your current directory.' \
    '  Use f query to find paths beyond the stack, or Tab for directory entry.' \
    '' \
    'Picker:' \
    '  Type to filter captured paths case-insensitively, in character order.' \
    '  Literal prefixes and substrings rank before abbreviated matches.' \
    '  Arrows / Ctrl-P / Ctrl-N move; Enter changes to the selected directory.' \
    '  With an empty query, a visible digit 0-9 selects immediately; after' \
    '  typing, digits are search text. Numbers label the currently visible' \
    '  slots, not fixed stack indexes; d --list shows native stack indexes.' \
    '  Escape / Ctrl-G cancels; Ctrl-C aborts; Ctrl-U clears the filter.' \
    '  Native ~1, ~2, ... expansion still works and changes with the stack.' \
    '  Up to 10 rows appear by default, limited by terminal height. Arrows' \
    '  scroll through all captured matches and stop at either end.' \
    '  Ctrl-V pages down; Escape then v pages up (Option-V with Meta).' \
    '  Fn-Up/Down also pages. Refining starts at the first match. Set' \
    '  ZSH_NAVIGATION_PICKER_MAX_RESULTS to change the visible limit.' \
    '  Missing or inaccessible directories fail through normal cd checks.' \
    '' \
    'Options and fallback:' \
    '  --list prints the stack without changing directories; long paths may' \
    '  be abbreviated for display. Pipes, redirects, dumb terminals, or an' \
    '  unavailable picker also use this display. This is a human-readable list.' \
    '  --help shows this guide. No path or query argument is accepted.' \
    '' \
    'Examples:' \
    '  d           Open the picker, then type a remembered path fragment.' \
    '  d --list    Inspect the current stack.' \
    '  cd ~1       Enter the directory currently at stack index 1.'
}

unalias d 2>/dev/null
d() {
  emulate -L zsh

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_d
    return 0
  fi

  (( $# <= 1 )) || {
    print -u2 'usage: d [--list]'
    return 2
  }
  [[ $# == 0 || $1 == --list ]] || {
    print -u2 'usage: d [--list]'
    return 2
  }

  local -i picker_status=0
  _directory_stack_capture
  if (( $# )) || [[ ! -t 0 || ! -t 1 || $TERM == dumb ]]; then
    _directory_stack_print
    return 0
  fi
  if (( ! ${+functions[_zle_picker_loop]} )); then
    _directory_stack_print
    return 0
  fi

  _ZLE_PICKER_TITLE='Directories'
  _ZLE_PICKER_BROWSE_LABEL='recent locations'
  _ZLE_PICKER_EMPTY_LABEL='no matching directories'
  _ZLE_PICKER_FOOTER='0–9 select · ↑↓ move · ^V/⌥V page · ⏎ cd · esc cancel'
  _ZLE_PICKER_COLLECTOR='_navigation_picker_collect'
  _ZLE_PICKER_DIGIT_SELECT=1
  _zle_picker_run "${ZSH_NAVIGATION_PICKER_MAX_RESULTS:-10}"
  picker_status=$?
  (( picker_status == 1 )) && return 0
  (( picker_status == 0 )) || return $picker_status
  [[ $_ZLE_PICKER_SELECTED_VALUE == $PWD ]] ||
    builtin cd -- "$_ZLE_PICKER_SELECTED_VALUE"
}

# Build a most-recently-used list from Git's own checkout reflog. Keeping this
# derived avoids a second history file and also sees switches made by IDEs or
# other shells. Deleted branches and detached commit IDs are filtered out.
_git_recent_branches() {
  emulate -L zsh

  local root=$1 current='' refs='' ref_marker='' ref=''
  local subject='' transition='' from='' to='' candidate=''
  local -a local_branches=()
  local -A local_branch_set=() recent_branch_set=()
  typeset -ga _GIT_RECENT_BRANCHES=()
  typeset -g _GIT_RECENT_CURRENT=''

  refs=$(command git -C "$root" for-each-ref \
    --format='%(HEAD)%09%(refname:short)' refs/heads 2>/dev/null) || return 1
  while IFS=$'\t' read -r ref_marker ref; do
    [[ -n $ref ]] || continue
    local_branches+=("$ref")
    local_branch_set[$ref]=1
    [[ $ref_marker == '*' ]] && current=$ref
  done <<< "$refs"

  [[ -n $current ]] && {
    _GIT_RECENT_BRANCHES+=("$current")
    recent_branch_set[$current]=1
    _GIT_RECENT_CURRENT=$current
  }
  (( ${#_GIT_RECENT_BRANCHES} == ${#local_branches} )) && return 0

  while IFS= read -r subject; do
    [[ $subject == 'checkout: moving from '*' to '* ]] || continue
    transition=${subject#checkout: moving from }
    from=${transition%% to *}
    to=${transition#* to }

    for candidate in "$to" "$from"; do
      [[ -n $candidate ]] || continue

      [[ -n ${local_branch_set[$candidate]-} ]] || continue
      [[ -z ${recent_branch_set[$candidate]-} ]] || continue
      _GIT_RECENT_BRANCHES+=("$candidate")
      recent_branch_set[$candidate]=1
    done

    (( ${#_GIT_RECENT_BRANCHES} == ${#local_branches} )) && break
  done < <(command git -C "$root" reflog show --format='%gs' \
    --grep-reflog='^checkout: moving from ' --max-count=200 HEAD 2>/dev/null)

  # Local branches absent from the bounded checkout reflog are simply not
  # recent; a partial recency list is still a successful inspection.
  return 0
}

# Optional details use one bounded bulk read, never a Git call per selection.
# NUL fields preserve tabs in commit subjects and empty upstreams. An incomplete
# record (including a failed Git command) leaves the useful branch-only fallback.
_git_branch_inspector_capture() {
  emulate -L zsh
  local root=$1 branch='' state='' data='' ref='' upstream='' oid='' subject='' text=''
  local -a refs=()
  typeset -gA _ZLE_PICKER_INSPECT_TEXTS=()
  for branch in "${_GIT_RECENT_BRANCHES[@]}"; do
    state='Recent local branch'
    [[ $branch == "$_GIT_RECENT_CURRENT" ]] && state='Current branch'
    _ZLE_PICKER_INSPECT_TEXTS[$branch]="${(V)branch}"$'\n'"$state"$'\n\nCommit details unavailable (read limit or Git error).'
    refs+=("refs/heads/$branch")
  done
  (( ${#refs} )) || return 0
  # 200 checkout transitions yield at most 401 distinct recent branches.
  # The byte/character cap also bounds unusually large commit messages.
  IFS= read -r -u 0 -k 262144 data < <(command git -C "$root" for-each-ref \
    --count=401 --format='%(refname)%00%(upstream:short)%00%(objectname:short)%00%(subject)%00' \
    "${refs[@]}" 2>/dev/null) || :
  while IFS= read -r -d '' ref && IFS= read -r -d '' upstream &&
        IFS= read -r -d '' oid && IFS= read -r -d '' subject; do
    ref=${ref#$'\n'}
    branch=${ref#refs/heads/}
    (( ${+_ZLE_PICKER_INSPECT_TEXTS[$branch]} )) || continue
    state='Recent local branch'
    [[ $branch == "$_GIT_RECENT_CURRENT" ]] && state='Current branch'
    (( ${#subject} > 512 )) && subject="${subject[1,512]}… [truncated]"
    text="${(V)branch}"$'\n'"$state"
    text+=$'\n\nLatest commit:\n  '"${(V)oid}"$'\n  '"${(V)subject}"
    text+=$'\n\nUpstream:\n  '"${(V)upstream:-not configured}"
    text+=$'\n\n  Enter switches to this branch.\n  Snapshot captured when g opened; no fetch.'
    _ZLE_PICKER_INSPECT_TEXTS[$branch]=$text
  done <<< "$data"
  return 0
}

# Resolve and populate the branch-picker context behind one Git boundary.
_git_branch_stack_load() {
  emulate -L zsh

  local root=''
  root=$(command git rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 'g: not inside a Git working tree'
    return 1
  }
  _git_recent_branches "$root" || {
    print -u2 'g: could not inspect local branches'
    return 1
  }
  (( ${#_GIT_RECENT_BRANCHES} )) || {
    print -u2 'g: this repository has no local branch history yet'
    return 1
  }
  REPLY=$root
}

# Copy a ref name as inert stdin data. `pbcopy` is resolved by the caller so
# unsupported hosts never advertise or enter this action path.
_git_copy_branch() {
  emulate -L zsh

  local branch=$1 clipboard_binary=$2 display=''
  [[ -n $clipboard_binary && -x $clipboard_binary ]] || {
    print -u2 'g: clipboard support is unavailable on this host'
    return 1
  }
  print -rn -- "$branch" | command "$clipboard_binary" || {
    print -u2 'g: could not copy the selected branch'
    return 1
  }
  _navigation_sanitize "$branch"
  display=$REPLY
  print -r -- "Copied branch ${display}."
}

_git_branch_stack_print() {
  emulate -L zsh

  local branch='' marker='recent'
  local -i index=0

  print -P '%F{blue}Branch stack%f'
  for branch in "${_GIT_RECENT_BRANCHES[@]}"; do
    marker='recent'
    [[ $branch == $_GIT_RECENT_CURRENT ]] && marker='current'
    _stack_print_entry $index "$marker" "$branch"
    (( ++index ))
  done
}

# Keep `g <arguments>` as the familiar Git shorthand. Its no-argument form,
# which would otherwise only print Git's help, opens the recent-branch picker.
_compozsh_help_g() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: g [git-arguments ...]' \
    'With no arguments, open the recent-branch picker.' \
    '' \
    'Which branches appear?' \
    '  Requires Git and a working tree. Starts with the current local branch,' \
    '  then recent local checkouts from up to 200 matching HEAD reflog entries.' \
    '  IDE and terminal switches recorded there count too. Deleted branches,' \
    '  detached commit IDs, and remote-only branches are excluded.' \
    '  A local branch absent from that recent history may not appear. Use' \
    '  g branch to list all local branches; g branch -a also lists remote refs.' \
    '  Detached HEAD has no current-branch row. No usable local history is an' \
    '  error. The picker does not fetch branches or create a history file.' \
    '' \
    'Picker:' \
    '  Type to filter case-insensitively, in character order; literal prefix' \
    '  and substring matches rank before abbreviated ones.' \
    '  Arrows / Ctrl-P / Ctrl-N move; Enter switches. With an empty query,' \
    '  a visible digit 0-9 switches immediately; otherwise digits filter.' \
    '  Numbers label visible slots and update as the list scrolls.' \
    '  Arrows scroll through all captured matches and stop at either end.' \
    '  Ctrl-V pages down; Escape then v pages up (Option-V with Meta).' \
    '  Fn-Up/Down also pages; page keys act on the focused pane.' \
    '  Refining the query returns to the first match.' \
    '  Option-W / Ctrl-Y copies the branch name without switching when pbcopy' \
    '  is available. In SSH, copying targets the host running Zsh.' \
    '  Escape / Ctrl-G cancels; Ctrl-C aborts; Ctrl-U clears the filter.' \
    '  Selection uses git switch --no-guess, with no forced discard or stash.' \
    '  Git can refuse conflicting edits or a branch used by another worktree.' \
    '  Up to 10 rows appear by default, limited by terminal height. Set' \
    '  ZSH_NAVIGATION_PICKER_MAX_RESULTS in your initializer to adjust it.' \
    '  Filtering uses the captured recent list; rerun g to refresh it.' \
    '' \
    'Branch details:' \
    '  At 100 columns or wider, the selected branch has a side panel showing' \
    '  its full name, current-branch marker, tip commit, and upstream.' \
    '  Right / Ctrl-F focuses details; Left / Ctrl-B returns to the list.' \
    '  Tab switches panes; Up/Down scrolls the focused details. In narrower' \
    '  windows, details use a full-width view. Typing returns to filtering.' \
    '  Enter still switches; Ctrl-Y / Option-W still copies when available.' \
    '  Digits select only with an empty query and focus on the visible list.' \
    '  One extra read-only Git batch captures details when opening, capped at' \
    '  262,144 characters and 401 refs. Subjects are limited to 512 characters.' \
    '  Missing or capped metadata leaves the branch selectable with a notice.' \
    '  The upstream is local configuration; no fetch or network access occurs.' \
    '' \
    'Git shorthand and fallback:' \
    '  With arguments, delegates directly to Git and preserves its status.' \
    '  g --help is this guide; use git --help for Git itself.' \
    '  There is no Compozsh --list mode: g --list is passed to Git.' \
    '  A noninteractive or dumb-terminal g with no arguments runs plain git.' \
    '  If only the picker is unavailable, the recent stack is printed.' \
    '' \
    'Examples:' \
    '  g                       Open recent branches; type to filter.' \
    '  g status                Inspect working-tree changes.' \
    '  g branch                List every local branch.' \
    '  g switch feature/search Switch a known branch outside the recent list.' \
    '  g switch --help         Read Git documentation for switch.'
}

unalias g 2>/dev/null
g() {
  emulate -L zsh

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_g
    return 0
  fi

  (( $# == 0 )) || {
    command git "$@"
    return $?
  }
  if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]]; then
    command git
    return $?
  fi

  local root='' repo='' branch='' clipboard_binary=${commands[pbcopy]:-}
  local _ZLE_PICKER_INSPECT_TITLE=Branch _ZLE_PICKER_INSPECT_ACTION=switch
  local -i index=0 picker_status=0
  _git_branch_stack_load || return
  root=$REPLY

  if (( ! ${+functions[_zle_picker_loop]} )); then
    _git_branch_stack_print
    return 0
  fi

  typeset -ga _NAVIGATION_PICKER_VALUES=("${_GIT_RECENT_BRANCHES[@]}")
  typeset -ga _NAVIGATION_PICKER_LABELS=("${_GIT_RECENT_BRANCHES[@]}")
  typeset -ga _NAVIGATION_PICKER_INDEXES=()
  for (( index = 0; index < ${#_GIT_RECENT_BRANCHES}; ++index )); do
    _NAVIGATION_PICKER_INDEXES+=($index)
  done

  repo=${root:t}
  _ZLE_PICKER_TITLE="Branches · ${repo}"
  [[ -z $_GIT_RECENT_CURRENT ]] && _ZLE_PICKER_TITLE+=' · detached HEAD'
  _ZLE_PICKER_BROWSE_LABEL='recent checkouts'
  _ZLE_PICKER_EMPTY_LABEL='no matching branches'
  _ZLE_PICKER_COPY_ENABLED=0
  if [[ -n $clipboard_binary ]]; then
    _ZLE_PICKER_FOOTER='⌥W/^Y copy · 0–9 switch · ↑↓ move · type filter · ⏎ switch · esc cancel'
    _ZLE_PICKER_COPY_ENABLED=1
  else
    _ZLE_PICKER_FOOTER='0–9 switch · ↑↓ move · type filter · ⏎ switch · esc cancel'
  fi
  _ZLE_PICKER_COLLECTOR='_navigation_picker_collect'
  _ZLE_PICKER_DIGIT_SELECT=1
  {
    (( ${+functions[_zle_picker_inspect_render]} )) && _git_branch_inspector_capture "$root"
    _zle_picker_run "${ZSH_NAVIGATION_PICKER_MAX_RESULTS:-10}"
    picker_status=$?
  } always {
    _ZLE_PICKER_INSPECT_TEXTS=()
  }
  (( picker_status == 1 )) && return 0
  (( picker_status == 0 )) || return $picker_status

  branch=$_ZLE_PICKER_SELECTED_VALUE
  if [[ $_ZLE_PICKER_ACTION == copy ]]; then
    _git_copy_branch "$branch" "$clipboard_binary"
    return $?
  fi
  [[ $branch == "$_GIT_RECENT_CURRENT" ]] && return 0
  command git -C "$root" switch --no-guess "$branch"
}

# Remove the former static branch-list helper when re-sourcing an older shell.
# `g` is now the single branch navigation interface.
unfunction b 2>/dev/null
unalias b 2>/dev/null

:
