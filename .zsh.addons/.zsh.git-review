# Read-only Git review. Source-time work is definitions only; navigation opts
# into these views at runtime. Providers capture, collectors filter, and the
# UI peer owns every key, frame and screen transition.
typeset -ga _GIT_REVIEW_CONFIG=() _GIT_REVIEW_PATHS=() _GIT_REVIEW_LABELS=()
typeset -ga _GIT_REVIEW_KINDS=() _GIT_REVIEW_CONTEXTS=() _GIT_REVIEW_DETAILS=() _GIT_REVIEW_PARENTS=()
typeset -g _GIT_REVIEW_DATA='' _GIT_REVIEW_SUMMARY='' _GIT_REVIEW_NOTICE=''
typeset -gi _GIT_REVIEW_TRUNCATED=0 _GIT_REVIEW_DOCUMENT_HAS_CODE=0
typeset -ga _GIT_REVIEW_DOCUMENT_OLD=() _GIT_REVIEW_DOCUMENT_NEW=()
typeset -g _GIT_REVIEW_ERROR=''
typeset -ga _GIT_REVIEW_REFS=() _GIT_REVIEW_REF_OIDS=() _GIT_REVIEW_REF_LABELS=()
typeset -g ZSH_GIT_REVIEW_AUTO_REFRESH=${ZSH_GIT_REVIEW_AUTO_REFRESH-1}
typeset -gF _GIT_REVIEW_AUTO_REFRESH_INTERVAL=2.0
typeset -gF _GIT_REVIEW_AUTO_REFRESH_TIMEOUT=30.0

_git_review_git() {
  emulate -L zsh
  local root=$1
  shift
  # Every provider reads the displayed root. Ambient selectors must not pair
  # another repository's refs/index with this root's direct file previews.
  local GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
  local GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
  local git_binary=${commands[git]:-git}
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
  unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
  local -x GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0
  local -x GIT_ALLOW_PROTOCOL='' GIT_LITERAL_PATHSPECS=1
  local -x GIT_GLOB_PATHSPECS=0 GIT_NOGLOB_PATHSPECS=0 GIT_ICASE_PATHSPECS=0
  if (( ${_GIT_REVIEW_WORKER_EXEC:-0} )); then
    # The automatic worker launches this function as a direct asynchronous
    # child, records that PID, then replaces it with Git. Cancellation can
    # therefore terminate the actual provider before reaping its Zsh parent.
    exec "$git_binary" --no-pager --no-replace-objects -C "$root" -c core.fsmonitor=false \
      -c core.untrackedCache=false -c core.hooksPath=/dev/null \
      "${_GIT_REVIEW_CONFIG[@]}" "$@"
  fi
  command git --no-pager --no-replace-objects -C "$root" -c core.fsmonitor=false \
    -c core.untrackedCache=false -c core.hooksPath=/dev/null \
    "${_GIT_REVIEW_CONFIG[@]}" "$@"
}

# Automatic providers stream through a private coprocess pipe so the worker
# owns the exact Git PID rather than an opaque command-substitution process
# tree. Only the established 256 KiB payload plus one lookahead byte is retained.
_git_review_capture_worker() {
  emulate -L zsh
  unsetopt BG_NICE
  zmodload zsh/system || return 2
  zmodload zsh/zselect || return 2
  zmodload zsh/datetime || return 2
  local root=$1
  shift
  local chunk=''
  local -i pid=0 result=0 fd=-1 amount=0 total=0 remaining=0 read_result=0
  _GIT_REVIEW_DATA='' _GIT_REVIEW_TRUNCATED=0
  _git_review_worker_forking=1
  local -i _GIT_REVIEW_WORKER_EXEC=1
  # A dynamically allocated descriptor above Git's documented trace-fd range
  # is a liveness duplicate inherited across the direct exec. A wrapper may
  # close stdout, but the capture pipe reaches EOF only when the provider exits
  # and closes every inherited descriptor. This keeps wait bounded by the same
  # deadline/cancellation loop without adding a timer or PID handoff file.
  coproc {
    local -i liveness_fd=-1
    exec {liveness_fd}>&1 || exit 2
    _git_review_git "$root" "$@" 2>/dev/null
  }
  pid=$!
  _git_review_worker_active_pid=$pid
  _git_review_worker_forking=0
  (( pid > 0 )) || return 2
  exec {fd}<&p || { _git_review_auto_worker_terminate; return 2; }
  (( _git_review_worker_cancelled )) && _git_review_auto_worker_terminate
  while true; do
    if (( EPOCHREALTIME >= _GIT_REVIEW_WORKER_DEADLINE )); then
      _git_review_worker_timed_out=1
      _git_review_auto_worker_terminate
    fi
    if ! zselect -r $fd -t 10 2>/dev/null; then
      continue
    fi
    remaining=$(( 262145 - total ))
    chunk='' amount=0
    sysread -i $fd -s $remaining -c amount chunk 2>/dev/null
    read_result=$?
    if (( read_result == 0 && amount > 0 )); then
      _GIT_REVIEW_DATA+=$chunk
      (( total += amount ))
      if (( total > 262144 )); then
        _GIT_REVIEW_DATA=${_GIT_REVIEW_DATA[1,262144]}
        _GIT_REVIEW_TRUNCATED=1
        exec {fd}<&-
        trap '_git_review_auto_worker_defer_terminate' TERM
        kill -KILL $pid 2>/dev/null
        wait $pid 2>/dev/null
        _git_review_worker_active_pid=0
        trap '_git_review_auto_worker_terminate' TERM
        (( _git_review_worker_cancelled )) && _git_review_auto_worker_terminate
        return 0
      fi
      continue
    fi
    # The provider and its liveness duplicate are closed; reap its stored exit
    # status while TERM is masked only across the nonblocking ownership clear.
    trap '_git_review_auto_worker_defer_terminate' TERM
    wait $pid 2>/dev/null
    result=$?
    _git_review_worker_active_pid=0
    trap '_git_review_auto_worker_terminate' TERM
    (( _git_review_worker_cancelled )) && _git_review_auto_worker_terminate
    break
  done
  exec {fd}<&-
  (( result == 0 )) && return 0
  (( result == 1 )) && return 1
  return 2
}

# Bound retained output, including one lookahead byte. The private trailing
# NUL/status distinguishes successful empty output from failure. Closing the
# read pipe stops oversized writers; it is not a wall-clock Git timeout.
_git_review_capture() {
  emulate -L zsh
  local -a reply=()
  _GIT_REVIEW_DATA='' _GIT_REVIEW_TRUNCATED=0
  if [[ -n ${_GIT_REVIEW_WORKER_DIR:-} ]]; then
    _git_review_capture_worker "$@"
    return $?
  fi
  (( ${+functions[_compozsh_capture_bounded]} )) || return 2
  _compozsh_capture_bounded 262144 _git_review_git "$@" || return 2
  if [[ $reply[2] == truncated ]]; then
    _GIT_REVIEW_DATA=$reply[1]
    _GIT_REVIEW_TRUNCATED=1
    return 0
  fi
  [[ $reply[2] == complete ]] || return 2
  _GIT_REVIEW_DATA=$reply[1]
  [[ $reply[3] == 0 ]] && return 0
  [[ $reply[3] == 1 ]] && return 1
  return 2
}

# --no-textconv alone does not disable clean/process filters used when Git
# compares working files. Discover names without reading values into shell
# syntax, then override every configured driver for this invocation only.
_git_review_prepare() {
  emulate -L zsh
  local root=$1
  local -a reply=()
  local -i result=0
  _GIT_REVIEW_CONFIG=()
  (( ${+functions[_compozsh_git_filter_overrides]} )) || return 2
  _git_review_capture "$root" config --null --name-only --get-regexp '^filter\..*\.(clean|process|required)$'
  result=$?
  (( result <= 1 && !_GIT_REVIEW_TRUNCATED )) || return 2
  _compozsh_git_filter_overrides "$_GIT_REVIEW_DATA" clean
  result=$?
  _GIT_REVIEW_CONFIG=("${reply[@]}")
  return $result
}

_git_review_reset() {
  _GIT_REVIEW_PATHS=() _GIT_REVIEW_LABELS=() _GIT_REVIEW_KINDS=()
  _GIT_REVIEW_CONTEXTS=() _GIT_REVIEW_DETAILS=() _GIT_REVIEW_PARENTS=()
  _GIT_REVIEW_SUMMARY='' _GIT_REVIEW_NOTICE=''
}

_git_review_changes_parse() {
  emulate -L zsh
  local record='' name='' xy='' kind='' state=''
  local -i staged=0 unstaged=0 untracked=0 conflicts=0 index=0
  _git_review_reset
  while IFS= read -r -d '' record; do
    (( ${#record} >= 4 )) || continue
    xy=${record[1,2]} name=${record[4,-1]}
    if [[ $xy == '??' ]]; then
      kind=untracked state='Untracked'
      [[ $name == */* && $name != */ ]] && state+=" · ${name:h}/"
      (( ++untracked ))
    elif [[ $xy == *U* || $xy == AA || $xy == DD ]]; then
      kind=conflict state="Conflict $xy"
      (( ++conflicts ))
    else
      for index in 1 2; do
        [[ $xy[index] == ' ' ]] && continue
        (( ${#_GIT_REVIEW_PATHS} < 1000 )) || { _GIT_REVIEW_TRUNCATED=1; break 2; }
        if (( index == 1 )); then
          kind=staged state="Staged $xy[index]"
          (( ++staged ))
        else
          kind=unstaged state="Unstaged $xy[index]"
          (( ++unstaged ))
        fi
        _GIT_REVIEW_PATHS+=("$name") _GIT_REVIEW_KINDS+=("$kind")
        _GIT_REVIEW_LABELS+=("$name") _GIT_REVIEW_CONTEXTS+=("$state")
        _GIT_REVIEW_DETAILS+=("$state"$'\n'"$name"$'\n\nEnter reads this diff.\n\n  Read-only · no staging or discard\n  Git filters disabled for review')
      done
      (( ${#_GIT_REVIEW_PATHS} >= 1000 )) && { _GIT_REVIEW_TRUNCATED=1; break; }
      continue
    fi
    _GIT_REVIEW_PATHS+=("$name") _GIT_REVIEW_KINDS+=("$kind")
    _GIT_REVIEW_LABELS+=("$name") _GIT_REVIEW_CONTEXTS+=("$state")
    if [[ $kind == untracked ]]; then
      _GIT_REVIEW_DETAILS+=("$state"$'\n'"$name"$'\n\nSelected regular text files are shown as new content.\nFolders, links and binary files show notices.')
    else
      _GIT_REVIEW_DETAILS+=("$state"$'\n'"$name"$'\n\nEnter reads the conflict notice.\nConflict content is not opened.')
    fi
    (( ${#_GIT_REVIEW_PATHS} >= 1000 )) && { _GIT_REVIEW_TRUNCATED=1; break; }
  done <<< "$_GIT_REVIEW_DATA"
  _GIT_REVIEW_SUMMARY="$staged staged · $unstaged unstaged · $untracked untracked · $conflicts conflicts"
  (( _GIT_REVIEW_TRUNCATED )) && _GIT_REVIEW_SUMMARY+=' · partial snapshot'
  _GIT_REVIEW_NOTICE='Renames appear as add/delete. Submodules and ignored files are excluded; untracked files are listed individually.'
  return 0
}

_git_review_changes_capture() {
  emulate -L zsh
  local root=$1
  # A failed provider is not a successful empty snapshot, but it must not
  # leave arrays from an unrelated prior capture available to a caller.
  _git_review_reset
  _git_review_capture "$root" status --porcelain=v1 -z --no-renames \
    --untracked-files=all --ignore-submodules=all || return 2
  _git_review_changes_parse
}


# Resolve only the documented input forms. Successful rev-parse alone can
# silently prefer a tag to a same-named branch, so check namespaces explicitly.
_git_review_resolve() {
  emulate -L zsh
  local root=$1 value=$2 ref='' object=''
  local -a refs=() matches=() objects=()
  local -i result=0
  REPLY='' _GIT_REVIEW_ERROR=''
  if [[ -z $value || $value == -* || $value == *[[:cntrl:]]* ]] || (( ${#value} > 512 )); then
    _GIT_REVIEW_ERROR='Enter a branch, tag, HEAD or unambiguous commit ID (at most 512 characters).'
    return 1
  fi
  if [[ $value == HEAD ]]; then
    object=HEAD
  else
    if [[ $value == refs/(heads|tags|remotes)/* ]]; then
      refs=("$value")
    else
      refs=("refs/heads/$value" "refs/tags/$value" "refs/remotes/$value")
    fi
    _git_review_capture "$root" check-ref-format "${refs[1]}" || {
      _GIT_REVIEW_ERROR='Unsupported revision: use a name or commit ID; ranges, paths and revision expressions are not accepted.'
      return 1
    }
    for ref in "${refs[@]}"; do
      _git_review_capture "$root" show-ref --verify --quiet "$ref"
      result=$?
      (( result <= 1 && !_GIT_REVIEW_TRUNCATED )) || {
        _GIT_REVIEW_ERROR='Unable to read local refs.'; return 1
      }
      (( result == 0 )) && matches+=("$ref")
    done
    if [[ $value != *[^[:xdigit:]]* ]] && (( ${#value} >= 4 && ${#value} <= 64 )); then
      _git_review_capture "$root" rev-parse "--disambiguate=$value" || {
        _GIT_REVIEW_ERROR='Unable to resolve this object locally.'; return 1
      }
      objects=("${(@f)${_GIT_REVIEW_DATA%$'\n'}}")
      [[ -z ${objects[1]} ]] && objects=()
      (( !_GIT_REVIEW_TRUNCATED && ${#objects} <= 1 )) || {
        _GIT_REVIEW_ERROR='This object ID is ambiguous; enter more hexadecimal characters.'; return 1
      }
      matches+=("${objects[@]}")
    fi
    (( ${#matches} == 1 )) || {
      if (( ${#matches} )); then
        _GIT_REVIEW_ERROR='This name is ambiguous; choose a ref or enter refs/heads/name, refs/tags/name or refs/remotes/name.'
      else
        _GIT_REVIEW_ERROR='Revision unavailable locally. Choose another ref or commit ID; nothing is fetched.'
      fi
      return 1
    }
    object=$matches[1]
  fi
  _git_review_capture "$root" rev-parse --verify --end-of-options "$object^{commit}" || {
    _GIT_REVIEW_ERROR='Revision does not resolve to an available local commit.'; return 1
  }
  object=${_GIT_REVIEW_DATA%$'\n'}
  (( !_GIT_REVIEW_TRUNCATED )) && (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$object" || {
    _GIT_REVIEW_ERROR='Invalid or incomplete commit resolution.'; return 1
  }
  REPLY=$object
}

_git_review_compare_base() {
  emulate -L zsh
  local root=$1 method=$2 from=$3 to=$4
  local -a bases=()
  REPLY='' _GIT_REVIEW_ERROR=''
  (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$from" && (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$to" || return 2
  [[ $method == exact ]] && { REPLY=$from; return 0; }
  [[ $method == ancestor ]] || return 2
  _git_review_capture "$root" merge-base --all "$from" "$to" || {
    _GIT_REVIEW_ERROR='No common ancestor available in local history. Choose All differences or different revisions.'
    return 1
  }
  bases=("${(@f)${_GIT_REVIEW_DATA%$'\n'}}")
  if (( _GIT_REVIEW_TRUNCATED || ${#bases} != 1 )); then
    _GIT_REVIEW_ERROR='Incomplete or multiple common ancestors. Choose an explicit Against commit with All differences.'
    return 1
  fi
  (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$bases[1]" || {
    _GIT_REVIEW_ERROR='No common ancestor available in local history.'; return 1
  }
  REPLY=$bases[1]
}

# Capture names and object IDs without author identities or commit subjects.
# Annotated tag objects remain pinned and are peeled only on acceptance.
_git_review_refs_capture() {
  emulate -L zsh
  local root=$1 ref='' kind='' oid='' label=''
  local -i count=0
  _GIT_REVIEW_REFS=() _GIT_REVIEW_REF_OIDS=() _GIT_REVIEW_REF_LABELS=()
  _git_review_capture "$root" for-each-ref --count=1001 --sort=refname \
    '--format=%(refname)%00%(objecttype)%00%(objectname)%00' \
    refs/heads/ refs/tags/ refs/remotes/ || return 2
  while IFS= read -r -d '' ref && IFS= read -r -d '' kind && IFS= read -r -d '' oid; do
    (( ++count <= 1000 )) || { _GIT_REVIEW_TRUNCATED=1; break; }
    ref=${ref#$'\n'}
    [[ $kind == (commit|tag) ]] && (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$oid" || continue
    case $ref in
      (refs/heads/*) label="${ref#refs/heads/} · branch" ;;
      (refs/tags/*) label="${ref#refs/tags/} · tag" ;;
      (refs/remotes/*) label="${ref#refs/remotes/} · remote-tracking" ;;
      (*) continue ;;
    esac
    _GIT_REVIEW_REFS+=("$ref") _GIT_REVIEW_REF_OIDS+=("$oid") _GIT_REVIEW_REF_LABELS+=("$label")
  done <<< "$_GIT_REVIEW_DATA"
  return 0
}

_git_review_commits_capture() {
  emulate -L zsh
  local root=$1 oid=$2 hash='' short='' date='' subject='' parents=''
  _git_review_reset
  (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$oid" || return 2
  _git_review_capture "$root" log --max-count=201 --date-order \
    --format='%H%x00%h%x00%cs%x00%s%x00%P%x00' "$oid" -- || return 2
  while IFS= read -r -d '' hash && IFS= read -r -d '' short &&
        IFS= read -r -d '' date && IFS= read -r -d '' subject &&
        IFS= read -r -d '' parents; do
    hash=${hash#$'\n'}
    (( ${#_GIT_REVIEW_PATHS} < 200 )) || { _GIT_REVIEW_TRUNCATED=1; break; }
    _GIT_REVIEW_PATHS+=("$hash") _GIT_REVIEW_KINDS+=(commit)
    _GIT_REVIEW_LABELS+=("$short · ${subject[1,512]}") _GIT_REVIEW_CONTEXTS+=("$date")
    _GIT_REVIEW_PARENTS+=("${parents%% *}")
    _GIT_REVIEW_DETAILS+=("${subject[1,512]}"$'\n'"$date"$'\n\n  '"$hash"$'\n\nEnter lists changed files.\nMerge commits compare with their first parent.\nRead-only · captured local history')
  done <<< "$_GIT_REVIEW_DATA"
  _GIT_REVIEW_SUMMARY='local history · read-only'
  (( _GIT_REVIEW_TRUNCATED )) && _GIT_REVIEW_SUMMARY+=' · first 200 / byte limit'
  return 0
}

_git_review_committed_files_capture() {
  emulate -L zsh
  local root=$1 oid=$2 before=$3 kind=$4 record='' added='' removed='' name='' summary=''
  local -a args=(diff)
  _git_review_reset
  (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$oid" || return 2
  [[ -z $before ]] || {
    (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$before"
  } || return 2
  [[ -n $before ]] || args=(diff-tree --root --no-commit-id -r)
  args+=(--numstat -z --no-renames --no-ext-diff --no-textconv --ignore-submodules=all)
  [[ -n $before ]] && args+=("$before")
  args+=("$oid" --)
  _git_review_capture "$root" "${args[@]}" || return 2
  while IFS= read -r -d '' record; do
    [[ $record == *$'\t'*$'\t'* ]] || continue
    added=${record%%$'\t'*} record=${record#*$'\t'}
    removed=${record%%$'\t'*} name=${record#*$'\t'}
    summary="+$added -$removed"
    [[ $added == '-' ]] && summary=Binary
    _GIT_REVIEW_PATHS+=("$name") _GIT_REVIEW_KINDS+=("$kind")
    _GIT_REVIEW_LABELS+=("$name") _GIT_REVIEW_CONTEXTS+=("$summary")
    _GIT_REVIEW_DETAILS+=("$name"$'\n'"$summary"$'\n\nEnter reads the committed diff.\nRead-only · no checkout')
    (( ${#_GIT_REVIEW_PATHS} >= 1000 )) && { _GIT_REVIEW_TRUNCATED=1; break; }
  done <<< "$_GIT_REVIEW_DATA"
  _GIT_REVIEW_SUMMARY="${#_GIT_REVIEW_PATHS} captured files · read-only"
  (( _GIT_REVIEW_TRUNCATED )) && _GIT_REVIEW_SUMMARY+=' · partial snapshot'
  return 0
}

_git_review_commit_files_capture() {
  _git_review_committed_files_capture "$1" "$2" "$3" commit || return $?
  _GIT_REVIEW_SUMMARY="${2[1,12]} · first-parent changes · $_GIT_REVIEW_SUMMARY"
}

_git_review_comparison_files_capture() {
  (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$3" || return 2
  _git_review_committed_files_capture "$1" "$2" "$3" comparison || return $?
  _GIT_REVIEW_SUMMARY="${_git_compare_method_label:-All differences} · ${1:t} · $_GIT_REVIEW_SUMMARY"
}

# Read only the selected regular file, never Git filters or an executable.
# Pin its physical parent in an isolated process; relative no-follow open and
# descriptor stat guard replacements without changing the caller directory or
# running hooks.
_git_review_untracked_read() {
  emulate -L zsh
  local absolute=$1 parent=$2 chunk='' data=''
  local -i fd=-1 result=0 total=0 amount=0
  local -A facts=()
  REPLY=''
  zmodload -F zsh/system b:sysopen b:sysread || return 2
  zmodload -F zsh/stat b:zstat || return 2
  builtin cd -q -P -- "$parent" 2>/dev/null || return 2
  [[ $PWD == "$parent" ]] || return 2
  {
    sysopen -r -o cloexec,nofollow,nonblock -u fd "./${absolute:t}" 2>/dev/null || return 2
    zstat -H facts -f $fd 2>/dev/null || return 2
    (( (facts[mode] & 8#170000) == 8#100000 )) || return 2
    while (( total < 262145 )); do
      chunk='' amount=0
      sysread -i $fd -s $(( 262145 - total )) -c amount chunk
      result=$?
      (( result == 5 )) && break
      (( result == 0 && amount > 0 )) || return 2
      data+=$chunk
      (( total += amount ))
    done
    REPLY=$data
  } always {
    (( fd >= 0 )) && exec {fd}<&-
  }
}

_git_review_untracked_capture() {
  emulate -L zsh
  local -x LC_ALL=C
  local absolute=$1 parent=${1:h} packet='' body=''
  local -i line_count=0 missing_newline=0
  local -a lines=()
  _GIT_REVIEW_DATA='' _GIT_REVIEW_TRUNCATED=0
  if [[ ${parent:A} != "$parent" ]]; then
    _GIT_REVIEW_DATA='Unavailable: the file parent changed or contains a symbolic link.'
    return 2
  elif [[ -L $absolute ]]; then
    _GIT_REVIEW_DATA='Symbolic link · untracked. The target is not followed or read.'
    return 0
  elif [[ -d $absolute ]]; then
    _GIT_REVIEW_DATA='Untracked folder · no file content to preview. Git may retain a nested repository as a folder; review that repository separately. Use Ctrl-R if this path changed.'
    return 0
  elif [[ ! -f $absolute ]]; then
    _GIT_REVIEW_DATA='Unavailable: the untracked path is missing or is not a regular file.'
    return 2
  fi
  if [[ -n ${_GIT_REVIEW_WORKER_DIR:-} ]]; then
    # The automatic worker is already isolated from the caller. Read directly
    # in that owned process so timeout/cancellation cannot orphan a nested file
    # reader; changing its private cwd has no effect on the review shell.
    _git_review_untracked_read "$absolute" "$parent" || {
      _GIT_REVIEW_DATA='Unavailable: the untracked file could not be read safely. Use Ctrl-R to refresh.'
      return 2
    }
    body=$REPLY
  else
    # Manual foreground capture still isolates its physical-parent cwd. The
    # child appends a NUL to protect real trailing newlines from substitution.
    packet=$( _git_review_untracked_read "$absolute" "$parent" || return 2
      print -rn -- "$REPLY"$'\0' ) || {
      _GIT_REVIEW_DATA='Unavailable: the untracked file could not be read safely. Use Ctrl-R to refresh.'
      return 2
    }
    body=${packet%$'\0'}
  fi
  if [[ $body == *$'\0'* ]]; then
    _GIT_REVIEW_DATA='Binary untracked file · a NUL byte was detected in the bounded capture. Content preview omitted.'
    return 0
  elif [[ -z $body ]]; then
    _GIT_REVIEW_DATA='Empty untracked file · no content yet.'
    return 0
  fi
  if (( ${#body} > 262144 )); then body=${body[1,262144]}; _GIT_REVIEW_TRUNCATED=1; fi
  lines=("${(@f)body}")
  if [[ $body == *$'\n' ]]; then lines[-1]=()
  else missing_newline=1; fi
  line_count=${#lines}
  # Keep conversion work at the document bound even for newline-only input.
  (( line_count > 10000 )) && lines=("${(@)lines[1,10000]}")
  # A new file is an all-additions patch in both context modes. Prefix every
  # source line so header-like content remains literal in the shared parser.
  lines=("${(@)lines/#/+}")
  _GIT_REVIEW_DATA="@@ -0,0 +1,$line_count @@"$'\n'"${(F)lines}"$'\n'
  (( missing_newline && !_GIT_REVIEW_TRUNCATED && line_count <= 10000 )) && _GIT_REVIEW_DATA+=$'\\ No newline at end of file\n'
  if (( ${#_GIT_REVIEW_DATA} > 262144 )); then
    _GIT_REVIEW_DATA=${_GIT_REVIEW_DATA[1,262144]} _GIT_REVIEW_TRUNCATED=1
  fi
  return 0
}

_git_review_diff_capture() {
  emulate -L zsh
  local root=${1:A} kind=$2 name=$3 oid=${4:-} parent=${5:-} context=${6:-3}
  local absolute="$root/$name"
  local -a args=(diff)
  _GIT_REVIEW_TRUNCATED=0 _GIT_REVIEW_DATA=''
  # Providers supply relative Git paths; reject malformed direct callers too.
  [[ -n $name && $name != /* && /$name/ != */../* && /$name/ != */./* ]] || return 2
  case $kind in
    (untracked)
      # Git can still report a nested repository with a trailing slash.
      _git_review_untracked_capture "${absolute%/}"
      return $? ;;
    (conflict)
      _GIT_REVIEW_DATA="${(C)kind}"$'\n\n'"$name"$'\n\nNo content preview for this kind.\nUse your normal Git tools to resolve or add it explicitly.'
      return 0 ;;
    (staged) args+=(--cached) ;;
    (unstaged)
      # Do not follow a replaced parent into an unrelated tree or read a FIFO.
      if [[ ${absolute:h:A} != "$root" && ${absolute:h:A} != $root/* ]] ||
         { [[ -e $absolute && ! -f $absolute && ! -L $absolute ]]; }; then
        _GIT_REVIEW_DATA='Unavailable: unsafe or special working-tree path.'
        return 2
      fi ;;
    (commit|comparison)
      (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$oid" || return 2
      [[ $kind != comparison || -n $parent ]] || return 2
      [[ -z $parent ]] || {
        (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$parent"
      } || return 2
      if [[ -n $parent ]]; then args+=("$parent" "$oid")
      else args=(show --format= --root "$oid"); fi ;;
    (*) return 2 ;;
  esac
  args+=(--no-ext-diff --no-textconv --no-color --no-renames --ignore-submodules=all
         --no-relative --default-prefix --word-diff=none --diff-algorithm=myers
         "--unified=$context" --inter-hunk-context=0 -- "$name")
  _git_review_capture "$root" "${args[@]}" || return 2
  if [[ -z $_GIT_REVIEW_DATA ]]; then
    if [[ $kind == comparison ]]; then _GIT_REVIEW_DATA='No differences between these captured versions for this file.'
    else _GIT_REVIEW_DATA='No diff remains for this selection. The working tree may have changed.'; fi
  fi
  return 0
}

# One continuous document, with old/new line numbers. Presentation stays in
# the shared renderer; Git headers and control bytes are never executable data.
_git_review_document_parse() {
  emulate -L zsh
  local line='' role='' old_label='' new_label=''
  local -a match=() mbegin=() mend=()
  local -i old=0 new=0 added=0 removed=0 in_hunk=0 partial=0
  _ZLE_PICKER_DOCUMENT_LINES=() _ZLE_PICKER_DOCUMENT_ROLES=()
  _GIT_REVIEW_DOCUMENT_OLD=() _GIT_REVIEW_DOCUMENT_NEW=()
  for line in "${(@f)_GIT_REVIEW_DATA}"; do
    [[ -z $line ]] && (( in_hunk )) && continue
    role=text old_label='' new_label=''
    if [[ $line == '@@ '* && $line =~ '^@@ -([0-9]+)(,[0-9]+)? \+([0-9]+)' ]]; then
      old=$(( 10#$match[1] )) new=$(( 10#$match[3] ))
      in_hunk=1 role=info
    elif (( in_hunk )); then
      case $line in
        (+*) new_label=$new; (( ++new, ++added )); role=success ;;
        (-*) old_label=$old; (( ++old, ++removed )); role=error ;;
        (' '*) old_label=$old new_label=$new; (( ++old, ++new )) ;;
      esac
      line="${(l:6:: :)old_label} ${(l:6:: :)new_label} $line"
    else
      case $line in
        ('diff --git '*|'index '*|'--- '*|'+++ '*) continue ;;
        (Unavailable:*|Limits:*) role=warning ;;
      esac
    fi
    _ZLE_PICKER_DOCUMENT_LINES+=("$line") _ZLE_PICKER_DOCUMENT_ROLES+=("$role")
    _GIT_REVIEW_DOCUMENT_OLD+=(${old_label:-0}) _GIT_REVIEW_DOCUMENT_NEW+=(${new_label:-0})
    if (( ${#_ZLE_PICKER_DOCUMENT_LINES} >= 10000 )); then partial=1; break; fi
  done
  _GIT_REVIEW_DOCUMENT_SUMMARY="+$added -$removed · read-only"
  _GIT_REVIEW_DOCUMENT_HAS_CODE=$in_hunk
  (( in_hunk )) || _GIT_REVIEW_DOCUMENT_SUMMARY='change metadata · read-only'
  if (( _GIT_REVIEW_TRUNCATED )); then
    partial=1
    _ZLE_PICKER_DOCUMENT_LINES+=('Limits: partial preview at 256 KiB. Use your file or Git tools for all content.')
    _ZLE_PICKER_DOCUMENT_ROLES+=(warning)
    _GIT_REVIEW_DOCUMENT_OLD+=(0) _GIT_REVIEW_DOCUMENT_NEW+=(0)
  elif (( partial )); then
    _ZLE_PICKER_DOCUMENT_LINES+=('Limits: first 10,000 document lines. Use your file or Git tools for the remaining content.')
    _ZLE_PICKER_DOCUMENT_ROLES+=(warning)
    _GIT_REVIEW_DOCUMENT_OLD+=(0) _GIT_REVIEW_DOCUMENT_NEW+=(0)
  fi
  (( partial )) && _GIT_REVIEW_DOCUMENT_SUMMARY+=' · partial'
  return 0
}

# A hunk header anchors to its following code; a trailing notice to prior code.
# New-side coordinates cover context/additions, old-side coordinates removals.
_git_review_document_anchor() {
  emulate -L zsh
  local -i row=$1 index=0 count=${#_GIT_REVIEW_DOCUMENT_NEW}
  REPLY=''
  (( row > 0 && count > 0 )) || return 0
  (( row > count )) && row=$count
  for (( index=row; index<=count; ++index )); do
    if (( _GIT_REVIEW_DOCUMENT_NEW[index] )); then REPLY="new:$_GIT_REVIEW_DOCUMENT_NEW[index]"; return 0
    elif (( _GIT_REVIEW_DOCUMENT_OLD[index] )); then REPLY="old:$_GIT_REVIEW_DOCUMENT_OLD[index]"; return 0; fi
  done
  for (( index=row-1; index>0; --index )); do
    if (( _GIT_REVIEW_DOCUMENT_NEW[index] )); then REPLY="new:$_GIT_REVIEW_DOCUMENT_NEW[index]"; return 0
    elif (( _GIT_REVIEW_DOCUMENT_OLD[index] )); then REPLY="old:$_GIT_REVIEW_DOCUMENT_OLD[index]"; return 0; fi
  done
  return 0
}

# Find the closest retained source line on the same side of the diff. Ordered
# traversal with strict improvement makes exact ties prefer earlier context.
_git_review_document_seek() {
  emulate -L zsh
  local anchor=$1
  local -a coordinates=()
  local -i target=0 index=0 distance=0 nearest=-1
  REPLY=0
  [[ ${anchor#*:} == <-> ]] || return 0
  target=${anchor#*:}
  case ${anchor%%:*} in
    (old) coordinates=("${_GIT_REVIEW_DOCUMENT_OLD[@]}") ;;
    (new) coordinates=("${_GIT_REVIEW_DOCUMENT_NEW[@]}") ;;
    (*) return 0 ;;
  esac
  # Exact expansion targets are common. Native literal lookup avoids a Zsh
  # loop over thousands of unchanged lines; gaps retain the nearest rule.
  index=${coordinates[(ie)$target]}
  if (( index <= ${#coordinates} )); then REPLY=$index; return 0; fi
  for (( index=1; index<=${#coordinates}; ++index )); do
    (( coordinates[index] )) || continue
    distance=$(( coordinates[index] - target ))
    (( distance < 0 )) && (( distance = -distance ))
    if (( nearest < 0 || distance < nearest )); then
      REPLY=$index nearest=$distance
      (( distance )) || break
    fi
  done
  return 0
}

# New files have identical content in both modes, including the refresh key.
_git_review_document_cache_key() {
  REPLY="$1:$2"
  [[ ${_GIT_REVIEW_KINDS[$1]} == untracked ]] && REPLY="$1:new"
  return 0
}

# Git syntax is optional presentation metadata, never part of document capture.
# Navigation must never wait for Vim: Terminal can repeat arrows faster than a
# syntax request plus paint, and serial waits turn valid input into a visible
# tail. One screen-session worker therefore runs requests asynchronously. The
# newest selected viewport is the only generation allowed to publish; completed
# stale work is discarded before it touches the reader.
#
# This is the same task rule used by mature terminal UIs: input owns the UI
# thread, expensive preview work runs separately, and latest selection wins.
# Supported source remains behind a stable pending surface until its validated
# tokens arrive, so the fix neither flushes input nor paints plain code first.
_git_review_syntax_cleanup() {
  emulate -L zsh
  _ZLE_PICKER_DOCUMENT_PENDING=0
  _git_syntax_status_note=''
  _git_syntax_active_key=''
  _git_syntax_active_note=''
  _git_syntax_active_first=0
  _git_syntax_active_last=0
  _git_syntax_active_epoch=0
  (( ${+functions[_git_syntax_session_stop]} )) && _git_syntax_session_stop
  return 0
}

_git_review_syntax_status() {
  emulate -L zsh
  local note=$1
  [[ -n ${_git_syntax_status_note:-} ]] &&
    _ZLE_PICKER_SUBTITLE=${_ZLE_PICKER_SUBTITLE% · $_git_syntax_status_note}
  _ZLE_PICKER_SUBTITLE=${_ZLE_PICKER_SUBTITLE% · syntax loads in viewport}
  _ZLE_PICKER_SUBTITLE=${_ZLE_PICKER_SUBTITLE% · syntax retry pending}
  [[ -n $note && $_ZLE_PICKER_SUBTITLE != *"$note"* ]] && _ZLE_PICKER_SUBTITLE+=" · $note"
  _git_syntax_status_note=$note
  _ZLE_PICKER_INSPECT_WIDTH=0
  return 0
}

_git_review_syntax_forget_failures() {
  emulate -L zsh
  local cache_key=$1 failure_key=''
  for failure_key in ${(k)_git_document_syntax_failures}; do
    [[ $failure_key == "$cache_key:"* ]] && unset "_git_document_syntax_failures[$failure_key]"
  done
  return 0
}

# A provider timeout, worker exit or invalid packet is scoped to one request.
# It is not deterministic coverage and must never poison every later file.
# Retry once after input settles; only a second failure for the same captured
# document window becomes an explicit plain fallback. Unsupported types and
# size/locale limits take the separate deterministic path below.
_git_review_syntax_transient_failure() {
  emulate -L zsh
  local cache_key=$1 failure_key="$1:$2:$3"
  local -i first=$2 last=$3 failures=$(( ${_git_document_syntax_failures[$failure_key]:-0} + 1 ))
  _git_document_syntax_failures[$failure_key]=$failures
  unset "_git_document_syntax_cache[$cache_key]" "_git_document_syntax_notes[$cache_key]" \
    "_git_document_syntax_first[$cache_key]" "_git_document_syntax_last[$cache_key]"
  _ZLE_PICKER_DOCUMENT_SYNTAX=()
  if (( failures < 2 )); then
    # Keep the stable loading surface through the retry boundary. This helper
    # runs during prepaint; clearing pending here would expose one plain source
    # frame before the next idle pass can start the replacement child.
    _ZLE_PICKER_DOCUMENT_PENDING=1
    _git_review_syntax_status 'syntax retry pending'
  else
    _ZLE_PICKER_DOCUMENT_PENDING=0
    _git_document_syntax_cache[$cache_key]=''
    _git_document_syntax_notes[$cache_key]='plain syntax · unavailable after retry'
    _git_document_syntax_first[$cache_key]=$first
    _git_document_syntax_last[$cache_key]=$last
    _git_review_syntax_status "${_git_document_syntax_notes[$cache_key]}"
  fi
  return 0
}

_git_review_syntax_idle() {
  emulate -L zsh
  local cache_key='' completed_key='' completed_data='' completed_note=''
  local failure_key=''
  local _GIT_SYNTAX_INPUT='' _GIT_SYNTAX_NOTE='' _GIT_SYNTAX_SUCCESS_NOTE=''
  local -i first=$_ZLE_PICKER_DOCUMENT_VISIBLE_FIRST last=$_ZLE_PICKER_DOCUMENT_VISIBLE_LAST
  local -i total=${#_ZLE_PICKER_DOCUMENT_LINES} span=0 guard=0 attempt_guard=0
  local -i desired_first=0 desired_last=0 covered_first=0 covered_last=0
  local -i refill_margin=0 current_covered=0 near_edge=0 poll_result=2 completed_id=0 changed=0
  local -i completed_first=0 completed_last=0 completed_epoch=0
  (( _ZLE_PICKER_DOCUMENT && first > 0 && last >= first && _GIT_REVIEW_DOCUMENT_HAS_CODE )) || return 2
  (( ${+functions[_git_syntax_prepare_input]} && ${+functions[_git_syntax_apply]} &&
     ${+functions[_git_syntax_session_request]} && ${+functions[_git_syntax_session_poll]} )) || return 2
  # During a navigation burst the selected list row intentionally outruns the
  # loaded document. Do not poll, schedule or publish syntax for that obsolete
  # reader; preview settlement will install the final exact document first.
  (( _ZLE_PICKER_SELECTED > 0 )) &&
    [[ ${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-} == "$_ZLE_PICKER_DOCUMENT_KEY" ]] || return 2
  _git_review_document_cache_key "$_ZLE_PICKER_DOCUMENT_KEY" "$context"
  cache_key=$REPLY
  covered_first=${_git_document_syntax_first[$cache_key]:-0}
  covered_last=${_git_document_syntax_last[$cache_key]:-0}
  (( covered_first > 0 && first >= covered_first && last <= covered_last )) && current_covered=1

  # Poll first, but publish only when the completed generation still describes
  # this exact selected document and covers its current source viewport.
  if (( _git_syntax_session_active_id )); then
    _git_syntax_session_poll
    poll_result=$?
    if (( poll_result == 0 || poll_result == 3 )); then
      completed_id=$REPLY
      completed_key=$_git_syntax_active_key
      completed_first=$_git_syntax_active_first
      completed_last=$_git_syntax_active_last
      completed_note=$_git_syntax_active_note
      completed_data=$_GIT_SYNTAX_DATA
      completed_epoch=$_git_syntax_active_epoch
      _git_syntax_active_key=''
      _git_syntax_active_note=''
      _git_syntax_active_first=0
      _git_syntax_active_last=0
      _git_syntax_active_epoch=0
      if [[ $completed_key == "$cache_key" ]] &&
         (( completed_epoch == _git_review_snapshot_epoch )) &&
         (( completed_id && first >= completed_first && last <= completed_last )); then
        if (( poll_result == 0 )) && _git_syntax_apply "$completed_data"; then
          _git_document_syntax_first[$cache_key]=$completed_first
          _git_document_syntax_last[$cache_key]=$completed_last
          _git_document_syntax_cache[$cache_key]=$completed_data
          _git_document_syntax_notes[$cache_key]=$completed_note
          unset "_git_document_syntax_failures[$cache_key:$completed_first:$completed_last]"
          _ZLE_PICKER_DOCUMENT_PENDING=0
          _git_review_syntax_status "${_git_document_syntax_notes[$cache_key]}"
        elif (( current_covered )); then
          # A speculative read-ahead failure must not discard the highlighted
          # rows that still cover the reader. Retain that atomic frame and let
          # a later, genuinely uncovered viewport make its own bounded request.
          failure_key="$cache_key:$completed_first:$completed_last"
          _git_document_syntax_failures[$failure_key]=$(( ${_git_document_syntax_failures[$failure_key]:-0} + 1 ))
          _ZLE_PICKER_DOCUMENT_PENDING=0
        else
          _git_review_syntax_transient_failure "$cache_key" $completed_first $completed_last
        fi
        return 0
      fi
      # A newer selection won while Vim was working. Its state is derived
      # below; the stale response is deliberately neither cached nor painted.
    elif (( poll_result == 1 )); then
      :
    else
      # No active packet remains; readiness may have arrived independently.
    fi
  else
    _git_syntax_session_poll >/dev/null 2>&1
  fi

  # One highlighted window spans several reader pages. Refill it while the
  # current page is still covered, two visible pages before either interior
  # edge. The existing colored frame remains installed until the complete new
  # response validates, so line and Option/Fn-page navigation never reveal a
  # blank or plain intermediate frame during ordinary forward progress.
  span=$(( last - first + 1 ))
  (( span < 1 )) && span=1
  guard=$(( span * 3 ))
  (( guard < 8 )) && guard=8
  (( guard > 256 )) && guard=256
  refill_margin=$(( span * 2 ))
  (( refill_margin > guard )) && refill_margin=$guard
  if (( current_covered )); then
    (( covered_first > 1 && first - covered_first <= refill_margin )) && near_edge=1
    (( covered_last < total && covered_last - last <= refill_margin )) && near_edge=1
    _ZLE_PICKER_DOCUMENT_PENDING=0
    (( near_edge )) || return 2
  fi

  # A single resident Vim request owns the worker. If this is proactive
  # read-ahead, keep polling behind the already-highlighted frame. Only a truly
  # uncovered viewport uses the explicit loading surface.
  if (( _git_syntax_session_active_id )); then
    if (( current_covered )); then
      return 1
    fi
    if (( !_ZLE_PICKER_DOCUMENT_PENDING )); then
      _ZLE_PICKER_DOCUMENT_PENDING=1
      _git_review_syntax_status ''
      _ZLE_PICKER_SUBTITLE+=' · syntax loads in viewport'
      return 0
    fi
    return 1
  fi

  # Large terminals or unusually long source rows can make a multi-page window
  # exceed the syntax adapter's independent byte bound. Shrink only the
  # read-ahead margin; the visible viewport itself is never truncated.
  attempt_guard=$guard
  while true; do
    desired_first=$(( first - attempt_guard ))
    desired_last=$(( last + attempt_guard ))
    (( desired_first < 1 )) && desired_first=1
    (( desired_last > total )) && desired_last=$total
    _git_syntax_prepare_input "$_ZLE_PICKER_DOCUMENT_TITLE" $desired_first $desired_last
    [[ -n $_GIT_SYNTAX_INPUT ]] && break
    if [[ $_GIT_SYNTAX_NOTE == 'plain syntax · size limit' ]] && (( attempt_guard > 2 )); then
      attempt_guard=$(( attempt_guard / 2 ))
      (( attempt_guard < 2 )) && attempt_guard=2
      continue
    fi
    break
  done

  if (( current_covered )); then
    # Boundary clamping can make the desired window identical to the installed
    # one. A failed speculative request is also suppressed until navigation
    # establishes a different desired window; the current colors remain valid.
    (( desired_first == covered_first && desired_last == covered_last )) && return 2
    failure_key="$cache_key:$desired_first:$desired_last"
    (( ${_git_document_syntax_failures[$failure_key]:-0} > 0 )) && return 2
  fi

  # Unsupported or bounded-out content has an immediate explicit plain state;
  # only supported code waits behind the stable pending surface.
  if [[ -z $_GIT_SYNTAX_INPUT ]]; then
    (( current_covered )) && return 2
    _git_document_syntax_cache[$cache_key]=''
    _git_document_syntax_notes[$cache_key]=$_GIT_SYNTAX_NOTE
    if [[ $_GIT_SYNTAX_NOTE == ('plain syntax · unsupported type'|'plain syntax · system Vim unavailable'|'plain syntax · UTF-8 locale required') ]]; then
      _git_document_syntax_first[$cache_key]=1
      _git_document_syntax_last[$cache_key]=$total
    else
      _git_document_syntax_first[$cache_key]=$desired_first
      _git_document_syntax_last[$cache_key]=$desired_last
    fi
    _ZLE_PICKER_DOCUMENT_PENDING=0
    _git_review_syntax_status "$_GIT_SYNTAX_NOTE"
    return 0
  fi

  _git_syntax_session_request "$_GIT_SYNTAX_INPUT"
  case $? in
    (0)
      _git_syntax_active_key=$cache_key
      _git_syntax_active_first=$desired_first
      _git_syntax_active_last=$desired_last
      _git_syntax_active_note=$_GIT_SYNTAX_SUCCESS_NOTE
      _git_syntax_active_epoch=$_git_review_snapshot_epoch
      if (( current_covered )); then
        _ZLE_PICKER_DOCUMENT_PENDING=0
      else
        _ZLE_PICKER_DOCUMENT_PENDING=1
        _git_review_syntax_status ''
        _ZLE_PICKER_SUBTITLE+=' · syntax loads in viewport'
      fi
      return 0 ;;
    (2)
      # Vim has completed a stale response but its next ready marker has not
      # arrived yet. A later idle poll submits this same latest selection.
      if (( current_covered )); then
        _ZLE_PICKER_DOCUMENT_PENDING=0
        return 1
      elif (( !_ZLE_PICKER_DOCUMENT_PENDING )); then
        _ZLE_PICKER_DOCUMENT_PENDING=1
        _git_review_syntax_status ''
        _ZLE_PICKER_SUBTITLE+=' · syntax loads in viewport'
        return 0
      fi
      return 1 ;;
    (*)
      if (( current_covered )); then
        failure_key="$cache_key:$desired_first:$desired_last"
        _git_document_syntax_failures[$failure_key]=$(( ${_git_document_syntax_failures[$failure_key]:-0} + 1 ))
        _ZLE_PICKER_DOCUMENT_PENDING=0
      else
        _git_review_syntax_transient_failure "$cache_key" $desired_first $desired_last
      fi
      return 0 ;;
  esac
}

# At most four captured patches per workspace, plus small per-file bookmarks.
# Loading is a controller operation after the input loop returns, never paint.
# Optional syntax is applied from the small visited-document cache; a missing
# viewport is scheduled and polled without blocking at the idle boundary above.
_git_review_document_load() {
  emulate -L zsh
  local root=$1 index=$2 oid=$3 parent=$4 context=$5 cache_key='' stale=''
  local name=${_GIT_REVIEW_PATHS[index]} kind=${_GIT_REVIEW_KINDS[index]}
  local anchor='' previous=$_ZLE_PICKER_DOCUMENT_KEY
  local -i captured=0
  # Direct/standalone callers may omit the optional syntax cache owner.
  if (( !${+_git_document_syntax_cache} )); then
    local -A _git_document_syntax_cache=() _git_document_syntax_notes=()
    local -A _git_document_syntax_first=() _git_document_syntax_last=()
  fi
  if (( !${+_git_document_syntax_failures} )); then
    local -A _git_document_syntax_failures=()
  fi
  _git_review_document_cache_key "$index" "$context"
  cache_key=$REPLY context=${REPLY#*:}
  # The old document still owns these coordinates after the input loop returns
  # a new exact selection and before its replacement document is installed.
  if [[ -n $previous ]]; then
    _git_review_document_anchor "${_ZLE_PICKER_DOCUMENT_ROWS[$previous]:-0}"
    [[ -n $REPLY ]] && _git_document_anchors[$previous]=$REPLY
  fi
  if [[ -z ${_git_document_cache[$cache_key]+present} ]]; then
    captured=1
    if (( ${_git_review_reads_blocked:-0} )); then
      _GIT_REVIEW_DATA='Unavailable: Git safety configuration could not be refreshed. Use Ctrl-R to retry.'
      _GIT_REVIEW_TRUNCATED=0
    elif ! _git_review_diff_capture "$root" "$kind" "$name" "$oid" "$parent" "$context"; then
      [[ $kind == untracked && $_GIT_REVIEW_DATA == Unavailable:* ]] ||
      _GIT_REVIEW_DATA='Unavailable: Git could not read this diff. Use Ctrl-R to refresh; Escape returns.'
    fi
    _git_document_cache[$cache_key]=$_GIT_REVIEW_DATA
    _git_document_partial[$cache_key]=$_GIT_REVIEW_TRUNCATED
  fi
  _git_document_order=("${(@)_git_document_order:#$cache_key}" "$cache_key")
  if (( ${#_git_document_order} > 4 )); then
    stale=$_git_document_order[1]
    unset "_git_document_cache[$stale]" "_git_document_partial[$stale]" \
      "_git_document_syntax_cache[$stale]" "_git_document_syntax_notes[$stale]" \
      "_git_document_syntax_first[$stale]" "_git_document_syntax_last[$stale]"
    _git_review_syntax_forget_failures "$stale"
    _git_document_order[1]=()
  fi
  _GIT_REVIEW_DATA=${_git_document_cache[$cache_key]}
  _GIT_REVIEW_TRUNCATED=${_git_document_partial[$cache_key]}
  _git_review_document_parse
  _ZLE_PICKER_DOCUMENT_PENDING=0
  _ZLE_PICKER_DOCUMENT_SYNTAX=()
  if (( ${+functions[_git_syntax_prepare_input]} && ${+functions[_git_syntax_apply]} && _GIT_REVIEW_DOCUMENT_HAS_CODE )); then
    if (( captured )); then
      unset "_git_document_syntax_cache[$cache_key]" "_git_document_syntax_notes[$cache_key]" \
        "_git_document_syntax_first[$cache_key]" "_git_document_syntax_last[$cache_key]"
      _git_review_syntax_forget_failures "$cache_key"
    fi
    if [[ -n ${_git_document_syntax_cache[$cache_key]} ]] &&
       ! _git_syntax_apply "${_git_document_syntax_cache[$cache_key]}"; then
      _git_document_syntax_notes[$cache_key]='plain syntax · invalid token data'
    fi
  fi
  _ZLE_PICKER_DOCUMENT_MODE=''
  if [[ $kind != untracked ]] && (( _GIT_REVIEW_DOCUMENT_HAS_CODE )); then
    [[ $context == 3 ]] && _ZLE_PICKER_DOCUMENT_MODE=focused || _ZLE_PICKER_DOCUMENT_MODE=full
  fi
  _ZLE_PICKER_DOCUMENT_TARGET_ROW=0
  if [[ -n ${_git_document_contexts[$index]-} && ${_git_document_contexts[$index]} != "$context" ]]; then
    anchor=${_git_document_anchors[$index]-}
    _git_review_document_seek "$anchor"
    _ZLE_PICKER_DOCUMENT_TARGET_ROW=$REPLY
    _ZLE_PICKER_DOCUMENT_OFFSETS[$index]=0
    if (( REPLY )); then
      local coordinate=$_GIT_REVIEW_DOCUMENT_NEW[REPLY]
      [[ $anchor == old:* ]] && coordinate=$_GIT_REVIEW_DOCUMENT_OLD[REPLY]
      [[ $coordinate == ${anchor#*:} ]] || _GIT_REVIEW_DOCUMENT_SUMMARY+=' · nearest retained context'
    fi
  fi
  _git_document_contexts[$index]=$context
  _ZLE_PICKER_DOCUMENT_KEY=$index
  _ZLE_PICKER_DOCUMENT_TITLE=$name
  _git_review_status_apply >/dev/null
  _ZLE_PICKER_SUBTITLE="${root:t} · $kind · full-file context · captured on selection"
  [[ $context == 3 ]] && _ZLE_PICKER_SUBTITLE="${root:t} · $kind · focused diff · 3 context lines · captured on selection"
  [[ $kind == untracked ]] && _ZLE_PICKER_SUBTITLE="${root:t} · untracked · new-file preview · captured on selection"
  [[ $kind == comparison ]] && _ZLE_PICKER_SUBTITLE="$_git_compare_context · ${root:t}"
  _git_syntax_status_note=${_git_document_syntax_notes[$cache_key]-}
  [[ -n $_git_syntax_status_note ]] && _ZLE_PICKER_SUBTITLE+=" · $_git_syntax_status_note"
  (( ${+functions[_git_syntax_prepare_input]} && _GIT_REVIEW_DOCUMENT_HAS_CODE )) &&
    [[ -z ${_git_document_syntax_cache[$cache_key]+present} ]] && _ZLE_PICKER_SUBTITLE+=' · syntax loads in viewport'
  return 0
}

# Adapt a view snapshot to the existing navigation ranker. Numeric IDs remain
# independent of literal path values (one file may have two change rows).
_git_review_rows() {
  local -i index=0
  local context='' path=''
  _NAVIGATION_PICKER_VALUES=() _NAVIGATION_PICKER_INDEXES=()
  _NAVIGATION_PICKER_LABELS=("${_GIT_REVIEW_LABELS[@]}")
  _NAVIGATION_PICKER_SEARCH_LABELS=()
  _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_INSPECT_TEXTS=()
  for (( index=1; index<=${#_GIT_REVIEW_LABELS}; ++index )); do
    _NAVIGATION_PICKER_VALUES+=("$index") _NAVIGATION_PICKER_INDEXES+=("$index")
    _NAVIGATION_PICKER_SEARCH_LABELS+=("${_GIT_REVIEW_LABELS[index]} ${_GIT_REVIEW_CONTEXTS[index]-}")
    context=${_GIT_REVIEW_CONTEXTS[index]-}
    if [[ ${_GIT_REVIEW_KINDS[index]-} == untracked ]]; then
      # Keep identity and state separate. File projections supply the final
      # labels; the narrow metadata column gets one complete human word.
      # Canonical Git wording remains in facts, search and details.
      context='New'
    fi
    _ZLE_PICKER_CONTEXTS[$index]=$context
    if (( ${_ZLE_PICKER_DOCUMENT:-0} )); then
      path=${_GIT_REVIEW_PATHS[index]}
      if [[ ${_GIT_REVIEW_KINDS[index]-} == untracked && $path == */* && $path != */ ]]; then
        _NAVIGATION_PICKER_LABELS[index]=$path
      else
        _NAVIGATION_PICKER_LABELS[index]=${path:t}
      fi
    fi
    _ZLE_PICKER_INSPECT_TEXTS[$index]=${_GIT_REVIEW_DETAILS[index]-}
  done
}

# Project the same bounded matching results into either a compact tree or a
# flat navigator. No provider reads: even deleted folders are captured prefixes.
_git_review_file_collect() {
  emulate -L zsh
  (( ${+functions[_navigation_picker_collect]} )) || return 1
  local query=$1 exclusion=${_ZLE_PICKER_EXCLUDE:-} value='' name='' parent=''
  local -i limit=$2 index=0
  local -i _git_tree_summary_limit=${3:-$2}
  local prepared_branch='' prepared_text=''
  if [[ -n ${_ZLE_PICKER_DOCUMENT_BRANCHES[$_ZLE_PICKER_INSPECT_KEY]-} ]]; then
    prepared_branch=$_ZLE_PICKER_INSPECT_KEY
    prepared_text=${_ZLE_PICKER_INSPECT_TEXTS[$prepared_branch]-}
    # The next projection may hide this folder, removing the branch capability
    # needed by the ordinary inspector transition to save its current offset.
    (( ${+functions[_zle_picker_document_bookmark]} )) && _zle_picker_document_bookmark
  fi
  for value in "${(@k)_ZLE_PICKER_DOCUMENT_BRANCHES}"; do
    unset "_ZLE_PICKER_CONTEXTS[$value]" "_ZLE_PICKER_INSPECT_TEXTS[$value]"
  done
  _navigation_picker_collect "$query" 1001
  local -a matches=("${_ZLE_PICKER_RESULTS[@]}")
  _ZLE_PICKER_DOCUMENT_BRANCHES=() _ZLE_PICKER_ACCEPT_LABELS=() _git_tree_depths=()
  _ZLE_PICKER_LABEL_PREFIXES=()
  if [[ $_git_file_view == flat ]]; then
    local -A names=() duplicates=()
    for value in "${matches[@]}"; do
      name=${_GIT_REVIEW_PATHS[value]:t}
      [[ -n ${names[$name]-} && ${names[$name]} != "${_GIT_REVIEW_PATHS[value]}" ]] && duplicates[$name]=1
      names[$name]=${_GIT_REVIEW_PATHS[value]}
    done
    _ZLE_PICKER_LABELS=()
    for value in "${matches[@]}"; do
      name=${_GIT_REVIEW_PATHS[value]:t}
      if [[ -n ${duplicates[$name]-} ]]; then
        parent=${_GIT_REVIEW_PATHS[value]:h}
        name+=" · $parent/"
      fi
      _ZLE_PICKER_LABELS+=("$name")
    done
    _ZLE_PICKER_QUERY_LABEL='Filter all files'
    _git_file_location='All files'
  else
    # Filter navigation has its own temporary scope and folds. Clearing both
    # fields restores the unfiltered tree rather than leaving it opened by search.
    if [[ $query != "$_git_tree_filter" || $exclusion != "$_git_tree_exclude" ]]; then
      _git_tree_filter=$query _git_tree_exclude=$exclusion
      _git_tree_filter_scope='' _git_tree_filter_expanded=()
      _git_tree_filter_scopes=() _git_tree_filter_returns=()
    fi
    local scope=$_git_tree_scope
    local -A expanded=("${(@kv)_git_tree_expanded}")
    if [[ -n $query || -n $exclusion ]]; then
      scope=$_git_tree_filter_scope
      expanded=("${(@kv)_git_tree_filter_expanded}")
    fi
    _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
    if [[ -n $scope ]]; then
      value="d:$scope"
      local -i scoped_count=0
      for index in "${matches[@]}"; do
        [[ ${_GIT_REVIEW_PATHS[index]} == "$scope"* ]] && (( ++scoped_count ))
      done
      if (( scoped_count )); then
        _ZLE_PICKER_RESULTS=("$value")
        _ZLE_PICKER_DOCUMENT_BRANCHES[$value]=1
        _git_tree_depths[$value]=-1
        _ZLE_PICKER_CONTEXTS[$value]="$scoped_count changes"
        _ZLE_PICKER_INSPECT_TEXTS[$value]=$scope
        if (( _git_tree_summary_limit )); then
          _git_review_folder_summary "$scope" "${matches[@]}"
          _ZLE_PICKER_INSPECT_TEXTS[$value]=$REPLY
        fi
        if (( ${expanded[$scope]:-1} )); then
          _ZLE_PICKER_LABELS=("▾ ${${scope%/}:t}/")
          _ZLE_PICKER_LABEL_PREFIXES[$value]='▾ '
          _ZLE_PICKER_ACCEPT_LABELS[$value]=collapse
          _git_review_tree_rows "$scope" 1 "${matches[@]}"
        else
          _ZLE_PICKER_LABELS=("▸ ${${scope%/}:t}/")
          _ZLE_PICKER_LABEL_PREFIXES[$value]='▸ '
          _ZLE_PICKER_ACCEPT_LABELS[$value]=expand
        fi
      fi
    else
      _git_review_tree_rows '' 0 "${matches[@]}"
    fi
    _ZLE_PICKER_QUERY_LABEL='Filter all changes'
    _git_file_location="Tree · ${scope:-Repository}"
    [[ -n $query || -n $exclusion ]] && _git_file_location+=" · ${#matches} matching changes"
  fi
  _ZLE_PICKER_RESULTS=("${_ZLE_PICKER_RESULTS[@]:0:$limit}")
  _ZLE_PICKER_LABELS=("${_ZLE_PICKER_LABELS[@]:0:$limit}")
  _ZLE_PICKER_RESULT_INDEXES=("${_ZLE_PICKER_RESULTS[@]/*/1}")
  # A refinement can change a folder summary without changing its exact key.
  # Rewrap its new captured text while retaining independent scroll offsets.
  if [[ -n $prepared_branch && $prepared_text != "${_ZLE_PICKER_INSPECT_TEXTS[$prepared_branch]-}" ]]; then
    _ZLE_PICKER_INSPECT_WIDTH=0
  fi
  return 0
}

_git_review_file_subtitle() {
  local -i width=$1 location_width=$(( $1 / 3 ))
  local location='' source=''
  local value=${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-}
  if [[ -n ${_ZLE_PICKER_DOCUMENT_BRANCHES[$value]-} ]]; then
    local _ZLE_PICKER_SUBTITLE="${root:t} · captured folder · read-only"
    [[ $kind == comparison ]] && _ZLE_PICKER_SUBTITLE="$_git_compare_context · ${root:t} · captured folder"
  fi
  _zle_picker_abbreviate "$_git_file_location" $location_width
  location=$REPLY
  if [[ $kind == comparison ]]; then
    _git_review_comparison_subtitle $(( width - location_width - 3 ))
    source=$REPLY
  else
    _zle_picker_abbreviate "$_ZLE_PICKER_SUBTITLE" $(( width - location_width - 3 ))
    source=$REPLY
  fi
  REPLY="$location · $source"
}

# Summarize only the matching captured entries beneath this exact prefix.
# Directory names and bars are passive information, never new action targets.
_git_review_folder_summary() {
  emulate -L zsh
  local directory=$1 name='' tail='' area='' state='' label='' bar='' item='' added='' removed=''
  shift
  local -i index=0 count=0 direct=0 filled=0 shown=0
  local -i additions=0 removals=0 binaries=0 line_entries=0 missing_totals=0
  local -A paths=() folders=() states=() areas=()
  local -a ranked=() lines=()
  for index in "$@"; do
    name=${_GIT_REVIEW_PATHS[index]}
    [[ $name == "$directory"* ]] || continue
    (( ++count ))
    state=${_GIT_REVIEW_KINDS[index]:-unknown}
    (( ++states[$state] ))
    if [[ $state == (commit|comparison) ]]; then
      item=${_GIT_REVIEW_CONTEXTS[index]}
      if [[ $item == Binary ]]; then
        (( ++binaries ))
      elif [[ $item == +<->' -'<-> ]]; then
        added=${${item%% *}#+} removed=${item##* -}
        if (( ${#added} <= 10 && ${#removed} <= 10 )); then
          (( additions += 10#$added, removals += 10#$removed, ++line_entries ))
        else
          (( ++missing_totals ))
        fi
      else
        (( ++missing_totals ))
      fi
    fi
    tail=${name#"$directory"}
    if [[ $tail == */?* ]]; then
      area="${tail%%/*}/"
      folders[$area]=1
    else
      area=''
      [[ -n ${paths[$name]-} ]] || (( ++direct ))
    fi
    paths[$name]=1
    # Prefix the literal area so an empty direct group has an ordinary key.
    (( ++areas[d:$area] ))
  done
  lines=("Captured path" "${(V)directory}" ''
    "$count change entries · ${#paths} distinct paths"
    "Direct paths: $direct · Child folders: ${#folders}" '')
  (( line_entries || binaries )) && lines+=("Lines: +$additions -$removals · Binary entries: $binaries" '')
  (( missing_totals )) && lines+=("Incomplete line totals · Entries without totals: $missing_totals" '')
  for state label in staged Staged unstaged Unstaged untracked New conflict Conflicts commit Committed comparison Compared unknown Other; do
    if (( ${states[$state]:-0} )); then
      filled=$(( (16 * states[$state] + count - 1) / count ))
      bar=${(l:$filled::━:)}
      lines+=("$label: ${states[$state]}  $bar")
    fi
  done
  lines+=('' 'Where changes are')
  for area in "${(@k)areas}"; do
    ranked+=("${(l:4::0:)areas[$area]} $area")
  done
  # Captures hold at most 1,000 entries, so four digits sort counts exactly.
  for item in "${(@On)ranked}"; do
    (( ++shown <= 6 )) || break
    area=${item#* } label=${area#d:}
    [[ -n $label ]] || label='Direct entries'
    label=${(V)label}
    filled=$(( (16 * areas[$area] + count - 1) / count ))
    bar=${(l:$filled::━:)}
    lines+=("$bar  ${areas[$area]}  $label")
  done
  (( ${#areas} > 6 )) && lines+=("… $(( ${#areas} - 6 )) more areas in this folder")
  lines+=('' 'Bars count change entries; staged and unstaged count separately.')
  if [[ -n $_git_tree_filter || -n $_git_tree_exclude ]]; then
    lines+=('Filtered captured changes · clear filters to see the captured scope.')
  else
    lines+=('Captured changes only · unchanged and ignored paths are not listed.')
  fi
  [[ $_GIT_REVIEW_SUMMARY == *'partial snapshot'* ]] && lines+=('Partial snapshot · counts cover captured entries only.')
  REPLY=${(F)lines}
}

_git_review_file_browse() {
  local value=${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-}
  if [[ -n ${_ZLE_PICKER_DOCUMENT_BRANCHES[$value]-} ]]; then
    REPLY="${_git_review_refresh_status}${_git_review_refresh_status:+ · }$_GIT_REVIEW_SUMMARY · Folder summary"
  else
    REPLY=$_ZLE_PICKER_BROWSE_LABEL
  fi
}

# Retain exact row identity across a projection change. The reader key remains
# the original numeric change entry, independently of directory selection.
_git_review_file_reselect() {
  local wanted=$1
  local _ZLE_PICKER_EXCLUDE=${bookmark[4]-}
  # Resolve ranks only. The input loop recollects its retained prefix before
  # painting, so summaries outside that prefix need not be built here.
  _git_review_file_collect "${bookmark[1]}" 10000 0
  local -i rank=${_ZLE_PICKER_RESULTS[(Ie)$wanted]}
  if (( !rank )) && [[ $wanted == <-> && -n ${_GIT_REVIEW_PATHS[wanted]-} ]]; then
    local value='' directory=''
    for value in "${_ZLE_PICKER_RESULTS[@]}"; do
      [[ $value == d:* ]] || continue
      directory=${value#d:}
      [[ ${_GIT_REVIEW_PATHS[wanted]} == "$directory"* ]] && rank=${_ZLE_PICKER_RESULTS[(Ie)$value]}
    done
  fi
  bookmark[2]=${rank:-1}
  (( rank )) || bookmark[3]=0
  return 0
}

_git_review_tree_reconcile() {
  emulate -L zsh
  local directory='' pattern='' scope=''
  local -a components=()
  local -i lower=0 upper=0 middle=0
  for directory in "${(@k)_git_tree_expanded}"; do
    pattern="${(b)directory}*"
    (( ${_GIT_REVIEW_PATHS[(I)${~pattern}]} )) || unset "_git_tree_expanded[$directory]"
  done
  for directory in "${(@k)_git_tree_filter_expanded}"; do
    pattern="${(b)directory}*"
    (( ${_GIT_REVIEW_PATHS[(I)${~pattern}]} )) || unset "_git_tree_filter_expanded[$directory]"
  done
  for scope in normal filter; do
    directory=$_git_tree_scope
    [[ $scope == filter ]] && directory=$_git_tree_filter_scope
    if [[ -n $directory ]]; then
      pattern="${(b)directory}*"
      if (( !${_GIT_REVIEW_PATHS[(I)${~pattern}]} )); then
        # Surviving prefixes form one continuous ancestor chain. Binary search
        # its depth instead of rescanning a shrinking path for every component.
        components=("${(@s:/:)${directory%/}}")
        lower=0 upper=$(( ${#components} - 1 ))
        while (( lower < upper )); do
          middle=$(( (lower + upper + 1) / 2 ))
          directory="${(j:/:)components[1,middle]}/"
          pattern="${(b)directory}*"
          if (( ${_GIT_REVIEW_PATHS[(I)${~pattern}]} )); then
            lower=$middle
          else
            upper=$(( middle - 1 ))
          fi
        done
        directory=''
        (( lower )) && directory="${(j:/:)components[1,lower]}/"
      fi
    fi
    [[ $scope == filter ]] && _git_tree_filter_scope=$directory || _git_tree_scope=$directory
  done
  return 0
}

_git_review_file_switch() {
  emulate -L zsh
  local next=$1 selected=$2 saved_value='' saved_document='' directory=''
  local -a saved_bookmark=()
  [[ $next == "$_git_file_view" ]] && return 0
  if [[ $_git_file_view == tree ]]; then
    _git_tree_bookmark=("${bookmark[@]}") _git_tree_selected=$selected
    _git_tree_document=$_ZLE_PICKER_DOCUMENT_KEY
    saved_bookmark=("${_git_flat_bookmark[@]}") saved_value=$_git_flat_selected saved_document=$_git_flat_document
  else
    _git_flat_bookmark=("${bookmark[@]}") _git_flat_selected=$selected
    _git_flat_document=$_ZLE_PICKER_DOCUMENT_KEY
    saved_bookmark=("${_git_tree_bookmark[@]}") saved_value=$_git_tree_selected saved_document=$_git_tree_document
  fi
  _git_file_view=$next
  if (( ${#saved_bookmark} )) && [[ $saved_document == "$_ZLE_PICKER_DOCUMENT_KEY" &&
        ${saved_bookmark[1]} == "${bookmark[1]}" && ${saved_bookmark[4]-} == "${bookmark[4]-}" ]]; then
    bookmark[3]=${saved_bookmark[3]}
    _git_review_file_reselect "$saved_value"
    return 0
  fi
  [[ $selected == d:* ]] && selected=$_ZLE_PICKER_DOCUMENT_KEY
  bookmark[3]=0
  _git_review_file_reselect "$selected"
  if [[ $next == tree && $selected == <-> && ${_ZLE_PICKER_RESULTS[(Ie)$selected]} == 0 ]]; then
    directory=${_GIT_REVIEW_PATHS[selected]:h}
    [[ $directory == . ]] && directory='' || directory+=/
    _git_review_tree_scope_set "$directory"
    if [[ -n $directory ]]; then
      if [[ -n ${bookmark[1]} || -n ${bookmark[4]-} ]]; then
        _git_tree_filter_expanded[$directory]=1
      else
        _git_tree_expanded[$directory]=1
      fi
    fi
    _git_review_file_reselect "$selected"
  fi
  return 0
}

_git_review_tree_scope_set() {
  if [[ -n ${bookmark[1]} || -n ${bookmark[4]-} ]]; then
    _git_tree_filter_scope=$1
  else
    _git_tree_scope=$1
  fi
}

_git_review_tree_enter() {
  local value=$1 directory=${1#d:}
  local -i depth=${_git_tree_depths[$value]:-0}
  if (( depth >= 3 )); then
    if [[ -n ${bookmark[1]} || -n ${bookmark[4]-} ]]; then
      _git_tree_filter_scopes+=("$_git_tree_filter_scope")
      _git_tree_filter_returns+=("$value" "${bookmark[3]}")
    else
      _git_tree_scopes+=("$_git_tree_scope")
      _git_tree_returns+=("$value" "${bookmark[3]}")
    fi
    _git_review_tree_scope_set "$directory"
    bookmark[2]=1 bookmark[3]=0
  else
    if [[ -n ${bookmark[1]} || -n ${bookmark[4]-} ]]; then
      _git_tree_filter_expanded[$directory]=$(( !${_git_tree_filter_expanded[$directory]:-1} ))
    else
      _git_tree_expanded[$directory]=$(( !${_git_tree_expanded[$directory]:-1} ))
    fi
    _git_review_file_reselect "$value"
  fi
  focus=0
}

_git_review_tree_back() {
  [[ $_git_file_view == tree ]] || return 1
  local scope=$_git_tree_scope wanted='' offset=0
  if [[ -n ${bookmark[1]} || -n ${bookmark[4]-} ]]; then
    scope=$_git_tree_filter_scope
    [[ -n $scope ]] || return 1
    if (( ${#_git_tree_filter_scopes} )); then
      scope=$_git_tree_filter_scopes[-1] wanted=$_git_tree_filter_returns[-2] offset=$_git_tree_filter_returns[-1]
      _git_tree_filter_scopes[-1]=() _git_tree_filter_returns[-2,-1]=()
    else
      scope=''
    fi
  else
    [[ -n $scope ]] || return 1
    if (( ${#_git_tree_scopes} )); then
      scope=$_git_tree_scopes[-1] wanted=$_git_tree_returns[-2] offset=$_git_tree_returns[-1]
      _git_tree_scopes[-1]=() _git_tree_returns[-2,-1]=()
    else
      scope=''
    fi
  fi
  _git_review_tree_scope_set "$scope"
  _git_review_tree_reconcile
  bookmark[3]=$offset
  _git_review_file_reselect "$wanted"
  focus=0
  return 0
}

_git_review_file_options_view() {
  local captured_path=$1 option=''
  _ZLE_PICKER_TITLE='Git / View options'
  _ZLE_PICKER_SUBTITLE='Same captured changes · read-only'
  _ZLE_PICKER_COLLECTOR=_navigation_picker_collect
  _ZLE_PICKER_INSPECT_ACTION=choose
  local -a _NAVIGATION_PICKER_VALUES=(flat tree ancestor atlas)
  local -a _NAVIGATION_PICKER_LABELS=('All files' Tree 'Jump to ancestor' 'Change atlas')
  local -a _NAVIGATION_PICKER_INDEXES=(1 2 3 4) _NAVIGATION_PICKER_SEARCH_LABELS=()
  _ZLE_PICKER_CONTEXTS=("$_git_file_view" current)
  _ZLE_PICKER_INSPECT_TEXTS=(
    tree 'Three expanded directory levels, including their files. Enter expands or collapses folders; fourth-level folders open in the same panel.'
    flat 'All captured file entries in one list. Duplicate filenames retain their parent path. Status labels and the selected diff stay visible.'
    ancestor 'Choose a parent of the current tree scope or selected file. The exact captured path determines the choices.'
    atlas 'Explore captured directory entry counts, then read a selected change. Escape restores this review.')
  for option in tree flat ancestor atlas; do
    [[ -n $captured_path ]] && _ZLE_PICKER_INSPECT_TEXTS[$option]+=$'\n\nSelected path:\n'"$captured_path"
  done
  _zle_picker_loop '' 10
}

_git_review_tree_ancestor_view() {
  local directory=$1 prefix='' component='' total=0
  local -a parts=("${(@s:/:)${directory%/}}")
  local -a _NAVIGATION_PICKER_VALUES=(root) _NAVIGATION_PICKER_LABELS=(Repository)
  local -a _NAVIGATION_PICKER_INDEXES=(1) _NAVIGATION_PICKER_SEARCH_LABELS=()
  _ZLE_PICKER_INSPECT_TEXTS=(root Repository)
  _ZLE_PICKER_INSPECT_TITLE='Captured path'
  # Bound both retained prefix text and choices, even for hostile Git paths.
  for component in "${parts[@]}"; do
    prefix+="$component/"
    (( total += ${#prefix} ))
    (( total <= 262144 && ${#_NAVIGATION_PICKER_VALUES} < 200 )) || break
    _NAVIGATION_PICKER_VALUES+=("d:$prefix")
    _NAVIGATION_PICKER_LABELS+=("$prefix")
    _ZLE_PICKER_INSPECT_TEXTS[d:$prefix]=$prefix
    _NAVIGATION_PICKER_INDEXES+=("${#_NAVIGATION_PICKER_VALUES}")
  done
  _ZLE_PICKER_TITLE='Git / Jump to ancestor'
  _ZLE_PICKER_SUBTITLE=$directory
  _ZLE_PICKER_COLLECTOR=_navigation_picker_collect
  _ZLE_PICKER_INSPECT_ACTION='open folder'
  _ZLE_PICKER_BROWSE_LABEL='Captured path · Repository always available'
  (( ${#_NAVIGATION_PICKER_VALUES} <= ${#parts} )) && _ZLE_PICKER_BROWSE_LABEL+=' · partial ancestor list'
  _zle_picker_loop '' 20
}

_git_review_file_options() {
  local selected=$1 choice='' directory='' scope=$_git_tree_scope
  local -i outcome=0
  local captured_path=''
  [[ $selected == <-> ]] && captured_path=${_GIT_REVIEW_PATHS[selected]-}
  [[ $selected == d:* ]] && captured_path=${selected#d:}
  _zle_ui_view choice _git_review_file_options_view "$captured_path"
  outcome=$?
  (( outcome == 0 )) || { (( outcome == 1 )) && return 0; return $outcome; }
  choice=$_ZLE_PICKER_SELECTED_VALUE
  case $choice in
    tree|flat)
      _git_review_file_switch "$choice" "$selected" ;;
    ancestor)
      if [[ -n ${bookmark[1]} || -n ${bookmark[4]-} ]]; then scope=$_git_tree_filter_scope; fi
      directory=$scope
      [[ $selected == d:* ]] && directory=${selected#d:}
      if [[ ( $_git_file_view == flat || -z $directory ) && $selected == <-> ]]; then
        directory=${_GIT_REVIEW_PATHS[selected]:h}
        [[ $directory == . ]] && directory='' || directory+=/
      fi
      _zle_ui_view choice _git_review_tree_ancestor_view "$directory"
      outcome=$?
      (( outcome == 0 )) || { (( outcome == 1 )) && return 0; return $outcome; }
      directory=${_ZLE_PICKER_SELECTED_VALUE#d:}
      [[ $_ZLE_PICKER_SELECTED_VALUE == root ]] && directory=''
      _git_file_view=tree
      _git_review_tree_scope_set "$directory"
      if [[ -n ${bookmark[1]} || -n ${bookmark[4]-} ]]; then
        _git_tree_filter_scopes=() _git_tree_filter_returns=()
      else
        _git_tree_scopes=() _git_tree_returns=()
      fi
      bookmark[2]=1 bookmark[3]=0 focus=0
      _git_review_file_reselect "$_ZLE_PICKER_DOCUMENT_KEY" ;;
    atlas)
      _git_review_atlas "$root" "$oid" "$parent"
      outcome=$?
      (( outcome > 1 )) && return $outcome ;;
  esac
  return 0
}

# Open three directory levels, then show deeper folders as collapsed entries.
# Compress a nonbranching stretch by its
# common parent prefix, including arbitrarily deep literal paths without a
# recursive call per path component. Recursion is only for visible levels.
_git_review_tree_rows() {
  emulate -L zsh
  local prefix=$1 value='' name='' tail='' directory='' common='' label='' marker='' action=''
  local -i depth=$2 index=0 open=0 part=0 common_count=0
  shift 2
  local -a order=() members=() common_parts=() parent_parts=()
  local -A groups=()
  for index in "$@"; do
    name=${_GIT_REVIEW_PATHS[index]}
    [[ $name == "$prefix"* ]] || continue
    tail=${name#"$prefix"}
    if [[ $tail == */?* ]]; then
      directory="$prefix${tail%%/*}/"
      [[ -n ${groups[$directory]-} ]] || order+=("d:$directory")
      groups[$directory]+=" $index"
    else
      order+=("$index")
    fi
  done
  for value in "${order[@]}"; do
    if [[ $value == d:* ]]; then
      directory=${value#d:}
      members=(${=groups[$directory]})
      common=${_GIT_REVIEW_PATHS[members[1]]:h}/
      # A captured trailing-slash entry is a leaf, never a traversable folder.
      [[ ${_GIT_REVIEW_PATHS[members[1]]} == */ ]] && common=$directory
      for index in "${members[@]:1}"; do
        name=${_GIT_REVIEW_PATHS[index]}
        [[ $name == "$common"?* ]] && continue
        # Compare components forward only on divergence. Repeatedly removing
        # the last component rescans long paths once per omitted directory.
        common_parts=("${(@s:/:)${common%/}}")
        parent_parts=("${(@s:/:)${${name%/}:h}}")
        common_count=${#common_parts}
        (( ${#parent_parts} < common_count )) && common_count=${#parent_parts}
        for (( part=1; part<=common_count; ++part )); do
          [[ ${common_parts[part]} == "${parent_parts[part]}" ]] || break
        done
        common_parts=("${common_parts[@]:0:$((part-1))}")
        common="${(j:/:)common_parts}/"
      done
      directory=$common value="d:$common"
      label=${common#"$prefix"}
      tail=${label%/}
      if [[ $tail == */*/* ]]; then label="${tail%%/*}/…/${tail:t}/"; fi
      open=${expanded[$directory]:-1}
      if (( depth >= 3 )); then
        open=0 action='open folder'
      elif (( open )); then
        action=collapse
      else
        action=expand
      fi
      (( open )) && marker=▾ || marker=▸
      _ZLE_PICKER_RESULTS+=("$value")
      _ZLE_PICKER_LABELS+=("${(l:$depth:: :)}$marker $label")
      _ZLE_PICKER_LABEL_PREFIXES[$value]="${(l:$depth:: :)}$marker "
      _ZLE_PICKER_DOCUMENT_BRANCHES[$value]=1
      _ZLE_PICKER_CONTEXTS[$value]="${#members} changes"
      _ZLE_PICKER_INSPECT_TEXTS[$value]=$directory
      if (( ${#_ZLE_PICKER_RESULTS} <= ${_git_tree_summary_limit:-0} )); then
        _git_review_folder_summary "$directory" "${members[@]}"
        _ZLE_PICKER_INSPECT_TEXTS[$value]=$REPLY
      fi
      _ZLE_PICKER_ACCEPT_LABELS[$value]=$action
      _git_tree_depths[$value]=$depth
      (( open )) && _git_review_tree_rows "$directory" $(( depth + 1 )) "${members[@]}"
    else
      _ZLE_PICKER_RESULTS+=("$value")
      # A one-cell step keeps hierarchy compact; nested files align with their
      # parent folder's name, beyond its disclosure arrow and separator.
      _ZLE_PICKER_LABELS+=("${(l:$((depth + (depth > 0))):: :)}${_GIT_REVIEW_PATHS[value]:t}")
      _ZLE_PICKER_LABEL_PREFIXES[$value]="${(l:$((depth + (depth > 0))):: :)}"
    fi
  done
  return 0
}

# Explicit captures share the existing busy painter. Review supplies its own
# status words so no search-only instructions leak into a Git screen.
_git_review_load() {
  local _ZLE_PICKER_BUSY_LABEL='Reading Git…'
  local -a _ZLE_PICKER_BUSY_LINES=('Reading a local Git snapshot' 'Read-only · no fetch, staging or checkout'
    'Large repositories or mounted drives can delay synchronous reads.')
  _zle_picker_capture 'Git review' "${root:t} · read-only" '' "$@"
}

# Only capture facts inside the busy painter: it temporarily shadows UI state.
_git_review_recapture() {
  _git_review_reads_blocked=1
  _git_review_prepare "$1" || return $?
  _git_review_reads_blocked=0
  if [[ $2 == working ]]; then
    _git_review_changes_capture "$1"
  elif [[ $2 == comparison ]]; then
    _git_review_comparison_files_capture "$1" "$3" "$4"
  else
    _git_review_commit_files_capture "$1" "$3" "$4"
  fi
}

# Automatic Working changes refresh is screen-session state. The public switch
# selects the initial state; Ctrl-A changes only the active workspace. Checks
# and candidate snapshots stay local, bounded and ephemeral.
_git_review_age() {
  emulate -L zsh
  local -i timestamp=${1:-0} now=${EPOCHSECONDS:-0} age=0
  REPLY='unknown'
  (( timestamp > 0 && now >= timestamp )) || return 0
  age=$(( now - timestamp ))
  if (( age < 60 )); then
    REPLY=now
  elif (( age < 3600 )); then
    REPLY="$(( age / 60 ))m ago"
  elif (( age < 86400 )); then
    REPLY="$(( age / 3600 ))h ago"
  else
    REPLY="$(( age / 86400 ))d ago"
  fi
}

_git_review_status_apply() {
  emulate -L zsh
  local previous=${_git_review_refresh_status:-} indicator='' checked='' updated=''
  local indicator_state='' indicator_details=''
  local base=$_GIT_REVIEW_SUMMARY
  [[ -n ${_ZLE_PICKER_DOCUMENT_KEY:-} && -n ${_GIT_REVIEW_DOCUMENT_SUMMARY:-} ]] &&
    base+=" · $_GIT_REVIEW_DOCUMENT_SUMMARY"
  if (( ${_ZLE_PICKER_AUTO_REFRESH:--1} >= 0 )); then
    _git_review_age "${_git_auto_checked_at:-0}"; checked=$REPLY
    _git_review_age "${_git_auto_updated_at:-0}"; updated=$REPLY
    if (( ${_git_auto_failed:-0} )); then
      if (( ${_git_auto_updated_at:-0} > 0 )); then
        indicator="auto paused · checked $checked · snapshot updated $updated"
      else
        indicator="auto paused · checked $checked · snapshot unavailable"
      fi
    elif (( ${_ZLE_PICKER_DOCUMENT_UPDATE_PENDING:-0} )); then
      indicator="auto on · update ready · current snapshot updated $updated"
    elif (( _ZLE_PICKER_AUTO_REFRESH )); then
      if (( ${_git_auto_updated_at:-0} > 0 )); then
        indicator="auto on · checked $checked · updated $updated"
      else
        indicator="auto on · checked $checked · snapshot unavailable"
      fi
    else
      if (( ${_git_auto_updated_at:-0} > 0 )); then
        indicator="auto off · snapshot updated $updated"
      else
        indicator='auto off · snapshot unavailable'
      fi
    fi
  fi
  if [[ -n ${_git_review_event_status:-} ]]; then
    if (( ${_ZLE_PICKER_DOCUMENT_UPDATE_PENDING:-0} )); then
      indicator+="${indicator:+ · }$_git_review_event_status"
    elif (( ${_ZLE_PICKER_AUTO_REFRESH:--1} >= 0 )) && [[ $indicator == *' · '* ]]; then
      indicator_state=${indicator%% · *}
      indicator_details=${indicator#* · }
      indicator="$indicator_state · $_git_review_event_status · $indicator_details"
    else
      indicator="${_git_review_event_status}${indicator:+ · $indicator}"
    fi
  fi
  _git_review_refresh_status=$indicator
  # Refresh state is the time-sensitive fact. Keep it at the left edge so
  # narrow document layouts retain auto/pending/failure status before counters.
  _ZLE_PICKER_BROWSE_LABEL="${indicator}${indicator:+ · }$base"
  [[ $indicator != "$previous" ]]
}

_git_review_status_wait() {
  emulate -L zsh
  local -i timestamp=${_git_auto_updated_at:-0} now=${EPOCHSECONDS:-0} age=0 wait=60
  (( ${_git_auto_failed:-0} )) && timestamp=${_git_auto_checked_at:-0}
  if (( timestamp > 0 && now >= timestamp )); then
    age=$(( now - timestamp ))
    if (( age < 3600 )); then
      wait=$(( 60 - age % 60 ))
    elif (( age < 86400 )); then
      wait=$(( 3600 - age % 3600 ))
    else
      wait=$(( 86400 - age % 86400 ))
    fi
  fi
  (( wait < 1 )) && wait=1
  _ZLE_PICKER_IDLE_WAIT=$wait
}

# Length-prefix every field so hostile paths, controls and newlines remain data
# without eval, quoting reconstruction or a delimiter that repository content
# could forge. Git paths and retained diffs cannot contain NUL in shell memory.
_git_review_packet_add() {
  emulate -L zsh
  local LC_ALL=C value=$1
  _git_auto_packet+="${#value}:$value"
}

_git_review_auto_worker() {
  emulate -L zsh
  unsetopt MONITOR NOTIFY BG_NICE
  setopt PIPE_FAIL
  umask 077
  zmodload zsh/datetime 2>/dev/null || return 2
  local LC_ALL=C root=$1 generation=$2 request_name=$3 request_kind=$4
  local request_context=$5 status_data='' diff_data='' config_data=''
  local _GIT_REVIEW_WORKER_DIR=$6
  local _git_auto_packet=$'compozsh-review-1\n'
  local -a config=()
  local -i result=0 prepare_result=0 list_truncated=0 diff_result=4 diff_truncated=0
  local -i index=0 match=0
  local -F started_at=$EPOCHREALTIME capture_duration=0
  local -F _GIT_REVIEW_WORKER_DEADLINE=$(( EPOCHREALTIME + _GIT_REVIEW_AUTO_REFRESH_TIMEOUT ))
  local -i _git_review_worker_active_pid=0
  local -i _git_review_worker_cancelled=0 _git_review_worker_timed_out=0
  local -i _git_review_worker_forking=0
  # Only this worker ever signals its direct Git child. TERM closes the fork
  # handoff race by recording cancellation until `$!` is assigned. Natural
  # completion is observed through pipe EOF before the still-owned PID is reaped.
  _git_review_auto_worker_defer_terminate() {
    _git_review_worker_cancelled=1
  }
  _git_review_auto_worker_terminate() {
    _git_review_worker_cancelled=1
    if (( _git_review_worker_active_pid > 0 )); then
      kill -KILL $_git_review_worker_active_pid 2>/dev/null
      wait $_git_review_worker_active_pid 2>/dev/null
      _git_review_worker_active_pid=0
    fi
    (( _git_review_worker_forking )) && return 0
    (( _git_review_worker_timed_out )) && exit 124
    exit 129
  }
  trap '_git_review_auto_worker_terminate' TERM

  _git_review_prepare "$root" || { prepare_result=2; result=2; }
  if (( !prepare_result )); then
    config=("${_GIT_REVIEW_CONFIG[@]}")
  fi
  if (( !result )); then
    _git_review_changes_capture "$root" || result=2
  fi
  if (( !result )); then
    status_data=$_GIT_REVIEW_DATA
    list_truncated=$_GIT_REVIEW_TRUNCATED
    if [[ -n $request_name ]]; then
      for (( index=1; index<=${#_GIT_REVIEW_PATHS}; ++index )); do
        if [[ ${_GIT_REVIEW_PATHS[index]} == "$request_name" &&
              ${_GIT_REVIEW_KINDS[index]} == "$request_kind" ]]; then
          match=$index
          break
        fi
      done
      if (( match )); then
        _git_review_diff_capture "$root" "$request_kind" "$request_name" '' '' "$request_context"
        diff_result=$?
        diff_data=$_GIT_REVIEW_DATA
        diff_truncated=$_GIT_REVIEW_TRUNCATED
      else
        diff_result=3
      fi
    fi
  fi

  capture_duration=$(( EPOCHREALTIME - started_at ))
  _git_review_packet_add "$result"
  _git_review_packet_add "$generation"
  _git_review_packet_add "$prepare_result"
  _git_review_packet_add "${#config}"
  (( ${#config} )) && config_data=${(pj:\0:)config}
  _git_review_packet_add "$config_data"
  _git_review_packet_add "$capture_duration"
  if (( !result )); then
    _git_review_packet_add "$list_truncated"
    _git_review_packet_add "$status_data"
    _git_review_packet_add "$request_name"
    _git_review_packet_add "$request_kind"
    _git_review_packet_add "$request_context"
    _git_review_packet_add "$match"
    _git_review_packet_add "$diff_result"
    _git_review_packet_add "$diff_truncated"
    _git_review_packet_add "$diff_data"
  fi
  _git_auto_packet+=$'compozsh-review-end-1\n'
  if (( ${#_git_auto_packet} > 1048576 )); then
    _git_auto_packet=$'compozsh-review-1\n'
    _git_review_packet_add 3
    _git_review_packet_add "$generation"
    _git_review_packet_add 2
    _git_review_packet_add 0
    _git_review_packet_add ''
    _git_review_packet_add "$capture_duration"
    _git_auto_packet+=$'compozsh-review-end-1\n'
  fi
  zmodload zsh/system || return 2
  zmodload zsh/zselect || return 2
  local -i written=0 write_result=0 offset=1 ERRNO=0
  # The session opens stdout nonblocking. A blocking print/syswrite retries
  # inside the builtin while the FIFO is full, deferring TERM indefinitely.
  # Small writes return control to this worker's trap and capture deadline;
  # publication must not depend on the picker draining its next idle result.
  while (( offset <= ${#_git_auto_packet} )); do
    if (( EPOCHREALTIME >= _GIT_REVIEW_WORKER_DEADLINE )); then
      _git_review_worker_timed_out=1
      _git_review_auto_worker_terminate
    fi
    written=0
    syswrite -c written "${_git_auto_packet[offset,offset + 8191]}"
    write_result=$?
    (( offset += written ))
    if (( write_result )); then
      [[ $write_result == 2 && ${errnos[ERRNO]-} == (EAGAIN|EWOULDBLOCK) ]] || return 2
      zselect -w 1 -t 10 2>/dev/null
    fi
  done
  return 0
}

_git_review_packet_take() {
  # Hot parser primitive: its sole caller already owns an emulated Zsh scope
  # and bytewise LC_ALL. Re-entering emulate for thousands of safe-filter
  # fields adds hundreds of milliseconds on the UI thread.
  local length_text=''
  local -i colon=$_git_auto_parse_pos length=0 start=0 end=0 total=${#_git_auto_parse_packet}
  # A length prefix has at most seven digits. Scan those bytes in place rather
  # than copying the complete remaining packet for every field; large but
  # valid filter configurations must remain linear-time UI work.
  while (( colon <= total && colon - _git_auto_parse_pos <= 7 )); do
    [[ ${_git_auto_parse_packet[colon]} == : ]] && break
    (( ++colon ))
  done
  (( colon - _git_auto_parse_pos <= 7 )) || return 1
  (( colon <= total )) || return 2
  [[ ${_git_auto_parse_packet[colon]} == : ]] || return 1
  length_text=${_git_auto_parse_packet[_git_auto_parse_pos,$(( colon - 1 ))]}
  # Check decimal width before integer assignment so a corrupted private
  # packet cannot print an arithmetic-overflow diagnostic into the screen.
  [[ $length_text == <-> && ${#length_text} -le 7 ]] || return 1
  length=$length_text
  (( length <= 1048576 )) || return 1
  start=$(( colon + 1 ))
  if (( length )); then
    end=$(( start + length - 1 ))
    (( end <= total )) || return 2
    REPLY=${_git_auto_parse_packet[start,end]}
    _git_auto_parse_pos=$(( end + 1 ))
  else
    REPLY=''
    _git_auto_parse_pos=$start
  fi
  return 0
}

_git_review_config_packet_valid() {
  emulate -L zsh
  local driver='' clean=''
  local -i index=0
  (( ${#config} % 6 == 0 )) || return 1
  for (( index=1; index<=${#config}; index+=6 )); do
    clean=${config[index + 1]}
    [[ $clean == filter.*.clean= ]] || return 1
    driver=${${clean#filter.}%.clean=}
    [[ -n $driver && $driver != *'='* && $clean == "filter.${driver}.clean=" ]] || return 1
    [[ ${config[index]} == -c && ${config[index + 2]} == -c && ${config[index + 4]} == -c ]] || return 1
    [[ ${config[index + 3]} == "filter.${driver}.process=" ]] || return 1
    [[ ${config[index + 5]} == "filter.${driver}.required=false" ]] || return 1
  done
  return 0
}

_git_review_auto_parse() {
  emulate -L zsh
  local LC_ALL=C header=$'compozsh-review-1\n' suffix=$'compozsh-review-end-1\n'
  local _git_auto_parse_packet=$_git_auto_session_buffer value='' status_data=''
  local request_name='' request_kind='' request_context='' diff_data='' config_data=''
  local -i _git_auto_parse_pos=1 result=0 generation=0 prepare_result=0 count=0 index=0
  local -i list_truncated=0 match=0 diff_result=0 diff_truncated=0 take_result=0
  local -F capture_duration=0
  local -a config=()
  local -a paths=() labels=() kinds=() contexts=() details=() parents=()
  local summary='' notice=''
  [[ $_git_auto_parse_packet == "$header"* ]] || {
    [[ $header == "$_git_auto_parse_packet"* ]] && return 2
    return 1
  }
  _git_auto_parse_pos=$(( ${#header} + 1 ))
  _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
  [[ $REPLY == (0|2|3) ]] || return 1
  result=$REPLY
  _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
  [[ $REPLY == <-> && ${#REPLY} -le 10 ]] || return 1
  generation=$REPLY
  _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
  [[ $REPLY == (0|2) ]] || return 1
  prepare_result=$REPLY
  _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
  [[ $REPLY == <-> && ${#REPLY} -le 4 ]] || return 1
  count=$REPLY
  (( count <= 4096 )) || return 1
  (( prepare_result == 0 || count == 0 )) || return 1
  _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
  config_data=$REPLY
  if (( count )); then
    config=("${(@0)config_data}")
  else
    [[ -z $config_data ]] || return 1
    config=()
  fi
  (( ${#config} == count )) || return 1
  _git_review_config_packet_valid || return 1
  _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
  [[ $REPLY == <-> || $REPLY == <->.<-> ]] || return 1
  (( ${#REPLY} <= 20 )) || return 1
  capture_duration=$REPLY
  (( capture_duration >= 0.0 && capture_duration <= _GIT_REVIEW_AUTO_REFRESH_TIMEOUT )) || return 1
  if (( !result )); then
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    [[ $REPLY == 0 || $REPLY == 1 ]] || return 1
    list_truncated=$REPLY
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    status_data=$REPLY
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    request_name=$REPLY
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    request_kind=$REPLY
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    request_context=$REPLY
    [[ $request_context == (3|1000000000) ]] || return 1
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    [[ $REPLY == <-> && ${#REPLY} -le 4 ]] || return 1
    match=$REPLY
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    [[ $REPLY == <-> && ${#REPLY} -le 3 ]] || return 1
    diff_result=$REPLY
    (( diff_result <= 255 )) || return 1
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    [[ $REPLY == 0 || $REPLY == 1 ]] || return 1
    diff_truncated=$REPLY
    _git_review_packet_take; take_result=$?; (( take_result )) && return $take_result
    diff_data=$REPLY

    # Parse the bounded status payload under local shadows; publish none of it
    # until the complete outer packet and every field have validated.
    local _GIT_REVIEW_DATA=$status_data _GIT_REVIEW_SUMMARY='' _GIT_REVIEW_NOTICE=''
    local -i _GIT_REVIEW_TRUNCATED=$list_truncated
    local -a _GIT_REVIEW_PATHS=() _GIT_REVIEW_LABELS=() _GIT_REVIEW_KINDS=()
    local -a _GIT_REVIEW_CONTEXTS=() _GIT_REVIEW_DETAILS=() _GIT_REVIEW_PARENTS=()
    _git_review_changes_parse || return 1
    paths=("${_GIT_REVIEW_PATHS[@]}") labels=("${_GIT_REVIEW_LABELS[@]}")
    kinds=("${_GIT_REVIEW_KINDS[@]}") contexts=("${_GIT_REVIEW_CONTEXTS[@]}")
    details=("${_GIT_REVIEW_DETAILS[@]}") parents=("${_GIT_REVIEW_PARENTS[@]}")
    summary=$_GIT_REVIEW_SUMMARY notice=$_GIT_REVIEW_NOTICE
    (( match <= ${#paths} )) || return 1
    if (( match )); then
      [[ ${paths[match]} == "$request_name" && ${kinds[match]} == "$request_kind" ]] || return 1
    fi
  fi
  local remaining=${_git_auto_parse_packet[_git_auto_parse_pos,-1]}
  if [[ $remaining != "$suffix" ]]; then
    [[ $suffix == "$remaining"* ]] && return 2
    return 1
  fi

  _git_auto_candidate_result=$result
  _git_auto_candidate_generation=$generation
  _git_auto_candidate_prepare_result=$prepare_result
  _git_auto_candidate_capture_duration=$capture_duration
  _git_auto_candidate_config=("${config[@]}")
  _git_auto_candidate_paths=("${paths[@]}")
  _git_auto_candidate_labels=("${labels[@]}")
  _git_auto_candidate_kinds=("${kinds[@]}")
  _git_auto_candidate_contexts=("${contexts[@]}")
  _git_auto_candidate_details=("${details[@]}")
  _git_auto_candidate_parents=("${parents[@]}")
  _git_auto_candidate_summary=$summary
  _git_auto_candidate_notice=$notice
  _git_auto_candidate_list_truncated=$list_truncated
  _git_auto_candidate_request_name=$request_name
  _git_auto_candidate_request_kind=$request_kind
  _git_auto_candidate_request_context=$request_context
  _git_auto_candidate_match=$match
  _git_auto_candidate_diff_result=$diff_result
  _git_auto_candidate_diff_truncated=$diff_truncated
  _git_auto_candidate_diff_data=$diff_data
  return 0
}

_git_review_auto_candidate_clear() {
  _git_auto_candidate_ready=0
  _git_auto_candidate_result=0 _git_auto_candidate_generation=0
  _git_auto_candidate_prepare_result=0 _git_auto_candidate_capture_duration=0
  _git_auto_candidate_config=() _git_auto_candidate_paths=() _git_auto_candidate_labels=()
  _git_auto_candidate_kinds=() _git_auto_candidate_contexts=()
  _git_auto_candidate_details=() _git_auto_candidate_parents=()
  _git_auto_candidate_summary='' _git_auto_candidate_notice=''
  _git_auto_candidate_request_name='' _git_auto_candidate_request_kind=''
  _git_auto_candidate_request_context='' _git_auto_candidate_diff_data=''
  _git_auto_candidate_list_truncated=0 _git_auto_candidate_match=0
  _git_auto_candidate_diff_result=0 _git_auto_candidate_diff_truncated=0
}

_git_review_auto_worker_stop() {
  emulate -L zsh
  local chunk=''
  local -i amount=0
  if (( ${_git_auto_session_pid:-0} > 0 )); then
    kill -TERM -- ${_git_auto_session_pid} 2>/dev/null
    # Nonblocking publication lets TERM run even with a full response FIFO.
    # The worker kills and reaps its exact in-memory provider before exiting;
    # the parent never signals a provider through a handoff PID.
    wait ${_git_auto_session_pid} 2>/dev/null
  fi
  # The parent holds the FIFO read/write so a killed writer does not produce
  # EOF. Discard any partial packet before this screen session launches a new
  # generation; otherwise resume could prepend stale bytes to its response.
  if (( ${_git_auto_session_fd:--1} >= 0 )) &&
     zmodload zsh/system 2>/dev/null && zmodload zsh/zselect 2>/dev/null; then
    while zselect -r $_git_auto_session_fd -t 0 2>/dev/null; do
      chunk='' amount=0
      sysread -i $_git_auto_session_fd -s 8192 -c amount chunk 2>/dev/null
      (( $? == 0 && amount > 0 )) || break
    done
  fi
  _git_auto_session_pid=0
  _ZLE_PICKER_DEADLINE_AT=0
  _git_auto_session_buffer=''
}

_git_review_auto_session_stop() {
  emulate -L zsh
  _git_review_auto_worker_stop
  if (( ${_git_auto_session_fd:--1} >= 0 )); then
    exec {_git_auto_session_fd}<&-
    _git_auto_session_fd=-1
  fi
  [[ -n ${_git_auto_session_fifo:-} ]] && command rm -f -- "$_git_auto_session_fifo"
  [[ -n ${_git_auto_session_dir:-} ]] && command rmdir -- "$_git_auto_session_dir" 2>/dev/null
  _git_auto_session_fifo='' _git_auto_session_dir=''
  _git_review_auto_candidate_clear
  return 0
}

_git_review_auto_session_start() {
  emulate -L zsh
  (( ${_git_auto_session_fd:--1} < 0 )) || return 0
  _git_auto_session_dir=$(command mktemp -d "${TMPDIR:-/tmp}/compozsh-review.XXXXXXXX") || return 1
  command chmod 700 "$_git_auto_session_dir" || { _git_review_auto_session_stop; return 1; }
  _git_auto_session_fifo="$_git_auto_session_dir/response.fifo"
  command mkfifo -m 600 -- "$_git_auto_session_fifo" || { _git_review_auto_session_stop; return 1; }
  exec {_git_auto_session_fd}<>"$_git_auto_session_fifo" || {
    _git_review_auto_session_stop
    return 1
  }
  return 0
}

_git_review_auto_launch() {
  emulate -L zsh
  unsetopt BG_NICE
  local selected=${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-} name='' kind=''
  [[ $selected == d:* ]] && selected=$_ZLE_PICKER_DOCUMENT_KEY
  _git_review_auto_session_start || return 1
  (( ${_git_auto_session_pid:-0} == 0 )) || return 0
  if [[ $selected == <-> ]] && (( selected > 0 )); then
    name=${_GIT_REVIEW_PATHS[selected]-}
    kind=${_GIT_REVIEW_KINDS[selected]-}
  fi
  (( ++_git_auto_generation ))
  _git_auto_request_name=$name _git_auto_request_kind=$kind
  _git_auto_request_context=$context
  _git_auto_session_buffer=''
  _git_auto_started_at=$EPOCHREALTIME
  _git_auto_deadline_at=$(( EPOCHREALTIME + _GIT_REVIEW_AUTO_REFRESH_TIMEOUT ))
  _ZLE_PICKER_DEADLINE_AT=$_git_auto_deadline_at
  (
    zmodload zsh/system || exit 2
    sysopen -w -o nonblock,cloexec,nofollow -u 1 "$_git_auto_session_fifo" || exit 2
    _git_review_auto_worker "$root" $_git_auto_generation "$name" "$kind" "$context" "$_git_auto_session_dir"
  ) < /dev/null 2>/dev/null &
  _git_auto_session_pid=$!
  (( _git_auto_session_pid > 0 ))
}

_git_review_auto_poll() {
  emulate -L zsh
  zmodload zsh/system || return 3
  zmodload zsh/zselect || return 3
  local chunk=''
  local -i amount=0 read_result=0 parse_result=0 pid=${_git_auto_session_pid:-0}
  local -i worker_finished=0
  (( pid > 0 && ${_git_auto_session_fd:--1} >= 0 )) || return 2
  while true; do
    while zselect -r $_git_auto_session_fd -t 0 2>/dev/null; do
      chunk='' amount=0
      sysread -i $_git_auto_session_fd -s 8192 -c amount chunk
      read_result=$?
      (( read_result == 0 && amount > 0 )) || break
      _git_auto_session_buffer+=$chunk
      (( ${#_git_auto_session_buffer} <= 1048576 )) || {
        _git_review_auto_worker_stop
        return 3
      }
    done
    _git_review_auto_parse
    parse_result=$?
    case $parse_result in
      (0)
        wait $pid 2>/dev/null
        _git_auto_session_pid=0 _git_auto_session_buffer=''
        _ZLE_PICKER_DEADLINE_AT=0
        _git_auto_candidate_ready=1
        return 0 ;;
      (1)
        _git_review_auto_worker_stop
        return 3 ;;
    esac
    (( worker_finished )) && break
    kill -0 $pid 2>/dev/null && return 1
    # The worker may have written its final bytes after the drain above but
    # before this exit observation. Drain once more after exit, when no later
    # write can race us, before classifying an incomplete packet as failure.
    worker_finished=1
  done
  wait $pid 2>/dev/null
  _git_auto_session_pid=0 _git_auto_session_buffer=''
  _ZLE_PICKER_DEADLINE_AT=0
  return 3
}

_git_review_arrays_equal() {
  emulate -L zsh
  local left_name=$1 right_name=$2
  local -a left=("${(@P)left_name}") right=("${(@P)right_name}")
  local -i index=0
  (( ${#left} == ${#right} )) || return 1
  for (( index=1; index<=${#left}; ++index )); do
    [[ ${left[index]} == "${right[index]}" ]] || return 1
  done
  return 0
}

_git_review_auto_candidate_changed() {
  emulate -L zsh
  local pair=''
  local -a pairs=(
    '_GIT_REVIEW_PATHS _git_auto_candidate_paths'
    '_GIT_REVIEW_LABELS _git_auto_candidate_labels'
    '_GIT_REVIEW_KINDS _git_auto_candidate_kinds'
    '_GIT_REVIEW_CONTEXTS _git_auto_candidate_contexts'
    '_GIT_REVIEW_DETAILS _git_auto_candidate_details'
    '_GIT_REVIEW_PARENTS _git_auto_candidate_parents')
  for pair in "${pairs[@]}"; do
    _git_review_arrays_equal ${=pair} || return 0
  done
  [[ $_GIT_REVIEW_SUMMARY == "$_git_auto_candidate_summary" &&
     $_GIT_REVIEW_NOTICE == "$_git_auto_candidate_notice" ]] || return 0
  if [[ -n $_git_auto_candidate_request_name && $_git_auto_candidate_match != 0 ]]; then
    local current=${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-} cache_key=''
    [[ $current == d:* ]] && current=$_ZLE_PICKER_DOCUMENT_KEY
    [[ $current == <-> ]] || return 0
    _git_review_document_cache_key "$current" "$context"
    cache_key=$REPLY
    [[ ${_git_document_cache[$cache_key]-} == "$_git_auto_candidate_diff_data" &&
       ${_git_document_partial[$cache_key]:-0} == $_git_auto_candidate_diff_truncated ]] || return 0
  fi
  return 1
}

_git_review_auto_candidate_visible() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local query=${_ZLE_PICKER_QUERY:-} label='' literal='' pattern=''
  local -a reply=()
  local -i match=${_git_auto_candidate_match:-0}
  (( match > 0 )) || return 1
  local exclusion_pattern='*' REPLY=''
  if [[ -n ${_ZLE_PICKER_EXCLUDE:-} ]]; then
    (( ${+functions[_matching_exclusion]} )) || return 1
    _matching_exclusion "$_ZLE_PICKER_EXCLUDE" || return
    exclusion_pattern=$REPLY
  fi
  label="${_git_auto_candidate_labels[match]} ${_git_auto_candidate_contexts[match]-}"
  [[ $label == ${~exclusion_pattern} ]] || return 1
  [[ -z $query ]] && return 0
  (( ${+functions[_matching_compile]} )) || return 1
  _matching_compile "$query" || return 1
  literal=$reply[1] pattern=$reply[2]
  [[ $label == (#i)${literal}* || $label == (#i)*${literal}* || $label == ${~pattern} ]]
}

_git_review_auto_forget_other_documents() {
  emulate -L zsh
  local current=${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-} keep='' key='' failure=''
  [[ $current == d:* ]] && current=$_ZLE_PICKER_DOCUMENT_KEY
  local saved_context='' saved_anchor=''
  local -i saved_offset=0 saved_row=0
  local -A folder_offsets=() folder_rows=()
  if [[ $_ZLE_PICKER_INSPECT_KEY == d:* ]] && (( ${+functions[_zle_picker_document_bookmark]} )); then
    _zle_picker_document_bookmark
  fi
  # An unchanged capture leaves literal folder identities intact. Numeric file
  # bookmarks still follow the existing active-reader invalidation rule below.
  for key in "${(@k)_ZLE_PICKER_DOCUMENT_OFFSETS}"; do
    [[ $key == d:* ]] || continue
    folder_offsets[$key]=${_ZLE_PICKER_DOCUMENT_OFFSETS[$key]}
    folder_rows[$key]=${_ZLE_PICKER_DOCUMENT_ROWS[$key]:-0}
  done
  [[ $current == <-> ]] && { _git_review_document_cache_key "$current" "$context"; keep=$REPLY; }
  if [[ $current == <-> ]]; then
    saved_context=${_git_document_contexts[$current]-}
    saved_anchor=${_git_document_anchors[$current]-}
    saved_offset=${_ZLE_PICKER_DOCUMENT_OFFSETS[$current]:-0}
    saved_row=${_ZLE_PICKER_DOCUMENT_ROWS[$current]:-0}
  fi
  for key in ${(k)_git_document_cache}; do
    [[ $key == "$keep" ]] && continue
    unset "_git_document_cache[$key]" "_git_document_partial[$key]" \
      "_git_document_syntax_cache[$key]" "_git_document_syntax_notes[$key]" \
      "_git_document_syntax_first[$key]" "_git_document_syntax_last[$key]"
    for failure in ${(k)_git_document_syntax_failures}; do
      [[ $failure == "$key:"* ]] && unset "_git_document_syntax_failures[$failure]"
    done
  done
  [[ -n $keep ]] && _git_document_order=("$keep") || _git_document_order=()
  # A successful external observation retires bookmarks for every other file,
  # even when labels and the selected diff compare equal. Only the active
  # reader can prove that its source anchor still belongs to retained bytes.
  _git_document_contexts=() _git_document_anchors=()
  _ZLE_PICKER_DOCUMENT_OFFSETS=("${(@kv)folder_offsets}")
  _ZLE_PICKER_DOCUMENT_ROWS=("${(@kv)folder_rows}")
  if [[ $current == <-> ]]; then
    [[ -n $saved_context ]] && _git_document_contexts[$current]=$saved_context
    [[ -n $saved_anchor ]] && _git_document_anchors[$current]=$saved_anchor
    _ZLE_PICKER_DOCUMENT_OFFSETS[$current]=$saved_offset
    _ZLE_PICKER_DOCUMENT_ROWS[$current]=$saved_row
  fi
}

_git_review_auto_safety_adopt() {
  emulate -L zsh
  if (( ${_git_auto_candidate_ready:-0} && ${_git_auto_candidate_prepare_result:-2} == 0 )); then
    _GIT_REVIEW_CONFIG=("${_git_auto_candidate_config[@]}")
    _git_review_reads_blocked=0
    return 0
  fi
  _git_review_reads_blocked=1
  return 1
}

_git_review_auto_fail() {
  emulate -L zsh
  local safety_known=${2:-0}
  _git_review_auto_worker_stop
  _git_review_auto_candidate_clear
  (( safety_known )) || _git_review_reads_blocked=1
  _ZLE_PICKER_AUTO_REFRESH=0
  _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=0
  _git_auto_failed=1
  _git_auto_checked_at=$EPOCHSECONDS
  _git_review_event_status=${1:-'automatic refresh failed'}
  _git_review_status_apply
  return 0
}

_git_review_auto_deadline() {
  emulate -L zsh
  (( ${_git_auto_session_pid:-0} > 0 && ${_git_auto_deadline_at:-0} > 0 &&
     EPOCHREALTIME >= _git_auto_deadline_at )) || return 1
  _git_review_auto_fail 'automatic refresh timed out'
  return 0
}

_git_review_auto_schedule_context_check() {
  emulate -L zsh
  local -F earliest=$(( EPOCHREALTIME + _GIT_REVIEW_AUTO_REFRESH_INTERVAL ))
  (( ${_git_auto_next_at:-0} >= earliest )) || _git_auto_next_at=$earliest
}

# Invalidate derived document state only after a replacement snapshot is ready.
_git_review_document_reset() {
  local key='' pattern=''
  local -A folder_offsets=() folder_rows=()
  if [[ $_ZLE_PICKER_INSPECT_KEY == d:* ]] && (( ${+functions[_zle_picker_document_bookmark]} )); then
    _zle_picker_document_bookmark
  fi
  # Snapshot indices are obsolete, but exact surviving directory prefixes can
  # retain summary positions. Test each saved prefix once against captured paths;
  # no traversal or prefix catalog is needed even for deeply nested paths.
  for key in "${(@k)_ZLE_PICKER_DOCUMENT_OFFSETS}"; do
    [[ $key == d:* ]] || continue
    pattern="${(b)${key#d:}}*"
    (( ${_GIT_REVIEW_PATHS[(I)${~pattern}]} )) || continue
    folder_offsets[$key]=${_ZLE_PICKER_DOCUMENT_OFFSETS[$key]}
    folder_rows[$key]=${_ZLE_PICKER_DOCUMENT_ROWS[$key]:-0}
  done
  _git_document_cache=() _git_document_partial=() _git_document_order=()
  _git_document_syntax_cache=() _git_document_syntax_notes=()
  _git_document_syntax_first=() _git_document_syntax_last=()
  _git_document_syntax_failures=()
  _git_document_contexts=() _git_document_anchors=()
  _ZLE_PICKER_DOCUMENT_OFFSETS=("${(@kv)folder_offsets}")
  _ZLE_PICKER_DOCUMENT_ROWS=("${(@kv)folder_rows}")
  _ZLE_PICKER_DOCUMENT_KEY='' _ZLE_PICKER_DOCUMENT_TITLE='' _ZLE_PICKER_DOCUMENT_MODE=''
  _ZLE_PICKER_DOCUMENT_PENDING=0
  (( ++_git_review_snapshot_epoch ))
  _git_review_syntax_cleanup
  _ZLE_PICKER_DOCUMENT_LINES=() _ZLE_PICKER_DOCUMENT_ROLES=() _ZLE_PICKER_DOCUMENT_SYNTAX=()
  _GIT_REVIEW_DOCUMENT_OLD=() _GIT_REVIEW_DOCUMENT_NEW=()
}

_git_review_auto_idle() {
  emulate -L zsh
  local old_status=$_git_review_refresh_status current='' current_name='' current_kind=''
  local -F now=$EPOCHREALTIME duration=0 interval=$_GIT_REVIEW_AUTO_REFRESH_INTERVAL
  local -i poll_result=2 changed=0 candidate_visible=0
  local -a reply=()
  _ZLE_PICKER_IDLE_WAIT=0
  (( _ZLE_PICKER_AUTO_REFRESH >= 0 )) || return 2

  # A guide never initiates Git discovery. Drain a request that was already in
  # flight so its pipe cannot block, then hold the validated candidate until
  # the user returns to the unchanged review context.
  if (( _ZLE_PICKER_GUIDE_ACTIVE )); then
    if (( _git_auto_session_pid > 0 )); then
      _git_review_auto_poll_outcome
      poll_result=$reply[1]
      (( reply[2] >= 0 )) && return $reply[2]
    fi
    return 2
  fi
  if (( _ZLE_PICKER_DOCUMENT_UPDATE_PENDING )); then
    if [[ $context != "$_git_auto_candidate_request_context" ]]; then
      # A pending diff is bound to the disclosure mode captured by its worker.
      # Keep the old observation and obtain the new context on the next normal
      # check instead of caching full bytes under a focused key (or vice versa).
      _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=0
      _git_review_auto_candidate_clear
      _git_review_auto_schedule_context_check
      _git_review_event_status='context changed · checking again'
      _git_review_status_apply
      return 0
    fi
    _git_review_status_apply
    changed=$?
    _git_review_status_wait
    (( changed == 0 )) && return 0
    return 2
  fi
  if (( !_ZLE_PICKER_AUTO_REFRESH )); then
    _git_review_status_apply
    changed=$?
    _git_review_status_wait
    (( changed == 0 )) && return 0
    return 2
  fi

  if (( _git_auto_session_pid > 0 )); then
    _git_review_auto_poll_outcome
    poll_result=$reply[1]
    (( reply[2] >= 0 )) && return $reply[2]
    if (( poll_result == 0 )); then
      duration=$_git_auto_candidate_capture_duration
      (( duration * 4.0 > interval )) && interval=$(( duration * 4.0 ))
      (( interval > 30.0 )) && interval=30.0
      _git_auto_next_at=$(( EPOCHREALTIME + interval ))
      _git_auto_checked_at=$EPOCHSECONDS
    fi
  fi

  if (( _git_auto_candidate_ready )); then
    local -i safety_known=0
    _git_review_auto_safety_adopt && safety_known=1
    (( _git_auto_candidate_generation == _git_auto_generation &&
       !_git_auto_candidate_result )) || {
      _git_review_auto_fail 'automatic refresh returned an invalid snapshot' $safety_known
      return 0
    }
    current=${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-}
    [[ $current == d:* ]] && current=$_ZLE_PICKER_DOCUMENT_KEY
    if [[ $current == <-> ]] && (( current > 0 )); then
      current_name=${_GIT_REVIEW_PATHS[current]-}
      current_kind=${_GIT_REVIEW_KINDS[current]-}
    fi
    if [[ $current_name != "$_git_auto_candidate_request_name" ||
          $current_kind != "$_git_auto_candidate_request_kind" ||
          $context != "$_git_auto_candidate_request_context" ]]; then
      # Selection or disclosure won while Git was working. Its result is a
      # valid local check but cannot replace another document; request the new
      # exact target on the already scheduled check without bypassing the
      # configured/adaptive pacing floor.
      _git_review_auto_candidate_clear
      _git_review_event_status=''
      _git_review_status_apply
      [[ $_git_review_refresh_status != "$old_status" ]] && return 0
    else
      if [[ -n $current_name && $_git_auto_candidate_match != 0 &&
            $_git_auto_candidate_diff_result != 0 ]]; then
        _git_review_auto_fail 'automatic diff refresh failed' $safety_known
        return 0
      fi
      if _git_review_auto_candidate_changed; then changed=1; fi
      _git_review_auto_candidate_visible && candidate_visible=1
      if (( !changed )); then
        _git_review_auto_forget_other_documents
        _git_review_auto_candidate_clear
        _git_review_event_status=''
        _git_review_status_apply
        [[ $_git_review_refresh_status != "$old_status" ]] && return 0
      elif [[ $current == <-> ]] && (( _ZLE_PICKER_INSPECT_FOCUS && current > 0 && !candidate_visible )); then
        _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=1
        if (( _git_auto_candidate_match )); then
          _git_review_event_status='selected change no longer matches filter'
        else
          _git_review_event_status='selected change resolved or moved'
        fi
        _git_review_status_apply
        return 0
      else
        _ZLE_PICKER_IDLE_ACTION=document-auto-refresh
        return 0
      fi
    fi
  fi

  now=$EPOCHREALTIME
  if (( now >= _git_auto_next_at )); then
    _git_review_auto_launch || { _git_review_auto_fail 'automatic refresh could not start'; return 0; }
    _ZLE_PICKER_IDLE_WAIT=0.10
    return 2
  fi
  _ZLE_PICKER_IDLE_WAIT=$(( _git_auto_next_at - now ))
  (( _ZLE_PICKER_IDLE_WAIT < 0.03 )) && _ZLE_PICKER_IDLE_WAIT=0.03
  return 2
}

# Drain an existing request and interpret its wait/failure outcome. Never
# start discovery or adopt a candidate here: the guide and review differ there.
_git_review_auto_poll_outcome() {
  local -i _auto_poll_status=0 _auto_poll_outcome=-1
  _git_review_auto_poll; _auto_poll_status=$?
  if (( _auto_poll_status == 1 )); then
    if (( EPOCHREALTIME >= _git_auto_deadline_at )); then
      _git_review_auto_fail 'automatic refresh timed out'
      _auto_poll_outcome=0
    else
      _ZLE_PICKER_IDLE_WAIT=0.10
      _auto_poll_outcome=2
    fi
  elif (( _auto_poll_status == 3 )); then
    (( EPOCHREALTIME >= _git_auto_deadline_at )) &&
      _git_review_auto_fail 'automatic refresh timed out' || _git_review_auto_fail
    _auto_poll_outcome=0
  fi
  reply=("$_auto_poll_status" "$_auto_poll_outcome")
}

_git_review_idle() {
  emulate -L zsh
  local -i auto_result=2 syntax_result=2
  local -F auto_wait=0
  _git_review_auto_idle; auto_result=$?
  auto_wait=$_ZLE_PICKER_IDLE_WAIT
  [[ -n ${_ZLE_PICKER_IDLE_ACTION:-} ]] && return 0
  _git_review_syntax_idle; syntax_result=$?
  (( auto_result == 0 || syntax_result == 0 )) && return 0
  (( auto_result == 1 || syntax_result == 1 )) && return 1
  _ZLE_PICKER_IDLE_WAIT=$auto_wait
  return 2
}

# Publish one fully validated candidate after the picker has returned its exact
# bookmark. No busy frame or provider call occurs here: the worker already
# captured both the list and the surviving selected diff. State changes once,
# then the normal ZLE repaint replaces the complete frame in place.
_git_review_auto_publish() {
  emulate -L zsh
  local root=$1 selected=${_ZLE_PICKER_DOCUMENT_KEY:-0} anchor='' cache_key=''
  local selected_row=${2:-$selected}
  # The focus-return key may also edit the filter and reset its visible
  # selection. Bind publication to the exact path/kind the worker captured,
  # never to that post-key numeric slot from the older observation.
  local name=$_git_auto_candidate_request_name
  local change_kind=$_git_auto_candidate_request_kind
  local diff_data=$_git_auto_candidate_diff_data
  local -i diff_truncated=$_git_auto_candidate_diff_truncated
  local -i match=0 rank=0 row=0 old_slot=$(( bookmark[2] - bookmark[3] ))

  if [[ $context != "$_git_auto_candidate_request_context" ]]; then
    _git_review_auto_safety_adopt || true
    _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=0
    _git_review_auto_candidate_clear
    _git_review_auto_schedule_context_check
    _git_review_event_status='context changed · checking again'
    _git_review_status_apply >/dev/null
    return 0
  fi

  if [[ $selected == <-> && ${_GIT_REVIEW_PATHS[selected]-} == "$name" &&
        ${_GIT_REVIEW_KINDS[selected]-} == "$change_kind" ]]; then
    _git_review_document_anchor "${_ZLE_PICKER_DOCUMENT_ROWS[$selected]:-0}"
    anchor=$REPLY
  fi

  _GIT_REVIEW_CONFIG=("${_git_auto_candidate_config[@]}")
  _GIT_REVIEW_PATHS=("${_git_auto_candidate_paths[@]}")
  _GIT_REVIEW_LABELS=("${_git_auto_candidate_labels[@]}")
  _GIT_REVIEW_KINDS=("${_git_auto_candidate_kinds[@]}")
  _GIT_REVIEW_CONTEXTS=("${_git_auto_candidate_contexts[@]}")
  _GIT_REVIEW_DETAILS=("${_git_auto_candidate_details[@]}")
  _GIT_REVIEW_PARENTS=("${_git_auto_candidate_parents[@]}")
  _GIT_REVIEW_SUMMARY=$_git_auto_candidate_summary
  _GIT_REVIEW_NOTICE=$_git_auto_candidate_notice
  _GIT_REVIEW_TRUNCATED=$_git_auto_candidate_list_truncated

  _git_review_document_reset
  _GIT_REVIEW_DOCUMENT_HAS_CODE=0 _ZLE_PICKER_DOCUMENT_TARGET_ROW=0
  _GIT_REVIEW_DOCUMENT_SUMMARY=''
  _ZLE_PICKER_EMPTY_LINES=()
  if (( !${#_GIT_REVIEW_PATHS} )); then
    _ZLE_PICKER_EMPTY_LINES=('No changes in this snapshot' 'Automatic refresh is active; Ctrl-R refreshes now.' "$_GIT_REVIEW_NOTICE")
  fi
  for (( row=1; row<=${#_GIT_REVIEW_PATHS}; ++row )); do
    if [[ ${_GIT_REVIEW_PATHS[row]} == "$name" &&
          ${_GIT_REVIEW_KINDS[row]} == "$change_kind" ]]; then
      match=$row
      break
    fi
  done
  _git_review_rows
  local _ZLE_PICKER_EXCLUDE=${bookmark[4]-}
  _navigation_picker_collect "${bookmark[1]}" 1000
  (( match )) && rank=${_ZLE_PICKER_RESULTS[(Ie)$match]}
  if (( rank )); then
    bookmark[2]=$rank
    (( old_slot < 1 )) && old_slot=1
    bookmark[3]=$(( rank - old_slot ))
    (( bookmark[3] < 0 )) && bookmark[3]=0
    _git_document_contexts[$match]=refresh
    _git_document_anchors[$match]=$anchor
    _git_review_document_cache_key "$match" "$context"
    cache_key=$REPLY
    _git_document_cache[$cache_key]=$diff_data
    _git_document_partial[$cache_key]=$diff_truncated
    _git_document_order=("$cache_key")
    _git_review_refresh_status=''
    _git_review_document_load "$root" "$match" '' '' "$context" || return $?
  else
    bookmark[2]=1 bookmark[3]=0 focus=0 context=3
    [[ -n $name ]] && _git_review_event_status='updated automatically · previous selection no longer in results' ||
      _git_review_event_status='updated automatically'
  fi
  if (( rank )); then
    _git_review_event_status='updated automatically'
  fi
  _git_auto_updated_at=$EPOCHSECONDS
  _git_auto_failed=0
  _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=0
  _git_review_auto_candidate_clear
  _git_review_status_apply >/dev/null
  if [[ $_ZLE_PICKER_OPTIONS_KIND == file-views ]]; then
    _git_tree_bookmark=() _git_flat_bookmark=()
    _git_review_tree_reconcile
    _git_review_file_reselect "$match"
    # The source rank excludes directory rows. Restore the visible slot only
    # after the final projection, retaining a surviving folder independently
    # from the reader whose path/kind was rebound to this snapshot.
    local -i folder_rank=0
    [[ $selected_row == d:* ]] && folder_rank=${_ZLE_PICKER_RESULTS[(Ie)$selected_row]}
    (( folder_rank )) && bookmark[2]=$folder_rank
    if (( (rank || folder_rank) && bookmark[2] > 0 )); then
      (( old_slot < 1 )) && old_slot=1
      bookmark[3]=$(( bookmark[2] - old_slot ))
      (( bookmark[3] < 0 )) && bookmark[3]=0
    fi
  fi
  return 0
}

# Explicit whole-workspace refresh, owned by _git_review_view. Keep the old
# observation on a failed list read. Numeric IDs can change, so successful
# refresh retires every raw/token cache and rebinds only the active source anchor
# by literal path AND change kind. bookmark/focus/context belong to the caller.
_git_review_refresh() {
  emulate -L zsh
  local root=$1 view_kind=$2 oid=$3 parent=$4 selected=$5
  local selected_row=${6:-$selected}
  local name='' change_kind='' anchor=''
  name=${_GIT_REVIEW_PATHS[selected]-}
  change_kind=${_GIT_REVIEW_KINDS[selected]-}
  local summary=$_GIT_REVIEW_SUMMARY notice=$_GIT_REVIEW_NOTICE
  local -a saved_paths=("${_GIT_REVIEW_PATHS[@]}") saved_kinds=("${_GIT_REVIEW_KINDS[@]}")
  local -a saved_labels=("${_GIT_REVIEW_LABELS[@]}") saved_contexts=("${_GIT_REVIEW_CONTEXTS[@]}")
  local -a saved_details=("${_GIT_REVIEW_DETAILS[@]}") saved_parents=("${_GIT_REVIEW_PARENTS[@]}")
  local -a saved_config=("${_GIT_REVIEW_CONFIG[@]}")
  local -i result=0 match=0 rank=0 row=0 old_slot=$(( bookmark[2] - bookmark[3] ))
  _git_review_refresh_succeeded=0
  if [[ -n $selected && $selected == "$_ZLE_PICKER_DOCUMENT_KEY" ]]; then
    _git_review_document_anchor "${_ZLE_PICKER_DOCUMENT_ROWS[$selected]:-0}"
    anchor=$REPLY
  fi
  # Configuration may have changed while an AI or editor was working too.
  _git_review_load _git_review_recapture "$root" "$view_kind" "$oid" "$parent"; result=$?
  if (( result )); then
    _GIT_REVIEW_PATHS=("${saved_paths[@]}") _GIT_REVIEW_KINDS=("${saved_kinds[@]}")
    _GIT_REVIEW_LABELS=("${saved_labels[@]}") _GIT_REVIEW_CONTEXTS=("${saved_contexts[@]}")
    _GIT_REVIEW_DETAILS=("${saved_details[@]}") _GIT_REVIEW_PARENTS=("${saved_parents[@]}")
    # A successful preparation remains current even if the later list read
    # failed. Failed preparation permits cached reading only, until retry.
    (( _git_review_reads_blocked )) && _GIT_REVIEW_CONFIG=("${saved_config[@]}")
    _GIT_REVIEW_SUMMARY=$summary _GIT_REVIEW_NOTICE=$notice
    (( result == 129 || result == 130 || result == 143 )) && return $result
    _git_review_event_status='refresh failed · previous snapshot · Ctrl-R retry'
    return 0
  fi

  _git_review_document_reset
  _GIT_REVIEW_DOCUMENT_HAS_CODE=0 _ZLE_PICKER_DOCUMENT_TARGET_ROW=0 _GIT_REVIEW_DOCUMENT_SUMMARY=''
  _git_review_event_status='refreshed'
  _ZLE_PICKER_SUBTITLE="${root:t} · read-only snapshot"
  [[ $view_kind == comparison ]] && _ZLE_PICKER_SUBTITLE="$_git_compare_context · ${root:t}"
  _ZLE_PICKER_EMPTY_LINES=()
  if (( !${#_GIT_REVIEW_PATHS} )); then
    _ZLE_PICKER_EMPTY_LINES=('No changes in this snapshot' 'Ctrl-R refreshes now; Escape returns.' "$_GIT_REVIEW_NOTICE")
  fi
  for (( row=1; row<=${#_GIT_REVIEW_PATHS}; ++row )); do
    if [[ ${_GIT_REVIEW_PATHS[row]} == "$name" && ${_GIT_REVIEW_KINDS[row]} == "$change_kind" ]]; then
      match=$row
      break
    fi
  done
  _git_review_rows
  # Re-rank the bounded captured list using the unchanged filter. A status
  # change may also remove a surviving path/kind from this query's results.
  local _ZLE_PICKER_EXCLUDE=${bookmark[4]-}
  _navigation_picker_collect "${bookmark[1]}" 1000
  (( match )) && rank=${_ZLE_PICKER_RESULTS[(Ie)$match]}
  if (( rank )); then
    bookmark[2]=$rank
    _git_document_contexts[$match]=refresh
    _git_document_anchors[$match]=$anchor
  else
    bookmark[2]=1 bookmark[3]=0 focus=0 context=3
    match=${_ZLE_PICKER_RESULTS[1]:-0}
    [[ -n $name ]] && _git_review_event_status+=' · previous selection no longer in results'
  fi
  _git_review_refresh_status=''
  if (( match )); then
    _git_review_document_load "$root" "$match" "$oid" "$parent" "$context" || return $?
  fi
  _git_review_refresh_succeeded=1
  if [[ $_ZLE_PICKER_OPTIONS_KIND == file-views ]]; then
    _git_tree_bookmark=() _git_flat_bookmark=()
    _git_review_tree_reconcile
    _git_review_file_reselect "$match"
    local -i folder_rank=0
    [[ $selected_row == d:* ]] && folder_rank=${_ZLE_PICKER_RESULTS[(Ie)$selected_row]}
    (( folder_rank )) && bookmark[2]=$folder_rank
    if (( (rank || folder_rank) && bookmark[2] > 0 )); then
      (( old_slot < 1 )) && old_slot=1
      bookmark[3]=$(( bookmark[2] - old_slot ))
      (( bookmark[3] < 0 )) && bookmark[3]=0
    fi
  fi
  return 0
}

_git_review_manual_refresh_auto_state() {
  emulate -L zsh
  local -i succeeded=$1 resume_after_failure=$2 auto_was_enabled=$3
  _git_auto_checked_at=$EPOCHSECONDS
  if (( succeeded )); then
    _git_auto_updated_at=$EPOCHSECONDS
    _git_auto_failed=0
    (( resume_after_failure )) && _ZLE_PICKER_AUTO_REFRESH=1
    _git_auto_next_at=$(( EPOCHREALTIME + _GIT_REVIEW_AUTO_REFRESH_INTERVAL ))
  elif (( _ZLE_PICKER_AUTO_REFRESH >= 0 )); then
    _ZLE_PICKER_AUTO_REFRESH=0
    (( resume_after_failure || auto_was_enabled )) && _git_auto_failed=1 || _git_auto_failed=0
  fi
}

# Scope file snapshots and reading bookmarks to this review workspace.
# Derive a folder map from the current captured list, never the filesystem.
# Directory IDs are exact prefixes; file IDs remain original snapshot indexes.
_git_review_atlas_rows() {
  emulate -L zsh
  local prefix=$1 name='' tail='' directory='' value='' members='' label='' bar=''
  local -i index=0 count=0 maximum=1 cells=0 staged=0 unstaged=0 untracked=0 conflicts=0 committed=0
  local -a order=() indexes=()
  _atlas_values=() _atlas_labels=() _atlas_groups=() _atlas_details=()
  for (( index=1; index<=${#_GIT_REVIEW_PATHS}; ++index )); do
    name=$_GIT_REVIEW_PATHS[index]
    [[ $name == "$prefix"* ]] || continue
    tail=${name#"$prefix"}
    # A trailing slash is a captured entry (e.g. nested repository), not a
    # discoverable directory. No recursion into paths absent from the snapshot.
    if [[ $tail == */?* ]]; then
      directory="$prefix${tail%%/*}/" value="d:$directory"
      [[ -n ${_atlas_groups[$directory]-} ]] || order+=("$value")
      _atlas_groups[$directory]+=" $index"
    else
      order+=("f:$index")
    fi
  done
  for directory in "${(@k)_atlas_groups}"; do
    members=${_atlas_groups[$directory]# }
    _atlas_groups[$directory]=$members
    indexes=(${=members})
    (( ${#indexes} > maximum )) && maximum=${#indexes}
  done
  for value in "${order[@]}"; do
    if [[ $value == d:* ]]; then
      directory=${value#d:} members=${_atlas_groups[$directory]}
      indexes=(${=members}) count=${#indexes}
      cells=$(( (12 * count + maximum - 1) / maximum ))
      bar=''
      repeat $cells; do bar+='▰'; done
      label="${directory#"$prefix"} · $count entries $bar"
      staged=0 unstaged=0 untracked=0 conflicts=0 committed=0
      for index in "${indexes[@]}"; do
        case $_GIT_REVIEW_KINDS[index] in
          staged) (( ++staged )) ;; unstaged) (( ++unstaged )) ;;
          untracked) (( ++untracked )) ;; conflict) (( ++conflicts )) ;;
          commit|comparison) (( ++committed )) ;;
        esac
      done
      _atlas_details[$value]="$directory"$'\n'"$count captured change entries"$'\n'"$staged staged · $unstaged unstaged · $untracked untracked · $conflicts conflicts"$'\n\nBars compare entry counts in these folders.\nA staged and an unstaged change count separately.\nEnter opens this captured folder; no discovery.'
      (( committed )) && _atlas_details[$value]+=$'\n'"$committed committed entries"
    else
      index=${value#f:}
      label="${_GIT_REVIEW_PATHS[index]#"$prefix"} · $_GIT_REVIEW_KINDS[index]"
      _atlas_details[$value]="$_GIT_REVIEW_PATHS[index]"$'\n'"$_GIT_REVIEW_CONTEXTS[index]"$'\n\nEnter reads this exact change.\nThe reader opens focused diff; Right expands full context.\nEscape returns to this map and selection.'
    fi
    _atlas_values+=("$value") _atlas_labels+=("$label")
  done
  return 0
}

_git_review_atlas_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local query=${1:l}
  local exclusion_pattern='*' REPLY=''
  if [[ -n ${_ZLE_PICKER_EXCLUDE:-} ]]; then
    (( ${+functions[_matching_exclusion]} )) || return 1
    _matching_exclusion "$_ZLE_PICKER_EXCLUDE" || return
    exclusion_pattern=$REPLY
  fi
  local -i index=0
  _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
  for (( index=1; index<=${#_atlas_values}; ++index )); do
    [[ ${_atlas_labels[index]:l} == *"$query"* && ${_atlas_labels[index]} == ${~exclusion_pattern} ]] || continue
    _ZLE_PICKER_RESULTS+=("$_atlas_values[index]") _ZLE_PICKER_LABELS+=("$_atlas_labels[index]")
    (( ${#_ZLE_PICKER_RESULTS} >= $2 )) && break
  done
  return 0
}

_git_review_atlas_view() {
  emulate -L zsh
  _ZLE_PICKER_TITLE='Git / Change atlas' _ZLE_PICKER_SUBTITLE="${_atlas_scope:-${1:t}} / ${2:-.}"
  _ZLE_PICKER_QUERY_LABEL='Filter this level' _ZLE_PICKER_COLLECTOR=_git_review_atlas_collect
  _ZLE_PICKER_BROWSE_LABEL="${#_GIT_REVIEW_PATHS} captured entries · file distribution · read-only"
  [[ -n $_GIT_REVIEW_NOTICE ]] && _ZLE_PICKER_BROWSE_LABEL+=" · $_GIT_REVIEW_NOTICE"
  _ZLE_PICKER_INSPECT_TITLE=Area _ZLE_PICKER_INSPECT_ACTION=open
  _ZLE_PICKER_INSPECT_TEXTS=("${(@kv)_atlas_details}")
  _ZLE_PICKER_EMPTY_LABEL='no captured entries at this level'
  _ZLE_PICKER_INSPECT_FALLBACK="$_GIT_REVIEW_SUMMARY"$'\n'"$_GIT_REVIEW_NOTICE"
  _ZLE_PICKER_TRAIL=('Areas' 'Files' 'Diff')
  _ZLE_PICKER_GUIDE_CONTEXT=('Map of captured change entries, not a filesystem browser.'
    'Bars show relative entry counts, not line counts or importance.'
    'Each staged / unstaged change retains its own identity.'
    'No list refresh while the atlas is open; return to review to refresh.' "$_GIT_REVIEW_NOTICE")
  _ZLE_PICKER_GUIDE_CONTEXT+=("${_atlas_guide[@]}")
  local value=''
  for value in "${_atlas_values[@]}"; do
    if [[ $value == d:* ]]; then
      _ZLE_PICKER_ACCEPT_LABELS[$value]='open folder'
      _ZLE_PICKER_LABEL_HIGHLIGHTS[$value]="0:${#${value#d:}}:picker-header"
    else
      _ZLE_PICKER_ACCEPT_LABELS[$value]='read diff'
    fi
  done
  _zle_picker_start_focus=${6:-0}
  _zle_picker_loop "${3:-}" 20 "${4:-1}" "${5:-0}" "${7:-}" "${8:-0}" "${9:-0}"
}

_git_review_atlas_level() {
  emulate -L zsh
  local root=$1 prefix=$2 oid=$3 parent=$4 choice=''
  local -a bookmark=('' 1 0) _atlas_values=() _atlas_labels=()
  local -A _atlas_details=() _atlas_groups=()
  local -i result=0 focus=0
  _git_review_atlas_rows "$prefix"
  while true; do
    _zle_ui_view choice _git_review_atlas_view "$root" "$prefix" "${bookmark[@][1,3]}" "$focus" "${bookmark[4]-}" "${bookmark[5]:-0}" "${bookmark[6]:-0}"
    result=$?
    (( result == 0 )) || return $result
    choice=$_ZLE_PICKER_SELECTED_VALUE
    bookmark=("${_ZLE_PICKER_BOOKMARK[@]}") focus=$_ZLE_PICKER_BOOKMARK_FOCUS
    if [[ $choice == d:* && -n ${_atlas_groups[${choice#d:}]-} ]]; then
      _git_review_atlas_level "$root" "${choice#d:}" "$oid" "$parent"
    elif [[ $choice == f:<-> ]] && (( ${choice#f:} >= 1 && ${choice#f:} <= ${#_GIT_REVIEW_PATHS} )); then
      if (( ${_git_review_reads_blocked:-0} )); then
        _zle_ui_read_text 'Atlas / Reading unavailable' "$root" \
          'Safe Git preparation failed. Return to review and retry Ctrl-R before opening uncached file content.'
      else
        _git_review_view "$root" atlas-file "${choice#f:}" "$oid" "$parent"
      fi
    else
      return 2
    fi
    result=$?
    (( result > 1 )) && return $result
  done
}

_git_review_atlas() {
  emulate -L zsh
  local _atlas_scope=$_ZLE_PICKER_SUBTITLE
  local -a _atlas_guide=("${_ZLE_PICKER_GUIDE_CONTEXT[@]}")
  local -a _atlas_paths=("${_GIT_REVIEW_PATHS[@]}") _atlas_kinds=("${_GIT_REVIEW_KINDS[@]}")
  local -a _atlas_source_labels=("${_GIT_REVIEW_LABELS[@]}") _atlas_contexts=("${_GIT_REVIEW_CONTEXTS[@]}")
  local -a _atlas_source_details=("${_GIT_REVIEW_DETAILS[@]}")
  _git_review_atlas_level "$1" '' "${2:-}" "${3:-}"
}

_git_review_view() {
  emulate -L zsh
  # Syntax capture is a screen-session child, not a user shell job. MONITOR
  # emits both `[n] pid` at launch and `[n] + done …` at completion; either can
  # interleave with ZLE's frame bytes and composite stale documents on screen.
  # Keep job control off for this function's dynamic lifetime so workers remain
  # waitable/reapable without terminal job records. `emulate -L` restores the
  # user's MONITOR/NOTIFY options as soon as the workspace exits.
  unsetopt MONITOR NOTIFY
  setopt EXTENDED_GLOB
  zmodload zsh/datetime || return 2
  local root=$1 kind=$2 target=${3:-} oid=${4:-} parent=${5:-}
  local _git_file_view=flat _git_file_location='' _git_tree_scope='' _git_tree_filter='' _git_tree_exclude='' _git_tree_filter_scope=''
  local selected_value=''
  local -a _git_tree_bookmark=() _git_flat_bookmark=()
  local _git_tree_selected='' _git_flat_selected='' _git_tree_document='' _git_flat_document=''
  local -A _git_tree_expanded=() _git_tree_filter_expanded=() _git_tree_depths=()
  local -A _ZLE_PICKER_DOCUMENT_BRANCHES=()
  local -A _ZLE_PICKER_LABEL_PREFIXES=()
  local -i _ZLE_PICKER_CONTEXT_MIN_WIDTH=0
  local -a _git_tree_scopes=() _git_tree_returns=() _git_tree_filter_scopes=() _git_tree_filter_returns=()
  local _ZLE_PICKER_TITLE='' _ZLE_PICKER_SUBTITLE="${root:t} · read-only"
  local _ZLE_PICKER_OPTIONS_KIND=''
  local _ZLE_PICKER_SUBTITLE_RENDERER=''
  local _ZLE_PICKER_BROWSE_RENDERER=''
  local _ZLE_PICKER_INSPECT_TITLE=Details _ZLE_PICKER_INSPECT_ACTION=diff
  local _ZLE_PICKER_CANCEL_LABEL=back _ZLE_PICKER_QUERY_LABEL='Filter files'
  local _ZLE_PICKER_COLLECTOR=_navigation_picker_collect _ZLE_PICKER_BROWSE_LABEL=''
  local _ZLE_PICKER_EMPTY_LABEL='no matching entries'
  local _ZLE_PICKER_SEARCH_ACTION=''
  local _ZLE_PICKER_IDLE_CALLBACK=_git_review_idle _ZLE_PICKER_IDLE_ACTION=''
  local _ZLE_PICKER_INSPECT_FALLBACK='' _ZLE_PICKER_INSPECT_EXPAND_KEY=''
  local -i _ZLE_PICKER_WORKSPACE_ACTIONS=0 _zle_picker_start_focus=0
  local -i result=0 index=0 focus=0 _git_review_reads_blocked=0
  local -i _ZLE_PICKER_DOCUMENT=0 context=3 _ZLE_PICKER_DOCUMENT_TARGET_ROW=0 _ZLE_PICKER_DOCUMENT_REFRESH=0
  local -i _ZLE_PICKER_DOCUMENT_PENDING=0 _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=0
  local -i _ZLE_PICKER_AUTO_REFRESH=-1 _git_review_refresh_succeeded=0
  local -i _ZLE_PICKER_DOCUMENT_SETTLE_TICKS=4
  local -F _ZLE_PICKER_IDLE_WAIT=0
  local -F _ZLE_PICKER_DEADLINE_AT=0
  local _ZLE_PICKER_DEADLINE_CALLBACK=''
  local _ZLE_PICKER_DOCUMENT_KEY='' _ZLE_PICKER_DOCUMENT_TITLE='' _GIT_REVIEW_DOCUMENT_SUMMARY='' _ZLE_PICKER_DOCUMENT_MODE=''
  local _git_review_refresh_status='' _git_review_event_status=''
  local _git_syntax_session_dir='' _git_syntax_session_request_fifo=''
  local _git_syntax_session_response_fifo='' _git_syntax_session_buffer=''
  local -i _git_syntax_session_fd=-1 _git_syntax_session_pid=0
  local -i _git_syntax_session_ready=0 _git_syntax_session_generation=0
  local -i _git_syntax_session_active_id=0
  local -i _git_syntax_active_first=0 _git_syntax_active_last=0
  local -i _git_review_snapshot_epoch=1 _git_syntax_active_epoch=0
  local -F _git_syntax_session_deadline=0
  local _git_syntax_active_key='' _git_syntax_active_note=''
  local _git_syntax_status_note=''
  local _git_auto_session_dir='' _git_auto_session_fifo='' _git_auto_session_buffer=''
  local _git_auto_request_name='' _git_auto_request_kind='' _git_auto_request_context=''
  local _git_auto_candidate_summary='' _git_auto_candidate_notice=''
  local _git_auto_candidate_request_name='' _git_auto_candidate_request_kind=''
  local _git_auto_candidate_request_context='' _git_auto_candidate_diff_data=''
  local -i _git_auto_session_fd=-1 _git_auto_session_pid=0 _git_auto_generation=0
  local -i _git_auto_candidate_ready=0 _git_auto_candidate_result=0
  local -i _git_auto_candidate_generation=0 _git_auto_candidate_prepare_result=0
  local -i _git_auto_candidate_list_truncated=0
  local -i _git_auto_candidate_match=0 _git_auto_candidate_diff_result=0
  local -i _git_auto_candidate_diff_truncated=0 _git_auto_failed=0
  local -i _git_auto_checked_at=0 _git_auto_updated_at=0
  local -F _git_auto_started_at=0 _git_auto_deadline_at=0 _git_auto_next_at=0
  local -F _git_auto_candidate_capture_duration=0
  local -a _ZLE_PICKER_DOCUMENT_LINES=() _ZLE_PICKER_DOCUMENT_ROLES=() _git_document_order=()
  local -A _ZLE_PICKER_DOCUMENT_OFFSETS=() _git_document_cache=() _git_document_partial=()
  local -A _ZLE_PICKER_DOCUMENT_SYNTAX=() _git_document_syntax_cache=() _git_document_syntax_notes=()
  local -A _git_document_syntax_first=() _git_document_syntax_last=()
  local -A _git_document_syntax_failures=()
  local -A _ZLE_PICKER_DOCUMENT_ROWS=() _git_document_contexts=() _git_document_anchors=()
  local -a _GIT_REVIEW_DOCUMENT_OLD=() _GIT_REVIEW_DOCUMENT_NEW=()
  local -a _GIT_REVIEW_PATHS=() _GIT_REVIEW_LABELS=() _GIT_REVIEW_KINDS=()
  local -a _GIT_REVIEW_CONTEXTS=() _GIT_REVIEW_DETAILS=() _GIT_REVIEW_PARENTS=()
  local -a _git_auto_candidate_config=() _git_auto_candidate_paths=()
  local -a _git_auto_candidate_labels=() _git_auto_candidate_kinds=()
  local -a _git_auto_candidate_contexts=() _git_auto_candidate_details=()
  local -a _git_auto_candidate_parents=()
  local _GIT_REVIEW_DATA='' _GIT_REVIEW_SUMMARY='' _GIT_REVIEW_NOTICE=''
  local -i _GIT_REVIEW_TRUNCATED=0 _GIT_REVIEW_DOCUMENT_HAS_CODE=0
  local -a _NAVIGATION_PICKER_VALUES=() _NAVIGATION_PICKER_LABELS=()
  local -a _NAVIGATION_PICKER_INDEXES=() _NAVIGATION_PICKER_SEARCH_LABELS=()
  local -A _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -a _ZLE_PICKER_EMPTY_LINES=() _ZLE_PICKER_TRAIL=() bookmark=('' 1 0)
  local -a _ZLE_PICKER_GUIDE_CONTEXT=()
  case $kind in
    (atlas-file)
      [[ $target == <-> ]] && (( target >= 1 && target <= ${#_atlas_paths} )) || return 2
      _GIT_REVIEW_PATHS=("$_atlas_paths[target]") _GIT_REVIEW_KINDS=("$_atlas_kinds[target]")
      _GIT_REVIEW_LABELS=("$_atlas_source_labels[target]") _GIT_REVIEW_CONTEXTS=("$_atlas_contexts[target]")
      _GIT_REVIEW_DETAILS=("$_atlas_source_details[target]")
      _ZLE_PICKER_TITLE='Atlas / Read change'
      _ZLE_PICKER_SUBTITLE=${_atlas_scope:-${root:t}}
      _ZLE_PICKER_GUIDE_CONTEXT=("${_atlas_guide[@]}")
      _GIT_REVIEW_SUMMARY='One captured change · Escape returns to the atlas'
      _ZLE_PICKER_DOCUMENT=1 _ZLE_PICKER_INSPECT_ACTION=read _ZLE_PICKER_INSPECT_TITLE=Diff ;;
    (working)
      _git_review_load _git_review_changes_capture "$root"; result=$?
      _ZLE_PICKER_TITLE='Working changes'
      _ZLE_PICKER_SUBTITLE="${root:t} · current working tree · read-only"
      [[ $ZSH_GIT_REVIEW_AUTO_REFRESH == 0 ]] && _ZLE_PICKER_AUTO_REFRESH=0 || _ZLE_PICKER_AUTO_REFRESH=1
      _ZLE_PICKER_DEADLINE_CALLBACK=_git_review_auto_deadline
      _git_auto_checked_at=$EPOCHSECONDS
      (( result == 0 )) && _git_auto_updated_at=$EPOCHSECONDS
      _git_auto_next_at=$(( EPOCHREALTIME + _GIT_REVIEW_AUTO_REFRESH_INTERVAL )) ;;
    (commits)
      _git_review_load _git_review_commits_capture "$root" "$oid"; result=$?
      _ZLE_PICKER_TITLE='Branch commits' _ZLE_PICKER_QUERY_LABEL='Filter commits'
      _ZLE_PICKER_SUBTITLE="${root:t} · $target · captured tip ${oid[1,12]}"
      _ZLE_PICKER_INSPECT_ACTION=files ;;
    (files)
      _git_review_load _git_review_commit_files_capture "$root" "$oid" "$parent"; result=$?
      _ZLE_PICKER_TITLE='Commit files' ;;
    (comparison)
      _git_review_load _git_review_comparison_files_capture "$root" "$oid" "$parent"; result=$?
      _ZLE_PICKER_TITLE='Git comparison'
      _ZLE_PICKER_SUBTITLE="$_git_compare_context · ${root:t}"
      _ZLE_PICKER_SUBTITLE_RENDERER=_git_review_comparison_subtitle
      _ZLE_PICKER_GUIDE_CONTEXT=("$_git_compare_method_label · ${root:t} · committed content"
        "Against (From): $_git_compare_from_label" "$_git_compare_from"
        "Compare (To): $_git_compare_to_label" "$_git_compare_to"
        'Actual old endpoint:' "$parent" 'Actual new endpoint:' "$oid"
        'Ctrl-R rereads these same IDs; it does not follow moving branches.'
        'Choose a ref again in setup, or rerun g --review, to acquire a newer tip.') ;;
    (*) return 2 ;;
  esac
  if [[ $kind == (working|files|comparison) ]]; then
    _ZLE_PICKER_DOCUMENT=1 _ZLE_PICKER_DOCUMENT_REFRESH=1
    _ZLE_PICKER_INSPECT_ACTION=read _ZLE_PICKER_INSPECT_TITLE=Diff
    _ZLE_PICKER_OPTIONS_KIND=file-views
    _ZLE_PICKER_COLLECTOR=_git_review_file_collect
    _ZLE_PICKER_SUBTITLE_RENDERER=_git_review_file_subtitle
    _ZLE_PICKER_BROWSE_RENDERER=_git_review_file_browse
    _ZLE_PICKER_CONTEXT_MIN_WIDTH=11
    _ZLE_PICKER_WORKSPACE_ACTIONS=1
  fi
  _ZLE_PICKER_BROWSE_LABEL=$_GIT_REVIEW_SUMMARY
  if (( !${#_GIT_REVIEW_LABELS} )); then
    _ZLE_PICKER_EMPTY_LINES=('No changes in this snapshot' 'Escape returns to the previous view.' "$_GIT_REVIEW_NOTICE")
    (( _ZLE_PICKER_DOCUMENT_REFRESH )) && _ZLE_PICKER_EMPTY_LINES[2]='Ctrl-R refreshes now; Escape returns.'
  fi
  if (( result )); then
    _ZLE_PICKER_EMPTY_LINES=('Unavailable: Git could not capture this view.' 'No changes were made. Escape returns to the previous view.')
    _ZLE_PICKER_BROWSE_LABEL='capture failed · read-only'
    _git_review_reset
    if (( _ZLE_PICKER_AUTO_REFRESH >= 0 )); then
      if (( _ZLE_PICKER_AUTO_REFRESH )); then
        _ZLE_PICKER_AUTO_REFRESH=0 _git_auto_failed=1
      else
        _git_auto_failed=0
      fi
      _git_review_event_status='initial capture failed'
    fi
  fi
  _git_review_rows
  _git_review_status_apply >/dev/null
  {
  if (( _ZLE_PICKER_DOCUMENT && ${+functions[_git_syntax_session_start]} )); then
    _git_syntax_session_start || true
  fi
  if [[ $kind == atlas-file ]]; then
    _git_review_document_load "$root" 1 "$oid" "$parent" "$context" || return $?
    focus=1
  elif [[ ${6:-} == atlas ]]; then
    _git_review_atlas "$root" "$oid" "$parent"
    return $?
  elif [[ $_ZLE_PICKER_OPTIONS_KIND == file-views ]] && (( ${#_GIT_REVIEW_PATHS} )); then
    _git_review_file_reselect 1
    if [[ ${_ZLE_PICKER_RESULTS[(Ie)1]} == 0 ]]; then
      _git_review_document_load "$root" 1 "$oid" "$parent" "$context" || return $?
    fi
  fi
  while true; do
    _ZLE_PICKER_DIGIT_SELECT=1 _ZLE_PICKER_COPY_ENABLED=0
    _zle_picker_start_focus=$focus
    _zle_picker_loop "${bookmark[1]}" 20 "${bookmark[2]}" "${bookmark[3]}" "${bookmark[4]-}" "${bookmark[5]:-0}" "${bookmark[6]:-0}"
    result=$?
    if (( result == 1 )) && [[ $_ZLE_PICKER_OPTIONS_KIND == file-views ]]; then
      bookmark=("${_ZLE_PICKER_BOOKMARK[@]}")
      _git_review_tree_back && continue
    fi
    (( result == 0 )) || return $result
    bookmark=("${_ZLE_PICKER_BOOKMARK[@]}") focus=$_ZLE_PICKER_BOOKMARK_FOCUS
    selected_value=$_ZLE_PICKER_SELECTED_VALUE
    index=0
    [[ $selected_value == <-> ]] && index=$selected_value
    if (( _ZLE_PICKER_DOCUMENT )); then
      if [[ $_ZLE_PICKER_ACTION == actions && $_ZLE_PICKER_OPTIONS_KIND == file-views ]]; then
        _git_review_auto_worker_stop
        _git_review_auto_candidate_clear
        _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=0
        _git_review_file_options "$selected_value" || return $?
        _git_auto_next_at=$(( EPOCHREALTIME + _GIT_REVIEW_AUTO_REFRESH_INTERVAL ))
        continue
      fi
      if [[ $selected_value == d:* ]]; then
        if [[ $_ZLE_PICKER_ACTION == select ]] && (( !focus )); then
          _git_review_tree_enter "$selected_value"
          continue
        fi
        index=${_ZLE_PICKER_DOCUMENT_KEY:-0}
      fi
      if [[ $_ZLE_PICKER_ACTION == document-auto-toggle ]]; then
        if (( _ZLE_PICKER_AUTO_REFRESH )); then
          _ZLE_PICKER_AUTO_REFRESH=0
          _git_auto_failed=0
          _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=0
          _git_review_auto_worker_stop
          _git_review_auto_candidate_clear
          _git_review_event_status=''
        else
          _ZLE_PICKER_AUTO_REFRESH=1
          _git_auto_failed=0
          _git_auto_next_at=$EPOCHREALTIME
          _git_review_event_status=''
        fi
        _git_review_status_apply >/dev/null
        continue
      fi
      if [[ $_ZLE_PICKER_ACTION == (document-auto-refresh|document-auto-apply) ]]; then
        _git_review_auto_publish "$root" "$selected_value" || return $?
        continue
      fi
      if [[ $_ZLE_PICKER_ACTION == document-refresh ]]; then
        local -i resume_after_failure=$_git_auto_failed
        local -i auto_was_enabled=$_ZLE_PICKER_AUTO_REFRESH
        _git_review_auto_worker_stop
        _git_review_auto_candidate_clear
        _ZLE_PICKER_DOCUMENT_UPDATE_PENDING=0
        _git_review_refresh "$root" "$kind" "$oid" "$parent" "$index" "$selected_value" || return $?
        _git_review_manual_refresh_auto_state $_git_review_refresh_succeeded \
          $resume_after_failure $auto_was_enabled
        _git_review_status_apply >/dev/null
        continue
      fi
      if (( index > 0 )); then
        case $_ZLE_PICKER_ACTION in
          (document-full|document-focused)
            case $_ZLE_PICKER_ACTION in
              (document-full) context=1000000000 ;;
              (document-focused) context=3 ;;
            esac
            _git_review_document_load "$root" "$index" "$oid" "$parent" "$context" || return $? ;;
          (*)
            [[ $_ZLE_PICKER_ACTION == select ]] && focus=1
            if [[ $index != "$_ZLE_PICKER_DOCUMENT_KEY" ]]; then
              _git_review_document_load "$root" "$index" "$oid" "$parent" "$context" || return $?
            fi ;;
        esac
      fi
      continue
    fi
    case $kind in
      (commits) _git_review_view "$root" files '' "${_GIT_REVIEW_PATHS[index]}" "${_GIT_REVIEW_PARENTS[index]}" ;;
    esac
    result=$?
    (( result > 1 )) && return $result
  done
  } always {
    _git_review_auto_session_stop
    _git_review_syntax_cleanup
  }
}

# Small choice lists and text entry use the shared input loop. All state belongs
# to the caller; opening a child view never re-registers keys or owns a screen.
_git_review_pick() {
  _zle_ui_view "${8:-choice}" _git_review_choice_view "$@"
}

_git_review_choice_view() {
  emulate -L zsh
  _ZLE_PICKER_TITLE=$1 _ZLE_PICKER_SUBTITLE=$2 _ZLE_PICKER_QUERY_LABEL=$3
  _ZLE_PICKER_BROWSE_LABEL=${_git_compare_status:-read-only comparison}
  _ZLE_PICKER_COLLECTOR=${_git_compare_collector:-_navigation_picker_collect}
  _zle_picker_start_focus=${7:-0}
  _ZLE_PICKER_INSPECT_TEXTS=("${(@kv)_git_compare_details}")
  _ZLE_PICKER_ACCEPT_LABELS=("${(@kv)_git_compare_actions}")
  if (( _ZLE_PICKER_ACTION_VIEW )); then
    _ZLE_PICKER_ACTION_CONTEXT="COMPARISON"$'\n'"$2"$'\n\nRead-only · captured endpoints'
    local -a reply=()
    _zle_ui_descriptions "${(@kv)_git_compare_details}"
    _ZLE_PICKER_DESCRIPTIONS=("${reply[@]}")
  fi
  _zle_picker_loop "${4:-}" 10 "${5:-1}" "${6:-0}" "${9:-}" "${10:-0}" "${11:-0}"
}

_git_review_ref_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local REPLY=''
  if [[ -n ${_ZLE_PICKER_EXCLUDE:-} ]]; then
    (( ${+functions[_matching_exclusion]} )) || return 1
    _matching_exclusion "$_ZLE_PICKER_EXCLUDE" || return
    if [[ 'Enter branch or commit…' != ${~REPLY} ]]; then
      _navigation_picker_collect "$@"
      return $?
    fi
  fi
  # Enter accepts the best ref. Keep literal input in a stable second slot;
  # appending it to a growing result prefix would move it during pagination.
  _navigation_picker_collect "$1" "$(( $2 > 1 ? $2 - 1 : 1 ))"
  (( $2 > 1 )) || { _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=(); }
  if (( ${#_ZLE_PICKER_RESULTS} )); then
    _ZLE_PICKER_RESULTS=("$_ZLE_PICKER_RESULTS[1]" enter "${_ZLE_PICKER_RESULTS[@]:1}")
    _ZLE_PICKER_LABELS=("$_ZLE_PICKER_LABELS[1]" 'Enter branch or commit…' "${_ZLE_PICKER_LABELS[@]:1}")
    _ZLE_PICKER_RESULT_INDEXES=("$_ZLE_PICKER_RESULT_INDEXES[1]" 0 "${_ZLE_PICKER_RESULT_INDEXES[@]:1}")
  else
    _ZLE_PICKER_RESULTS=(enter) _ZLE_PICKER_LABELS=('Enter branch or commit…') _ZLE_PICKER_RESULT_INDEXES=(0)
  fi
}

_git_review_revision_text() {
  _zle_ui_view query _git_review_revision_view "$@"
}

_git_review_revision_view() {
  emulate -L zsh
  local root=$1 endpoint=$2 draft=${3:-}
  local -i result=0
  local purpose=Compare opposite="Against: ${_git_compare_from_label:-not chosen}"
  [[ $endpoint == From ]] && { purpose=Against; opposite="Compare: ${_git_compare_to_label:-not chosen}"; }
  _ZLE_PICKER_TITLE="${purpose} · enter branch or commit" _ZLE_PICKER_SUBTITLE="${root:t} · $opposite"
  _ZLE_PICKER_QUERY_LABEL='Branch or commit' _ZLE_PICKER_INSPECT_ACTION=use
  _ZLE_PICKER_BROWSE_LABEL='Enter a branch, tag, HEAD or commit ID'
  _ZLE_PICKER_EMPTY_LINES=('Literal names and hexadecimal IDs; no ranges, paths or shell expansion.'
    'Nothing is fetched. Digits remain text. Escape keeps the previous endpoint.')
  while true; do
    _zle_picker_loop "$draft" 10
    result=$?
    (( result == 0 )) || return $result
    draft=$_ZLE_PICKER_SELECTED_VALUE
    if _git_review_load _git_review_resolve "$root" "$draft"; then
      _git_compare_label=$draft
      return 0
    fi
    _ZLE_PICKER_BROWSE_LABEL=$_GIT_REVIEW_ERROR
  done
}

_git_review_endpoint_choose() {
  emulate -L zsh
  local root=$1 endpoint=$2 value='' oid='' _git_compare_status='' _git_compare_collector=_git_review_ref_collect
  local purpose=Compare opposite="Against: ${_git_compare_from_label:-not chosen}"
  [[ $endpoint == From ]] && { purpose=Against; opposite="Compare: ${_git_compare_to_label:-not chosen}"; }
  local -i index=0 result=0 focus=0
  local -a _GIT_REVIEW_REFS=() _GIT_REVIEW_REF_OIDS=() _GIT_REVIEW_REF_LABELS=() bookmark=('' 1 0)
  local -a _NAVIGATION_PICKER_VALUES=() _NAVIGATION_PICKER_LABELS=() _NAVIGATION_PICKER_INDEXES=() _NAVIGATION_PICKER_SEARCH_LABELS=()
  local -A _git_compare_details=() _git_compare_actions=(enter enter)
  if _git_review_load _git_review_refs_capture "$root"; then
    _git_compare_status="${#_GIT_REVIEW_REFS} local refs · Enter chooses this side · no checkout"
    (( _GIT_REVIEW_TRUNCATED )) && _git_compare_status+=' · partial at 1,000 refs / 256 KiB'
    for (( index=1; index<=${#_GIT_REVIEW_REFS}; ++index )); do
      value=$_GIT_REVIEW_REFS[index]
      _NAVIGATION_PICKER_VALUES+=("$index") _NAVIGATION_PICKER_INDEXES+=("$index")
      _NAVIGATION_PICKER_LABELS+=("$_GIT_REVIEW_REF_LABELS[index]")
      _git_compare_details[$index]="$value"$'\n'"$_GIT_REVIEW_REF_OIDS[index]"$'\n\nCaptured locally; no checkout or fetch.'
      _git_compare_actions[$index]=use
    done
  else
    _git_compare_status='Ref capture failed · enter an exact revision or return and retry'
  fi
  _git_compare_details[enter]='Enter an exact name or commit ID; validation runs only when submitted.'
  while true; do
    _git_review_pick "$purpose · choose branch or commit" "${root:t} · $opposite" 'Find branch or tag' "${bookmark[@][1,3]}" "$focus" choice "${bookmark[4]-}" "${bookmark[5]:-0}" "${bookmark[6]:-0}"
    result=$?
    (( result == 0 )) || return $result
    value=$_ZLE_PICKER_SELECTED_VALUE bookmark=("${_ZLE_PICKER_BOOKMARK[@]}") focus=$_ZLE_PICKER_BOOKMARK_FOCUS
    if [[ $value == enter ]]; then
      _git_review_revision_text "$root" "$endpoint" "${bookmark[1]}"
      result=$?
      (( result == 1 )) && continue
      return $result
    fi
    oid=${_GIT_REVIEW_REF_OIDS[value]}
    if (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$oid" &&
       _git_review_load _git_review_capture "$root" rev-parse --verify --end-of-options "$oid^{commit}"; then
      oid=${_GIT_REVIEW_DATA%$'\n'}
      if (( !_GIT_REVIEW_TRUNCATED )) && (( ${+functions[_compozsh_git_valid_oid]} )) && _compozsh_git_valid_oid "$oid"; then
        REPLY=$oid
        if [[ $_GIT_REVIEW_REFS[value] == refs/heads/* ]]; then
          _git_compare_label=${_GIT_REVIEW_REFS[value]#refs/heads/}
        else
          _git_compare_label=$_GIT_REVIEW_REF_LABELS[value]
        fi
        return 0
      fi
    fi
    _git_compare_status='Selected ref has no available local commit. Choose another revision.'
  done
}

_git_review_comparison_context() {
  emulate -L zsh
  _git_compare_method_label='All differences'
  _git_compare_context="From $_git_compare_from_label @ ${_git_compare_from[1,12]} → To $_git_compare_to_label @ ${_git_compare_to[1,12]}"
  if [[ $_git_compare_method == ancestor ]]; then
    _git_compare_method_label='Changes since common ancestor'
    if [[ -n $_git_compare_before ]]; then
      _git_compare_context="Ancestor ${_git_compare_before[1,12]} of $_git_compare_from_label → To $_git_compare_to_label @ ${_git_compare_to[1,12]}"
    else
      _git_compare_context="Common ancestor of $_git_compare_from_label and $_git_compare_to_label → To $_git_compare_to_label"
    fi
  fi
}

# Cell-aware presentation of the current comparison state. Preserve direction
# and both IDs before secondary labels; the summary keeps repository/method.
_git_review_comparison_subtitle() {
  emulate -L zsh
  local -i width=$1 available=0 left_width=0 right_width=0
  local from=${(V)_git_compare_from_label} to=${(V)_git_compare_to_label}
  local old=${_git_compare_from[1,12]} new=${_git_compare_to[1,12]}
  local prefix='From ' middle='' suffix=" @ $new" text=${(V)_ZLE_PICKER_SUBTITLE}
  if (( ${(m)#text} <= width )); then
    REPLY=$text
    return 0
  fi
  if [[ $_git_compare_method == ancestor ]]; then
    prefix="Ancestor ${_git_compare_before[1,12]} → To "
    available=$(( width - ${(m)#prefix} - ${(m)#suffix} ))
    _zle_picker_abbreviate "$to" "$available"
    _zle_picker_fit "$prefix$REPLY$suffix" "$width"
    return 0
  fi
  middle=" @ $old → To "
  available=$(( width - ${(m)#prefix} - ${(m)#middle} - ${(m)#suffix} ))
  if (( available < 2 )); then
    # Extremely narrow windows retain the target and direction first.
    _zle_picker_fit "→ To $to$suffix" "$width"
    return 0
  fi
  left_width=$(( available / 2 ))
  (( left_width > ${(m)#from} )) && left_width=${(m)#from}
  right_width=$(( available - left_width ))
  if (( right_width > ${(m)#to} )); then
    right_width=${(m)#to}
    left_width=$(( available - right_width ))
  fi
  _zle_picker_abbreviate "$from" "$left_width"
  text="$prefix$REPLY$middle"
  _zle_picker_abbreviate "$to" "$right_width"
  _zle_picker_fit "$text$REPLY$suffix" "$width"
}

_git_review_compare_choose() {
  emulate -L zsh
  local root=$1 selected=$2 choice='' _git_compare_status='Choose Against; both choices can be changed with Enter'
  local _git_compare_from='' _git_compare_to='' _git_compare_from_label='Choose branch or commit…' _git_compare_to_label='Choose branch or commit…'
  local _git_compare_method=exact _git_compare_before='' _git_compare_method_label='' _git_compare_context='' _git_compare_label=''
  local exact_text='' ancestor_text='' pair=''
  local -i result=0 focus=0 method_index=1
  local -a bookmark=('' 1 0) _NAVIGATION_PICKER_VALUES=() _NAVIGATION_PICKER_LABELS=() _NAVIGATION_PICKER_INDEXES=() _NAVIGATION_PICKER_SEARCH_LABELS=()
  local -A _git_compare_details=() _git_compare_actions=()
  if _git_review_load _git_review_resolve "$root" "${selected:+refs/heads/}${selected:-HEAD}"; then
    _git_compare_to=$REPLY _git_compare_to_label=${selected:-HEAD}
    bookmark[2]=2
  else
    _git_compare_status='Choose Compare, then Against; both choices can be changed'
  fi
  while true; do
    _git_review_comparison_context
    pair="Compare $_git_compare_to_label against $_git_compare_from_label"
    exact_text="Compare the committed content of $_git_compare_from_label and $_git_compare_to_label."$'\n'"Additions are in $_git_compare_to_label; removals are from $_git_compare_from_label."
    ancestor_text="Show changes toward $_git_compare_to_label since its common ancestor with $_git_compare_from_label."$'\n'"Later changes only on $_git_compare_from_label are excluded. This does not simulate a merge."
    _NAVIGATION_PICKER_VALUES=(to from method)
    _NAVIGATION_PICKER_LABELS=("Compare · $_git_compare_to_label" "Against · $_git_compare_from_label" "Show · $_git_compare_method_label")
    _NAVIGATION_PICKER_INDEXES=(1 2 3)
    _git_compare_actions=(from change to change method change open review)
    _git_compare_details=(from "Against: $_git_compare_from_label"$'\n'"$_git_compare_from"$'\n\n'"Enter changes the branch or commit used as the baseline for $_git_compare_to_label."
      to "Compare: $_git_compare_to_label"$'\n'"$_git_compare_to"$'\n\nEnter changes the branch or commit you want to review.\nThe highlighted branch is a starting choice; no checkout occurs.'
      method "$exact_text")
    [[ $_git_compare_method == ancestor ]] && _git_compare_details[method]=$ancestor_text
    if [[ -n $_git_compare_from && -n $_git_compare_to ]]; then
      _NAVIGATION_PICKER_VALUES+=(open) _NAVIGATION_PICKER_LABELS+=('Review differences') _NAVIGATION_PICKER_INDEXES+=(4)
      _git_compare_details[open]="$pair"$'\n'"$_git_compare_method_label"$'\n\n'"$_git_compare_context"$'\n\nRead-only · captured commits. Ctrl-R keeps their IDs.'
    fi
    _git_review_pick 'Compare branches or commits' "${root:t} · $pair" 'Filter choices' "${bookmark[@][1,3]}" "$focus" action "${bookmark[4]-}" "${bookmark[5]:-0}" "${bookmark[6]:-0}"
    result=$?
    (( result == 0 )) || return $result
    choice=$_ZLE_PICKER_SELECTED_VALUE bookmark=("${_ZLE_PICKER_BOOKMARK[@]}") focus=$_ZLE_PICKER_BOOKMARK_FOCUS
    case $choice in
      (from|to)
        _git_review_endpoint_choose "$root" "${(C)choice}"; result=$?
        if (( result == 0 )); then
          if [[ $choice == from ]]; then _git_compare_from=$REPLY _git_compare_from_label=$_git_compare_label
          else _git_compare_to=$REPLY _git_compare_to_label=$_git_compare_label; fi
          _git_compare_before=''
          bookmark=('' 1 0) focus=0
          if [[ -z $_git_compare_to ]]; then
            _git_compare_status='Choose Compare; Against is retained'
          elif [[ -z $_git_compare_from ]]; then
            bookmark[2]=2 _git_compare_status='Choose Against; Compare is retained'
          else
            bookmark[2]=4 _git_compare_status='Both choices can be changed; Review differences opens the reader'
          fi
        fi ;;
      (method)
        _NAVIGATION_PICKER_VALUES=(exact ancestor) _NAVIGATION_PICKER_LABELS=('All differences' 'Changes since common ancestor') _NAVIGATION_PICKER_INDEXES=(1 2)
        _git_compare_details=(exact "$exact_text" ancestor "$ancestor_text")
        _git_compare_actions=(exact use ancestor use)
        method_index=1
        [[ $_git_compare_method == ancestor ]] && method_index=2
        _git_review_pick 'Changes to show' "${root:t} · $pair" 'Filter choices' '' "$method_index" 0 0 action; result=$?
        if (( result == 0 )); then
          _git_compare_method=$_ZLE_PICKER_SELECTED_VALUE _git_compare_before=''
        fi ;;
      (open)
        if _git_review_load _git_review_prepare "$root" &&
           _git_review_load _git_review_compare_base "$root" "$_git_compare_method" "$_git_compare_from" "$_git_compare_to"; then
          _git_compare_before=$REPLY
          _git_review_comparison_context
          _git_review_view "$root" comparison '' "$_git_compare_to" "$_git_compare_before"; result=$?
        else
          _git_compare_status=${_GIT_REVIEW_ERROR:-Unable to establish safe local Git inspection.}
          result=1
        fi ;;
    esac
    (( result > 1 )) && return $result
  done
}

_git_review_direct_choose() {
  if (( ${#_git_compare_direct} )); then
    _git_review_view "$root" comparison '' "$_git_compare_to" "$_git_compare_before"
  else
    _git_review_menu "$root" "$_git_compare_branch" 1
  fi
}

_git_review_session() {
  emulate -L zsh
  local root='' _git_compare_branch='' _GIT_REVIEW_DATA='' _GIT_REVIEW_ERROR=''
  local _git_compare_method=${1:-exact} _git_compare_from='' _git_compare_to='' _git_compare_before=''
  local _git_compare_from_label=${2:-} _git_compare_to_label=${3:-} _git_compare_context='' _git_compare_method_label=''
  local -a _GIT_REVIEW_CONFIG=() _git_compare_direct=("$@")
  local -i _GIT_REVIEW_TRUNCATED=0 result=0
  if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]]; then
    print -u2 -r -- 'g --review: requires an interactive terminal; use git diff for plain output.'
    return 1
  fi
  if (( !${+functions[_zle_picker_run]} || !${+functions[_zle_picker_capture]} || !${+functions[_navigation_picker_collect]} || !${+functions[_matching_compile]} )); then
    print -u2 -r -- 'g --review: shared picker unavailable; keep .zsh.ui, .zsh.matching and .zsh.navigation installed.'
    return 1
  fi
  {
    _git_review_capture "$PWD" rev-parse --show-toplevel || {
      _GIT_REVIEW_ERROR='Run inside a Git working tree.'; return 1
    }
    root=${_GIT_REVIEW_DATA%$'\n'}
    (( !_GIT_REVIEW_TRUNCATED )) && [[ -d $root ]] || return 1
    _git_review_prepare "$root" || { _GIT_REVIEW_ERROR='Unable to establish safe local Git inspection.'; return 1; }
    if (( $# )); then
      _git_review_resolve "$root" "$2" || return 1
      _git_compare_from=$REPLY
      _git_review_resolve "$root" "$3" || return 1
      _git_compare_to=$REPLY
      _git_review_compare_base "$root" "$1" "$_git_compare_from" "$_git_compare_to" || return 1
      _git_compare_before=$REPLY
      _git_review_comparison_context
    elif _git_review_capture "$root" symbolic-ref --quiet HEAD; then
      _git_compare_branch=${_GIT_REVIEW_DATA%$'\n'}
      if (( _GIT_REVIEW_TRUNCATED )) || [[ $_git_compare_branch != refs/heads/* ]]; then
        _git_compare_branch=''
      else
        _git_compare_branch=${_git_compare_branch#refs/heads/}
      fi
      _git_review_resolve "$root" HEAD || _git_compare_branch=''
    fi
    _GIT_REVIEW_ERROR=''
    _zle_picker_run 10 '' 1 0 _git_review_direct_choose
    result=$?
    (( result == 1 )) && return 0
    return $result
  } always {
    [[ -n $_GIT_REVIEW_ERROR ]] && print -u2 -r -- "g --review: ${(V)_GIT_REVIEW_ERROR}"
    _ZLE_PICKER_SELECTED_VALUE='' _ZLE_PICKER_BOOKMARK=() _ZLE_PICKER_BOOKMARK_FOCUS=0
  }
}

_git_review_options() {
  _zle_ui_view action _git_review_options_view "$@"
}

_git_review_options_view() {
  emulate -L zsh
  local root=$1 branch=$2
  _ZLE_PICKER_ACTION_CONTEXT="REPOSITORY"$'\n'"$root"$'\n\nRead-only · no checkout or fetch'
  _ZLE_PICKER_DESCRIPTIONS=(working 'Staged, unstaged and untracked changes'
    commits 'Captured branch tip → commits → files → diff'
    compare 'Choose both endpoints and a comparison method')
  _ZLE_PICKER_ACCEPT_LABELS=(working review commits 'browse commits' compare configure)
  _ZLE_PICKER_TITLE='Git review' _ZLE_PICKER_SUBTITLE="${root:t} · choose a read-only view"
  _ZLE_PICKER_QUERY_LABEL='Filter views' _ZLE_PICKER_INSPECT_ACTION=open
  _ZLE_PICKER_COLLECTOR=_navigation_picker_collect
  _ZLE_PICKER_INSPECT_TITLE=Scope _ZLE_PICKER_BROWSE_LABEL='read-only review'
  local -a _NAVIGATION_PICKER_VALUES=(working) _NAVIGATION_PICKER_LABELS=('Working tree · Review working changes')
  local -a _NAVIGATION_PICKER_INDEXES=(1) _NAVIGATION_PICKER_SEARCH_LABELS=()
  _ZLE_PICKER_INSPECT_TEXTS=(working $'Current working tree\nStaged, unstaged and untracked\n\nReviews the currently checked-out tree.\nRead-only · no fetch or writes')
  [[ -n $branch ]] && {
    _NAVIGATION_PICKER_VALUES+=(commits) _NAVIGATION_PICKER_LABELS+=("Selected branch · Commits in $branch")
    _NAVIGATION_PICKER_INDEXES+=(2)
    _ZLE_PICKER_INSPECT_TEXTS[commits]="$branch"$'\nLocal branch history\n\nCommits → files → diff\nNo checkout; selected tip is resolved once.'
  }
  _NAVIGATION_PICKER_VALUES+=(compare) _NAVIGATION_PICKER_LABELS+=('Compare branches or commits…')
  _NAVIGATION_PICKER_INDEXES+=("${#_NAVIGATION_PICKER_VALUES}")
  _ZLE_PICKER_INSPECT_TEXTS[compare]="Compare: ${branch:-HEAD}"$'\nAgainst: choose another branch or commit\n\nBoth choices can be changed. Review differences opens the two-pane reader.\nNo checkout or fetch.'
  _NAVIGATION_PICKER_VALUES+=(atlas) _NAVIGATION_PICKER_LABELS+=('Change atlas · Explore working changes by folder')
  _NAVIGATION_PICKER_INDEXES+=("${#_NAVIGATION_PICKER_VALUES}")
  _ZLE_PICKER_DESCRIPTIONS[atlas]='Captured change entries → folders → files → focused diff'
  _ZLE_PICKER_ACCEPT_LABELS[atlas]='open atlas'
  _ZLE_PICKER_INSPECT_TEXTS[atlas]='Map the current working-tree snapshot by folder. Bars show file-entry counts; staged and unstaged changes remain distinct. No content is read until a file is chosen.'
  _zle_picker_start_focus=${6:-0}
  _zle_picker_loop "${3:-}" 10 "${4:-1}" "${5:-0}" "${7:-}" "${8:-0}" "${9:-0}"
}

_git_review_menu() {
  emulate -L zsh
  # These errors are presented inside guided views; cancellation is not a
  # failed direct invocation and must not leak their diagnostics to the shell.
  local root=$1 selected=$2 choice='' oid='' _GIT_REVIEW_ERROR=''
  local -i stay=${3:-0} result=0 focus=0
  local -a bookmark=('' 1 0)
  while true; do
    _git_review_options "$root" "$selected" "${bookmark[@][1,3]}" "$focus" "${bookmark[4]-}" "${bookmark[5]:-0}" "${bookmark[6]:-0}"
    result=$?
    (( result == 0 )) || return $result
    choice=$_ZLE_PICKER_SELECTED_VALUE bookmark=("${_ZLE_PICKER_BOOKMARK[@]}") focus=$_ZLE_PICKER_BOOKMARK_FOCUS
    if ! _git_review_prepare "$root"; then
      _git_review_unavailable; result=$?
    elif [[ $choice == compare ]]; then
      _git_review_compare_choose "$root" "$selected"; result=$?
    elif [[ $choice == atlas ]]; then
      _git_review_view "$root" working '' '' '' atlas; result=$?
    elif [[ $choice == commits ]]; then
      if _git_review_resolve "$root" "refs/heads/$selected"; then
        oid=$REPLY
        _git_review_view "$root" commits "$selected" "$oid"; result=$?
      else
        _git_review_unavailable; result=$?
      fi
    else
      _git_review_view "$root" working; result=$?
    fi
    (( result > 1 )) && return $result
    # Preserve the original branch-review Back route. A comparison returns to
    # its setup and menu; the direct review menu remains the caller of all views.
    [[ $choice == (compare|atlas) || $stay == 1 ]] || return 1
  done
}

# Called inside g's existing screen owner. Branch accept/copy returns unchanged
# to navigation for post-cleanup dispatch; review never performs either action.
_git_review_branch_choose() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local -i _ZLE_PICKER_WORKSPACE_ACTIONS=1 focus=0 result=0
  local _ZLE_PICKER_OPTIONS_KIND=git selected=''
  local -a bookmark=('' 1 0) _GIT_REVIEW_CONFIG=()
  local -a _ZLE_PICKER_EMPTY_LINES=()
  local _GIT_REVIEW_DATA='' _GIT_REVIEW_ERROR=''
  local -i _GIT_REVIEW_TRUNCATED=0 _zle_picker_start_focus=0
  if (( !${#_NAVIGATION_PICKER_VALUES} )); then
    _ZLE_PICKER_EMPTY_LINES=('No recent local branches'
      'Ctrl-X reviews the current working tree, including before its first commit.')
  fi
  while true; do
    _ZLE_PICKER_COLLECTOR=_navigation_picker_collect
    _ZLE_PICKER_DIGIT_SELECT=1
    _ZLE_PICKER_COPY_ENABLED=$(( ${#clipboard_binary} > 0 ))
    _zle_picker_start_focus=$focus
    _zle_picker_loop "${bookmark[1]}" "${ZSH_NAVIGATION_PICKER_MAX_RESULTS:-10}" "${bookmark[2]}" "${bookmark[3]}" "${bookmark[4]-}" "${bookmark[5]:-0}" "${bookmark[6]:-0}"
    result=$?
    (( result == 0 )) || return $result
    [[ $_ZLE_PICKER_ACTION == actions ]] || return 0
    selected=$_ZLE_PICKER_SELECTED_VALUE
    bookmark=("${_ZLE_PICKER_BOOKMARK[@]}") focus=$_ZLE_PICKER_BOOKMARK_FOCUS
    _git_review_menu "$root" "$selected"
    result=$?
    (( result > 1 )) && return $result
  done
}

_git_review_unavailable() {
  _zle_ui_view notice _git_review_unavailable_view
}

_git_review_unavailable_view() {
  emulate -L zsh
  _ZLE_PICKER_TITLE='Git review' _ZLE_PICKER_BROWSE_LABEL='unavailable'
  _ZLE_PICKER_SUBTITLE="${root:t} · read-only" _ZLE_PICKER_QUERY_LABEL='Filter notice'
  _ZLE_PICKER_COLLECTOR=_navigation_picker_collect
  local -a _NAVIGATION_PICKER_VALUES=() _NAVIGATION_PICKER_LABELS=()
  _ZLE_PICKER_EMPTY_LINES=('Unable to establish safe local Git inspection.' 'The branch or configuration may have changed. Escape returns.')
  _zle_picker_loop '' 10
}

:
