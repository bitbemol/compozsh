# Live discovery and safe documentation for public add-on functions.

# Discovery is intentionally regenerated only when requested. Zsh records the
# defining source for every loaded function in memory, so this add-on neither
# scans the filesystem nor depends on being sourced after any peer.
typeset -g ZSH_TOOL_PICKER_MAX_RESULTS=${ZSH_TOOL_PICKER_MAX_RESULTS:-10}
typeset -ga _COMPOZSH_TOOL_NAMES=()
typeset -ga _COMPOZSH_TOOL_LABELS=()
typeset -ga _COMPOZSH_TOOL_INDEXES=()
typeset -ga _COMPOZSH_TOOL_SEARCH_TEXTS=()
typeset -gA _COMPOZSH_TOOL_HELPERS=()
typeset -gA _COMPOZSH_TOOL_SOURCES=()

_compozsh_help_compozsh() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: compozsh [--list | help command]' \
    'Explore public functions loaded from Compozsh add-on directories.' \
    '' \
    'Modes:' \
    '  No arguments opens a fuzzy tool picker. Enter or a visible digit with' \
    '  an empty query shows documentation; selection never runs the tool.' \
    '  --list  Print the live catalog with source and help availability.' \
    '  help command shows help for an exact loaded name, without a picker.' \
    '  --help shows this guide without discovering tools.' \
    '  Pipes, redirects, dumb terminals, or a missing picker show the catalog.' \
    '' \
    'Discovery and missing help:' \
    '  Uses loaded public functions defined beneath a .zsh.addons directory,' \
    '  including your private peers and local/init.zsh. Aliases, executables,' \
    '  underscore-prefixed helpers, and functions from other trees are omitted.' \
    '  The catalog is rebuilt on each call from in-memory source metadata.' \
    '  A file must be loaded before its functions appear; after editing your' \
    '  configuration, start a fresh shell with exec zsh.' \
    '  Help comes from _compozsh_help_<command> in the same file as the public' \
    '  function. Without it, the tool is marked no help and only its source' \
    '  is reported. Unknown names return an error. Transparent wrappers may' \
    '  appear without Compozsh help; use their native documentation directly.' \
    '' \
    'Picker:' \
    '  Ctrl-K opens the shared keyboard guide; Escape or Enter' \
    '  returns to the same filter and selection. A plain ? filters normally.' \
    '  Terminal.app uses a temporary alternate screen; closing restores' \
    '  your previous terminal output. Unsupported terminals stay inline.' \
    '  Search stays at the top, shortcuts at the bottom. Visible matches' \
    '  are emphasized as you filter; row limits and number keys stay the same.' \
    '  Searches names and source labels case-insensitively, in character order.' \
    '  Prefixes and substrings rank before abbreviated matches. Type to refine;' \
    '  Arrows / Ctrl-P / Ctrl-N move; Enter shows help for the selected tool.' \
    '  Digits filter normally once the query is nonempty.' \
    '  Numbers identify visible slots; 0 selects the tenth row when shown.' \
    '  Arrows scroll through all matching tools and stop at either end.' \
    '  Fn-Up/Down or Option-Up/Down page with one-line overlap; Ctrl-V/D also page.' \
    '  Page keys act on the focused pane; refining starts at the first match.' \
    '  Escape / Ctrl-G cancels; Ctrl-C aborts; Ctrl-U clears the filter.' \
    '  Up to 10 rows appear by default, limited by terminal height; set' \
    '  ZSH_TOOL_PICKER_MAX_RESULTS in your initializer to adjust it.' \
    '' \
    'Help inspector (Zsh 5.9 / macOS Terminal.app):' \
    '  At 100 columns or wider, the list gets most of the width. Help uses' \
    '  a secondary pane capped at 48 columns, compact until focused.' \
    '  Focused help can use the full body height of the temporary screen.' \
    '  Height adapts to the window and visible results. In narrower windows,' \
    '  switch between the list and a full-width help view.' \
    '  Right / Ctrl-E enters help; Left / Ctrl-B returns to the tool list.' \
    '  Tab / Shift-Tab switches panes. In help, Up/Down or Ctrl-P/N scroll;' \
    '  Fn-Up/Down or Option-Up/Down page with one-line overlap.' \
    '  Ctrl-V pages down; Ctrl-D pages up without Option-as-Meta. Typing refines the' \
    '  filter and returns to the list. Enter prints full help after closing.' \
    '  Digits select only from the visible list with an empty filter.' \
    '  The browser captures up to 64 trusted same-file help companions once' \
    '  when opened, up to 32,768 characters each and 256 wrapped preview lines.' \
    '  Truncation is labeled; Enter still shows the complete guide.' \
    '  Scrolling and resizing use that in-memory snapshot; closing releases it.' \
    '  Custom help providers must be static and side-effect-free, just as for' \
    '  --help. Preview bounds are not a sandbox for user-defined shell code.' \
    '' \
    'Filesystem workspace (path + Tab):' \
    '  Type ~/ then Tab for home, ./ then Tab for the current directory, or' \
    '  / then Tab for root. An arbitrary folder path sets that exact scope.' \
    '  At line end, vim ~/Developer + Tab browses its directory argument.' \
    '  Arguments starting ~/, /, ./ or ../ preserve the command and earlier' \
    '  arguments on insertion; they do not require AUTO_CD. File arguments,' \
    '  expansions and complex shell syntax retain native completion.' \
    '  Browse lists child directories. Enter inserts a shell-quoted path;' \
    '  Right/Tab enters a folder, Left/Shift-Tab goes Back. Ctrl-T toggles' \
    '  hidden folders, Ctrl-O previews names, Ctrl-X opens workspace options.' \
    '  Filter folders refines only that captured level. Ctrl-F opens Search' \
    '  descendants of the displayed folder. Defaults: Git within a worktree,' \
    '  Spotlight for home/root on macOS, Filesystem elsewhere. The source' \
    '  is shown before submission; Ctrl-X can choose another explicitly.' \
    '  Type fragments, then Return to search. Escape restores your browsing' \
    '  filter, selection, viewport and focus; typing never starts discovery.' \
    '  Ctrl-E focuses details/preview; Ctrl-B returns to the list.' \
    '  That menu groups Selected folder and Current folder actions first,' \
    '  then Go to for independent navigation to Recent directories.' \
    '  Each filtered/paged row keeps its group; details show its exact target.' \
    '  Option-Tab at the ordinary prompt opens Recent directories directly,' \
    '  including with an unfinished command. Enable Use Option as Meta key' \
    '  in Terminal Settings > Profiles > your profile > Keyboard.' \
    '  Hold Option and press Tab; Ctrl-Tab stays with Terminal tab navigation.' \
    '  Path + Tab starts from a known folder; Option-Tab starts from recall.' \
    '  Recents is the current shell directory stack, including the current' \
    '  folder. It is separate from children and never searches the filesystem.' \
    '  Both entry points insert a visible quoted path when you select a row.' \
    '  A lone path or Recents selection replaces the draft; a path argument' \
    '  replaces only that argument. The cursor moves to the inserted end.' \
    '  Review it, then Enter at the prompt runs the command or uses AUTO_CD' \
    '  for a lone path. Selection itself never executes the command.' \
    '  Escape or copy preserves the original command, cursor and directory.' \
    '  Native dirs -v and ~1, ~2, ... remain available. Stacks are per shell.' \
    '  Ctrl-O browses a recent folder. Ctrl-X switches workspace views.' \
    '  Ctrl-X offers explicit Search filesystem / Git / Spotlight sources:' \
    '  enter an initial query and press Return. Even inside Git, a subfolder' \
    '  stays the scope; the search never widens to the repository root.' \
    '  Space-separated fragments match in any order, case-insensitively;' \
    '  each fragment may abbreviate characters in order. Matches paths,' \
    '  not file contents. Example: net cli. Query text is always literal.' \
    '  Git includes tracked/untracked files, honors untracked ignore rules,' \
    '  and derives containing directories; empty directories may be absent.' \
    '  Filesystem walks include hidden entries and skip .git metadata;' \
    '  they skip unreadable directories and never follow directory links.' \
    '  Spotlight index uses the longest query fragment as a filename seed.' \
    '  Unindexed, excluded or inaccessible paths may be absent; this is not' \
    '  an exhaustive whole-disk search. Sources require Git / mdfind where used.' \
    '  Initial capture: 20,000 inspected walk entries, 2,000 matches per source.' \
    '  Partial captures are labeled partial; 10 rows are visible by default.' \
    '  Filter results refines captured paths. Ctrl-F edits the discovery query;' \
    '  Return captures again in the same scope/source; Escape keeps results.' \
    '  Ctrl-X chooses another source. Retries keep the resolved source.' \
    '  Searching appears before capture, with the chosen scope and query.' \
    '  Capture is synchronous: blocked reads can delay keys and resize.' \
    '  A failed source is distinct from no matches; partial output is marked.' \
    '  No fallback scan runs if Spotlight is missing or fails. Use Ctrl-X' \
    '  to choose a filesystem walk explicitly if index coverage is limited.' \
    '  Paging and resizing use memory only. Mounted drives can still be slow.' \
    '  Configure ZSH_FILE_SEARCH_MAX_VISITED, ZSH_FILE_SEARCH_MAX_CANDIDATES,' \
    '  and ZSH_FILE_SEARCH_MAX_RESULTS in your initializer.' \
    '  Search Enter inserts directories; files/links open a file-action picker.' \
    '  For files, Enter then choose an action is the primary workflow;' \
    '  no extra shortcut is needed to open, reveal, copy or insert the path.' \
    '  The optional Ctrl-X options menu also includes folder/source controls.' \
    '  Ctrl-X also offers actions for the exact selected file, folder or link,' \
    '  separate from Current folder operations such as scoped Search.' \
    '  Open with default app and Reveal in Finder require macOS open.' \
    '  Open uses the registered app (normally Finder for folders). Reveal' \
    '  opens the containing folder and selects the exact item in Finder.' \
    '  Copy path uses Ctrl-Y (optional Option-W) and requires pbcopy.' \
    '  Insert path keeps it editable; Enter linked directory is explicit.' \
    '  A broken link has no Open action. Open only items you trust: a default' \
    '  application may launch. Actions run after picker cleanup; paths are' \
    '  rechecked. Returning restores the same query and selected row.' \
    '  Ctrl-K shows keys; Escape goes back/cancels, Ctrl-C aborts.' \
    '  d and f are retired. For scripts use native find / git ls-files / mdfind.' \
    '' \
    'Examples:' \
    '  compozsh          Explore, then type part of a tool name.' \
    '  compozsh --list   Inspect the loaded catalog.' \
    '  compozsh help g   Read the Git workspace guide.'
}

_compozsh_tool_sanitize() {
  REPLY=${1//[[:cntrl:]]/?}
}

_compozsh_tool_source_label() {
  local source=$1 label=${1##*/.zsh.addons/}
  [[ $label != "$source" ]] || label=${source:t}
  _compozsh_tool_sanitize "$label"
}

# A companion provider is both documentation and a capability marker. Requiring
# it to share the command's source file keeps each add-on atomic and prevents a
# stale or unrelated helper from authorizing execution on another function's
# behalf. Operational functions themselves are never called during discovery.
_compozsh_tool_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  if ! zmodload -F zsh/parameter p:functions_source 2>/dev/null; then
    print -u2 -r -- 'compozsh: function-source metadata is unavailable'
    return 1
  fi

  local name='' source='' helper='' source_label='' help_label='— no help'
  local -i index=0
  typeset -ga _COMPOZSH_TOOL_NAMES=()
  typeset -ga _COMPOZSH_TOOL_LABELS=()
  typeset -ga _COMPOZSH_TOOL_INDEXES=()
  typeset -ga _COMPOZSH_TOOL_SEARCH_TEXTS=()
  typeset -gA _COMPOZSH_TOOL_HELPERS=()
  typeset -gA _COMPOZSH_TOOL_SOURCES=()

  for name in ${(ok)functions_source}; do
    [[ $name == [A-Za-z][A-Za-z0-9_-]# ]] || continue
    [[ $name != _* && $name != TRAP[A-Z0-9]## ]] || continue
    source=${functions_source[$name]-}
    [[ $source == */.zsh.addons/* ]] || continue

    _compozsh_tool_source_label "$source"
    source_label=$REPLY
    helper="_compozsh_help_${name}"
    help_label='— no help'
    if (( ${+functions[$helper]} )) &&
       [[ ${functions_source[$helper]-} == "$source" ]]; then
      _COMPOZSH_TOOL_HELPERS[$name]=$helper
      help_label='✓ help'
    fi

    (( ++index ))
    _COMPOZSH_TOOL_NAMES+=("$name")
    _COMPOZSH_TOOL_LABELS+=("${name} · ${help_label} · ${source_label}")
    _COMPOZSH_TOOL_INDEXES+=($index)
    _COMPOZSH_TOOL_SEARCH_TEXTS+=("${name} ${source_label}")
    _COMPOZSH_TOOL_SOURCES[$name]=$source_label
  done
}

_compozsh_tool_print_captured() {
  local label=''
  print -r -- "Compozsh tools · ${#_COMPOZSH_TOOL_NAMES} loaded"
  for label in "${_COMPOZSH_TOOL_LABELS[@]}"; do
    print -r -- "$label"
  done
}

# Capture trusted help companions once per browser invocation, outside ZLE.
# The UI receives only text. Never call a public tool to probe documentation.
_compozsh_tool_inspector_capture() {
  emulate -L zsh
  local name helper text
  local -i captured=0
  typeset -gA _ZLE_PICKER_INSPECT_TEXTS=()
  for name in "${_COMPOZSH_TOOL_NAMES[@]}"; do
    helper=${_COMPOZSH_TOOL_HELPERS[$name]-}
    if [[ -z $helper ]]; then
      _ZLE_PICKER_INSPECT_TEXTS[$name]="No Compozsh help is available for ${name}."$'\n'"Defined in: ${_COMPOZSH_TOOL_SOURCES[$name]}"
    elif (( captured >= 64 )); then
      _ZLE_PICKER_INSPECT_TEXTS[$name]='Preview limit reached. Press Enter for full help.'
    else
      (( ++captured ))
      text=''
      # read retains a short final read at EOF. A closed pipe bounds oversized
      # output without storing the rest. Companions follow the static-help contract.
      IFS= read -r -u 0 -k 32768 text < <("$helper" 2>/dev/null) || :
      if (( ${#text} >= 32768 )); then
        text+=$'\n[Preview truncated. Press Enter for full help.]'
      fi
      [[ -n $text ]] || text='No preview text returned. Press Enter for full help.'
      _ZLE_PICKER_INSPECT_TEXTS[$name]=$text
    fi
  done
}

_compozsh_tool_print() {
  _compozsh_tool_capture || return
  _compozsh_tool_print_captured
}

_compozsh_tool_show_help() {
  emulate -L zsh

  local name=$1 helper='' source=''
  _compozsh_tool_capture || return
  (( ${_COMPOZSH_TOOL_NAMES[(Ie)$name]} )) || {
    _compozsh_tool_sanitize "$name"
    print -u2 -r -- "compozsh: no loaded add-on function named ${REPLY}"
    return 1
  }

  helper=${_COMPOZSH_TOOL_HELPERS[$name]-}
  if [[ -n $helper ]]; then
    "$helper"
    return $?
  fi

  source=${_COMPOZSH_TOOL_SOURCES[$name]-unknown}
  print -r -- "$name"
  print -r -- "No Compozsh help is available for ${name}."
  print -r -- "Defined in: ${source}"
}

_compozsh_tool_escape_pattern() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local MATCH
  REPLY=${1//(#m)[\][|()\\*?#<>~^]/\\$MATCH}
}

_compozsh_tool_append_matches() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local pattern=$1 raw_limit=$2 value='' label='' search_text=''
  local -i limit=$raw_limit index=0
  for (( index = 1; index <= ${#_COMPOZSH_TOOL_NAMES}; ++index )); do
    search_text=${_COMPOZSH_TOOL_SEARCH_TEXTS[index]}
    [[ $search_text == ${~pattern} ]] || continue
    value=${_COMPOZSH_TOOL_NAMES[index]}
    (( ${_ZLE_PICKER_RESULTS[(Ie)$value]} )) && continue
    label=${_COMPOZSH_TOOL_LABELS[index]}
    _ZLE_PICKER_RESULTS+=("$value")
    _ZLE_PICKER_LABELS+=("$label")
    _ZLE_PICKER_RESULT_INDEXES+=("${_COMPOZSH_TOOL_INDEXES[index]}")
    (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  done
}

_compozsh_tool_picker_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local query=$1 raw_limit=$2 literal='' pattern='(#i)*' character=''
  local -i limit=$raw_limit index=0
  typeset -ga _ZLE_PICKER_RESULTS=()
  typeset -ga _ZLE_PICKER_LABELS=()
  typeset -ga _ZLE_PICKER_RESULT_INDEXES=()

  if [[ -z $query ]]; then
    for (( index = 1; index <= ${#_COMPOZSH_TOOL_NAMES}; ++index )); do
      _ZLE_PICKER_RESULTS+=("${_COMPOZSH_TOOL_NAMES[index]}")
      _ZLE_PICKER_LABELS+=("${_COMPOZSH_TOOL_LABELS[index]}")
      _ZLE_PICKER_RESULT_INDEXES+=("${_COMPOZSH_TOOL_INDEXES[index]}")
      (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
    done
    return 0
  fi

  _compozsh_tool_escape_pattern "$query"
  literal=$REPLY
  _compozsh_tool_append_matches "(#i)${literal}*" $limit
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  _compozsh_tool_append_matches "(#i)*${literal}*" $limit
  (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0

  for character in "${(s::)query}"; do
    _compozsh_tool_escape_pattern "$character"
    pattern+="${REPLY}*"
  done
  _compozsh_tool_append_matches "$pattern" $limit
}

unalias compozsh 2>/dev/null
compozsh() {
  emulate -L zsh

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_compozsh
    return 0
  fi
  if (( $# == 1 )) && [[ $1 == --list ]]; then
    _compozsh_tool_print
    return $?
  fi
  if (( $# == 2 )) && [[ $1 == help ]]; then
    _compozsh_tool_show_help "$2"
    return $?
  fi
  (( $# == 0 )) || {
    print -u2 -r -- 'usage: compozsh [--list | help command]'
    return 2
  }

  _compozsh_tool_capture || return
  if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]] ||
     (( ! ${+functions[_zle_picker_run]} ||
        ! ${+functions[_zle_picker_loop]} )); then
    _compozsh_tool_print_captured
    return 0
  fi

  local selected=''
  local _ZLE_PICKER_INSPECT_TITLE=Help _ZLE_PICKER_INSPECT_ACTION='print help'
  local _ZLE_PICKER_SUBTITLE='Commands from your loaded add-ons' _ZLE_PICKER_CANCEL_LABEL=''
  local -i picker_status=0
  _ZLE_PICKER_TITLE='Tool explorer'
  _ZLE_PICKER_BROWSE_LABEL='loaded add-on functions'
  _ZLE_PICKER_EMPTY_LABEL='no matching tools'
  _ZLE_PICKER_COLLECTOR='_compozsh_tool_picker_collect'
  _ZLE_PICKER_DIGIT_SELECT=1
  _ZLE_PICKER_COPY_ENABLED=0
  _ZLE_PICKER_HIERARCHY_ENABLED=0
  {
    if (( ${+functions[_zle_picker_inspect_render]} )); then
      _compozsh_tool_inspector_capture
    fi
    _zle_picker_run "${ZSH_TOOL_PICKER_MAX_RESULTS:-10}"
    picker_status=$?
  } always {
    _ZLE_PICKER_INSPECT_TEXTS=()
  }
  (( picker_status == 1 )) && return 0
  (( picker_status == 0 )) || return $picker_status

  selected=$_ZLE_PICKER_SELECTED_VALUE
  _compozsh_tool_show_help "$selected"
}

:
