# Native terminal-aware semantic output.

# Appearance owns defaults; this consumer preserves explicit public roles.
typeset -gA ZSH_OUTPUT_COLORS

# Return a validated 256-color index. A malformed local override falls back
# instead of making an ordinary command fail inside Git's color parser.
_output_color() {
  emulate -L zsh

  local role=$1 value=''
  if [[ ${(t)ZSH_OUTPUT_COLORS} == association* ]]; then
    value=${ZSH_OUTPUT_COLORS[$role]-}
  fi
  if [[ $value != <0-255> && ${(t)_COMPOZSH_COLOR_FALLBACKS} == association* ]]; then
    value=${_COMPOZSH_COLOR_FALLBACKS[output:$role]-}
  fi
  REPLY=''
  [[ $value == <0-255> ]] || return 1
  REPLY=$value
}

# Choose black or white by relative luminance for the standard xterm cube and
# grayscale. ANSI colors 0–15 are profile-defined; callers retain native inverse
# video there. This calculation runs only for an explicit manual-page request.
_output_contrasting_foreground() {
  emulate -L zsh
  [[ $1 == <16-255> ]] || return 1
  local -i index=$1 cube=0 component=0 channel=0
  local -a levels=(0 95 135 175 215 255) channels=()
  local -a weights=(0.2126 0.7152 0.0722)
  local -F linear=0 luminance=0
  if (( index < 232 )); then
    cube=$(( index - 16 ))
    channels=( ${levels[cube / 36 + 1]} ${levels[(cube / 6) % 6 + 1]} ${levels[cube % 6 + 1]} )
  else
    component=$(( 8 + (index - 232) * 10 ))
    channels=($component $component $component)
  fi
  for component in $channels; do
    (( ++channel, linear = component / 255.0 ))
    if (( linear <= 0.04045 )); then
      (( linear /= 12.92 ))
    else
      (( linear = ((linear + 0.055) / 1.055) ** 2.4 ))
    fi
    (( luminance += linear * weights[channel] ))
  done
  if (( (luminance + 0.05) / 0.05 >= 1.05 / (luminance + 0.05) )); then
    REPLY=16
  else
    REPLY=231
  fi
}

# Optional presentation for Compozsh-owned help, never a filter for arbitrary
# command output. Providers pass complete plain lines and retain a print
# fallback when this peer is disabled. Nothing here executes help text.
_output_print_help() {
  emulate -L zsh

  if [[ ! -t 1 || -z $TERM || $TERM == dumb || -n ${NO_COLOR:-} ]] ||
     ! zmodload -F zsh/terminfo p:terminfo 2>/dev/null ||
     (( ${terminfo[colors]:-0} < 256 )); then
    print -rl -- "$@"
    return
  fi

  local REPLY heading='' accent='' info='' warning='' reset=$'\e[0m'
  local line='' body='' prefix='' remainder='' style=''
  local -i index=0 examples=0
  local -a rendered=()
  if _output_color heading; then
    heading=$'\e[1;38;5;'"${REPLY}m"
  fi
  if _output_color accent; then
    accent=$'\e[38;5;'"${REPLY}m"
  fi
  if _output_color info; then
    info=$'\e[38;5;'"${REPLY}m"
  fi
  if _output_color warning; then
    warning=$'\e[1;38;5;'"${REPLY}m"
  fi

  for line in "$@"; do
    (( ++index ))
    style=''
    if [[ -z $line ]]; then
      rendered+=('')
      continue
    elif (( index == 1 )); then
      style=$heading
    elif (( index == 2 )); then
      style=$info
    elif [[ $line != ' '* ]]; then
      examples=0
      [[ $line == 'Examples:' ]] && examples=1
      case $line in
        (Safety*|Limits*|*recovery:) style=$warning ;;
        (*) style=$heading ;;
      esac
    elif [[ $line == '  '* ]]; then
      body=${line#'  '}
      if (( examples )) || [[ $body == --* && $body == *'  '* ]]; then
        # Two spaces separate an option/example from its explanation. Keep
        # indentation and spacing byte-for-byte and emphasize only the prefix.
        prefix=${body%%  *}
        remainder=${body#"$prefix"}
        if (( examples )); then
          style=$info
        else
          style=$accent
        fi
        if [[ -n $style ]]; then
          rendered+=("  ${style}${prefix}${reset}${remainder}")
        else
          rendered+=("$line")
        fi
        continue
      fi
    fi
    if [[ -n $style ]]; then
      rendered+=("${style}${line}${reset}")
    else
      rendered+=("$line")
    fi
  done
  print -rl -- "${rendered[@]}"
}

# Return native LLDB presentation arguments in the caller's local reply array.
# Only validated color indexes enter these fixed commands; no app or project
# text is interpreted. The Xcode caller owns terminal detection and execution.
_output_lldb_color_arguments() {
  emulate -L zsh
  local property='' role='' weight='' prefix='' REPLY=''
  local -a specifications=(
    prompt heading '1;'
    stop-show-line warning '1;'
    show-autosuggestion muted ''
  )
  reply=()
  for property role weight in "${specifications[@]}"; do
    _output_color "$role" || continue
    prefix=$'\e['"${weight}38;5;${REPLY}m"
    reply+=(
      --one-line-before-file "settings set --exists ${property}-ansi-prefix \"${prefix}\""
      --one-line-before-file "settings set --exists ${property}-ansi-suffix \""$'\e[0m'"\""
    )
  done
}

# Build Git's native semantic color configuration from the shared output
# palette. Values are separate argv elements; no shell source or output text is
# constructed from them.
_output_git_color_arguments() {
  emulate -L zsh

  local property='' role='' attributes='' value=''
  local -A colors=()
  local -a specifications=(
    color.advice.hint muted ''
    color.branch.current success 'bold'
    color.branch.local info ''
    color.branch.remote accent ''
    color.branch.upstream heading ''
    color.branch.plain text ''
    color.decorate.branch success ''
    color.decorate.remoteBranch accent ''
    color.decorate.tag warning ''
    color.decorate.stash match ''
    color.decorate.HEAD heading 'bold'
    color.diff.meta heading ''
    color.diff.frag warning 'bold'
    color.diff.old error ''
    color.diff.new success ''
    color.diff.commit heading 'bold'
    color.diff.whitespace error 'reverse'
    color.grep.match match 'bold'
    color.grep.filename heading ''
    color.grep.lineNumber muted ''
    color.grep.column muted ''
    color.grep.separator muted ''
    color.grep.context text ''
    color.interactive.prompt heading 'bold'
    color.status.header heading 'bold'
    color.status.added success 'bold'
    color.status.updated success 'bold'
    color.status.changed warning 'bold'
    color.status.untracked error 'bold'
    color.status.unmerged error 'bold'
    color.status.nobranch warning 'bold'
    color.status.localBranch success ''
    color.status.remoteBranch accent ''
    color.push.error error 'bold'
    color.remote.error error 'bold'
    color.remote.warning warning 'bold'
    color.remote.hint muted ''
    color.remote.success success 'bold'
    color.transport.rejected error 'bold'
  )
  for role in heading accent success warning error info muted match text; do
    _output_color "$role" && colors[$role]=$REPLY
  done
  typeset -ga _OUTPUT_GIT_COLOR_CONFIG=()
  for property role attributes in "${specifications[@]}"; do
    value=${colors[$role]-}
    [[ -n $value ]] || continue
    _OUTPUT_GIT_COLOR_CONFIG+=("$property=${attributes:+$attributes }$value")
  done
  if (( ${#_OUTPUT_GIT_COLOR_CONFIG} )); then
    _OUTPUT_GIT_COLOR_CONFIG=('color.ui=auto' "${_OUTPUT_GIT_COLOR_CONFIG[@]}")
  fi
}

# Find the Git subcommand without interpreting its operands. Unknown global
# options conservatively disable decoration rather than risk changing command
# semantics.
_output_git_subcommand() {
  emulate -L zsh

  local -a arguments=("$@")
  local argument=''
  local -i index=1

  REPLY=''
  while (( index <= ${#arguments} )); do
    argument=${arguments[index]}
    case $argument in
      -C|-c|--config-env|--git-dir|--work-tree|--namespace|--super-prefix|--attr-source)
        (( index += 2 ))
        ;;
      --*=*|-p|--paginate|-P|--no-pager|--no-replace-objects|--bare|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--no-optional-locks)
        (( ++index ))
        ;;
      -*)
        return 1
        ;;
      *)
        REPLY=$argument
        return 0
        ;;
    esac
  done
  return 1
}

_output_git_subcommand_uses_color() {
  case $1 in
    add|am|annotate|apply|backfill|bisect|blame|branch|bundle|checkout|\
    cherry-pick|clean|clone|commit|count-objects|describe|diff|diff-files|\
    diff-index|diff-tree|difftool|fetch|format-patch|fsck|gc|grep|init|log|\
    maintenance|merge|merge-tree|mergetool|mv|notes|pull|push|range-diff|\
    rebase|reflog|remote|repack|replace|request-pull|reset|restore|revert|\
    rerere|rm|shortlog|show|show-branch|sparse-checkout|stash|status|\
    submodule|switch|tag|verify-commit|verify-tag|whatchanged|worktree)
      return 0
      ;;
  esac
  return 1
}

# Apply only Git's own color engine to human-facing commands. Non-terminal
# calls, configuration inspection, and machine-oriented subcommands receive the
# exact original argv. Explicit `git -c color.ui=...` arguments come later and
# therefore retain final authority.
unalias git 2>/dev/null
git() {
  emulate -L zsh

  local subcommand=''
  local configuration=''
  local -a git_color_arguments=()

  if [[ ! -t 1 && ! -t 2 ]]; then
    command git "$@"
    return
  fi

  _output_git_subcommand "$@" || {
    command git "$@"
    return
  }
  subcommand=$REPLY
  _output_git_subcommand_uses_color "$subcommand" || {
    command git "$@"
    return
  }

  _output_git_color_arguments
  for configuration in "${_OUTPUT_GIT_COLOR_CONFIG[@]}"; do
    git_color_arguments+=(-c "$configuration")
  done
  command git "${git_color_arguments[@]}" "$@"
}

# Highlight matches only for interactive terminal output. Pipes, command
# substitutions, and redirected files remain byte-for-byte plain unless the
# caller explicitly requests --color=always. Capability detection runs only on
# the first interactive use of each resolved grep executable and is cached in
# memory for the shell's lifetime.
typeset -gi _GREP_SUPPORTS_COLOR=-1
typeset -g _GREP_COLOR_BINARY=''
unalias grep 2>/dev/null
grep() {
  emulate -L zsh

  local grep_binary=${commands[grep]:-}
  if [[ $grep_binary != $_GREP_COLOR_BINARY ]]; then
    _GREP_SUPPORTS_COLOR=-1
    _GREP_COLOR_BINARY=$grep_binary
  fi

  if [[ -t 1 ]]; then
    if (( _GREP_SUPPORTS_COLOR < 0 )); then
      command grep --color=never -q -- '' /dev/null 2>/dev/null
      if (( $? <= 1 )); then
        _GREP_SUPPORTS_COLOR=1
      else
        _GREP_SUPPORTS_COLOR=0
      fi
    fi
  fi

  if [[ -t 1 ]] && (( _GREP_SUPPORTS_COLOR )); then
    if _output_color match; then
      local match=$REPLY
      local -x GREP_COLOR=${GREP_COLOR-"1;38;5;$match"}
      local -x GREP_COLORS=${GREP_COLORS-"ms=1;38;5;$match:mc=1;38;5;$match"}
    fi
    command grep --color=auto "$@"
  else
    command grep "$@"
  fi
}

# Render the semantic emphasis already embedded in manual pages with the
# shared output palette. The exported values are local to this invocation, so
# ordinary `less` sessions keep their own appearance.
man() {
  emulate -L zsh

  local heading_style=$'\e[1m' match_style=$'\e[1m'
  local warning_style=$'\e[4m' selected_style=$'\e[7m'
  local heading=''
  if _output_color heading; then
    heading=$REPLY
    heading_style=$'\e[1;38;5;'"${heading}m"
    if _output_contrasting_foreground "$heading"; then
      selected_style=$'\e[1;38;5;'"$REPLY;48;5;${heading}m"
    fi
  fi
  if _output_color warning; then
    warning_style=$'\e[4;38;5;'"${REPLY}m"
  fi
  if _output_color match; then
    match_style=$'\e[1;38;5;'"${REPLY}m"
  fi

  local -x MANCOLOR=${MANCOLOR:-1}
  local -x MANPAGER=${MANPAGER:-'less -sR'}
  local -x LESS_TERMCAP_mb=${LESS_TERMCAP_mb-$match_style}
  local -x LESS_TERMCAP_md=${LESS_TERMCAP_md-$heading_style}
  local -x LESS_TERMCAP_me=${LESS_TERMCAP_me-$'\e[0m'}
  local -x LESS_TERMCAP_so=${LESS_TERMCAP_so-$selected_style}
  local -x LESS_TERMCAP_se=${LESS_TERMCAP_se-$'\e[0m'}
  local -x LESS_TERMCAP_us=${LESS_TERMCAP_us-$warning_style}
  local -x LESS_TERMCAP_ue=${LESS_TERMCAP_ue-$'\e[0m'}

  command man "$@"
}

:
