# Xcode-specific tools. This peer unit is loaded by the .zshrc bootstrap only
# while its name matches .zsh.<name> inside the adjacent add-on directory.

# Apple documents an Xcode 27 issue where Codex does not automatically receive
# Xcode-provided agent skills. This add-on implements Apple's `xcrun agent
# skills export` workaround and also places the portable export where other
# common agents can discover it:
# https://developer.apple.com/documentation/xcode-release-notes/xcode-27-release-notes
#
# Re-evaluate this workaround when Apple marks that issue resolved. The
# Codex-in-Xcode destination may then be removable; keep the multi-agent export
# only if it still provides value outside Xcode.

# The same peer also exposes a first-party Xcode workspace. Discovery is
# bounded to literal containers on the upward path; Xcode supplies schemes,
# destinations, builds and tests. Compozsh only coordinates the interaction.
typeset -g ZSH_XCODE_CAPTURE_MAX_BYTES=${ZSH_XCODE_CAPTURE_MAX_BYTES:-262144}
typeset -ga _XCODE_CONTAINERS=() _XCODE_CONTAINER_KINDS=()
typeset -ga _XCODE_SCHEMES=()
typeset -ga _XCODE_DESTINATION_IDS=() _XCODE_DESTINATION_PLATFORMS=()
typeset -ga _XCODE_DESTINATION_NAMES=() _XCODE_COMMAND=()
typeset -g _XCODE_CAPTURE='' _XCODE_CAPTURE_ERROR=''
typeset -g _XCODE_TEST_RESULT='' _XCODE_TEST_CAPTURE_ERROR=''
typeset -g _XCODE_TEST_SCHEME='' _XCODE_TEST_DESTINATION=''
typeset -gi _XCODE_TEST_TOTAL=0 _XCODE_TEST_PASSED=0 _XCODE_TEST_FAILED=0
typeset -gi _XCODE_TEST_SKIPPED=0 _XCODE_TEST_EXPECTED_FAILURES=0
typeset -ga _XCODE_TEST_FAILURE_NAMES=() _XCODE_TEST_FAILURE_TARGETS=()
typeset -ga _XCODE_TEST_FAILURE_TEXTS=() _XCODE_TEST_FAILURE_FILES=()
typeset -ga _XCODE_TEST_BUILD_NAMES=() _XCODE_TEST_BUILD_TEXTS=()
typeset -ga _XCODE_TEST_BUILD_FILES=()

_xcode_container_discover() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB

  local current=${1:-$PWD} entry=''
  local -a workspaces=() projects=()
  typeset -ga _XCODE_CONTAINERS=() _XCODE_CONTAINER_KINDS=()

  current=${current:a}
  [[ -d $current ]] || current=${current:h}
  while [[ $current == /* ]]; do
    workspaces=("$current"/*.xcworkspace(N/))
    projects=("$current"/*.xcodeproj(N/))
    for entry in "${workspaces[@]}"; do
      [[ ! -L $entry ]] || continue
      _XCODE_CONTAINERS+=("$entry")
      _XCODE_CONTAINER_KINDS+=(workspace)
    done
    for entry in "${projects[@]}"; do
      [[ ! -L $entry ]] || continue
      _XCODE_CONTAINERS+=("$entry")
      _XCODE_CONTAINER_KINDS+=(project)
    done
    (( ${#_XCODE_CONTAINERS} )) && return 0
    [[ $current == / ]] && break
    current=${current:h}
  done
  return 1
}

_xcode_container_arguments() {
  emulate -L zsh
  typeset -ga _XCODE_CONTAINER_ARGUMENTS=()
  case $1 in
    (workspace) _XCODE_CONTAINER_ARGUMENTS=(-workspace "$2") ;;
    (project) _XCODE_CONTAINER_ARGUMENTS=(-project "$2") ;;
    (*) return 2 ;;
  esac
}

_xcode_safe_arguments() {
  typeset -ga _XCODE_SAFE_ARGUMENTS=(
    -disableAutomaticPackageResolution
    -onlyUsePackageVersionsFromResolvedFile
    -skipPackageUpdates
  )
}

# Capture first-party command output into a size-bounded invocation directory.
# No partial output is parsed; diagnostics are retained separately and both
# files are removed before returning.
_xcode_capture_command() {
  emulate -L zsh

  local temp_root=${TMPDIR:-/tmp} capture_dir='' stdout_file='' stderr_file=''
  local raw_size='' output='' diagnostic=''
  local -i command_status=0 max_bytes=${ZSH_XCODE_CAPTURE_MAX_BYTES:-262144}
  _XCODE_CAPTURE='' _XCODE_CAPTURE_ERROR=''
  [[ $max_bytes == <-> ]] || max_bytes=262144
  (( max_bytes < 4096 )) && max_bytes=4096

  capture_dir=$(command mktemp -d "${temp_root%/}/compozsh-xcode.XXXXXX") || {
    _XCODE_CAPTURE_ERROR='cannot create a bounded capture directory'
    return 1
  }
  stdout_file="$capture_dir/stdout"
  stderr_file="$capture_dir/stderr"
  {
    command "$@" >| "$stdout_file" 2>| "$stderr_file"
    command_status=$?
    raw_size=$(command wc -c < "$stdout_file" 2>/dev/null)
    raw_size=${raw_size//[[:space:]]/}
    [[ $raw_size == <-> ]] || raw_size=0
    if (( raw_size > max_bytes )); then
      command_status=1
      diagnostic="output exceeded the ${max_bytes}-byte capture limit"
    elif (( command_status == 0 )); then
      output=$(<"$stdout_file")
    else
      diagnostic=$(command head -c 8192 -- "$stderr_file" 2>/dev/null)
      [[ -n $diagnostic ]] || diagnostic='xcodebuild returned a nonzero status'
    fi
  } always {
    if [[ -n $capture_dir && ${capture_dir:t} == compozsh-xcode.* &&
          ${capture_dir:h:A} == ${temp_root:A} ]]; then
      command rm -rf -- "$capture_dir"
    fi
  }
  _XCODE_CAPTURE=$output
  _XCODE_CAPTURE_ERROR=$diagnostic
  return $command_status
}

_xcode_json_raw() {
  emulate -L zsh
  local json=$1 key=$2
  (( $+commands[plutil] )) || return 1
  REPLY=$(print -rn -- "$json" |
    command /usr/bin/plutil -extract "$key" raw -o - -- - 2>/dev/null) || return
}

# Decode the five named XML entities emitted by plutil for string values. Decode
# ampersands last so literal text such as "&lt;" makes exactly one round trip.
_xcode_xml_string_decode() {
  emulate -L zsh
  local value=$1 apostrophe="'" double_quote='"'
  value=${value//\&lt\;/<}
  value=${value//\&gt\;/>}
  value=${value//\&quot\;/$double_quote}
  value=${value//\&apos\;/$apostrophe}
  value=${value//\&amp\;/\&}
  REPLY=$value
}

# Parse only plutil's normalized XML representation of a string array. The
# caller obtains the original array count separately, so a type mismatch or
# malformed conversion fails instead of producing a partial scheme catalog.
_xcode_plist_string_array_parse() {
  emulate -L zsh
  local remaining=$1 expected=$2 value=''
  local open='<string>' close='</string>'
  local -i parsed=0
  reply=()
  [[ $expected == <-> ]] || return 1
  while [[ $remaining == *"$open"*"$close"* ]]; do
    remaining=${remaining#*"$open"}
    value=${remaining%%"$close"*}
    remaining=${remaining#*"$close"}
    _xcode_xml_string_decode "$value"
    reply+=("$REPLY")
    (( ++parsed > expected )) && return 1
  done
  (( parsed == expected ))
}

_xcode_test_result_reset() {
  emulate -L zsh
  _XCODE_TEST_RESULT='' _XCODE_TEST_CAPTURE_ERROR=''
  _XCODE_TEST_TOTAL=0 _XCODE_TEST_PASSED=0 _XCODE_TEST_FAILED=0
  _XCODE_TEST_SKIPPED=0 _XCODE_TEST_EXPECTED_FAILURES=0
  _XCODE_TEST_FAILURE_NAMES=() _XCODE_TEST_FAILURE_TARGETS=()
  _XCODE_TEST_FAILURE_TEXTS=() _XCODE_TEST_FAILURE_FILES=()
  _XCODE_TEST_BUILD_NAMES=() _XCODE_TEST_BUILD_TEXTS=()
  _XCODE_TEST_BUILD_FILES=()
}

# Collect structured source locations from one failed test's bounded detail
# tree. xcresulttool owns the schema; this walker accepts only its numeric array
# indexes, limits depth/nodes, and retains no attachments or source contents.
_xcode_test_node_sources_capture() {
  emulate -L zsh
  local json=$1 key=$2
  local -i depth=${3:-0} children=0 index=0 line=0
  local file=''
  (( depth <= 12 && _XCODE_TEST_DETAIL_NODE_COUNT < 256 )) || return 0
  (( ++_XCODE_TEST_DETAIL_NODE_COUNT ))

  if _xcode_json_raw "$json" "$key.sourceLocation.filePath"; then
    file=$REPLY
    if [[ -n $file && ${#file} -le 4096 && $file != *[[:cntrl:]]* ]]; then
      if _xcode_json_raw "$json" "$key.sourceLocation.lineNumber" &&
          [[ $REPLY == <-> ]]; then
        line=$REPLY
      fi
      (( line > 0 )) && file+=":$line"
      (( _XCODE_TEST_DETAIL_FILES[(Ie)$file] )) ||
        _XCODE_TEST_DETAIL_FILES+=("$file")
    fi
  fi
  _xcode_json_raw "$json" "$key.children" || return 0
  children=$REPLY
  [[ $children == <-> ]] || return 0
  (( children > 64 )) && children=64
  for (( index = 0; index < children; ++index )); do
    _xcode_test_node_sources_capture "$json" "$key.children.$index" $(( depth + 1 ))
    (( _XCODE_TEST_DETAIL_NODE_COUNT < 256 )) || break
  done
}

_xcode_test_failure_files_capture() {
  emulate -L zsh
  local bundle=$1 identifier=$2 json='' count=0
  local -i index=0
  typeset -ga _XCODE_TEST_DETAIL_FILES=()
  typeset -gi _XCODE_TEST_DETAIL_NODE_COUNT=0
  [[ -n $identifier && ${#identifier} -le 4096 &&
     $identifier != *[[:cntrl:]]* ]] || return 1
  _xcode_capture_command xcrun xcresulttool get test-results test-details \
    --path "$bundle" --test-id "$identifier" --compact || return
  json=$_XCODE_CAPTURE
  _xcode_json_raw "$json" testRuns || return 1
  count=$REPLY
  [[ $count == <-> ]] || return 1
  (( count > 64 )) && count=64
  for (( index = 0; index < count; ++index )); do
    _xcode_test_node_sources_capture "$json" "testRuns.$index" 0
    (( _XCODE_TEST_DETAIL_NODE_COUNT < 256 )) || break
  done
  (( ${#_XCODE_TEST_DETAIL_FILES} ))
}

_xcode_test_source_url_display() {
  emulate -L zsh
  local source=$1
  [[ -n $source && ${#source} -le 4096 &&
     $source != *[[:cntrl:]]* ]] || { REPLY=''; return 1; }
  source=${source#file://}
  source=${source//\%20/ }
  REPLY=$source
}

_xcode_test_build_issues_capture() {
  emulate -L zsh
  local bundle=$1 json='' count=0 message='' issue='' target='' source=''
  local -i index=0
  _xcode_capture_command xcrun xcresulttool get build-results \
    --path "$bundle" --compact || return
  json=$_XCODE_CAPTURE
  _xcode_json_raw "$json" errors || return 0
  count=$REPLY
  [[ $count == <-> ]] || return 1
  (( count > 20 )) && count=20
  for (( index = 0; index < count; ++index )); do
    _xcode_json_raw "$json" "errors.$index.issueType" && issue=$REPLY || issue='Build error'
    _xcode_json_raw "$json" "errors.$index.targetName" && target=$REPLY || target=''
    _xcode_json_raw "$json" "errors.$index.message" && message=$REPLY || message='No diagnostic was reported.'
    _xcode_json_raw "$json" "errors.$index.sourceURL" && source=$REPLY || source=''
    (( ${#issue} > 256 )) && issue=${issue[1,256]}
    (( ${#target} > 256 )) && target=${target[1,256]}
    (( ${#message} > 4096 )) && message=${message[1,4096]}
    [[ -n $target ]] && issue+=" · $target"
    _xcode_test_source_url_display "$source" || REPLY=''
    _XCODE_TEST_BUILD_NAMES+=("$issue")
    _XCODE_TEST_BUILD_TEXTS+=("$message")
    _XCODE_TEST_BUILD_FILES+=("$REPLY")
  done
}

# Read only the bounded summary, failed-test details, and build issues from the
# transient xcresult bundle. The native xcodebuild stream remains untouched in
# the restored terminal while these captured facts feed the result view.
_xcode_test_result_capture() {
  emulate -L zsh
  local bundle=$1
  local -i action_status=${2:-1} failure_count=0 index=0
  local json='' name='' target='' reason='' identifier='' files=''
  _xcode_test_result_reset
  (( $+commands[xcrun] )) || {
    (( action_status == 0 )) && _XCODE_TEST_RESULT=Passed || _XCODE_TEST_RESULT=Failed
    _XCODE_TEST_CAPTURE_ERROR='xcrun is unavailable; the native test status is shown without structured details'
    return 0
  }

  if _xcode_capture_command xcrun xcresulttool get test-results summary \
       --path "$bundle" --compact; then
    json=$_XCODE_CAPTURE
    _xcode_json_raw "$json" result && _XCODE_TEST_RESULT=$REPLY
    case $_XCODE_TEST_RESULT in
      (Passed|Failed|'Expected Failure'|Skipped|unknown) ;;
      (*) _XCODE_TEST_RESULT='' ;;
    esac
    _xcode_json_raw "$json" totalTestCount && [[ $REPLY == <-> ]] && _XCODE_TEST_TOTAL=$REPLY
    _xcode_json_raw "$json" passedTests && [[ $REPLY == <-> ]] && _XCODE_TEST_PASSED=$REPLY
    _xcode_json_raw "$json" failedTests && [[ $REPLY == <-> ]] && _XCODE_TEST_FAILED=$REPLY
    _xcode_json_raw "$json" skippedTests && [[ $REPLY == <-> ]] && _XCODE_TEST_SKIPPED=$REPLY
    _xcode_json_raw "$json" expectedFailures && [[ $REPLY == <-> ]] && _XCODE_TEST_EXPECTED_FAILURES=$REPLY
    _xcode_json_raw "$json" testFailures && failure_count=$REPLY || failure_count=0
    [[ $failure_count == <-> ]] || failure_count=0
    (( failure_count > 20 )) && failure_count=20
    for (( index = 0; index < failure_count; ++index )); do
      _xcode_json_raw "$json" "testFailures.$index.testName" && name=$REPLY || name="Failed test $(( index + 1 ))"
      _xcode_json_raw "$json" "testFailures.$index.targetName" && target=$REPLY || target=''
      _xcode_json_raw "$json" "testFailures.$index.failureText" && reason=$REPLY || reason='No failure reason was reported.'
      _xcode_json_raw "$json" "testFailures.$index.testIdentifierURL" && identifier=$REPLY || identifier=''
      [[ -n $identifier ]] ||
        { _xcode_json_raw "$json" "testFailures.$index.testIdentifierString" && identifier=$REPLY || identifier=''; }
      (( ${#name} > 512 )) && name=${name[1,512]}
      (( ${#target} > 256 )) && target=${target[1,256]}
      (( ${#reason} > 4096 )) && reason=${reason[1,4096]}
      files=''
      if _xcode_test_failure_files_capture "$bundle" "$identifier"; then
        files=${(F)_XCODE_TEST_DETAIL_FILES}
      fi
      _XCODE_TEST_FAILURE_NAMES+=("$name")
      _XCODE_TEST_FAILURE_TARGETS+=("$target")
      _XCODE_TEST_FAILURE_TEXTS+=("$reason")
      _XCODE_TEST_FAILURE_FILES+=("$files")
    done
  else
    _XCODE_TEST_CAPTURE_ERROR=${_XCODE_CAPTURE_ERROR:-'Xcode returned no readable test summary'}
  fi

  if [[ -z $_XCODE_TEST_RESULT ]]; then
    (( action_status == 0 )) && _XCODE_TEST_RESULT=Passed || _XCODE_TEST_RESULT=Failed
  elif (( action_status != 0 )); then
    _XCODE_TEST_RESULT=Failed
  fi
  (( action_status != 0 )) && _xcode_test_build_issues_capture "$bundle"
  return 0
}

_xcode_schemes_capture() {
  emulate -L zsh
  local kind=$1 container=$2 json='' xml='' count='' scheme='' key=''
  local -a reply=()
  typeset -ga _XCODE_SCHEMES=()
  (( $+commands[xcodebuild] )) || {
    _XCODE_CAPTURE_ERROR='xcodebuild is unavailable; select full Xcode with xcode-select'
    return 1
  }
  _xcode_container_arguments "$kind" "$container" || return
  _xcode_safe_arguments
  _XCODE_COMMAND=(xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}"
    "${_XCODE_SAFE_ARGUMENTS[@]}" -list -json)
  _xcode_capture_command "${_XCODE_COMMAND[@]}" || return
  json=$_XCODE_CAPTURE
  key="$kind.schemes"
  _xcode_json_raw "$json" "$key" || {
    _XCODE_CAPTURE_ERROR='Xcode returned no readable scheme list'
    return 1
  }
  count=$REPLY
  [[ $count == <-> ]] || {
    _XCODE_CAPTURE_ERROR='Xcode returned an invalid scheme count'
    return 1
  }
  (( count <= 4096 )) || {
    _XCODE_CAPTURE_ERROR='Xcode reported more than 4096 schemes; none were retained'
    return 1
  }
  xml=$(print -rn -- "$json" |
    command /usr/bin/plutil -extract "$key" xml1 -o - -- - 2>/dev/null) || {
    _XCODE_CAPTURE_ERROR='Xcode returned no readable scheme list'
    return 1
  }
  _xcode_plist_string_array_parse "$xml" "$count" || {
    _XCODE_CAPTURE_ERROR='Xcode returned a malformed scheme list; none were retained'
    return 1
  }
  for scheme in "${reply[@]}"; do
    [[ -n $scheme && ${#scheme} -le 256 && $scheme != *[[:cntrl:]]* ]] || continue
    _XCODE_SCHEMES+=("$scheme")
  done
  (( ${#_XCODE_SCHEMES} )) || {
    _XCODE_CAPTURE_ERROR='Xcode reported no shared schemes for this container'
    return 1
  }
}

_xcode_destination_platform_is_supported() {
  case $1 in
    (macOS|iOS|'iOS Simulator'|tvOS|'tvOS Simulator'|watchOS|'watchOS Simulator'|visionOS|'visionOS Simulator'|DriverKit) return 0 ;;
    (*) return 1 ;;
  esac
}

_xcode_destinations_parse() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local data=$1 line='' body='' part='' key='' value=''
  local platform='' identifier='' name='' os='' destination_error=''
  local -a parts=()
  local -A seen=()
  typeset -ga _XCODE_DESTINATION_IDS=() _XCODE_DESTINATION_PLATFORMS=()
  typeset -ga _XCODE_DESTINATION_NAMES=()

  for line in ${(f)data}; do
    [[ $line == *'{'*'}'* ]] || continue
    body=${line#*\{}
    body=${body%\}*}
    parts=("${(@s:,:)body}")
    platform='' identifier='' name='' os='' destination_error=''
    for part in "${parts[@]}"; do
      part=${part##[[:space:]]#}
      part=${part%%[[:space:]]#}
      key=${part%%:*}
      value=${part#*:}
      key=${key##[[:space:]]#}
      key=${key%%[[:space:]]#}
      value=${value##[[:space:]]#}
      value=${value%%[[:space:]]#}
      case $key in
        (platform) platform=$value ;;
        (id) identifier=$value ;;
        (name) name=$value ;;
        (OS) os=$value ;;
        (error) destination_error=$value ;;
      esac
    done
    [[ -z $destination_error ]] || continue
    _xcode_destination_platform_is_supported "$platform" || continue
    [[ $identifier == [[:alnum:]][[:alnum:].-]# &&
       -n $name && ${#name} -le 200 && $name != *[[:cntrl:]]* ]] || continue
    (( ${+seen[$identifier]} )) && continue
    seen[$identifier]=1
    [[ -n $os ]] && name+=" · ${platform% Simulator} ${(V)os}"
    _XCODE_DESTINATION_IDS+=("$identifier")
    _XCODE_DESTINATION_PLATFORMS+=("$platform")
    _XCODE_DESTINATION_NAMES+=("$name")
    (( ${#_XCODE_DESTINATION_IDS} >= 100 )) && break
  done
  (( ${#_XCODE_DESTINATION_IDS} ))
}

_xcode_destinations_capture() {
  emulate -L zsh
  local kind=$1 container=$2 scheme=$3
  _xcode_container_arguments "$kind" "$container" || return
  _xcode_safe_arguments
  _XCODE_COMMAND=(xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}" -scheme "$scheme"
    "${_XCODE_SAFE_ARGUMENTS[@]}" -showdestinations)
  _xcode_capture_command "${_XCODE_COMMAND[@]}" || return
  _xcode_destinations_parse "$_XCODE_CAPTURE" || {
    _XCODE_CAPTURE_ERROR='Xcode reported no concrete destinations with stable identifiers'
    return 1
  }
}

_xcode_action_command() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local kind=$1 container=$2 scheme=$3 platform=$4 identifier=$5 action=$6
  typeset -ga _XCODE_COMMAND=()
  case $action in
    (build|test|analyze|clean) ;;
    (*) return 2 ;;
  esac
  [[ -n $scheme && $scheme != *[[:cntrl:]]* ]] || return 2
  _xcode_destination_platform_is_supported "$platform" || return 2
  [[ $identifier == [[:alnum:]][[:alnum:].-]# ]] || return 2
  _xcode_container_arguments "$kind" "$container" || return
  _xcode_safe_arguments
  _XCODE_COMMAND=(xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}" -scheme "$scheme"
    -destination "platform=$platform,id=$identifier"
    "${_XCODE_SAFE_ARGUMENTS[@]}" -hideShellScriptEnvironment "$action")
}

_xcode_build_settings_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local kind=$1 container=$2 scheme=$3 platform=$4 identifier=$5
  local json='' extension='' build_dir='' product='' bundle_id=''
  local -i index=0
  typeset -g _XCODE_APP_PATH='' _XCODE_BUNDLE_ID=''
  _xcode_container_arguments "$kind" "$container" || return
  _xcode_safe_arguments
  _XCODE_COMMAND=(xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}" -scheme "$scheme"
    -destination "platform=$platform,id=$identifier"
    "${_XCODE_SAFE_ARGUMENTS[@]}" -showBuildSettings -json)
  _xcode_capture_command "${_XCODE_COMMAND[@]}" || return
  json=$_XCODE_CAPTURE
  # The root is an array. Probe a bounded number of target dictionaries;
  # plutil intentionally has no empty-key extraction for the root count.
  for (( index = 0; index < 100; ++index )); do
    _xcode_json_raw "$json" "$index.buildSettings" || break
    _xcode_json_raw "$json" "$index.buildSettings.WRAPPER_EXTENSION" || continue
    extension=$REPLY
    [[ $extension == app ]] || continue
    _xcode_json_raw "$json" "$index.buildSettings.TARGET_BUILD_DIR" || continue
    build_dir=$REPLY
    _xcode_json_raw "$json" "$index.buildSettings.FULL_PRODUCT_NAME" || continue
    product=$REPLY
    _xcode_json_raw "$json" "$index.buildSettings.PRODUCT_BUNDLE_IDENTIFIER" || continue
    bundle_id=$REPLY
    [[ $build_dir == /* && -n $product && $product != */* &&
       $bundle_id == [[:alnum:]][[:alnum:].-]# ]] || continue
    _XCODE_APP_PATH="$build_dir/$product"
    _XCODE_BUNDLE_ID=$bundle_id
    [[ -d $_XCODE_APP_PATH && ! -L $_XCODE_APP_PATH ]] && return 0
  done
  _XCODE_CAPTURE_ERROR='the selected scheme produced no installable application bundle'
  return 1
}

_xcode_run_simulator() {
  emulate -L zsh
  local kind=$1 container=$2 scheme=$3 platform=$4 identifier=$5
  [[ $platform == *Simulator ]] || {
    print -u2 -r -- 'xcode: Run requires a concrete Simulator destination'
    return 2
  }
  _xcode_action_command "$kind" "$container" "$scheme" "$platform" "$identifier" build || return
  command "${_XCODE_COMMAND[@]}" || return
  _xcode_build_settings_capture "$kind" "$container" "$scheme" "$platform" "$identifier" || {
    print -u2 -r -- "xcode: ${_XCODE_CAPTURE_ERROR:-cannot resolve the built application}"
    return 1
  }
  (( $+commands[xcrun] )) || {
    print -u2 -r -- 'xcode: xcrun is unavailable'
    return 1
  }
  command xcrun simctl boot "$identifier" >/dev/null 2>&1 || true
  command xcrun simctl bootstatus "$identifier" -b || return
  (( $+commands[open] )) && command open -a Simulator >/dev/null 2>&1
  command xcrun simctl install "$identifier" "$_XCODE_APP_PATH" || return
  command xcrun simctl launch "$identifier" "$_XCODE_BUNDLE_ID"
}

# Workspace menus own a small source array but reuse the editor's renderer,
# screen lifecycle, focus language, filtering and resize behavior.
_xcode_picker_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local query=$1 raw_limit=$2 value='' label='' searchable='' pattern='(#i)*' character=''
  local -i limit=$raw_limit index=0 result_index=0
  typeset -ga _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
  [[ $limit == <-> ]] || limit=10
  if [[ -n $query ]]; then
    for character in "${(s::)query}"; do
      (( ${+functions[_zle_picker_escape_pattern]} )) || return 1
      _zle_picker_escape_pattern "$character"
      pattern+="${REPLY}*"
    done
  fi
  for (( index = 1; index <= ${#_XCODE_PICKER_VALUES}; ++index )); do
    value=${_XCODE_PICKER_VALUES[index]}
    label=${_XCODE_PICKER_LABELS[index]}
    searchable="${label} ${_XCODE_PICKER_SEARCH[index]-}"
    [[ -z $query || $searchable == ${~pattern} ]] || continue
    _ZLE_PICKER_RESULTS+=("$value")
    _ZLE_PICKER_LABELS+=("$label")
    result_index=${#_ZLE_PICKER_RESULTS}
    (( result_index == 10 )) && result_index=0
    _ZLE_PICKER_RESULT_INDEXES+=($result_index)
    (( ${#_ZLE_PICKER_RESULTS} >= limit )) && break
  done
}

_xcode_choose() {
  emulate -L zsh
  local title=$1 subtitle=$2 query_label=$3
  local _ZLE_PICKER_TITLE=$title _ZLE_PICKER_SUBTITLE=$subtitle
  local _ZLE_PICKER_QUERY_LABEL=$query_label _ZLE_PICKER_INSPECT_TITLE=Details
  local _ZLE_PICKER_INSPECT_ACTION=choose _ZLE_PICKER_CANCEL_LABEL=back
  local _ZLE_PICKER_BROWSE_LABEL='read-only selection'
  local _ZLE_PICKER_COLLECTOR=_xcode_picker_collect
  local -i _ZLE_PICKER_WORKSPACE_ACTIONS=0 _ZLE_PICKER_COPY_ENABLED=0
  local -i _ZLE_PICKER_DIGIT_SELECT=1
  local -A _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -i index=0
  for (( index = 1; index <= ${#_XCODE_PICKER_VALUES}; ++index )); do
    _ZLE_PICKER_INSPECT_TEXTS[${_XCODE_PICKER_VALUES[index]}]=${_XCODE_PICKER_DETAILS[index]-}
    _ZLE_PICKER_ACCEPT_LABELS[${_XCODE_PICKER_VALUES[index]}]=choose
  done
  _zle_picker_loop '' 20
}

_xcode_test_result_choose() {
  emulate -L zsh
  local title=$1 subtitle=$2
  local _ZLE_PICKER_TITLE=$title _ZLE_PICKER_SUBTITLE=$subtitle
  local _ZLE_PICKER_QUERY_LABEL='Filter failures'
  local _ZLE_PICKER_INSPECT_TITLE='Test result'
  local _ZLE_PICKER_INSPECT_ACTION=done _ZLE_PICKER_CANCEL_LABEL=done
  local _ZLE_PICKER_BROWSE_LABEL='captured Xcode result · source locations from xcresult'
  local _ZLE_PICKER_COLLECTOR=_xcode_picker_collect
  local -i _ZLE_PICKER_WORKSPACE_ACTIONS=0 _ZLE_PICKER_COPY_ENABLED=0
  local -i _ZLE_PICKER_DIGIT_SELECT=1
  local -A _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_INSPECT_TEXTS=()
  local -A _ZLE_PICKER_ACCEPT_LABELS=() _ZLE_PICKER_LABEL_HIGHLIGHTS=()
  local -a _ZLE_PICKER_PASSIVE_LINES=("${_XCODE_TEST_PASSIVE_LINES[@]}")
  local -a _ZLE_PICKER_PASSIVE_STYLES=("${_XCODE_TEST_PASSIVE_STYLES[@]}")
  local -i index=0
  for (( index = 1; index <= ${#_XCODE_PICKER_VALUES}; ++index )); do
    _ZLE_PICKER_INSPECT_TEXTS[${_XCODE_PICKER_VALUES[index]}]=${_XCODE_PICKER_DETAILS[index]-}
    _ZLE_PICKER_ACCEPT_LABELS[${_XCODE_PICKER_VALUES[index]}]=done
    [[ -n ${_XCODE_PICKER_HIGHLIGHTS[index]-} ]] &&
      _ZLE_PICKER_LABEL_HIGHLIGHTS[${_XCODE_PICKER_VALUES[index]}]=${_XCODE_PICKER_HIGHLIGHTS[index]}
  done
  _zle_picker_loop '' 20
}

_xcode_test_result_screen() {
  emulate -L zsh
  local -i action_status=${1:-1} index=0
  local title='Xcode Test · Failed' subtitle=''
  local name='' target='' reason='' files='' first_file='' label='' details=''
  local overview='Test results' count_label=''
  local -a _XCODE_PICKER_VALUES=(done) _XCODE_PICKER_LABELS=('[ Done ]')
  local -a _XCODE_PICKER_HIGHLIGHTS=('') _XCODE_PICKER_SEARCH=(done)
  local -a _XCODE_PICKER_DETAILS=('')
  local -a _XCODE_TEST_PASSIVE_LINES=() _XCODE_TEST_PASSIVE_STYLES=()

  count_label="${_XCODE_TEST_PASSED} passed · ${_XCODE_TEST_FAILED} failed"
  (( _XCODE_TEST_SKIPPED )) && count_label+=" · ${_XCODE_TEST_SKIPPED} skipped"
  (( _XCODE_TEST_EXPECTED_FAILURES )) &&
    count_label+=" · ${_XCODE_TEST_EXPECTED_FAILURES} expected failures"
  overview+=$'\n'"$count_label"

  if (( action_status == 0 )) && [[ $_XCODE_TEST_RESULT == Passed ]]; then
    title='Xcode Test · Passed'
    subtitle="$_XCODE_TEST_SCHEME · $_XCODE_TEST_DESTINATION · DONE"
    if [[ -n $_XCODE_TEST_CAPTURE_ERROR ]]; then
      label='Test action passed · structured totals unavailable'
    elif (( _XCODE_TEST_TOTAL )); then
      label="All tests passed · ${_XCODE_TEST_PASSED} of ${_XCODE_TEST_TOTAL} passed"
    else
      label='Test action passed · Xcode reported no tests'
    fi
    _XCODE_TEST_PASSIVE_LINES+=("$label")
    _XCODE_TEST_PASSIVE_STYLES+=(picker-success)
    if [[ -n $_XCODE_TEST_CAPTURE_ERROR ]]; then
      _XCODE_TEST_PASSIVE_LINES+=("Result details limited · $_XCODE_TEST_CAPTURE_ERROR")
      _XCODE_TEST_PASSIVE_STYLES+=(picker-warning)
      overview+=$'\n\n''Limits'$'\n'"  $_XCODE_TEST_CAPTURE_ERROR"
    fi
    _XCODE_PICKER_HIGHLIGHTS[1]="0:${#_XCODE_PICKER_LABELS[1]}:picker-success"
    _XCODE_PICKER_DETAILS=("$overview"$'\n\n''Outcome'$'\n'"  $label")
    _xcode_test_result_choose "$title" "$subtitle"
    return $?
  fi

  subtitle="$_XCODE_TEST_SCHEME · $_XCODE_TEST_DESTINATION · FAILED"
  overview+=$'\n\n''Failures'
  for (( index = 1; index <= ${#_XCODE_TEST_FAILURE_NAMES}; ++index )); do
    name=${_XCODE_TEST_FAILURE_NAMES[index]}
    target=${_XCODE_TEST_FAILURE_TARGETS[index]}
    reason=${_XCODE_TEST_FAILURE_TEXTS[index]}
    files=${_XCODE_TEST_FAILURE_FILES[index]}
    first_file=${files%%$'\n'*}
    label="Test failed · $name"
    [[ -n $first_file ]] && label+=" · ${first_file:t}"
    details="$name"
    [[ -n $target ]] && details+=$'\n'"Target · $target"
    details+=$'\n\n''Failure'$'\n'"  $reason"$'\n\n''Involved files'
    if [[ -n $files ]]; then
      details+=$'\n'"  ${files//$'\n'/$'\n  '}"
    else
      details+=$'\n''  Xcode reported no source location for this failure.'
    fi
    _XCODE_PICKER_VALUES+=("failure:$index")
    _XCODE_PICKER_LABELS+=("$label")
    _XCODE_PICKER_HIGHLIGHTS+=("0:${#label}:picker-error")
    _XCODE_PICKER_SEARCH+=("$name $target $reason $files")
    _XCODE_PICKER_DETAILS+=("$details")
    overview+=$'\n'"  $name"
    [[ -n $files ]] && overview+=$'\n'"    ${files//$'\n'/$'\n    '}"
  done
  for (( index = 1; index <= ${#_XCODE_TEST_BUILD_NAMES}; ++index )); do
    name=${_XCODE_TEST_BUILD_NAMES[index]}
    reason=${_XCODE_TEST_BUILD_TEXTS[index]}
    files=${_XCODE_TEST_BUILD_FILES[index]}
    label="Build failed · $name"
    [[ -n $files ]] && label+=" · ${files:t}"
    details="$name"$'\n\n''Failure'$'\n'"  $reason"$'\n\n''Involved files'$'\n'"  ${files:-Xcode reported no source location for this issue.}"
    _XCODE_PICKER_VALUES+=("build:$index")
    _XCODE_PICKER_LABELS+=("$label")
    _XCODE_PICKER_HIGHLIGHTS+=("0:${#label}:picker-error")
    _XCODE_PICKER_SEARCH+=("$name $reason $files")
    _XCODE_PICKER_DETAILS+=("$details")
    overview+=$'\n'"  $name"
    [[ -n $files ]] && overview+=$'\n'"    $files"
  done
  if (( ${#_XCODE_TEST_FAILURE_NAMES} + ${#_XCODE_TEST_BUILD_NAMES} == 0 )); then
    label='Test action failed · Xcode reported no structured failure details'
    _XCODE_TEST_PASSIVE_LINES+=("$label")
    _XCODE_TEST_PASSIVE_STYLES+=(picker-error)
    overview+=$'\n''  Xcode reported no structured test or build issue.'
  fi
  if [[ -n $_XCODE_TEST_CAPTURE_ERROR ]]; then
    _XCODE_TEST_PASSIVE_LINES+=("Result details limited · $_XCODE_TEST_CAPTURE_ERROR")
    _XCODE_TEST_PASSIVE_STYLES+=(picker-warning)
    overview+=$'\n\n''Limits'$'\n'"  $_XCODE_TEST_CAPTURE_ERROR"
  fi
  _XCODE_PICKER_DETAILS=("$overview" "${_XCODE_PICKER_DETAILS[@][2,-1]}")
  _xcode_test_result_choose "$title" "$subtitle"
}

_xcode_test_result_controller() {
  _xcode_test_result_screen "${_XCODE_TEST_ACTION_STATUS:-1}"
}

_xcode_test_execute() {
  emulate -L zsh
  local kind=$1 container=$2 scheme=$3 platform=$4 identifier=$5 destination=$6
  local temp_root=${TMPDIR:-/tmp} result_dir='' bundle=''
  local -i action_status=0
  _XCODE_TEST_SCHEME=$scheme _XCODE_TEST_DESTINATION=$destination
  _xcode_test_result_reset
  _xcode_action_command "$kind" "$container" "$scheme" "$platform" "$identifier" test || return
  result_dir=$(command mktemp -d "${temp_root%/}/compozsh-xcode-test.XXXXXX") || result_dir=''
  if [[ -n $result_dir ]]; then
    bundle="$result_dir/Test.xcresult"
    _XCODE_COMMAND=("${_XCODE_COMMAND[@][1,-2]}" -collect-test-diagnostics never \
      -resultBundlePath "$bundle" test)
  else
    _XCODE_TEST_CAPTURE_ERROR='cannot create a temporary Xcode result directory'
  fi
  {
    command "${_XCODE_COMMAND[@]}"
    action_status=$?
    if [[ -n $bundle && -d $result_dir && ! -L $result_dir &&
          -d $bundle && ! -L $bundle ]]; then
      _xcode_test_result_capture "$bundle" $action_status
    else
      (( action_status == 0 )) && _XCODE_TEST_RESULT=Passed || _XCODE_TEST_RESULT=Failed
      [[ -n $_XCODE_TEST_CAPTURE_ERROR ]] ||
        _XCODE_TEST_CAPTURE_ERROR='Xcode produced no readable result bundle'
    fi
  } always {
    if [[ -n $result_dir && -d $result_dir &&
          ${result_dir:t} == compozsh-xcode-test.* &&
          ${result_dir:h:A} == ${temp_root:A} ]]; then
      command rm -rf -- "$result_dir"
    fi
  }
  return $action_status
}

_xcode_workspace_controller() {
  emulate -L zsh
  local kind=${_XCODE_CONTAINER_KINDS[1]} container=${_XCODE_CONTAINERS[1]}
  local scheme='' platform='' identifier='' destination='' selected=''
  local -i result=0 index=0 container_index=1 scheme_index=1 destination_index=1
  local -a _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=()
  local -a _XCODE_PICKER_SEARCH=() _XCODE_PICKER_DETAILS=()

  if (( ${#_XCODE_CONTAINERS} > 1 )); then
    _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=() _XCODE_PICKER_SEARCH=() _XCODE_PICKER_DETAILS=()
    for (( index = 1; index <= ${#_XCODE_CONTAINERS}; ++index )); do
      _XCODE_PICKER_VALUES+=("$index")
      _XCODE_PICKER_LABELS+=("${_XCODE_CONTAINERS[index]:t} · ${_XCODE_CONTAINER_KINDS[index]}")
      _XCODE_PICKER_SEARCH+=("${_XCODE_CONTAINERS[index]}")
      _XCODE_PICKER_DETAILS+=("${_XCODE_CONTAINERS[index]}"$'\n\nNearest literal Xcode container · read-only selection')
    done
    _xcode_choose 'Xcode / Container' 'Nearest project scope' 'Filter containers'
    result=$?
    (( result == 0 )) || return $result
    container_index=$_ZLE_PICKER_SELECTED_VALUE
    kind=${_XCODE_CONTAINER_KINDS[container_index]}
    container=${_XCODE_CONTAINERS[container_index]}
  fi

  _xcode_schemes_capture "$kind" "$container" || {
    _XCODE_WORKSPACE_ERROR=$_XCODE_CAPTURE_ERROR
    return 4
  }
  scheme=${_XCODE_SCHEMES[1]}
  _xcode_destinations_capture "$kind" "$container" "$scheme" || {
    _XCODE_WORKSPACE_ERROR=$_XCODE_CAPTURE_ERROR
    return 4
  }
  platform=${_XCODE_DESTINATION_PLATFORMS[1]}
  identifier=${_XCODE_DESTINATION_IDS[1]}
  destination=${_XCODE_DESTINATION_NAMES[1]}

  while true; do
    _XCODE_PICKER_VALUES=(scheme destination build test analyze clean)
    _XCODE_PICKER_LABELS=(
      "Scheme · $scheme"
      "Destination · $destination"
      'Build · Compile the selected scheme'
      'Test · Run the selected scheme tests'
      'Analyze · Run Xcode static analysis'
      'Clean · Remove selected-scheme build products')
    _XCODE_PICKER_SEARCH=(scheme destination build test analyze clean)
    _XCODE_PICKER_DETAILS=(
      "$scheme"$'\n\nChoose one of Xcode’s shared schemes.'
      "$destination"$'\n'"$platform · $identifier"$'\n\nChoose an exact destination reported by Xcode.'
      'Build'$'\n\nRuns xcodebuild after this full-screen workspace closes. Project build scripts, package plugins and macros may execute.'
      'Test'$'\n\nBuilds and runs tests after this workspace closes, keeps native output in the terminal, then reopens a result view with totals, failures, and involved files reported by Xcode.'
      'Analyze'$'\n\nRuns Xcode static analysis after this workspace closes.'
      'Clean'$'\n\nRemoves build products for this scheme and destination after this workspace closes.')
    if [[ $platform == *Simulator ]]; then
      _XCODE_PICKER_VALUES+=(run)
      _XCODE_PICKER_LABELS+=('Build & Run · Launch in the selected Simulator')
      _XCODE_PICKER_SEARCH+=(simulator launch run)
      _XCODE_PICKER_DETAILS+=('Build & Run'$'\n\nBuilds, boots the selected Simulator, installs the app and launches it. No physical-device launch.')
    fi
    _xcode_choose 'Xcode / Actions' "${container:t} · $scheme · $destination" 'Filter actions'
    result=$?
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    case $selected in
      (scheme)
        _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=() _XCODE_PICKER_SEARCH=() _XCODE_PICKER_DETAILS=()
        for (( index = 1; index <= ${#_XCODE_SCHEMES}; ++index )); do
          _XCODE_PICKER_VALUES+=("$index") _XCODE_PICKER_LABELS+=("${_XCODE_SCHEMES[index]}")
          _XCODE_PICKER_SEARCH+=("${_XCODE_SCHEMES[index]}")
          _XCODE_PICKER_DETAILS+=("${_XCODE_SCHEMES[index]}"$'\n\nShared scheme reported by Xcode.')
        done
        _xcode_choose 'Xcode / Scheme' "${container:t}" 'Filter schemes'
        result=$?
        (( result == 1 )) && continue
        (( result == 0 )) || return $result
        scheme_index=$_ZLE_PICKER_SELECTED_VALUE
        scheme=${_XCODE_SCHEMES[scheme_index]}
        _xcode_destinations_capture "$kind" "$container" "$scheme" || {
          _XCODE_WORKSPACE_ERROR=$_XCODE_CAPTURE_ERROR
          return 4
        }
        destination_index=1
        platform=${_XCODE_DESTINATION_PLATFORMS[1]}
        identifier=${_XCODE_DESTINATION_IDS[1]}
        destination=${_XCODE_DESTINATION_NAMES[1]} ;;
      (destination)
        _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=() _XCODE_PICKER_SEARCH=() _XCODE_PICKER_DETAILS=()
        for (( index = 1; index <= ${#_XCODE_DESTINATION_IDS}; ++index )); do
          _XCODE_PICKER_VALUES+=("$index")
          _XCODE_PICKER_LABELS+=("${_XCODE_DESTINATION_NAMES[index]} · ${_XCODE_DESTINATION_PLATFORMS[index]}")
          _XCODE_PICKER_SEARCH+=("${_XCODE_DESTINATION_NAMES[index]} ${_XCODE_DESTINATION_PLATFORMS[index]}")
          _XCODE_PICKER_DETAILS+=("${_XCODE_DESTINATION_NAMES[index]}"$'\n'"${_XCODE_DESTINATION_PLATFORMS[index]} · ${_XCODE_DESTINATION_IDS[index]}"$'\n\nExact destination reported by Xcode.')
        done
        _xcode_choose 'Xcode / Destination' "$scheme" 'Filter destinations'
        result=$?
        (( result == 1 )) && continue
        (( result == 0 )) || return $result
        destination_index=$_ZLE_PICKER_SELECTED_VALUE
        platform=${_XCODE_DESTINATION_PLATFORMS[destination_index]}
        identifier=${_XCODE_DESTINATION_IDS[destination_index]}
        destination=${_XCODE_DESTINATION_NAMES[destination_index]} ;;
      (build|test|analyze|clean|run)
        _XCODE_REQUEST=$selected
        _XCODE_SELECTED_KIND=$kind _XCODE_SELECTED_CONTAINER=$container
        _XCODE_SELECTED_SCHEME=$scheme _XCODE_SELECTED_PLATFORM=$platform
        _XCODE_SELECTED_ID=$identifier _XCODE_SELECTED_DESTINATION=$destination
        return 0 ;;
    esac
  done
}

_compozsh_help_xcode() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: xcode [xcodebuild-arguments ...]' \
    'Open a native Xcode action workspace, or delegate arguments to xcodebuild.' \
    '' \
    'Workspace discovery:' \
    '  With no arguments, finds the nearest directory on the upward path that' \
    '  contains a literal .xcworkspace or .xcodeproj. It never scans descendants.' \
    '  A workspace is offered before a project at the same nearest scope.' \
    '  Xcode supplies shared schemes and concrete destinations; selections are' \
    '  read-only discovery and remain inside one responsive full-screen workspace.' \
    '  Every validated scheme in a bounded response is available to filtering and' \
    '  paging. A response above 4096 schemes fails; no partial list is shown.' \
    '' \
    'Actions:' \
    '  Choose a scheme and destination, then Build, Test, Analyze, or Clean.' \
    '  A concrete Simulator destination also offers Build & Run: it builds,' \
    '  boots Simulator, installs the resulting app, and launches its bundle.' \
    '  Physical-device launch and signing configuration are outside this UI.' \
    '  The screen closes before xcodebuild or Simulator performs the action.' \
    '  Native output remains in the terminal. After Test, the screen reopens' \
    '  with passed/failed totals and, for failures, reasons and involved files.' \
    '  Failure selection shows up to 20 tests and 20 build-stage errors. Some' \
    '  Xcode failures have no structured source location; the view says so.' \
    '  If structured results are unavailable, the native status remains visible' \
    '  and the result view labels its missing detail instead of inventing totals.' \
    '' \
    'Safety and reproducibility:' \
    '  Captures and item counts are bounded; automatic package resolution and' \
    '  package updates are disabled; resolved package versions' \
    '  are required.' \
    '  Compozsh never enables provisioning updates and never skips package plugin' \
    '  or macro validation. Xcode may still inspect project/package metadata.' \
    '  Build, Test, Analyze, Clean, and Run are explicit execution boundaries:' \
    '  project build scripts, package plugins, macros, tests, and app code may run.' \
    '  Review unfamiliar repositories before selecting an action.' \
    '  Test creates a temporary xcresult bundle under TMPDIR, disables verbose' \
    '  test-diagnostic collection, and reads bounded' \
    '  summaries, failure source locations, and build issues with xcresulttool,' \
    '  then removes it before showing the result. Attachments and source contents' \
    '  are not read. The native xcodebuild status remains the command status.' \
    '' \
    'Direct xcodebuild access and fallback:' \
    '  Any arguments delegate directly to xcodebuild and preserve its status.' \
    '  Direct arguments do not add a result bundle or result window.' \
    '  In a noninteractive/dumb terminal, no arguments run a safe xcodebuild -list' \
    '  for the nearest container. Full Xcode must be selected with xcode-select.' \
    '' \
    'Examples:' \
    '  xcode                              Open the native action workspace.' \
    '  xcode -version                     Ask xcodebuild for its version.' \
    '  xcode -showBuildSettings -scheme App  Delegate an advanced query.'
}

unalias xcode 2>/dev/null
xcode() {
  emulate -L zsh
  local kind='' container='' request='' picker_status=0
  local -i action_status=0
  local _XCODE_REQUEST='' _XCODE_WORKSPACE_ERROR=''
  local _XCODE_SELECTED_KIND='' _XCODE_SELECTED_CONTAINER=''
  local _XCODE_SELECTED_SCHEME='' _XCODE_SELECTED_PLATFORM=''
  local _XCODE_SELECTED_ID='' _XCODE_SELECTED_DESTINATION=''

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_xcode
    return 0
  fi
  {
    (( $# == 0 )) || {
      command xcodebuild "$@"
      return $?
    }
    (( $+commands[xcodebuild] )) || {
      print -u2 -r -- 'xcode: xcodebuild is unavailable; select full Xcode with xcode-select'
      return 1
    }
    _xcode_container_discover "$PWD" || {
      print -u2 -r -- 'xcode: no .xcworkspace or .xcodeproj found on the upward path'
      return 1
    }
    kind=${_XCODE_CONTAINER_KINDS[1]}
    container=${_XCODE_CONTAINERS[1]}
    if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]] ||
        (( ! ${+functions[_zle_picker_run]} )); then
      _xcode_container_arguments "$kind" "$container" || return
      _xcode_safe_arguments
      command xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}" \
        "${_XCODE_SAFE_ARGUMENTS[@]}" -list
      return $?
    fi

    _zle_picker_run 20 '' 1 0 _xcode_workspace_controller
    picker_status=$?
    (( picker_status == 1 )) && return 0
    if (( picker_status != 0 )); then
      [[ -n $_XCODE_WORKSPACE_ERROR ]] && print -u2 -r -- "xcode: $_XCODE_WORKSPACE_ERROR"
      return $picker_status
    fi
    request=$_XCODE_REQUEST
    case $request in
      (build|analyze|clean)
        _xcode_action_command "$_XCODE_SELECTED_KIND" "$_XCODE_SELECTED_CONTAINER" \
          "$_XCODE_SELECTED_SCHEME" "$_XCODE_SELECTED_PLATFORM" \
          "$_XCODE_SELECTED_ID" "$request" || return
        print -r -- "Xcode ${request}: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        command "${_XCODE_COMMAND[@]}" ;;
      (test)
        print -r -- "Xcode test: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        _xcode_test_execute "$_XCODE_SELECTED_KIND" "$_XCODE_SELECTED_CONTAINER" \
          "$_XCODE_SELECTED_SCHEME" "$_XCODE_SELECTED_PLATFORM" \
          "$_XCODE_SELECTED_ID" "$_XCODE_SELECTED_DESTINATION"
        action_status=$?
        _XCODE_TEST_ACTION_STATUS=$action_status
        _zle_picker_run 20 '' 1 0 _xcode_test_result_controller
        return $action_status ;;
      (run)
        print -r -- "Xcode run: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        _xcode_run_simulator "$_XCODE_SELECTED_KIND" "$_XCODE_SELECTED_CONTAINER" \
          "$_XCODE_SELECTED_SCHEME" "$_XCODE_SELECTED_PLATFORM" "$_XCODE_SELECTED_ID" ;;
      (*) return 0 ;;
    esac
  } always {
    _XCODE_CONTAINERS=() _XCODE_CONTAINER_KINDS=() _XCODE_SCHEMES=()
    _XCODE_DESTINATION_IDS=() _XCODE_DESTINATION_PLATFORMS=()
    _XCODE_DESTINATION_NAMES=() _XCODE_COMMAND=()
    _XCODE_CAPTURE='' _XCODE_CAPTURE_ERROR=''
    _xcode_test_result_reset
    _XCODE_TEST_SCHEME='' _XCODE_TEST_DESTINATION=''
    unset _XCODE_TEST_ACTION_STATUS _XCODE_TEST_DETAIL_NODE_COUNT
    unset _XCODE_TEST_DETAIL_FILES
    unset _XCODE_CONTAINER_ARGUMENTS _XCODE_SAFE_ARGUMENTS
    unset _XCODE_APP_PATH _XCODE_BUNDLE_ID
  }
}

# Detect coding-agent surfaces that can discover local Agent Skills. A CLI on
# PATH or its standard macOS application bundle is sufficient; merely having a
# vendor's consumer web or chat application is not.
_detect_xcode_skill_vendor() {
  emulate -L zsh

  local vendor=$1 binary='' app_name='' app_root=''
  local -a binaries=() app_names=() matches=()

  case $vendor in
    codex)
      binaries=(codex)
      app_names=(ChatGPT Codex)
      ;;
    claude)
      binaries=(claude)
      app_names=(Claude)
      ;;
    gemini)
      binaries=(gemini)
      ;;
    antigravity)
      binaries=(agy antigravity)
      app_names=(Antigravity)
      ;;
    kiro)
      binaries=(kiro-cli kiro)
      app_names=(Kiro)
      ;;
    *)
      REPLY=''
      return 2
      ;;
  esac

  for binary in "${binaries[@]}"; do
    (( $+commands[$binary] )) && matches+=("$binary CLI")
  done

  for app_root in /Applications "$HOME/Applications"; do
    for app_name in "${app_names[@]}"; do
      [[ -d "$app_root/$app_name.app/Contents" ]] && matches+=("$app_name app")
    done
  done

  REPLY=${(j:, :)matches}
  (( ${#matches} != 0 ))
}

# Remove only a temporary directory created immediately below an agent skill
# root by this add-on. Keeping this validation beside the recursive removal
# prevents a malformed path from broadening cleanup.
_remove_xcode_skill_temp_tree() {
  emulate -L zsh

  local target=${1:A} expected_parent=${2:A} name=${${1:A}:t}
  [[ ${target:h} == $expected_parent &&
     ( $name == .xcode-skill-stage.* ||
       $name == .xcode-skill-backup.* ) ]] || {
    print -u2 -r -- "Xcode skill update: refused unsafe cleanup target: $target"
    return 1
  }
  [[ -e $target || -L $target ]] || return 0
  command rm -rf -- "$target"
}

# Copy one staged Xcode export into an agent's global skill directory. Existing
# directories are updated only when a marker proves this function created them;
# a same-named personal skill is preserved and reported as a conflict. Every
# managed skill is built completely in a sibling directory before one swap, so
# a failed copy leaves the previous skill intact and stale files disappear.
_install_xcode_skills_for_agent() {
  emulate -L zsh

  local source_dir=$1 target_dir=$2 agent_name=$3 xcode_build=$4
  local source_skill='' target_skill='' marker='.xcode-skill-export'
  local stage_dir='' backup_dir=''
  local -i installed=0 updated=0 conflicts=0 failures=0 refreshing=0 restored=0

  target_dir=${target_dir:A}
  if ! command mkdir -p -- "$target_dir"; then
    print -u2 -r -- "  ✗ $agent_name: cannot create $target_dir"
    return 1
  fi

  for source_skill in "$source_dir"/*(N/); do
    [[ -f "$source_skill/SKILL.md" ]] || continue
    target_skill="$target_dir/${source_skill:t}"

    if [[ -L $target_skill || ( -e $target_skill && ! -d $target_skill ) ]]; then
      print -u2 -r -- \
        "  ! $agent_name: kept conflicting ${source_skill:t}"
      (( ++conflicts ))
      continue
    fi

    if [[ -d $target_skill &&
          ( ! -f "$target_skill/$marker" || -L "$target_skill/$marker" ) ]]; then
      print -u2 -r -- \
        "  ! $agent_name: kept existing personal skill ${source_skill:t}"
      (( ++conflicts ))
      continue
    fi

    [[ -d $target_skill ]] && refreshing=1 || refreshing=0
    stage_dir=$(command mktemp -d \
      "$target_dir/.xcode-skill-stage.XXXXXX") || {
      print -u2 -r -- "  ✗ $agent_name: cannot stage ${source_skill:t}"
      (( ++failures ))
      continue
    }

    if ! command cp -R -f "$source_skill"/. "$stage_dir" ||
        ! print -r -- "$xcode_build" >| "$stage_dir/$marker"; then
      print -u2 -r -- "  ✗ $agent_name: failed to copy ${source_skill:t}"
      (( ++failures ))
      _remove_xcode_skill_temp_tree "$stage_dir" "$target_dir" ||
        (( ++failures ))
      continue
    fi

    backup_dir=''
    if (( refreshing )); then
      backup_dir=$(command mktemp -d \
        "$target_dir/.xcode-skill-backup.XXXXXX") || {
        print -u2 -r -- "  ✗ $agent_name: cannot stage refresh ${source_skill:t}"
        (( ++failures ))
        _remove_xcode_skill_temp_tree "$stage_dir" "$target_dir" ||
          (( ++failures ))
        continue
      }
      if ! command mv -- "$target_skill" "$backup_dir/previous"; then
        print -u2 -r -- "  ✗ $agent_name: cannot refresh ${source_skill:t}"
        (( ++failures ))
        _remove_xcode_skill_temp_tree "$stage_dir" "$target_dir" ||
          (( ++failures ))
        _remove_xcode_skill_temp_tree "$backup_dir" "$target_dir" ||
          (( ++failures ))
        continue
      fi
    fi

    if ! command mv -- "$stage_dir" "$target_skill"; then
      print -u2 -r -- "  ✗ $agent_name: cannot activate ${source_skill:t}"
      (( ++failures ))
      restored=0
      if (( refreshing )); then
        if command mv -- "$backup_dir/previous" "$target_skill"; then
          restored=1
        else
          (( ++failures ))
          print -u2 -r -- \
            "  ! $agent_name: previous skill retained at $backup_dir/previous"
        fi
      fi
      _remove_xcode_skill_temp_tree "$stage_dir" "$target_dir" ||
        (( ++failures ))
      if [[ -n $backup_dir ]] && (( !refreshing || restored )); then
        _remove_xcode_skill_temp_tree "$backup_dir" "$target_dir" ||
          (( ++failures ))
      fi
      continue
    fi

    if (( refreshing )); then
      (( ++updated ))
      command chmod -R u+w "$backup_dir" 2>/dev/null
      _remove_xcode_skill_temp_tree "$backup_dir" "$target_dir" ||
        (( ++failures ))
    else
      (( ++installed ))
    fi
  done

  print -r -- \
    "  $agent_name: ${installed} installed, ${updated} refreshed, ${conflicts} kept"
  (( conflicts == 0 && failures == 0 ))
}

# Export Apple's portable Xcode skills once, then make them discoverable to the
# common local coding agents. No Xcode process or filesystem write occurs until
# this function is explicitly invoked.
_compozsh_help_update-xcode-skills() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: update-xcode-skills' \
    'Export Apple-authored Xcode skills to detected coding agents.' \
    '' \
    'Prerequisites and detection:' \
    '  Uses the Xcode selected for xcrun (xcode-select or DEVELOPER_DIR).' \
    '  That Xcode must provide xcrun agent skills export. This command does' \
    '  not install Xcode, coding agents, or other tools.' \
    '  Detects supported CLIs on PATH and standard macOS app bundles in' \
    '  /Applications or ~/Applications; apps are not launched.' \
    '  Codex: codex, ChatGPT.app, or Codex.app; Claude: claude or Claude.app;' \
    '  Gemini: gemini; Antigravity: agy, antigravity, or Antigravity.app;' \
    '  Kiro: kiro-cli, kiro, or Kiro.app. Detection does not check sign-in or' \
    '  guarantee skill support in every installed version or chat surface.' \
    '' \
    'Writes only for detected agents (paths are below HOME):' \
    '  Codex / Gemini CLI: ~/.agents/skills' \
    '  Claude Code:        ~/.claude/skills' \
    '  Antigravity:        ~/.gemini/config/skills' \
    '  Kiro:               ~/.kiro/skills' \
    '  Codex in Xcode also uses:' \
    '    ~/Library/Developer/Xcode/CodingAssistant/codex/skills/__xcode' \
    '  Exports once into a temporary directory, then installs real copies.' \
    '  Missing agents get no new configuration directories. With no detected' \
    '  agent or no compatible Xcode exporter, it fails before installing.' \
    '' \
    'Refresh and recovery:' \
    '  Running this command writes immediately; there is no confirmation or' \
    '  dry-run mode. Rerun after changing Xcode to refresh exported skills.' \
    '  Only existing skills marked .xcode-skill-export are replaced. Personal' \
    '  same-name directories, symlinks, and other conflicts are kept/reported.' \
    '  Replacement is staged per skill; the whole multi-agent update is not' \
    '  one transaction. A later failure can leave earlier skills updated.' \
    '  Failed replacement attempts restore the previous copy; if recovery' \
    '  fails, its retained backup path is printed. Review nonzero results.' \
    '  Refresh replaces contents of matching exported skills; it does not' \
    '  remove other skill directories absent from the new export.' \
    '  Start a new agent session afterward. Gemini CLI can use /skills reload.' \
    '  Exported guidance does not connect live Xcode tools or configure MCP.' \
    '  No arguments are accepted; --help shows this guide without detection,' \
    '  invoking Xcode, or writing files.' \
    '' \
    'Examples:' \
    '  update-xcode-skills    Export from the currently selected Xcode.'
}

update-xcode-skills() {
  emulate -L zsh

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_update-xcode-skills
    return 0
  fi

  local agent_path='' xcode_version='' xcode_build='' stage_dir=''
  local shared_agent_name=''
  local temp_root=${TMPDIR:-/tmp}
  local -i overall_status=0 install_status=0
  local -i codex_installed=0 claude_installed=0 gemini_installed=0
  local -i antigravity_installed=0 kiro_installed=0
  local -a exported_skills=()
  local -a detected_vendors=() agent_names=() skill_dirs=()
  local -i index=0

  if (( $# != 0 )); then
    print -u2 -r -- 'usage: update-xcode-skills'
    return 2
  fi

  if _detect_xcode_skill_vendor codex; then
    codex_installed=1
    detected_vendors+=("Codex ($REPLY)")
  fi
  if _detect_xcode_skill_vendor claude; then
    claude_installed=1
    detected_vendors+=("Claude Code ($REPLY)")
  fi
  if _detect_xcode_skill_vendor gemini; then
    gemini_installed=1
    detected_vendors+=("Gemini CLI ($REPLY)")
  fi
  if _detect_xcode_skill_vendor antigravity; then
    antigravity_installed=1
    detected_vendors+=("Google Antigravity ($REPLY)")
  fi
  if _detect_xcode_skill_vendor kiro; then
    kiro_installed=1
    detected_vendors+=("Kiro ($REPLY)")
  fi

  if (( codex_installed || gemini_installed )); then
    if (( codex_installed && gemini_installed )); then
      shared_agent_name='Codex + Gemini CLI'
    elif (( codex_installed )); then
      shared_agent_name='Codex'
    else
      shared_agent_name='Gemini CLI'
    fi
    agent_names+=("$shared_agent_name")
    skill_dirs+=("$HOME/.agents/skills")
  fi
  if (( claude_installed )); then
    agent_names+=('Claude Code')
    skill_dirs+=("$HOME/.claude/skills")
  fi
  if (( antigravity_installed )); then
    agent_names+=('Google Antigravity')
    skill_dirs+=("$HOME/.gemini/config/skills")
  fi
  if (( kiro_installed )); then
    agent_names+=('Kiro')
    skill_dirs+=("$HOME/.kiro/skills")
  fi
  if (( codex_installed )); then
    agent_names+=('Codex in Xcode')
    skill_dirs+=(
      "$HOME/Library/Developer/Xcode/CodingAssistant/codex/skills/__xcode"
    )
  fi

  if (( ${#agent_names} == 0 )); then
    print -u2 -r -- 'update-xcode-skills: no supported local coding agent found'
    print -u2 -r -- \
      'Install Codex, Claude Code, Gemini CLI, Antigravity, or Kiro first.'
    return 1
  fi

  if (( ! $+commands[xcrun] )) || \
      ! agent_path=$(command xcrun --find agent 2>/dev/null) || \
      [[ -z $agent_path ]]; then
    print -u2 -r -- \
      "update-xcode-skills: Xcode's agent command is unavailable"
    print -u2 -r -- \
      'Select a compatible Xcode with xcode-select, then try again.'
    return 1
  fi

  print -r -- "Detected: ${(j:, :)detected_vendors}"

  stage_dir=$(command mktemp -d "${temp_root%/}/xcode-skills.XXXXXX") || {
    print -u2 -r -- 'update-xcode-skills: cannot create a temporary directory'
    return 1
  }

  {
    xcode_version=$(command xcodebuild -version 2>/dev/null)
    xcode_build=${${(M)${(f)xcode_version}:#Build version *}#Build version }

    print -r -- 'Exporting portable Apple skills from:'
    [[ -n $xcode_version ]] && print -r -- "$xcode_version"

    if ! command xcrun agent skills export --output-dir "$stage_dir"; then
      overall_status=1
    else
      exported_skills=("$stage_dir"/*/SKILL.md(N.))
      if (( ${#exported_skills} == 0 )); then
        print -u2 -r -- 'update-xcode-skills: Xcode exported no usable skills'
        overall_status=1
      else
        print -r -- \
          "Installing ${#exported_skills} skills for local coding agents:"
        for (( index = 1; index <= ${#agent_names}; ++index )); do
          _install_xcode_skills_for_agent \
            "$stage_dir" "${skill_dirs[$index]}" \
            "${agent_names[$index]}" "$xcode_build"
          install_status=$?
          (( install_status == 0 )) || overall_status=1
        done
      fi
    fi
  } always {
    if [[ -n $stage_dir && -d $stage_dir &&
          ${stage_dir:t} == xcode-skills.* ]]; then
      command rm -rf -- "$stage_dir"
    fi
  }

  if (( overall_status == 0 )); then
    print -r -- "Xcode skills are ready for: ${(j:, :)agent_names}."
    print -r -- 'Start a new agent session to make the exported skills available.'
    (( gemini_installed )) && \
      print -r -- 'An open Gemini CLI session can instead run /skills reload.'
  else
    print -u2 -r -- \
      'The Xcode skill update did not complete; review the messages above.'
  fi
  return overall_status
}

:
