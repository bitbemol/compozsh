# Xcode-specific tools. This peer unit is loaded by the .zshrc bootstrap only
# while its name matches .zsh.<name> inside the adjacent add-on directory.

# Apple documents an Xcode 27 issue where Codex does not automatically receive
# Xcode-provided agent skills. This add-on implements Apple's `xcrun agent
# skills export` workaround and also places the portable export where other
# common agents can discover it:
# https://developer.apple.com/documentation/xcode-release-notes/xcode-27-release-notes
#
# Re-evaluate this workaround when Apple marks that issue resolved. The
# Codex-in-Xcode destination may then be removable; keep the multi-agent export
# only if it still provides value outside Xcode.

# The same peer also exposes a first-party Xcode workspace. Discovery is
# bounded to literal containers on the upward path; Xcode supplies schemes,
# destinations, builds and tests. Compozsh only coordinates the interaction.
typeset -g ZSH_XCODE_CAPTURE_MAX_BYTES=${ZSH_XCODE_CAPTURE_MAX_BYTES:-262144}
typeset -ga _XCODE_CONTAINERS=() _XCODE_CONTAINER_KINDS=()
typeset -ga _XCODE_SCHEMES=()
typeset -ga _XCODE_DESTINATION_IDS=() _XCODE_DESTINATION_PLATFORMS=()
typeset -ga _XCODE_DESTINATION_NAMES=() _XCODE_COMMAND=()
typeset -g _XCODE_CAPTURE='' _XCODE_CAPTURE_ERROR=''
typeset -g _XCODE_TEST_RESULT='' _XCODE_TEST_CAPTURE_ERROR=''
typeset -g _XCODE_TEST_CONTAINER='' _XCODE_TEST_SCHEME=''
typeset -g _XCODE_TEST_PLATFORM='' _XCODE_TEST_DESTINATION_ID=''
typeset -g _XCODE_TEST_DESTINATION='' _XCODE_TEST_MODE=''
typeset -gi _XCODE_TEST_TOTAL=0 _XCODE_TEST_PASSED=0 _XCODE_TEST_FAILED=0
typeset -gi _XCODE_TEST_SKIPPED=0 _XCODE_TEST_EXPECTED_FAILURES=0
typeset -gi _XCODE_TEST_BUILD_ERROR_TOTAL=0
typeset -ga _XCODE_TEST_FAILURE_NAMES=() _XCODE_TEST_FAILURE_TARGETS=()
typeset -ga _XCODE_TEST_FAILURE_IDENTIFIERS=()
typeset -ga _XCODE_TEST_FAILURE_TEXTS=() _XCODE_TEST_FAILURE_FILES=()
typeset -ga _XCODE_TEST_BUILD_NAMES=() _XCODE_TEST_BUILD_TEXTS=()
typeset -ga _XCODE_TEST_BUILD_FILES=()

_xcode_container_discover() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB

  local current=${1:-$PWD} entry=''
  local -a workspaces=() projects=()
  typeset -ga _XCODE_CONTAINERS=() _XCODE_CONTAINER_KINDS=()

  current=${current:a}
  [[ -d $current ]] || current=${current:h}
  while [[ $current == /* ]]; do
    workspaces=("$current"/*.xcworkspace(N/))
    projects=("$current"/*.xcodeproj(N/))
    for entry in "${workspaces[@]}"; do
      [[ ! -L $entry ]] || continue
      _XCODE_CONTAINERS+=("$entry")
      _XCODE_CONTAINER_KINDS+=(workspace)
    done
    for entry in "${projects[@]}"; do
      [[ ! -L $entry ]] || continue
      _XCODE_CONTAINERS+=("$entry")
      _XCODE_CONTAINER_KINDS+=(project)
    done
    (( ${#_XCODE_CONTAINERS} )) && return 0
    [[ $current == / ]] && break
    current=${current:h}
  done
  return 1
}

_xcode_container_arguments() {
  emulate -L zsh
  typeset -ga _XCODE_CONTAINER_ARGUMENTS=()
  case $1 in
    (workspace) _XCODE_CONTAINER_ARGUMENTS=(-workspace "$2") ;;
    (project) _XCODE_CONTAINER_ARGUMENTS=(-project "$2") ;;
    (*) return 2 ;;
  esac
}

# Revalidate the exact leaf after the full-screen workspace restores the
# terminal. A project may be renamed or replaced while the user is choosing an
# action; never execute a different symlink target under the captured consent.
_xcode_container_is_current() {
  emulate -L zsh
  local kind=$1 container=$2
  [[ $container == /* && -d $container && ! -L $container ]] || return 1
  case $kind in
    (workspace) [[ ${container:t} == *.xcworkspace ]] ;;
    (project) [[ ${container:t} == *.xcodeproj ]] ;;
    (*) return 1 ;;
  esac
}

_xcode_safe_arguments() {
  typeset -ga _XCODE_SAFE_ARGUMENTS=(
    -disableAutomaticPackageResolution
    -onlyUsePackageVersionsFromResolvedFile
    -skipPackageUpdates
  )
}

# Capture first-party command output into a size-bounded invocation directory.
# No partial output is parsed; diagnostics are retained separately and both
# files are removed before returning.
_xcode_capture_command() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local temp_root=${TMPDIR:-/tmp} capture_dir='' stdout_file='' stderr_file=''
  local raw_size='' output='' diagnostic=''
  local max_bytes=${ZSH_XCODE_CAPTURE_MAX_BYTES:-262144}
  local integer_max=9223372036854775807
  local -i command_status=0
  _XCODE_CAPTURE='' _XCODE_CAPTURE_ERROR=''
  [[ $max_bytes == <-> ]] || max_bytes=262144
  max_bytes=${max_bytes##0#}
  [[ -n $max_bytes ]] || max_bytes=0
  # Validate decimal text before arithmetic can interpret expressions or
  # truncate beyond the supported Zsh's signed 64-bit integer range.
  if (( ${#max_bytes} > ${#integer_max} )) ||
     { (( ${#max_bytes} == ${#integer_max} )) && [[ $max_bytes > $integer_max ]]; }; then
    max_bytes=262144
  fi
  (( max_bytes < 4096 )) && max_bytes=4096

  capture_dir=$(command mktemp -d "${temp_root%/}/compozsh-xcode.XXXXXX") || {
    _XCODE_CAPTURE_ERROR='cannot create a bounded capture directory'
    return 1
  }
  stdout_file="$capture_dir/stdout"
  stderr_file="$capture_dir/stderr"
  {
    command "$@" >| "$stdout_file" 2>| "$stderr_file"
    command_status=$?
    raw_size=$(command wc -c < "$stdout_file" 2>/dev/null)
    raw_size=${raw_size//[[:space:]]/}
    [[ $raw_size == <-> ]] || raw_size=0
    if (( raw_size > max_bytes )); then
      command_status=1
      diagnostic="output exceeded the ${max_bytes}-byte capture limit"
    elif (( command_status == 0 )); then
      output=$(<"$stdout_file")
    else
      diagnostic=$(command head -c 8192 -- "$stderr_file" 2>/dev/null)
      [[ -n $diagnostic ]] || diagnostic='xcodebuild returned a nonzero status'
    fi
  } always {
    if [[ -n $capture_dir && ${capture_dir:t} == compozsh-xcode.* &&
          ${capture_dir:h:A} == ${temp_root:A} ]]; then
      command rm -rf -- "$capture_dir"
    fi
  }
  _XCODE_CAPTURE=$output
  _XCODE_CAPTURE_ERROR=$diagnostic
  return $command_status
}

_xcode_json_raw() {
  emulate -L zsh
  local json=$1 key=$2
  (( $+commands[plutil] )) || return 1
  REPLY=$(print -rn -- "$json" |
    command /usr/bin/plutil -extract "$key" raw -o - -- - 2>/dev/null) || return
}

# Decode the five named XML entities emitted by plutil for string values. Decode
# ampersands last so literal text such as "&lt;" makes exactly one round trip.
_xcode_xml_string_decode() {
  emulate -L zsh
  local value=$1 apostrophe="'" double_quote='"'
  value=${value//\&lt\;/<}
  value=${value//\&gt\;/>}
  value=${value//\&quot\;/$double_quote}
  value=${value//\&apos\;/$apostrophe}
  value=${value//\&amp\;/\&}
  REPLY=$value
}

# Parse only plutil's normalized XML representation of a string array. The
# caller obtains the original array count separately, so a type mismatch or
# malformed conversion fails instead of producing a partial scheme catalog.
_xcode_plist_string_array_parse() {
  emulate -L zsh
  local remaining=$1 expected=$2 value=''
  local open='<string>' close='</string>'
  local -i parsed=0
  reply=()
  [[ $expected == <-> ]] || return 1
  while [[ $remaining == *"$open"*"$close"* ]]; do
    remaining=${remaining#*"$open"}
    value=${remaining%%"$close"*}
    remaining=${remaining#*"$close"}
    _xcode_xml_string_decode "$value"
    reply+=("$REPLY")
    (( ++parsed > expected )) && return 1
  done
  (( parsed == expected ))
}

_xcode_test_result_reset() {
  emulate -L zsh
  _XCODE_TEST_RESULT='' _XCODE_TEST_CAPTURE_ERROR=''
  _XCODE_TEST_TOTAL=0 _XCODE_TEST_PASSED=0 _XCODE_TEST_FAILED=0
  _XCODE_TEST_SKIPPED=0 _XCODE_TEST_EXPECTED_FAILURES=0
  _XCODE_TEST_BUILD_ERROR_TOTAL=0
  _XCODE_TEST_FAILURE_NAMES=() _XCODE_TEST_FAILURE_TARGETS=()
  _XCODE_TEST_FAILURE_IDENTIFIERS=()
  _XCODE_TEST_FAILURE_TEXTS=() _XCODE_TEST_FAILURE_FILES=()
  _XCODE_TEST_BUILD_NAMES=() _XCODE_TEST_BUILD_TEXTS=()
  _XCODE_TEST_BUILD_FILES=()
}

# Collect structured source locations from one failed test's bounded detail
# tree. xcresulttool owns the schema; this walker accepts only its numeric array
# indexes, limits depth/nodes, and retains no attachments or source contents.
_xcode_test_node_sources_capture() {
  emulate -L zsh
  local json=$1 key=$2
  local -i depth=${3:-0} children=0 index=0 line=0
  local file=''
  (( depth <= 12 && _XCODE_TEST_DETAIL_NODE_COUNT < 256 )) || return 0
  (( ++_XCODE_TEST_DETAIL_NODE_COUNT ))

  if _xcode_json_raw "$json" "$key.sourceLocation.filePath"; then
    file=$REPLY
    if [[ -n $file && ${#file} -le 4096 && $file != *[[:cntrl:]]* ]]; then
      if _xcode_json_raw "$json" "$key.sourceLocation.lineNumber" &&
          [[ $REPLY == <-> ]]; then
        line=$REPLY
      fi
      (( line > 0 )) && file+=":$line"
      (( _XCODE_TEST_DETAIL_FILES[(Ie)$file] )) ||
        _XCODE_TEST_DETAIL_FILES+=("$file")
    fi
  fi
  _xcode_json_raw "$json" "$key.children" || return 0
  children=$REPLY
  [[ $children == <-> ]] || return 0
  (( children > 64 )) && children=64
  for (( index = 0; index < children; ++index )); do
    _xcode_test_node_sources_capture "$json" "$key.children.$index" $(( depth + 1 ))
    (( _XCODE_TEST_DETAIL_NODE_COUNT < 256 )) || break
  done
}

_xcode_test_failure_files_capture() {
  emulate -L zsh
  local bundle=$1 identifier=$2 json='' count=0
  local -i index=0
  typeset -ga _XCODE_TEST_DETAIL_FILES=()
  typeset -gi _XCODE_TEST_DETAIL_NODE_COUNT=0
  [[ -n $identifier && ${#identifier} -le 4096 &&
     $identifier != *[[:cntrl:]]* ]] || return 1
  _xcode_capture_command xcrun xcresulttool get test-results test-details \
    --path "$bundle" --test-id "$identifier" --compact || return
  json=$_XCODE_CAPTURE
  _xcode_json_raw "$json" testRuns || return 1
  count=$REPLY
  [[ $count == <-> ]] || return 1
  (( count > 64 )) && count=64
  for (( index = 0; index < count; ++index )); do
    _xcode_test_node_sources_capture "$json" "testRuns.$index" 0
    (( _XCODE_TEST_DETAIL_NODE_COUNT < 256 )) || break
  done
  (( ${#_XCODE_TEST_DETAIL_FILES} ))
}

_xcode_test_source_url_display() {
  emulate -L zsh
  local source=$1
  [[ -n $source && ${#source} -le 4096 &&
     $source != *[[:cntrl:]]* ]] || { REPLY=''; return 1; }
  source=${source#file://}
  source=${source//\%20/ }
  REPLY=$source
}

_xcode_test_build_issues_capture() {
  emulate -L zsh
  local bundle=$1 json='' count=0 message='' issue='' target='' source=''
  local -i index=0
  _xcode_capture_command xcrun xcresulttool get build-results \
    --path "$bundle" --compact || return
  json=$_XCODE_CAPTURE
  _xcode_json_raw "$json" errors || return 0
  count=$REPLY
  [[ $count == <-> ]] || return 1
  _XCODE_TEST_BUILD_ERROR_TOTAL=$count
  (( count > 20 )) && count=20
  for (( index = 0; index < count; ++index )); do
    _xcode_json_raw "$json" "errors.$index.issueType" && issue=$REPLY || issue='Build error'
    _xcode_json_raw "$json" "errors.$index.targetName" && target=$REPLY || target=''
    _xcode_json_raw "$json" "errors.$index.message" && message=$REPLY || message='No diagnostic was reported.'
    _xcode_json_raw "$json" "errors.$index.sourceURL" && source=$REPLY || source=''
    (( ${#issue} > 256 )) && issue=${issue[1,256]}
    (( ${#target} > 256 )) && target=${target[1,256]}
    (( ${#message} > 4096 )) && message=${message[1,4096]}
    [[ -n $target ]] && issue+=" · $target"
    _xcode_test_source_url_display "$source" || REPLY=''
    _XCODE_TEST_BUILD_NAMES+=("$issue")
    _XCODE_TEST_BUILD_TEXTS+=("$message")
    _XCODE_TEST_BUILD_FILES+=("$REPLY")
  done
}

# Read only the bounded summary, failed-test details, and build issues from the
# transient xcresult bundle. The native xcodebuild stream remains untouched in
# the restored terminal while these captured facts feed the result view.
_xcode_test_result_capture() {
  emulate -L zsh
  local bundle=$1
  local -i action_status=${2:-1} failure_count=0 index=0
  local json='' name='' target='' reason='' identifier='' files=''
  _xcode_test_result_reset
  (( $+commands[xcrun] )) || {
    (( action_status == 0 )) && _XCODE_TEST_RESULT=Passed || _XCODE_TEST_RESULT=Failed
    _XCODE_TEST_CAPTURE_ERROR='xcrun is unavailable; the native test status is shown without structured details'
    return 0
  }

  if _xcode_capture_command xcrun xcresulttool get test-results summary \
       --path "$bundle" --compact; then
    json=$_XCODE_CAPTURE
    _xcode_json_raw "$json" result && _XCODE_TEST_RESULT=$REPLY
    case $_XCODE_TEST_RESULT in
      (Passed|Failed|'Expected Failure'|Skipped|unknown) ;;
      (*) _XCODE_TEST_RESULT='' ;;
    esac
    _xcode_json_raw "$json" totalTestCount && [[ $REPLY == <-> ]] && _XCODE_TEST_TOTAL=$REPLY
    _xcode_json_raw "$json" passedTests && [[ $REPLY == <-> ]] && _XCODE_TEST_PASSED=$REPLY
    _xcode_json_raw "$json" failedTests && [[ $REPLY == <-> ]] && _XCODE_TEST_FAILED=$REPLY
    _xcode_json_raw "$json" skippedTests && [[ $REPLY == <-> ]] && _XCODE_TEST_SKIPPED=$REPLY
    _xcode_json_raw "$json" expectedFailures && [[ $REPLY == <-> ]] && _XCODE_TEST_EXPECTED_FAILURES=$REPLY
    _xcode_json_raw "$json" testFailures && failure_count=$REPLY || failure_count=0
    [[ $failure_count == <-> ]] || failure_count=0
    (( failure_count > 20 )) && failure_count=20
    for (( index = 0; index < failure_count; ++index )); do
      _xcode_json_raw "$json" "testFailures.$index.testName" && name=$REPLY || name="Failed test $(( index + 1 ))"
      _xcode_json_raw "$json" "testFailures.$index.targetName" && target=$REPLY || target=''
      _xcode_json_raw "$json" "testFailures.$index.failureText" && reason=$REPLY || reason='No failure reason was reported.'
      _xcode_json_raw "$json" "testFailures.$index.testIdentifierURL" && identifier=$REPLY || identifier=''
      [[ -n $identifier ]] ||
        { _xcode_json_raw "$json" "testFailures.$index.testIdentifierString" && identifier=$REPLY || identifier=''; }
      [[ ${#identifier} -le 4096 && $identifier != *[[:cntrl:]]* ]] || identifier=''
      (( ${#name} > 512 )) && name=${name[1,512]}
      (( ${#target} > 256 )) && target=${target[1,256]}
      (( ${#reason} > 4096 )) && reason=${reason[1,4096]}
      files=''
      if _xcode_test_failure_files_capture "$bundle" "$identifier"; then
        files=${(F)_XCODE_TEST_DETAIL_FILES}
      fi
      _XCODE_TEST_FAILURE_NAMES+=("$name")
      _XCODE_TEST_FAILURE_TARGETS+=("$target")
      _XCODE_TEST_FAILURE_IDENTIFIERS+=("$identifier")
      _XCODE_TEST_FAILURE_TEXTS+=("$reason")
      _XCODE_TEST_FAILURE_FILES+=("$files")
    done
  else
    _XCODE_TEST_CAPTURE_ERROR=${_XCODE_CAPTURE_ERROR:-'Xcode returned no readable test summary'}
  fi

  if [[ -z $_XCODE_TEST_RESULT ]]; then
    (( action_status == 0 )) && _XCODE_TEST_RESULT=Passed || _XCODE_TEST_RESULT=Failed
  elif (( action_status != 0 )); then
    _XCODE_TEST_RESULT=Failed
  fi
  (( action_status != 0 )) && _xcode_test_build_issues_capture "$bundle"
  return 0
}

# Keep clipboard reports readable plain text even when an external diagnostic
# includes terminal control bytes. Newlines and tabs remain intact because they
# carry useful compiler and assertion structure for the recipient.
_xcode_test_report_text() {
  emulate -L zsh
  local value=$1 character='' safe=''
  value=${value//$'\r\n'/$'\n'}
  value=${value//$'\r'/$'\n'}
  for character in "${(@s::)value}"; do
    if [[ $character == $'\n' || $character == $'\t' ||
          $character != [[:cntrl:]] ]]; then
      safe+=$character
    else
      safe+='?'
    fi
  done
  REPLY=$safe
}

# Compose an inert, bounded report only from the structured facts already
# retained for the result window. No source files, attachments or environment
# values are read while formatting or copying it.
_xcode_test_report_build() {
  emulate -L zsh
  local -i action_status=${1:-1} index=0 captured=0 reported=0
  local report='Xcode test report' result='' name='' target='' identifier=''
  local reason='' files=''
  local expected_label='expected failure'

  _xcode_test_report_text "${_XCODE_TEST_RESULT:-Unknown}"
  result=$REPLY
  report+=$'\n\n'"Result: $result"
  report+=$'\n'"xcodebuild exit status: $action_status"
  _xcode_test_report_text "${_XCODE_TEST_MODE:-Incremental Test}"
  report+=$'\n'"Mode: $REPLY"
  if [[ -n $_XCODE_TEST_CONTAINER ]]; then
    _xcode_test_report_text "$_XCODE_TEST_CONTAINER"
    report+=$'\n'"Container: $REPLY"
  fi
  _xcode_test_report_text "$_XCODE_TEST_SCHEME"
  report+=$'\n'"Scheme: $REPLY"
  _xcode_test_report_text "$_XCODE_TEST_DESTINATION"
  report+=$'\n'"Destination: $REPLY"
  if [[ -n $_XCODE_TEST_PLATFORM ]]; then
    _xcode_test_report_text "$_XCODE_TEST_PLATFORM"
    report+=$'\n'"Platform: $REPLY"
  fi
  if [[ -n $_XCODE_TEST_DESTINATION_ID ]]; then
    _xcode_test_report_text "$_XCODE_TEST_DESTINATION_ID"
    report+=$'\n'"Destination ID: $REPLY"
  fi
  (( _XCODE_TEST_EXPECTED_FAILURES != 1 )) && expected_label+='s'
  report+=$'\n'"Tests: ${_XCODE_TEST_TOTAL} total · ${_XCODE_TEST_PASSED} passed"
  report+=" · ${_XCODE_TEST_FAILED} failed · ${_XCODE_TEST_SKIPPED} skipped"
  report+=" · ${_XCODE_TEST_EXPECTED_FAILURES} $expected_label"
  report+=$'\n''Report scope: bounded structured xcresult snapshot; native console'
  report+=' output, attachments, and source contents are not included.'

  captured=${#_XCODE_TEST_FAILURE_NAMES}
  reported=$_XCODE_TEST_FAILED
  (( reported < captured )) && reported=$captured
  if (( captured )); then
    report+=$'\n\n'"Failed tests: $captured captured of $reported reported"
    for (( index = 1; index <= captured; ++index )); do
      _xcode_test_report_text "${_XCODE_TEST_FAILURE_NAMES[index]}"
      name=$REPLY
      _xcode_test_report_text "${_XCODE_TEST_FAILURE_TARGETS[index]}"
      target=$REPLY
      _xcode_test_report_text "${_XCODE_TEST_FAILURE_IDENTIFIERS[index]}"
      identifier=$REPLY
      _xcode_test_report_text "${_XCODE_TEST_FAILURE_TEXTS[index]}"
      reason=$REPLY
      _xcode_test_report_text "${_XCODE_TEST_FAILURE_FILES[index]}"
      files=$REPLY
      report+=$'\n\n'"$index. $name"
      [[ -n $target ]] && report+=$'\n'"Target: $target"
      [[ -n $identifier ]] && report+=$'\n'"Identifier: $identifier"
      report+=$'\n'"Failure:"$'\n'"$reason"
      if [[ -n $files ]]; then
        report+=$'\n'"Involved files:"$'\n- '"${files//$'\n'/$'\n- '}"
      else
        report+=$'\n'"Involved files: Xcode reported no source location for this failure."
      fi
    done
  fi

  captured=${#_XCODE_TEST_BUILD_NAMES}
  if (( captured )); then
    reported=$_XCODE_TEST_BUILD_ERROR_TOTAL
    (( reported < captured )) && reported=$captured
    report+=$'\n\n'"Build errors: $captured captured of $reported reported"
    for (( index = 1; index <= captured; ++index )); do
      _xcode_test_report_text "${_XCODE_TEST_BUILD_NAMES[index]}"
      name=$REPLY
      _xcode_test_report_text "${_XCODE_TEST_BUILD_TEXTS[index]}"
      reason=$REPLY
      _xcode_test_report_text "${_XCODE_TEST_BUILD_FILES[index]}"
      files=$REPLY
      report+=$'\n\n'"$index. $name"$'\n'"Failure:"$'\n'"$reason"
      if [[ -n $files ]]; then
        report+=$'\n'"Involved files:"$'\n- '"${files//$'\n'/$'\n- '}"
      else
        report+=$'\n'"Involved files: Xcode reported no source location for this issue."
      fi
    done
  elif (( action_status != 0 && ${#_XCODE_TEST_FAILURE_NAMES} == 0 )); then
    report+=$'\n\n''Structured failure details: Xcode reported no test or build issue.'
  fi

  if [[ -n $_XCODE_TEST_CAPTURE_ERROR ]]; then
    _xcode_test_report_text "$_XCODE_TEST_CAPTURE_ERROR"
    report+=$'\n\n'"Structured result limitation: $REPLY"
  fi
  REPLY=$report
}

_xcode_test_report_copy() {
  emulate -L zsh
  setopt PIPE_FAIL
  local action_status=$1 clipboard_binary=$2
  [[ -n $clipboard_binary && -x $clipboard_binary ]] || {
    print -u2 -r -- 'xcode: pbcopy is unavailable; the test report was not copied'
    return 1
  }
  _xcode_test_report_build "$action_status" || return
  print -rn -- "$REPLY" | command "$clipboard_binary" || {
    print -u2 -r -- 'xcode: could not copy the test report'
    return 1
  }
  print -r -- 'Copied Xcode test report to the clipboard.'
}

# Apply the result-screen choice after its screen session has restored the
# terminal. A clipboard failure becomes the command status only when the native
# test action itself passed; a failing test always keeps xcodebuild's status.
_xcode_test_result_apply() {
  emulate -L zsh
  local action_status=$1 selected=$2 clipboard_binary=$3
  local -i copy_status=0
  if [[ $selected == copy-report ]]; then
    _xcode_test_report_copy "$action_status" "$clipboard_binary" || copy_status=$?
  fi
  (( action_status == 0 && copy_status != 0 )) && return $copy_status
  return $action_status
}

_xcode_schemes_capture() {
  emulate -L zsh
  local kind=$1 container=$2 json='' xml='' count='' scheme='' key=''
  local -a reply=()
  typeset -ga _XCODE_SCHEMES=()
  (( $+commands[xcodebuild] )) || {
    _XCODE_CAPTURE_ERROR='xcodebuild is unavailable; select full Xcode with xcode-select'
    return 1
  }
  _xcode_container_arguments "$kind" "$container" || return
  _xcode_safe_arguments
  _XCODE_COMMAND=(xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}"
    "${_XCODE_SAFE_ARGUMENTS[@]}" -list -json)
  _xcode_capture_command "${_XCODE_COMMAND[@]}" || return
  json=$_XCODE_CAPTURE
  key="$kind.schemes"
  _xcode_json_raw "$json" "$key" || {
    _XCODE_CAPTURE_ERROR='Xcode returned no readable scheme list'
    return 1
  }
  count=$REPLY
  [[ $count == <-> ]] || {
    _XCODE_CAPTURE_ERROR='Xcode returned an invalid scheme count'
    return 1
  }
  (( count <= 4096 )) || {
    _XCODE_CAPTURE_ERROR='Xcode reported more than 4096 schemes; none were retained'
    return 1
  }
  xml=$(print -rn -- "$json" |
    command /usr/bin/plutil -extract "$key" xml1 -o - -- - 2>/dev/null) || {
    _XCODE_CAPTURE_ERROR='Xcode returned no readable scheme list'
    return 1
  }
  _xcode_plist_string_array_parse "$xml" "$count" || {
    _XCODE_CAPTURE_ERROR='Xcode returned a malformed scheme list; none were retained'
    return 1
  }
  for scheme in "${reply[@]}"; do
    [[ -n $scheme && ${#scheme} -le 256 && $scheme != *[[:cntrl:]]* ]] || continue
    _XCODE_SCHEMES+=("$scheme")
  done
  (( ${#_XCODE_SCHEMES} )) || {
    _XCODE_CAPTURE_ERROR='Xcode reported no shared schemes for this container'
    return 1
  }
}

_xcode_destination_platform_is_supported() {
  case $1 in
    (macOS|iOS|'iOS Simulator'|tvOS|'tvOS Simulator'|watchOS|'watchOS Simulator'|visionOS|'visionOS Simulator'|DriverKit) return 0 ;;
    (*) return 1 ;;
  esac
}

_xcode_destinations_parse() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local data=$1 line='' body='' part='' key='' value=''
  local platform='' identifier='' name='' os='' destination_error=''
  local -a parts=()
  local -A seen=()
  typeset -ga _XCODE_DESTINATION_IDS=() _XCODE_DESTINATION_PLATFORMS=()
  typeset -ga _XCODE_DESTINATION_NAMES=()

  for line in ${(f)data}; do
    [[ $line == *'{'*'}'* ]] || continue
    body=${line#*\{}
    body=${body%\}*}
    parts=("${(@s:,:)body}")
    platform='' identifier='' name='' os='' destination_error=''
    for part in "${parts[@]}"; do
      part=${part##[[:space:]]#}
      part=${part%%[[:space:]]#}
      key=${part%%:*}
      value=${part#*:}
      key=${key##[[:space:]]#}
      key=${key%%[[:space:]]#}
      value=${value##[[:space:]]#}
      value=${value%%[[:space:]]#}
      case $key in
        (platform) platform=$value ;;
        (id) identifier=$value ;;
        (name) name=$value ;;
        (OS) os=$value ;;
        (error) destination_error=$value ;;
      esac
    done
    [[ -z $destination_error ]] || continue
    _xcode_destination_platform_is_supported "$platform" || continue
    [[ $identifier == [[:alnum:]][[:alnum:].-]# &&
       -n $name && ${#name} -le 200 && $name != *[[:cntrl:]]* ]] || continue
    (( ${+seen[$identifier]} )) && continue
    seen[$identifier]=1
    if [[ -n $os && ${#os} -le 100 ]]; then
      name+=" · ${platform% Simulator} ${(V)os}"
    fi
    (( ${#name} <= 4096 )) || continue
    _XCODE_DESTINATION_IDS+=("$identifier")
    _XCODE_DESTINATION_PLATFORMS+=("$platform")
    _XCODE_DESTINATION_NAMES+=("$name")
    (( ${#_XCODE_DESTINATION_IDS} >= 100 )) && break
  done
  (( ${#_XCODE_DESTINATION_IDS} ))
}

_xcode_destinations_capture() {
  emulate -L zsh
  local kind=$1 container=$2 scheme=$3
  _xcode_container_arguments "$kind" "$container" || return
  _xcode_safe_arguments
  _XCODE_COMMAND=(xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}" -scheme "$scheme"
    "${_XCODE_SAFE_ARGUMENTS[@]}" -showdestinations)
  _xcode_capture_command "${_XCODE_COMMAND[@]}" || return
  _xcode_destinations_parse "$_XCODE_CAPTURE" || {
    _XCODE_CAPTURE_ERROR='Xcode reported no concrete destinations with stable identifiers'
    return 1
  }
}

# Destination compatibility is expensive Xcode-owned discovery. Keep at most
# four successful parsed snapshots inside one workspace controller so returning
# to a scheme does not start xcodebuild again. These dynamically scoped arrays
# disappear when that screen session ends; reopening xcode is always fresh.
_xcode_destination_cache_touch() {
  emulate -L zsh
  local slot=$1 saved_scheme='' saved_ids='' saved_platforms='' saved_names=''
  (( ${+parameters[_XCODE_DESTINATION_CACHE_SCHEMES]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_IDS]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_PLATFORMS]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_NAMES]} )) || return 2
  [[ $slot == <-> ]] && (( slot >= 1 && slot <= ${#_XCODE_DESTINATION_CACHE_SCHEMES} )) ||
    return 2
  saved_scheme=${_XCODE_DESTINATION_CACHE_SCHEMES[slot]}
  saved_ids=${_XCODE_DESTINATION_CACHE_IDS[slot]}
  saved_platforms=${_XCODE_DESTINATION_CACHE_PLATFORMS[slot]}
  saved_names=${_XCODE_DESTINATION_CACHE_NAMES[slot]}
  _XCODE_DESTINATION_CACHE_SCHEMES[slot]=()
  _XCODE_DESTINATION_CACHE_IDS[slot]=()
  _XCODE_DESTINATION_CACHE_PLATFORMS[slot]=()
  _XCODE_DESTINATION_CACHE_NAMES[slot]=()
  _XCODE_DESTINATION_CACHE_SCHEMES+=("$saved_scheme")
  _XCODE_DESTINATION_CACHE_IDS+=("$saved_ids")
  _XCODE_DESTINATION_CACHE_PLATFORMS+=("$saved_platforms")
  _XCODE_DESTINATION_CACHE_NAMES+=("$saved_names")
}

_xcode_destination_cache_forget() {
  emulate -L zsh
  local scheme=$1
  local -i slot=0
  (( ${+parameters[_XCODE_DESTINATION_CACHE_SCHEMES]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_IDS]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_PLATFORMS]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_NAMES]} )) || return 2
  slot=${_XCODE_DESTINATION_CACHE_SCHEMES[(Ie)$scheme]}
  (( slot )) || return 0
  _XCODE_DESTINATION_CACHE_SCHEMES[slot]=()
  _XCODE_DESTINATION_CACHE_IDS[slot]=()
  _XCODE_DESTINATION_CACHE_PLATFORMS[slot]=()
  _XCODE_DESTINATION_CACHE_NAMES[slot]=()
}

_xcode_destination_cache_store() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local scheme=$1 name='' platform='' identifier=''
  local -i count=${#_XCODE_DESTINATION_IDS} index=0 slot=0
  (( ${+parameters[_XCODE_DESTINATION_CACHE_SCHEMES]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_IDS]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_PLATFORMS]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_NAMES]} )) || return 2
  [[ -n $scheme && $scheme != *[[:cntrl:]]* ]] || return 1
  (( count >= 1 && count <= 100 &&
     ${#_XCODE_DESTINATION_PLATFORMS} == count &&
     ${#_XCODE_DESTINATION_NAMES} == count )) || return 1
  for (( index = 1; index <= count; ++index )); do
    identifier=${_XCODE_DESTINATION_IDS[index]}
    platform=${_XCODE_DESTINATION_PLATFORMS[index]}
    name=${_XCODE_DESTINATION_NAMES[index]}
    [[ $identifier == [[:alnum:]][[:alnum:].-]# &&
       -n $name && ${#name} -le 4096 && $name != *[[:cntrl:]]* ]] || return 1
    _xcode_destination_platform_is_supported "$platform" || return 1
  done
  slot=${_XCODE_DESTINATION_CACHE_SCHEMES[(Ie)$scheme]}
  if (( slot )); then
    _XCODE_DESTINATION_CACHE_IDS[slot]=${(F)_XCODE_DESTINATION_IDS}
    _XCODE_DESTINATION_CACHE_PLATFORMS[slot]=${(F)_XCODE_DESTINATION_PLATFORMS}
    _XCODE_DESTINATION_CACHE_NAMES[slot]=${(F)_XCODE_DESTINATION_NAMES}
  else
    _XCODE_DESTINATION_CACHE_SCHEMES+=("$scheme")
    _XCODE_DESTINATION_CACHE_IDS+=("${(F)_XCODE_DESTINATION_IDS}")
    _XCODE_DESTINATION_CACHE_PLATFORMS+=("${(F)_XCODE_DESTINATION_PLATFORMS}")
    _XCODE_DESTINATION_CACHE_NAMES+=("${(F)_XCODE_DESTINATION_NAMES}")
    slot=${#_XCODE_DESTINATION_CACHE_SCHEMES}
  fi
  _xcode_destination_cache_touch $slot || return
  if (( ${#_XCODE_DESTINATION_CACHE_SCHEMES} > 4 )); then
    _XCODE_DESTINATION_CACHE_SCHEMES=("${_XCODE_DESTINATION_CACHE_SCHEMES[@][2,-1]}")
    _XCODE_DESTINATION_CACHE_IDS=("${_XCODE_DESTINATION_CACHE_IDS[@][2,-1]}")
    _XCODE_DESTINATION_CACHE_PLATFORMS=("${_XCODE_DESTINATION_CACHE_PLATFORMS[@][2,-1]}")
    _XCODE_DESTINATION_CACHE_NAMES=("${_XCODE_DESTINATION_CACHE_NAMES[@][2,-1]}")
  fi
}

_xcode_destination_cache_restore() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local scheme=$1 encoded='' name='' platform='' identifier=''
  local -i slot=0 count=0 index=0
  local -a ids=() platforms=() names=()
  (( ${+parameters[_XCODE_DESTINATION_CACHE_SCHEMES]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_IDS]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_PLATFORMS]} &&
     ${+parameters[_XCODE_DESTINATION_CACHE_NAMES]} )) || return 2
  slot=${_XCODE_DESTINATION_CACHE_SCHEMES[(Ie)$scheme]}
  (( slot )) || return 1
  encoded=${_XCODE_DESTINATION_CACHE_IDS[slot]}
  ids=("${(@f)encoded}")
  encoded=${_XCODE_DESTINATION_CACHE_PLATFORMS[slot]}
  platforms=("${(@f)encoded}")
  encoded=${_XCODE_DESTINATION_CACHE_NAMES[slot]}
  names=("${(@f)encoded}")
  count=${#ids}
  (( count >= 1 && count <= 100 && ${#platforms} == count && ${#names} == count )) ||
    return 1
  for (( index = 1; index <= count; ++index )); do
    identifier=${ids[index]} platform=${platforms[index]} name=${names[index]}
    [[ $identifier == [[:alnum:]][[:alnum:].-]# &&
       -n $name && ${#name} -le 4096 && $name != *[[:cntrl:]]* ]] || return 1
    _xcode_destination_platform_is_supported "$platform" || return 1
  done
  _XCODE_DESTINATION_IDS=("${ids[@]}")
  _XCODE_DESTINATION_PLATFORMS=("${platforms[@]}")
  _XCODE_DESTINATION_NAMES=("${names[@]}")
  _xcode_destination_cache_touch $slot
}

_xcode_action_command() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local kind=$1 container=$2 scheme=$3 platform=$4 identifier=$5 action=$6
  local -a actions=()
  typeset -ga _XCODE_COMMAND=()
  case $action in
    (build|test|analyze|clean) actions=("$action") ;;
    (rebuild) actions=(clean build) ;;
    (rebuild-test) actions=(clean test) ;;
    (*) return 2 ;;
  esac
  [[ -n $scheme && $scheme != *[[:cntrl:]]* ]] || return 2
  _xcode_destination_platform_is_supported "$platform" || return 2
  [[ $identifier == [[:alnum:]][[:alnum:].-]# ]] || return 2
  _xcode_container_arguments "$kind" "$container" || return
  _xcode_safe_arguments
  _XCODE_COMMAND=(xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}" -scheme "$scheme"
    -destination "platform=$platform,id=$identifier"
    "${_XCODE_SAFE_ARGUMENTS[@]}" -hideShellScriptEnvironment "${actions[@]}")
}

_xcode_build_settings_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local kind=$1 container=$2 scheme=$3 platform=$4 identifier=$5
  local json='' extension='' build_dir='' product='' bundle_id=''
  local -i index=0
  typeset -g _XCODE_APP_PATH='' _XCODE_BUNDLE_ID=''
  _xcode_container_arguments "$kind" "$container" || return
  _xcode_safe_arguments
  _XCODE_COMMAND=(xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}" -scheme "$scheme"
    -destination "platform=$platform,id=$identifier"
    "${_XCODE_SAFE_ARGUMENTS[@]}" -showBuildSettings -json)
  _xcode_capture_command "${_XCODE_COMMAND[@]}" || return
  json=$_XCODE_CAPTURE
  # The root is an array. Probe a bounded number of target dictionaries;
  # plutil intentionally has no empty-key extraction for the root count.
  for (( index = 0; index < 100; ++index )); do
    _xcode_json_raw "$json" "$index.buildSettings" || break
    _xcode_json_raw "$json" "$index.buildSettings.WRAPPER_EXTENSION" || continue
    extension=$REPLY
    [[ $extension == app ]] || continue
    _xcode_json_raw "$json" "$index.buildSettings.TARGET_BUILD_DIR" || continue
    build_dir=$REPLY
    _xcode_json_raw "$json" "$index.buildSettings.FULL_PRODUCT_NAME" || continue
    product=$REPLY
    _xcode_json_raw "$json" "$index.buildSettings.PRODUCT_BUNDLE_IDENTIFIER" || continue
    bundle_id=$REPLY
    [[ $build_dir == /* && -n $product && $product != */* &&
       $bundle_id == [[:alnum:]][[:alnum:].-]# ]] || continue
    _XCODE_APP_PATH="$build_dir/$product"
    _XCODE_BUNDLE_ID=$bundle_id
    [[ -d $_XCODE_APP_PATH && ! -L $_XCODE_APP_PATH ]] && return 0
  done
  _XCODE_CAPTURE_ERROR='the selected scheme produced no installable application bundle'
  return 1
}

# Open only the viewer bundled with the same Xcode as the native tools.
# xcode-select resolves both supported DEVELOPER_DIR forms before returning
# the Developer directory; a global application-name lookup can choose wrong.
_xcode_open_simulator() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local identifier=$1 developer='' viewer=''
  local _XCODE_CAPTURE='' _XCODE_CAPTURE_ERROR=''
  local -a arguments=()
  local -i result=0
  [[ $identifier == [[:alnum:]][[:alnum:].-]# ]] || return 2
  _xcode_capture_command xcode-select --print-path || {
    print -u2 -r -- 'xcode: cannot resolve the selected Xcode for its Simulator window'
    return 1
  }
  developer=$_XCODE_CAPTURE
  [[ $developer == /*/Contents/Developer && $developer != *[[:cntrl:]]* &&
     -d $developer ]] || {
    print -u2 -r -- 'xcode: a full Xcode installation is required to open its Simulator window'
    return 1
  }
  viewer="${developer:h}/Applications/DeviceHub.app"
  if [[ -x $viewer/Contents/MacOS/DeviceHub ]]; then
    # This local application URL also selects the device in an existing window.
    arguments=("devices:///manage/select?id=$identifier")
  else
    viewer="$developer/Applications/Simulator.app"
    [[ -x $viewer/Contents/MacOS/Simulator ]] || {
      print -u2 -r -- 'xcode: the selected Xcode has no Device Hub or Simulator application'
      return 1
    }
    arguments=(--args -CurrentDeviceUDID "$identifier")
  fi
  command open -a "$viewer" "${arguments[@]}" || {
    result=$?
    print -u2 -r -- 'xcode: could not open the selected Simulator window; open Device Hub or Simulator and retry'
    return $result
  }
}

_xcode_run_simulator() {
  emulate -L zsh
  local kind=$1 container=$2 scheme=$3 platform=$4 identifier=$5
  local requested_mode=${6:-run} build_action=build
  local destination=${7:-$platform}
  case $requested_mode in
    (run) ;;
    (rebuild-run) build_action=rebuild ;;
    (*) return 2 ;;
  esac
  [[ $platform == *Simulator ]] || {
    print -u2 -r -- 'xcode: Run requires a concrete Simulator destination'
    return 2
  }
  _xcode_action_command "$kind" "$container" "$scheme" "$platform" "$identifier" \
    "$build_action" || return
  command "${_XCODE_COMMAND[@]}" || return
  _xcode_build_settings_capture "$kind" "$container" "$scheme" "$platform" "$identifier" || {
    print -u2 -r -- "xcode: ${_XCODE_CAPTURE_ERROR:-cannot resolve the built application}"
    return 1
  }
  (( $+commands[xcrun] )) || {
    print -u2 -r -- 'xcode: xcrun is unavailable'
    return 1
  }
  command xcrun simctl boot "$identifier" >/dev/null 2>&1 || true
  command xcrun simctl bootstatus "$identifier" -b || return
  _xcode_open_simulator "$identifier" || return
  command xcrun simctl install "$identifier" "$_XCODE_APP_PATH" || return
  if [[ -o interactive && -t 0 && -t 1 && $TERM != dumb ]] &&
      (( ${+functions[_zle_picker_run]} )); then
    _xcode_run_live "$identifier" "$_XCODE_BUNDLE_ID" "$scheme · $destination · $identifier"
    return $?
  fi
  command xcrun simctl launch "$identifier" "$_XCODE_BUNDLE_ID"
}

# One explicit run owns its pipe, process identity and bounded memory tail.
# App output never shares the launch-response channel used to resolve the PID.
_xcode_run_log_append() {
  emulate -L zsh
  local LC_ALL=C
  _xcode_run_log+=$1
  if (( ${#_xcode_run_log} > 32768 )); then
    _xcode_run_log=${_xcode_run_log[-32768,-1]}
    _xcode_run_trimmed=1
  fi
  local -a lines=("${(@f)_xcode_run_log}")
  if (( ${#lines} > 200 )); then
    _xcode_run_log=${(pj:\n:)lines[-200,-1]}
    _xcode_run_trimmed=1
  fi
}

_xcode_run_output_snapshot() {
  emulate -L zsh
  local _xcode_run_log=$_xcode_run_log pending=''
  for pending in "${_xcode_run_pending[@]}"; do
    [[ -n $pending ]] && _xcode_run_log_append "$pending"$'\n'
  done
  REPLY=$_xcode_run_log
}

# Keep unfinished records separate: a read boundary is not a line boundary,
# and bytes from the two producers must never form a single mixed record.
_xcode_run_output_append() {
  emulate -L zsh
  local LC_ALL=C source=$1 text="${_xcode_run_pending[$1]-}$2" complete=''
  local -a records=("${(@f)text}")
  if (( ${#records} > 1 )); then
    complete=${(pj:\n:)records[1,-2]}
    _xcode_run_log_append "$complete"$'\n'
  fi
  text=${records[-1]-}
  if (( ${#text} > 8192 )); then
    text=${text[-8192,-1]}
    _xcode_run_trimmed=1
  fi
  _xcode_run_pending[$source]=$text
}

# Subscribe before launch, with a native predicate for this installed executable
# on this device. Neither user log configuration nor a process-name match may
# broaden that source. All metadata reads stay outside the input/paint loops.
_xcode_run_logs_start() {
  emulate -L zsh
  unsetopt BG_NICE NOTIFY
  local identifier=$1 bundle=$2 app='' executable='' predicate='' chunk='' header=''
  local -i attempt=0 read_status=0
  local -x SIMCTL_CHILD_LOGRC=/dev/null SIMCTL_CHILD_NSUnbufferedIO=YES LC_ALL=C
  _xcode_run_unified_status=unavailable
  zmodload zsh/parameter || return 1
  _xcode_capture_command xcrun simctl get_app_container "$identifier" "$bundle" app || return 1
  app=$_XCODE_CAPTURE
  [[ $app == /* && ${#app} -le 4096 && $app != *[[:cntrl:]]* &&
     -d $app && ! -L $app && -f $app/Info.plist && ! -L $app/Info.plist ]] || return 1
  app=${app:A}
  _xcode_capture_command plutil -extract CFBundleExecutable raw -o - -- "$app/Info.plist" || return 1
  executable=$_XCODE_CAPTURE
  [[ -n $executable && ${#executable} -le 255 && $executable != */* &&
     $executable != *[[:cntrl:]]* && $executable != . && $executable != .. ]] || return 1
  executable="$app/$executable"
  [[ -f $executable && -x $executable && ${executable:A:h} == "$app" ]] || return 1
  executable=${executable:A}
  predicate=${executable//\\/\\\\}
  predicate=${predicate//\"/\\\"}
  predicate="processImagePath == \"$predicate\""
  _xcode_run_unified_fifo="$_xcode_run_dir/unified"
  command mkfifo -m 600 -- "$_xcode_run_unified_fifo" || return 1
  sysopen -r -o nonblock,cloexec -u _xcode_run_unified_fd "$_xcode_run_unified_fifo" || return 1
  # This invocation's producer owns no terminal job. simctl forwards termination
  # to its spawned log process; the caller stops and reaps it before closing FIFO.
  unsetopt MONITOR
  command xcrun simctl spawn "$identifier" log stream --predicate "$predicate" \
    --level debug --style compact --color none > "$_xcode_run_unified_fifo" 2>/dev/null &
  _xcode_run_logger=$!
  # Native header observation avoids launching before the stream even starts.
  # It is bounded, and is not a guarantee that the OS delivers every message.
  for (( attempt=0; attempt<20; ++attempt )); do
    chunk=''
    sysread -i $_xcode_run_unified_fd -s 1024 -t 0.1 chunk 2>/dev/null
    read_status=$?
    header+=$chunk
    if [[ $header == *$'\n'* ]]; then
      [[ $header == 'Filtering the log data using '* && ${#header} -le 8192 ]] || break
      _xcode_run_unified_status=following
      return 0
    fi
    (( ${#header} <= 8192 )) || break
    # No writer yet also reports EOF; wait without a subprocess or busy loop.
    if (( read_status == 5 )); then
      zmodload zsh/zselect || break
      zselect -t 10
    elif (( read_status != 0 && read_status != 4 )); then
      break
    fi
  done
  return 1
}

_xcode_run_logs_stop() {
  emulate -L zsh
  local job='' state=''
  if (( ${_xcode_run_logger:-0} > 1 )); then
    # Zsh can reap an exited producer before this view closes. Verify it is
    # still our live job, rather than signalling a numeric PID reused later.
    for job in "${(@k)jobstates}"; do
      state=${jobstates[$job]}
      if [[ $state == *":$_xcode_run_logger=running" ||
            $state == *":$_xcode_run_logger=suspended" ]]; then
        kill -TERM $_xcode_run_logger 2>/dev/null
        [[ $state == *'=suspended' ]] && kill -CONT $_xcode_run_logger 2>/dev/null
        break
      fi
    done
    wait $_xcode_run_logger 2>/dev/null
    _xcode_run_logger=0
  fi
}

_xcode_run_identity() {
  emulate -L zsh
  local pid=$1
  [[ $pid == <-> && ${#pid} -le 10 ]] && (( pid > 1 )) || return 1
  REPLY=$(LC_ALL=C command ps -p "$pid" -o uid= -o lstart= -o comm= 2>/dev/null) || return 1
  [[ -n $REPLY && ${#REPLY} -le 4096 && $REPLY != *$'\n'* ]]
}

_xcode_run_is_current() {
  _xcode_run_identity "$_xcode_run_pid" &&
    [[ -n $_xcode_run_identity && $REPLY == "$_xcode_run_identity" ]]
}

# Called only from the shared loop's idle boundary, never from a renderer or
# resize handler. Drain at most 32 KiB per turn; input always gets priority.
_xcode_run_read_sources() {
  emulate -L zsh
  local chunk=''
  local -i attempt=0 read_status=0 changed=0 source=1 fd=-1
  if (( !_xcode_run_eof || ${_xcode_run_unified_fd:--1} >= 0 )); then
    for (( attempt=0; attempt<4; ++attempt )); do
      source=1
      [[ ${_xcode_run_unified_status:-} == following ]] && source=$(( attempt % 2 + 1 ))
      if (( source == 2 )); then
        [[ ${_xcode_run_unified_status:-} == following ]] || continue
        fd=$_xcode_run_unified_fd
      else
        (( !_xcode_run_eof )) || continue
        fd=$_xcode_run_fd
      fi
      chunk=''
      sysread -i $fd -s 8192 -t 0 chunk 2>/dev/null
      read_status=$?
      if [[ -n $chunk ]]; then
        _xcode_run_output_append $source "$chunk"
        (( source == 1 )) && _xcode_run_stdout_seen=1
        changed=1
      fi
      if (( read_status == 5 )); then
        # Launch can return before the app opens its output handles. With no
        # bytes yet, FIFO EOF is only a writer gap; continue waiting for data.
        if (( source == 2 )); then
          _xcode_run_unified_status=closed changed=1
        elif (( ${_xcode_run_stdout_seen:-0} )); then
          _xcode_run_eof=1 changed=1
        fi
        continue
      fi
      if (( read_status != 0 && read_status != 4 )); then
        if (( source == 2 )); then
          _xcode_run_unified_status=unavailable
        else
          _xcode_run_eof=1 _xcode_run_read_error=1
        fi
        changed=1
      fi
    done
  fi
  REPLY=$changed
}

_xcode_run_capture_idle() {
  _xcode_run_read_sources
  (( _xcode_run_eof )) && [[ ${_xcode_run_unified_status:-} != following ]] && return 2
  return 1
}

_xcode_run_idle() {
  emulate -L zsh
  local previous_subtitle=$_ZLE_PICKER_SUBTITLE
  local previous_title=${_ZLE_PICKER_INSPECT_TITLE:-} output_state='' source_state=''
  local -i changed=0 max_offset=0
  local -i reading=$(( _ZLE_PICKER_INSPECT_FOCUS || _ZLE_PICKER_GUIDE_ACTIVE ))
  local -i open_reader=${_xcode_run_open_reader:-0}
  _xcode_run_read_sources
  changed=$REPLY
  _ZLE_PICKER_SUBTITLE="$_xcode_run_context · stdout/stderr"
  case ${_xcode_run_unified_status:-} in
    following) _ZLE_PICKER_SUBTITLE+=' + Logger' ;;
    closed) _ZLE_PICKER_SUBTITLE+=' · Logger closed'; source_state='Logger closed' ;;
    unavailable) _ZLE_PICKER_SUBTITLE+=' · Logger unavailable'; source_state='Logger unavailable' ;;
  esac
  if (( ${_xcode_run_read_error:-0} )); then
    if [[ ${_xcode_run_unified_status:-} == following ]]; then
      _ZLE_PICKER_SUBTITLE+=' · stdout/stderr unavailable'
      _ZLE_PICKER_PASSIVE_LINES[2]='stdout/stderr unavailable; Logger continues.'
      source_state='stdout unavailable'
    else
      _ZLE_PICKER_SUBTITLE+=' · output unavailable'
      output_state=Unavailable
    fi
  elif (( _xcode_run_eof )); then
    if [[ ${_xcode_run_unified_status:-} == following ]]; then
      _ZLE_PICKER_SUBTITLE+=' · stdout/stderr closed'
      _ZLE_PICKER_PASSIVE_LINES[2]='stdout/stderr closed; Logger continues.'
      source_state='stdout closed'
    else
      _ZLE_PICKER_SUBTITLE+=' · output closed'
      output_state=Closed
    fi
  fi
  _ZLE_PICKER_INSPECT_TITLE='App output · Following'
  # Opening Read output seeds a frozen snapshot at the tail after the shared
  # loop has prepared its new reader geometry. Later reads leave it stable.
  if (( (!reading && (changed || _xcode_run_publish)) || open_reader )); then
    _xcode_run_output_snapshot
    local output=$REPLY
    _xcode_run_empty_snapshot=0
    [[ -z $output ]] && _xcode_run_empty_snapshot=1
    _ZLE_PICKER_INSPECT_TEXTS[run]=${output:-${_xcode_run_empty_output:-'Waiting for app output.'}}
    _ZLE_PICKER_INSPECT_WIDTH=0
    _ZLE_PICKER_INSPECT_OFFSET=100000
    _xcode_run_publish=0
    changed=1
  elif (( reading )); then
    changed=0
  fi
  case ${_xcode_run_unified_status:-} in
    closed|unavailable)
      _ZLE_PICKER_PASSIVE_LINES[2]="Logger $_xcode_run_unified_status; stdout/stderr follows when available."
      ;;
  esac
  # Capture status remains live even while an empty reading snapshot is frozen.
  # Invalidate its prepared rows; never replace actual frozen app messages.
  if (( ${_xcode_run_empty_snapshot:-0} )) && [[ -n $source_state ]]; then
    local empty_output=''
    if [[ $source_state == Logger* ]]; then
      empty_output="Logger capture $_xcode_run_unified_status."$'\n'
      if (( ${_xcode_run_read_error:-0} )); then
        empty_output+='stdout/stderr unavailable.'
      elif (( _xcode_run_eof )); then
        empty_output+='stdout/stderr closed.'
      else
        empty_output+='Waiting for app stdout/stderr.'
      fi
    else
      empty_output="$source_state."$'\nWaiting for Logger/os_log.'
    fi
    if [[ ${_ZLE_PICKER_INSPECT_TEXTS[run]} != "$empty_output" ]]; then
      _ZLE_PICKER_INSPECT_TEXTS[run]=$empty_output
      _ZLE_PICKER_INSPECT_WIDTH=0
      changed=1
    fi
  fi
  if (( reading )); then
    _ZLE_PICKER_INSPECT_TITLE='App output · Paused'
    _ZLE_PICKER_SUBTITLE+=' · reading paused'
    _xcode_run_publish=1
  elif [[ -n $output_state ]]; then
    _ZLE_PICKER_INSPECT_TITLE='App output'
  fi
  [[ -n $output_state ]] && _ZLE_PICKER_INSPECT_TITLE+=" · $output_state"
  if [[ -z $output_state && -n $source_state ]]; then
    _ZLE_PICKER_INSPECT_TITLE="$source_state · Following"
    (( reading )) && _ZLE_PICKER_INSPECT_TITLE="$source_state · Paused"
  fi
  (( open_reader )) && _xcode_run_open_reader=0
  if (( !changed && _ZLE_PICKER_INSPECT_WIDTH > 0 &&
        !_ZLE_PICKER_INSPECT_FOCUS && !_ZLE_PICKER_GUIDE_ACTIVE )); then
    # A taller or shorter pane changes the tail position even without new
    # bytes. The shared renderer has already supplied its current geometry.
    max_offset=$(( ${#_ZLE_PICKER_INSPECT_LINES} - _ZLE_PICKER_INSPECT_PAGE ))
    (( max_offset < 0 )) && max_offset=0
    if (( _ZLE_PICKER_INSPECT_OFFSET != max_offset )); then
      _ZLE_PICKER_INSPECT_OFFSET=$max_offset
      changed=1
    fi
  fi
  (( _xcode_run_trimmed )) && _ZLE_PICKER_SUBTITLE+=' · older output dropped'
  [[ $previous_subtitle != "$_ZLE_PICKER_SUBTITLE" ||
     $previous_title != "$_ZLE_PICKER_INSPECT_TITLE" ]] && changed=1
  (( changed )) && return 0
  (( _xcode_run_eof )) && [[ ${_xcode_run_unified_status:-} != following ]] && return 2
  return 1
}

# The displayed tail follows capture until reading pauses it. Filtering,
# formatting and copying derive only from that published text.
_xcode_logs_capture() {
  _xcode_run_read_sources
  _xcode_run_output_snapshot
  _xcode_logs_snapshot=$REPLY
  _xcode_logs_trimmed=$_xcode_run_trimmed
  _xcode_logs_captured=1
  _xcode_logs_offset=100000 _xcode_logs_row=0 _xcode_logs_width=0
}

_xcode_logs_status() {
  emulate -L zsh
  # Keep actionable failures before counts so narrow headers disclose them.
  _ZLE_PICKER_BROWSE_LABEL=''
  _ZLE_PICKER_SUBTITLE=$_xcode_run_context
  case ${_xcode_run_unified_status:-} in
    closed|unavailable) _ZLE_PICKER_BROWSE_LABEL+="Logger $_xcode_run_unified_status · " ;;
  esac
  if (( ${_xcode_run_read_error:-0} )); then
    _ZLE_PICKER_BROWSE_LABEL+='stdout unavailable · '
  elif (( ${_xcode_run_eof:-0} )); then
    _ZLE_PICKER_BROWSE_LABEL+='stdout closed · '
  fi
  [[ -n ${_xcode_logs_notice:-} ]] && _ZLE_PICKER_BROWSE_LABEL+="$_xcode_logs_notice · "
  _ZLE_PICKER_BROWSE_LABEL+="$_xcode_logs_matches of $_xcode_logs_total retained lines"
  (( ${_xcode_logs_trimmed:-0} )) && _ZLE_PICKER_BROWSE_LABEL+=' · older logs dropped'
  return 0
}

# Derive presentation from one captured line. Results belong to the caller;
# copying and literal matching retain the original snapshot independently.
_xcode_logs_format_line() {
  emulate -L zsh
  local raw=$1 time='' level='' scope='' body='' label='' role=''
  local MATCH=''
  local -a match=() mbegin=() mend=()
  local -i MBEGIN=0 MEND=0
  local record_pattern='^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:blank:]]+([0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?)[[:blank:]]+(Df|Db|In|Er|Ft)[[:blank:]]+([^][]+)\[[0-9]+:[[:xdigit:]]+\]([[:blank:]](.*))?$'
  local scope_pattern='^\[([^][]+:[^][]+)\]([[:blank:]](.*))?$'
  _xcode_logs_format_lines=("$raw") _xcode_logs_format_roles=(text)
  REPLY=0
  [[ $raw =~ $record_pattern ]] || return 0
  time=${match[1][1,12]} level=$match[3] scope=$match[4] body=$match[6]
  if [[ $body =~ $scope_pattern ]]; then
    scope=$match[1] body=$match[3]
  fi
  case $level in
    Df) label=Default role=info ;;
    Db) label=Debug role=muted ;;
    In) label=Info role=info ;;
    Er) label=Error role=error ;;
    Ft) label=Fault role=error ;;
  esac
  _xcode_logs_format_lines=("$time · $label · $scope" "$body")
  _xcode_logs_format_roles=("$role" text)
  REPLY=1
  return 0
}

_xcode_logs_collect() {
  emulate -L zsh
  local query=$1 line='' lower=${1:l} previous_text=${_xcode_logs_text-}
  local -a lines=("${(@f)_xcode_logs_snapshot}") matched=()
  local -a _xcode_logs_format_lines=() _xcode_logs_format_roles=()
  local -i index=0 final_newline=0 changed=0 previous_total=${_xcode_logs_total:-0}
  [[ $_xcode_logs_snapshot == *$'\n' ]] && final_newline=1
  if [[ -z $_xcode_logs_snapshot ]]; then
    lines=()
  elif (( final_newline )); then
    lines[-1]=()
  fi
  _xcode_logs_total=${#lines} _xcode_logs_matches=0 _xcode_logs_text=''
  _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
  for line in "${lines[@]}"; do
    (( ++index ))
    [[ ${line:l} == *"$lower"* ]] || continue
    (( ++_xcode_logs_matches ))
    matched+=("$line")
    _xcode_logs_text+=$line
    (( index < ${#lines} || final_newline )) && _xcode_logs_text+=$'\n'
  done
  _ZLE_PICKER_COPY_ENABLED=$(( ${#_xcode_logs_text} > 0 && ${#_xcode_run_clipboard} > 0 ))
  # A noisy app can change the raw tail without changing any filter matches.
  # Keep prepared formatting/wrapping in that case; only status may need paint.
  if [[ $previous_text != "$_xcode_logs_text" ]] ||
     (( !${#_ZLE_PICKER_DOCUMENT_LINES} || (previous_total == 0) != (_xcode_logs_total == 0) )); then
    changed=1
    _ZLE_PICKER_DOCUMENT_LINES=() _ZLE_PICKER_DOCUMENT_ROLES=()
    for line in "${matched[@]}"; do
      _xcode_logs_format_line "$line"
      if (( ${#_ZLE_PICKER_DOCUMENT_LINES} && REPLY )); then
        _ZLE_PICKER_DOCUMENT_LINES+=('')
        _ZLE_PICKER_DOCUMENT_ROLES+=(text)
      fi
      _ZLE_PICKER_DOCUMENT_LINES+=("${_xcode_logs_format_lines[@]}")
      _ZLE_PICKER_DOCUMENT_ROLES+=("${_xcode_logs_format_roles[@]}")
    done
    if (( !_xcode_logs_matches )); then
      if (( _xcode_logs_total )); then
        _ZLE_PICKER_DOCUMENT_LINES=('No retained lines match this filter.' 'New matching output appears while following live.')
      else
        _ZLE_PICKER_DOCUMENT_LINES=('Waiting for app output.' 'New messages appear automatically while following live.')
      fi
      _ZLE_PICKER_DOCUMENT_ROLES=(info text)
    fi
    _ZLE_PICKER_INSPECT_WIDTH=0
  fi
  if [[ $query != "$_xcode_logs_query" ]]; then
    _xcode_logs_notice=''
    _ZLE_PICKER_INSPECT_OFFSET=0
    _ZLE_PICKER_DOCUMENT_OFFSETS[logs]=0 _ZLE_PICKER_DOCUMENT_ROWS[logs]=0
    _ZLE_PICKER_DOCUMENT_WIDTHS[logs]=0
  fi
  _xcode_logs_query=$query
  _xcode_logs_status
  REPLY=$changed
}

_xcode_logs_idle() {
  emulate -L zsh
  local before=$_ZLE_PICKER_BROWSE_LABEL
  local -i changed=0
  _xcode_run_read_sources
  if (( ${_ZLE_PICKER_DOCUMENT_FOLLOW:-1} == 1 && !${_ZLE_PICKER_GUIDE_ACTIVE:-0} )); then
    _xcode_run_output_snapshot
    _xcode_logs_trimmed=$_xcode_run_trimmed
    if [[ $REPLY != "$_xcode_logs_snapshot" ]]; then
      _xcode_logs_snapshot=$REPLY
      _xcode_logs_collect "$_xcode_logs_query" 0
      changed=$REPLY
    fi
  fi
  _xcode_logs_status
  (( changed )) || [[ $before != "$_ZLE_PICKER_BROWSE_LABEL" ]] && return 0
  (( _xcode_run_eof )) && [[ ${_xcode_run_unified_status:-} != following ]] && return 2
  return 1
}

_xcode_logs_options() {
  _zle_ui_view action _xcode_logs_options_view
}

_xcode_logs_options_view() {
  emulate -L zsh
  _ZLE_PICKER_TITLE='Xcode / Logs / Options'
  _ZLE_PICKER_SUBTITLE="$_xcode_logs_matches of $_xcode_logs_total captured lines"
  _ZLE_PICKER_BROWSE_LABEL='Actions use the logs displayed when Options opened'
  _ZLE_PICKER_QUERY_LABEL='Filter options' _ZLE_PICKER_COLLECTOR=_xcode_picker_collect
  _ZLE_PICKER_IDLE_CALLBACK=_xcode_run_capture_idle
  local -a _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=() _XCODE_PICKER_SEARCH=()
  if [[ -n $_xcode_logs_text && -n $_xcode_run_clipboard ]]; then
    _XCODE_PICKER_VALUES+=(copy)
    [[ -n $_xcode_logs_query ]] &&
      _XCODE_PICKER_LABELS+=("Copy filtered logs · $_xcode_logs_matches lines; return to Run") ||
      _XCODE_PICKER_LABELS+=("Copy all captured logs · $_xcode_logs_matches lines; return to Run")
  fi
  if (( _xcode_logs_follow )); then
    _XCODE_PICKER_VALUES+=(pause)
    _XCODE_PICKER_LABELS+=('Pause display · Keep this reading position')
  fi
  _XCODE_PICKER_VALUES+=(last first)
  _XCODE_PICKER_LABELS+=('Follow latest · Show new output automatically'
    'Go to beginning · Pause and read the first matching line')
  if [[ -n $_xcode_logs_query ]]; then
    _XCODE_PICKER_VALUES+=(clear)
    _XCODE_PICKER_LABELS+=('Clear filter · Show all captured lines')
  fi
  _XCODE_PICKER_VALUES+=(back)
  _XCODE_PICKER_LABELS+=('Return to Run · Keep the app running')
  _ZLE_PICKER_ACTION_CONTEXT="CAPTURED LOGS"$'\n'"$_xcode_logs_matches of $_xcode_logs_total lines"$'\n\nThe app remains running while you read.'
  local -i index=0
  local value='' label='' detail=''
  for (( index=1; index<=${#_XCODE_PICKER_VALUES}; ++index )); do
    value=$_XCODE_PICKER_VALUES[index] label=$_XCODE_PICKER_LABELS[index]
    detail=${label#* · } label=${label%% · *}
    _XCODE_PICKER_LABELS[index]=$label
    _XCODE_PICKER_SEARCH[index]="$label $detail"
    _ZLE_PICKER_DESCRIPTIONS[$value]=$detail
    _ZLE_PICKER_INSPECT_TEXTS[$value]=$detail
    _ZLE_PICKER_ACCEPT_LABELS[$value]=${label:l}
  done
  _zle_picker_loop '' 10
}

_xcode_logs_reader() {
  _zle_ui_view reader _xcode_logs_reader_view
}

_xcode_logs_reader_view() {
  emulate -L zsh
  _ZLE_PICKER_TITLE='Xcode / Logs' _ZLE_PICKER_BROWSE_LABEL=''
  _ZLE_PICKER_QUERY_LABEL='Filter log lines' _ZLE_PICKER_COLLECTOR=_xcode_logs_collect
  _ZLE_PICKER_INSPECT_ACTION=options
  _ZLE_PICKER_INSPECT_FIXED_KEY=logs _ZLE_PICKER_DOCUMENT_KEY=logs
  _ZLE_PICKER_DOCUMENT_TITLE='App logs'
  _ZLE_PICKER_INSPECT_TITLE='App logs' _ZLE_PICKER_IDLE_CALLBACK=_xcode_logs_idle
  # Capture does not depend on viewport geometry. Publish once per idle frame
  # instead of preparing a second tail before the first can reach the display.
  _ZLE_PICKER_IDLE_PREPAINT=0
  _ZLE_PICKER_DOCUMENT_FOLLOW=${_xcode_logs_follow:-1}
  _zle_picker_start_focus=1
  local -a _ZLE_PICKER_DOCUMENT_LINES=() _ZLE_PICKER_DOCUMENT_ROLES=()
  _ZLE_PICKER_GUIDE_CONTEXT=('Filter: case-insensitive literal substring in each captured line.'
    'New matching output appears automatically while following live.'
    'Scroll up to pause; return to the bottom or choose Follow latest to resume.'
    'Copy uses complete displayed matching source lines, including offscreen text.'
    'Options and the guide keep displayed text stable while capture continues.')
  local -A _ZLE_PICKER_DOCUMENT_OFFSETS=(logs "${_xcode_logs_offset:-100000}")
  local -A _ZLE_PICKER_DOCUMENT_ROWS=(logs "${_xcode_logs_row:-0}")
  local -A _ZLE_PICKER_DOCUMENT_WIDTHS=(logs "${_xcode_logs_width:-0}")
  local -A _ZLE_PICKER_DOCUMENT_SYNTAX=()
  _ZLE_PICKER_INSPECT_TEXTS=(logs '')
  local _xcode_logs_text='' action=''
  local -i _xcode_logs_total=0 _xcode_logs_matches=0 result=0
  while true; do
    if (( _ZLE_PICKER_DOCUMENT_FOLLOW == 1 )); then
      _xcode_logs_capture
    fi
    _ZLE_PICKER_DOCUMENT_OFFSETS[logs]=${_xcode_logs_offset:-100000}
    _ZLE_PICKER_DOCUMENT_ROWS[logs]=${_xcode_logs_row:-0}
    _ZLE_PICKER_DOCUMENT_WIDTHS[logs]=${_xcode_logs_width:-0}
    _zle_picker_loop "$_xcode_logs_query" 20
    result=$?
    _xcode_logs_follow=$_ZLE_PICKER_DOCUMENT_FOLLOW
    _xcode_logs_query=${_ZLE_PICKER_BOOKMARK[1]-$_xcode_logs_query}
    _xcode_logs_offset=${_ZLE_PICKER_DOCUMENT_OFFSETS[logs]:-0}
    _xcode_logs_row=${_ZLE_PICKER_DOCUMENT_ROWS[logs]:-0}
    _xcode_logs_width=${_ZLE_PICKER_DOCUMENT_WIDTHS[logs]:-0}
    (( result == 0 )) || return $result
    action=$_ZLE_PICKER_ACTION
    if [[ $action == select ]]; then
      _xcode_logs_options
      result=$?
      (( result > 1 )) && return $result
      (( result == 1 )) && continue
      action=$_ZLE_PICKER_SELECTED_VALUE
    fi
    case $action in
      copy)
        [[ -n $_xcode_logs_text && -n $_xcode_run_clipboard ]] || continue
        _xcode_logs_copy_payload=$_xcode_logs_text _xcode_logs_copy_count=$_xcode_logs_matches
        _ZLE_PICKER_SELECTED_VALUE=copy-logs
        return 0 ;;
      pause) _ZLE_PICKER_DOCUMENT_FOLLOW=0 ;;
      first)
        _ZLE_PICKER_DOCUMENT_FOLLOW=0
        _xcode_logs_offset=0 _xcode_logs_row=0 _xcode_logs_width=0 ;;
      last) _ZLE_PICKER_DOCUMENT_FOLLOW=1 ;;
      clear) _xcode_logs_query='' _xcode_logs_offset=0 _xcode_logs_row=0 _xcode_logs_width=0 ;;
      back) return 1 ;;
    esac
  done
}

# The Run owner invokes this only after the screen session has restored the
# terminal. The payload is frozen by explicit acceptance, never a fresh capture.
_xcode_logs_copy() {
  emulate -L zsh
  if [[ -z $_xcode_logs_copy_payload || ! -x $_xcode_run_clipboard || -d $_xcode_run_clipboard ]]; then
    _xcode_logs_notice='Copy failed: clipboard unavailable'
    return 1
  fi
  if ! print -rn -- "$_xcode_logs_copy_payload" | command "$_xcode_run_clipboard"; then
    _xcode_logs_notice='Copy failed: clipboard write failed'
    return 1
  fi
  _xcode_logs_notice="Copied $_xcode_logs_copy_count captured lines"
}

_xcode_run_controller() {
  _zle_ui_view choice _xcode_run_view
}

_xcode_run_view() {
  emulate -L zsh
  # The shared renderer retains its last frame. Scope this copy so app output
  # cannot survive in shell globals after the run view closes.
  local -a _ZLE_PICKER_DISPLAY=()
  _ZLE_PICKER_TITLE='Xcode / Run'
  _ZLE_PICKER_QUERY_LABEL='Filter actions' _ZLE_PICKER_INSPECT_TITLE='App output'
  _ZLE_PICKER_INSPECT_FIXED_KEY=run
  _ZLE_PICKER_INSPECT_ACTION=stop _ZLE_PICKER_CANCEL_LABEL=stop
  _ZLE_PICKER_BROWSE_LABEL='Enter applies selected action · Escape stops run'
  [[ -n ${_xcode_logs_notice:-} ]] && _ZLE_PICKER_BROWSE_LABEL="$_xcode_logs_notice · Escape stops run"
  _ZLE_PICKER_COLLECTOR=_xcode_picker_collect
  _ZLE_PICKER_IDLE_CALLBACK=_xcode_run_idle
  _ZLE_PICKER_INSPECT_CLIP_LINES=1
  _ZLE_PICKER_INSPECT_STACKED=1
  local -i result=0 selected=${_xcode_run_actions_bookmark[2]:-1}
  local -i _xcode_run_open_reader=0 _xcode_run_empty_snapshot=1
  local query=${_xcode_run_actions_bookmark[1]-} _xcode_run_empty_output=$'Waiting for app output.\nstdout/stderr + Logger/os_log'
  [[ ${_xcode_run_unified_status:-} == following ]] ||
    _xcode_run_empty_output=$'Waiting for app stdout/stderr.\nLogger capture unavailable.'
  local -a _XCODE_PICKER_VALUES=(stop read)
  local -a _XCODE_PICKER_LABELS=('Stop app and close' 'Read output · Full view, filter and copy')
  local -a _XCODE_PICKER_SEARCH=()
  _ZLE_PICKER_PASSIVE_LINES=(
    'Output follows automatically; Read output opens the full log view.'
    'stdout/stderr + Logger scoped to this installed app executable.')
  _ZLE_PICKER_INSPECT_TEXTS=(run "$_xcode_run_empty_output")
  _ZLE_PICKER_ACCEPT_LABELS=(stop stop read 'read output')
  if [[ -n $_xcode_run_lldb && -n $_xcode_run_identity ]]; then
    _XCODE_PICKER_VALUES+=(lldb)
    _XCODE_PICKER_LABELS+=('Enter LLDB · Stop app when debugger exits')
    _ZLE_PICKER_ACCEPT_LABELS[lldb]='enter LLDB'
  elif [[ -z $_xcode_run_identity ]]; then
    _ZLE_PICKER_PASSIVE_LINES+=('Process identity unavailable; check or stop the app in Simulator.')
  else
    _ZLE_PICKER_PASSIVE_LINES+=('LLDB unavailable.')
  fi
  while true; do
    _xcode_run_publish=1
    _ZLE_PICKER_DIGIT_SELECT=1
    _zle_picker_loop "$query" 10 "$selected"
    result=$?
    (( result == 0 )) || return $result
    [[ $_ZLE_PICKER_SELECTED_VALUE == read ]] || return 0
    query=${_ZLE_PICKER_BOOKMARK[1]-}
    selected=${_ZLE_PICKER_BOOKMARK[2]:-2}
    _xcode_run_actions_bookmark=("$query" "$selected" "${_ZLE_PICKER_BOOKMARK[3]:-0}")
    (( ${_xcode_logs_captured:-0} )) || _xcode_logs_capture
    _xcode_logs_reader
    result=$?
    (( result == 0 || result > 1 )) && return $result
    _zle_picker_start_focus=0
  done
}

# LLDB owns the real terminal. Drain output during that handoff so a full pipe
# cannot stall the debuggee; do not echo untrusted app control bytes into LLDB.
_xcode_run_drain() {
  emulate -L zsh
  local chunk='' result=0
  while true; do
    sysread -i $_xcode_run_fd -s 8192 -t 1 chunk 2>/dev/null
    result=$?
    (( result == 0 || result == 4 )) || return 0
  done
}

# The caller revalidates the launched process and restores the screen first.
# Keep native LLDB input, completion, signals and exit status; style only its
# supported presentation settings, without loading user/project init scripts.
_xcode_run_debugger() {
  emulate -L zsh
  local -a arguments=(--no-use-colors) reply=()
  if [[ -t 1 && -t 2 && -n $TERM && $TERM != dumb && -z ${NO_COLOR:-} ]] &&
     zmodload -F zsh/terminfo p:terminfo 2>/dev/null &&
     (( ${terminfo[colors]:-0} >= 8 )); then
    arguments=(
      --one-line-before-file 'settings set --exists use-color true'
      --one-line-before-file 'settings set --exists highlight-source true'
    )
    if (( ${terminfo[colors]:-0} >= 256 && ${+functions[_output_lldb_color_arguments]} )); then
      _output_lldb_color_arguments
      arguments+=("${reply[@]}")
    fi
  fi
  command "$1" --no-lldbinit --source-quietly --one-line-before-file \
    'settings set target.load-script-from-symbol-file false' \
    "${arguments[@]}" --attach-pid "$2"
}

_xcode_run_live() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  unsetopt BG_NICE NOTIFY
  local identifier=$1 bundle=$2 _xcode_run_context=$3 REPLY=''
  [[ $identifier == [[:alnum:]][[:alnum:].-]# &&
     $bundle == [[:alnum:]][[:alnum:].-]# ]] || return 2
  zmodload zsh/system || return 1
  local _xcode_run_dir='' _xcode_run_fifo='' _xcode_run_log=''
  local _xcode_run_root='' _xcode_run_tmp='' guest_fifo=''
  local _XCODE_CAPTURE='' _XCODE_CAPTURE_ERROR=''
  local _xcode_run_identity='' _xcode_run_lldb='' request='' monitor_enabled=''
  local _xcode_run_unified_fifo='' _xcode_run_unified_status=''
  local _xcode_run_clipboard='' _xcode_logs_snapshot='' _xcode_logs_query='' _xcode_logs_notice=''
  local _xcode_logs_copy_payload=''
  local -a _xcode_run_actions_bookmark=('' 1 0)
  # Filters can contain app data. Keep shared input-loop return state inside
  # this run even when an interrupt exits directly from the full reader.
  local -a _ZLE_PICKER_BOOKMARK=()
  local -i _ZLE_PICKER_BOOKMARK_FOCUS=0
  local -i _xcode_logs_captured=0 _xcode_logs_trimmed=0 _xcode_logs_offset=100000 _xcode_logs_follow=1
  local -i _xcode_logs_row=0 _xcode_logs_width=0 _xcode_logs_copy_count=0
  local -a _xcode_run_pending=('' '')
  local -i _xcode_run_unified_fd=-1 _xcode_run_logger=0 _xcode_run_stdout_seen=0
  local -i _xcode_run_fd=-1 writer=-1 _xcode_run_pid=0 drainer=0
  local -i _xcode_run_trimmed=0 _xcode_run_eof=0 _xcode_run_publish=1
  local -i _xcode_run_read_error=0
  local -i result=0 screen_result=0
  # simctl interprets output paths inside this Simulator's data filesystem.
  # Resolve only the selected device; host TMPDIR is not its guest /tmp.
  _xcode_capture_command xcrun simctl getenv "$identifier" SIMULATOR_SHARED_RESOURCES_DIRECTORY || {
    print -u2 -r -- 'xcode: cannot resolve the selected Simulator output directory'
    return 1
  }
  _xcode_run_root=$_XCODE_CAPTURE
  [[ $_xcode_run_root == /* && $_xcode_run_root != *[[:cntrl:]]* &&
     $_xcode_run_root == ${_xcode_run_root:a} &&
     ${#_xcode_run_root} -le 4096 && -d $_xcode_run_root && ! -L $_xcode_run_root &&
     -d $_xcode_run_root/tmp && ! -L $_xcode_run_root/tmp ]] || {
    print -u2 -r -- 'xcode: selected Simulator has no safe temporary output directory'
    return 1
  }
  _xcode_run_root=${_xcode_run_root:A}
  _xcode_run_tmp=${_xcode_run_root}/tmp
  [[ ${_xcode_run_tmp:A:h} == "$_xcode_run_root" ]] || return 1
  _xcode_run_dir=$(command mktemp -d "$_xcode_run_tmp/compozsh-xcode-run.XXXXXXXX") || return 1
  _xcode_run_fifo="$_xcode_run_dir/output"
  guest_fifo="/tmp/${_xcode_run_dir:t}/output"
  {
    command mkfifo -m 600 -- "$_xcode_run_fifo" || return 1
    sysopen -r -o nonblock,cloexec -u _xcode_run_fd "$_xcode_run_fifo" || return 1
    # Keep an initial writer until simctl has opened the app's output handles.
    sysopen -w -o nonblock,cloexec -u writer "$_xcode_run_fifo" || return 1
    _xcode_run_logs_start "$identifier" "$bundle" || _xcode_run_logs_stop
    local -x SIMCTL_CHILD_NSUnbufferedIO=YES
    _xcode_capture_command xcrun simctl launch "--stdout=$guest_fifo" \
      "--stderr=$guest_fifo" --terminate-running-process "$identifier" "$bundle" || {
      result=$?
      print -u2 -r -- "xcode: ${(V)_XCODE_CAPTURE_ERROR}"
      return $result
    }
    exec {writer}>&-
    writer=-1
    request=${_XCODE_CAPTURE#"$bundle: "}
    [[ $_XCODE_CAPTURE == "$bundle: $request" && $request == <-> &&
       ${#request} -le 10 ]] && (( request > 1 )) || {
      print -u2 -r -- 'xcode: launch returned no exact PID; manage the app in Simulator'
      return 1
    }
    _xcode_run_pid=$request
    _xcode_run_identity "$_xcode_run_pid" && _xcode_run_identity=$REPLY
    _xcode_run_lldb=$(command xcrun --find lldb 2>/dev/null)
    [[ $_xcode_run_lldb == /* && -x $_xcode_run_lldb && ! -d $_xcode_run_lldb ]] || _xcode_run_lldb=''
    _xcode_run_clipboard=$(whence -p pbcopy 2>/dev/null)
    while true; do
      _zle_picker_run 20 '' 1 0 _xcode_run_controller
      screen_result=$?
      request=$_ZLE_PICKER_SELECTED_VALUE
      (( screen_result == 0 )) && [[ $request == copy-logs ]] || break
      # Screen restoration precedes the clipboard effect; the app and observer
      # keep their existing owner as Run reopens with the frozen reader bookmark.
      _xcode_logs_copy || result=1
      _xcode_logs_copy_payload=''
    done
    _xcode_run_logs_stop
    if (( screen_result == 0 )) && [[ $request == lldb ]]; then
      if [[ -x $_xcode_run_lldb ]] && _xcode_run_is_current; then
        # Keep the drainer alive even if the app closes stdout while debugging.
        # Its owned PID then remains a cleanup target until we reap it.
        sysopen -w -o nonblock,cloexec -u writer "$_xcode_run_fifo" || return 1
        # The pipe drainer needs no terminal job. Restore the caller's job
        # control before starting LLDB so debugger interrupts remain native.
        monitor_enabled=$options[monitor]
        unsetopt MONITOR
        _xcode_run_drain &
        drainer=$!
        [[ $monitor_enabled == on ]] && setopt MONITOR
        print -r -- 'LLDB: continue resumes; quit returns and stops this run. App output is discarded while debugging.'
        _xcode_run_debugger "$_xcode_run_lldb" "$_xcode_run_pid" || result=$?
      else
        print -u2 -r -- 'xcode: the launched process ended or changed, or LLDB is unavailable'
        result=1
      fi
    elif (( screen_result > 1 )); then
      result=$screen_result
    fi
  } always {
    _xcode_run_logs_stop
    # Stop only the still-identical launched process on this exact Simulator.
    # Identity revalidation narrows, but cannot atomically eliminate, exit races.
    if (( _xcode_run_pid > 1 )); then
      if _xcode_run_is_current; then
        command xcrun simctl terminate "$identifier" "$bundle" || {
          print -u2 -r -- 'xcode: could not stop the app; stop it in Simulator'
          (( result == 0 )) && result=1
        }
      else
        print -u2 -r -- 'xcode: could not verify the launched process; check or stop the app in Simulator'
        (( result == 0 )) && result=1
      fi
    fi
    if (( drainer > 0 )); then
      kill -KILL $drainer 2>/dev/null
      wait $drainer 2>/dev/null
    fi
    (( writer >= 0 )) && exec {writer}>&-
    (( _xcode_run_fd >= 0 )) && exec {_xcode_run_fd}<&-
    (( _xcode_run_unified_fd >= 0 )) && exec {_xcode_run_unified_fd}<&-
    if [[ ${_xcode_run_dir:t} == compozsh-xcode-run.* &&
          ${_xcode_run_dir:h:A} == "$_xcode_run_tmp" && ! -L $_xcode_run_dir ]]; then
      command rm -f -- "$_xcode_run_fifo"
      [[ -n $_xcode_run_unified_fifo ]] && command rm -f -- "$_xcode_run_unified_fifo"
      command rmdir -- "$_xcode_run_dir"
    fi
  }
  return $result
}

# Workspace menus own a small source array but reuse the shared UI renderer,
# screen lifecycle, focus language, filtering and resize behavior.
_xcode_picker_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local query=$1 raw_limit=$2 value='' label='' searchable='' pattern=''
  local -a reply=()
  local -i limit=$raw_limit index=0
  typeset -ga _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
  [[ $limit == <-> ]] || limit=10
  if [[ -n $query ]]; then
    _matching_compile "$query" || return
    pattern=${reply[2]}
  fi
  for (( index = 1; index <= ${#_XCODE_PICKER_VALUES}; ++index )); do
    value=${_XCODE_PICKER_VALUES[index]}
    label=${_XCODE_PICKER_LABELS[index]}
    searchable="${label} ${_XCODE_PICKER_SEARCH[index]-}"
    [[ -z $query || $searchable == ${~pattern} ]] || continue
    _ZLE_PICKER_RESULTS+=("$value")
    _ZLE_PICKER_LABELS+=("$label")
    (( ${#_ZLE_PICKER_RESULTS} >= limit )) && break
  done
}

_xcode_choose() {
  local view_kind=choice
  [[ ${4:-} == options ]] && view_kind=action
  _zle_ui_view "$view_kind" _xcode_choice_view "$@"
}

_xcode_choice_view() {
  emulate -L zsh
  local title=$1 subtitle=$2 query_label=$3
  local label_kind=${4:-} label_prefix=''
  local initial_query=${5:-} initial_value=${6:-} value=''
  local -i initial_index=1
  local -a _XCODE_PICKER_LABELS=("${_XCODE_PICKER_LABELS[@]}")
  local -a _XCODE_PICKER_SEARCH=("${_XCODE_PICKER_SEARCH[@]}")
  _ZLE_PICKER_TITLE=$title _ZLE_PICKER_SUBTITLE=$subtitle
  _ZLE_PICKER_QUERY_LABEL=$query_label
  _ZLE_PICKER_BROWSE_LABEL='read-only selection'
  _ZLE_PICKER_COLLECTOR=_xcode_picker_collect
  local -i index=0
  for (( index = 1; index <= ${#_XCODE_PICKER_VALUES}; ++index )); do
    _ZLE_PICKER_INSPECT_TEXTS[${_XCODE_PICKER_VALUES[index]}]=${_XCODE_PICKER_DETAILS[index]-}
    if [[ $label_kind == options ]]; then
      # Only Actions owns this separator: names in other views stay literal.
      label_prefix=${_XCODE_PICKER_LABELS[index]%% · *}
      value=${_XCODE_PICKER_VALUES[index]}
      _XCODE_PICKER_SEARCH[index]+=" ${_XCODE_PICKER_LABELS[index]}"
      _ZLE_PICKER_DESCRIPTIONS[$value]=${_XCODE_PICKER_LABELS[index]#* · }
      _XCODE_PICKER_LABELS[index]=$label_prefix
      case $value in
        (scheme|destination) _ZLE_PICKER_ACCEPT_LABELS[$value]="choose $value" ;;
        (refresh-destinations) _ZLE_PICKER_ACCEPT_LABELS[$value]=refresh ;;
        (*) _ZLE_PICKER_ACCEPT_LABELS[$value]=${label_prefix:l} ;;
      esac
      _ZLE_PICKER_LABEL_HIGHLIGHTS[${_XCODE_PICKER_VALUES[index]}]="0:${#label_prefix}:picker-header"
    fi
  done
  if [[ $label_kind == options ]]; then
    _ZLE_PICKER_ACTION_CONTEXT=${_XCODE_ACTION_CONTEXT:-$subtitle}
    _ZLE_PICKER_BROWSE_LABEL='Choose an action · inspect before applying'
  fi
  if [[ -n $initial_value ]]; then
    _xcode_picker_collect "$initial_query" 1000
    initial_index=${_ZLE_PICKER_RESULTS[(Ie)$initial_value]}
    (( initial_index > 0 )) || initial_index=1
  fi
  _zle_picker_start_focus=${8:-0}
  _zle_picker_loop "$initial_query" 10 $initial_index "${7:-0}"
}

_xcode_test_result_choose() {
  _zle_ui_view notice _xcode_test_result_view "$@"
}

_xcode_test_result_view() {
  emulate -L zsh
  local title=$1 subtitle=$2
  _ZLE_PICKER_TITLE=$title _ZLE_PICKER_SUBTITLE=$subtitle
  _ZLE_PICKER_QUERY_LABEL='Filter failures'
  _ZLE_PICKER_INSPECT_TITLE='Test result'
  _ZLE_PICKER_INSPECT_ACTION=done _ZLE_PICKER_CANCEL_LABEL=done
  _ZLE_PICKER_BROWSE_LABEL='captured Xcode result · source locations from xcresult'
  _ZLE_PICKER_COLLECTOR=_xcode_picker_collect
  _ZLE_PICKER_PASSIVE_LINES=("${_XCODE_TEST_PASSIVE_LINES[@]}")
  _ZLE_PICKER_PASSIVE_STYLES=("${_XCODE_TEST_PASSIVE_STYLES[@]}")
  local -i index=0
  for (( index = 1; index <= ${#_XCODE_PICKER_VALUES}; ++index )); do
    _ZLE_PICKER_INSPECT_TEXTS[${_XCODE_PICKER_VALUES[index]}]=${_XCODE_PICKER_DETAILS[index]-}
    if [[ ${_XCODE_PICKER_VALUES[index]} == copy-report ]]; then
      _ZLE_PICKER_ACCEPT_LABELS[${_XCODE_PICKER_VALUES[index]}]='copy report and done'
    fi
    [[ -n ${_XCODE_PICKER_HIGHLIGHTS[index]-} ]] &&
      _ZLE_PICKER_LABEL_HIGHLIGHTS[${_XCODE_PICKER_VALUES[index]}]=${_XCODE_PICKER_HIGHLIGHTS[index]}
  done
  _zle_picker_loop '' 10
}

_xcode_test_result_screen() {
  emulate -L zsh
  local -i action_status=${1:-1} index=0
  local title='Xcode Test · Failed' subtitle=''
  local name='' target='' reason='' files='' first_file='' label='' details=''
  local overview='Test results' count_label=''
  local -a _XCODE_PICKER_VALUES=(done) _XCODE_PICKER_LABELS=(Done)
  local -a _XCODE_PICKER_HIGHLIGHTS=('') _XCODE_PICKER_SEARCH=(done)
  local -a _XCODE_PICKER_DETAILS=('')
  local -a _XCODE_TEST_PASSIVE_LINES=() _XCODE_TEST_PASSIVE_STYLES=()

  if [[ -n ${_XCODE_TEST_CLIPBOARD_BINARY:-} &&
        -x ${_XCODE_TEST_CLIPBOARD_BINARY:-} ]]; then
    _XCODE_PICKER_VALUES+=(copy-report)
    _XCODE_PICKER_LABELS+=('Copy report and done')
    _XCODE_PICKER_HIGHLIGHTS+=('')
    _XCODE_PICKER_SEARCH+=('copy report clipboard done failures files')
    _XCODE_PICKER_DETAILS+=(
      'Copy the captured test report to the host clipboard and close.'$'\n\n''Includes the result, native status, test mode, scheme, destination, totals, failed-test names, targets, identifiers, reasons, involved files, build errors, and capture limits.'
    )
  fi

  count_label="${_XCODE_TEST_PASSED} passed · ${_XCODE_TEST_FAILED} failed"
  (( _XCODE_TEST_SKIPPED )) && count_label+=" · ${_XCODE_TEST_SKIPPED} skipped"
  (( _XCODE_TEST_EXPECTED_FAILURES )) &&
    count_label+=" · ${_XCODE_TEST_EXPECTED_FAILURES} expected failures"
  overview+=$'\n'"Mode · ${_XCODE_TEST_MODE:-Incremental Test}"
  overview+=$'\n'"$count_label"

  if (( action_status == 0 )) && [[ $_XCODE_TEST_RESULT == Passed ]]; then
    title='Xcode Test · Passed'
    subtitle="$_XCODE_TEST_SCHEME · $_XCODE_TEST_DESTINATION · DONE"
    if [[ -n $_XCODE_TEST_CAPTURE_ERROR ]]; then
      label='Test action passed · structured totals unavailable'
    elif (( _XCODE_TEST_TOTAL )); then
      label="All tests passed · ${_XCODE_TEST_PASSED} of ${_XCODE_TEST_TOTAL} passed"
    else
      label='Test action passed · Xcode reported no tests'
    fi
    _XCODE_TEST_PASSIVE_LINES+=("$label")
    _XCODE_TEST_PASSIVE_STYLES+=(picker-success)
    if [[ -n $_XCODE_TEST_CAPTURE_ERROR ]]; then
      _XCODE_TEST_PASSIVE_LINES+=("Result details limited · $_XCODE_TEST_CAPTURE_ERROR")
      _XCODE_TEST_PASSIVE_STYLES+=(picker-warning)
      overview+=$'\n\n''Limits'$'\n'"  $_XCODE_TEST_CAPTURE_ERROR"
    fi
    _XCODE_PICKER_HIGHLIGHTS[1]="0:${#_XCODE_PICKER_LABELS[1]}:picker-success"
    _XCODE_PICKER_DETAILS[1]="$overview"$'\n\n''Outcome'$'\n'"  $label"
    _xcode_test_result_choose "$title" "$subtitle"
    return $?
  fi

  subtitle="$_XCODE_TEST_SCHEME · $_XCODE_TEST_DESTINATION · FAILED"
  overview+=$'\n\n''Failures'
  for (( index = 1; index <= ${#_XCODE_TEST_FAILURE_NAMES}; ++index )); do
    name=${_XCODE_TEST_FAILURE_NAMES[index]}
    target=${_XCODE_TEST_FAILURE_TARGETS[index]}
    reason=${_XCODE_TEST_FAILURE_TEXTS[index]}
    files=${_XCODE_TEST_FAILURE_FILES[index]}
    first_file=${files%%$'\n'*}
    label="Test failed · $name"
    [[ -n $first_file ]] && label+=" · ${first_file:t}"
    details="$name"
    [[ -n $target ]] && details+=$'\n'"Target · $target"
    details+=$'\n\n''Failure'$'\n'"  $reason"$'\n\n''Involved files'
    if [[ -n $files ]]; then
      details+=$'\n'"  ${files//$'\n'/$'\n  '}"
    else
      details+=$'\n''  Xcode reported no source location for this failure.'
    fi
    _XCODE_PICKER_VALUES+=("failure:$index")
    _XCODE_PICKER_LABELS+=("$label")
    _XCODE_PICKER_HIGHLIGHTS+=("0:${#label}:picker-error")
    _XCODE_PICKER_SEARCH+=("$name $target $reason $files")
    _XCODE_PICKER_DETAILS+=("$details")
    overview+=$'\n'"  $name"
    [[ -n $files ]] && overview+=$'\n'"    ${files//$'\n'/$'\n    '}"
  done
  for (( index = 1; index <= ${#_XCODE_TEST_BUILD_NAMES}; ++index )); do
    name=${_XCODE_TEST_BUILD_NAMES[index]}
    reason=${_XCODE_TEST_BUILD_TEXTS[index]}
    files=${_XCODE_TEST_BUILD_FILES[index]}
    label="Build failed · $name"
    [[ -n $files ]] && label+=" · ${files:t}"
    details="$name"$'\n\n''Failure'$'\n'"  $reason"$'\n\n''Involved files'$'\n'"  ${files:-Xcode reported no source location for this issue.}"
    _XCODE_PICKER_VALUES+=("build:$index")
    _XCODE_PICKER_LABELS+=("$label")
    _XCODE_PICKER_HIGHLIGHTS+=("0:${#label}:picker-error")
    _XCODE_PICKER_SEARCH+=("$name $reason $files")
    _XCODE_PICKER_DETAILS+=("$details")
    overview+=$'\n'"  $name"
    [[ -n $files ]] && overview+=$'\n'"    $files"
  done
  if (( ${#_XCODE_TEST_FAILURE_NAMES} + ${#_XCODE_TEST_BUILD_NAMES} == 0 )); then
    label='Test action failed · Xcode reported no structured failure details'
    _XCODE_TEST_PASSIVE_LINES+=("$label")
    _XCODE_TEST_PASSIVE_STYLES+=(picker-error)
    overview+=$'\n''  Xcode reported no structured test or build issue.'
  fi
  if [[ -n $_XCODE_TEST_CAPTURE_ERROR ]]; then
    _XCODE_TEST_PASSIVE_LINES+=("Result details limited · $_XCODE_TEST_CAPTURE_ERROR")
    _XCODE_TEST_PASSIVE_STYLES+=(picker-warning)
    overview+=$'\n\n''Limits'$'\n'"  $_XCODE_TEST_CAPTURE_ERROR"
  fi
  _XCODE_PICKER_DETAILS[1]=$overview
  _xcode_test_result_choose "$title" "$subtitle"
}

_xcode_test_result_controller() {
  _xcode_test_result_screen "${_XCODE_TEST_ACTION_STATUS:-1}"
}

_xcode_test_execute() {
  emulate -L zsh
  local kind=$1 container=$2 scheme=$3 platform=$4 identifier=$5 destination=$6
  local requested_mode=${7:-test}
  local temp_root=${TMPDIR:-/tmp} result_dir='' bundle=''
  local -i action_status=0
  case $requested_mode in
    (test) _XCODE_TEST_MODE='Incremental Test' ;;
    (rebuild-test) _XCODE_TEST_MODE='Rebuild & Test' ;;
    (*) return 2 ;;
  esac
  _XCODE_TEST_CONTAINER=$container _XCODE_TEST_SCHEME=$scheme
  _XCODE_TEST_PLATFORM=$platform _XCODE_TEST_DESTINATION_ID=$identifier
  _XCODE_TEST_DESTINATION=$destination
  _xcode_test_result_reset
  _xcode_action_command "$kind" "$container" "$scheme" "$platform" "$identifier" \
    "$requested_mode" || return
  result_dir=$(command mktemp -d "${temp_root%/}/compozsh-xcode-test.XXXXXX") || result_dir=''
  if [[ -n $result_dir ]]; then
    bundle="$result_dir/Test.xcresult"
    _XCODE_COMMAND=("${_XCODE_COMMAND[@][1,-2]}" -collect-test-diagnostics never \
      -resultBundlePath "$bundle" test)
  else
    _XCODE_TEST_CAPTURE_ERROR='cannot create a temporary Xcode result directory'
  fi
  {
    command "${_XCODE_COMMAND[@]}"
    action_status=$?
    if [[ -n $bundle && -d $result_dir && ! -L $result_dir &&
          -d $bundle && ! -L $bundle ]]; then
      _xcode_test_result_capture "$bundle" $action_status
    else
      (( action_status == 0 )) && _XCODE_TEST_RESULT=Passed || _XCODE_TEST_RESULT=Failed
      [[ -n $_XCODE_TEST_CAPTURE_ERROR ]] ||
        _XCODE_TEST_CAPTURE_ERROR='Xcode produced no readable result bundle'
    fi
  } always {
    if [[ -n $result_dir && -d $result_dir &&
          ${result_dir:t} == compozsh-xcode-test.* &&
          ${result_dir:h:A} == ${temp_root:A} ]]; then
      command rm -rf -- "$result_dir"
    fi
  }
  return $action_status
}

_xcode_workspace_controller() {
  emulate -L zsh
  local kind=${_XCODE_CONTAINER_KINDS[1]} container=${_XCODE_CONTAINERS[1]}
  local scheme='' platform='' identifier='' destination='' selected=''
  local previous_identifier=''
  local -i result=0 index=0 container_index=1 scheme_index=1 destination_index=1
  local -a _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=()
  local -a _XCODE_PICKER_SEARCH=() _XCODE_PICKER_DETAILS=()
  local -a _XCODE_DESTINATION_CACHE_SCHEMES=()
  local -a _XCODE_DESTINATION_CACHE_IDS=()
  local -a _XCODE_DESTINATION_CACHE_PLATFORMS=()
  local -a _XCODE_DESTINATION_CACHE_NAMES=()
  local _XCODE_ACTION_CONTEXT='' action_query='' action_value=''
  local -i action_offset=0 action_focus=0

  if (( ${#_XCODE_CONTAINERS} > 1 )); then
    _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=() _XCODE_PICKER_SEARCH=() _XCODE_PICKER_DETAILS=()
    for (( index = 1; index <= ${#_XCODE_CONTAINERS}; ++index )); do
      _XCODE_PICKER_VALUES+=("$index")
      _XCODE_PICKER_LABELS+=("${_XCODE_CONTAINERS[index]:t} · ${_XCODE_CONTAINER_KINDS[index]}")
      _XCODE_PICKER_SEARCH+=("${_XCODE_CONTAINERS[index]}")
      _XCODE_PICKER_DETAILS+=("${_XCODE_CONTAINERS[index]}"$'\n\nNearest literal Xcode container · read-only selection')
    done
    _xcode_choose 'Xcode / Container' 'Nearest project scope' 'Filter containers'
    result=$?
    (( result == 0 )) || return $result
    container_index=$_ZLE_PICKER_SELECTED_VALUE
    kind=${_XCODE_CONTAINER_KINDS[container_index]}
    container=${_XCODE_CONTAINERS[container_index]}
  fi

  _xcode_schemes_capture "$kind" "$container" || {
    _XCODE_WORKSPACE_ERROR=$_XCODE_CAPTURE_ERROR
    return 4
  }
  scheme=${_XCODE_SCHEMES[1]}
  _xcode_destinations_capture "$kind" "$container" "$scheme" || {
    _XCODE_WORKSPACE_ERROR=$_XCODE_CAPTURE_ERROR
    return 4
  }
  _xcode_destination_cache_store "$scheme" || :
  platform=${_XCODE_DESTINATION_PLATFORMS[1]}
  identifier=${_XCODE_DESTINATION_IDS[1]}
  destination=${_XCODE_DESTINATION_NAMES[1]}

  while true; do
    _XCODE_PICKER_VALUES=(scheme destination refresh-destinations build rebuild
      test rebuild-test analyze clean)
    _XCODE_PICKER_LABELS=(
      "Scheme · $scheme"
      "Destination · $destination"
      'Refresh destinations · Read Xcode again for this scheme'
      'Build · Incrementally compile changed products'
      'Rebuild · Clean selected products, then build'
      'Test · Incrementally build changed products, then run tests'
      'Rebuild & Test · Clean selected products, rebuild, then test'
      'Analyze · Run Xcode static analysis'
      'Clean · Remove selected-scheme build products')
    _XCODE_PICKER_SEARCH=(scheme destination 'refresh destinations devices runtimes'
      'build incremental changed modified products' 'rebuild clean build stale older source'
      'test incremental changed products' 'rebuild clean test stale older source' analyze clean)
    _XCODE_PICKER_DETAILS=(
      "$scheme"$'\n\nChoose one of Xcode’s shared schemes.'
      "$destination"$'\n'"$platform · $identifier"$'\n\nChoose an exact destination reported by Xcode.'
      'Refresh destinations'$'\n\nReplaces the current scheme’s in-memory snapshot with a fresh Xcode query. Use after devices or runtimes change.'
      'Build'$'\n\nAsks Xcode to incrementally compile changed products after this workspace closes. Project build scripts, package plugins and macros may execute.'
      'Rebuild'$'\n\nRuns Xcode clean and build for this scheme and destination after the workspace closes. This slower recovery is useful when a product appears to use older source; it preserves broader DerivedData and package caches.'
      'Test'$'\n\nAsks Xcode to incrementally rebuild changed products and run tests after this workspace closes. Keeps native output in the terminal, then reopens a result view with totals, failures, and involved files reported by Xcode.'
      'Rebuild & Test'$'\n\nRuns Xcode clean and test for this scheme and destination after the workspace closes. This slower recovery is useful when results appear to use older source; it preserves the broader DerivedData and package caches.'
      'Analyze'$'\n\nRuns Xcode static analysis after this workspace closes.'
      'Clean'$'\n\nRemoves build products for this scheme and destination after this workspace closes.')
    if [[ $platform == *Simulator ]]; then
      _XCODE_PICKER_VALUES+=(run rebuild-run)
      _XCODE_PICKER_LABELS+=(
        'Build & Run · Incrementally build and launch in Simulator'
        'Rebuild & Run · Clean, rebuild, and launch in Simulator')
      _XCODE_PICKER_SEARCH+=('simulator launch run incremental changed modified'
        'rebuild clean simulator launch stale older source')
      _XCODE_PICKER_DETAILS+=(
        'Build & Run'$'\n\nAsks Xcode to incrementally build changed products, then boots the selected Simulator, installs the app and launches it. Opens live app output with Stop and Enter LLDB actions. Escape stops this run. No physical-device launch.'
        'Rebuild & Run'$'\n\nRuns Xcode clean and build for this scheme and destination, then boots the selected Simulator, installs the app and opens live output with Stop and Enter LLDB actions. Escape stops this run. This is a slower stale-product recovery.')
    fi
    _XCODE_ACTION_CONTEXT="PROJECT"$'\n'"$container"$'\n\nSCHEME  '"$scheme"$'\nDESTINATION  '"$destination"$'\n'"$platform · $identifier"
    _xcode_choose 'Xcode / Actions' "${container:t} · $scheme · $destination" 'Filter actions' options \
      "$action_query" "$action_value" "$action_offset" "$action_focus"
    result=$?
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    action_query=${_ZLE_PICKER_BOOKMARK[1]-} action_value=$selected
    action_offset=${_ZLE_PICKER_BOOKMARK[3]:-0} action_focus=${_ZLE_PICKER_BOOKMARK_FOCUS:-0}
    case $selected in
      (scheme)
        _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=() _XCODE_PICKER_SEARCH=() _XCODE_PICKER_DETAILS=()
        for (( index = 1; index <= ${#_XCODE_SCHEMES}; ++index )); do
          _XCODE_PICKER_VALUES+=("$index") _XCODE_PICKER_LABELS+=("${_XCODE_SCHEMES[index]}")
          _XCODE_PICKER_SEARCH+=("${_XCODE_SCHEMES[index]}")
          _XCODE_PICKER_DETAILS+=("${_XCODE_SCHEMES[index]}"$'\n\nShared scheme reported by Xcode.')
        done
        _xcode_choose 'Xcode / Scheme' "${container:t}" 'Filter schemes'
        result=$?
        (( result == 1 )) && continue
        (( result == 0 )) || return $result
        scheme_index=$_ZLE_PICKER_SELECTED_VALUE
        scheme=${_XCODE_SCHEMES[scheme_index]}
        if ! _xcode_destination_cache_restore "$scheme"; then
          _xcode_destinations_capture "$kind" "$container" "$scheme" || {
            _XCODE_WORKSPACE_ERROR=$_XCODE_CAPTURE_ERROR
            return 4
          }
          _xcode_destination_cache_store "$scheme" || :
        fi
        destination_index=1
        platform=${_XCODE_DESTINATION_PLATFORMS[1]}
        identifier=${_XCODE_DESTINATION_IDS[1]}
        destination=${_XCODE_DESTINATION_NAMES[1]} ;;
      (destination)
        _XCODE_PICKER_VALUES=() _XCODE_PICKER_LABELS=() _XCODE_PICKER_SEARCH=() _XCODE_PICKER_DETAILS=()
        for (( index = 1; index <= ${#_XCODE_DESTINATION_IDS}; ++index )); do
          _XCODE_PICKER_VALUES+=("$index")
          _XCODE_PICKER_LABELS+=("${_XCODE_DESTINATION_NAMES[index]} · ${_XCODE_DESTINATION_PLATFORMS[index]}")
          _XCODE_PICKER_SEARCH+=("${_XCODE_DESTINATION_NAMES[index]} ${_XCODE_DESTINATION_PLATFORMS[index]}")
          _XCODE_PICKER_DETAILS+=("${_XCODE_DESTINATION_NAMES[index]}"$'\n'"${_XCODE_DESTINATION_PLATFORMS[index]} · ${_XCODE_DESTINATION_IDS[index]}"$'\n\nExact destination reported by Xcode.')
        done
        _xcode_choose 'Xcode / Destination' "$scheme" 'Filter destinations'
        result=$?
        (( result == 1 )) && continue
        (( result == 0 )) || return $result
        destination_index=$_ZLE_PICKER_SELECTED_VALUE
        platform=${_XCODE_DESTINATION_PLATFORMS[destination_index]}
        identifier=${_XCODE_DESTINATION_IDS[destination_index]}
        destination=${_XCODE_DESTINATION_NAMES[destination_index]} ;;
      (refresh-destinations)
        previous_identifier=$identifier
        _xcode_destinations_capture "$kind" "$container" "$scheme" || {
          _XCODE_WORKSPACE_ERROR=$_XCODE_CAPTURE_ERROR
          return 4
        }
        _xcode_destination_cache_forget "$scheme" || return 4
        _xcode_destination_cache_store "$scheme" || {
          _XCODE_WORKSPACE_ERROR='cannot retain the refreshed destination snapshot'
          return 4
        }
        destination_index=${_XCODE_DESTINATION_IDS[(Ie)$previous_identifier]}
        (( destination_index )) || destination_index=1
        platform=${_XCODE_DESTINATION_PLATFORMS[destination_index]}
        identifier=${_XCODE_DESTINATION_IDS[destination_index]}
        destination=${_XCODE_DESTINATION_NAMES[destination_index]} ;;
      (build|rebuild|test|rebuild-test|analyze|clean|run|rebuild-run)
        _XCODE_REQUEST=$selected
        _XCODE_SELECTED_KIND=$kind _XCODE_SELECTED_CONTAINER=$container
        _XCODE_SELECTED_SCHEME=$scheme _XCODE_SELECTED_PLATFORM=$platform
        _XCODE_SELECTED_ID=$identifier _XCODE_SELECTED_DESTINATION=$destination
        return 0 ;;
    esac
  done
}

_compozsh_help_xcode() {
  if [[ ${1:-} == export-skills ]]; then
    _xcode_export_help
    return
  fi
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: xcode [xcodebuild-arguments ...]' \
    'Open a native Xcode action workspace, or delegate arguments to xcodebuild.' \
    '' \
    'Options:' \
    '  --export-skills  Review and export Apple skills for detected local agents.' \
    '  --help  Read this guide without project discovery or Xcode execution.' \
    '  Other arguments retain native xcodebuild syntax; use xcodebuild -help.' \
    '' \
    'Workspace discovery:' \
    '  With no arguments, finds the nearest directory on the upward path that' \
    '  contains a literal .xcworkspace or .xcodeproj. It never scans descendants.' \
    '  A workspace is offered before a project at the same nearest scope.' \
    '  Xcode supplies shared schemes and concrete destinations; selections are' \
    '  read-only discovery and remain inside one responsive full-screen workspace.' \
    '  Every validated scheme in a bounded response is available to filtering and' \
    '  paging. A response above 4096 schemes fails; no partial list is shown.' \
    '  Destination snapshots for up to four schemes stay in memory only while this' \
    '  workspace is open, so returning to a scheme avoids another Xcode query.' \
    '  Refresh destinations replaces the current scheme snapshot after devices or' \
    '  runtimes change. Closing and reopening xcode performs fresh discovery.' \
    '' \
    'Actions:' \
    '  Option names use the picker-header palette; settings and descriptions' \
    '  use normal text. Selected rows retain their configured contrast.' \
    '  Choose a scheme and destination, then Build, Rebuild, Test,' \
    '  Rebuild & Test, Analyze, or Clean. Build and Test use Xcode incremental' \
    '  dependency decisions. Rebuild actions run clean first as slower recovery.' \
    '  A concrete Simulator also offers Build & Run and Rebuild & Run; each' \
    '  boots Simulator, installs the resulting app, and launches its bundle.' \
    '  Opens Device Hub or Simulator from the Xcode selected by DEVELOPER_DIR' \
    '  or xcode-select. A window-opening failure stops before install or launch.' \
    '  Add new project sources to a target built or tested by the selected scheme,' \
    '  either explicitly or through an Xcode buildable folder assigned to it.' \
    '  Compozsh does not infer target membership from filesystem or Git.' \
    '  Physical-device launch and signing configuration are outside this UI.' \
    '  The screen closes before xcodebuild or Simulator performs the action.' \
    '  Native build output remains in the terminal. After either test action, the' \
    '  screen reopens with the mode, passed/failed totals and, for failures,' \
    '  reasons and involved files.' \
    '  Failure selection shows up to 20 tests and 20 build-stage errors. Some' \
    '  Xcode failures have no structured source location; the view says so.' \
    '  If structured results are unavailable, the native status remains visible' \
    '  and the result view labels its missing detail instead of inventing totals.' \
    '  When pbcopy is available, Copy report and done writes the result, native' \
    '  status, test mode, exact target, totals, retained failure reasons,' \
    '  involved files, build errors, and capture limits as plain text after cleanup.' \
    '  It uses the clipboard of the machine running Zsh; in SSH that is' \
    '  the remote host. Compozsh never reads the clipboard or source-file content.' \
    '' \
    'Simulator run view:' \
    '  Build & Run and Rebuild & Run reopen a view for stdout/stderr and' \
    '  Logger/os_log. A live Run replaces the selected bundle’s running copy' \
    '  and requests NSUnbufferedIO=YES for prompt Foundation/Swift stdout.' \
    '  Other libraries can still buffer output.' \
    '  The selected scheme supplies build settings; no separate Debug/Release,' \
    '  launch-argument, environment, macOS-app, or physical-device editor is added.' \
    '  The live tail retains up to 32 KiB and 200 lines; long rows abbreviate.' \
    '  Each source keeps up to 8 KiB of an unfinished line before merging.' \
    '  Read output keeps one additional bounded displayed tail for this run.' \
    '  Narrow terminals show output below actions; action changes preserve it.' \
    '  Native log stream includes debug messages and filters the exact installed' \
    '  executable on this Simulator before capture. Framework messages inside' \
    '  that app are included; helpers and other app executables are excluded.' \
    '  Another launch of the same executable can match while this view is open.' \
    '  The log child uses LOGRC=/dev/null and starts before app launch.' \
    '  Native delivery may drop or miss records; cross-source order can differ.' \
    '  Native privacy behavior is retained; Simulator may expose private fields.' \
    '  A source closing is not proof that the app exited. Source failures are' \
    '  disclosed independently; the other source continues when available.' \
    '  Before the first output, launch-time writer gaps keep waiting for data.' \
    '  A failed pipe read is labeled unavailable and stops that source’s polling.' \
    '  Output follows automatically in Run and the full-width Read output view.' \
    '  Native records show compact metadata, textual severity and message bodies,' \
    '  with spacing between records and the existing semantic output palette.' \
    '  Plain stdout and unrecognized records retain their text. Original dates,' \
    '  process/thread IDs and metadata remain in original source lines for copy' \
    '  and filtering; recognized display headers show time, severity and scope.' \
    '  Type a case-insensitive literal substring to filter each captured line.' \
    '  New matching messages appear automatically, including after no matches.' \
    '  Scroll up pauses the display; capture continues. Reaching the bottom or' \
    '  End follows live again. Home pauses at the beginning. Resizing keeps mode.' \
    '  Enter opens options: Pause display, Follow latest, Go to beginning,' \
    '  Clear filter, and Return to Run. Options and the guide hold displayed' \
    '  text steady, then resume the prior live/paused mode when closed.' \
    '  Copy all captured logs / Copy filtered logs appears when pbcopy is' \
    '  available and matching text is nonempty. Ctrl-Y or Option-W also copies.' \
    '  Copy writes complete captured matching lines, including offscreen text,' \
    '  without UI labels or wrapping, after screen restoration; Run then reopens.' \
    '  No filter copies all retained displayed text; a filter copies only matches.' \
    '  Copy failures are visible and keep the eventual command status nonzero.' \
    '  Copied logs can contain sensitive values and outlive the run in the clipboard.' \
    '  In the full reader, Escape returns to Run without stopping the app.' \
    '  Escape in options returns to the reader; its filter and position persist.' \
    '  In Run, Tab or Ctrl-E focuses the preview; arrows and paging scroll.' \
    '  Tab or Ctrl-B returns to actions and resumes the latest preview output.' \
    '  The pane title shows Following, Paused, Closed, or Unavailable.' \
    '  Waiting for app output means no captured messages are available yet.' \
    '  Arrows choose actions; Enter applies the visible action. Empty-filter' \
    '  digits choose visible rows; ordinary text filters actions in character order.' \
    '  Ctrl-K opens the shared guide. In Run, Escape/Ctrl-G or Stop app and close' \
    '  stops this exact Simulator bundle after screen cleanup. Ctrl-C aborts' \
    '  and stops from Run, the reader, or its options.' \
    '  Enter LLDB is available when Xcode supplies lldb and the launched PID' \
    '  has an observed identity. Identity is checked again before attaching.' \
    '  LLDB owns the restored terminal; continue resumes, quit returns and stops' \
    '  this run. The log observer stops before LLDB; app stdout/stderr is' \
    '  drained and discarded while debugging.' \
    '  Color terminals enable native source highlighting for supported languages.' \
    '  Swift source may remain plain in the installed Apple LLDB.' \
    '  With the output peer and 256 colors, ZSH_OUTPUT_COLORS styles the prompt' \
    '  (heading), current source line (warning), and enabled suggestions (muted).' \
    '  NO_COLOR, unsupported terminals, and redirected output disable colors.' \
    '  LLDB keeps its native editing/completion; typed commands and expressions' \
    '  do not receive shell-style token highlighting. No LLDB config is written.' \
    '  Automatic .lldbinit and symbol-script loading are disabled; macOS signing' \
    '  and debugger permissions still apply. Compozsh does not elevate privileges' \
    '  or change signing.' \
    '  Pipes live in a private compozsh-xcode-run.* directory under the selected' \
    '  Simulator data/tmp directory. Normal/error cleanup removes them;' \
    '  a crash can leave the directory or app. Launch metadata uses host TMPDIR.' \
    '  Concurrent process replacement cannot be excluded atomically. A failed' \
    '  stop or unverifiable identity returns a failure; check or stop the app' \
    '  in Simulator. Missing identity can also mean the app already exited.' \
    '' \
    'Safety and reproducibility:' \
    '  Captures and item counts are bounded; automatic package resolution and' \
    '  package updates are disabled; resolved package versions are required.' \
    '  Compozsh never enables provisioning updates and never skips package plugin' \
    '  or macro validation. Xcode may still inspect project/package metadata.' \
    '  Build, Rebuild, Test, Rebuild & Test, Analyze, Clean, Build & Run, and' \
    '  Rebuild & Run are explicit execution boundaries:' \
    '  project build scripts, package plugins, macros, tests, and app code may run.' \
    '  Review unfamiliar repositories before selecting an action.' \
    '  Both test actions create a temporary xcresult bundle under TMPDIR,' \
    '  disable verbose test-diagnostic collection, and read bounded' \
    '  summaries, failure source locations, and build issues with xcresulttool,' \
    '  then remove it before showing the result. Attachments and source contents' \
    '  are not read. The native xcodebuild status remains the command status.' \
    '' \
    'Direct xcodebuild access and fallback:' \
    '  --export-skills exports Apple-authored skills; see the guide below.' \
    '  Other arguments delegate directly to xcodebuild and preserve its status.' \
    '  Direct arguments do not add a result bundle or result window.' \
    '  In a noninteractive/dumb terminal, no arguments run a safe xcodebuild -list' \
    '  for the nearest container. Full Xcode must be selected with xcode-select.' \
    '' \
    'Examples:' \
    '  xcode                              Open the native action workspace.' \
    '  xcode -version                     Ask xcodebuild for its version.' \
    '  xcode -showBuildSettings -scheme App  Delegate an advanced query.'
  _xcode_export_help section
}

unalias xcode 2>/dev/null
xcode() {
  emulate -L zsh
  local kind='' container='' request='' picker_status=0
  local -i action_status=0
  local _XCODE_REQUEST='' _XCODE_WORKSPACE_ERROR=''
  local _XCODE_SELECTED_KIND='' _XCODE_SELECTED_CONTAINER=''
  local _XCODE_SELECTED_SCHEME='' _XCODE_SELECTED_PLATFORM=''
  local _XCODE_SELECTED_ID='' _XCODE_SELECTED_DESTINATION=''
  local _XCODE_TEST_CLIPBOARD_BINARY=''

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    local -a help=(_compozsh_help_xcode)
    (( ${+functions[_compozsh_help_show]} )) && help=(_compozsh_help_show "${help[@]}")
    "${help[@]}"
    return 0
  fi
  if [[ ${1:-} == --export-skills ]]; then
    if (( $# == 2 )) && [[ $2 == --help ]]; then
      local -a help=(_compozsh_help_xcode export-skills)
      (( ${+functions[_compozsh_help_show]} )) && help=(_compozsh_help_show "${help[@]}")
      "${help[@]}"
      return 0
    fi
    (( $# == 1 )) || {
      print -u2 -r -- 'usage: xcode [xcodebuild-arguments ...]'
      return 2
    }
    _xcode_export_skills
    return $?
  fi
  {
    (( $# == 0 )) || {
      command xcodebuild "$@"
      return $?
    }
    (( $+commands[xcodebuild] )) || {
      print -u2 -r -- 'xcode: xcodebuild is unavailable; select full Xcode with xcode-select'
      return 1
    }
    _xcode_container_discover "$PWD" || {
      print -u2 -r -- 'xcode: no .xcworkspace or .xcodeproj found on the upward path'
      return 1
    }
    kind=${_XCODE_CONTAINER_KINDS[1]}
    container=${_XCODE_CONTAINERS[1]}
    if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]] ||
        (( ! ${+functions[_zle_picker_run]} || ! ${+functions[_matching_compile]} )); then
      _xcode_container_arguments "$kind" "$container" || return
      _xcode_safe_arguments
      command xcodebuild "${_XCODE_CONTAINER_ARGUMENTS[@]}" \
        "${_XCODE_SAFE_ARGUMENTS[@]}" -list
      return $?
    fi

    _XCODE_TEST_CLIPBOARD_BINARY=${commands[pbcopy]:-}
    _zle_picker_run 20 '' 1 0 _xcode_workspace_controller
    picker_status=$?
    (( picker_status == 1 )) && return 0
    if (( picker_status != 0 )); then
      [[ -n $_XCODE_WORKSPACE_ERROR ]] && print -u2 -r -- "xcode: $_XCODE_WORKSPACE_ERROR"
      return $picker_status
    fi
    request=$_XCODE_REQUEST
    _xcode_container_is_current "$_XCODE_SELECTED_KIND" \
      "$_XCODE_SELECTED_CONTAINER" || {
      print -u2 -r -- 'xcode: the selected project or workspace changed; reopen xcode'
      return 1
    }
    case $request in
      (build|rebuild|analyze|clean)
        _xcode_action_command "$_XCODE_SELECTED_KIND" "$_XCODE_SELECTED_CONTAINER" \
          "$_XCODE_SELECTED_SCHEME" "$_XCODE_SELECTED_PLATFORM" \
          "$_XCODE_SELECTED_ID" "$request" || return
        if [[ $request == rebuild ]]; then
          print -r -- "Xcode rebuild: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        else
          print -r -- "Xcode ${request}: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        fi
        command "${_XCODE_COMMAND[@]}" ;;
      (test|rebuild-test)
        if [[ $request == rebuild-test ]]; then
          print -r -- "Xcode rebuild & test: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        else
          print -r -- "Xcode test: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        fi
        _xcode_test_execute "$_XCODE_SELECTED_KIND" "$_XCODE_SELECTED_CONTAINER" \
          "$_XCODE_SELECTED_SCHEME" "$_XCODE_SELECTED_PLATFORM" \
          "$_XCODE_SELECTED_ID" "$_XCODE_SELECTED_DESTINATION" "$request"
        action_status=$?
        _XCODE_TEST_ACTION_STATUS=$action_status
        _zle_picker_run 20 '' 1 0 _xcode_test_result_controller
        _xcode_test_result_apply "$action_status" "$_ZLE_PICKER_SELECTED_VALUE" \
          "$_XCODE_TEST_CLIPBOARD_BINARY"
        return $? ;;
      (run|rebuild-run)
        if [[ $request == rebuild-run ]]; then
          print -r -- "Xcode rebuild & run: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        else
          print -r -- "Xcode build & run: $_XCODE_SELECTED_SCHEME · $_XCODE_SELECTED_DESTINATION"
        fi
        _xcode_run_simulator "$_XCODE_SELECTED_KIND" "$_XCODE_SELECTED_CONTAINER" \
          "$_XCODE_SELECTED_SCHEME" "$_XCODE_SELECTED_PLATFORM" \
          "$_XCODE_SELECTED_ID" "$request" "$_XCODE_SELECTED_DESTINATION" ;;
      (*) return 0 ;;
    esac
  } always {
    _XCODE_CONTAINERS=() _XCODE_CONTAINER_KINDS=() _XCODE_SCHEMES=()
    _XCODE_DESTINATION_IDS=() _XCODE_DESTINATION_PLATFORMS=()
    _XCODE_DESTINATION_NAMES=() _XCODE_COMMAND=()
    _XCODE_CAPTURE='' _XCODE_CAPTURE_ERROR=''
    _xcode_test_result_reset
    _XCODE_TEST_CONTAINER='' _XCODE_TEST_SCHEME=''
    _XCODE_TEST_PLATFORM='' _XCODE_TEST_DESTINATION_ID=''
    _XCODE_TEST_DESTINATION='' _XCODE_TEST_MODE=''
    unset _XCODE_TEST_ACTION_STATUS _XCODE_TEST_DETAIL_NODE_COUNT
    unset _XCODE_TEST_DETAIL_FILES
    unset _XCODE_CONTAINER_ARGUMENTS _XCODE_SAFE_ARGUMENTS
    unset _XCODE_APP_PATH _XCODE_BUNDLE_ID
  }
}

# Detect coding-agent surfaces that can discover local Agent Skills. A CLI on
# PATH or its standard macOS application bundle is sufficient; merely having a
# vendor's consumer web or chat application is not.
_detect_xcode_skill_vendor() {
  emulate -L zsh

  local vendor=$1 binary='' app_name='' app_root=''
  local -a binaries=() app_names=() matches=()

  case $vendor in
    codex)
      binaries=(codex)
      app_names=(ChatGPT Codex)
      ;;
    claude)
      binaries=(claude)
      app_names=(Claude)
      ;;
    gemini)
      binaries=(gemini)
      ;;
    antigravity)
      binaries=(agy antigravity)
      app_names=(Antigravity)
      ;;
    kiro)
      binaries=(kiro-cli kiro)
      app_names=(Kiro)
      ;;
    *)
      REPLY=''
      return 2
      ;;
  esac

  for binary in "${binaries[@]}"; do
    (( $+commands[$binary] )) && matches+=("$binary CLI")
  done

  for app_root in /Applications "$HOME/Applications"; do
    for app_name in "${app_names[@]}"; do
      [[ -d "$app_root/$app_name.app/Contents" ]] && matches+=("$app_name app")
    done
  done

  REPLY=${(j:, :)matches}
  (( ${#matches} != 0 ))
}

# Remove only a temporary directory created immediately below an agent skill
# root by this add-on. Keeping this validation beside the recursive removal
# prevents a malformed path from broadening cleanup.
_remove_xcode_skill_temp_tree() {
  emulate -L zsh

  local target=${1:A} expected_parent=${2:A} name=${${1:A}:t}
  [[ ${target:h} == $expected_parent &&
     ( $name == .xcode-skill-stage.* ||
       $name == .xcode-skill-backup.* ) ]] || {
    print -u2 -r -- "Xcode skill update: refused unsafe cleanup target: $target"
    return 1
  }
  [[ -e $target || -L $target ]] || return 0
  command rm -rf -- "$target"
}

# Copy one staged Xcode export into an agent's global skill directory. Existing
# directories are updated only when a marker proves this function created them;
# a same-named personal skill is preserved and reported as a conflict. Every
# managed skill is built completely in a sibling directory before one swap, so
# a failed copy leaves the previous skill intact and stale files disappear.
_install_xcode_skills_for_agent() {
  emulate -L zsh

  local source_dir=$1 target_dir=$2 agent_name=$3 xcode_build=$4
  local source_skill='' target_skill='' marker='.xcode-skill-export'
  local stage_dir='' backup_dir=''
  local -i installed=0 updated=0 conflicts=0 failures=0 refreshing=0 restored=0

  target_dir=${target_dir:A}
  if ! command mkdir -p -- "$target_dir"; then
    print -u2 -r -- "  ✗ $agent_name: cannot create $target_dir"
    return 1
  fi

  for source_skill in "$source_dir"/*(N/); do
    [[ -f "$source_skill/SKILL.md" ]] || continue
    target_skill="$target_dir/${source_skill:t}"

    if [[ -L $target_skill || ( -e $target_skill && ! -d $target_skill ) ]]; then
      print -u2 -r -- \
        "  ! $agent_name: kept conflicting ${source_skill:t}"
      (( ++conflicts ))
      continue
    fi

    if [[ -d $target_skill &&
          ( ! -f "$target_skill/$marker" || -L "$target_skill/$marker" ) ]]; then
      print -u2 -r -- \
        "  ! $agent_name: kept existing personal skill ${source_skill:t}"
      (( ++conflicts ))
      continue
    fi

    [[ -d $target_skill ]] && refreshing=1 || refreshing=0
    stage_dir=$(command mktemp -d \
      "$target_dir/.xcode-skill-stage.XXXXXX") || {
      print -u2 -r -- "  ✗ $agent_name: cannot stage ${source_skill:t}"
      (( ++failures ))
      continue
    }

    if ! command cp -R -f "$source_skill"/. "$stage_dir" ||
        ! print -r -- "$xcode_build" >| "$stage_dir/$marker"; then
      print -u2 -r -- "  ✗ $agent_name: failed to copy ${source_skill:t}"
      (( ++failures ))
      _remove_xcode_skill_temp_tree "$stage_dir" "$target_dir" ||
        (( ++failures ))
      continue
    fi

    backup_dir=''
    if (( refreshing )); then
      backup_dir=$(command mktemp -d \
        "$target_dir/.xcode-skill-backup.XXXXXX") || {
        print -u2 -r -- "  ✗ $agent_name: cannot stage refresh ${source_skill:t}"
        (( ++failures ))
        _remove_xcode_skill_temp_tree "$stage_dir" "$target_dir" ||
          (( ++failures ))
        continue
      }
      if ! command mv -- "$target_skill" "$backup_dir/previous"; then
        print -u2 -r -- "  ✗ $agent_name: cannot refresh ${source_skill:t}"
        (( ++failures ))
        _remove_xcode_skill_temp_tree "$stage_dir" "$target_dir" ||
          (( ++failures ))
        _remove_xcode_skill_temp_tree "$backup_dir" "$target_dir" ||
          (( ++failures ))
        continue
      fi
    fi

    if ! command mv -- "$stage_dir" "$target_skill"; then
      print -u2 -r -- "  ✗ $agent_name: cannot activate ${source_skill:t}"
      (( ++failures ))
      restored=0
      if (( refreshing )); then
        if command mv -- "$backup_dir/previous" "$target_skill"; then
          restored=1
        else
          (( ++failures ))
          print -u2 -r -- \
            "  ! $agent_name: previous skill retained at $backup_dir/previous"
        fi
      fi
      _remove_xcode_skill_temp_tree "$stage_dir" "$target_dir" ||
        (( ++failures ))
      if [[ -n $backup_dir ]] && (( !refreshing || restored )); then
        _remove_xcode_skill_temp_tree "$backup_dir" "$target_dir" ||
          (( ++failures ))
      fi
      continue
    fi

    if (( refreshing )); then
      (( ++updated ))
      command chmod -R u+w "$backup_dir" 2>/dev/null
      _remove_xcode_skill_temp_tree "$backup_dir" "$target_dir" ||
        (( ++failures ))
    else
      (( ++installed ))
    fi
  done

  print -r -- \
    "  $agent_name: ${installed} installed, ${updated} refreshed, ${conflicts} kept"
  (( conflicts == 0 && failures == 0 ))
}

# Export Apple's portable Xcode skills once, then make them discoverable to the
# common local coding agents. No Xcode process or filesystem write occurs until
# this function is explicitly invoked.
_xcode_export_help() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  if [[ ${1:-} == section ]]; then
    "${printer[@]}" '' 'Skill export: xcode --export-skills'
  else
    "${printer[@]}" 'usage: xcode --export-skills'
  fi
  "${printer[@]}" \
    'Export Apple-authored Xcode skills to detected coding agents.' \
    '' \
    'Prerequisites and detection:' \
    '  Uses the Xcode selected for xcrun (xcode-select or DEVELOPER_DIR).' \
    '  That Xcode must provide xcrun agent skills export. This command does' \
    '  not install Xcode, coding agents, or other tools.' \
    '  Detects supported CLIs on PATH and standard macOS app bundles in' \
    '  /Applications or ~/Applications; apps are not launched.' \
    '  Codex: codex, ChatGPT.app, or Codex.app; Claude: claude or Claude.app;' \
    '  Gemini: gemini; Antigravity: agy, antigravity, or Antigravity.app;' \
    '  Kiro: kiro-cli, kiro, or Kiro.app. Detection does not check sign-in or' \
    '  guarantee skill support in every installed version or chat surface.' \
    '' \
    'Writes only for detected agents (paths are below HOME):' \
    '  Codex / Gemini CLI: ~/.agents/skills' \
    '  Claude Code:        ~/.claude/skills' \
    '  Antigravity:        ~/.gemini/config/skills' \
    '  Kiro:               ~/.kiro/skills' \
    '  Codex in Xcode also uses:' \
    '    ~/Library/Developer/Xcode/CodingAssistant/codex/skills/__xcode' \
    '  Exports once into a temporary directory, then installs real copies.' \
    '  Missing agents get no new configuration directories. With no detected' \
    '  agent or no compatible Xcode exporter, it fails before installing.' \
    '' \
    'Refresh and recovery:' \
    '  An interactive terminal with UI/matching peers opens an installation plan.' \
    '  Review the detected destinations; Enter on Export skills closes the screen' \
    '  before exporting or writing. Escape cancels without creating staging data.' \
    '  Pipes, dumb terminals, and missing UI keep direct immediate execution.' \
    '  There is no dry-run mode. Rerun after changing Xcode to refresh skills.' \
    '  Only existing skills marked .xcode-skill-export are replaced. Personal' \
    '  same-name directories, symlinks, and other conflicts are kept/reported.' \
    '  Replacement is staged per skill; the whole multi-agent update is not' \
    '  one transaction. A later failure can leave earlier skills updated.' \
    '  Failed replacement attempts restore the previous copy; if recovery' \
    '  fails, its retained backup path is printed. Review nonzero results.' \
    '  Refresh replaces contents of matching exported skills; it does not' \
    '  remove other skill directories absent from the new export.' \
    '  Start a new agent session afterward. Gemini CLI can use /skills reload.' \
    '  Exported guidance does not connect live Xcode tools or configure MCP.' \
    '  No extra arguments are accepted; --export-skills --help works without detection,' \
    '  invoking Xcode, or writing files.' \
    '' \
    'Examples:' \
    '  xcode --export-skills    Export from the currently selected Xcode.'
}

unfunction update-xcode-skills _compozsh_help_update-xcode-skills 2>/dev/null
unalias update-xcode-skills 2>/dev/null

_xcode_export_review() {
  emulate -L zsh
  local -a _XCODE_PICKER_VALUES=(export)
  local -a _XCODE_PICKER_LABELS=('Export skills · Install Apple guidance for the detected agents')
  local -a _XCODE_PICKER_SEARCH=('export install update skills')
  local -a _XCODE_PICKER_DETAILS=(
    $'Export once, then install real copies in the displayed destinations.\n\nOnly skills marked .xcode-skill-export may be replaced. Personal conflicts and symlinks are kept and reported.\nReplacement is staged per skill, not one transaction: a later failure can leave earlier updates installed.\nNo export or installation has started. Escape returns without writing.')
  local _XCODE_ACTION_CONTEXT="SOURCE"$'\n'"$agent_path"$'\n\nDESTINATIONS'
  local -i index=0
  for (( index = 1; index <= ${#agent_names}; ++index )); do
    _XCODE_ACTION_CONTEXT+=$'\n'"${agent_names[index]}"$'\n'"${skill_dirs[index]}"
  done
  _xcode_choose 'Xcode / Export skills' 'Detected local agents · review installation targets' 'Filter actions' options
}

_xcode_export_skills() {
  emulate -L zsh

  local agent_path='' xcode_version='' xcode_build='' stage_dir=''
  local shared_agent_name=''
  local temp_root=${TMPDIR:-/tmp}
  local -i overall_status=0 install_status=0
  local -i codex_installed=0 claude_installed=0 gemini_installed=0
  local -i antigravity_installed=0 kiro_installed=0
  local -a exported_skills=()
  local -a detected_vendors=() agent_names=() skill_dirs=()
  local -i index=0

  if _detect_xcode_skill_vendor codex; then
    codex_installed=1
    detected_vendors+=("Codex ($REPLY)")
  fi
  if _detect_xcode_skill_vendor claude; then
    claude_installed=1
    detected_vendors+=("Claude Code ($REPLY)")
  fi
  if _detect_xcode_skill_vendor gemini; then
    gemini_installed=1
    detected_vendors+=("Gemini CLI ($REPLY)")
  fi
  if _detect_xcode_skill_vendor antigravity; then
    antigravity_installed=1
    detected_vendors+=("Google Antigravity ($REPLY)")
  fi
  if _detect_xcode_skill_vendor kiro; then
    kiro_installed=1
    detected_vendors+=("Kiro ($REPLY)")
  fi

  if (( codex_installed || gemini_installed )); then
    if (( codex_installed && gemini_installed )); then
      shared_agent_name='Codex + Gemini CLI'
    elif (( codex_installed )); then
      shared_agent_name='Codex'
    else
      shared_agent_name='Gemini CLI'
    fi
    agent_names+=("$shared_agent_name")
    skill_dirs+=("$HOME/.agents/skills")
  fi
  if (( claude_installed )); then
    agent_names+=('Claude Code')
    skill_dirs+=("$HOME/.claude/skills")
  fi
  if (( antigravity_installed )); then
    agent_names+=('Google Antigravity')
    skill_dirs+=("$HOME/.gemini/config/skills")
  fi
  if (( kiro_installed )); then
    agent_names+=('Kiro')
    skill_dirs+=("$HOME/.kiro/skills")
  fi
  if (( codex_installed )); then
    agent_names+=('Codex in Xcode')
    skill_dirs+=(
      "$HOME/Library/Developer/Xcode/CodingAssistant/codex/skills/__xcode"
    )
  fi

  if (( ${#agent_names} == 0 )); then
    print -u2 -r -- 'xcode --export-skills: no supported local coding agent found'
    print -u2 -r -- \
      'Install Codex, Claude Code, Gemini CLI, Antigravity, or Kiro first.'
    return 1
  fi

  if (( ! $+commands[xcrun] )) || \
      ! agent_path=$(command xcrun --find agent 2>/dev/null) || \
      [[ -z $agent_path ]]; then
    print -u2 -r -- \
      "xcode --export-skills: Xcode's agent command is unavailable"
    print -u2 -r -- \
      'Select a compatible Xcode with xcode-select, then try again.'
    return 1
  fi

  if [[ -t 0 && -t 1 && $TERM != dumb ]] &&
     (( ${+functions[_zle_picker_run]} && ${+functions[_zle_ui_view]} && ${+functions[_matching_compile]} )); then
    local _ZLE_PICKER_SELECTED_VALUE=''
    local -a _ZLE_PICKER_BOOKMARK=()
    local -i _ZLE_PICKER_BOOKMARK_FOCUS=0 review_status=0
    _zle_picker_run 10 '' 1 0 _xcode_export_review
    review_status=$?
    (( review_status == 1 )) && return 0
    (( review_status == 0 )) || return $review_status
    [[ $_ZLE_PICKER_SELECTED_VALUE == export ]] || return 1
  fi

  print -r -- "Detected: ${(j:, :)detected_vendors}"

  stage_dir=$(command mktemp -d "${temp_root%/}/xcode-skills.XXXXXX") || {
    print -u2 -r -- 'xcode --export-skills: cannot create a temporary directory'
    return 1
  }

  {
    xcode_version=$(command xcodebuild -version 2>/dev/null)
    xcode_build=${${(M)${(f)xcode_version}:#Build version *}#Build version }

    print -r -- 'Exporting portable Apple skills from:'
    [[ -n $xcode_version ]] && print -r -- "$xcode_version"

    if ! command xcrun agent skills export --output-dir "$stage_dir"; then
      overall_status=1
    else
      exported_skills=("$stage_dir"/*/SKILL.md(N.))
      if (( ${#exported_skills} == 0 )); then
        print -u2 -r -- 'xcode --export-skills: Xcode exported no usable skills'
        overall_status=1
      else
        print -r -- \
          "Installing ${#exported_skills} skills for local coding agents:"
        for (( index = 1; index <= ${#agent_names}; ++index )); do
          _install_xcode_skills_for_agent \
            "$stage_dir" "${skill_dirs[$index]}" \
            "${agent_names[$index]}" "$xcode_build"
          install_status=$?
          (( install_status == 0 )) || overall_status=1
        done
      fi
    fi
  } always {
    if [[ -n $stage_dir && -d $stage_dir &&
          ${stage_dir:t} == xcode-skills.* ]]; then
      command rm -rf -- "$stage_dir"
    fi
  }

  if (( overall_status == 0 )); then
    print -r -- "Xcode skills are ready for: ${(j:, :)agent_names}."
    print -r -- 'Start a new agent session to make the exported skills available.'
    (( gemini_installed )) && \
      print -r -- 'An open Gemini CLI session can instead run /skills reload.'
  else
    print -u2 -r -- \
      'The Xcode skill update did not complete; review the messages above.'
  fi
  return overall_status
}

:
