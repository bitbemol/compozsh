# Entry point: _compozsh_git_filter_config
# Impure: observes bounded Git filter names without evaluating their values.
# Prompt and discard retain inherited Git context and select clean/restore
# policy explicitly; the shared local-only entry owns the Git call's controls.
# Explicit-root review keeps its own capture lifecycle.
_compozsh_git_filter_config() {
  emulate -L zsh
  local root=$1 mode=${2:-clean} pattern='^filter\..*\.(clean|process|required)$'
  reply=()
  (( ${+functions[_compozsh_capture_bounded]} &&
     ${+functions[_compozsh_git_filter_overrides]} &&
     ${+functions[_compozsh_git_local]} )) || return 2
  [[ $mode == (clean|restore) ]] || return 2
  [[ $mode == restore ]] && pattern='^filter\..*\.(clean|smudge|process|required)$'
  _compozsh_capture_bounded 65538 _compozsh_git_local inherit "$root" -- \
    config --null --name-only --get-regexp "$pattern" || return 2
  [[ $reply[2] == complete && $reply[3] == (0|1) ]] || return 2
  local names=$reply[1]
  _compozsh_git_filter_overrides "$names" "$mode"
}

