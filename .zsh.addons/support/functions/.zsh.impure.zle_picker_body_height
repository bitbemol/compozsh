# Entry point: _zle_picker_body_height
# Impure: may observe external or shared state, or apply effects.
# Ordinary support peer; no cross-peer calls at source time.

# One shared height budget keeps collection, layout, and footer anchoring in
# agreement when a caller provides a location row. Tiny windows omit that row.
# Inline, the frame starts below the prompt and draft whose line widths the
# screen session captured; their last row stands where the title bar would,
# and every further row, wrapped at the current width, comes off the body.
_zle_picker_body_height() {
  emulate -L zsh
  local width=''
  local -i columns=${COLUMNS:-80} prefix_rows=0
  (( columns > 0 )) || columns=80
  for width in "${_ZLE_PICKER_INLINE_WIDTHS[@]}"; do
    # Session-captured counts; any other text is not a width.
    [[ $width == <-> && ${#width} -le 18 ]] || continue
    (( prefix_rows += 1 + width / columns ))
  done
  (( prefix_rows > 1 )) || prefix_rows=1
  REPLY=$(( LINES - 6 - (${_ZLE_PICKER_EXCLUDE_SHOWN:-0} != 0) - (${#_ZLE_PICKER_SUBTITLE} > 0 && LINES >= 10) - (prefix_rows - 1) ))
  (( REPLY < 1 )) && REPLY=1
  return 0
}


