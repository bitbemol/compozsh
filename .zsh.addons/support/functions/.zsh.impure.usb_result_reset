  _USB_RESULT_VERIFY_SECONDS=0 _USB_RESULT_VERIFIED=0 _USB_RESULT_EJECTED=0
  _USB_RESULT_STARTED=0 _USB_RESULT_CHECKSUM_VALIDATED=0
}

