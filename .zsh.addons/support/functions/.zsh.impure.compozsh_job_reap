# Entry point: _compozsh_job_reap
# Impure: signals and reaps one exact owned background child, then retires
# only that child's completed job record. Usage: <pid> [none|TERM|KILL].
# The signal reaches the PID only while its owned job is running or suspended,
# never a PID whose job is already done or absent. REPLY is the wait status,
# or empty when this shell owns no such job.
_compozsh_job_reap() {
  emulate -L zsh
  local pid=$1 signal=${2:-none} job='' state='' owned=''
  REPLY=''
  [[ $pid == <1-> && ${#pid} -le 10 && $signal == (none|TERM|KILL) ]] || return 2
  zmodload zsh/parameter || return 1
  for job in "${(@k)jobstates}"; do
    state=${jobstates[$job]}
    [[ $state == *":${pid}="* ]] || continue
    owned=$job
    break
  done
  [[ -n $owned ]] || return 0

  # Zsh's wait/jobs builtins scan all completed jobs when NOTIFY is off,
  # even with an exact operand. Avoid that scan and terminal notifications in
  # this small scope; emulate -L restores the caller's options on return.
  unsetopt MONITOR
  setopt NOTIFY
  if [[ $signal != none && ( $state == running:* || $state == suspended:* ) ]]; then
    builtin kill -$signal "$pid" 2>/dev/null
  fi
  builtin wait "$pid" 2>/dev/null
  REPLY=$?
  state=${jobstates[$owned]:-}
  if [[ $state == done:*":${pid}="* ]]; then
    builtin jobs -p "%$owned" >/dev/null 2>&1
  fi
  return 0
}

