# Entry point: _zle_picker_fit
# Pure: explicit captured inputs; caller-local REPLY/reply outputs only.
# Ordinary support peer; no cross-peer calls at source time.

# Fit literal text using the shared cell prefix, then apply this element's
# ellipsis and right-padding policy. Width must be decimal integer text of at
# most 18 digits (sign excluded), like the other pure width entries: zero or
# negative gives an empty REPLY with status 0; anything else gives an empty
# REPLY and status 2. Callers bound the width to the frame, since padding
# allocates that many cells.
_zle_picker_fit() {
  emulate -L zsh
  REPLY=''
  # Integer assignment evaluates arithmetic, which could read or assign names,
  # and 19 or more digits truncate or wrap.
  [[ $2 == (|-)<-> ]] && (( ${#${2#-}} <= 18 )) || return 2
  local text=$1 marker='…'
  local -i width=$2
  (( width > 0 )) || return 0
  if (( ${(m)#text} > width )); then
    (( ${(m)#marker} > width )) && marker='.'
    _compozsh_cell_prefix "$text" $(( width - ${(m)#marker} ))
    text=$REPLY$marker
  fi
  REPLY=${(mr:$width:: :)text}
}


