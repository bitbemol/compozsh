# Entry point: _zle_picker_can_select_digit
# Impure: reads current picker capabilities, focus and exclusion state.

# Share the acceptance rule with the footer so its hint cannot diverge from
# key handling. Slot existence is still checked against the painted viewport.
_zle_picker_can_select_digit() {
  emulate -L zsh
  (( _ZLE_PICKER_DIGIT_SELECT && _ZLE_PICKER_INDEXES_VISIBLE &&
     !_ZLE_PICKER_INSPECT_FOCUS && !${_ZLE_PICKER_EXCLUDE_FOCUS:-0} )) &&
    [[ -z $1 && -z ${_ZLE_PICKER_EXCLUDE:-} ]]
}

