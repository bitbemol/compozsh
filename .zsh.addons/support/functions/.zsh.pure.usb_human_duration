# Entry point: _usb_human_duration
# Pure: explicit supplied numbers in; caller-local REPLY out.
# Ordinary support peer; no cross-peer calls at source time.

# Seconds default to zero when empty and are otherwise decimal integer text of
# at most 18 digits (sign excluded); negative values clamp to zero. Other text
# gives an empty REPLY and status 2.
_usb_human_duration() {
  emulate -L zsh
  REPLY=''
  local total_text=${1:-0}
  # Integer assignment evaluates arithmetic, which can read or assign names and
  # run subscript command substitutions; longer digits truncate and can flip sign.
  [[ $total_text == (|-)<-> ]] && (( ${#${total_text#-}} <= 18 )) || return 2
  local -i total=$total_text hours=0 minutes=0 seconds=0
  (( total < 0 )) && total=0
  hours=$(( total / 3600 ))
  minutes=$(( (total % 3600) / 60 ))
  seconds=$(( total % 60 ))
  if (( hours )); then
    REPLY="${hours}h ${minutes}m ${seconds}s"
  elif (( minutes )); then
    REPLY="${minutes}m ${seconds}s"
  else
    REPLY="${seconds}s"
  fi
}

:
