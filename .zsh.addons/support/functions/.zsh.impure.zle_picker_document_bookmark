# Entry point: _zle_picker_document_bookmark
# Impure: may observe external or shared state, or apply effects.
# Ordinary support peer; no cross-peer calls at source time.

_zle_picker_document_bookmark() {
  if (( _ZLE_PICKER_DOCUMENT )) && [[ -n $_ZLE_PICKER_INSPECT_KEY &&
        ( $_ZLE_PICKER_INSPECT_KEY == "$_ZLE_PICKER_DOCUMENT_KEY" ||
          -n ${_ZLE_PICKER_DOCUMENT_BRANCHES[$_ZLE_PICKER_INSPECT_KEY]-} ) ]]; then
    _ZLE_PICKER_DOCUMENT_OFFSETS[$_ZLE_PICKER_INSPECT_KEY]=$_ZLE_PICKER_INSPECT_OFFSET
    _ZLE_PICKER_DOCUMENT_ROWS[$_ZLE_PICKER_INSPECT_KEY]=${_ZLE_PICKER_INSPECT_SOURCE_LINES[_ZLE_PICKER_INSPECT_OFFSET+1]:-0}
    (( _ZLE_PICKER_READER_ONLY )) &&
      _ZLE_PICKER_DOCUMENT_WIDTHS[$_ZLE_PICKER_INSPECT_KEY]=$_ZLE_PICKER_INSPECT_WIDTH
  fi
  return 0
}


