# Entry point: _zle_picker_highlights_shift
# Pure: supplied spans, offset and clipping width in; caller-local REPLY out.
# Ordinary support peer; no cross-peer calls at source time.

# Shift and clip validated label-highlight spans without interpreting their
# contents as patterns or styles. The renderer owns role resolution.
# Offset, width and span endpoints are nonnegative decimal integers of at most
# 18 digits, keeping their sums within native signed arithmetic. Invalid numeric
# arguments fail; malformed spans are skipped. Omitted offset/width mean zero.
_zle_picker_highlights_shift() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local specifications=$1 token='' role=''
  local offset=${2:-0} width=${3:-0} IFS=$' \t\n'
  local -i shift=0 limit=0 start=0 end=0
  local -a fields=()
  REPLY=''
  (( $# >= 1 && $# <= 3 )) &&
    [[ $offset == <-> && $width == <-> ]] &&
    (( ${#offset} <= 18 && ${#width} <= 18 )) || return 2
  shift=$(( 10#$offset )) limit=$(( 10#$width ))
  (( limit > 0 )) || return 0
  for token in ${=specifications}; do
    fields=( "${(@s.:.)token}" )
    (( ${#fields} == 3 )) || continue
    [[ ${fields[1]} == <-> && ${fields[2]} == <-> ]] || continue
    (( ${#fields[1]} <= 18 && ${#fields[2]} <= 18 )) || continue
    role=${fields[3]}
    [[ $role == picker-[A-Za-z0-9_-]## ]] || continue
    start=$(( 10#${fields[1]} )) end=$(( 10#${fields[2]} ))
    (( start >= 0 && end > start && start < limit )) || continue
    (( end > limit )) && end=$limit
    REPLY+="$(( start + shift )):$(( end + shift )):$role "
  done
  REPLY=${REPLY% }
}


