# Entry point: _zle_picker_screen_session
# UI component: consumes view state and participates in the screen lifecycle.
# Ordinary support peer; no cross-peer calls at source time.

# Own the display for one interaction, which may contain several picker views.
# Callers return a choice; filesystem/application actions run after restoration.
_zle_picker_screen_session() {
  emulate -L zsh
  # The screen owner releases its painted frame on every exit. Its rows, bars
  # and composed copy hold labels, inspector, document, query and location
  # text; every view and capture status in this session renders into these.
  local -a _ZLE_PICKER_DISPLAY=() _ZLE_PICKER_DISPLAY_STYLES=() _ZLE_PICKER_DISPLAY_INDEX_ENDS=()
  local -a _ZLE_PICKER_DISPLAY_HIGHLIGHTS=() _ZLE_PICKER_DISPLAY_LEFT_ENDS=() _ZLE_PICKER_DISPLAY_RIGHT_ROLES=()
  local -a _ZLE_PICKER_DISPLAY_RIGHT_SYNTAX=() _ZLE_PICKER_DISPLAY_CONTEXT_STARTS=() _ZLE_PICKER_DISPLAY_MATCH_STARTS=()
  local -a _ZLE_PICKER_DISPLAY_PREFIX_ENDS=() _ZLE_PICKER_INSPECT_SYNTAX=()
  local _ZLE_PICKER_HEADER='' _ZLE_PICKER_TITLEBAR='' _ZLE_PICKER_SUBTITLE_ROW=''
  local _ZLE_PICKER_QUERY_ROW='' _ZLE_PICKER_POSTDISPLAY=''
  local -i _ZLE_PICKER_TITLEBAR_META_START=-1 _ZLE_PICKER_QUERY_START=0 _ZLE_PICKER_QUERY_END=0
  local -i _ZLE_PICKER_SESSION=1 _ZLE_PICKER_SCREEN_ACTIVE=0 result=0
  local saved_postdisplay=$POSTDISPLAY saved_buffer=$BUFFER saved_predisplay=$PREDISPLAY
  local saved_prompt=$PROMPT saved_rprompt=$RPROMPT
  local PROMPT=$PROMPT RPROMPT=$RPROMPT screen_exit=''
  local -i saved_cursor=$CURSOR saved_mark=$MARK
  # The optional editor owns this flag; validate its text before restoring it,
  # because an inherited value would otherwise be evaluated as arithmetic.
  local -i saved_suspended=0
  [[ ${_ZLE_AUTOSUGGEST_SUSPENDED-} == <-> && ${#_ZLE_AUTOSUGGEST_SUSPENDED} -le 18 ]] &&
    saved_suspended=$_ZLE_AUTOSUGGEST_SUSPENDED
  local -a saved_highlights=()

  # Removing a temporary INT trap inside a manually driven ZLE input loop
  # restores the process default before ZLE can rearm its own handler. Keep a
  # default abort handler for the whole screen, through restoration, instead.
  # The modal screen owns abort behavior; LOCAL_TRAPS restores the caller's
  # function, static or ignored registration when that ownership finishes.
  setopt LOCAL_TRAPS
  TRAPINT() { return 130 }
  if (( ! ${+functions[TRAPWINCH]} )); then
    TRAPWINCH() { zle compozsh-picker-redraw }
  fi
  _ZLE_AUTOSUGGEST_SUSPENDED=1
  region_highlight=("${(@)region_highlight:#*memo=my-zsh-autosuggestion}")
  if [[ -n ${_ZLE_AUTOSUGGEST_DISPLAY:-} && $POSTDISPLAY == "$_ZLE_AUTOSUGGEST_DISPLAY" ]]; then
    saved_postdisplay=''
    POSTDISPLAY=''
  fi
  _ZLE_AUTOSUGGEST_SUFFIX='' _ZLE_AUTOSUGGEST_DISPLAY=''
  {
    if [[ -t 1 && -n ${terminfo[smcup]} && -n ${terminfo[rmcup]} ]]; then
      saved_highlights=("${region_highlight[@]}")
      screen_exit=$terminfo[rmcup]
      print -rn -- "$terminfo[smcup]"
      _ZLE_PICKER_SCREEN_ACTIVE=1
      BUFFER='' CURSOR=0 PREDISPLAY='' POSTDISPLAY=''
      PROMPT='' RPROMPT='' region_highlight=()
      zle reset-prompt
      zle .clear-screen
    fi
    "$@"
    result=$?
  } always {
    _ZLE_PICKER_ACTIVE=0
    _ZLE_AUTOSUGGEST_SUSPENDED=$saved_suspended
    region_highlight=("${(@)region_highlight:#*memo=my-zsh-picker}")
    POSTDISPLAY=$saved_postdisplay
    if (( _ZLE_PICKER_SCREEN_ACTIVE )); then
      BUFFER=$saved_buffer CURSOR=$saved_cursor MARK=$saved_mark
      PREDISPLAY=$saved_predisplay
      PROMPT=$saved_prompt RPROMPT=$saved_rprompt
      region_highlight=("${saved_highlights[@]}")
      zle reset-prompt
    fi
    zle -R -c
    if (( _ZLE_PICKER_SCREEN_ACTIVE )); then
      print -rn -- "$screen_exit"
      _ZLE_PICKER_SCREEN_ACTIVE=0
      zle .redisplay
      zle -R -c
    fi
  }
  return $result
}


