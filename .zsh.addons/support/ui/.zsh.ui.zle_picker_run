# Entry point: _zle_picker_run
# UI component: consumes view state and participates in the screen lifecycle.
# Ordinary support peer; no cross-peer calls at source time.

_zle_picker_run() {
  emulate -L zsh

  local raw_limit=${1:-10} picker_buffer=''
  local _zle_picker_start_query=${2:-} _zle_picker_start_index=${3:-1}
  local _zle_picker_start_offset=${4:-0}
  # Optional internal controller for several views in one nested editor.
  # Scoped here so it cannot leak into a final cd/chpwd or application action.
  local _zle_picker_session_callback=${5:-}
  local -i _zle_picker_session_status=1
  # Ctrl-C, as SIGINT or as the byte the picker loop reads, aborts the screen.
  # The screen session and loop record it here; every workspace then returns
  # 130 instead of whatever an unwinding nested editor leaves behind.
  local -i _zle_picker_aborted=0 edit_status=0
  # Settings text: 19 or more digits would truncate or wrap in arithmetic.
  [[ $raw_limit == <-> && ${#raw_limit} -le 18 ]] || raw_limit=10
  (( raw_limit < 1 )) && raw_limit=1
  (( raw_limit > 20 )) && raw_limit=20

  _ZLE_PICKER_RUN_LIMIT=$raw_limit
  _ZLE_PICKER_BOOTSTRAP='compozsh-picker'
  # The interrupt ends here, after the session's cleanup has run: a function
  # trap's nonzero return unwinds this anonymous scope only, and the caller
  # receives an ordinary status it can pass through.
  () {
    {
      vared -i compozsh-picker-init picker_buffer || edit_status=$?
    } always {
      _ZLE_PICKER_BOOTSTRAP=''
      if (( TRY_BLOCK_INTERRUPT )); then
        _zle_picker_aborted=1
        TRY_BLOCK_INTERRUPT=0
      fi
    }
  }
  (( _zle_picker_aborted )) && return 130
  (( edit_status )) && return 2
  [[ -n ${_zle_picker_session_callback:-} ]] && return $_zle_picker_session_status
  (( _ZLE_PICKER_ACCEPTED )) && return 0
  return 1
}

# Public commands launch the same picker through a short-lived nested ZLE.
# The UI peer owns this lifecycle so navigation and search peers can detect it
# at runtime without depending on each other or duplicating terminal handling.
_zle_picker_widget() {
  emulate -L zsh
  if [[ -n ${_zle_picker_session_callback:-} ]]; then
    _zle_picker_screen_session "$_zle_picker_session_callback"
    _zle_picker_session_status=$?
  else
    _zle_picker_loop "${_zle_picker_start_query:-}" "${_ZLE_PICKER_RUN_LIMIT:-10}" \
      "${_zle_picker_start_index:-1}" "${_zle_picker_start_offset:-0}"
  fi
}

_zle_picker_line_init() {
  emulate -L zsh

  [[ $_ZLE_PICKER_BOOTSTRAP == compozsh-picker ]] || return 0
  _ZLE_PICKER_BOOTSTRAP=''
  zle compozsh-picker
  zle .accept-line
}

zle -N compozsh-picker _zle_picker_widget
zle -N compozsh-picker-init _zle_picker_line_init

:
