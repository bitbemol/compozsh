# Terminal color-scheme selection and coherent palette defaults.
# Repository-managed support: keep installed; customize public settings in the
# machine-local initializer. Discovered with all peers, without a loading phase.

# A local initializer may select `light` or `dark` explicitly. Automatic
# selection uses only passive terminal metadata: querying the terminal during
# startup can race with user input and leave delayed replies in ZLE's buffer.
(( ${+ZSH_COLOR_SCHEME} )) || typeset -g ZSH_COLOR_SCHEME=auto

# Classify COLORFGBG's final indexed-color field. The first 16 colors retain
# the conventional dark/light grouping; extended xterm colors use their
# standard cube or grayscale luminance. Terminal palettes remain customizable,
# so an explicit ZSH_COLOR_SCHEME is authoritative.
_appearance_scheme_from_color_index() {
  emulate -L zsh

  local -i index=$1 red=0 green=0 blue=0 cube=0 brightness=0
  local -a levels=(0 95 135 175 215 255)

  if (( index < 16 )); then
    case $index in
      0|1|2|3|4|5|6|8|9|12|13) REPLY=dark ;;
      *) REPLY=light ;;
    esac
    return
  elif (( index < 232 )); then
    cube=$(( index - 16 ))
    red=${levels[cube / 36 + 1]}
    green=${levels[(cube / 6) % 6 + 1]}
    blue=${levels[cube % 6 + 1]}
  else
    red=$(( 8 + (index - 232) * 10 ))
    green=$red
    blue=$red
  fi

  brightness=$(( (299 * red + 587 * green + 114 * blue) / 1000 ))
  (( brightness >= 128 )) && REPLY=light || REPLY=dark
}

_appearance_detect_color_scheme() {
  emulate -L zsh

  case ${ZSH_COLOR_SCHEME:l} in
    light|dark)
      REPLY=${ZSH_COLOR_SCHEME:l}
      return
      ;;
    auto)
      # COLORFGBG is a best-effort hint because indexed colors are customizable.
      # Its final field is the background index.
      local background=${COLORFGBG##*;}
      if [[ $background == <0-255> ]]; then
        _appearance_scheme_from_color_index "$background"
        return
      fi
      ;;
  esac

  # Preserve the established palette when detection is unavailable or an
  # initializer supplied an unsupported value.
  REPLY=dark
}

# Appearance is the sole default writer. Consumers read public overrides and
# these selected defaults at invocation time; re-sourcing fills only absent keys.
typeset -gA _COMPOZSH_COLOR_FALLBACKS

_appearance_apply_defaults() {
  emulate -L zsh
  local -A highlight_defaults=() prompt_defaults=() output_defaults=()
  local -a completion_defaults=()
  local lscolors_default='' role='' key=''

  if [[ $_COMPOZSH_COLOR_SCHEME == light ]]; then
    output_defaults=(
      heading  25
      accent   24
      success  22
      warning  94
      error    160
      info     24
      muted    240
      match    127
      text     236
    )
    highlight_defaults=(
      alias              'fg=127,bold'
      global-alias       'fg=91,bold,underline'
      suffix-alias       'fg=94,bold'
      function           'fg=25,bold'
      builtin            'fg=23,bold'
      command            'fg=22,bold'
      directory          'fg=25,bold,underline'
      executable         'fg=22,bold,underline'
      symlink            'fg=126,underline'
      symlink-directory  'fg=91,bold,underline'
      hardlink           'fg=94,underline'
      file               'fg=240,underline'
      special-file       "fg=${output_defaults[error]},bold,underline"
      argument           'fg=236'
      option             'fg=25'
      keyword            'fg=94,bold'
      pipeline           'fg=127,bold'
      logical            "fg=${output_defaults[error]},bold"
      separator          'fg=240,bold'
      structure          'fg=58,underline'
      conditional        'fg=94'
      arithmetic         'fg=94,bold'
      redirection        'fg=25,bold'
      redirection-target 'fg=94,underline'
      assignment         'fg=61'
      string             'fg=58'
      variable           'fg=24'
      substitution       'fg=90'
      glob               'fg=95'
      history            'fg=161,bold'
      escape             'fg=23'
      number             'fg=94'
      comment            'fg=240'
      autosuggestion     'fg=242'
      picker-header       "fg=${output_defaults[heading]},bold"
      picker-location     'fg=25'
      picker-title        'fg=236,bold'
      picker-surface      'fg=236,bg=255'
      picker-action       'fg=231,bg=24,bold'
      picker-query        'fg=236,bg=255,bold'
      picker-match        'fg=25,bold,underline'
      picker-index        'fg=23,bold'
      picker-selected     'fg=235,bg=189,bold'
      picker-selected-inactive 'fg=236,bg=253'
      picker-focus        "fg=${output_defaults[heading]},bold"
      picker-text         "fg=${output_defaults[text]}"
      picker-architecture 'fg=25,bold'
      picker-architecture-selected 'fg=24,bold'
      picker-architecture-selected-inactive 'fg=24,bold'
      picker-size         'fg=94'
      picker-size-selected 'fg=58,bold'
      picker-size-selected-inactive 'fg=58,bold'
      picker-error        "fg=${output_defaults[error]},bold"
      picker-error-selected 'fg=88,bold'
      picker-error-selected-inactive 'fg=88,bold'
      picker-success      "fg=${output_defaults[success]},bold"
      picker-success-selected 'fg=22,bold'
      picker-success-selected-inactive 'fg=22,bold'
      picker-muted        'fg=242'
      picker-empty        "fg=${output_defaults[error]},bold"
      review-added        'fg=236,bg=194'
      review-removed      'fg=236,bg=224'
      review-keyword      'fg=90,bold'
      review-string       'fg=22'
      review-number       'fg=58'
      review-comment      'fg=240'
      review-type         'fg=24'
      review-function     'fg=25'
      review-variable     'fg=24'
    )
    prompt_defaults=(
      frame       "${output_defaults[muted]}"
      identity    24
      path        25
      project     "${output_defaults[muted]}"
      symbol      23
      success     "${output_defaults[success]}"
      warning     "${output_defaults[warning]}"
      danger      "${output_defaults[error]}"
      info        "${output_defaults[heading]}"
      detached    89
      duration    90
      environment 61
      jobs        94
      tool        25
      framework   90
      container   23
    )
    completion_defaults=(
        'di=1;38;5;25' 'ln=38;5;126' 'so=38;5;23' 'pi=38;5;94'
        'ex=1;38;5;22' 'bd=1;38;5;160' 'cd=38;5;95'
        'or=1;4;38;5;160' 'mi=1;38;5;160'
        'su=1;38;5;231;48;5;124' 'sg=1;38;5;231;48;5;90'
        'tw=38;5;236;48;5;186' 'ow=38;5;231;48;5;124'
        'st=38;5;16;48;5;179' 'ca=1;38;5;94'
    )
    lscolors_default=exfxgxdxcxbxbxhbhfadabdx
  else
    output_defaults=(
      heading  75
      accent   81
      success  71
      warning  221
      error    203
      info     111
      muted    245
      match    199
      text     252
    )
    highlight_defaults=(
      alias              'fg=171,bold'
      global-alias       'fg=177,bold,underline'
      suffix-alias       'fg=215,bold'
      function           'fg=75,bold'
      builtin            'fg=44,bold'
      command            'fg=77,bold'
      directory          'fg=39,bold,underline'
      executable         'fg=83,bold,underline'
      symlink            'fg=207,underline'
      symlink-directory  'fg=141,bold,underline'
      hardlink           'fg=214,underline'
      file               'fg=250,underline'
      special-file       "fg=${output_defaults[error]},bold,underline"
      argument           'fg=252'
      option             'fg=81'
      keyword            'fg=220,bold'
      pipeline           'fg=213,bold'
      logical            "fg=${output_defaults[error]},bold"
      separator          'fg=245,bold'
      structure          'fg=229,underline'
      conditional        'fg=221'
      arithmetic         'fg=208,bold'
      redirection        'fg=69,bold'
      redirection-target 'fg=222,underline'
      assignment         'fg=68'
      string             'fg=186'
      variable           'fg=111'
      substitution       'fg=176'
      glob               'fg=209'
      history            'fg=199,bold'
      escape             'fg=87'
      number             'fg=216'
      comment            "fg=${output_defaults[muted]}"
      autosuggestion     "fg=${output_defaults[muted]}"
      picker-header       "fg=${output_defaults[heading]},bold"
      picker-location     'fg=39'
      picker-title        'fg=252,bold'
      picker-surface      'fg=252,bg=235'
      picker-action       'fg=16,bg=81,bold'
      picker-query        'fg=87,bg=235,bold'
      picker-match        "fg=${output_defaults[accent]},bold,underline"
      picker-index        'fg=44,bold'
      picker-selected     'fg=255,bg=238,bold'
      picker-selected-inactive 'fg=252,bg=235'
      picker-focus        "fg=${output_defaults[heading]},bold"
      picker-text         "fg=${output_defaults[text]}"
      picker-architecture 'fg=117,bold'
      picker-architecture-selected 'fg=231,bold'
      picker-architecture-selected-inactive 'fg=231,bold'
      picker-size         'fg=221'
      picker-size-selected 'fg=229,bold'
      picker-size-selected-inactive 'fg=229,bold'
      picker-error        "fg=${output_defaults[error]},bold"
      picker-error-selected 'fg=224,bold'
      picker-error-selected-inactive 'fg=224,bold'
      picker-success      "fg=${output_defaults[success]},bold"
      picker-success-selected 'fg=120,bold'
      picker-success-selected-inactive 'fg=120,bold'
      picker-muted        "fg=${output_defaults[muted]}"
      picker-empty        "fg=${output_defaults[error]},bold"
      review-added        'fg=231,bg=22'
      review-removed      'fg=231,bg=52'
      review-keyword      'fg=189,bold'
      review-string       'fg=151'
      review-number       'fg=223'
      review-comment      'fg=251'
      review-type         'fg=153'
      review-function     'fg=117'
      review-variable     'fg=153'
    )
    prompt_defaults=(
      frame       "${output_defaults[muted]}"
      identity    109
      path        80
      project     "${output_defaults[muted]}"
      symbol      87
      success     "${output_defaults[success]}"
      warning     "${output_defaults[warning]}"
      danger      "${output_defaults[error]}"
      info        "${output_defaults[heading]}"
      detached    170
      duration    177
      environment 147
      jobs        215
      tool        69
      framework   176
      container   44
    )
    completion_defaults=(
        'di=1;38;5;39' 'ln=38;5;207' 'so=38;5;44' 'pi=38;5;220'
        'ex=1;38;5;83' 'bd=1;38;5;203' 'cd=38;5;209'
        'or=1;4;38;5;203' 'mi=1;38;5;203'
        'su=1;38;5;16;48;5;203' 'sg=1;38;5;16;48;5;176'
        'tw=38;5;16;48;5;220' 'ow=38;5;16;48;5;203'
        'st=38;5;16;48;5;215' 'ca=1;38;5;221'
    )
    lscolors_default=ExFxgxDxCxBxbxHbHfadabdx
  fi

  typeset -gA ZSH_HIGHLIGHT_STYLES ZSH_PROMPT_COLORS ZSH_OUTPUT_COLORS
  for role in ${(k)highlight_defaults}; do
    key="highlight:$role"
    _COMPOZSH_COLOR_FALLBACKS[$key]=${highlight_defaults[$role]}
    (( ${+ZSH_HIGHLIGHT_STYLES[$role]} )) ||
      ZSH_HIGHLIGHT_STYLES[$role]=${highlight_defaults[$role]}
  done
  for role in ${(k)prompt_defaults}; do
    key="prompt:$role"
    _COMPOZSH_COLOR_FALLBACKS[$key]=${prompt_defaults[$role]}
    (( ${+ZSH_PROMPT_COLORS[$role]} )) ||
      ZSH_PROMPT_COLORS[$role]=${prompt_defaults[$role]}
  done
  for role in ${(k)output_defaults}; do
    key="output:$role"
    _COMPOZSH_COLOR_FALLBACKS[$key]=${output_defaults[$role]}
    (( ${+ZSH_OUTPUT_COLORS[$role]} )) ||
      ZSH_OUTPUT_COLORS[$role]=${output_defaults[$role]}
  done

  # Completion's consumer registers its own deferred zstyle callback. Explicit
  # LS_COLORS is read there, so changing it does not require a new shell.
  typeset -ga _COMPOZSH_COMPLETION_LIST_COLORS=("${completion_defaults[@]}")
  _COMPOZSH_COLOR_FALLBACKS[lscolors]=$lscolors_default
  (( ${+LSCOLORS} )) || typeset -gx LSCOLORS=$lscolors_default
  return 0
}

if (( !${+_COMPOZSH_COLOR_SCHEME} )); then
  _appearance_detect_color_scheme
  typeset -g _COMPOZSH_COLOR_SCHEME=$REPLY
fi
_appearance_apply_defaults
:
