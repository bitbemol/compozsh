# Native bootable external-media creation. This peer unit is loaded by the .zshrc
# bootstrap only while its name matches .zsh.<name> inside an add-on directory.

_compozsh_help_external-device() {
  emulate -L zsh
  case ${1:-} in
    flash) _usb_help_flash; return ;;
    format) _usb_help_format; return ;;
  esac
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: external-device [--flash [media] | --format]' \
    'Choose a task for one whole external physical disk.' \
    '' \
    'Tasks:' \
    '  No arguments opens the task chooser without reading disks or images.' \
    '  --flash [media]  Create bootable media from an image or macOS installer.' \
    '  --format  Choose a drive, filesystem, and volume name.' \
    '  Enter opens the displayed task, never an erase; Option-digits require both fields empty.' \
    '  Filter tasks by name; arrows move, Ctrl-E/B focuses plan/list, Escape exits.' \
    '  Ctrl-] switches Filter / Exclude contains in candidate menus; both stay active.' \
    '  Exclusion is one case-insensitive phrase. Ctrl-U clears only the active field.' \
    '  Digits choose rows only with both fields empty; authored text stays literal.' \
    '  Ctrl-K shows the shared keys. Narrow screens retain explicit plan access.' \
    '  Every write requires its own exact-device typed confirmation afterward.' \
    '  Tasks require an interactive terminal and the shared support/ui and' \
    '  support/functions components.' \
    '  Pipes, dumb terminals, and missing UI return an error without discovery.' \
    '  --help, --flash --help, and --format --help read nothing and write nothing.' \
    '' \
    'Bootable media guide:'
  _usb_help_flash
  "${printer[@]}" '' 'Formatting guide:'
  _usb_help_format
}

_usb_task_choose() {
  emulate -L zsh
  local -a _USB_PICKER_VALUES=(flash format)
  local -a _USB_PICKER_LABELS=('Create bootable media' 'Format a drive')
  local -a _USB_PICKER_SEARCH=('flash bootable image iso img installer' 'format erase filesystem volume')
  local -a _USB_PICKER_DETAILS=(
    $'Create bootable media\n\nChoose an image or macOS installer, then an external drive.\n\nReview the exact media, disk identity, and verification plan.\nThe separate ERASE diskN confirmation is required before authorization.\nNo media or disk has been read yet.'
    $'Format a drive\n\nChoose a whole external physical disk, filesystem, and volume name.\n\nReview the exact disk identity and format.\nThe separate ERASE diskN confirmation is required before authorization.\nFormatting destroys existing partitions and data; no disk has been read yet.')
  _usb_choose 'External device / Tasks' 'Choose a task · no device selected' 'Filter tasks' 1 0 0 '' '' '' action
}

unalias external-device 2>/dev/null
external-device() {
  emulate -L zsh
  local selected='' result=0
  if (( $# == 1 )) && [[ $1 == --help ]]; then
    local -a help=(_compozsh_help_external-device)
    (( ${+functions[_compozsh_help_show]} )) && help=(_compozsh_help_show "${help[@]}")
    "${help[@]}"
    return $?
  fi
  case ${1:-} in
    --flash|--format)
      selected=${1#--}
      if (( $# == 2 )) && [[ $2 == --help ]]; then
        local -a help=(_compozsh_help_external-device "$selected")
        (( ${+functions[_compozsh_help_show]} )) && help=(_compozsh_help_show "${help[@]}")
        "${help[@]}"
        return $?
      fi
      if { [[ $selected == flash && ${2:-} != --* ]] && (( $# <= 2 )); } ||
         { [[ $selected == format ]] && (( $# == 1 )); }; then
        if [[ $selected == flash ]]; then
          _usb_flash "${@:2}"
        else
          _usb_format
        fi
        return $?
      fi
      ;;
    '')
      if (( $# == 0 )); then
        if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]] ||
           (( ! ${+functions[_zle_picker_run]} || ! ${+functions[_zle_ui_view]} || ! ${+functions[_matching_compile]} )); then
          print -u2 -r -- 'external-device: an interactive terminal and the shared support/ui and support/functions components are required'
          return 1
        fi
        local _ZLE_PICKER_SELECTED_VALUE=''
        local -a _ZLE_PICKER_BOOKMARK=()
        local -i _ZLE_PICKER_BOOKMARK_FOCUS=0
        _zle_picker_run 20 '' 1 0 _usb_task_choose
        result=$?
        (( result == 1 )) && return 0
        (( result == 0 )) || return $result
        selected=$_ZLE_PICKER_SELECTED_VALUE
        # Task dispatch occurs after the chooser relinquishes the terminal.
        case $selected in
          flash) _usb_flash; return $? ;;
          format) _usb_format; return $? ;;
          *) return 1 ;;
        esac
      fi
      ;;
  esac
  print -u2 -r -- 'usage: external-device [--flash [media] | --format]'
  return 2
}

# Limits are the only USB globals. Every capture, selection and result fact is
# a local of _usb_flash or _usb_format, so it has no global value and ends
# with the task.
typeset -gi _USB_ISO_TABLE_MAX_BYTES=16777216 _USB_ISO_TABLE_MAX_ENTRIES=65536
typeset -gi _USB_PLIST_MAX_BYTES=1048576
typeset -gi _USB_IMAGE_MAX_PER_FOLDER=200 _USB_IMAGE_MAX_INDEXED=500
typeset -gi _USB_MACOS_TARGET_MINIMUM=15000000000


_usb_image_extension_supported() {
  case ${1:e:l} in
    (iso|img) return 0 ;;
    (*) return 1 ;;
  esac
}

_usb_macos_installer_tool() {
  emulate -L zsh
  local installer=${1:A} tool=''
  REPLY=''
  [[ -d $installer && ! -L $installer ]] || return 1
  case ${installer:t} in
    (Install\ macOS\ *.app|Install\ OS\ X\ *.app) ;;
    (*) return 1 ;;
  esac
  tool="$installer/Contents/Resources/createinstallmedia"
  [[ -f $tool && ! -L $tool && -x $tool ]] || return 1
  REPLY=$tool
}

_usb_macos_installer_fingerprint() {
  emulate -L zsh
  local installer=${1:A} tool='' root_stat='' tool_stat=''
  _usb_macos_installer_tool "$installer" || return 1
  tool=$REPLY
  root_stat=$(command /usr/bin/stat -f '%d:%i:%m:%B' "$installer" 2>/dev/null) || return 1
  tool_stat=$(command /usr/bin/stat -f '%d:%i:%z:%m:%B' "$tool" 2>/dev/null) || return 1
  REPLY="$root_stat|$tool_stat"
}

# Apple identity comes only from requirements this file passes to codesign; a
# signer chooses its own designated requirement, so it is never consulted. A
# signature that no longer validates (an untrusted or expired chain) fails.
_usb_codesign_is_apple() {
  emulate -L zsh
  command /usr/bin/codesign --verify --strict -R '=anchor apple' -- "$1" \
    >/dev/null 2>&1 || return 1
}

# The installer application may also carry Apple's Mac App Store signature;
# the createinstallmedia tool that runs as root must be Apple's own code.
_usb_codesign_is_apple_application() {
  emulate -L zsh
  command /usr/bin/codesign --verify --strict \
    -R '=anchor apple or (anchor apple generic and certificate leaf[field.1.2.840.113635.100.6.1.9] /* exists */)' \
    -- "$1" >/dev/null 2>&1 || return 1
}

_usb_macos_codesign_verify() {
  emulate -L zsh
  local installer=$1 tool=''
  _usb_macos_installer_tool "$installer" || return 1
  tool=$REPLY
  _usb_codesign_is_apple_application "$installer" || return 1
  _usb_codesign_is_apple "$tool"
}

_usb_macos_installer_revalidate() {
  emulate -L zsh
  local installer=$1 expected=$2
  _usb_macos_installer_fingerprint "$installer" || return 1
  [[ $REPLY == "$expected" ]] || return 1
  _usb_macos_codesign_verify "$installer"
}

_usb_hdiutil_attach_readonly() {
  emulate -L zsh
  local image=$1 mount_point=$2 output='' line='' device=''
  local -i attach_status=0
  # A failed detach retains ownership for the outer recovery boundary. Never
  # overwrite that identity by beginning another inspection first.
  if [[ -n $_USB_INSPECT_DEVICE || -n $_USB_INSPECT_MOUNT ]]; then
    _usb_inspect_cleanup || return 2
  fi
  _USB_INSPECT_DEVICE='' _USB_INSPECT_MOUNT=''
  output=$(command /usr/bin/hdiutil attach -readonly -nobrowse -noautoopen \
    -mountpoint "$mount_point" "$image" 2>/dev/null)
  attach_status=$?
  for line in "${(f)output}"; do
    device=${line%%[[:space:]]*}
    [[ $device == /dev/disk<-> ]] || continue
    _USB_INSPECT_DEVICE=${device#/dev/}
    break
  done
  if (( attach_status != 0 )); then
    if [[ -n $device ]] &&
        ! _usb_hdiutil_detach "${device#/dev/}" >/dev/null 2>&1; then
      _USB_INSPECT_DEVICE=${device#/dev/}
      _USB_INSPECT_MOUNT=$mount_point
      return 2
    fi
    _USB_INSPECT_DEVICE='' _USB_INSPECT_MOUNT=''
    return 1
  fi
  [[ $_USB_INSPECT_DEVICE == disk<-> && -d $mount_point ]] || return 1
  _USB_INSPECT_MOUNT=$mount_point
}

_usb_hdiutil_detach() {
  command /usr/bin/hdiutil detach "/dev/$1"
}

# Detach before removing an empty, validated mount directory. The returned
# pair contains resources still owned after partial failure, for caller retry.
_usb_mount_cleanup() {
  emulate -L zsh
  local device=$1 mount_point=$2 prefix=$3 temp_root=${TMPDIR:-/tmp}
  local -i cleanup_status=0
  reply=("$device" "$mount_point")
  if [[ -n $device ]]; then
    if _usb_hdiutil_detach "$device" >/dev/null 2>&1; then
      reply[1]=''
    else
      cleanup_status=1
    fi
  fi
  if (( cleanup_status == 0 )) &&
      [[ -n $mount_point && -d $mount_point && ! -L $mount_point &&
        ${mount_point:t} == "$prefix".* && ${mount_point:h:A} == ${temp_root:A} ]]; then
    if command /bin/rmdir "$mount_point" 2>/dev/null; then
      reply[2]=''
    else
      cleanup_status=1
    fi
  fi
  return $cleanup_status
}

_usb_inspect_cleanup() {
  emulate -L zsh
  local device=${1:-$_USB_INSPECT_DEVICE} mount_point=${2:-$_USB_INSPECT_MOUNT}
  local -a reply=()
  _usb_mount_cleanup "$device" "$mount_point" compozsh-usb-inspect
  local -i result=$?
  [[ $_USB_INSPECT_DEVICE == "$device" ]] && _USB_INSPECT_DEVICE=$reply[1]
  [[ $_USB_INSPECT_MOUNT == "$mount_point" ]] && _USB_INSPECT_MOUNT=$reply[2]
  return $result
}

# Classification only needs to decide whether raw flashing must be refused.
# Check a fixed set of canonical setup markers without enumerating or statting
# the complete mounted tree.
_usb_windows_setup_markers_detect() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB
  local root=${1:A}
  local -a markers=()
  [[ -d $root && ! -L $root ]] || return 2
  markers=(
    "$root"/(#i)sources/boot.wim(N.)
    "$root"/(#i)sources/install.wim(N.)
    "$root"/(#i)sources/install.esd(N.)
    "$root"/(#i)sources/install.swm(N.)
    "$root"/(#i)efi/microsoft/boot/bcd(N.))
  (( ${#markers} ))
}

# A Windows installer ISO is identified from canonical setup markers, not from
# its filename. The temporary mount is read-only; a failed detach stays
# recorded for retry before the next inspection and when the workspace exits.
_usb_windows_installer_detect() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB
  local image=$1 temp_root=${TMPDIR:-/tmp} mount_point='' device=''
  local -a reply=()
  local -i detected=1 attach_status=0 cleanup_status=0
  [[ ${image:e:l} == iso ]] || return 1
  mount_point=$(command /usr/bin/mktemp -d \
    "${temp_root%/}/compozsh-usb-inspect.XXXXXX" 2>/dev/null) || return 2
  {
    _usb_hdiutil_attach_readonly "$image" "$mount_point"
    attach_status=$?
    device=$_USB_INSPECT_DEVICE
    if (( attach_status == 0 )); then
      _usb_windows_setup_markers_detect "$mount_point"
      detected=$?
    fi
  } always {
    if [[ -z $_USB_INSPECT_MOUNT || $_USB_INSPECT_MOUNT == "$mount_point" ]]; then
      _usb_inspect_cleanup "$device" "$mount_point" || cleanup_status=1
    else
      # An attach refused over an earlier inspection's retained ownership
      # leaves that identity recorded; remove only this call's empty mount.
      _usb_mount_cleanup '' "$mount_point" compozsh-usb-inspect || cleanup_status=1
    fi
  }
  # Inspection is optional for an ISO that can still be written as a raw disk
  # image. A mount refusal therefore means "not identified as Windows". Once
  # hdiutil did attach a device, however, failed cleanup is a hard stop because
  # the probe no longer owns a known-clean temporary state.
  (( cleanup_status == 0 )) || return 2
  (( attach_status == 2 )) && return 2
  (( attach_status == 0 )) || return 1
  return $detected
}

_usb_windows_filename_hint() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local name=${1:t:l}
  [[ ${name:e} == iso ]] || return 1
  case $name in
    (win10.iso|win10[_-]*.iso|win11.iso|win11[_-]*.iso|\
      windows10.iso|windows10[_-]*.iso|windows11.iso|windows11[_-]*.iso|\
      windows[_-]10*.iso|windows[_-]11*.iso|\
      windowsserver*.iso|windows[_-]server*.iso)
      return 0 ;;
  esac
  return 1
}

_usb_windows_iso_table_detect() {
  emulate -L zsh
  local image=${1:A} temp_root=${TMPDIR:-/tmp} capture_file=''
  local raw_size='' line='' folded=''
  local -a command_statuses=()
  local -i result=2 entry_count=0
  [[ -f $image && ! -L $image && ${image:e:l} == iso &&
    -x /usr/bin/tar && -x /usr/bin/head ]] || return 2
  capture_file=$(command /usr/bin/mktemp \
    "${temp_root%/}/compozsh-usb-iso.XXXXXX" 2>/dev/null) || return 2
  {
    command /usr/bin/tar -tf "$image" 2>/dev/null |
      command /usr/bin/head -c $(( _USB_ISO_TABLE_MAX_BYTES + 1 )) >| "$capture_file"
    command_statuses=("${pipestatus[@]}")
    raw_size=$(command /usr/bin/stat -f '%z' "$capture_file" 2>/dev/null)
    [[ $raw_size == <-> ]] || raw_size=0
    if (( command_statuses[1] == 0 && command_statuses[2] == 0 &&
          raw_size > 0 && raw_size <= _USB_ISO_TABLE_MAX_BYTES )); then
      result=1
      while IFS= read -r line; do
        (( ++entry_count <= _USB_ISO_TABLE_MAX_ENTRIES )) || {
          result=2
          break
        }
        folded=${line:l}
        folded=${folded#./}
        folded=${folded%/}
        case $folded in
          (sources/boot.wim|sources/boot.wim\;<->|\
            sources/install.wim|sources/install.wim\;<->|\
            sources/install.esd|sources/install.esd\;<->|\
            sources/install.swm|sources/install.swm\;<->|\
            efi/microsoft/boot/bcd|efi/microsoft/boot/bcd\;<->)
            result=0
            break ;;
        esac
      done < "$capture_file"
    fi
  } always {
    if [[ -n $capture_file && ${capture_file:t} == compozsh-usb-iso.* &&
          ${capture_file:h:A} == ${temp_root:A} ]]; then
      command /bin/rm -f -- "$capture_file"
    fi
  }
  return $result
}

_usb_media_kind_capture() {
  emulate -L zsh
  local media_path=${1:A} detect_status=0
  _USB_MEDIA_ERROR=''
  if _usb_macos_installer_tool "$media_path" >/dev/null; then
    REPLY=macos-installer
    return 0
  fi
  _usb_image_extension_supported "$media_path" || {
    _USB_MEDIA_ERROR='choose a readable .iso, .img, or full Install macOS application'
    return 2
  }
  if [[ ${media_path:e:l} == iso ]]; then
    # Officially named Windows media can only reach the unsupported terminal
    # screen, so refusing it from a conservative filename prefix is safe and
    # avoids macOS's comparatively slow temporary attach/detach cycle. Renamed
    # or ambiguous ISOs retain the structural inspection below.
    if _usb_windows_filename_hint "$media_path"; then
      REPLY=windows-installer
      return 0
    fi
    _usb_windows_iso_table_detect "$media_path"
    detect_status=$?
    if (( detect_status == 0 )); then
      REPLY=windows-installer
      return 0
    elif (( detect_status == 1 )); then
      REPLY=raw-image
      return 0
    fi
    _usb_windows_installer_detect "$media_path"
    detect_status=$?
    if (( detect_status == 0 )); then
      REPLY=windows-installer
      return 0
    elif (( detect_status == 2 )); then
      _USB_MEDIA_ERROR='macOS could not inspect this ISO safely; nothing can be written'
      return 1
    fi
  fi
  REPLY=raw-image
}

_usb_image_architecture_hint() {
  emulate -L zsh
  local name=${1:t:l}
  case $name in
    (*arm64*|*aarch64*) REPLY=arm64 ;;
    (*amd64*|*x64*|*x86_64*|*x86-64*) REPLY=x86_64 ;;
    (proxmox-ve_*.iso) REPLY=x86_64 ;;
    (*) REPLY=unknown ;;
  esac
}

_usb_image_architecture_label() {
  case $1 in
    (arm64) REPLY='ARM64 · inferred from filename' ;;
    (x86_64) REPLY='Intel/AMD x86-64 · inferred from filename' ;;
    (multi-architecture) REPLY='x64 + ARM64 · detected in Windows media' ;;
    (*) REPLY='Not declared in filename' ;;
  esac
}

_usb_image_architecture_short_label() {
  case $1 in
    (arm64) REPLY='ARM64' ;;
    (x86_64) REPLY='x86-64' ;;
    (multi-architecture) REPLY='x64 + ARM64' ;;
    (*) REPLY='Architecture not detected' ;;
  esac
}

_usb_image_stat_capture() {
  emulate -L zsh
  local file_path=$1 raw=''
  local -a fields=()
  _USB_STAT_FINGERPRINT=''
  _USB_STAT_SIZE=0 _USB_STAT_MODIFIED=0 _USB_STAT_CREATED=0
  [[ -f $file_path && ! -L $file_path && -r $file_path ]] || return 1
  raw=$(command /usr/bin/stat -f '%d:%i:%z:%m:%B' "$file_path" 2>/dev/null) || return
  fields=("${(@s/:/)raw}")
  (( ${#fields} == 5 )) || return 1
  [[ ${fields[3]} == <-> && ${fields[4]} == <-> && ${fields[5]} == <-> ]] || return 1
  _USB_STAT_SIZE=${fields[3]}
  _USB_STAT_MODIFIED=${fields[4]}
  _USB_STAT_CREATED=${fields[5]}
  _USB_STAT_FINGERPRINT=$raw
}

_usb_image_fingerprint() {
  emulate -L zsh
  _usb_image_stat_capture "$1" || return 1
  REPLY=$_USB_STAT_FINGERPRINT
}

_usb_format_epoch() {
  emulate -L zsh
  local epoch=${1:-0}
  REPLY='Unavailable'
  [[ $epoch == <-> ]] && (( epoch > 0 )) || return 0
  if zmodload -F zsh/datetime b:strftime 2>/dev/null &&
      strftime -s REPLY '%Y-%m-%d %H:%M %Z' "$epoch" 2>/dev/null; then
    return 0
  fi
  REPLY=$epoch
}

# Pure media row label: the name, then each (role, text) segment after " · ".
# reply=(label, highlights); a segment with a role gets a "start:end:role" span,
# space separated, counting each separator as three characters.
_usb_media_label() {
  emulate -L zsh
  local label=$1 role='' text='' highlights=''
  local -i start=0 end=${#1}
  shift
  reply=()
  (( $# % 2 == 0 )) || return 2
  for role text in "$@"; do
    label+=" · $text"
    start=$(( end + 3 )) end=$(( end + 3 + ${#text} ))
    [[ -z $role ]] || highlights+=" $start:$end:$role"
  done
  reply=("$label" "${highlights# }")
}

_usb_image_add() {
  emulate -L zsh
  local image_path=${1:a} fingerprint='' raw_size='' size_label=''
  local created_label='' modified_label='' format='' architecture='' architecture_label=''
  local architecture_short=''
  local -a segments=() reply=()
  [[ ! -L $image_path ]] || return 1
  image_path=${image_path:A}
  [[ ${#image_path} -le 4096 && $image_path != *[[:cntrl:]]* ]] || return 1
  _usb_image_extension_supported "$image_path" || return 1
  # Expand lookups first: a subscript in arithmetic text is reparsed, so `]`
  # or $(...) in a file name would run as code.
  (( ${_USB_IMAGE_PATHS[(Ie)$image_path]} )) && return 0
  _usb_image_stat_capture "$image_path" || return 1
  fingerprint=$_USB_STAT_FINGERPRINT
  raw_size=$_USB_STAT_SIZE
  (( raw_size > 17408 )) || return 1
  REPLY='size unavailable'
  (( ${+functions[_usb_human_size]} )) && _usb_human_size "$raw_size"
  size_label=$REPLY
  format="${image_path:e:u} raw disk image"
  _usb_format_epoch "$_USB_STAT_CREATED"
  created_label=$REPLY
  _usb_format_epoch "$_USB_STAT_MODIFIED"
  modified_label=$REPLY
  _usb_image_architecture_hint "$image_path"
  architecture=$REPLY
  _usb_image_architecture_label "$architecture"
  architecture_label=$REPLY
  _usb_image_architecture_short_label "$architecture"
  architecture_short=$REPLY
  [[ $architecture == unknown ]] ||
    segments=(picker-architecture "$architecture_short")
  _usb_media_label "${image_path:t}" "${segments[@]}" picker-size "$size_label"
  _USB_IMAGE_PATHS+=("$image_path")
  _USB_IMAGE_LABELS+=("$reply[1]")
  _USB_IMAGE_HIGHLIGHTS+=("$reply[2]")
  _USB_IMAGE_DETAILS+=("${image_path:t}"$'\n\nPath\n  '"$image_path"$'\n\n'"Format · $format"$'\n'"Architecture · $architecture_label"$'\n'"Size · $size_label"$'\n'"Created · $created_label"$'\n'"Modified · $modified_label")
  _USB_IMAGE_SIZES+=("$raw_size")
  _USB_IMAGE_FINGERPRINTS+=("$fingerprint")
  _USB_IMAGE_CREATED+=("$_USB_STAT_CREATED")
  _USB_IMAGE_MODIFIED+=("$_USB_STAT_MODIFIED")
  _USB_IMAGE_KINDS+=(raw-image)
}

_usb_macos_installer_add() {
  emulate -L zsh
  local installer_path=${1:A} fingerprint='' root_stat='' filename=''
  local created_label='' modified_label=''
  local -a fields=() reply=()
  [[ ${#installer_path} -le 4096 && $installer_path != *[[:cntrl:]]* ]] || return 1
  (( ${_USB_IMAGE_PATHS[(Ie)$installer_path]} )) && return 0
  _usb_macos_installer_fingerprint "$installer_path" || return 1
  fingerprint=$REPLY
  # Reuse the root observation already retained in this exact fingerprint.
  root_stat=${fingerprint%%|*}
  fields=("${(@s/:/)root_stat}")
  (( ${#fields} == 4 )) || return 1
  [[ ${fields[3]} == <-> && ${fields[4]} == <-> ]] || return 1
  filename=${installer_path:t}
  _usb_format_epoch "${fields[4]}"
  created_label=$REPLY
  _usb_format_epoch "${fields[3]}"
  modified_label=$REPLY
  _usb_media_label "$filename" picker-architecture 'macOS installer' '' '16 GB-class target'
  _USB_IMAGE_PATHS+=("$installer_path")
  _USB_IMAGE_LABELS+=("$reply[1]")
  _USB_IMAGE_HIGHLIGHTS+=("$reply[2]")
  _USB_IMAGE_DETAILS+=("$filename"$'\n\nPath\n  '"$installer_path"$'\n\n''Format · Full macOS installer application'$'\n''Handler · Apple createinstallmedia'$'\n''Target · 16 GB-class minimum; Apple reports if more is required'$'\n'"Created · $created_label"$'\n'"Modified · $modified_label")
  _USB_IMAGE_SIZES+=("$_USB_MACOS_TARGET_MINIMUM")
  _USB_IMAGE_FINGERPRINTS+=("$fingerprint")
  _USB_IMAGE_CREATED+=("${fields[4]}")
  _USB_IMAGE_MODIFIED+=("${fields[3]}")
  _USB_IMAGE_KINDS+=(macos-installer)
}

_usb_media_add() {
  emulate -L zsh
  local original=$1 media_path=''
  [[ ! -L $original ]] || return 1
  media_path=${original:A}
  if _usb_macos_installer_tool "$media_path" >/dev/null; then
    _usb_macos_installer_add "$media_path"
  else
    _usb_image_add "$media_path"
  fi
}

_usb_images_sort_newest() {
  emulate -L zsh
  local -i index=0 source_index=0 epoch=0
  local record='' key=''
  local -a records=() paths=() labels=() highlights=() details=() sizes=() fingerprints=()
  local -a created=() modified=() kinds=()
  for (( index = 1; index <= ${#_USB_IMAGE_PATHS}; ++index )); do
    epoch=${_USB_IMAGE_CREATED[index]:-${_USB_IMAGE_MODIFIED[index]:-0}}
    (( epoch > 0 )) || epoch=${_USB_IMAGE_MODIFIED[index]:-0}
    printf -v key '%020d:%010d' "$epoch" "$index"
    records+=("$key")
  done
  records=("${(@O)records}")
  for record in "${records[@]}"; do
    source_index=$(( 10#${record##*:} ))
    paths+=("${_USB_IMAGE_PATHS[source_index]}")
    labels+=("${_USB_IMAGE_LABELS[source_index]}")
    highlights+=("${_USB_IMAGE_HIGHLIGHTS[source_index]}")
    details+=("${_USB_IMAGE_DETAILS[source_index]}")
    sizes+=("${_USB_IMAGE_SIZES[source_index]}")
    fingerprints+=("${_USB_IMAGE_FINGERPRINTS[source_index]}")
    created+=("${_USB_IMAGE_CREATED[source_index]}")
    modified+=("${_USB_IMAGE_MODIFIED[source_index]}")
    kinds+=("${_USB_IMAGE_KINDS[source_index]}")
  done
  _USB_IMAGE_PATHS=("${paths[@]}") _USB_IMAGE_LABELS=("${labels[@]}")
  _USB_IMAGE_HIGHLIGHTS=("${highlights[@]}")
  _USB_IMAGE_DETAILS=("${details[@]}") _USB_IMAGE_SIZES=("${sizes[@]}")
  _USB_IMAGE_FINGERPRINTS=("${fingerprints[@]}")
  _USB_IMAGE_CREATED=("${created[@]}") _USB_IMAGE_MODIFIED=("${modified[@]}")
  _USB_IMAGE_KINDS=("${kinds[@]}")
}

_usb_spotlight_run() {
  command /usr/bin/mdfind "$@"
}

# Capture a bounded Spotlight snapshot beneath home. Finder indexing supplies
# descendant discovery without a synchronous recursive filesystem walk.
_usb_spotlight_images_capture() {
  emulate -L zsh
  local root=${HOME:A} found_path='' resolved='' completion=''
  local query='(kMDItemFSName == "*.iso"cd || kMDItemFSName == "*.img"cd)'
  local -i considered=0 source_status=2 stopped=0
  [[ -x /usr/bin/mdfind && -d $root ]] || return 2
  while IFS= read -r -d '' found_path; do
    if [[ -z $found_path ]]; then
      IFS= read -r -d '' completion
      [[ $completion == 0 ]] && source_status=0
      break
    fi
    (( ++considered > _USB_IMAGE_MAX_INDEXED )) && {
      _USB_IMAGE_CAPTURE_PARTIAL=1
      stopped=1
      break
    }
    [[ $found_path == /* && -f $found_path && ! -L $found_path ]] || continue
    resolved=${found_path:A}
    [[ $resolved == $root/* ]] || continue
    _usb_image_add "$resolved"
  done < <(_usb_spotlight_run -0 -onlyin "$root" "$query" 2>/dev/null
    print -rn -- $'\0'"$?"$'\0' 2>/dev/null)
  (( stopped || source_status == 0 )) || return 2
  return 0
}

# With no explicit input, merge a bounded Finder-index snapshot beneath home
# with shallow current-folder and Downloads reads for newly arrived images.
_usb_images_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB
  local explicit=${1:-} candidate=''
  local -a candidates=() installers=()
  _USB_CAPTURE_ERROR=''
  _USB_IMAGE_PATHS=() _USB_IMAGE_LABELS=() _USB_IMAGE_DETAILS=()
  _USB_IMAGE_HIGHLIGHTS=()
  _USB_IMAGE_SIZES=() _USB_IMAGE_FINGERPRINTS=()
  _USB_IMAGE_CREATED=() _USB_IMAGE_MODIFIED=()
  _USB_IMAGE_KINDS=()
  _USB_IMAGE_CAPTURE_SCOPE='' _USB_IMAGE_CAPTURE_PARTIAL=0

  if [[ -n $explicit ]]; then
    if [[ -d $explicit && ! -L $explicit ]]; then
      _usb_macos_installer_tool "$explicit" >/dev/null || {
        _USB_CAPTURE_ERROR='the application is not a complete Install macOS app with createinstallmedia'
        return 2
      }
    else
      _usb_image_extension_supported "$explicit" || {
        if [[ ${explicit:e:l} == dmg || ${explicit:e:l} == pkg ]]; then
          _USB_CAPTURE_ERROR='open the macOS .dmg or .pkg first so it installs the full Install macOS app, then select that app'
        else
          _USB_CAPTURE_ERROR='the media must be a regular .iso or .img file, or a full Install macOS application'
        fi
        return 2
      }
    fi
    _usb_media_add "$explicit" || _usb_media_add "$explicit" || {
      _USB_CAPTURE_ERROR='the selected media must be readable, complete, and must not be a symbolic link'
      return 1
    }
    _USB_IMAGE_CAPTURE_SCOPE='explicit media path'
    return 0
  fi

  candidates=(
    "$PWD"/*.(#i)(iso|img)(N.[1,$_USB_IMAGE_MAX_PER_FOLDER])
    "$HOME/Downloads"/*.(#i)(iso|img)(N.[1,$_USB_IMAGE_MAX_PER_FOLDER]))
  for candidate in "${candidates[@]}"; do
    [[ ! -L $candidate ]] || continue
    _usb_image_extension_supported "$candidate" || continue
    _usb_image_add "$candidate"
  done
  installers=(
    /Applications/Install\ (macOS|OS\ X)\ *.app(N/)
    "$HOME/Applications"/Install\ (macOS|OS\ X)\ *.app(N/))
  for candidate in "${installers[@]}"; do
    [[ ! -L $candidate ]] || continue
    _usb_macos_installer_add "$candidate"
  done
  if _usb_spotlight_images_capture; then
    _USB_IMAGE_CAPTURE_SCOPE='Spotlight index under ~ + current folder + ~/Downloads + installed macOS installers'
    (( _USB_IMAGE_CAPTURE_PARTIAL )) && _USB_IMAGE_CAPTURE_SCOPE+=' · partial snapshot'
  else
    _USB_IMAGE_CAPTURE_SCOPE='current folder + ~/Downloads + installed macOS installers · Spotlight index unavailable'
    _USB_IMAGE_CAPTURE_PARTIAL=1
  fi
  _usb_images_sort_newest
  return 0
}

# Terminal.app drags shell-quote paths containing spaces. Remove one quoting
# layer as data only; never evaluate substitutions, parameters, or commands.
_usb_image_from_query() {
  emulate -L zsh
  local query=$1 candidate='' decoded=''
  local -a candidates=()
  [[ -n $query && $query != *[[:cntrl:]]* ]] || return 2
  decoded=${(Q)query}
  [[ $decoded != *[[:cntrl:]]* ]] || return 2
  candidates=("$query")
  [[ $decoded == "$query" ]] || candidates+=("$decoded")
  for candidate in "${candidates[@]}"; do
    if [[ $candidate == '~/'* ]]; then
      candidate="$HOME/${candidate#\~/}"
    fi
    if _usb_media_add "$candidate"; then
      REPLY=${candidate:A}
      return 0
    fi
  done
  return 1
}

_usb_read_image_path() {
  _zle_ui_view query _usb_image_path_view "$@"
}

_usb_image_path_view() {
  emulate -L zsh
  local subtitle=${1:-'Drop an .iso, .img, or full Install macOS app, then press Return'}
  _ZLE_PICKER_TITLE='External device / Flash / Add media' _ZLE_PICKER_SUBTITLE=$subtitle
  _ZLE_PICKER_QUERY_LABEL='Media path' _ZLE_PICKER_INSPECT_ACTION=add
  _ZLE_PICKER_BROWSE_LABEL='drop or paste one exact path · Return validates'
  _ZLE_PICKER_EMPTY_LINES=(
    'Drag a regular .iso or .img file from Finder into this field.'
    'A pasted absolute, home-relative, or current-folder path also works.'
    'The path is treated only as data; no shell text is evaluated.'
    'Press Return to validate and add the exact image to this workspace.')
  _zle_picker_loop '' 1
}

_usb_checksum_parse() {
  emulate -L zsh
  local IFS=$' \t\n' input=$1 scrubbed='' token='' digest=''
  local -a tokens=()
  local -i matches=0
  _USB_CHECKSUM_ALGORITHM=''
  (( ${#input} > 0 && ${#input} <= 4096 )) || return 1
  [[ $input != *$'\n'* && $input != *$'\r'* ]] || return 1
  scrubbed=${input//[^0-9A-Fa-f]/ }
  tokens=(${=scrubbed})
  for token in "${tokens[@]}"; do
    case ${#token} in
      (64|128)
        digest=${token:l}
        (( ++matches )) ;;
    esac
  done
  (( matches == 1 )) || return 1
  (( ${#digest} == 64 )) && _USB_CHECKSUM_ALGORITHM=256 || _USB_CHECKSUM_ALGORITHM=512
  REPLY=$digest
}

_usb_read_checksum() {
  _zle_ui_view query _usb_checksum_view "$@"
}

_usb_checksum_view() {
  emulate -L zsh
  local subtitle=${1:-'Paste one SHA-256 or SHA-512 checksum, then press Return'}
  local initial=${2:-}
  _ZLE_PICKER_TITLE='External device / Flash / Image checksum' _ZLE_PICKER_SUBTITLE=$subtitle
  _ZLE_PICKER_QUERY_LABEL='Checksum' _ZLE_PICKER_INSPECT_ACTION=add
  _ZLE_PICKER_BROWSE_LABEL='optional integrity check · Return validates'
  _ZLE_PICKER_EMPTY_LINES=(
    'Paste the checksum published for the selected image.'
    'Bare hexadecimal, shasum output, and BSD SHA lines are accepted.'
    'SHA-256 uses 64 hexadecimal characters; SHA-512 uses 128.'
    'The full image is checked before the external drive is changed.'
    'After writing, the same algorithm checks the immutable payload region.')
  _zle_picker_loop "$initial" 1
}

# Custom Path is a bounded file browser rather than a shell-like path parser.
# It starts at home, exposes the current path, and retains Finder-style
# hierarchy movement while showing folders, raw images, and full macOS installers.
_usb_browser_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB
  local location=${1:A} candidate='' raw_size='' size_label=''
  local -a directories=() images=() installers=() reply=()
  local -i inspected=0
  _USB_BROWSER_PARTIAL=0
  [[ -d $location && -r $location ]] || return 1
  _USB_PICKER_VALUES=(paste-path)
  _USB_PICKER_LABELS=('Paste or drop an exact media path…')
  _USB_PICKER_HIGHLIGHTS=('')
  _USB_PICKER_SEARCH=(paste drop drag finder exact path)
  _USB_PICKER_DETAILS=('')
  if (( ${_USB_BROWSER_SHOW_HIDDEN:-0} )); then
    directories=("$location"/*(ND/[1,501]))
    images=("$location"/*.(#i)(iso|img)(ND.[1,501]))
    installers=("$location"/Install\ (macOS|OS\ X)\ *.app(ND/[1,501]))
  else
    directories=("$location"/*(N/[1,501]))
    images=("$location"/*.(#i)(iso|img)(N.[1,501]))
    installers=("$location"/Install\ (macOS|OS\ X)\ *.app(N/[1,501]))
  fi
  (( ${#directories} + ${#images} + ${#installers} > 500 )) && _USB_BROWSER_PARTIAL=1
  for candidate in "${directories[@]}"; do
    (( ++inspected > 500 )) && break
    [[ ! -L $candidate ]] || continue
    _usb_macos_installer_tool "$candidate" >/dev/null && continue
    _USB_PICKER_VALUES+=("${candidate:A}/")
    _USB_PICKER_LABELS+=("${candidate:t}/")
    _USB_PICKER_HIGHLIGHTS+=('')
    _USB_PICKER_SEARCH+=("${candidate:t} folder")
    _USB_PICKER_DETAILS+=('')
  done
  for candidate in "${installers[@]}"; do
    (( ++inspected > 500 )) && break
    [[ ! -L $candidate ]] || continue
    _usb_macos_installer_tool "$candidate" >/dev/null || continue
    _usb_media_label "${candidate:t}" picker-architecture 'macOS installer'
    _USB_PICKER_VALUES+=("${candidate:A}")
    _USB_PICKER_LABELS+=("$reply[1]")
    _USB_PICKER_HIGHLIGHTS+=("$reply[2]")
    _USB_PICKER_SEARCH+=("${candidate:t} macos installer createinstallmedia")
    _USB_PICKER_DETAILS+=('Apple createinstallmedia will erase the selected external disk and build the bootable installer.')
  done
  for candidate in "${images[@]}"; do
    (( ++inspected > 500 )) && break
    [[ ! -L $candidate ]] || continue
    raw_size=$(command /usr/bin/stat -f '%z' "$candidate" 2>/dev/null) || continue
    [[ $raw_size == <-> ]] || continue
    (( raw_size > 17408 )) || continue
    REPLY='size unavailable'
    (( ${+functions[_usb_human_size]} )) && _usb_human_size "$raw_size"
    size_label=$REPLY
    _usb_media_label "${candidate:t}" picker-size "$size_label"
    _USB_PICKER_VALUES+=("${candidate:A}")
    _USB_PICKER_LABELS+=("$reply[1]")
    _USB_PICKER_HIGHLIGHTS+=("$reply[2]")
    _USB_PICKER_SEARCH+=("${candidate:t} image")
    _USB_PICKER_DETAILS+=('')
  done
}

# One pass of the browser view: its configuration lives in the view's scope.
_usb_browse_choose() {
  emulate -L zsh
  local hidden_label='Hidden: off'
  (( ${_USB_BROWSER_SHOW_HIDDEN:-0} )) && hidden_label='Hidden: on'
  _ZLE_PICKER_QUERY_LABEL='Filter this folder'
  _ZLE_PICKER_INSPECT_ACTION=choose _ZLE_PICKER_CANCEL_LABEL=back
  _ZLE_PICKER_BROWSE_LABEL="$hidden_label · ← parent · → open folder · Return select"
  _ZLE_PICKER_COLLECTOR=_usb_picker_collect
  _ZLE_PICKER_DIGIT_SELECT=0 _ZLE_PICKER_HIERARCHY_ENABLED=1
  _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  _ZLE_PICKER_LABEL_HIGHLIGHTS=()
  local -i index=0
  for (( index = 1; index <= ${#_USB_PICKER_VALUES}; ++index )); do
    [[ -n ${_USB_PICKER_HIGHLIGHTS[index]-} ]] &&
      _ZLE_PICKER_LABEL_HIGHLIGHTS[${_USB_PICKER_VALUES[index]}]=${_USB_PICKER_HIGHLIGHTS[index]}
  done
  local -a view_bookmark=("${_USB_BROWSER_RESUME[1]-}" \
    "${_USB_BROWSER_RESUME[2]:-1}" "${_USB_BROWSER_RESUME[3]:-0}" \
    "${_USB_BROWSER_RESUME[4]-}" "${_USB_BROWSER_RESUME[5]:-0}" "${_USB_BROWSER_RESUME[6]:-0}" 0)
  _zle_picker_loop --bookmark view_bookmark 20
}

# The browser is one view: its title, location, trail and capabilities end
# with it. REPLY, the final action, value and bookmark go to the caller.
_usb_browse_image_path() {
  _zle_ui_view choice _usb_browse_image_path_view "$@"
}

_usb_browse_image_path_view() {
  emulate -L zsh
  local location=${HOME:A} selected='' display_path='' path_subtitle=''
  _ZLE_PICKER_TITLE='External device / Flash · Step 1 of 3'
  local -i _USB_BROWSER_PARTIAL=0 _USB_BROWSER_SHOW_HIDDEN=0
  local -a _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_HIGHLIGHTS=()
  local -a _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
  local -a _USB_BROWSER_RESUME=('' 1 0) _USB_BROWSER_LOCATION_STACK=()
  local -a _USB_BROWSER_QUERY_STACK=() _USB_BROWSER_INDEX_STACK=() _USB_BROWSER_OFFSET_STACK=()
  local -a exclusion_stack=() exclusion_focus_stack=() exclusion_shown_stack=()
  local -a components=() bookmark=()
  local component='' indent=''
  local -i result=0
  while true; do
    _usb_browser_capture "$location" || return 1
    if [[ $location == ${HOME:A} ]]; then
      display_path='~/'
    elif [[ $location == ${HOME:A}/* ]]; then
      display_path="~/${location#${HOME:A}/}/"
    elif [[ $location == / ]]; then
      display_path='/'
    else
      display_path="$location/"
    fi
    (( _USB_BROWSER_PARTIAL )) && display_path+=' · first 500 items'
    _ZLE_PICKER_SUBTITLE=$display_path
    _ZLE_PICKER_TRAIL=(Location)
    components=("${(@s:/:)display_path%% · first 500 items}")
    indent=''
    for component in "${components[@]}"; do
      [[ -n $component ]] || continue
      _ZLE_PICKER_TRAIL+=("$indent$component")
      (( ${#indent} < 6 )) && indent+='  '
    done
    while true; do
      _usb_browse_choose
      result=$?
      # Right and Tab only enter folders. On media and the paste row they stay
      # inert: same snapshot, filter and selection, no recapture.
      (( result == 0 )) && [[ $_ZLE_PICKER_ACTION == descend &&
        $_ZLE_PICKER_SELECTED_VALUE != */ ]] || break
      _USB_BROWSER_RESUME=("${_ZLE_PICKER_BOOKMARK[@]}")
      zle && zle beep
    done
    (( result == 1 )) && return 1
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    bookmark=("${_ZLE_PICKER_BOOKMARK[@]}")
    if [[ $_ZLE_PICKER_ACTION == toggle-hidden ]]; then
      _USB_BROWSER_SHOW_HIDDEN=$(( !_USB_BROWSER_SHOW_HIDDEN ))
      _USB_BROWSER_RESUME=("${bookmark[@]}")
      continue
    fi
    if [[ $_ZLE_PICKER_ACTION == parent ]]; then
      if (( ${#_USB_BROWSER_LOCATION_STACK} )); then
        location=${_USB_BROWSER_LOCATION_STACK[-1]}
        _USB_BROWSER_RESUME=(
          "${_USB_BROWSER_QUERY_STACK[-1]-}"
          "${_USB_BROWSER_INDEX_STACK[-1]:-1}"
          "${_USB_BROWSER_OFFSET_STACK[-1]:-0}"
          "${exclusion_stack[-1]-}" "${exclusion_focus_stack[-1]:-0}" "${exclusion_shown_stack[-1]:-0}")
        _USB_BROWSER_LOCATION_STACK[-1]=()
        _USB_BROWSER_QUERY_STACK[-1]=()
        _USB_BROWSER_INDEX_STACK[-1]=()
        _USB_BROWSER_OFFSET_STACK[-1]=()
        exclusion_stack[-1]=() exclusion_focus_stack[-1]=() exclusion_shown_stack[-1]=()
      fi
      continue
    fi
    if [[ $selected == paste-path ]]; then
      path_subtitle='Drop an .iso, .img, or full Install macOS app, then press Return'
      while true; do
        _usb_read_image_path "$path_subtitle"
        result=$?
        (( result == 1 )) && break
        (( result == 0 )) || return $result
        if _usb_image_from_query "$_ZLE_PICKER_SELECTED_VALUE"; then
          return 0
        fi
        path_subtitle='That is not readable supported media; paste another image or full Install macOS app'
      done
      continue
    fi
    if [[ $selected == */ && -d ${selected%/} && ! -L ${selected%/} ]]; then
      _USB_BROWSER_LOCATION_STACK+=("$location")
      _USB_BROWSER_QUERY_STACK+=("${bookmark[1]-}")
      _USB_BROWSER_INDEX_STACK+=("${bookmark[2]:-1}")
      _USB_BROWSER_OFFSET_STACK+=("${bookmark[3]:-0}")
      exclusion_stack+=("${bookmark[4]-}") exclusion_focus_stack+=("${bookmark[5]:-0}") exclusion_shown_stack+=("${bookmark[6]:-0}")
      location=${${selected%/}:A}
      _USB_BROWSER_RESUME=('' 1 0)
      continue
    fi
    [[ ( -f $selected || -d $selected ) && ! -L $selected ]] || continue
    REPLY=${selected:A}
    return 0
  done
}

_usb_image_filesystem_device_capture() {
  emulate -L zsh
  local image_path=$1 output='' line='' device=''
  _USB_IMAGE_DEVICE=''
  output=$(command /bin/df -P "$image_path" 2>/dev/null) || {
    _USB_CAPTURE_ERROR='macOS could not resolve the selected image filesystem'
    return 1
  }
  (( ${#output} <= 8192 )) || {
    _USB_CAPTURE_ERROR='image filesystem output exceeded the 8,192-character limit'
    return 1
  }
  line=${${(f)output}[-1]-}
  device=${line%%[[:space:]]*}
  [[ -n $device && $device != *[[:cntrl:]]* ]] || {
    _USB_CAPTURE_ERROR='macOS returned no usable filesystem device for the image'
    return 1
  }
  _USB_IMAGE_DEVICE=$device
}

# Whole disk named by one captured diskutil info plist, in REPLY.
_usb_plist_whole_disk() {
  emulate -L zsh
  local plist=$1 parent=''
  _usb_plist_optional "$plist" ParentWholeDisk
  parent=$REPLY
  if [[ -z $parent ]]; then
    _usb_plist_optional "$plist" DeviceIdentifier
    [[ $REPLY == disk<-> ]] && parent=$REPLY
  fi
  REPLY=$parent
  [[ $parent == disk<-> ]]
}

# Accept one whole disk behind the source unless diskutil reports it Virtual.
# An attached disk image, sparsebundle or AppleRAID set hides the drives that
# hold it, so they could not be excluded as targets; refuse instead of tracing
# them. Internal Apple silicon storage reports Unknown, so only Virtual refuses.
# $2/$3 are an identifier and plist already read, reused when $1 names it.
_usb_source_whole_disk_check() {
  emulate -L zsh
  local whole=$1 plist=$3
  if [[ $whole != "$2" ]]; then
    _usb_disk_info_read "$whole" || return
    plist=$_USB_PLIST
  fi
  _usb_plist_optional "$plist" DeviceIdentifier
  [[ $REPLY == "$whole" ]] || {
    _USB_CAPTURE_ERROR="diskutil described another disk than /dev/$whole"
    return 1
  }
  _usb_plist_optional "$plist" VirtualOrPhysical
  [[ $REPLY == Virtual ]] || return 0
  _USB_CAPTURE_ERROR='the media is on a virtual disk (a mounted disk image, sparsebundle, or RAID set); copy it to a regular drive first'
  _USB_CAPTURE_ERROR_KIND=virtual-source
  return 1
}

# Resolve a local source volume through diskutil metadata instead of deriving a
# whole-disk identifier from a partition name. An APFS volume's ParentWholeDisk
# is its synthesized (Virtual) container, never a physical target, so each APFS
# physical store resolves to its own whole disk; a Fusion container spans two.
# The result is one or more space-separated diskN identifiers, and anything
# unestablished fails closed, as does a whole disk diskutil reports Virtual.
# _USB_CAPTURE_ERROR_KIND is virtual-source for that refusal, which no retry
# can resolve, and empty otherwise. Network/FileProvider sources do not map to
# a local /dev/disk target and therefore need no exclusion.
_usb_image_source_disk_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local image_path=$1 device='' identifier='' plist='' count='' store='' whole=''
  local store_plist=''
  local -i index=0
  local -a disks=()
  _USB_IMAGE_SOURCE_DISK='' _USB_CAPTURE_ERROR='' _USB_CAPTURE_ERROR_KIND=''
  _usb_image_filesystem_device_capture "$image_path" || return
  device=$_USB_IMAGE_DEVICE
  [[ $device == /dev/disk* ]] || return 0
  [[ $device == /dev/disk<->(s<->)# ]] || {
    _USB_CAPTURE_ERROR='the image filesystem reported an unsupported local device identifier'
    return 1
  }
  identifier=${device#/dev/}
  _usb_disk_info_read "$identifier" || return
  plist=$_USB_PLIST
  _usb_plist_optional "$plist" APFSPhysicalStores
  count=$REPLY
  if [[ -z $count ]]; then
    _usb_plist_optional "$plist" APFSContainerReference
    [[ -z $REPLY ]] || {
      _USB_CAPTURE_ERROR='diskutil did not report the APFS physical store holding the image'
      return 1
    }
    _usb_plist_whole_disk "$plist" || {
      _USB_CAPTURE_ERROR='diskutil could not resolve the image filesystem to a whole disk'
      return 1
    }
    whole=$REPLY
    _usb_source_whole_disk_check "$whole" "$identifier" "$plist" || return
    _USB_IMAGE_SOURCE_DISK=$whole
    return 0
  fi
  [[ $count == <1-16> ]] || {
    _USB_CAPTURE_ERROR='diskutil reported an unusable APFS physical store list for the image'
    return 1
  }
  for (( index = 0; index < count; ++index )); do
    _usb_plist_optional "$plist" "APFSPhysicalStores.$index.APFSPhysicalStore"
    store=$REPLY
    [[ $store == disk<->(s<->)# ]] || {
      _USB_CAPTURE_ERROR='diskutil reported an unsupported APFS physical store for the image'
      return 1
    }
    _usb_disk_info_read "$store" || return
    store_plist=$_USB_PLIST
    _usb_plist_whole_disk "$store_plist" || {
      _USB_CAPTURE_ERROR="diskutil could not resolve APFS physical store /dev/$store to a whole disk"
      return 1
    }
    whole=$REPLY
    (( ${disks[(Ie)$whole]} )) && continue
    _usb_source_whole_disk_check "$whole" "$store" "$store_plist" || return
    disks+=("$whole")
  done
  _USB_IMAGE_SOURCE_DISK=${(j: :)disks}
}


_usb_plist_optional() {
  emulate -L zsh
  local plist=$1 key=$2 fallback=${3:-}
  (( ${+functions[_compozsh_plutil_raw]} )) && _compozsh_plutil_raw "$plist" "$key" || REPLY=$fallback
}

_usb_diskutil_run() {
  emulate -L zsh
  command /usr/sbin/diskutil "$@"
}

# diskutil reports APFS's size limit as 9223372034707292160, so accept every
# signed 64-bit decimal. Compare 19-digit text as text: arithmetic would
# truncate or wrap a longer value before any range check.
_usb_decimal_is_int64() {
  [[ $1 == <-> ]] && { (( ${#1} < 19 )) || [[ ${#1} == 19 && $1 < 9223372036854775808 ]]; }
}

_usb_diskutil_plist_capture() {
  emulate -L zsh
  local temp_root=${TMPDIR:-/tmp} capture_file='' raw_size=''
  local -i command_status=0
  _USB_PLIST='' _USB_CAPTURE_ERROR=''
  capture_file=$(command /usr/bin/mktemp "${temp_root%/}/compozsh-usb.XXXXXX" 2>/dev/null) || {
    _USB_CAPTURE_ERROR='cannot create a bounded diskutil capture file'
    return 1
  }
  {
    _usb_diskutil_run "$@" >| "$capture_file" 2>/dev/null
    command_status=$?
    if (( command_status == 0 )); then
      raw_size=$(command /usr/bin/stat -f '%z' "$capture_file" 2>/dev/null)
      if [[ $raw_size != <-> ]]; then
        command_status=1
        _USB_CAPTURE_ERROR='cannot measure the bounded diskutil capture file'
      elif (( raw_size == 0 )); then
        command_status=1
        _USB_CAPTURE_ERROR='diskutil returned no output'
      elif (( raw_size > _USB_PLIST_MAX_BYTES )); then
        command_status=1
        _USB_CAPTURE_ERROR="diskutil output exceeded the ${_USB_PLIST_MAX_BYTES}-byte capture limit"
      else
        _USB_PLIST=$(<"$capture_file")
      fi
    fi
  } always {
    if [[ -n $capture_file && ${capture_file:t} == compozsh-usb.* &&
          ${capture_file:h:A} == ${temp_root:A} ]]; then
      command /bin/rm -f -- "$capture_file"
    fi
  }
  return $command_status
}

_usb_disk_list_read() {
  emulate -L zsh
  _usb_diskutil_plist_capture list -plist external physical || {
    [[ -n $_USB_CAPTURE_ERROR ]] ||
      _USB_CAPTURE_ERROR='diskutil could not capture external physical disks'
    return 1
  }
  [[ -n $_USB_PLIST ]] || {
    _USB_CAPTURE_ERROR='diskutil could not capture external physical disks'
    return 1
  }
}

# _USB_CAPTURE_ERROR is display text; consumers branch on
# _USB_CAPTURE_ERROR_KIND, which is no-disks when diskutil lists no whole
# external physical disk and empty for every other failure.
_usb_disk_ids_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local count='' identifier=''
  local -i index=0
  _USB_DISK_IDS=() _USB_CAPTURE_ERROR_KIND=''
  _usb_disk_list_read || return
  (( ${+functions[_compozsh_plutil_raw]} )) && _compozsh_plutil_raw "$_USB_PLIST" AllDisks || return 1
  count=$REPLY
  [[ $count == <-> && ${#count} -le 18 ]] || return 1
  (( count <= 4096 )) || {
    _USB_CAPTURE_ERROR='diskutil reported too many device entries to inspect safely'
    return 1
  }
  for (( index = 0; index < count; ++index )); do
    (( ${+functions[_compozsh_plutil_raw]} )) && _compozsh_plutil_raw "$_USB_PLIST" "AllDisks.$index" || continue
    identifier=$REPLY
    [[ $identifier == disk<-> ]] || continue
    _USB_DISK_IDS+=("$identifier")
    (( ${#_USB_DISK_IDS} >= 64 )) && break
  done
  (( ${#_USB_DISK_IDS} )) || {
    _USB_CAPTURE_ERROR='no whole external physical disks are attached'
    _USB_CAPTURE_ERROR_KIND=no-disks
    return 1
  }
}

_usb_disk_info_read() {
  emulate -L zsh
  local identifier=$1
  _usb_diskutil_plist_capture info -plist "/dev/$identifier" || {
    [[ -n $_USB_CAPTURE_ERROR ]] ||
      _USB_CAPTURE_ERROR="diskutil could not inspect /dev/$identifier"
    return 1
  }
  [[ -n $_USB_PLIST ]] || {
    _USB_CAPTURE_ERROR="diskutil could not inspect /dev/$identifier"
    return 1
  }
}

_usb_disk_info_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local requested=$1 plist='' internal='' physical='' whole='' writable=''
  local device_tree='' size_text='' block_size_text=''
  _USB_INFO_ID='' _USB_INFO_NAME='' _USB_INFO_PROTOCOL=''
  _USB_INFO_FINGERPRINT=''
  _USB_INFO_SIZE=0 _USB_INFO_BLOCK_SIZE=512
  _USB_INFO_EXTERNAL=0 _USB_INFO_WHOLE=0
  _USB_INFO_PHYSICAL=0 _USB_INFO_WRITABLE=0
  [[ $requested == disk<-> ]] || return 2
  _usb_disk_info_read "$requested" || return
  plist=$_USB_PLIST

  _usb_plist_optional "$plist" DeviceIdentifier
  _USB_INFO_ID=$REPLY
  _usb_plist_optional "$plist" TotalSize 0
  size_text=$REPLY
  _usb_plist_optional "$plist" DeviceBlockSize 512
  block_size_text=$REPLY
  _usb_plist_optional "$plist" MediaName
  _USB_INFO_NAME=$REPLY
  [[ -n $_USB_INFO_NAME ]] || {
    _usb_plist_optional "$plist" DeviceName 'Unnamed external disk'
    _USB_INFO_NAME=$REPLY
  }
  _usb_plist_optional "$plist" BusProtocol
  _USB_INFO_PROTOCOL=$REPLY
  [[ -n $_USB_INFO_PROTOCOL ]] || {
    _usb_plist_optional "$plist" DeviceProtocol External
    _USB_INFO_PROTOCOL=$REPLY
  }
  _usb_plist_optional "$plist" Internal unknown
  internal=$REPLY
  _usb_plist_optional "$plist" VirtualOrPhysical unknown
  physical=$REPLY
  _usb_plist_optional "$plist" Whole
  whole=$REPLY
  if [[ -z $whole ]]; then
    _usb_plist_optional "$plist" WholeDisk false
    whole=$REPLY
  fi
  _usb_plist_optional "$plist" WritableMedia false
  writable=$REPLY
  _usb_plist_optional "$plist" DeviceTreePath
  device_tree=$REPLY

  # The size globals are integers, so assignment would evaluate unchecked text.
  [[ $_USB_INFO_ID == "$requested" && $size_text == <-> &&
     $block_size_text == <-> ]] &&
    (( ${#size_text} <= 18 && ${#block_size_text} <= 18 )) || return 1
  _USB_INFO_SIZE=$(( 10#$size_text ))
  _USB_INFO_BLOCK_SIZE=$(( 10#$block_size_text ))
  (( _USB_INFO_BLOCK_SIZE >= 512 && _USB_INFO_BLOCK_SIZE % 512 == 0 )) || return 1
  [[ -n $_USB_INFO_NAME && ${#_USB_INFO_NAME} -le 256 &&
     $_USB_INFO_NAME != *[[:cntrl:]]* ]] || return 1
  [[ -n $_USB_INFO_PROTOCOL && ${#_USB_INFO_PROTOCOL} -le 64 &&
     $_USB_INFO_PROTOCOL != *[[:cntrl:]]* ]] || return 1
  [[ ${#device_tree} -le 2048 && $device_tree != *[[:cntrl:]]* ]] || return 1
  [[ $internal == false ]] && _USB_INFO_EXTERNAL=1
  [[ $physical == Physical ]] && _USB_INFO_PHYSICAL=1
  [[ $whole == true ]] && _USB_INFO_WHOLE=1
  [[ $writable == true ]] && _USB_INFO_WRITABLE=1
  _USB_INFO_FINGERPRINT="${_USB_INFO_ID}|${_USB_INFO_SIZE}|${_USB_INFO_NAME}|${_USB_INFO_PROTOCOL}"
  if [[ -n $device_tree ]]; then _USB_INFO_FINGERPRINT+="|$device_tree"; fi
}

_usb_info_is_eligible() {
  (( _USB_INFO_EXTERNAL && _USB_INFO_PHYSICAL && _USB_INFO_WHOLE &&
     _USB_INFO_WRITABLE && _USB_INFO_SIZE > 0 ))
}

_usb_external_disks_capture() {
  emulate -L zsh
  local minimum_size=${1:-1} excluded_disk=${2:-} purpose=${3:-raw-image}
  local identifier='' size_label='' effect_detail=''
  local -i excluded_count=0 ineligible_count=0 undersized_count=0
  local -a captured_ids=()
  _USB_CAPTURE_ERROR='' _USB_CAPTURE_ERROR_KIND=''
  [[ $minimum_size == <-> ]] || return 2
  _usb_disk_ids_capture || return
  captured_ids=("${_USB_DISK_IDS[@]}")
  _USB_DISK_IDS=() _USB_DISK_LABELS=() _USB_DISK_DETAILS=()
  _USB_DISK_SIZES=() _USB_DISK_FINGERPRINTS=()
  for identifier in "${captured_ids[@]}"; do
    if [[ -n $excluded_disk && " $excluded_disk " == *" $identifier "* ]]; then
      (( ++excluded_count ))
      continue
    fi
    _usb_disk_info_capture "$identifier" || {
      (( ++ineligible_count ))
      continue
    }
    _usb_info_is_eligible || {
      (( ++ineligible_count ))
      continue
    }
    (( _USB_INFO_SIZE >= minimum_size )) || {
      (( ++undersized_count ))
      continue
    }
    REPLY='size unavailable'
    (( ${+functions[_usb_human_size]} )) && _usb_human_size "$_USB_INFO_SIZE"
    size_label=$REPLY
    _USB_DISK_IDS+=("$_USB_INFO_ID")
    _USB_DISK_LABELS+=("${_USB_INFO_NAME} · $size_label · ${_USB_INFO_PROTOCOL} · /dev/${_USB_INFO_ID}")
    if [[ $purpose == macos-installer ]]; then
      effect_detail='Apple createinstallmedia will erase and format this whole external disk; every existing partition and all data may be destroyed.'
    elif [[ $purpose == format ]]; then
      effect_detail='diskutil will replace this whole disk with one newly formatted volume; every existing partition and all data may be destroyed.'
    else
      effect_detail='The image writes from sector zero; existing partitions and data may be destroyed.'
    fi
    _USB_DISK_DETAILS+=("${_USB_INFO_NAME}"$'\n'"/dev/${_USB_INFO_ID} · $size_label"$'\n'"${_USB_INFO_PROTOCOL} · external physical · writable whole disk"$'\n\n'"$effect_detail")
    _USB_DISK_SIZES+=("$_USB_INFO_SIZE")
    _USB_DISK_FINGERPRINTS+=("$_USB_INFO_FINGERPRINT")
  done
  (( ${#_USB_DISK_IDS} )) || {
    if [[ $purpose == format ]]; then
      _USB_CAPTURE_ERROR='no writable whole external physical disk is currently eligible'
    elif (( excluded_count == ${#captured_ids} && excluded_count > 0 )); then
      _USB_CAPTURE_ERROR='the only attached external disk contains the selected image; attach another external disk or move the image to a different disk'
    elif (( undersized_count > 0 && ineligible_count == 0 )); then
      _USB_CAPTURE_ERROR='no separate writable whole external physical disk is large enough for the selected image'
    else
      _USB_CAPTURE_ERROR='no separate writable whole external physical target is currently eligible'
    fi
    return 1
  }
}

_usb_disks_capture() {
  _usb_external_disks_capture "$1" "${2:-}" "${3:-raw-image}"
}

_usb_format_disks_capture() {
  _usb_external_disks_capture 1 '' format
}

_usb_picker_collect() {
  (( ${+functions[_zle_ui_collect]} )) || {
    _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=()
    return 1
  }
  _zle_ui_collect ranked "$1" "$2" _USB_PICKER_VALUES _USB_PICKER_LABELS \
    _USB_PICKER_LABELS _USB_PICKER_SEARCH append
}

_usb_choose() {
  _zle_ui_view "${10:-choice}" _usb_choice_view "$@"
}

_usb_choice_view() {
  emulate -L zsh
  local title=$1 subtitle=$2 query_label=$3 detail=''
  local -i show_details=${4:-0} show_highlights=${6:-0} index=0
  local -a view_bookmark=("${8:-}" 1 0 "${11:-}" "${12:-0}" "${13:-0}" 0) choices=() reply=()
  if (( _ZLE_PICKER_ACTION_VIEW )); then
    show_details=1
    _zle_ui_action_context heading PLAN text "$2" text '' text 'Writes require a separate confirmation.'
    _ZLE_PICKER_ACTION_CONTEXT=$REPLY _ZLE_PICKER_ACTION_CONTEXT_ROLES=("${reply[@]}")
    _ZLE_PICKER_ACCEPT_LABELS=(flash-verify 'review confirmation' flash-only 'review confirmation'
      flash 'choose media' format 'choose drive'
      default-name 'review confirmation' custom-name 'enter name' image 'choose media'
      target 'choose drive' checksum 'enter checksum' remove-checksum 'remove checksum'
      retry 'retry capture' back back done done)
    # Action rows describe themselves by their detail's second paragraph.
    for (( index = 1; index <= ${#_USB_PICKER_VALUES}; ++index )); do
      detail=${_USB_PICKER_DETAILS[index]-}
      [[ $detail == *$'\n\n'* ]] && detail=${detail#*$'\n\n'}
      _ZLE_PICKER_DESCRIPTIONS[${_USB_PICKER_VALUES[index]}]=${detail%%$'\n'*}
    done
  fi
  _ZLE_PICKER_REFRESH_ENABLED=${5:-0}
  local refresh_label=${7:-'captured external disks · Ctrl-R refresh'}
  _ZLE_PICKER_TITLE=$title _ZLE_PICKER_SUBTITLE=$subtitle
  _ZLE_PICKER_QUERY_LABEL=$query_label
  _ZLE_PICKER_BROWSE_LABEL='captured choices · no action yet'
  (( _ZLE_PICKER_REFRESH_ENABLED )) &&
    _ZLE_PICKER_BROWSE_LABEL=$refresh_label
  _ZLE_PICKER_COLLECTOR=_usb_picker_collect
  if (( ${+_USB_PICKER_PASSIVE_LINES} )); then
    _ZLE_PICKER_PASSIVE_LINES=("${_USB_PICKER_PASSIVE_LINES[@]}")
    _ZLE_PICKER_PASSIVE_STYLES=("${_USB_PICKER_PASSIVE_STYLES[@]}")
  fi
  (( show_details )) && choices+=(--details _USB_PICKER_DETAILS)
  (( show_highlights )) && choices+=(--highlights _USB_PICKER_HIGHLIGHTS)
  [[ -n ${9:-} ]] && choices+=(--select-top "$9")
  _zle_ui_choices "${choices[@]}" _USB_PICKER_VALUES view_bookmark 20
}

# A first removable-volume access can return once while macOS applies the
# user's permission choice. Keep the established image and screen session so
# the user can retry that explicit provider capture without starting over.
_usb_external_device_capture_retry() {
  emulate -L zsh
  local capture_helper=$1 minimum_size=$2 excluded_disk=$3 purpose=$4
  local title=$5 back_value=$6 back_label=$7
  local error='' selected='' retry_label='' retry_detail='' subtitle=''
  local -i result=0
  while true; do
    "$capture_helper" "$minimum_size" "$excluded_disk" "$purpose" && return 0
    error=${_USB_CAPTURE_ERROR:-'diskutil did not return a usable external-disk snapshot'}
    retry_label='Retry target capture · permission or attachment may have changed'
    retry_detail='Retry target capture'$'\n\n'"$error"$'\n\n''macOS can return once while applying removable-volume permission. Enter performs a fresh read-only diskutil capture.'
    subtitle="DRIVE unavailable · $error"
    if [[ $_USB_CAPTURE_ERROR_KIND == no-disks ]]; then
      retry_label='Make drive available · connect or replug it, then retry'
      retry_detail='No external disk is currently visible to macOS.'$'\n\n''A drive can remain physically plugged in after macOS ejects it. Ctrl-R cannot reactivate an ejected drive. Unplug and reconnect the drive (or power-cycle its hub), then press Ctrl-R or Enter.'
      subtitle='DRIVE unavailable · no external disk is currently visible to macOS'
    fi
    _USB_PICKER_VALUES=(retry "$back_value")
    _USB_PICKER_LABELS=(
      "$retry_label"
      "$back_label")
    _USB_PICKER_SEARCH=(retry permission disk refresh back image target)
    _USB_PICKER_DETAILS=(
      "$retry_detail"
      "$back_label"$'\n\n''Return without discarding the established image or performing an action.')
    _usb_choose "$title" "$subtitle" 'Filter choices' 0 1 0 '' '' '' action
    result=$?
    (( result == 1 )) && return 1
    (( result == 0 )) || return $result
    [[ $_ZLE_PICKER_ACTION == refresh ]] && continue
    selected=$_ZLE_PICKER_SELECTED_VALUE
    [[ $selected == retry ]] || return 1
  done
}

_usb_external_device_choose() {
  emulate -L zsh
  local capture_helper=$1 minimum_size=$2 excluded_disk=$3 purpose=$4
  local title=$5 subtitle=$6 query_label=$7 back_value=$8 back_label=$9
  local -i result=0 index=0
  while true; do
    _usb_external_device_capture_retry "$capture_helper" "$minimum_size" \
      "$excluded_disk" "$purpose" "$title" "$back_value" "$back_label" || return $?
    _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
    for (( index = 1; index <= ${#_USB_DISK_IDS}; ++index )); do
      _USB_PICKER_VALUES+=("$index") _USB_PICKER_LABELS+=("${_USB_DISK_LABELS[index]}")
      _USB_PICKER_SEARCH+=("${_USB_DISK_IDS[index]} ${_USB_DISK_LABELS[index]}")
      _USB_PICKER_DETAILS+=("${_USB_DISK_DETAILS[index]}")
    done
    _usb_choose "$title" "$subtitle" "$query_label" 0 1
    result=$?
    (( result == 0 )) || return $result
    [[ $_ZLE_PICKER_ACTION == refresh ]] && continue
    return 0
  done
}

_usb_target_choose() {
  emulate -L zsh
  local image_size=$1 image_label=$2 back_value=$3 back_label=$4
  local excluded_disk=${5:-} subtitle=${6:-"Image  ›  DRIVE  ›  Flash · $image_label"}
  local media_kind=${7:-raw-image}
  _usb_external_device_choose _usb_disks_capture "$image_size" "$excluded_disk" \
    "$media_kind" 'External device / Flash · Step 2 of 3' "$subtitle" 'Filter drives' \
    "$back_value" "$back_label"
}

_usb_formats_capture() {
  emulate -L zsh
  local personality='' visible_name='' minimum='' maximum=''
  local minimum_label='' maximum_label=''
  local -i index=0
  _USB_FORMAT_PERSONALITIES=() _USB_FORMAT_LABELS=() _USB_FORMAT_DETAILS=()
  _USB_FORMAT_MINIMUM_SIZES=() _USB_FORMAT_MAXIMUM_SIZES=()
  _USB_CAPTURE_ERROR=''
  _usb_diskutil_plist_capture listFilesystems -plist || {
    [[ -n $_USB_CAPTURE_ERROR ]] ||
      _USB_CAPTURE_ERROR='diskutil could not capture its filesystem catalog'
    return 1
  }
  while (( index < 64 )); do
    (( ${+functions[_compozsh_plutil_raw]} )) && _compozsh_plutil_raw "$_USB_PLIST" "$index.Personality" || break
    personality=$REPLY
    _usb_plist_optional "$_USB_PLIST" "$index.UserVisibleName" "$personality"
    visible_name=$REPLY
    _usb_plist_optional "$_USB_PLIST" "$index.MinimumSize" 0
    minimum=$REPLY
    _usb_plist_optional "$_USB_PLIST" "$index.MaximumSize" 0
    maximum=$REPLY
    if [[ -n $personality && ${#personality} -le 128 &&
          $personality != *[[:cntrl:]]* && -n $visible_name &&
          ${#visible_name} -le 128 && $visible_name != *[[:cntrl:]]* ]] &&
        _usb_decimal_is_int64 "$minimum" && _usb_decimal_is_int64 "$maximum"; then
      if (( minimum > 0 )); then
        REPLY='size unavailable'
        (( ${+functions[_usb_human_size]} )) && _usb_human_size "$minimum"
        minimum_label=$REPLY
      else
        minimum_label='none reported'
      fi
      if (( maximum > 0 )); then
        REPLY='size unavailable'
        (( ${+functions[_usb_human_size]} )) && _usb_human_size "$maximum"
        maximum_label=$REPLY
      else
        maximum_label='none reported'
      fi
      _USB_FORMAT_PERSONALITIES+=("$personality")
      _USB_FORMAT_LABELS+=("$visible_name")
      _USB_FORMAT_DETAILS+=("$visible_name"$'\n'"diskutil personality · $personality"$'\n'"Minimum size · $minimum_label"$'\n'"Maximum size · $maximum_label"$'\n\n''diskutil advertised this personality for its erase and partition verbs on this Mac.')
      _USB_FORMAT_MINIMUM_SIZES+=("$minimum")
      _USB_FORMAT_MAXIMUM_SIZES+=("$maximum")
    fi
    (( ++index ))
  done
  if (( index == 64 )) && (( ${+functions[_compozsh_plutil_raw]} )) && _compozsh_plutil_raw "$_USB_PLIST" '64.Personality'; then
    _USB_CAPTURE_ERROR='diskutil reported more than 64 filesystem personalities'
    return 1
  fi
  (( ${#_USB_FORMAT_PERSONALITIES} )) || {
    _USB_CAPTURE_ERROR='diskutil reported no usable filesystem personalities'
    return 1
  }
}

_usb_format_is_applicable() {
  emulate -L zsh
  local index=$1 disk_size=$2
  local minimum=${_USB_FORMAT_MINIMUM_SIZES[index]:-0}
  local maximum=${_USB_FORMAT_MAXIMUM_SIZES[index]:-0}
  [[ $index == <-> && $disk_size == <-> && $minimum == <-> && $maximum == <-> ]] ||
    return 2
  (( disk_size >= minimum && ( maximum == 0 || disk_size <= maximum ) ))
}

_usb_volume_name_validate() {
  emulate -L zsh
  local name=$1 personality=$2
  _USB_FORMAT_ERROR='' REPLY=''
  (( ${#name} > 0 )) || {
    _USB_FORMAT_ERROR='Volume name cannot be empty.'
    return 1
  }
  (( ${#name} <= 255 )) || {
    _USB_FORMAT_ERROR='Volume name exceeds the 255-character safety limit.'
    return 1
  }
  [[ $name != *[[:cntrl:]]* ]] && [[ $name != *'/'* ]] &&
      [[ $name != *':'* ]] && [[ ${name[1]} != ' ' && ${name[-1]} != ' ' ]] || {
    _USB_FORMAT_ERROR='Volume name cannot contain control characters, /, :, or leading/trailing spaces.'
    return 1
  }
  case $personality in
    (*APFS|*HFS+|Free\ Space|Linux\ Swap|Linux\ Native) ;;
    (*)
      (( ${#name} <= 11 )) || {
        _USB_FORMAT_ERROR="$personality volume names are limited to 11 portable characters."
        return 1
      }
      [[ $name != *[^-A-Za-z0-9_\ ]* ]] || {
        _USB_FORMAT_ERROR="$personality names may use letters, numbers, spaces, underscores, and hyphens."
        return 1
      } ;;
  esac
  REPLY=$name
}

_usb_read_volume_name() {
  _zle_ui_view query _usb_volume_name_view "$@"
}

_usb_volume_name_view() {
  emulate -L zsh
  local subtitle=${1:-'Enter a volume name, then press Return'}
  local initial=${2:-}
  _ZLE_PICKER_TITLE='External device / Format / Volume name'
  _ZLE_PICKER_SUBTITLE=$subtitle _ZLE_PICKER_QUERY_LABEL='Volume name'
  _ZLE_PICKER_INSPECT_ACTION=use
  _ZLE_PICKER_BROWSE_LABEL='literal volume name · Return validates'
  _ZLE_PICKER_EMPTY_LINES=(
    'Enter the initial name for the new volume.'
    'The text is passed to diskutil as one literal argument.'
    'APFS and HFS accept printable names without / or :.'
    'Other formatted volumes use an 11-character portable label subset.'
    'Press Return to validate the name, or Escape to go back.')
  _zle_picker_loop "$initial" 1
}

_usb_format_workspace_controller() {
  emulate -L zsh
  local selected='' disk='' format_subtitle='DRIVE  ›  Format'
  local size_label='' incompatibility='' volume_name='' name_subtitle=''
  local -i result=0 disk_index=0 format_index=0 index=0
  local -a _USB_PICKER_VALUES=() _USB_PICKER_LABELS=()
  local -a _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
  while true; do
    _usb_external_device_choose _usb_format_disks_capture 1 '' format \
      'External device / Format · Step 1 of 3' \
      'DRIVE  ›  Format · whole external physical disks only' \
      'Filter drives' cancel 'Cancel formatting'
    result=$?
    (( result == 0 )) || return $result
    disk_index=$_ZLE_PICKER_SELECTED_VALUE
    disk=${_USB_DISK_IDS[disk_index]}
    # Status 1 means the user cancelled; a failed capture must stay a failure.
    _usb_formats_capture || {
      _USB_FORMAT_ERROR=${_USB_CAPTURE_ERROR:-'diskutil did not return a usable filesystem catalog'}
      return 2
    }
    REPLY='size unavailable'
    (( ${+functions[_usb_human_size]} )) && _usb_human_size "${_USB_DISK_SIZES[disk_index]}"
    size_label=$REPLY
    format_subtitle="Drive  ›  FORMAT · /dev/$disk · $size_label"
    while true; do
      _USB_PICKER_VALUES=() _USB_PICKER_LABELS=()
      _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
      for (( index = 1; index <= ${#_USB_FORMAT_PERSONALITIES}; ++index )); do
        _USB_PICKER_VALUES+=("$index")
        _USB_PICKER_LABELS+=("${_USB_FORMAT_LABELS[index]}")
        _USB_PICKER_SEARCH+=("${_USB_FORMAT_LABELS[index]} ${_USB_FORMAT_PERSONALITIES[index]}")
        if _usb_format_is_applicable "$index" "${_USB_DISK_SIZES[disk_index]}"; then
          _USB_PICKER_DETAILS+=("${_USB_FORMAT_DETAILS[index]}"$'\n\n'"The selected $size_label drive is within diskutil's reported size bounds.")
        else
          _USB_PICKER_LABELS[index]+=" · unavailable for $size_label"
          _USB_PICKER_DETAILS+=("${_USB_FORMAT_DETAILS[index]}"$'\n\n'"This personality is outside diskutil's reported size bounds for the selected $size_label drive. Selecting it will not erase the disk.")
        fi
      done
      _usb_choose 'External device / Format · Step 2 of 3' "$format_subtitle" \
        'Filter formats' 1
      result=$?
      (( result == 1 )) && break
      (( result == 0 )) || return $result
      format_index=$_ZLE_PICKER_SELECTED_VALUE
      if ! _usb_format_is_applicable "$format_index" "${_USB_DISK_SIZES[disk_index]}"; then
        incompatibility=${_USB_FORMAT_LABELS[format_index]}
        format_subtitle="FORMAT unavailable for $size_label · $incompatibility"
        continue
      fi
      _USB_SELECTED_DISK=$disk
      _USB_SELECTED_DISK_LABEL=${_USB_DISK_LABELS[disk_index]}
      _USB_SELECTED_DISK_FINGERPRINT=${_USB_DISK_FINGERPRINTS[disk_index]}
      _USB_SELECTED_DISK_SIZE=${_USB_DISK_SIZES[disk_index]}
      _USB_SELECTED_FORMAT=${_USB_FORMAT_PERSONALITIES[format_index]}
      _USB_SELECTED_FORMAT_LABEL=${_USB_FORMAT_LABELS[format_index]}
      while true; do
        _USB_PICKER_VALUES=(default-name custom-name)
        _USB_PICKER_LABELS=(
          'Use default name · External'
          'Give the volume a custom name…')
        _USB_PICKER_SEARCH=(default external custom name label)
        _USB_PICKER_DETAILS=(
          'Use default name'$'\n\n''Continue with External as the initial volume name.'
          'Custom volume name'$'\n\n''Enter one literal name. It is validated for the selected filesystem before confirmation.')
        _usb_choose 'External device / Format · Step 3 of 3' \
          "Drive  ›  Format  ›  NAME · ${_USB_FORMAT_LABELS[format_index]} · /dev/$disk" \
          'Filter choices' 1 0 0 '' '' '' action
        result=$?
        (( result == 1 )) && break
        (( result == 0 )) || return $result
        selected=$_ZLE_PICKER_SELECTED_VALUE
        if [[ $selected == default-name ]]; then
          _USB_SELECTED_VOLUME_NAME=External
          return 0
        fi
        [[ $selected == custom-name ]] || continue
        name_subtitle="Enter a name for ${_USB_FORMAT_LABELS[format_index]}"
        volume_name=''
        while true; do
          _usb_read_volume_name "$name_subtitle" "$volume_name"
          result=$?
          (( result == 1 )) && break
          (( result == 0 )) || return $result
          volume_name=$_ZLE_PICKER_SELECTED_VALUE
          if _usb_volume_name_validate "$volume_name" \
              "${_USB_FORMAT_PERSONALITIES[format_index]}"; then
            _USB_SELECTED_VOLUME_NAME=$REPLY
            return 0
          fi
          name_subtitle=${_USB_FORMAT_ERROR:-'Enter another volume name'}
        done
      done
      continue
    done
  done
}

_usb_image_source_disk_retry() {
  emulate -L zsh
  local image=$1 error='' selected=''
  local -i result=0
  while true; do
    _usb_image_source_disk_capture "$image" && return 0
    error=${_USB_CAPTURE_ERROR:-'macOS did not return a usable image-volume snapshot'}
    if [[ $_USB_CAPTURE_ERROR_KIND == virtual-source ]]; then
      _usb_media_attention_choose "$image" \
        'Media on a virtual disk · Nothing can be written' \
        'Media on a virtual disk'$'\n\n''The selected media is on a mounted disk image, sparsebundle, or RAID set. macOS does not report which drives hold that virtual disk, so Compozsh cannot keep them out of the drive list and refuses the media before any drive is captured.'$'\n\n''Copy the media to a regular internal or external drive, then choose the copy.'
      result=$?
      (( result <= 1 )) && return 1
      return $result
    fi
    _USB_PICKER_VALUES=(retry image)
    _USB_PICKER_LABELS=(
      'Retry image-volume access · permission may have changed'
      'Choose another image')
    _USB_PICKER_SEARCH=(retry permission volume image back)
    _USB_PICKER_DETAILS=(
      'Retry image-volume access'$'\n\n'"$error"$'\n\n''macOS can return once while applying removable-volume permission. Enter resolves the source again so it cannot be selected as the write target.'
      'Choose another image'$'\n\n''Return to the captured image choices without performing an action.')
    _usb_choose 'External device / Flash · Step 1 of 3' "IMAGE unavailable · $error" 'Filter choices'
    result=$?
    (( result == 1 )) && return 1
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    [[ $selected == retry ]] || return 1
  done
}

_usb_image_architecture_capture() {
  emulate -L zsh
  _usb_image_architecture_hint "$1"
  _USB_SELECTED_IMAGE_ARCHITECTURE=$REPLY
}

_usb_media_attention_choose() {
  emulate -L zsh
  local image=$1 headline=$2 detail=$3
  local -a _USB_PICKER_VALUES=(back)
  local -a _USB_PICKER_LABELS=('Choose another media')
  local -a _USB_PICKER_HIGHLIGHTS=('')
  local -a _USB_PICKER_SEARCH=(back)
  local -a _USB_PICKER_DETAILS=("$detail")
  local -a _USB_PICKER_PASSIVE_LINES=("$headline")
  local -a _USB_PICKER_PASSIVE_STYLES=(picker-error)
  _usb_choose 'External device / Flash · Media compatibility' \
    "MEDIA  ›  ${image:t}" 'Choose another media' 1 0 1
}

_usb_windows_unsupported_choose() {
  emulate -L zsh
  local image=$1
  local boundary='Windows USB creation is unavailable on stock macOS'
  local boot='Boot requirement · Windows Setup requires FAT32 for portable UEFI media'
  local limit='Media limit · Current Windows 11 ISOs can contain install.wim larger than 4 GiB'
  local tool='Required tool · Microsoft requires DISM on Windows to create install.swm parts'
  local safety='Safety · Compozsh will not use raw, exFAT, or NTFS workarounds'
  local summary='Compozsh detected Windows Setup media and stopped before drive selection.'$'\n\n''Microsoft’s supported portable installer uses FAT32. Current Windows 11 ISOs can contain sources/install.wim larger than FAT32’s 4 GiB single-file limit. Microsoft requires DISM on Windows to split that image into install.swm parts; stock macOS has no supported WIM splitter. Raw writing and alternate exFAT or NTFS layouts are not reliable ordinary Windows Setup media.'$'\n\n''Nothing was written or targeted. Use Microsoft Media Creation Tool or DISM on Windows.'
  local -a _USB_PICKER_VALUES=(done)
  local -a _USB_PICKER_LABELS=(Done)
  local -a _USB_PICKER_HIGHLIGHTS=('')
  local -a _USB_PICKER_SEARCH=(done)
  local -a _USB_PICKER_DETAILS=("$summary")
  local -a _USB_PICKER_PASSIVE_LINES=("$boundary" "$boot" "$limit" "$tool" "$safety")
  local -a _USB_PICKER_PASSIVE_STYLES=(
    picker-error picker-text picker-text picker-text picker-success)
  _usb_choose 'External device / Flash · Windows unsupported' \
    "MEDIA  ›  WINDOWS UNSUPPORTED · ${image:t}" 'Done' 0 0 1
}

_usb_macos_review_choose() {
  emulate -L zsh
  local installer=$1 disk_index=$2
  local disk=${_USB_DISK_IDS[disk_index]}
  local source_label='Source validation · Verified · Apple-signed full installer'
  _USB_PICKER_VALUES=(flash-verify image target)
  _USB_PICKER_LABELS=(
    'Create bootable macOS installer'
    "Change installer · ${installer:t}"
    "Change drive · ${_USB_DISK_LABELS[disk_index]}")
  _USB_PICKER_HIGHLIGHTS=('' '' '')
  _USB_PICKER_SEARCH=(create installer drive)
  _USB_PICKER_DETAILS=(
    'Create macOS installer'$'\n\n'"The whole selected external disk is prepared as Mac OS Extended, then the selected app’s Apple createinstallmedia tool builds the bootable installer and the disk is ejected."$'\n\n''The full installer application and its createinstallmedia executable passed Apple signature validation. Their captured filesystem identities are checked again before erasing the drive.'
    "${_USB_IMAGE_DETAILS[${_USB_IMAGE_PATHS[(Ie)$installer]}]}"
    "${_USB_DISK_DETAILS[disk_index]}")
  # Validation is a fact, not an action; scoped here so later screens never inherit it.
  local -a _USB_PICKER_PASSIVE_LINES=("$source_label")
  local -a _USB_PICKER_PASSIVE_STYLES=(picker-success)
  _usb_choose 'External device / Flash · Step 3 of 3' \
    "Media  ›  Drive  ›  CREATE · macOS · ${installer:t} → /dev/$disk" \
    'Filter choices' 1 0 1 '' '' '' action
}

# A refused flash returns here, so its reason is passive context on this one
# view; scoped here so later screens never inherit it.
_usb_flash_review_choose() {
  emulate -L zsh
  local breadcrumb=$1 refusal=$2
  local -a _USB_PICKER_PASSIVE_LINES=() _USB_PICKER_PASSIVE_STYLES=()
  if [[ -n $refusal ]]; then
    _USB_PICKER_PASSIVE_LINES=("$refusal")
    _USB_PICKER_PASSIVE_STYLES=(picker-error)
  fi
  _usb_choose 'External device / Flash · Step 3 of 3' "$breadcrumb" \
    'Filter choices' 1 0 1 '' '' '' action
}

_usb_step3_checksum_progress() {
  emulate -L zsh
  local image=$1 disk=$2 disk_label=$3 checksum=$4 algorithm=$5 architecture=$6
  local _USB_SELECTED_IMAGE=$image _USB_SELECTED_DISK=$disk
  local _USB_SELECTED_DISK_LABEL=$disk_label _USB_SELECTED_CHECKSUM=$checksum
  local _USB_SELECTED_CHECKSUM_ALGORITHM=$algorithm
  local _USB_SELECTED_IMAGE_INTEGRITY=checking
  local _USB_SELECTED_IMAGE_ARCHITECTURE=$architecture
  _usb_progress_stage "Checking image SHA-$algorithm" \
    info 'Hashing the complete local image before confirmation.' \
    muted "Expected · ${checksum[1,16]}…"
}

# Pure Step 3 rows from the reviewed drive, image and checksum state, as
# reply=(value label role search detail ...). Only the integrity row carries a
# role; any checksum that has not matched turns the start row into a reminder.
_usb_review_rows() {
  emulate -L zsh
  local disk=$1 image_name=$2 disk_label=$3 image_detail=$4 disk_detail=$5
  local checksum=$6 algorithm=$7 state=$8 actual=$9
  local start='Start flash & verify' role=picker-error label='' detail=''
  if [[ -n $checksum && $state == matched ]]; then
    start+=" · SHA-$algorithm"
  elif [[ -n $checksum ]]; then
    start='Resolve image integrity check before flashing'
  fi
  reply=(flash-verify "$start" '' 'write verify checksum'
    'Flash & verify'$'\n\n'"Step 3 validates a provided full-image checksum. After confirmation it revalidates the image and /dev/$disk, writes through /dev/r$disk, compares every image byte before the drive is released, and ejects.")
  case $state in
    (matched)
      role=picker-success
      label="Image integrity · Verified · SHA-$algorithm matched"
      detail="Verified local image"$'\n\n'"Expected"$'\n'"$checksum"$'\n\n'"Actual"$'\n'"$actual"$'\n\n''The complete local image matches the supplied checksum.' ;;
    (mismatch)
      label="Image integrity · FAILED · SHA-$algorithm mismatch"
      detail="Local image checksum mismatch"$'\n\n'"Expected"$'\n'"$checksum"$'\n\n'"Actual"$'\n'"${actual:-unavailable}"$'\n\n''The drive cannot be flashed until the checksum is corrected, removed, or a valid image is selected.' ;;
    (changed)
      label='Image integrity · FAILED · image changed during validation'
      detail='The selected image no longer matches its captured size or filesystem identity. Choose the image again before flashing.' ;;
    (error)
      label="Image integrity · Could not calculate SHA-$algorithm"
      detail='The selected image could not be read completely. Nothing can be written until the integrity check succeeds or the checksum is explicitly removed.' ;;
    (*)
      label='Image integrity · Not verified · no checksum provided'
      detail='No checksum was supplied. Flash & verify will still compare the finished drive with the selected local image, but the local image’s origin is not established.' ;;
  esac
  reply+=(checksum "$label" "$role" 'checksum sha256 sha512 integrity' "$detail")
  [[ -z $checksum ]] || reply+=(remove-checksum 'Remove image checksum' '' 'remove checksum'
    'Remove checksum'$'\n\n''Continue without trusted-checksum validation. Flash & verify will still perform the native raw-device comparison.')
  reply+=(image "Change image · $image_name" '' image "$image_detail"
    target "Change drive · $disk_label" '' target "$disk_detail"
    flash-only 'Flash without verification' '' write
    'Flash only'$'\n\n'"Validates a provided checksum before writing, then writes /dev/r$disk and ejects without reading the payload back.")
}

# Append (value label role search detail) records to the picker rows the
# caller scoped; a role highlights its whole label.
_usb_picker_rows_add() {
  emulate -L zsh
  local value='' label='' role='' search='' detail=''
  for value label role search detail in "$@"; do
    _USB_PICKER_VALUES+=("$value") _USB_PICKER_LABELS+=("$label")
    if [[ -n $role ]]; then
      _USB_PICKER_HIGHLIGHTS+=("0:${#label}:$role")
    else
      _USB_PICKER_HIGHLIGHTS+=('')
    fi
    _USB_PICKER_SEARCH+=("$search") _USB_PICKER_DETAILS+=("$detail")
  done
}

_usb_workspace_controller() {
  emulate -L zsh
  local selected='' image='' disk='' source_disk=''
  local image_query='' image_initial_value='' refresh_path=''
  local -a image_exclusion=()
  local checksum='' checksum_algorithm='' checksum_subtitle='' architecture_label=''
  local media_kind=raw-image media_error='' review_breadcrumb='' review_refusal=''
  local checksum_state=not-provided checksum_actual=''
  local _USB_CHECKSUM_ALGORITHM=''
  local -i image_index=1 disk_index=1 result=0 index=0 refresh_index=0
  local -i target_minimum=0
  local -a _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_HIGHLIGHTS=()
  local -a _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=() reply=()

  while true; do
    _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_HIGHLIGHTS=() _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
    _USB_PICKER_VALUES+=(custom-path)
    _USB_PICKER_LABELS+=('Custom path to media…')
    _USB_PICKER_HIGHLIGHTS+=('')
    _USB_PICKER_SEARCH+=(custom path browse home finder)
    _USB_PICKER_DETAILS+=('Custom path to media'$'\n\n''Browse from ~/ with Compozsh fuzzy matching. Use Right or Return to enter a folder, Left to return, and choose one ISO, IMG, or full Install macOS application.')
    for (( index = 1; index <= ${#_USB_IMAGE_PATHS}; ++index )); do
      _USB_PICKER_VALUES+=("image:$index") _USB_PICKER_LABELS+=("${_USB_IMAGE_LABELS[index]}")
      _USB_PICKER_HIGHLIGHTS+=("${_USB_IMAGE_HIGHLIGHTS[index]}")
      _USB_PICKER_SEARCH+=("${_USB_IMAGE_PATHS[index]}")
      _USB_PICKER_DETAILS+=("${_USB_IMAGE_DETAILS[index]}")
    done
    _usb_choose 'External device / Flash · Step 1 of 3' \
      "MEDIA  ›  Drive  ›  Flash · newest first · ${_USB_IMAGE_CAPTURE_SCOPE}" \
      'Filter media' 1 1 1 'captured media · Ctrl-R refresh Spotlight' \
      "$image_query" "$image_initial_value" choice "${image_exclusion[1]-}" "${image_exclusion[2]:-0}" "${image_exclusion[3]:-0}"
    result=$?
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    if [[ $_ZLE_PICKER_ACTION == refresh ]]; then
      image_query=${_ZLE_PICKER_BOOKMARK[1]-}
      image_exclusion=("${_ZLE_PICKER_BOOKMARK[4]-}" "${_ZLE_PICKER_BOOKMARK[5]:-0}" "${_ZLE_PICKER_BOOKMARK[6]:-0}")
      refresh_path=''
      [[ $selected == image:<-> ]] && refresh_path=${_USB_IMAGE_PATHS[${selected#image:}]-}
      _usb_images_capture || return $?
      refresh_index=${_USB_IMAGE_PATHS[(Ie)$refresh_path]}
      if [[ -n $refresh_path ]] && (( !refresh_index )); then
        if _usb_media_add "$refresh_path"; then
          _USB_IMAGE_CAPTURE_SCOPE+=' + selected exact path'
          _usb_images_sort_newest
        fi
      fi
      refresh_index=${_USB_IMAGE_PATHS[(Ie)$refresh_path]}
      if [[ -n $refresh_path ]] && (( refresh_index )); then
        image_initial_value="image:$refresh_index"
      else
        image_initial_value=''
      fi
      continue
    fi
    image_query='' image_initial_value='' image_exclusion=()
    if [[ $selected == custom-path ]]; then
      _usb_browse_image_path
      result=$?
      (( result == 1 )) && continue
      (( result == 0 )) || return $result
      if (( !${_USB_IMAGE_PATHS[(Ie)$REPLY]} )); then
        _usb_image_from_query "$REPLY" || continue
      fi
      _usb_images_sort_newest
      image_index=${_USB_IMAGE_PATHS[(Ie)$REPLY]}
    else
      image_index=${selected#image:}
    fi
    image=${_USB_IMAGE_PATHS[image_index]}
    media_kind=${_USB_IMAGE_KINDS[image_index]:-raw-image}
    if [[ -e $image ]]; then
      _usb_media_kind_capture "$image"
      result=$?
      if (( result != 0 )); then
        media_error=${_USB_MEDIA_ERROR:-'macOS could not classify the selected media safely'}
        _usb_media_attention_choose "$image" \
          "Media inspection failed · $media_error" \
          "$media_error"
        continue
      fi
      media_kind=$REPLY
    fi
    if [[ $media_kind == windows-installer ]]; then
      _usb_windows_unsupported_choose "$image"
      return 1
    fi
    if [[ $media_kind == macos-installer ]] && ! _usb_macos_codesign_verify "$image"; then
      _usb_media_attention_choose "$image" \
        'macOS installer validation failed · Nothing can be written' \
        'The selected application is incomplete or did not pass Apple code-signature validation. Download the full installer again with Software Update, the App Store, or softwareupdate.'
      continue
    fi
    checksum='' checksum_algorithm='' checksum_state=not-provided checksum_actual=''
    _USB_SELECTED_IMAGE_ARCHITECTURE=''
    _usb_image_architecture_capture "$image"

    _usb_image_source_disk_retry "$image"
    result=$?
    (( result == 1 )) && continue
    (( result == 0 )) || return $result
    source_disk=$_USB_IMAGE_SOURCE_DISK

    target_minimum=${_USB_IMAGE_SIZES[image_index]}
    if [[ $media_kind == macos-installer ]]; then
      _usb_target_choose "${_USB_IMAGE_SIZES[image_index]}" "${image:t}" \
        image 'Choose another installer' "$source_disk" \
        "Media  ›  DRIVE  ›  Create macOS installer · ${image:t}" "$media_kind"
    else
      _usb_target_choose "$target_minimum" "${image:t}" \
        image 'Choose another image' "$source_disk" '' "$media_kind"
    fi
    result=$?
    (( result == 1 )) && continue
    (( result == 0 )) || return $result
    disk_index=$_ZLE_PICKER_SELECTED_VALUE
    disk=${_USB_DISK_IDS[disk_index]}

    if [[ $media_kind == macos-installer ]]; then
      while true; do
        _usb_macos_review_choose "$image" "$disk_index"
        result=$?
        (( result == 1 )) && break
        (( result == 0 )) || return $result
        selected=$_ZLE_PICKER_SELECTED_VALUE
        case $selected in
          (image) break ;;
          (target)
            _usb_workspace_retarget "${_USB_IMAGE_SIZES[image_index]}" "${image:t}" \
              target 'Keep current target' "$source_disk" \
              'Media  ›  DRIVE  ›  Create macOS installer · refreshed' "$media_kind"
            result=$?
            (( result == 1 )) && continue
            (( result == 0 )) || return $result
            disk_index=$_ZLE_PICKER_SELECTED_VALUE
            disk=${_USB_DISK_IDS[disk_index]} ;;
          (flash-verify)
            _usb_workspace_request "$selected" "$image_index" "$disk_index" "$image" "$disk" \
              "$source_disk" "$media_kind" '' '' apple-signed
            return 0 ;;
        esac
      done
      continue
    fi

    while true; do
      _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_HIGHLIGHTS=()
      _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
      _usb_review_rows "$disk" "${image:t}" "${_USB_DISK_LABELS[disk_index]}" \
        "${_USB_IMAGE_DETAILS[image_index]}" "${_USB_DISK_DETAILS[disk_index]}" \
        "$checksum" "$checksum_algorithm" "$checksum_state" "$checksum_actual"
      _usb_picker_rows_add "${reply[@]}"
      _usb_image_architecture_short_label "$_USB_SELECTED_IMAGE_ARCHITECTURE"
      architecture_label=$REPLY
      review_breadcrumb="Image  ›  Drive  ›  FLASH · $architecture_label · ${image:t} → /dev/$disk"
      _usb_flash_review_choose "$review_breadcrumb" "$review_refusal"
      result=$? review_refusal=''
      (( result == 1 )) && break
      (( result == 0 )) || return $result
      selected=$_ZLE_PICKER_SELECTED_VALUE
      case $selected in
        (image) break ;;
        (checksum)
          checksum_subtitle='Paste one SHA-256 or SHA-512 checksum, then press Return'
          while true; do
            _usb_read_checksum "$checksum_subtitle" "$checksum"
            result=$?
            (( result == 1 )) && break
            (( result == 0 )) || return $result
            if _usb_checksum_parse "$_ZLE_PICKER_SELECTED_VALUE"; then
              checksum=$REPLY checksum_algorithm=$_USB_CHECKSUM_ALGORITHM
              checksum_state=checking checksum_actual=''
              _usb_step3_checksum_progress "$image" "$disk" \
                "${_USB_DISK_LABELS[disk_index]}" "$checksum" "$checksum_algorithm" \
                "$_USB_SELECTED_IMAGE_ARCHITECTURE"
              if ! _usb_image_revalidate "$image" "${_USB_IMAGE_FINGERPRINTS[image_index]}" \
                  "${_USB_IMAGE_SIZES[image_index]}"; then
                checksum_state=changed
              elif _usb_image_checksum "$image" "$checksum_algorithm"; then
                checksum_actual=$REPLY
                [[ $checksum_actual == "$checksum" ]] && checksum_state=matched || checksum_state=mismatch
              else
                checksum_state=error
              fi
              break
            fi
            checksum_subtitle='No single valid SHA-256 or SHA-512 digest was found; paste another'
          done
          continue ;;
        (remove-checksum)
          checksum='' checksum_algorithm='' checksum_state=not-provided checksum_actual=''
          continue ;;
        (target)
          _usb_workspace_retarget "$target_minimum" "${image:t}" \
            target 'Keep current target' "$source_disk" \
            'Image  ›  DRIVE  ›  Flash · refreshed' "$media_kind"
          result=$?
          (( result == 1 )) && continue
          (( result == 0 )) || return $result
          disk_index=$_ZLE_PICKER_SELECTED_VALUE
          disk=${_USB_DISK_IDS[disk_index]} ;;
        (flash-verify|flash-only)
          if [[ -n $checksum && $checksum_state != matched ]]; then
            review_refusal='The image integrity check must match before flashing; correct or remove the checksum'
            continue
          fi
          _usb_workspace_request "$selected" "$image_index" "$disk_index" "$image" "$disk" \
            "$source_disk" "$media_kind" "$checksum" "$checksum_algorithm" "$checksum_state"
          return 0 ;;
      esac
    done
  done
}

# A cancelled explicit recapture retains the exact prior disk snapshot. Abort
# and successful capture keep their existing status and ownership semantics.
_usb_workspace_retarget() {
  local -a _retarget_ids=("${_USB_DISK_IDS[@]}") _retarget_labels=("${_USB_DISK_LABELS[@]}")
  local -a _retarget_details=("${_USB_DISK_DETAILS[@]}") _retarget_sizes=("${_USB_DISK_SIZES[@]}")
  local -a _retarget_fingerprints=("${_USB_DISK_FINGERPRINTS[@]}")
  local -i _retarget_status=0
  _usb_target_choose "$@"; _retarget_status=$?
  if (( _retarget_status == 1 )); then
    _USB_DISK_IDS=("${_retarget_ids[@]}") _USB_DISK_LABELS=("${_retarget_labels[@]}")
    _USB_DISK_DETAILS=("${_retarget_details[@]}") _USB_DISK_SIZES=("${_retarget_sizes[@]}")
    _USB_DISK_FINGERPRINTS=("${_retarget_fingerprints[@]}")
  fi
  return $_retarget_status
}

# Capture the accepted exact target after media-specific checks. This assembles
# a request only; confirmation, validation and writes retain their boundaries.
_usb_workspace_request() {
  local -i _request_image_index=$2 _request_disk_index=$3
  _USB_REQUEST=$1 _USB_SELECTED_IMAGE=$4 _USB_SELECTED_DISK=$5
  _USB_SELECTED_MEDIA_KIND=$7
  _USB_SELECTED_IMAGE_SIZE=${_USB_IMAGE_SIZES[_request_image_index]}
  _USB_SELECTED_IMAGE_FINGERPRINT=${_USB_IMAGE_FINGERPRINTS[_request_image_index]}
  _USB_SELECTED_DISK_FINGERPRINT=${_USB_DISK_FINGERPRINTS[_request_disk_index]}
  _USB_SELECTED_DISK_SIZE=${_USB_DISK_SIZES[_request_disk_index]}
  _USB_SELECTED_DISK_LABEL=${_USB_DISK_LABELS[_request_disk_index]}
  _USB_SELECTED_SOURCE_DISK=$6
  _USB_SELECTED_CHECKSUM=$8 _USB_SELECTED_CHECKSUM_ALGORITHM=$9
  _USB_SELECTED_IMAGE_INTEGRITY=${10}
}

_usb_image_revalidate() {
  emulate -L zsh
  local image_path=$1 expected_fingerprint=$2 expected_size=$3
  _usb_image_fingerprint "$image_path" || return 1
  [[ $REPLY == "$expected_fingerprint" && $expected_size == <-> ]] || return 1
  [[ ${${REPLY#*:*:}%%:*} == "$expected_size" ]]
}

_usb_target_revalidate() {
  emulate -L zsh
  local identifier=$1 expected_fingerprint=$2 image_size=$3
  _usb_disk_info_capture "$identifier" || return 1
  _usb_info_is_eligible || return 1
  [[ $_USB_INFO_FINGERPRINT == "$expected_fingerprint" ]] || return 1
  (( _USB_INFO_SIZE >= image_size ))
}



_usb_noop() {
  return 0
}

# Paint one stable stage frame. The caller then performs its synchronous
# effect while that frame remains visible; dd publishes determinate updates.
_usb_progress_stage() {
  (( ${+functions[_zle_ui_view]} && ${+functions[_zle_picker_capture]} )) || return 0
  _zle_ui_view status _usb_progress_view "$@"
}

_usb_progress_view() {
  emulate -L zsh
  local stage=$1 style='' line='' integrity_status=''
  local image=${_USB_SELECTED_IMAGE:-} disk_label=${_USB_SELECTED_DISK_LABEL:-}
  local _ZLE_PICKER_BUSY_LABEL="● ${stage:u}"
  shift
  if [[ -n $image ]]; then
    if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} == macos-installer ]]; then
      _ZLE_PICKER_BUSY_LINES=(
        '' 'MACOS INSTALLER' "  ${image:t}" "  ${image:h}"
        '' 'TARGET' "  ${disk_label:-/dev/${_USB_SELECTED_DISK}}" ''
        'SOURCE VALIDATION' '  Verified · Apple-signed full installer' '')
      _ZLE_PICKER_BUSY_STYLES=(
        picker-text picker-status-heading picker-status-info picker-status-muted
        picker-text picker-status-heading picker-status-info picker-text
        picker-status-heading picker-status-success picker-text)
    else
      _ZLE_PICKER_BUSY_LINES=(
        '' 'IMAGE' "  ${image:t}" "  ${image:h}"
      '' 'TARGET' "  ${disk_label:-/dev/${_USB_SELECTED_DISK}}" '')
      _ZLE_PICKER_BUSY_STYLES=(
        picker-text picker-status-heading picker-status-info picker-status-muted
        picker-text picker-status-heading picker-status-info picker-text)
      if [[ -n ${_USB_SELECTED_CHECKSUM:-} ]]; then
        integrity_status='Provided · verification pending'
        case ${_USB_SELECTED_IMAGE_INTEGRITY:-} in
          (matched) integrity_status="Verified in Step 3 · SHA-${_USB_SELECTED_CHECKSUM_ALGORITHM} matched" ;;
          (checking) integrity_status="Checking · SHA-${_USB_SELECTED_CHECKSUM_ALGORITHM}" ;;
        esac
        _ZLE_PICKER_BUSY_LINES+=(
          'IMAGE INTEGRITY' "  $integrity_status" '')
        _ZLE_PICKER_BUSY_STYLES+=(
          picker-status-heading picker-status-info picker-text)
      else
        _ZLE_PICKER_BUSY_LINES+=(
          'IMAGE INTEGRITY' '  Not verified · no checksum provided' '')
        _ZLE_PICKER_BUSY_STYLES+=(
          picker-status-heading picker-status-warning picker-text)
      fi
      if [[ -n ${_USB_SELECTED_IMAGE_ARCHITECTURE:-} ]]; then
        _usb_image_architecture_short_label "$_USB_SELECTED_IMAGE_ARCHITECTURE"
        _ZLE_PICKER_BUSY_LINES+=(
          'IMAGE ARCHITECTURE' "  $REPLY" '')
        _ZLE_PICKER_BUSY_STYLES+=(
          picker-status-heading picker-status-info picker-text)
      fi
    fi
  fi
  while (( $# >= 2 )); do
    style=$1 line=$2
    shift 2
    case $style in
      (heading|info|progress|warning|muted) ;;
      (*) style=info ;;
    esac
    _ZLE_PICKER_BUSY_LINES+=("$line")
    _ZLE_PICKER_BUSY_STYLES+=("picker-status-$style")
  done
  _zle_picker_capture 'External device / Flash · Step 3 of 3' 'Image  ›  Drive  ›  FLASH' '' _usb_noop
}

# Pure parse of complete native writer status lines from one bounded read.
# Byte records count toward the stage in effect, starting from `stage`; markers
# switch the stage or record success evidence; any other short printable line
# becomes the latest diagnostic. A verify-bytes marker counts only within
# `total` and above the verify bytes already parsed. reply=(stage seen, stage,
# write bytes, verify bytes, verified, tail verified, diagnostic).
_usb_write_progress_parse() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local complete=$1 stage=$2 total=$3 line='' byte_text='' diagnostic='' REPLY=''
  local -i stage_seen=0 write_bytes=0 verify_bytes=0 verified=0 tail_verified=0
  reply=()
  (( ${+functions[_usb_dd_progress_bytes]} )) && [[ $total == <-> ]] || return 1
  for line in "${(f)complete}"; do
    if _usb_dd_progress_bytes "$line"; then
      if [[ $stage == verify ]]; then
        verify_bytes=$REPLY
      else
        write_bytes=$REPLY
      fi
      continue
    fi
    line=${line##[[:space:]]#}
    case $line in
      (compozsh-write-stage:*)
        stage=${line#compozsh-write-stage:} stage_seen=1
        continue ;;
      (compozsh-write-verify-bytes:<->)
        byte_text=${line#compozsh-write-verify-bytes:}
        (( ${#byte_text} <= 18 )) &&
          (( 10#$byte_text <= total && 10#$byte_text > verify_bytes )) &&
          verify_bytes=$(( 10#$byte_text ))
        continue ;;
      (compozsh-write-verified) verified=1; continue ;;
      (compozsh-write-tail-verified) tail_verified=1; continue ;;
      (''|*' records in'|*' records out') continue ;;
    esac
    if (( ${#line} <= 512 )) && [[ $line != *[[:cntrl:]]* ]]; then
      diagnostic=$line
    fi
  done
  reply=($stage_seen "$stage" $write_bytes $verify_bytes $verified $tail_verified "$diagnostic")
}

# Pure Step 3 progress-bar width for a terminal `columns` wide: half the width
# beyond a 12-column margin, kept within 24 to 64 cells, from 80 columns when
# the width is not a number. REPLY=width.
_usb_progress_bar_width() {
  emulate -L zsh
  local columns=$1
  local -i width=0
  [[ $columns == <-> && ${#columns} -le 18 ]] || columns=80
  width=$(( (10#$columns - 12) / 2 ))
  (( width < 24 )) && width=24
  (( width > 64 )) && width=64
  REPLY=$width
}

_usb_dd_progress_read() {
  emulate -L zsh
  (( ${+functions[_usb_dd_progress_bytes]} )) || { REPLY='Shared parsing support unavailable'; return 1; }
  local progress_file=$1 total=$2 started=$3 raw='' chunk=''
  local complete='' size_text=''
  local -i progress_fd=-1 chunk_size=0 new_size=0 raw_size=0
  local -i bytes=0 write_bytes=0 verify_bytes=0
  local -i elapsed=$(( SECONDS - started )) bar_width=32
  local -a reply=()
  _usb_progress_bar_width "${COLUMNS:-80}"
  bar_width=$REPLY
  REPLY=''
  (( ${+functions[_usb_progress_bar]} )) && _usb_progress_bar 0 $bar_width
  _USB_PROGRESS_BAR=$REPLY
  REPLY='Preparing the first write block…'
  [[ -f $progress_file && $total == <-> ]] || return 0
  size_text=$(command /usr/bin/stat -f '%z' "$progress_file" 2>/dev/null) || return 0
  [[ $size_text == <-> && ${#size_text} -le 18 ]] || return 0
  raw_size=$size_text
  (( raw_size >= _USB_WRITE_PROGRESS_OFFSET )) || {
    _USB_WRITE_ERROR='the bounded progress stream changed unexpectedly'
    return 0
  }
  new_size=$(( raw_size - _USB_WRITE_PROGRESS_OFFSET ))
  if (( new_size > 0 )); then
    (( new_size <= 1048576 )) || {
      _USB_WRITE_ERROR='the native writer produced too much unparsed status output'
      return 0
    }
    zmodload zsh/system 2>/dev/null || return 0
    exec {progress_fd}< "$progress_file" || return 0
    {
      sysseek -u "$progress_fd" "$_USB_WRITE_PROGRESS_OFFSET" || return 0
      while (( new_size > 0 )); do
        chunk_size=$(( new_size < 65536 ? new_size : 65536 ))
        sysread -i "$progress_fd" -s "$chunk_size" -c chunk_size chunk || break
        (( chunk_size > 0 )) || break
        raw+=$chunk
        (( _USB_WRITE_PROGRESS_OFFSET += chunk_size ))
        (( new_size -= chunk_size ))
      done
    } always {
      exec {progress_fd}<&-
    }
  else
    [[ -n $_USB_WRITE_PROGRESS_REMAINDER ]] || raw=$'\n'
  fi
  raw=$_USB_WRITE_PROGRESS_REMAINDER$raw
  raw=${raw//$'\r'/$'\n'}
  if [[ $raw != *$'\n'* ]]; then
    _USB_WRITE_PROGRESS_REMAINDER=$raw
    return 0
  fi
  _USB_WRITE_PROGRESS_REMAINDER=${raw##*$'\n'}
  if [[ -n $_USB_WRITE_PROGRESS_REMAINDER ]]; then
    complete=${raw[1,$(( ${#raw} - ${#_USB_WRITE_PROGRESS_REMAINDER} ))]}
  else
    complete=$raw
  fi
  _usb_write_progress_parse "$complete" "$_USB_WRITE_PROGRESS_STAGE" "$total" || return 0
  if [[ $reply[1] == 1 ]]; then
    _USB_WRITE_PROGRESS_STAGE=$reply[2] _USB_WRITE_STAGE=$reply[2]
  fi
  write_bytes=$reply[3] verify_bytes=$reply[4]
  [[ $reply[5] == 1 ]] && _USB_WRITE_VERIFIED=1
  [[ $reply[6] == 1 ]] && _USB_WRITE_TAIL_VERIFIED=1
  [[ -n $reply[7] ]] && _USB_WRITE_ERROR=$reply[7]
  (( write_bytes > _USB_WRITE_BYTES_OBSERVED )) &&
    _USB_WRITE_BYTES_OBSERVED=$write_bytes
  (( verify_bytes > _USB_WRITE_VERIFY_BYTES_OBSERVED )) &&
    _USB_WRITE_VERIFY_BYTES_OBSERVED=$verify_bytes
  if [[ $_USB_WRITE_STAGE == verify ]]; then
    bytes=$_USB_WRITE_VERIFY_BYTES_OBSERVED
  else
    bytes=$_USB_WRITE_BYTES_OBSERVED
  fi
  if (( ${+functions[_usb_progress_model]} && ${+functions[_usb_progress_bar]} &&
        ${+functions[_usb_human_size]} && ${+functions[_usb_human_duration]} )) &&
      _usb_progress_model "$bytes" "$total" "$elapsed" "$bar_width"; then
    _USB_PROGRESS_BAR=$reply[1]
    REPLY=$reply[2]
  else
    REPLY='Write progress detail unavailable'
  fi
}

_usb_authorize() {
  command /usr/bin/sudo -v
}

_usb_authorization_valid() {
  command /usr/bin/sudo -n -v
}

_usb_unmount() {
  command /usr/sbin/diskutil unmountDisk "/dev/$1"
}

_usb_raw_write_script_capture() {
  emulate -L zsh
  REPLY='emulate -LR zsh
zmodload zsh/system || exit
zmodload zsh/stat || exit
local image=$1 device=$2 sector_count=$3 tail_seek=$4 tail_count=$5 verify=${6:-0}
local block_size=${7:-512} expected_fingerprint=${8:-}
local -a verify_status=() expected_fields=() image_stat=()
local verify_bulk_label=4m
local -i tail_byte_offset=0 tail_bytes=0 tail_blocks=0 tail_block_seek=0
local -i image_bytes=0 block_sectors=0 image_fd=-1
local -i verify_bulk_bytes=4194304 verify_bulk_blocks=0
local -i verify_tail_bytes=0 verify_tail_blocks=0 verify_tail_skip=0
[[ -f $image && ! -L $image ]] || exit 2
[[ (-c $device || -f $device) && ! -L $device ]] || exit 2
[[ $sector_count == <-> && $tail_seek == <-> && $tail_count == <-> &&
   $verify == [01] && $block_size == <-> && -n $expected_fingerprint ]] || exit 2
(( sector_count > 0 && tail_seek >= 0 && tail_count >= 0 )) || exit 2
(( block_size >= 512 && block_size % 512 == 0 )) || exit 2
block_sectors=$(( block_size / 512 ))
image_bytes=$(( sector_count * 512 ))
(( image_bytes > 0 && image_bytes / 512 == sector_count )) || exit 2
(( image_bytes % block_size == 0 && tail_seek % block_sectors == 0 &&
   tail_count % block_sectors == 0 )) || exit 2
if (( verify_bulk_bytes % block_size != 0 )); then
  verify_bulk_bytes=$block_size
  verify_bulk_label=$block_size
fi
verify_bulk_blocks=$(( image_bytes / verify_bulk_bytes ))
verify_tail_bytes=$(( image_bytes % verify_bulk_bytes ))
verify_tail_blocks=$(( verify_tail_bytes / block_size ))
verify_tail_skip=$(( verify_bulk_blocks * (verify_bulk_bytes / block_size) ))
expected_fields=("${(@s/:/)expected_fingerprint}")
(( ${#expected_fields} == 5 )) || exit 2
[[ $expected_fields[1] == <-> && $expected_fields[2] == <-> &&
   $expected_fields[3] == <-> && $expected_fields[4] == <-> &&
   $expected_fields[5] == <-> ]] || exit 2
sysopen -r -o nofollow -u image_fd -- "$image" || exit 7
zstat -A image_stat -f "$image_fd" || exit 7
[[ $image_stat[1] == "$expected_fields[1]" &&
   $image_stat[2] == "$expected_fields[2]" &&
   $image_stat[8] == "$expected_fields[3]" &&
   $image_stat[10] == "$expected_fields[4]" &&
   $expected_fields[3] == "$image_bytes" ]] || exit 7
print -u2 -r -- compozsh-write-stage:open
if [[ -c $device ]]; then
  if (( verify )); then
    exec 9<> "$device" || exit 1
  else
    exec 9> "$device" || exit 1
  fi
else
  exec 9<> "$device" || exit 1
fi
print -u2 -r -- compozsh-write-stage:image
command /bin/dd if="/dev/fd/$image_fd" ibs=512 obs=4m count="$sector_count" \
  conv=notrunc,fsync status=progress >&9 || exit
if (( tail_count > 0 )); then
  print -u2 -r -- compozsh-write-stage:tail
  tail_byte_offset=$(( tail_seek * 512 ))
  tail_bytes=$(( tail_count * 512 ))
  tail_blocks=$(( tail_bytes / block_size ))
  tail_block_seek=$(( tail_byte_offset / block_size ))
  sysseek -u 9 "$tail_byte_offset" || exit
  command /bin/dd if=/dev/zero bs="$block_size" count="$tail_blocks" \
    conv=notrunc,fsync status=none >&9 || exit
fi
if (( verify )); then
  print -u2 -r -- compozsh-write-stage:verify
  zstat -A image_stat -f "$image_fd" || exit 7
  [[ $image_stat[1] == "$expected_fields[1]" &&
     $image_stat[2] == "$expected_fields[2]" &&
     $image_stat[8] == "$expected_fields[3]" ]] || exit 7
  sysseek -u "$image_fd" 0 || exit 7
  {
    if (( verify_bulk_blocks > 0 )); then
      command /bin/dd if="$device" bs="$verify_bulk_label" \
        count="$verify_bulk_blocks" iflag=direct,fullblock \
        status=progress || exit 6
    fi
    if (( verify_tail_blocks > 0 )); then
      command /bin/dd if="$device" bs="$block_size" skip="$verify_tail_skip" \
        count="$verify_tail_blocks" iflag=direct,fullblock \
        status=progress || exit 6
    fi
  } |
    (
      local -i compare_status=0
      command /usr/bin/cmp -s -n "$image_bytes" - "/dev/fd/$image_fd"
      compare_status=$?
      # cmp exits at the first difference. Drain the bounded reader so it never
      # receives SIGPIPE and its own raw-device status remains authoritative.
      command /bin/cat >/dev/null
      exit $compare_status
    )
  verify_status=("${pipestatus[@]}")
  (( verify_status[1] == 0 )) || exit 6
  print -u2 -r -- "compozsh-write-verify-bytes:$image_bytes"
  (( verify_status[2] == 1 )) && exit 5
  (( verify_status[2] == 0 )) || exit 7
  if (( tail_count > 0 )); then
    command /bin/dd if="$device" bs="$block_size" skip="$tail_block_seek" \
      count="$tail_blocks" iflag=direct status=none |
      (
        local -i compare_status=0
        command /usr/bin/cmp -s -n "$tail_bytes" - /dev/zero
        compare_status=$?
        command /bin/cat >/dev/null
        exit $compare_status
      )
    verify_status=("${pipestatus[@]}")
    (( verify_status[1] == 0 )) || exit 6
    (( verify_status[2] == 1 )) && exit 8
    (( verify_status[2] == 0 )) || exit 7
    print -u2 -r -- compozsh-write-tail-verified
  fi
  print -u2 -r -- compozsh-write-verified
fi'
}

_usb_raw_write_session_run() {
  emulate -L zsh
  local image=$1 identifier=$2 sector_count=$3 tail_seek=$4 tail_count=$5
  local verify=${6:-0}
  local block_size=${7:-512}
  local expected_fingerprint=${8:-}
  [[ -f $image && ! -L $image && $identifier == disk<-> ]] || return 2
  [[ $sector_count == <-> && $tail_seek == <-> && $tail_count == <-> &&
     $verify == [01] && $block_size == <-> && -n $expected_fingerprint ]] || return 2
  (( sector_count > 0 && tail_seek >= 0 && tail_count >= 0 )) || return 2
  # Keep one privileged descriptor open from the first image byte through
  # physical-tail cleanup and read-back. No raw-device close occurs inside
  # that session before verification evidence is captured.
  _usb_raw_write_script_capture
  command /usr/bin/sudo -n /bin/zsh -fc "$REPLY" compozsh-raw-write \
    "$image" "/dev/r${identifier}" "$sector_count" \
    "$tail_seek" "$tail_count" "$verify" "$block_size" "$expected_fingerprint"
}

# Pure raw-write geometry from byte sizes and the target's logical block size.
# reply=(image sectors, tail seek, tail count) in 512-byte sectors: the
# physical-tail clear covers the 33-sector backup GPT, rounded up to whole
# logical blocks and capped at the space after the image, so it never touches
# image bytes. Status 2 refuses sizes the raw writer must not receive: empty,
# unaligned or larger than the target.
_usb_write_geometry() {
  emulate -L zsh
  local image_size=$1 target_size=$2 block_size=$3
  local -i block_sectors=0 sector_count=0 target_sectors=0
  local -i trailing_sectors=0 tail_clear_sectors=0 tail_seek=0 tail_count=0
  reply=()
  [[ $image_size == <-> && $target_size == <-> && $block_size == <-> ]] || return 2
  (( block_size >= 512 && block_size % 512 == 0 )) || return 2
  (( image_size > 0 && image_size % block_size == 0 )) || return 2
  (( target_size >= image_size && target_size % block_size == 0 )) || return 2
  block_sectors=$(( block_size / 512 ))
  sector_count=$(( image_size / 512 ))
  target_sectors=$(( target_size / 512 ))
  trailing_sectors=$(( target_sectors - sector_count ))
  if (( trailing_sectors > 0 )); then
    tail_clear_sectors=$(( (33 + block_sectors - 1) / block_sectors * block_sectors ))
    tail_count=$(( trailing_sectors < tail_clear_sectors ? trailing_sectors : tail_clear_sectors ))
    tail_seek=$(( target_sectors - tail_count ))
  fi
  reply=($sector_count $tail_seek $tail_count)
}

# Runs one native USB worker in the background with its output in the
# caller's new owner-only `progress_file`, a compozsh-* file directly in
# TMPDIR, and removes that file on every exit, invalid arguments included.
# The file captures standard error (`stderr`, standard output stays the
# caller's) or both streams (`both`). While the worker runs, `reader` gets
# `running`, the file and its own arguments every quarter second, and once
# after the worker exits it gets `finished` instead; readers read the file and
# paint their own stage. An error or interrupt that leaves the loop early
# interrupts a worker that is still running and reaps it. REPLY is the
# reader's last REPLY, empty when no worker started. Returns the worker's
# status, or 2 for invalid arguments.
# Usage: _usb_worker_progress_run <progress-file> <stderr|both> <reader> [reader-arg...] -- <command> [arg...]
_usb_worker_progress_run() {
  emulate -L zsh
  setopt NO_BG_NICE
  unsetopt MONITOR NOTIFY
  local progress_file=${1-} stream=${2-} reader=${3-} temp_root=${TMPDIR:-/tmp}
  local -i worker=0 command_status=2 separator=0
  local -a reader_arguments=()
  REPLY=''
  {
    (( $# >= 5 )) || return 2
    shift 3
    separator=${argv[(ie)--]}
    (( separator < $# )) || return 2
    reader_arguments=("${(@)argv[1,separator-1]}")
    shift $separator
    [[ -f $progress_file && $stream == (stderr|both) ]] &&
      (( ${+functions[$reader]} )) || return 2
    if [[ $stream == both ]]; then
      "$@" >| "$progress_file" 2>&1 &
    else
      "$@" 2>| "$progress_file" &
    fi
    worker=$!
    while builtin kill -0 $worker 2>/dev/null; do
      "$reader" running "$progress_file" "${reader_arguments[@]}"
      command /bin/sleep 0.25
    done
    wait $worker
    command_status=$?
    "$reader" finished "$progress_file" "${reader_arguments[@]}"
  } always {
    if (( worker )) && builtin kill -0 $worker 2>/dev/null; then
      builtin kill -INT $worker 2>/dev/null
      wait $worker 2>/dev/null
    fi
    if [[ ${progress_file:t} == compozsh-?*.?* &&
          ${progress_file:h:A} == ${temp_root:A} ]]; then
      command /bin/rm -f -- "$progress_file"
    fi
  }
  return $command_status
}

# Reads the native writer's progress and, while it runs, paints the write or
# verify stage. The first read in the verify stage starts the calling
# _usb_write_image's verify_started clock; the read after the writer exits
# records how long verification took. $1 running|finished, $2 progress file,
# $3 image bytes, $4 starting SECONDS.
_usb_write_progress_poll() {
  emulate -L zsh
  local phase=$1 title='Writing image'
  _usb_dd_progress_read "$2" "$3" "$4"
  if [[ $_USB_WRITE_STAGE == verify ]]; then
    (( verify_started )) || verify_started=$SECONDS
    title='Verifying USB against image'
  fi
  if [[ $phase == finished ]]; then
    [[ $_USB_WRITE_STAGE == verify ]] &&
      _USB_WRITE_VERIFY_SECONDS=$(( SECONDS - verify_started ))
    return 0
  fi
  _usb_progress_stage "$title" \
    progress "$_USB_PROGRESS_BAR" info "$REPLY" \
    warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
}

_usb_write_image() {
  emulate -L zsh
  local image=$1 identifier=$2 image_size=$3 target_size=${4:-$3}
  local verify=${5:-0}
  local block_size=${6:-512}
  local image_fingerprint=${7:-}
  local temp_root=${TMPDIR:-/tmp} progress_file=''
  local -i command_status=1 started=$SECONDS sector_count=0
  # Started by _usb_write_progress_poll when the verify stage first appears.
  local -i verify_started=0 tail_count=0 tail_seek=0
  local -a reply=()
  _USB_WRITE_BYTES_OBSERVED=0 _USB_WRITE_VERIFY_BYTES_OBSERVED=0
  _USB_WRITE_VERIFY_SECONDS=0 _USB_WRITE_VERIFIED=0
  _USB_WRITE_TAIL_VERIFIED=0
  _USB_WRITE_PROGRESS_OFFSET=0 _USB_WRITE_PROGRESS_STAGE=''
  _USB_WRITE_PROGRESS_REMAINDER=''
  _USB_WRITE_ERROR='' _USB_WRITE_STAGE=''
  (( ${+functions[_usb_dd_progress_bytes]} )) || {
    _USB_WRITE_ERROR='Shared byte-progress parsing support unavailable; nothing was written.'
    return 1
  }
  [[ $verify == [01] ]] || return 2
  _usb_write_geometry "$image_size" "$target_size" "$block_size" || return 2
  sector_count=$reply[1] tail_seek=$reply[2] tail_count=$reply[3]
  progress_file=$(command /usr/bin/mktemp "${temp_root%/}/compozsh-usb-progress.XXXXXX" 2>/dev/null) || return 1
  _usb_worker_progress_run "$progress_file" stderr \
    _usb_write_progress_poll "$image_size" $started -- \
    _usb_raw_write_session_run "$image" "$identifier" "$sector_count" \
      "$tail_seek" "$tail_count" "$verify" "$block_size" "$image_fingerprint"
  command_status=$?
  if (( command_status == 0 && _USB_WRITE_BYTES_OBSERVED != image_size )); then
    command_status=3
  fi
  if (( verify )) && [[ $_USB_WRITE_STAGE == verify ]] &&
      (( _USB_WRITE_VERIFY_BYTES_OBSERVED != image_size )); then
    command_status=6
  elif (( command_status == 0 && verify && tail_count > 0 &&
          !_USB_WRITE_TAIL_VERIFIED )); then
    command_status=8
  elif (( command_status == 0 && verify && !_USB_WRITE_VERIFIED )); then
    command_status=9
  fi
  if (( command_status != 0 && command_status != 5 && command_status != 6 &&
        command_status != 7 )) && [[ $_USB_WRITE_STAGE == tail ]]; then
    command_status=4
  fi
  return $command_status
}

_usb_image_checksum_run() {
  local algorithm=$1 image=$2
  command /usr/bin/shasum -a "$algorithm" -b < "$image"
}

_usb_image_checksum() {
  emulate -L zsh
  (( ${+functions[_usb_checksum_output_read]} && ${+functions[_usb_checksum_validate]} )) || { REPLY='Shared parsing support unavailable'; return 1; }
  local image=$1 algorithm=$2 output=''
  output=$(_usb_image_checksum_run "$algorithm" "$image") || return 1
  _usb_checksum_output_read "$output" "$algorithm"
}

_usb_eject() {
  command /usr/sbin/diskutil eject "/dev/$1"
}

_usb_diskutil_erase_run() {
  command /usr/bin/sudo -n /usr/sbin/diskutil "$@"
}

_usb_macos_prepare_volume() {
  emulate -L zsh
  local identifier=$1 name='' mount_point='' plist='' parent=''
  local -i attempts=0
  REPLY=''
  [[ $identifier == disk<-> ]] || return 2
  while (( ++attempts <= 8 )); do
    name="Compozsh-${identifier}-${RANDOM}"
    [[ ! -e "/Volumes/$name" ]] && break
    name=''
  done
  [[ -n $name ]] || return 1
  _usb_diskutil_erase_run eraseDisk JHFS+ "$name" GPT "/dev/$identifier" \
    >/dev/null 2>&1 || return 1
  mount_point="/Volumes/$name"
  [[ -d $mount_point && ! -L $mount_point ]] || return 1
  _usb_diskutil_plist_capture info -plist "$mount_point" || return 1
  plist=$_USB_PLIST
  _usb_plist_optional "$plist" ParentWholeDisk
  parent=$REPLY
  [[ $parent == "$identifier" ]] || return 1
  REPLY=$mount_point
}

_usb_createinstallmedia_progress_read() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local log_path=$1 raw='' line='' prefix='' latest='Preparing Apple createinstallmedia…'
  local size_text=''
  local -i raw_size=0 percent=0 bar_width=32
  _usb_progress_bar_width "${COLUMNS:-80}"
  bar_width=$REPLY
  REPLY=''
  (( ${+functions[_usb_progress_bar]} )) && _usb_progress_bar 0 $bar_width
  _USB_PROGRESS_BAR=$REPLY
  REPLY=$latest
  [[ -f $log_path ]] || return 0
  size_text=$(command /usr/bin/stat -f '%z' "$log_path" 2>/dev/null) || return 0
  [[ $size_text == <-> && ${#size_text} -le 18 ]] || return 0
  raw_size=$size_text
  (( raw_size > 0 && raw_size <= 1048576 )) || return 0
  raw=$(<"$log_path")
  raw=${raw//$'\r'/$'\n'}
  for line in "${(f)raw}"; do
    line=${line##[[:space:]]#}
    line=${line%%[[:space:]]#}
    [[ -n $line && ${#line} -le 512 && $line != *[[:cntrl:]]* ]] || continue
    latest=$line
    if [[ $line == *%* ]]; then
      prefix=${line%%\%*}
      prefix=${prefix##*[^0-9]}
      [[ $prefix == <-> ]] && (( ${#prefix} <= 18 )) && percent=$(( 10#$prefix ))
    fi
  done
  (( percent > 100 )) && percent=100
  REPLY=''
  (( ${+functions[_usb_progress_bar]} )) && _usb_progress_bar $percent $bar_width
  _USB_PROGRESS_BAR=$REPLY
  REPLY=$latest
}

_usb_createinstallmedia_command_run() {
  emulate -L zsh
  setopt PIPE_FAIL
  local installer=$1 volume=$2 tool=''
  local -a arguments=(--volume "$volume")
  _usb_macos_installer_tool "$installer" || return 1
  tool=$REPLY
  [[ ${installer:t} == 'Install OS X El Capitan.app' ]] &&
    arguments+=(--applicationpath "$installer")
  builtin print -r -- Y | command /usr/bin/sudo -n "$tool" "${arguments[@]}"
}

# Reads Apple createinstallmedia's latest line and paints it, while the tool
# runs and once more after it exits. REPLY=the line. $1 running|finished
# (both paint), $2 progress file.
_usb_createinstallmedia_progress_poll() {
  emulate -L zsh
  local progress_text=''
  _usb_createinstallmedia_progress_read "$2"
  progress_text=$REPLY
  _usb_progress_stage 'Creating macOS installer' \
    progress "$_USB_PROGRESS_BAR" info "$progress_text" \
    warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
  REPLY=$progress_text
}

_usb_createinstallmedia_run() {
  emulate -L zsh
  local installer=$1 volume=$2 temp_root=${TMPDIR:-/tmp} progress_file='' REPLY=''
  local -i command_status=1
  _USB_CREATEINSTALLMEDIA_ERROR=''
  _usb_macos_installer_tool "$installer" >/dev/null || return 1
  [[ -d $volume && ! -L $volume ]] || return 1
  progress_file=$(command /usr/bin/mktemp \
    "${temp_root%/}/compozsh-createinstallmedia.XXXXXX" 2>/dev/null) || return 1
  _usb_worker_progress_run "$progress_file" both \
    _usb_createinstallmedia_progress_poll -- \
    _usb_createinstallmedia_command_run "$installer" "$volume"
  command_status=$?
  (( command_status == 0 )) || _USB_CREATEINSTALLMEDIA_ERROR=$REPLY
  return $command_status
}

# The media executors share one prologue and one epilogue; each validates its
# own arguments between _usb_execution_begin and _usb_execution_authorize, and
# revalidates its source and the target after authorizing.

# Starts an execution with empty shared result evidence, failing closed when
# the shared result support is unavailable.
_usb_execution_begin() {
  emulate -L zsh
  if (( ! ${+functions[_usb_result_reset]} )); then
    _USB_RESULT_OUTCOME=failed _USB_RESULT_ERROR='Shared USB result support is unavailable; nothing was written.'
    return 1
  fi
  _usb_result_reset
}

# Refuses a target that is one of the source's whole disks, shows the
# validating stage, then authorizes unless the caller already has. Nothing has
# been written when it fails. $1 target, $2 space-separated source whole disks,
# $3 nonzero when the caller already authorized, $4 refusal for a target
# holding the source, $5 stage title, $6 stage detail.
_usb_execution_authorize() {
  emulate -L zsh
  local identifier=$1 source_disk=$2 authorized=$3
  if [[ -n $source_disk && " $source_disk " == *" $identifier "* ]]; then
    _USB_RESULT_OUTCOME=failed _USB_RESULT_ERROR=$4
    return 1
  fi
  _usb_progress_stage "$5" info "$6" muted 'No disk data has been changed yet.'
  (( authorized )) || _usb_authorize || {
    _USB_RESULT_OUTCOME=failed _USB_RESULT_ERROR='Administrator authorization failed; nothing was written.'
    return 1
  }
}

# Ejects the target, records the total time after the eject, then settles the
# outcome: a failed action keeps its status and message, a failed eject after
# a successful action fails with $4, and anything else is complete. $2 and $3
# are the caller's typed action status and starting SECONDS.
_usb_execution_finish() {
  emulate -L zsh
  local identifier=$1 eject_error=$4
  local -i action_status=$2 execution_started=$3 eject_status=0
  _usb_progress_stage 'Ejecting external drive' \
    info 'Finishing the operation and making the drive safe to remove.'
  _usb_eject "$identifier" >/dev/null 2>&1
  eject_status=$?
  (( eject_status == 0 )) && _USB_RESULT_EJECTED=1
  _USB_RESULT_SECONDS=$(( SECONDS - execution_started ))
  (( action_status )) && return $action_status
  if (( eject_status )); then
    _USB_RESULT_OUTCOME=failed _USB_RESULT_ERROR=$eject_error
    return $eject_status
  fi
  _USB_RESULT_OUTCOME=complete
}

_usb_macos_execute() {
  emulate -L zsh
  local installer=$1 identifier=$2 disk_fingerprint=$3 installer_fingerprint=$4
  local minimum_size=$5 request=$6 source_disk=${7:-} authorized=${8:-0}
  local target_size=${11:-$minimum_size} volume=''
  local -i action_status=0 execution_started=$SECONDS stage_started=0
  _usb_execution_begin || return
  _USB_RESULT_SOURCE_VALIDATED=0
  [[ $minimum_size == <-> && $target_size == <-> ]] || return 2
  (( target_size >= minimum_size )) || return 2
  [[ $request == flash-verify ]] || return 2
  _usb_execution_authorize "$identifier" "$source_disk" "$authorized" \
    'The selected drive contains the macOS installer source; nothing was written.' \
    'Validating Apple installer and drive' \
    'Checking the installer signature, captured identity, and exact external drive.' || return
  _usb_macos_installer_revalidate "$installer" "$installer_fingerprint" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The macOS installer changed, is incomplete, or is not Apple-signed; nothing was written.'
    return 1
  }
  _USB_RESULT_SOURCE_VALIDATED=1
  _usb_target_revalidate "$identifier" "$disk_fingerprint" "$minimum_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive changed or is no longer eligible; nothing was written.'
    return 1
  }
  _usb_progress_stage 'Revalidating exact target' \
    info 'Closing the device-identity race immediately before the first erase.' \
    warning 'NO DISK DATA HAS BEEN CHANGED YET'
  _usb_target_revalidate "$identifier" "$disk_fingerprint" "$minimum_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive changed immediately before preparation; nothing was written.'
    return 1
  }
  _USB_RESULT_STARTED=1
  _usb_progress_stage 'Preparing external drive' \
    info 'Creating one temporary Mac OS Extended volume for Apple createinstallmedia.' \
    warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
  _usb_macos_prepare_volume "$identifier"
  action_status=$?
  volume=$REPLY
  if (( action_status )); then
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='macOS could not prepare the selected whole external drive for createinstallmedia.'
  else
    _usb_macos_installer_revalidate "$installer" "$installer_fingerprint" || {
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR='The macOS installer changed while the drive was being prepared; createinstallmedia was not started.'
    }
    if (( action_status == 0 )); then
      stage_started=$SECONDS
      _usb_createinstallmedia_run "$installer" "$volume"
      action_status=$?
      _USB_RESULT_WRITE_SECONDS=$(( SECONDS - stage_started ))
      if (( action_status )); then
        _USB_RESULT_OUTCOME=failed
        _USB_RESULT_ERROR="Apple createinstallmedia failed${_USB_CREATEINSTALLMEDIA_ERROR:+: $_USB_CREATEINSTALLMEDIA_ERROR}"
      else
        _USB_RESULT_VERIFIED=1
        _USB_RESULT_VERIFY_SCOPE=apple-createinstallmedia
      fi
    fi
  fi
  _usb_execution_finish "$identifier" $action_status $execution_started \
    'The macOS installer was created, but macOS could not eject the external drive.'
}

_usb_media_execute() {
  emulate -L zsh
  local kind=$1
  shift
  case $kind in
    (raw-image) _usb_execute "$@" ;;
    (macos-installer) _usb_macos_execute "$@" ;;
    (windows-installer)
      _USB_RESULT_OUTCOME=failed _USB_RESULT_STARTED=0
      _USB_RESULT_ERROR='Windows media is unsupported on stock macOS; nothing was written.'
      return 2 ;;
    (*)
      _USB_RESULT_OUTCOME=failed _USB_RESULT_STARTED=0
      _USB_RESULT_ERROR='The selected media handler is unavailable; nothing was written.'
      return 2 ;;
  esac
}

_usb_cleanup_eject() {
  emulate -L zsh
  (( ${_USB_RESULT_STARTED:-0} && !${_USB_RESULT_EJECTED:-0} )) || return 0
  [[ ${_USB_SELECTED_DISK:-} == disk<-> ]] || return 0
  _usb_eject "$_USB_SELECTED_DISK" >/dev/null 2>&1 || return 1
  _USB_RESULT_EJECTED=1
}

# Pure failure record for a raw write that did not succeed, from the writer's
# status, final stage, observed bytes, image size and bounded native error.
# reply=(error, verify reason). Statuses 5-9 are verification evidence only
# when the writer ended in its pre-mount verify stage; status 3 (short write)
# and 4 (tail clear) win over native text, and anything else is a write failure.
_usb_write_failure_model() {
  emulate -L zsh
  local write_status=$1 stage=$2 observed_bytes=$3 image_size=$4 native_error=$5
  local error='' reason=''
  case $write_status:$stage in
    (3:*) error="Writing stopped after $observed_bytes of $image_size bytes; the USB contains an incomplete image and must not be used." ;;
    (4:*) error='The image write completed, but old physical-tail partition metadata could not be cleared safely; the USB must not be used.' ;;
    (5:verify)
      reason=mismatch
      error='The USB bytes differed from the selected image during pre-mount verification; the drive must not be used.' ;;
    (6:verify)
      reason=drive-read-failed
      error='The image was written, but the USB could not be read completely before macOS mounted it; the drive was not verified.' ;;
    (7:verify)
      reason=image-read-failed
      error='The image was written, but its source could not be reread completely during pre-mount verification; the drive was not verified.' ;;
    (8:verify)
      reason=stale-tail-gpt
      error='The image bytes matched, but the cleared physical-tail metadata did not read back as zero; the drive must not be used.' ;;
    (9:verify)
      reason=incomplete-evidence
      error='Pre-mount verification ended without complete success evidence; the drive was not verified.' ;;
    (*)
      if [[ -n $native_error ]]; then
        error="Writing failed: $native_error. The USB may contain an incomplete image and must not be used."
      else
        error='Writing failed; the USB may contain an incomplete image and must not be used.'
      fi ;;
  esac
  reply=("$error" "$reason")
}

_usb_execute() {
  emulate -L zsh
  setopt EXTENDED_GLOB NO_BG_NICE
  unsetopt MONITOR NOTIFY
  local image=$1 identifier=$2 disk_fingerprint=$3 image_fingerprint=$4
  local image_size=$5 request=$6 source_disk=${7:-} authorized=${8:-0}
  local checksum_algorithm=${9:-} expected_checksum=${10:-}
  local target_size=${11:-$image_size}
  local -i action_status=0 execution_started=$SECONDS stage_started=0
  local -i verify_during_write=0
  local -i target_block_size=512
  local -a reply=()
  _usb_execution_begin || return
  _USB_RESULT_CHECKSUM_ALGORITHM=$checksum_algorithm
  _USB_RESULT_EXPECTED_CHECKSUM=$expected_checksum _USB_RESULT_IMAGE_CHECKSUM=''
  [[ $image_size == <-> && $target_size == <-> ]] || return 2
  (( target_size >= image_size )) || return 2
  case $request in
    (flash-verify|flash-only) ;;
    (*) return 2 ;;
  esac
  [[ $request == flash-verify ]] && verify_during_write=1
  if [[ -n $expected_checksum ]]; then
    (( ${+functions[_usb_checksum_validate]} )) &&
      _usb_checksum_validate "$checksum_algorithm" "$expected_checksum" || return 2
  elif [[ -n $checksum_algorithm ]]; then
    return 2
  fi
  _usb_execution_authorize "$identifier" "$source_disk" "$authorized" \
    'The selected drive contains the image source; nothing was written.' \
    'Validating image and drive' \
    'Checking the captured image and external-drive identity before writing.' || return
  _usb_image_revalidate "$image" "$image_fingerprint" "$image_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The selected image changed after capture; nothing was written.'
    return 1
  }
  if [[ -n $expected_checksum ]]; then
    _usb_progress_stage "Checking image SHA-$checksum_algorithm" \
      info "Hashing the complete image before any external-drive data is changed." \
      muted "Expected · ${expected_checksum[1,16]}…"
    _usb_image_checksum "$image" "$checksum_algorithm" || {
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR="The image SHA-$checksum_algorithm checksum could not be calculated; nothing was written."
      return 1
    }
    _USB_RESULT_IMAGE_CHECKSUM=$REPLY
    if [[ $REPLY != "$expected_checksum" ]]; then
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR="The image SHA-$checksum_algorithm does not match the provided checksum; nothing was written."
      return 1
    fi
    _USB_RESULT_CHECKSUM_VALIDATED=1
  fi
  _usb_target_revalidate "$identifier" "$disk_fingerprint" "$image_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive changed or is no longer eligible; nothing was written.'
    return 1
  }
  target_block_size=${_USB_INFO_BLOCK_SIZE:-512}
  if (( target_block_size < 512 || target_block_size % 512 != 0 ||
        image_size % target_block_size != 0 || target_size % target_block_size != 0 )); then
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR="The image or target size is not aligned to this drive's $target_block_size-byte logical blocks; nothing was written."
    return 1
  fi
  if ! _usb_authorization_valid >/dev/null 2>&1; then
    _usb_progress_stage 'Authorization required for writing' \
      info 'Re-enter the administrator password before the external drive is unmounted or changed.' \
      muted 'No disk data has been changed yet.'
    _usb_authorize || {
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR='Administrator authorization expired before writing; nothing was written.'
      return 1
    }
  fi
  _usb_progress_stage 'Unmounting external drive' \
    info 'Preparing the whole external drive for a raw image write.' \
    warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
  _usb_unmount "$identifier" >/dev/null 2>&1 || {
    _USB_RESULT_OUTCOME=failed _USB_RESULT_ERROR='The external drive could not be unmounted; nothing was written.'
    return 1
  }
  _usb_target_revalidate "$identifier" "$disk_fingerprint" "$image_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive changed after unmounting; nothing was written.'
    _usb_eject "$identifier" >/dev/null 2>&1 && _USB_RESULT_EJECTED=1
    return 1
  }
  if (( ${_USB_INFO_BLOCK_SIZE:-512} != target_block_size )); then
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive block geometry changed after unmounting; nothing was written.'
    _usb_eject "$identifier" >/dev/null 2>&1 && _USB_RESULT_EJECTED=1
    return 1
  fi
  _USB_RESULT_STARTED=1
  _usb_progress_stage 'Writing image' \
    info 'Starting Apple dd with 4 MiB blocks.' \
    warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
  stage_started=$SECONDS
  _usb_write_image "$image" "$identifier" "$image_size" "$target_size" \
    "$verify_during_write" "$target_block_size" "$image_fingerprint"
  action_status=$?
  _USB_RESULT_WRITE_SECONDS=$(( SECONDS - stage_started ))
  # Flash & verify trusts only the held write session's evidence. Success
  # without it fails closed like the writer's own status 9: a later reread
  # could see media that macOS has already mounted and modified.
  if (( action_status == 0 && verify_during_write && !_USB_WRITE_VERIFIED )); then
    action_status=9
    _USB_WRITE_STAGE=verify
  fi
  if (( action_status == 0 )); then
    _USB_RESULT_BYTES=$image_size
    if (( verify_during_write )); then
      _USB_RESULT_VERIFIED=1
      _USB_RESULT_VERIFY_SCOPE=full
      _USB_RESULT_VERIFY_REASON=''
      _USB_RESULT_VERIFY_SECONDS=$_USB_WRITE_VERIFY_SECONDS
    fi
    if (( ${+functions[_usb_human_size]} )); then
      _usb_human_size $(( image_size / (_USB_RESULT_WRITE_SECONDS > 0 ? _USB_RESULT_WRITE_SECONDS : 1) ))
      _USB_RESULT_RATE="$REPLY/s"
    fi
  else
    _usb_write_failure_model "$action_status" "$_USB_WRITE_STAGE" \
      "${_USB_WRITE_BYTES_OBSERVED:-0}" "$image_size" "$_USB_WRITE_ERROR"
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR=$reply[1] _USB_RESULT_VERIFY_REASON=$reply[2]
  fi
  if (( action_status == 0 )); then
    _usb_unmount "$identifier" >/dev/null 2>&1 || {
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR='The image was written, but macOS could not immediately unmount the target.'
    }
  fi
  if (( action_status == 0 )); then
    _usb_image_revalidate "$image" "$image_fingerprint" "$image_size" || {
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR='The selected image changed during writing; the USB must not be used.'
    }
  fi
  if (( action_status == 0 )) && [[ -n $expected_checksum ]]; then
    _usb_progress_stage "Rechecking image SHA-$checksum_algorithm" \
      info 'Confirming the complete source image remained unchanged through the write.' \
      warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
    _usb_image_checksum "$image" "$checksum_algorithm" || {
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR="The image could not be reread after writing; the USB must not be used."
    }
    if (( action_status == 0 )) && [[ $REPLY != "$expected_checksum" ]]; then
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR="The image SHA-$checksum_algorithm changed during writing; the USB must not be used."
    fi
  fi
  _usb_execution_finish "$identifier" $action_status $execution_started \
    'The image was written, but macOS could not eject the external drive.'
}

_usb_result_choose() {
  emulate -L zsh

  local -a _USB_PICKER_PASSIVE_LINES=() _USB_PICKER_PASSIVE_STYLES=()
  local -i index=0
  for (( index = 2; index <= ${#_USB_PICKER_LABELS}; ++index )); do
    _USB_PICKER_PASSIVE_LINES+=("${_USB_PICKER_LABELS[index]}")
    case ${_USB_PICKER_HIGHLIGHTS[index]-} in
      (*:picker-success) _USB_PICKER_PASSIVE_STYLES+=(picker-success) ;;
      (*:picker-error) _USB_PICKER_PASSIVE_STYLES+=(picker-error) ;;
      (*) _USB_PICKER_PASSIVE_STYLES+=(picker-text) ;;
    esac
  done
  _USB_PICKER_VALUES=("${_USB_PICKER_VALUES[1]}")
  _USB_PICKER_LABELS=("${_USB_PICKER_LABELS[1]}")
  _USB_PICKER_HIGHLIGHTS=("${_USB_PICKER_HIGHLIGHTS[1]-}")
  _USB_PICKER_SEARCH=("${_USB_PICKER_SEARCH[1]-}")
  _USB_PICKER_DETAILS=("${_USB_PICKER_DETAILS[1]-}")
  _usb_choose "$1" "$2" 'Done' 0 0 1
}

# Pure presentation from supplied result facts. Output is title/subtitle followed
# by five-field rows: exact value, label, semantic role, search text, details.
_usb_result_model() {
  emulate -L zsh
  local kind=$1 result_status=$2
  shift 2
  local -A facts=("$@")
  local REPLY='' duration='' size='' label='' role='' detail='' eject_label='' eject_role=''
  local -i complete=0
  _usb_human_duration "${facts[seconds]:-0}"
  duration=$REPLY
  [[ $result_status == 0 && ${facts[outcome]} == complete ]] && complete=1
  if (( complete )) || [[ ${facts[ejected]} == 1 ]]; then
    eject_label='Safe to remove · external drive ejected' eject_role=picker-success
  else
    eject_label='Check the drive before removing it' eject_role=picker-error
  fi
  if (( !complete )) && [[ ${facts[started]} != 1 ]]; then
    eject_label='Nothing was written · drive remains mounted'
    [[ ${facts[ejected]} == 1 ]] || eject_role=''
  fi
  local trail=Media heading='External device / Flash · Couldn’t complete' outcome=FAILED
  [[ $kind == raw ]] && trail=Image
  if (( complete )); then heading='External device / Flash · Complete'; outcome=DONE; fi
  reply=("$heading" "$trail  ›  Drive  ›  $outcome")
  role=''
  (( complete )) && role=picker-success
  reply+=(done Done "$role" done '')
  if (( complete )); then
    case $kind in
      raw)
        _usb_human_size "${facts[bytes]:-0}"; size=$REPLY
        reply+=(bytes "Flash complete · $size written" picker-success complete '') ;;
      macos-installer)
        reply+=(complete 'macOS installer complete · Apple createinstallmedia succeeded' picker-success complete
          'Apple createinstallmedia completed successfully and reported the bootable installer as available.') ;;
      *) return 2 ;;
    esac
    label="Time · $duration"
    [[ $kind == macos-installer ]] || label+=" · ${facts[rate]:-rate unavailable}"
    reply+=(time "$label" '' time '')
  else
    label='Flash failed' detail=''
    case $kind in
      macos-installer) label='macOS installer failed'; detail=${facts[error]:-No additional diagnostic was retained.} ;;
      raw) ;;
      *) return 2 ;;
    esac
    reply+=(error "$label · ${facts[error]:-The operation did not complete.}" picker-error failed "$detail")
  fi
  if [[ $kind == macos-installer ]]; then
    role=picker-error
    if (( complete )); then
      label='Source validation · Verified · Apple-signed full installer' role=picker-success
      detail='The installer application and its createinstallmedia executable passed Apple signature validation before the target was erased.'
    elif [[ ${facts[source_validated]} == 1 ]]; then
      label='Source validation · Verified before preparation · Apple-signed installer' role=picker-success detail=''
    else
      label='Source validation · FAILED · installer was not accepted' detail=''
    fi
    local search=source
    (( complete )) && search=apple
    reply+=(source "$label" "$role" "$search" "$detail")
  else
    role=picker-error
    if [[ ${facts[checksum_validated]} == 1 ]]; then
      label="Image integrity · Verified · SHA-${facts[checksum_algorithm]} matched" role=picker-success
    elif [[ -n ${facts[expected_checksum]} ]] && (( !complete )); then
      label="Image integrity · FAILED · SHA-${facts[checksum_algorithm]} did not match"
    else
      label='Image integrity · Not verified · no checksum provided'
    fi
    local value=image-integrity search=''
    (( complete )) && value=image-checksum
    if [[ ${facts[checksum_validated]} == 1 ]]; then
      search='image integrity checksum verified matched'
      detail="Provided checksum matched before writing"$'\n\n'"Expected"$'\n'"${facts[expected_checksum]}"$'\n\n'"Actual"$'\n'"${facts[image_checksum]}"
      if (( complete )); then
        search='image integrity checksum matched'
        detail="Provided checksum matched"$'\n\n'"SHA-${facts[checksum_algorithm]}"$'\n'"${facts[image_checksum]}"
      fi
    elif [[ -n ${facts[expected_checksum]} ]] && (( !complete )); then
      search='image integrity checksum failed expected actual'
      detail="Expected"$'\n'"${facts[expected_checksum]}"$'\n\n'"Actual"$'\n'"${facts[image_checksum]:-unavailable}"
    else
      search='image integrity not verified no checksum'
      detail='The selected local image had no provided checksum. Finished-drive comparison can validate the copy, but cannot establish the image’s origin.'
      (( complete )) && detail='No checksum was provided. USB verification establishes fidelity to this local image, but does not establish the local image’s origin.'
    fi
    reply+=("$value" "$label" "$role" "$search" "$detail")
    if (( complete )); then
      role=picker-success detail=''
      if [[ ${facts[verified]} != 1 ]]; then
        label='USB verification · Not performed · Flash only' role=''
      else
        case ${facts[verify_scope]} in
          full) label='USB verification · Full image byte-for-byte matched' ;;
          *) label='USB verification · Selected image bytes matched' ;;
        esac
      fi
      reply+=(verify "$label" "$role" verified "$detail")
    elif [[ $kind == raw && -n ${facts[verify_reason]} ]]; then
      case ${facts[verify_reason]} in
        mismatch) label='USB verification · FAILED · installer or boot bytes differ' ;;
        stale-tail-gpt) label='USB verification · FAILED · old GPT metadata remains at physical tail' ;;
        drive-read-failed) label='USB verification · Could not read the finished drive' ;;
        image-read-failed) label='USB verification · Could not reread the selected image' ;;
        *) label='USB verification · Could not complete' ;;
      esac
      reply+=(verification-error "$label" picker-error 'usb verification read error recovery'
        "Verification reason"$'\n'"${facts[verify_reason]}"$'\n\n'"${facts[error]:-No additional diagnostic was retained.}")
    fi
  fi
  local search=recovery
  (( complete )) && search=safe
  reply+=(eject "$eject_label" "$eject_role" "$search" '')
  return 0
}

# Capture the existing invocation state once, then adapt pure rows to the UI.
_usb_result_present() {
  emulate -L zsh
  local -a reply=() _USB_PICKER_VALUES=() _USB_PICKER_LABELS=()
  local -a _USB_PICKER_HIGHLIGHTS=() _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
  if (( ! ${+functions[_usb_human_size]} || ! ${+functions[_usb_human_duration]} )); then
    print -r -- "External device / Flash · ${(V)_USB_RESULT_OUTCOME}"
    print -r -- "${(V)_USB_RESULT_ERROR}"
    print -r -- "External drive ejected: ${_USB_RESULT_EJECTED:-0}"
    return 0
  fi
  _usb_result_model "$1" "${2:-1}" \
    bytes "${_USB_RESULT_BYTES:-0}" seconds "${_USB_RESULT_SECONDS:-0}" rate "${_USB_RESULT_RATE:-}" \
    outcome "${_USB_RESULT_OUTCOME:-}" error "${_USB_RESULT_ERROR:-}" \
    started "${_USB_RESULT_STARTED:-0}" ejected "${_USB_RESULT_EJECTED:-0}" \
    verified "${_USB_RESULT_VERIFIED:-0}" verify_scope "${_USB_RESULT_VERIFY_SCOPE:-}" \
    verify_reason "${_USB_RESULT_VERIFY_REASON:-}" source_validated "${_USB_RESULT_SOURCE_VALIDATED:-0}" \
    checksum_validated "${_USB_RESULT_CHECKSUM_VALIDATED:-0}" checksum_algorithm "${_USB_RESULT_CHECKSUM_ALGORITHM:-}" \
    expected_checksum "${_USB_RESULT_EXPECTED_CHECKSUM:-}" image_checksum "${_USB_RESULT_IMAGE_CHECKSUM:-}" || return
  local title=$reply[1] subtitle=$reply[2]
  _usb_picker_rows_add "${reply[@]:2}"
  _usb_result_choose "$title" "$subtitle"
}

_usb_media_result_screen() {
  case $1 in
    (macos-installer) _usb_result_present "$1" "$2" ;;
    (*) _usb_result_present raw "$2" ;;
  esac
}

_usb_progress_controller() {
  emulate -L zsh
  local -i execution_status=0
  _usb_media_execute "${_USB_SELECTED_MEDIA_KIND:-raw-image}" \
    "$_USB_SELECTED_IMAGE" "$_USB_SELECTED_DISK" \
    "$_USB_SELECTED_DISK_FINGERPRINT" "$_USB_SELECTED_IMAGE_FINGERPRINT" \
    "$_USB_SELECTED_IMAGE_SIZE" "$_USB_REQUEST" "$_USB_SELECTED_SOURCE_DISK" 1 \
    "$_USB_SELECTED_CHECKSUM_ALGORITHM" "$_USB_SELECTED_CHECKSUM" \
    "$_USB_SELECTED_DISK_SIZE"
  execution_status=$?
  _usb_media_result_screen "${_USB_SELECTED_MEDIA_KIND:-raw-image}" $execution_status
  return $execution_status
}

_usb_confirmation_prompt() {
  emulate -L zsh
  local expected=$1 color='' style='' reset=$'\e[0m'
  REPLY="Type exactly $expected to continue: "
  [[ -t 0 && -t 2 && -n $TERM && $TERM != dumb && -z ${NO_COLOR:-} ]] || return 0
  zmodload -F zsh/terminfo p:terminfo 2>/dev/null || return 0
  (( ${terminfo[colors]:-0} >= 256 )) || return 0
  (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color output warning || {
    REPLY="Type exactly $expected to continue: "
    return 0
  }
  color=$REPLY
  style=$'\e[1;38;5;'"${color}m"
  REPLY="Type exactly ${style}${expected}${reset} to continue: "
}

# Read only after the caller prints its exact operation preview. The default
# remains refusal; no normalization of the typed phrase is permitted.
_usb_confirm_exact() {
  emulate -L zsh
  local expected=$1 answer=''
  _usb_confirmation_prompt "$expected"
  IFS= read -r "answer?$REPLY" || {
    _USB_CONFIRM_ERROR='Confirmation was not completed.'
    return 1
  }
  [[ $answer == "$expected" ]] || {
    _USB_CONFIRM_ERROR="Confirmation did not match. Expected exactly: $expected"
    return 1
  }
}

_usb_format_confirm() {
  emulate -L zsh
  local identifier=$1 disk_label=$2 format_label=$3 volume_name=$4
  local expected="ERASE $identifier"
  _USB_CONFIRM_ERROR=''
  print -r -- "Target: $disk_label"
  print -r -- "Format: $format_label"
  print -r -- "Volume name: $volume_name"
  print -r -- 'Action: Replace the whole disk with one volume using Apple diskutil.'
  print -r -- 'This can permanently destroy every existing partition and all data on the selected drive.'
  _usb_confirm_exact "$expected"
}

_usb_format_color_style() {
  emulate -L zsh
  local role=$1 bold=${2:-0} color=''
  REPLY=''
  [[ -t 1 && -n $TERM && $TERM != dumb && -z ${NO_COLOR:-} ]] || return 0
  zmodload -F zsh/terminfo p:terminfo 2>/dev/null || return 0
  (( ${terminfo[colors]:-0} >= 256 )) || return 0
  (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color output "$role" || return 0
  color=$REPLY
  if (( bold )); then
    REPLY=$'\e[1;38;5;'"${color}m"
  else
    REPLY=$'\e[38;5;'"${color}m"
  fi
}

_usb_format_output_filter() {
  emulate -L zsh
  local line='' prefix='' remainder='' reset=$'\e[0m'
  local heading='' info='' accent='' success=''
  _usb_format_color_style heading 1
  heading=$REPLY
  _usb_format_color_style info
  info=$REPLY
  _usb_format_color_style accent
  accent=$REPLY
  _usb_format_color_style success 1
  success=$REPLY
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ -z $heading ]]; then
      print -r -- "$line"
      continue
    fi
    case $line in
      (Started\ erase\ on\ *)
        print -r -- "${heading}${line}${reset}" ;;
      (Finished\ erase\ on\ *)
        print -r -- "${success}${line}${reset}" ;;
      (Unmounting\ *|Creating\ *|Waiting\ *|Formatting\ *|Mounting\ *)
        print -r -- "${info}${line}${reset}" ;;
      (*:*)
        prefix=${line%%:*}
        remainder=${line#"$prefix"}
        print -r -- "${accent}${prefix}${reset}${info}${remainder}${reset}" ;;
      (*) print -r -- "$line" ;;
    esac
  done
}

_usb_format_erase_run() {
  emulate -L zsh
  setopt PIPE_FAIL
  _usb_format_color_style heading 1
  if [[ -z $REPLY ]]; then
    _usb_diskutil_erase_run "$@"
    return $?
  fi
  _usb_diskutil_erase_run "$@" | _usb_format_output_filter
  return $?
}

_usb_format_print_summary() {
  emulate -L zsh
  local identifier=$1 format_label=$2 volume_name=$3 reset=$'\e[0m'
  local success='' accent=''
  _usb_format_color_style success 1
  success=$REPLY
  _usb_format_color_style accent
  accent=$REPLY
  if [[ -z $success ]]; then
    print -r -- "Formatted /dev/$identifier as $format_label."
    print -r -- "Volume name: $volume_name"
    return
  fi
  print -r -- "${success}Formatted /dev/$identifier as $format_label.${reset}"
  print -r -- "${accent}Volume name:${reset} $volume_name"
}

_usb_format_execute() {
  emulate -L zsh
  local identifier=$1 expected_fingerprint=$2 personality=$3 volume_name=$4
  local captured_size=${5:-0}
  local -i erase_status=0
  _USB_FORMAT_ERROR=''
  [[ $identifier == disk<-> && -n $expected_fingerprint &&
     -n $personality && ${#personality} -le 128 &&
     $personality != *[[:cntrl:]]* &&
     $captured_size == <-> ]] || {
    _USB_FORMAT_ERROR='the captured format request is invalid; nothing was erased'
    return 2
  }
  _usb_volume_name_validate "$volume_name" "$personality" || {
    _USB_FORMAT_ERROR="$_USB_FORMAT_ERROR Nothing was erased."
    return 2
  }
  _usb_target_revalidate "$identifier" "$expected_fingerprint" 1 || {
    _USB_FORMAT_ERROR='the external drive changed or became ineligible before authorization; nothing was erased'
    return 1
  }
  _usb_authorize || {
    _USB_FORMAT_ERROR='administrator authorization failed; nothing was erased'
    return 1
  }
  _usb_target_revalidate "$identifier" "$expected_fingerprint" 1 || {
    _USB_FORMAT_ERROR='the external drive changed or became ineligible before formatting; nothing was erased'
    return 1
  }
  _usb_format_erase_run eraseDisk "$personality" "$volume_name" "/dev/$identifier" || {
    erase_status=$?
    _USB_FORMAT_ERROR="diskutil could not format /dev/$identifier as $personality; the prior layout may already be changed"
    return $erase_status
  }
}

_usb_confirm() {
  emulate -L zsh
  local image=$1 identifier=$2 disk_label=$3 request=$4
  local checksum_algorithm=${5:-} checksum=${6:-}
  local expected="ERASE $identifier"
  _USB_CONFIRM_ERROR=''
  if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} == macos-installer ]]; then
    print -r -- "Installer: $image"
  else
    print -r -- "Image:  $image"
  fi
  print -r -- "Target: $disk_label"
  if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} != macos-installer &&
        -n ${_USB_SELECTED_IMAGE_ARCHITECTURE:-} ]]; then
    _usb_image_architecture_short_label "$_USB_SELECTED_IMAGE_ARCHITECTURE"
    print -r -- "Image architecture: $REPLY"
  fi
  if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} == macos-installer ]]; then
    print -r -- 'Source validation: Apple-signed full macOS installer'
    print -r -- 'Action: Prepare the whole drive, run Apple createinstallmedia, and eject'
    print -r -- 'Apple createinstallmedia will erase and format the selected external drive.'
  elif [[ -n $checksum ]]; then
    print -r -- "Checksum: SHA-$checksum_algorithm · $checksum"
  else
    print -r -- 'Checksum: Not provided'
  fi
  if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} == macos-installer ]]; then
    :
  elif [[ $request == flash-verify && -n $checksum ]]; then
    print -r -- "Action: Validate image SHA-$checksum_algorithm, flash, verify payload SHA-$checksum_algorithm, and eject"
  elif [[ $request == flash-verify ]]; then
    print -r -- 'Action: Flash, verify payload, and eject'
  elif [[ -n $checksum ]]; then
    print -r -- "Action: Validate image SHA-$checksum_algorithm, flash without read-back verification, and eject"
  else
    print -r -- 'Action: Flash and eject without verification'
  fi
  print -r -- 'This can permanently destroy every existing partition and all data on the selected drive.'
  _usb_confirm_exact "$expected"
}

_usb_help_flash() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: external-device --flash [media]' \
    'Open a native workspace that creates bootable external installation media.' \
    '' \
    'Image capture:' \
    '  An explicit path selects one readable regular .iso or .img file, or a' \
    '  full Install macOS application containing Apple createinstallmedia.' \
    '  Quote paths with spaces; prefix a name beginning with -- using ./.' \
    '  With no path, Step 1 merges up to 500 Finder-indexed matches beneath ~' \
    '  with shallow current-folder and ~/Downloads captures of up to 200 each.' \
    '  The direct captures help include fresh files Spotlight has not indexed.' \
    '  Results are a bounded snapshot: Spotlight exclusions, indexing delay, or' \
    '  the limit can omit images. Discovery never follows symbolic links.' \
    '  Images are ordered by creation time, newest first, falling back to' \
    '  modification time when creation time is unavailable. Ordering never' \
    '  accepts an image automatically; every run requires explicit selection.' \
    '  Step 1 Ctrl-R replaces the snapshot with a fresh Spotlight capture under' \
    '  ~ plus fresh shallow current-folder and ~/Downloads reads. It retains the' \
    '  active filter and exact selected image while that image remains available.' \
    '  A completed download can therefore appear without restarting external-device --flash' \
    '  or waiting for Spotlight to index it.' \
    '  Step 1 keeps Custom path first and shows captured format, size, creation,' \
    '  modification, filename-derived architecture, and exact path details.' \
    '  Recognized AMD64/x86_64 and ARM64/aarch64 names receive equal passive' \
    '  architecture labels in image, review, confirmation, and progress context.' \
    '  No architecture adds an interruption. Unknown names remain explicitly' \
    '  undetected; the Mac writing the USB does not determine installer architecture.' \
    '  Custom path' \
    '  opens a bounded browser at ~/. Left moves to the parent; Right or Return' \
    '  opens a folder, and Return on a visible .iso or .img selects it.' \
    '  Typing refines the current folder with prefix, substring, then in-order' \
    '  fuzzy matching, consistent with Compozsh Tab path navigation.' \
    '  For Finder drag and drop, type external-device --flash followed by a space, drop the' \
    '  image into Terminal, and press Return. Custom path also offers a literal' \
    '  drop/paste field for files outside the visible folder.' \
    '  Dropped text is decoded as a path without evaluating shell commands.' \
    '  If macOS asks for Removable Volumes access, granting it keeps the screen' \
    '  context; Enter on Retry performs a fresh read-only source/target capture.' \
    '  Installed macOS installers in /Applications and ~/Applications are also' \
    '  captured. A macOS .dmg or .pkg must first install the full application.' \
    '  ISO selection first reads a bounded archive table without mounting it.' \
    '  Media the native archive reader cannot parse uses a read-only attach fallback;' \
    '  its device is detached before the workspace continues; if macOS refuses, it' \
    '  stays attached read-only and is retried before the next inspection and on' \
    '  exit. Recognized' \
    '  Windows Setup media opens a terminal Windows unsupported screen before' \
    '  target capture. It explains the portable FAT32 requirement, its 4 GiB' \
    '  single-file limit, and Microsoft’s DISM/install.swm resolution on Windows.' \
    '  Done ends the tool. Nothing was written or targeted; Windows media is never' \
    '  raw-flashed or routed through unverified exFAT or NTFS layouts.' \
    '  A clean read-only ISO fallback refusal stays eligible for raw/hybrid handling;' \
    '  partial attachment or cleanup fails closed.' \
    '' \
    'Target capture:' \
    '  diskutil supplies currently attached whole external physical disks.' \
    '  Native plist captures are limited to 1 MiB, 4,096 device entries, and' \
    '  64 whole external-disk candidates per refresh.' \
    '  The workspace excludes internal, virtual, read-only, partition-slice,' \
    '  and undersized targets. USB, Thunderbolt, and other external transports' \
    '  are eligible; protocol, media name, exact /dev/diskN, and size are shown.' \
    '  The whole disk holding the selected media is also excluded, so a write' \
    '  can never target its own source. For an APFS volume, that is the whole' \
    '  disk of every physical store behind its container. Media on a virtual' \
    '  disk (a mounted disk image, sparsebundle, or RAID set) is refused before' \
    '  target capture, because macOS does not report the drives behind it; copy' \
    '  it to a regular drive first.' \
    '  Step 2 Ctrl-R performs a fresh target capture without losing the selected' \
    '  image, including after a newly connected drive becomes available.' \
    '  A drive macOS ejected can remain physically plugged in while absent from' \
    '  diskutil. Ctrl-R cannot reactivate it: unplug and reconnect the drive, or' \
    '  power-cycle its hub, then press Ctrl-R or Enter to capture it again.' \
    '' \
    'Actions:' \
    '  Step 2 selects one exact eligible external drive. Step 3 reviews media,' \
    '  drive, optional checksum, and mode; Flash & verify is the default.' \
    '  Add image checksum accepts one SHA-256 or SHA-512 digest as bare hex,' \
    '  standard shasum output, or a BSD SHA line. Step 3 immediately hashes the' \
    '  complete image and shows Verified, mismatch, or read failure; a failed' \
    '  integrity check cannot start flashing. With no checksum, Step 3 says the' \
    '  image is not verified. Selecting another image clears' \
    '  the checksum so it cannot silently carry across image context.' \
    '  The complete integrity row uses the shared bold error red when unverified' \
    '  or failed, and the shared bold success green after a checksum matches.' \
    '  An exact typed' \
    '  ERASE diskN confirmation is required. A mismatch reports the exact' \
    '  expected phrase and writes nothing.' \
    '  Supported 256-color terminals highlight that phrase with the shared' \
    '  warning color; NO_COLOR and unsupported terminals keep it plain.' \
    '  Compozsh then requests sudo, revalidates the image and target identity,' \
    '  unmounts the whole disk, revalidates the target again, and' \
    '  writes through /dev/rdiskN with Apple’s dd using 512-byte input sectors' \
    '  aggregated into 4 MiB output blocks. One privileged raw-device session' \
    '  remains open through write, fsync, physical-tail cleanup, and verification.' \
    '  The captured sector count bounds the read. The target logical block size' \
    '  is validated before unmount; incompatible image alignment writes nothing.' \
    '  A logical-block-aligned range covering at least 33 final sectors outside' \
    '  the image extent is zeroed and read back so old whole-disk backup GPT data' \
    '  cannot conflict with the new raw-image layout. The final transferred-byte' \
    '  count must equal the captured size.' \
    '  Apple dd supplies exact bytes once per second for a determinate progress' \
    '  bar. Step 3 uses a dedicated status view with no query or bottom footer:' \
    '  the active stage, image, target, progress, and disconnect warning remain' \
    '  together near the top with semantic heading, success, and warning colors.' \
    '  Before that session closes, verification reopens the named raw device for' \
    '  uncached input and reports the current comparison pass, bytes read, total,' \
    '  percentage, and elapsed time; aligned 4 MiB reads prove every image byte;' \
    '  the cleared physical tail must independently read back zero.' \
    '  Progress is consumed incrementally during long operations. Validation,' \
    '  unmount, verification, and eject remain named stages.' \
    '  The raw handler does not pre-format the target.' \
    '  Full macOS installer applications use a separate handler. It validates' \
    '  the Apple code signature, revalidates the installer and target, prepares' \
    '  one Mac OS Extended volume on the selected whole disk, and invokes the' \
    '  installer’s createinstallmedia tool with live native progress. Apple’s' \
    '  tool performs the bootable-media creation; the result is then ejected.' \
    '  Windows Setup media is deliberately not a creation action. Stock macOS has' \
    '  no supported WIM splitter, while current Windows 11 media can exceed FAT32’s' \
    '  file limit. Microsoft requires DISM on Windows to create install.swm parts.' \
    '  The dispatcher therefore shows the reasons and exits before drive selection.' \
    '  For raw images, the source identity is checked again after writing; a' \
    '  provided full-image digest is also recalculated. The held raw session' \
    '  performs verification under the authorization retained for writing.' \
    '  Flash only skips the read-back comparison. Both actions eject afterward;' \
    '  an eject is also attempted after a write or verification failure.' \
    '  A final screen remains until Done and reports bytes, duration, average' \
    '  write rate, image-integrity status, USB verification scope,' \
    '  and whether the drive is safe to remove.' \
    '' \
    'Verification boundary:' \
    '  Uncached raw reads compare every image byte, including boot and filesystem' \
    '  metadata, before the held write session releases the raw device. No metadata' \
    '  byte is exempted. The physical-tail cleanup is independently read back.' \
    '  Device short reads, source-read errors, byte mismatches, tail mismatches,' \
    '  and incomplete success evidence remain distinct failures.' \
    '  macOS may update filesystem bookkeeping after verified evidence exists and' \
    '  the held session closes; the result describes the captured pre-mount proof.' \
    '' \
    'Requirements and recovery:' \
    '  Requires macOS, an interactive terminal, the shared support/ui and' \
    '  support/functions components, and Apple’s diskutil, plutil, hdiutil,' \
    '  codesign, tar, df, mktemp, rmdir, rm, sleep, cat, dd, cmp,' \
    '  head, shasum, stat, and sudo tools.' \
    '  Apple mdfind supplies the indexed home catalog; if it fails, the shallow' \
    '  current-folder and Downloads snapshot plus Custom path remain available.' \
    '  A failed or interrupted write can leave the target unusable until it is' \
    '  rewritten or reformatted. Compozsh cannot roll back overwritten bytes.' \
    '' \
    'Examples:' \
    '  external-device --flash                         Choose a captured image and target.' \
    '  external-device --flash ~/Downloads/Linux.iso  Select this exact raw image.' \
    '  external-device --flash ~/Downloads/Windows.iso  Explain why Windows media is unsupported.' \
    '  external-device --flash "/Applications/Install macOS Tahoe.app"  Use Apple’s handler.'
}

_usb_flash() {
  emulate -L zsh
  local explicit=${1:-} picker_status=0 capture_status=0 progress_status=0
  local _USB_REQUEST='' _USB_WORKSPACE_ERROR='' _USB_CONFIRM_ERROR=''
  local _USB_SELECTED_IMAGE='' _USB_SELECTED_DISK=''
  local _USB_SELECTED_MEDIA_KIND=raw-image
  local _USB_SELECTED_SOURCE_DISK=''
  local _USB_SELECTED_IMAGE_ARCHITECTURE=''
  local _USB_SELECTED_IMAGE_FINGERPRINT='' _USB_SELECTED_DISK_FINGERPRINT=''
  local _USB_SELECTED_DISK_LABEL=''
  local _USB_SELECTED_CHECKSUM='' _USB_SELECTED_CHECKSUM_ALGORITHM=''
  local _USB_RESULT_OUTCOME='' _USB_RESULT_ERROR='' _USB_RESULT_RATE=''
  local _USB_RESULT_CHECKSUM_ALGORITHM='' _USB_RESULT_EXPECTED_CHECKSUM=''
  local _USB_RESULT_IMAGE_CHECKSUM=''
  local -i _USB_RESULT_BYTES=0 _USB_RESULT_SECONDS=0
  local -i _USB_RESULT_WRITE_SECONDS=0 _USB_RESULT_VERIFY_SECONDS=0
  local -i _USB_RESULT_VERIFIED=0 _USB_RESULT_EJECTED=0 _USB_RESULT_STARTED=0
  local -i _USB_RESULT_CHECKSUM_VALIDATED=0
  local -i _USB_RESULT_SOURCE_VALIDATED=0
  local _USB_RESULT_VERIFY_REASON='' _USB_RESULT_VERIFY_SCOPE=''
  local _USB_SELECTED_IMAGE_INTEGRITY=not-provided
  local -i _USB_SELECTED_IMAGE_SIZE=0
  local -i _USB_SELECTED_DISK_SIZE=0
  # Disk, image and writer facts captured by this invocation end with it.
  local _USB_INFO_ID='' _USB_INFO_NAME='' _USB_INFO_PROTOCOL='' _USB_INFO_FINGERPRINT=''
  local -i _USB_INFO_SIZE=0 _USB_INFO_BLOCK_SIZE=512
  local -i _USB_INFO_EXTERNAL=0 _USB_INFO_WHOLE=0 _USB_INFO_PHYSICAL=0 _USB_INFO_WRITABLE=0
  local _USB_STAT_FINGERPRINT=''
  local -i _USB_STAT_SIZE=0 _USB_STAT_MODIFIED=0 _USB_STAT_CREATED=0
  local _USB_WRITE_ERROR='' _USB_WRITE_STAGE=''
  local _USB_WRITE_PROGRESS_STAGE='' _USB_WRITE_PROGRESS_REMAINDER=''
  local -i _USB_WRITE_BYTES_OBSERVED=0 _USB_WRITE_VERIFY_BYTES_OBSERVED=0
  local -i _USB_WRITE_VERIFY_SECONDS=0 _USB_WRITE_VERIFIED=0
  local -i _USB_WRITE_TAIL_VERIFIED=0 _USB_WRITE_PROGRESS_OFFSET=0
  local _USB_PROGRESS_BAR=''
  local -a _USB_IMAGE_PATHS=() _USB_IMAGE_LABELS=() _USB_IMAGE_DETAILS=()
  local -a _USB_IMAGE_HIGHLIGHTS=() _USB_IMAGE_SIZES=() _USB_IMAGE_FINGERPRINTS=()
  local -a _USB_IMAGE_CREATED=() _USB_IMAGE_MODIFIED=() _USB_IMAGE_KINDS=()
  local -a _USB_DISK_IDS=() _USB_DISK_LABELS=() _USB_DISK_DETAILS=()
  local -a _USB_DISK_SIZES=() _USB_DISK_FINGERPRINTS=()
  local _USB_CAPTURE_ERROR='' _USB_CAPTURE_ERROR_KIND='' _USB_PLIST=''
  local _USB_IMAGE_CAPTURE_SCOPE='' _USB_IMAGE_DEVICE='' _USB_IMAGE_SOURCE_DISK=''
  local -i _USB_IMAGE_CAPTURE_PARTIAL=0
  local _USB_MEDIA_ERROR='' _USB_INSPECT_DEVICE='' _USB_INSPECT_MOUNT=''
  local _USB_CREATEINSTALLMEDIA_ERROR=''
  # Helper results and the picker's selection and bookmark (filter text
  # included) are invocation memory too.
  local REPLY='' _ZLE_PICKER_SELECTED_VALUE=''
  local -a reply=() _ZLE_PICKER_BOOKMARK=()
  local -i _ZLE_PICKER_BOOKMARK_FOCUS=0

  {
    [[ $OSTYPE == darwin* ]] || {
      print -u2 -r -- 'external-device --flash: this workspace requires macOS'
      return 1
    }
    [[ -x /usr/sbin/diskutil && -x /usr/bin/plutil && -x /bin/df &&
       -x /usr/bin/mktemp && -x /bin/rm && -x /bin/sleep && -x /bin/dd &&
       -x /bin/cat && -x /usr/bin/cmp && -x /usr/bin/head &&
       -x /usr/bin/shasum && -x /usr/bin/stat && -x /usr/bin/sudo &&
       -x /usr/bin/hdiutil && -x /usr/bin/codesign && -x /bin/rmdir ]] || {
      print -u2 -r -- 'external-device --flash: required Apple command-line tools are unavailable'
      return 1
    }
    if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]] ||
        (( ! ${+functions[_zle_picker_run]} || ! ${+functions[_matching_compile]} )); then
      print -u2 -r -- 'external-device --flash: an interactive terminal and the shared support/ui and support/functions components are required'
      return 1
    fi
    _usb_images_capture "$explicit"
    capture_status=$?
    (( capture_status == 0 )) || {
      print -u2 -r -- "external-device --flash: ${_USB_CAPTURE_ERROR:-cannot capture the image}"
      return $capture_status
    }
    _zle_picker_run 20 '' 1 0 _usb_workspace_controller
    picker_status=$?
    (( picker_status == 1 )) && return 0
    if (( picker_status != 0 )); then
      [[ -n $_USB_WORKSPACE_ERROR ]] && print -u2 -r -- "external-device --flash: $_USB_WORKSPACE_ERROR"
      return $picker_status
    fi
    _usb_confirm "$_USB_SELECTED_IMAGE" "$_USB_SELECTED_DISK" \
      "$_USB_SELECTED_DISK_LABEL" "$_USB_REQUEST" \
      "$_USB_SELECTED_CHECKSUM_ALGORITHM" "$_USB_SELECTED_CHECKSUM" || {
      [[ -n $_USB_CONFIRM_ERROR ]] && print -r -- "$_USB_CONFIRM_ERROR"
      print -r -- 'Cancelled; nothing was written.'
      return 0
    }
    _usb_authorize || {
      print -u2 -r -- 'external-device --flash: administrator authorization failed; nothing was written'
      return 1
    }
    _zle_picker_run 20 '' 1 0 _usb_progress_controller
    progress_status=$?
    return $progress_status
  } always {
    _usb_cleanup_eject
    _usb_inspect_cleanup "$_USB_INSPECT_DEVICE" "$_USB_INSPECT_MOUNT" \
      >/dev/null 2>&1
  }
}

_usb_help_format() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: external-device --format' \
    'Format one whole external physical disk with Apple diskutil.' \
    '' \
    'Drive capture:' \
    '  Step 1 captures currently attached whole external physical disks through' \
    '  diskutil. Internal, virtual, read-only, and partition-slice devices are' \
    '  excluded. Rows show the media name, size, protocol, and exact /dev/diskN.' \
    '  The native plist capture is bounded to 1 MiB, 4,096 device entries, and' \
    '  64 whole external-disk candidates. The result is a temporary snapshot.' \
    '  Ctrl-R replaces it with a fresh capture while retaining the workspace.' \
    '  If an ejected drive is absent from diskutil, reconnect it or power-cycle' \
    '  its hub before retrying; refresh cannot reactivate an offline device.' \
    '' \
    'Format capture:' \
    '  After drive selection, Step 2 calls diskutil listFilesystems -plist and' \
    '  shows every filesystem personality advertised by this Mac, including' \
    '  installed filesystem bundles and special personalities such as Free Space.' \
    '  Each choice shows its exact diskutil personality and reported size bounds.' \
    '  A choice outside those bounds remains visible but cannot start an erase.' \
    '  The selected personality is passed unchanged to diskutil eraseDisk.' \
    '' \
    'Volume name:' \
    '  Step 3 offers Use default name to continue with External, or Give the' \
    '  volume a custom name. Custom text is passed as one literal argument after' \
    '  validation. APFS and HFS names accept up to 255 printable characters' \
    '  without /, :, control characters, or leading/trailing spaces. Other' \
    '  formatted personalities use a conservative 11-character subset of' \
    '  letters, numbers, spaces, underscores, and hyphens. Invalid input stays' \
    '  in the naming step and cannot reach confirmation.' \
    '  diskutil chooses its native partition scheme; personalities that do not' \
    '  create a volume may ignore the selected name.' \
    '' \
    'Native report:' \
    '  On supported 256-color terminals, the shared semantic palette styles' \
    '  diskutil headings, live stages, field labels, and successful completion.' \
    '  The text, ordering, diagnostics, and diskutil exit status remain unchanged.' \
    '  NO_COLOR, redirects, pipes, unsupported terminals, and unavailable palette' \
    '  roles retain diskutil’s exact plain output and the plain final summary.' \
    '' \
    'Safety and recovery:' \
    '  The action always targets the selected whole /dev/diskN. It requires the' \
    '  exact typed phrase ERASE diskN, then requests administrator authorization.' \
    '  The captured disk identity and external, physical, writable, whole-disk' \
    '  eligibility are checked before authorization and again immediately before' \
    '  eraseDisk. A changed, disconnected, reused, or ineligible target stops.' \
    '  Formatting permanently destroys all existing partitions and data on the' \
    '  selected disk. diskutil may already have changed the layout if formatting' \
    '  later fails; Compozsh cannot restore the previous partition map or files.' \
    '  Requires macOS, an interactive terminal, the shared support/ui and' \
    '  support/functions components, and Apple diskutil, plutil, mktemp, rm, and sudo.' \
    '' \
    'Examples:' \
    '  external-device --format  Choose an external drive and advertised format.'
}

_usb_format() {
  emulate -L zsh
  local picker_status=0 format_status=0
  local _USB_SELECTED_DISK='' _USB_SELECTED_DISK_LABEL=''
  local _USB_SELECTED_DISK_FINGERPRINT=''
  local _USB_SELECTED_FORMAT='' _USB_SELECTED_FORMAT_LABEL=''
  local _USB_SELECTED_VOLUME_NAME=External
  local _USB_FORMAT_ERROR='' _USB_CONFIRM_ERROR=''
  local -i _USB_SELECTED_DISK_SIZE=0
  # Disk and filesystem facts captured by this invocation end with it.
  local _USB_INFO_ID='' _USB_INFO_NAME='' _USB_INFO_PROTOCOL='' _USB_INFO_FINGERPRINT=''
  local -i _USB_INFO_SIZE=0 _USB_INFO_BLOCK_SIZE=512
  local -i _USB_INFO_EXTERNAL=0 _USB_INFO_WHOLE=0 _USB_INFO_PHYSICAL=0 _USB_INFO_WRITABLE=0
  local -a _USB_DISK_IDS=() _USB_DISK_LABELS=() _USB_DISK_DETAILS=()
  local -a _USB_DISK_SIZES=() _USB_DISK_FINGERPRINTS=()
  local -a _USB_FORMAT_PERSONALITIES=() _USB_FORMAT_LABELS=() _USB_FORMAT_DETAILS=()
  local -a _USB_FORMAT_MINIMUM_SIZES=() _USB_FORMAT_MAXIMUM_SIZES=()
  local _USB_CAPTURE_ERROR='' _USB_CAPTURE_ERROR_KIND='' _USB_PLIST=''
  # Helper results and the picker's selection and bookmark (filter text
  # included) are invocation memory too.
  local REPLY='' _ZLE_PICKER_SELECTED_VALUE=''
  local -a reply=() _ZLE_PICKER_BOOKMARK=()
  local -i _ZLE_PICKER_BOOKMARK_FOCUS=0

  [[ $OSTYPE == darwin* ]] || {
    print -u2 -r -- 'external-device --format: this tool requires macOS'
    return 1
  }
  [[ -x /usr/sbin/diskutil && -x /usr/bin/plutil &&
     -x /usr/bin/mktemp && -x /bin/rm && -x /usr/bin/sudo ]] || {
    print -u2 -r -- 'external-device --format: required Apple command-line tools are unavailable'
    return 1
  }
  if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]] ||
      (( ! ${+functions[_zle_picker_run]} || ! ${+functions[_matching_compile]} )); then
    print -u2 -r -- 'external-device --format: an interactive terminal and the shared support/ui and support/functions components are required'
    return 1
  fi
  _zle_picker_run 20 '' 1 0 _usb_format_workspace_controller
  picker_status=$?
  (( picker_status == 1 )) && return 0
  if (( picker_status != 0 )); then
    print -u2 -r -- "external-device --format: ${_USB_FORMAT_ERROR:-the format workspace failed}"
    return $picker_status
  fi
  _usb_format_confirm "$_USB_SELECTED_DISK" "$_USB_SELECTED_DISK_LABEL" \
    "$_USB_SELECTED_FORMAT_LABEL" "$_USB_SELECTED_VOLUME_NAME" || {
    [[ -n $_USB_CONFIRM_ERROR ]] && print -r -- "$_USB_CONFIRM_ERROR"
    print -r -- 'Cancelled; nothing was erased.'
    return 0
  }
  _usb_format_execute "$_USB_SELECTED_DISK" "$_USB_SELECTED_DISK_FINGERPRINT" \
    "$_USB_SELECTED_FORMAT" "$_USB_SELECTED_VOLUME_NAME" \
    "$_USB_SELECTED_DISK_SIZE"
  format_status=$?
  if (( format_status != 0 )); then
    print -u2 -r -- "external-device --format: ${_USB_FORMAT_ERROR:-diskutil formatting failed}"
    return $format_status
  fi
  _usb_format_print_summary "$_USB_SELECTED_DISK" \
    "$_USB_SELECTED_FORMAT_LABEL" "$_USB_SELECTED_VOLUME_NAME"
}
