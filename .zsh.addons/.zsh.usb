# Native bootable external-media creation. This peer unit is loaded by the .zshrc
# bootstrap only while its name matches .zsh.<name> inside an add-on directory.

typeset -ga _USB_IMAGE_PATHS=() _USB_IMAGE_LABELS=() _USB_IMAGE_DETAILS=()
typeset -ga _USB_IMAGE_HIGHLIGHTS=()
typeset -ga _USB_IMAGE_SIZES=() _USB_IMAGE_FINGERPRINTS=()
typeset -ga _USB_IMAGE_CREATED=() _USB_IMAGE_MODIFIED=()
typeset -ga _USB_IMAGE_KINDS=()
typeset -ga _USB_DISK_IDS=() _USB_DISK_LABELS=() _USB_DISK_DETAILS=()
typeset -ga _USB_DISK_SIZES=() _USB_DISK_FINGERPRINTS=()
typeset -g _USB_CAPTURE_ERROR='' _USB_PLIST=''
typeset -g _USB_MEDIA_ERROR='' _USB_INSPECT_DEVICE='' _USB_INSPECT_MOUNT=''
typeset -g _USB_CREATEINSTALLMEDIA_ERROR=''
typeset -g _USB_INFO_ID='' _USB_INFO_NAME='' _USB_INFO_PROTOCOL=''
typeset -g _USB_INFO_FINGERPRINT=''
typeset -g _USB_IMAGE_DEVICE='' _USB_IMAGE_SOURCE_DISK=''
typeset -g _USB_IMAGE_CAPTURE_SCOPE=''
typeset -g _USB_STAT_FINGERPRINT=''
typeset -g _USB_CONFIRM_ERROR=''
typeset -g _USB_RESULT_OUTCOME='' _USB_RESULT_ERROR='' _USB_RESULT_RATE=''
typeset -g _USB_WRITE_ERROR='' _USB_WRITE_STAGE=''
typeset -g _USB_RESULT_VERIFY_REASON='' _USB_RESULT_VERIFY_SCOPE=''
typeset -g _USB_PAYLOAD_VERIFY_ERROR=''
typeset -g _USB_PAYLOAD_VERIFY_SCOPE='' _USB_SELECTED_IMAGE_INTEGRITY='not-provided'
typeset -g _USB_VERIFY_PROGRESS_BAR=''
typeset -g _USB_RESULT_IMAGE_CHECKSUM='' _USB_RESULT_EXPECTED_CHECKSUM=''
typeset -g _USB_RESULT_CHECKSUM_ALGORITHM=''
typeset -gi _USB_RESULT_BYTES=0 _USB_RESULT_SECONDS=0
typeset -gi _USB_RESULT_WRITE_SECONDS=0 _USB_RESULT_VERIFY_SECONDS=0
typeset -gi _USB_RESULT_VERIFIED=0 _USB_RESULT_EJECTED=0 _USB_RESULT_STARTED=0
typeset -gi _USB_RESULT_SOURCE_VALIDATED=0
typeset -gi _USB_WRITE_BYTES_OBSERVED=0
typeset -gi _USB_SELECTED_DISK_SIZE=0
typeset -gi _USB_INFO_SIZE=0 _USB_INFO_EXTERNAL=0 _USB_INFO_WHOLE=0
typeset -gi _USB_INFO_PHYSICAL=0 _USB_INFO_WRITABLE=0
typeset -gi _USB_PLIST_MAX_BYTES=1048576
typeset -gi _USB_IMAGE_MAX_PER_FOLDER=200
typeset -gi _USB_IMAGE_MAX_INDEXED=500 _USB_IMAGE_CAPTURE_PARTIAL=0
typeset -gi _USB_MACOS_TARGET_MINIMUM=15000000000
typeset -gi _USB_STAT_SIZE=0 _USB_STAT_MODIFIED=0 _USB_STAT_CREATED=0
typeset -gi _USB_GPT_ENTRY_OFFSET=0 _USB_GPT_ENTRY_BYTES=0
typeset -gi _USB_GPT_STABLE_START=0 _USB_GPT_STABLE_END=0
typeset -gi _USB_GPT_HEADER_SIZE=0 _USB_GPT_FIRST_USABLE=0 _USB_GPT_LAST_USABLE=0
typeset -gi _USB_GPT_ENTRY_LBA=0 _USB_GPT_ENTRY_COUNT=0 _USB_GPT_ENTRY_SIZE=0
typeset -gi _USB_GPT_ENTRY_CRC=0
typeset -g _USB_GPT_DISK_GUID=''

_usb_human_size() {
  emulate -L zsh
  local raw=${1:-0}
  local -F value=0.0
  [[ $raw == <-> ]] || raw=0
  if (( raw >= 1073741824 )); then
    value=$(( raw / 1073741824.0 ))
    printf -v REPLY '%.1f GiB' $value
  elif (( raw >= 1048576 )); then
    value=$(( raw / 1048576.0 ))
    printf -v REPLY '%.1f MiB' $value
  elif (( raw >= 1024 )); then
    value=$(( raw / 1024.0 ))
    printf -v REPLY '%.1f KiB' $value
  else
    REPLY="$raw bytes"
  fi
}

_usb_image_extension_supported() {
  case ${1:e:l} in
    (iso|img) return 0 ;;
    (*) return 1 ;;
  esac
}

_usb_macos_installer_tool() {
  emulate -L zsh
  local installer=${1:A} tool=''
  REPLY=''
  [[ -d $installer && ! -L $installer ]] || return 1
  case ${installer:t} in
    (Install\ macOS\ *.app|Install\ OS\ X\ *.app) ;;
    (*) return 1 ;;
  esac
  tool="$installer/Contents/Resources/createinstallmedia"
  [[ -f $tool && ! -L $tool && -x $tool ]] || return 1
  REPLY=$tool
}

_usb_macos_installer_fingerprint() {
  emulate -L zsh
  local installer=${1:A} tool='' root_stat='' tool_stat=''
  _usb_macos_installer_tool "$installer" || return 1
  tool=$REPLY
  root_stat=$(command /usr/bin/stat -f '%d:%i:%m:%B' "$installer" 2>/dev/null) || return 1
  tool_stat=$(command /usr/bin/stat -f '%d:%i:%z:%m:%B' "$tool" 2>/dev/null) || return 1
  REPLY="$root_stat|$tool_stat"
}

_usb_codesign_is_apple() {
  emulate -L zsh
  local path=$1 requirement='' normalized='' verification='' line=''
  local -i verify_status=0
  verification=$(command /usr/bin/codesign --verify --strict "$path" 2>&1)
  verify_status=$?
  (( ${#verification} <= 8192 )) || return 1
  if (( verify_status != 0 )); then
    [[ $verification == *CSSMERR_TP_NOT_TRUSTED* ]] || return 1
    for line in "${(f)verification}"; do
      case $line in
        (*': CSSMERR_TP_NOT_TRUSTED'|'In architecture: '*) ;;
        (*) return 1 ;;
      esac
    done
  fi
  requirement=$(command /usr/bin/codesign -d -r- "$path" 2>&1) || return 1
  (( ${#requirement} <= 8192 )) || return 1
  normalized=${requirement//$'\n'/}
  [[ $normalized != *[[:cntrl:]]* ]] || return 1
  [[ $requirement == *'anchor apple'* ]]
}

_usb_macos_codesign_verify() {
  emulate -L zsh
  local installer=$1 tool=''
  _usb_macos_installer_tool "$installer" || return 1
  tool=$REPLY
  _usb_codesign_is_apple "$installer" || return 1
  _usb_codesign_is_apple "$tool"
}

_usb_macos_installer_revalidate() {
  emulate -L zsh
  local installer=$1 expected=$2
  _usb_macos_installer_fingerprint "$installer" || return 1
  [[ $REPLY == "$expected" ]] || return 1
  _usb_macos_codesign_verify "$installer"
}

_usb_hdiutil_attach_readonly() {
  emulate -L zsh
  local image=$1 mount_point=$2 output='' line='' device=''
  local -i attach_status=0
  _USB_INSPECT_DEVICE='' _USB_INSPECT_MOUNT=''
  output=$(command /usr/bin/hdiutil attach -readonly -nobrowse -noautoopen \
    -mountpoint "$mount_point" "$image" 2>/dev/null)
  attach_status=$?
  for line in "${(f)output}"; do
    device=${line%%[[:space:]]*}
    [[ $device == /dev/disk<-> ]] || continue
    _USB_INSPECT_DEVICE=${device#/dev/}
    break
  done
  (( attach_status == 0 )) || return 1
  [[ $_USB_INSPECT_DEVICE == disk<-> && -d $mount_point ]] || return 1
  _USB_INSPECT_MOUNT=$mount_point
}

_usb_hdiutil_detach() {
  command /usr/bin/hdiutil detach "/dev/$1"
}

# A Windows installer ISO is identified from its canonical setup payload, not
# from its filename. The temporary mount is read-only and always detached.
_usb_windows_installer_detect() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB
  local image=$1 temp_root=${TMPDIR:-/tmp} mount_point='' device=''
  local -a source_dirs=() boot_images=() install_images=()
  local -i detected=1 attach_status=0 cleanup_status=0
  [[ ${image:e:l} == iso ]] || return 1
  mount_point=$(command /usr/bin/mktemp -d \
    "${temp_root%/}/compozsh-usb-inspect.XXXXXX" 2>/dev/null) || return 2
  {
    _usb_hdiutil_attach_readonly "$image" "$mount_point"
    attach_status=$?
    device=$_USB_INSPECT_DEVICE
    if (( attach_status == 0 )); then
      source_dirs=("$mount_point"/(#i)sources(N/))
      if (( ${#source_dirs} == 1 )); then
        boot_images=("${source_dirs[1]}"/(#i)boot.wim(N.))
        install_images=("${source_dirs[1]}"/(#i)(install.wim|install.esd|install.swm)(N.))
      fi
      if (( ${#boot_images} == 1 && ${#install_images} >= 1 )); then
        detected=0
      fi
    fi
  } always {
    if [[ -n $device ]]; then
      _usb_hdiutil_detach "$device" >/dev/null 2>&1 || cleanup_status=1
    fi
    if [[ -d $mount_point && ! -L $mount_point &&
          ${mount_point:t} == compozsh-usb-inspect.* &&
          ${mount_point:h:A} == ${temp_root:A} ]]; then
      command /bin/rmdir "$mount_point" 2>/dev/null || cleanup_status=1
    fi
  }
  # Inspection is optional for an ISO that can still be written as a raw disk
  # image. A mount refusal therefore means "not identified as Windows". Once
  # hdiutil did attach a device, however, failed cleanup is a hard stop because
  # the probe no longer owns a known-clean temporary state.
  (( cleanup_status == 0 )) || return 2
  (( attach_status == 0 )) || return 1
  return $detected
}

_usb_media_kind_capture() {
  emulate -L zsh
  local path=${1:A} detect_status=0
  _USB_MEDIA_ERROR=''
  if _usb_macos_installer_tool "$path" >/dev/null; then
    REPLY=macos-installer
    return 0
  fi
  _usb_image_extension_supported "$path" || {
    _USB_MEDIA_ERROR='choose a readable .iso, .img, or full Install macOS application'
    return 2
  }
  if [[ ${path:e:l} == iso ]]; then
    _usb_windows_installer_detect "$path"
    detect_status=$?
    if (( detect_status == 0 )); then
      REPLY=windows-installer
      return 0
    elif (( detect_status == 2 )); then
      _USB_MEDIA_ERROR='macOS could not inspect this ISO safely; nothing can be written'
      return 1
    fi
  fi
  REPLY=raw-image
}

_usb_image_architecture_hint() {
  emulate -L zsh
  local name=${1:t:l}
  case $name in
    (*arm64*|*aarch64*) REPLY=arm64 ;;
    (*amd64*|*x86_64*|*x86-64*) REPLY=x86_64 ;;
    (proxmox-ve_*.iso) REPLY=x86_64 ;;
    (*) REPLY=unknown ;;
  esac
}

_usb_image_architecture_label() {
  case $1 in
    (arm64) REPLY='ARM64 · inferred from filename' ;;
    (x86_64) REPLY='Intel/AMD x86-64 · inferred from filename' ;;
    (*) REPLY='Not declared in filename' ;;
  esac
}

_usb_image_architecture_short_label() {
  case $1 in
    (arm64) REPLY='ARM64' ;;
    (x86_64) REPLY='x86-64' ;;
    (*) REPLY='Architecture not detected' ;;
  esac
}

_usb_image_stat_capture() {
  emulate -L zsh
  local path=$1 raw=''
  local -a fields=()
  _USB_STAT_FINGERPRINT=''
  _USB_STAT_SIZE=0 _USB_STAT_MODIFIED=0 _USB_STAT_CREATED=0
  [[ -f $path && ! -L $path && -r $path ]] || return 1
  raw=$(command /usr/bin/stat -f '%d:%i:%z:%m:%B' "$path" 2>/dev/null) || return
  fields=("${(@s/:/)raw}")
  (( ${#fields} == 5 )) || return 1
  [[ ${fields[3]} == <-> && ${fields[4]} == <-> && ${fields[5]} == <-> ]] || return 1
  _USB_STAT_SIZE=${fields[3]}
  _USB_STAT_MODIFIED=${fields[4]}
  _USB_STAT_CREATED=${fields[5]}
  _USB_STAT_FINGERPRINT=$raw
}

_usb_image_fingerprint() {
  emulate -L zsh
  _usb_image_stat_capture "$1" || return 1
  REPLY=$_USB_STAT_FINGERPRINT
}

_usb_format_epoch() {
  emulate -L zsh
  local epoch=${1:-0}
  REPLY='Unavailable'
  [[ $epoch == <-> ]] && (( epoch > 0 )) || return 0
  if zmodload -F zsh/datetime b:strftime 2>/dev/null &&
      strftime -s REPLY '%Y-%m-%d %H:%M %Z' "$epoch" 2>/dev/null; then
    return 0
  fi
  REPLY=$epoch
}

_usb_image_add() {
  emulate -L zsh
  local path=${1:a} fingerprint='' raw_size='' label='' size_label='' filename='' highlights=''
  local created_label='' modified_label='' format='' architecture='' architecture_label=''
  local architecture_short=''
  local -i architecture_start=0 architecture_end=0 size_start=0 size_end=0
  [[ ! -L $path ]] || return 1
  path=${path:A}
  [[ ${#path} -le 4096 && $path != *[[:cntrl:]]* ]] || return 1
  _usb_image_extension_supported "$path" || return 1
  (( _USB_IMAGE_PATHS[(Ie)$path] )) && return 0
  _usb_image_stat_capture "$path" || return 1
  fingerprint=$_USB_STAT_FINGERPRINT
  raw_size=$_USB_STAT_SIZE
  (( raw_size > 17408 )) || return 1
  _usb_human_size "$raw_size"
  size_label=$REPLY
  format="${path:e:u} raw disk image"
  _usb_format_epoch "$_USB_STAT_CREATED"
  created_label=$REPLY
  _usb_format_epoch "$_USB_STAT_MODIFIED"
  modified_label=$REPLY
  _usb_image_architecture_hint "$path"
  architecture=$REPLY
  _usb_image_architecture_label "$architecture"
  architecture_label=$REPLY
  _usb_image_architecture_short_label "$architecture"
  architecture_short=$REPLY
  filename=${path:t}
  if [[ $architecture == unknown ]]; then
    label="$filename · $size_label"
    size_start=$(( ${#filename} + 3 ))
  else
    label="$filename · $architecture_short · $size_label"
    architecture_start=$(( ${#filename} + 3 ))
    architecture_end=$(( architecture_start + ${#architecture_short} ))
    size_start=$(( architecture_end + 3 ))
    highlights="$architecture_start:$architecture_end:picker-architecture "
  fi
  size_end=$(( size_start + ${#size_label} ))
  highlights+="$size_start:$size_end:picker-size"
  _USB_IMAGE_PATHS+=("$path")
  _USB_IMAGE_LABELS+=("$label")
  _USB_IMAGE_HIGHLIGHTS+=("$highlights")
  _USB_IMAGE_DETAILS+=("${path:t}"$'\n\nPath\n  '"$path"$'\n\n'"Format · $format"$'\n'"Architecture · $architecture_label"$'\n'"Size · $size_label"$'\n'"Created · $created_label"$'\n'"Modified · $modified_label")
  _USB_IMAGE_SIZES+=("$raw_size")
  _USB_IMAGE_FINGERPRINTS+=("$fingerprint")
  _USB_IMAGE_CREATED+=("$_USB_STAT_CREATED")
  _USB_IMAGE_MODIFIED+=("$_USB_STAT_MODIFIED")
  _USB_IMAGE_KINDS+=(raw-image)
}

_usb_macos_installer_add() {
  emulate -L zsh
  local path=${1:A} fingerprint='' root_stat='' filename='' label=''
  local created_label='' modified_label=''
  local -a fields=()
  [[ ${#path} -le 4096 && $path != *[[:cntrl:]]* ]] || return 1
  (( _USB_IMAGE_PATHS[(Ie)$path] )) && return 0
  _usb_macos_installer_fingerprint "$path" || return 1
  fingerprint=$REPLY
  root_stat=$(command /usr/bin/stat -f '%d:%i:%m:%B' "$path" 2>/dev/null) || return 1
  fields=("${(@s/:/)root_stat}")
  (( ${#fields} == 4 )) || return 1
  [[ ${fields[3]} == <-> && ${fields[4]} == <-> ]] || return 1
  filename=${path:t}
  label="$filename · macOS installer · 16 GB-class target"
  _usb_format_epoch "${fields[4]}"
  created_label=$REPLY
  _usb_format_epoch "${fields[3]}"
  modified_label=$REPLY
  _USB_IMAGE_PATHS+=("$path")
  _USB_IMAGE_LABELS+=("$label")
  _USB_IMAGE_HIGHLIGHTS+=("$(( ${#filename} + 3 )):$(( ${#filename} + 18 )):picker-architecture")
  _USB_IMAGE_DETAILS+=("$filename"$'\n\nPath\n  '"$path"$'\n\n''Format · Full macOS installer application'$'\n''Handler · Apple createinstallmedia'$'\n''Target · 16 GB-class minimum; Apple reports if more is required'$'\n'"Created · $created_label"$'\n'"Modified · $modified_label")
  _USB_IMAGE_SIZES+=("$_USB_MACOS_TARGET_MINIMUM")
  _USB_IMAGE_FINGERPRINTS+=("$fingerprint")
  _USB_IMAGE_CREATED+=("${fields[4]}")
  _USB_IMAGE_MODIFIED+=("${fields[3]}")
  _USB_IMAGE_KINDS+=(macos-installer)
}

_usb_media_add() {
  emulate -L zsh
  local original=$1 path=''
  [[ ! -L $original ]] || return 1
  path=${original:A}
  if _usb_macos_installer_tool "$path" >/dev/null; then
    _usb_macos_installer_add "$path"
  else
    _usb_image_add "$path"
  fi
}

_usb_images_sort_newest() {
  emulate -L zsh
  local -i index=0 source_index=0 epoch=0
  local record='' key=''
  local -a records=() paths=() labels=() highlights=() details=() sizes=() fingerprints=()
  local -a created=() modified=() kinds=()
  for (( index = 1; index <= ${#_USB_IMAGE_PATHS}; ++index )); do
    epoch=${_USB_IMAGE_CREATED[index]:-${_USB_IMAGE_MODIFIED[index]:-0}}
    (( epoch > 0 )) || epoch=${_USB_IMAGE_MODIFIED[index]:-0}
    printf -v key '%020d:%010d' "$epoch" "$index"
    records+=("$key")
  done
  records=("${(@O)records}")
  for record in "${records[@]}"; do
    source_index=$(( 10#${record##*:} ))
    paths+=("${_USB_IMAGE_PATHS[source_index]}")
    labels+=("${_USB_IMAGE_LABELS[source_index]}")
    highlights+=("${_USB_IMAGE_HIGHLIGHTS[source_index]}")
    details+=("${_USB_IMAGE_DETAILS[source_index]}")
    sizes+=("${_USB_IMAGE_SIZES[source_index]}")
    fingerprints+=("${_USB_IMAGE_FINGERPRINTS[source_index]}")
    created+=("${_USB_IMAGE_CREATED[source_index]}")
    modified+=("${_USB_IMAGE_MODIFIED[source_index]}")
    kinds+=("${_USB_IMAGE_KINDS[source_index]}")
  done
  _USB_IMAGE_PATHS=("${paths[@]}") _USB_IMAGE_LABELS=("${labels[@]}")
  _USB_IMAGE_HIGHLIGHTS=("${highlights[@]}")
  _USB_IMAGE_DETAILS=("${details[@]}") _USB_IMAGE_SIZES=("${sizes[@]}")
  _USB_IMAGE_FINGERPRINTS=("${fingerprints[@]}")
  _USB_IMAGE_CREATED=("${created[@]}") _USB_IMAGE_MODIFIED=("${modified[@]}")
  _USB_IMAGE_KINDS=("${kinds[@]}")
}

_usb_spotlight_run() {
  command /usr/bin/mdfind "$@"
}

# Capture a bounded Spotlight snapshot beneath home. Finder indexing supplies
# descendant discovery without a synchronous recursive filesystem walk.
_usb_spotlight_images_capture() {
  emulate -L zsh
  local root=${HOME:A} path='' resolved='' completion=''
  local query='(kMDItemFSName == "*.iso"cd || kMDItemFSName == "*.img"cd)'
  local -i considered=0 source_status=2 stopped=0
  [[ -x /usr/bin/mdfind && -d $root ]] || return 2
  while IFS= read -r -d '' path; do
    if [[ -z $path ]]; then
      IFS= read -r -d '' completion
      [[ $completion == 0 ]] && source_status=0
      break
    fi
    (( ++considered > _USB_IMAGE_MAX_INDEXED )) && {
      _USB_IMAGE_CAPTURE_PARTIAL=1
      stopped=1
      break
    }
    [[ $path == /* && -f $path && ! -L $path ]] || continue
    resolved=${path:A}
    [[ $resolved == $root/* ]] || continue
    _usb_image_add "$resolved"
  done < <(_usb_spotlight_run -0 -onlyin "$root" "$query" 2>/dev/null
    print -rn -- $'\0'"$?"$'\0' 2>/dev/null)
  (( stopped || source_status == 0 )) || return 2
  return 0
}

# With no explicit input, merge a bounded Finder-index snapshot beneath home
# with shallow current-folder and Downloads reads for newly arrived images.
_usb_images_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB
  local explicit=${1:-} candidate=''
  local -a candidates=() installers=()
  _USB_CAPTURE_ERROR=''
  _USB_IMAGE_PATHS=() _USB_IMAGE_LABELS=() _USB_IMAGE_DETAILS=()
  _USB_IMAGE_HIGHLIGHTS=()
  _USB_IMAGE_SIZES=() _USB_IMAGE_FINGERPRINTS=()
  _USB_IMAGE_CREATED=() _USB_IMAGE_MODIFIED=()
  _USB_IMAGE_KINDS=()
  _USB_IMAGE_CAPTURE_SCOPE='' _USB_IMAGE_CAPTURE_PARTIAL=0

  if [[ -n $explicit ]]; then
    if [[ -d $explicit && ! -L $explicit ]]; then
      _usb_macos_installer_tool "$explicit" >/dev/null || {
        _USB_CAPTURE_ERROR='the application is not a complete Install macOS app with createinstallmedia'
        return 2
      }
    else
      _usb_image_extension_supported "$explicit" || {
        if [[ ${explicit:e:l} == dmg || ${explicit:e:l} == pkg ]]; then
          _USB_CAPTURE_ERROR='open the macOS .dmg or .pkg first so it installs the full Install macOS app, then select that app'
        else
          _USB_CAPTURE_ERROR='the media must be a regular .iso or .img file, or a full Install macOS application'
        fi
        return 2
      }
    fi
    _usb_media_add "$explicit" || _usb_media_add "$explicit" || {
      _USB_CAPTURE_ERROR='the selected media must be readable, complete, and must not be a symbolic link'
      return 1
    }
    _USB_IMAGE_CAPTURE_SCOPE='explicit media path'
    return 0
  fi

  candidates=(
    "$PWD"/*.(#i)(iso|img)(N.[1,$_USB_IMAGE_MAX_PER_FOLDER])
    "$HOME/Downloads"/*.(#i)(iso|img)(N.[1,$_USB_IMAGE_MAX_PER_FOLDER]))
  for candidate in "${candidates[@]}"; do
    [[ ! -L $candidate ]] || continue
    _usb_image_extension_supported "$candidate" || continue
    _usb_image_add "$candidate"
  done
  installers=(
    /Applications/Install\ (macOS|OS\ X)\ *.app(N/)
    "$HOME/Applications"/Install\ (macOS|OS\ X)\ *.app(N/))
  for candidate in "${installers[@]}"; do
    [[ ! -L $candidate ]] || continue
    _usb_macos_installer_add "$candidate"
  done
  if _usb_spotlight_images_capture; then
    _USB_IMAGE_CAPTURE_SCOPE='Spotlight index under ~ + current folder + ~/Downloads + installed macOS installers'
    (( _USB_IMAGE_CAPTURE_PARTIAL )) && _USB_IMAGE_CAPTURE_SCOPE+=' · partial snapshot'
  else
    _USB_IMAGE_CAPTURE_SCOPE='current folder + ~/Downloads + installed macOS installers · Spotlight index unavailable'
    _USB_IMAGE_CAPTURE_PARTIAL=1
  fi
  _usb_images_sort_newest
  return 0
}

# Terminal.app drags shell-quote paths containing spaces. Remove one quoting
# layer as data only; never evaluate substitutions, parameters, or commands.
_usb_image_from_query() {
  emulate -L zsh
  local query=$1 candidate='' decoded=''
  local -a candidates=()
  [[ -n $query && $query != *[[:cntrl:]]* ]] || return 2
  decoded=${(Q)query}
  [[ $decoded != *[[:cntrl:]]* ]] || return 2
  candidates=("$query")
  [[ $decoded == "$query" ]] || candidates+=("$decoded")
  for candidate in "${candidates[@]}"; do
    if [[ $candidate == '~/'* ]]; then
      candidate="$HOME/${candidate#\~/}"
    fi
    if _usb_media_add "$candidate"; then
      REPLY=${candidate:A}
      return 0
    fi
  done
  return 1
}

_usb_path_query_collect() {
  typeset -ga _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
}

_usb_read_image_path() {
  emulate -L zsh
  local subtitle=${1:-'Drop an .iso, .img, or full Install macOS app, then press Return'}
  local _ZLE_PICKER_TITLE='Flash USB / Add media' _ZLE_PICKER_SUBTITLE=$subtitle
  local _ZLE_PICKER_QUERY_LABEL='Media path' _ZLE_PICKER_INSPECT_TITLE=Details
  local _ZLE_PICKER_INSPECT_ACTION=add _ZLE_PICKER_CANCEL_LABEL=back
  local _ZLE_PICKER_BROWSE_LABEL='drop or paste one exact path · Return validates'
  local _ZLE_PICKER_COLLECTOR=_usb_path_query_collect _ZLE_PICKER_INSPECT_FALLBACK=''
  local -i _ZLE_PICKER_QUERY_SUBMIT=1 _ZLE_PICKER_WORKSPACE_ACTIONS=0
  local -i _ZLE_PICKER_DIRECTORY_ACTIONS=0 _ZLE_PICKER_HIERARCHY_ENABLED=0
  local -i _ZLE_PICKER_COPY_ENABLED=0 _ZLE_PICKER_DIGIT_SELECT=0
  local -A _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -a _ZLE_PICKER_TRAIL=() _ZLE_PICKER_EMPTY_LINES=(
    'Drag a regular .iso or .img file from Finder into this field.'
    'A pasted absolute, home-relative, or current-folder path also works.'
    'The path is treated only as data; no shell text is evaluated.'
    'Press Return to validate and add the exact image to this workspace.')
  _zle_picker_loop '' 1
}

_usb_checksum_parse() {
  emulate -L zsh
  local input=$1 scrubbed='' token='' digest=''
  local -a tokens=()
  local -i matches=0
  _USB_CHECKSUM_ALGORITHM=''
  (( ${#input} > 0 && ${#input} <= 4096 )) || return 1
  [[ $input != *$'\n'* && $input != *$'\r'* ]] || return 1
  scrubbed=${input//[^0-9A-Fa-f]/ }
  tokens=(${=scrubbed})
  for token in "${tokens[@]}"; do
    case ${#token} in
      (64|128)
        digest=${token:l}
        (( ++matches )) ;;
    esac
  done
  (( matches == 1 )) || return 1
  (( ${#digest} == 64 )) && _USB_CHECKSUM_ALGORITHM=256 || _USB_CHECKSUM_ALGORITHM=512
  REPLY=$digest
}

_usb_checksum_query_collect() {
  typeset -ga _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
}

_usb_read_checksum() {
  emulate -L zsh
  local subtitle=${1:-'Paste one SHA-256 or SHA-512 checksum, then press Return'}
  local initial=${2:-}
  local _ZLE_PICKER_TITLE='Flash USB / Image checksum' _ZLE_PICKER_SUBTITLE=$subtitle
  local _ZLE_PICKER_QUERY_LABEL='Checksum' _ZLE_PICKER_INSPECT_TITLE=Details
  local _ZLE_PICKER_INSPECT_ACTION=add _ZLE_PICKER_CANCEL_LABEL=back
  local _ZLE_PICKER_BROWSE_LABEL='optional integrity check · Return validates'
  local _ZLE_PICKER_COLLECTOR=_usb_checksum_query_collect _ZLE_PICKER_INSPECT_FALLBACK=''
  local -i _ZLE_PICKER_QUERY_SUBMIT=1 _ZLE_PICKER_WORKSPACE_ACTIONS=0
  local -i _ZLE_PICKER_DIRECTORY_ACTIONS=0 _ZLE_PICKER_HIERARCHY_ENABLED=0
  local -i _ZLE_PICKER_COPY_ENABLED=0 _ZLE_PICKER_DIGIT_SELECT=0
  local -A _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -a _ZLE_PICKER_TRAIL=() _ZLE_PICKER_EMPTY_LINES=(
    'Paste the checksum published for the selected image.'
    'Bare hexadecimal, shasum output, and BSD SHA lines are accepted.'
    'SHA-256 uses 64 hexadecimal characters; SHA-512 uses 128.'
    'The full image is checked before the external drive is changed.'
    'After writing, the same algorithm checks the immutable payload region.')
  _zle_picker_loop "$initial" 1
}

# Custom Path is a bounded file browser rather than a shell-like path parser.
# It starts at home, exposes the current path, and retains Finder-style
# hierarchy movement while showing folders, raw images, and full macOS installers.
_usb_browser_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB NULL_GLOB
  local location=${1:A} candidate='' raw_size='' filename='' size_label=''
  local -a directories=() images=() installers=()
  local -i inspected=0
  _USB_BROWSER_PARTIAL=0
  [[ -d $location && -r $location ]] || return 1
  _USB_PICKER_VALUES=(paste-path)
  _USB_PICKER_LABELS=('[ Paste or drop an exact media path… ]')
  _USB_PICKER_HIGHLIGHTS=('')
  _USB_PICKER_SEARCH=(paste drop drag finder exact path)
  _USB_PICKER_DETAILS=('')
  if (( ${_USB_BROWSER_SHOW_HIDDEN:-0} )); then
    directories=("$location"/*(ND/[1,501]))
    images=("$location"/*.(#i)(iso|img)(ND.[1,501]))
    installers=("$location"/Install\ (macOS|OS\ X)\ *.app(ND/[1,501]))
  else
    directories=("$location"/*(N/[1,501]))
    images=("$location"/*.(#i)(iso|img)(N.[1,501]))
    installers=("$location"/Install\ (macOS|OS\ X)\ *.app(N/[1,501]))
  fi
  (( ${#directories} + ${#images} + ${#installers} > 500 )) && _USB_BROWSER_PARTIAL=1
  for candidate in "${directories[@]}"; do
    (( ++inspected > 500 )) && break
    [[ ! -L $candidate ]] || continue
    _usb_macos_installer_tool "$candidate" >/dev/null && continue
    _USB_PICKER_VALUES+=("${candidate:A}/")
    _USB_PICKER_LABELS+=("${candidate:t}/")
    _USB_PICKER_HIGHLIGHTS+=('')
    _USB_PICKER_SEARCH+=("${candidate:t} folder")
    _USB_PICKER_DETAILS+=('')
  done
  for candidate in "${installers[@]}"; do
    (( ++inspected > 500 )) && break
    [[ ! -L $candidate ]] || continue
    _usb_macos_installer_tool "$candidate" >/dev/null || continue
    filename=${candidate:t}
    _USB_PICKER_VALUES+=("${candidate:A}")
    _USB_PICKER_LABELS+=("$filename · macOS installer")
    _USB_PICKER_HIGHLIGHTS+=("$(( ${#filename} + 3 )):$(( ${#filename} + 18 )):picker-architecture")
    _USB_PICKER_SEARCH+=("${candidate:t} macos installer createinstallmedia")
    _USB_PICKER_DETAILS+=('Apple createinstallmedia will erase the selected external disk and build the bootable installer.')
  done
  for candidate in "${images[@]}"; do
    (( ++inspected > 500 )) && break
    [[ ! -L $candidate ]] || continue
    raw_size=$(command /usr/bin/stat -f '%z' "$candidate" 2>/dev/null) || continue
    [[ $raw_size == <-> ]] || continue
    (( raw_size > 17408 )) || continue
    _usb_human_size "$raw_size"
    size_label=$REPLY
    filename=${candidate:t}
    _USB_PICKER_VALUES+=("${candidate:A}")
    _USB_PICKER_LABELS+=("$filename · $size_label")
    _USB_PICKER_HIGHLIGHTS+=("$(( ${#filename} + 3 )):$(( ${#filename} + 3 + ${#size_label} )):picker-size")
    _USB_PICKER_SEARCH+=("${candidate:t} image")
    _USB_PICKER_DETAILS+=('')
  done
}

_usb_browse_choose() {
  emulate -L zsh
  local _ZLE_PICKER_QUERY_LABEL='Filter this folder'
  local _ZLE_PICKER_INSPECT_ACTION=choose _ZLE_PICKER_CANCEL_LABEL=back
  local hidden_label='Hidden: off'
  (( ${_USB_BROWSER_SHOW_HIDDEN:-0} )) && hidden_label='Hidden: on'
  local _ZLE_PICKER_BROWSE_LABEL="$hidden_label · ← parent · → open folder · Return select"
  local _ZLE_PICKER_COLLECTOR=_usb_picker_collect
  local -i _ZLE_PICKER_WORKSPACE_ACTIONS=0 _ZLE_PICKER_COPY_ENABLED=0
  local -i _ZLE_PICKER_DIGIT_SELECT=0 _ZLE_PICKER_HIERARCHY_ENABLED=1
  local -i _ZLE_PICKER_DIRECTORY_ACTIONS=1
  local -A _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -A _ZLE_PICKER_LABEL_HIGHLIGHTS=()
  local -i index=0
  for (( index = 1; index <= ${#_USB_PICKER_VALUES}; ++index )); do
    [[ -n ${_USB_PICKER_HIGHLIGHTS[index]-} ]] &&
      _ZLE_PICKER_LABEL_HIGHLIGHTS[${_USB_PICKER_VALUES[index]}]=${_USB_PICKER_HIGHLIGHTS[index]}
  done
  _zle_picker_loop "${_USB_BROWSER_RESUME[1]-}" 20 \
    "${_USB_BROWSER_RESUME[2]:-1}" "${_USB_BROWSER_RESUME[3]:-0}"
}

_usb_browse_image_path() {
  emulate -L zsh
  local location=${HOME:A} selected='' display_path='' path_subtitle=''
  local _ZLE_PICKER_TITLE='Flash USB · Step 1 of 3'
  local _ZLE_PICKER_SUBTITLE=''
  local -i _USB_BROWSER_PARTIAL=0 _USB_BROWSER_SHOW_HIDDEN=0
  local -a _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_HIGHLIGHTS=()
  local -a _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
  local -a _USB_BROWSER_RESUME=('' 1 0) _USB_BROWSER_LOCATION_STACK=()
  local -a _USB_BROWSER_QUERY_STACK=() _USB_BROWSER_INDEX_STACK=() _USB_BROWSER_OFFSET_STACK=()
  local -a _ZLE_PICKER_TRAIL=() components=() bookmark=()
  local component='' indent=''
  local -i result=0
  while true; do
    _usb_browser_capture "$location" || return 1
    if [[ $location == ${HOME:A} ]]; then
      display_path='~/'
    elif [[ $location == ${HOME:A}/* ]]; then
      display_path="~/${location#${HOME:A}/}/"
    elif [[ $location == / ]]; then
      display_path='/'
    else
      display_path="$location/"
    fi
    (( _USB_BROWSER_PARTIAL )) && display_path+=' · first 500 items'
    _ZLE_PICKER_SUBTITLE=$display_path
    _ZLE_PICKER_TRAIL=(Location)
    components=("${(@s:/:)display_path%% · first 500 items}")
    indent=''
    for component in "${components[@]}"; do
      [[ -n $component ]] || continue
      _ZLE_PICKER_TRAIL+=("$indent$component")
      (( ${#indent} < 6 )) && indent+='  '
    done
    _usb_browse_choose
    result=$?
    (( result == 1 )) && return 1
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    bookmark=("${_ZLE_PICKER_BOOKMARK[@]}")
    if [[ $_ZLE_PICKER_ACTION == toggle-hidden ]]; then
      _USB_BROWSER_SHOW_HIDDEN=$(( !_USB_BROWSER_SHOW_HIDDEN ))
      _USB_BROWSER_RESUME=("${bookmark[1]-}" "${bookmark[2]:-1}" "${bookmark[3]:-0}")
      continue
    fi
    if [[ $_ZLE_PICKER_ACTION == parent ]]; then
      if (( ${#_USB_BROWSER_LOCATION_STACK} )); then
        location=${_USB_BROWSER_LOCATION_STACK[-1]}
        _USB_BROWSER_RESUME=(
          "${_USB_BROWSER_QUERY_STACK[-1]-}"
          "${_USB_BROWSER_INDEX_STACK[-1]:-1}"
          "${_USB_BROWSER_OFFSET_STACK[-1]:-0}")
        _USB_BROWSER_LOCATION_STACK[-1]=()
        _USB_BROWSER_QUERY_STACK[-1]=()
        _USB_BROWSER_INDEX_STACK[-1]=()
        _USB_BROWSER_OFFSET_STACK[-1]=()
      fi
      continue
    fi
    if [[ $selected == paste-path ]]; then
      path_subtitle='Drop an .iso, .img, or full Install macOS app, then press Return'
      while true; do
        _usb_read_image_path "$path_subtitle"
        result=$?
        (( result == 1 )) && break
        (( result == 0 )) || return $result
        if _usb_image_from_query "$_ZLE_PICKER_SELECTED_VALUE"; then
          return 0
        fi
        path_subtitle='That is not readable supported media; paste another image or full Install macOS app'
      done
      continue
    fi
    if [[ $selected == */ && -d ${selected%/} && ! -L ${selected%/} ]]; then
      _USB_BROWSER_LOCATION_STACK+=("$location")
      _USB_BROWSER_QUERY_STACK+=("${bookmark[1]-}")
      _USB_BROWSER_INDEX_STACK+=("${bookmark[2]:-1}")
      _USB_BROWSER_OFFSET_STACK+=("${bookmark[3]:-0}")
      location=${${selected%/}:A}
      _USB_BROWSER_RESUME=('' 1 0)
      continue
    fi
    [[ ( -f $selected || -d $selected ) && ! -L $selected ]] || continue
    REPLY=${selected:A}
    return 0
  done
}

_usb_image_filesystem_device_capture() {
  emulate -L zsh
  local path=$1 output='' line='' device=''
  _USB_IMAGE_DEVICE=''
  output=$(command /bin/df -P "$path" 2>/dev/null) || {
    _USB_CAPTURE_ERROR='macOS could not resolve the selected image filesystem'
    return 1
  }
  (( ${#output} <= 8192 )) || {
    _USB_CAPTURE_ERROR='image filesystem output exceeded the 8,192-character limit'
    return 1
  }
  line=${${(f)output}[-1]-}
  device=${line%%[[:space:]]*}
  [[ -n $device && $device != *[[:cntrl:]]* ]] || {
    _USB_CAPTURE_ERROR='macOS returned no usable filesystem device for the image'
    return 1
  }
  _USB_IMAGE_DEVICE=$device
}

# Resolve a local source volume through diskutil metadata instead of deriving a
# whole-disk identifier from a partition name. Network/FileProvider sources do
# not map to a local /dev/disk target and therefore need no exclusion.
_usb_image_source_disk_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local path=$1 device='' identifier='' plist='' parent=''
  _USB_IMAGE_SOURCE_DISK='' _USB_CAPTURE_ERROR=''
  _usb_image_filesystem_device_capture "$path" || return
  device=$_USB_IMAGE_DEVICE
  [[ $device == /dev/disk* ]] || return 0
  [[ $device == /dev/disk<->(s<->)# ]] || {
    _USB_CAPTURE_ERROR='the image filesystem reported an unsupported local device identifier'
    return 1
  }
  identifier=${device#/dev/}
  _usb_disk_info_read "$identifier" || return
  plist=$_USB_PLIST
  _usb_plist_optional "$plist" ParentWholeDisk
  parent=$REPLY
  if [[ -z $parent ]]; then
    _usb_plist_optional "$plist" DeviceIdentifier
    [[ $REPLY == disk<-> ]] && parent=$REPLY
  fi
  [[ $parent == disk<-> ]] || {
    _USB_CAPTURE_ERROR='diskutil could not resolve the image filesystem to a whole disk'
    return 1
  }
  _USB_IMAGE_SOURCE_DISK=$parent
}

_usb_plist_raw() {
  emulate -L zsh
  local plist=$1 key=$2
  REPLY=$(print -rn -- "$plist" |
    command /usr/bin/plutil -extract "$key" raw -o - -- - 2>/dev/null) || return
}

_usb_plist_optional() {
  emulate -L zsh
  local plist=$1 key=$2 fallback=${3:-}
  _usb_plist_raw "$plist" "$key" || REPLY=$fallback
}

_usb_diskutil_run() {
  emulate -L zsh
  command /usr/sbin/diskutil "$@"
}

_usb_diskutil_plist_capture() {
  emulate -L zsh
  local temp_root=${TMPDIR:-/tmp} capture_file='' raw_size=''
  local -i command_status=0
  _USB_PLIST='' _USB_CAPTURE_ERROR=''
  capture_file=$(command /usr/bin/mktemp "${temp_root%/}/compozsh-usb.XXXXXX" 2>/dev/null) || {
    _USB_CAPTURE_ERROR='cannot create a bounded diskutil capture file'
    return 1
  }
  {
    _usb_diskutil_run "$@" >| "$capture_file" 2>/dev/null
    command_status=$?
    if (( command_status == 0 )); then
      raw_size=$(command /usr/bin/stat -f '%z' "$capture_file" 2>/dev/null)
      [[ $raw_size == <-> ]] || raw_size=0
      if (( raw_size == 0 || raw_size > _USB_PLIST_MAX_BYTES )); then
        command_status=1
        _USB_CAPTURE_ERROR="diskutil output exceeded the ${_USB_PLIST_MAX_BYTES}-byte capture limit"
      else
        _USB_PLIST=$(<"$capture_file")
      fi
    fi
  } always {
    if [[ -n $capture_file && ${capture_file:t} == compozsh-usb.* &&
          ${capture_file:h:A} == ${temp_root:A} ]]; then
      command /bin/rm -f -- "$capture_file"
    fi
  }
  return $command_status
}

_usb_disk_list_read() {
  emulate -L zsh
  _usb_diskutil_plist_capture list -plist external physical || {
    [[ -n $_USB_CAPTURE_ERROR ]] ||
      _USB_CAPTURE_ERROR='diskutil could not capture external physical disks'
    return 1
  }
  [[ -n $_USB_PLIST ]] || {
    _USB_CAPTURE_ERROR='diskutil could not capture external physical disks'
    return 1
  }
}

_usb_disk_ids_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local count='' identifier=''
  local -i index=0
  _USB_DISK_IDS=()
  _usb_disk_list_read || return
  _usb_plist_raw "$_USB_PLIST" AllDisks || return 1
  count=$REPLY
  [[ $count == <-> ]] || return 1
  (( count <= 4096 )) || {
    _USB_CAPTURE_ERROR='diskutil reported too many device entries to inspect safely'
    return 1
  }
  for (( index = 0; index < count; ++index )); do
    _usb_plist_raw "$_USB_PLIST" "AllDisks.$index" || continue
    identifier=$REPLY
    [[ $identifier == disk<-> ]] || continue
    _USB_DISK_IDS+=("$identifier")
    (( ${#_USB_DISK_IDS} >= 64 )) && break
  done
  (( ${#_USB_DISK_IDS} )) || {
    _USB_CAPTURE_ERROR='no whole external physical disks are attached'
    return 1
  }
}

_usb_disk_info_read() {
  emulate -L zsh
  local identifier=$1
  _usb_diskutil_plist_capture info -plist "/dev/$identifier" || {
    [[ -n $_USB_CAPTURE_ERROR ]] ||
      _USB_CAPTURE_ERROR="diskutil could not inspect /dev/$identifier"
    return 1
  }
  [[ -n $_USB_PLIST ]] || {
    _USB_CAPTURE_ERROR="diskutil could not inspect /dev/$identifier"
    return 1
  }
}

_usb_disk_info_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local requested=$1 plist='' internal='' physical='' whole='' writable=''
  local device_tree=''
  _USB_INFO_ID='' _USB_INFO_NAME='' _USB_INFO_PROTOCOL=''
  _USB_INFO_FINGERPRINT=''
  _USB_INFO_SIZE=0 _USB_INFO_EXTERNAL=0 _USB_INFO_WHOLE=0
  _USB_INFO_PHYSICAL=0 _USB_INFO_WRITABLE=0
  [[ $requested == disk<-> ]] || return 2
  _usb_disk_info_read "$requested" || return
  plist=$_USB_PLIST

  _usb_plist_optional "$plist" DeviceIdentifier
  _USB_INFO_ID=$REPLY
  _usb_plist_optional "$plist" TotalSize 0
  _USB_INFO_SIZE=$REPLY
  _usb_plist_optional "$plist" MediaName
  _USB_INFO_NAME=$REPLY
  [[ -n $_USB_INFO_NAME ]] || {
    _usb_plist_optional "$plist" DeviceName 'Unnamed external disk'
    _USB_INFO_NAME=$REPLY
  }
  _usb_plist_optional "$plist" BusProtocol
  _USB_INFO_PROTOCOL=$REPLY
  [[ -n $_USB_INFO_PROTOCOL ]] || {
    _usb_plist_optional "$plist" DeviceProtocol External
    _USB_INFO_PROTOCOL=$REPLY
  }
  _usb_plist_optional "$plist" Internal unknown
  internal=$REPLY
  _usb_plist_optional "$plist" VirtualOrPhysical unknown
  physical=$REPLY
  _usb_plist_optional "$plist" Whole
  whole=$REPLY
  if [[ -z $whole ]]; then
    _usb_plist_optional "$plist" WholeDisk false
    whole=$REPLY
  fi
  _usb_plist_optional "$plist" WritableMedia false
  writable=$REPLY
  _usb_plist_optional "$plist" DeviceTreePath
  device_tree=$REPLY

  [[ $_USB_INFO_ID == "$requested" && $_USB_INFO_SIZE == <-> ]] || return 1
  [[ -n $_USB_INFO_NAME && ${#_USB_INFO_NAME} -le 256 &&
     $_USB_INFO_NAME != *[[:cntrl:]]* ]] || return 1
  [[ -n $_USB_INFO_PROTOCOL && ${#_USB_INFO_PROTOCOL} -le 64 &&
     $_USB_INFO_PROTOCOL != *[[:cntrl:]]* ]] || return 1
  [[ ${#device_tree} -le 2048 && $device_tree != *[[:cntrl:]]* ]] || return 1
  [[ $internal == false ]] && _USB_INFO_EXTERNAL=1
  [[ $physical == Physical ]] && _USB_INFO_PHYSICAL=1
  [[ $whole == true ]] && _USB_INFO_WHOLE=1
  [[ $writable == true ]] && _USB_INFO_WRITABLE=1
  _USB_INFO_FINGERPRINT="${_USB_INFO_ID}|${_USB_INFO_SIZE}|${_USB_INFO_NAME}|${_USB_INFO_PROTOCOL}"
  [[ -n $device_tree ]] && _USB_INFO_FINGERPRINT+="|$device_tree"
}

_usb_info_is_eligible() {
  (( _USB_INFO_EXTERNAL && _USB_INFO_PHYSICAL && _USB_INFO_WHOLE &&
     _USB_INFO_WRITABLE && _USB_INFO_SIZE > 0 ))
}

_usb_disks_capture() {
  emulate -L zsh
  local image_size=$1 excluded_disk=${2:-} media_kind=${3:-raw-image}
  local identifier='' size_label='' effect_detail=''
  local -i excluded_count=0 ineligible_count=0 undersized_count=0
  local -a captured_ids=()
  _USB_CAPTURE_ERROR=''
  [[ $image_size == <-> ]] || return 2
  _usb_disk_ids_capture || return
  captured_ids=("${_USB_DISK_IDS[@]}")
  _USB_DISK_IDS=() _USB_DISK_LABELS=() _USB_DISK_DETAILS=()
  _USB_DISK_SIZES=() _USB_DISK_FINGERPRINTS=()
  for identifier in "${captured_ids[@]}"; do
    if [[ -n $excluded_disk && $identifier == "$excluded_disk" ]]; then
      (( ++excluded_count ))
      continue
    fi
    _usb_disk_info_capture "$identifier" || {
      (( ++ineligible_count ))
      continue
    }
    _usb_info_is_eligible || {
      (( ++ineligible_count ))
      continue
    }
    (( _USB_INFO_SIZE >= image_size )) || {
      (( ++undersized_count ))
      continue
    }
    _usb_human_size "$_USB_INFO_SIZE"
    size_label=$REPLY
    _USB_DISK_IDS+=("$_USB_INFO_ID")
    _USB_DISK_LABELS+=("${_USB_INFO_NAME} · $size_label · ${_USB_INFO_PROTOCOL} · /dev/${_USB_INFO_ID}")
    if [[ $media_kind == macos-installer ]]; then
      effect_detail='Apple createinstallmedia will erase and format this whole external disk; every existing partition and all data may be destroyed.'
    else
      effect_detail='The image writes from sector zero; existing partitions and data may be destroyed.'
    fi
    _USB_DISK_DETAILS+=("${_USB_INFO_NAME}"$'\n'"/dev/${_USB_INFO_ID} · $size_label"$'\n'"${_USB_INFO_PROTOCOL} · external physical · writable whole disk"$'\n\n'"$effect_detail")
    _USB_DISK_SIZES+=("$_USB_INFO_SIZE")
    _USB_DISK_FINGERPRINTS+=("$_USB_INFO_FINGERPRINT")
  done
  (( ${#_USB_DISK_IDS} )) || {
    if (( excluded_count == ${#captured_ids} && excluded_count > 0 )); then
      _USB_CAPTURE_ERROR='the only attached external disk contains the selected image; attach another external disk or move the image to a different disk'
    elif (( undersized_count > 0 && ineligible_count == 0 )); then
      _USB_CAPTURE_ERROR='no separate writable whole external physical disk is large enough for the selected image'
    else
      _USB_CAPTURE_ERROR='no separate writable whole external physical target is currently eligible'
    fi
    return 1
  }
}

_usb_picker_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local query=$1 raw_limit=$2 value='' label='' searchable='' pattern='(#i)*' character=''
  local literal=''
  local -i limit=$raw_limit index=0 result_index=0
  typeset -ga _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
  [[ $limit == <-> ]] || limit=10
  if [[ -z $query ]]; then
    for (( index = 1; index <= ${#_USB_PICKER_VALUES} && index <= limit; ++index )); do
      _ZLE_PICKER_RESULTS+=("${_USB_PICKER_VALUES[index]}")
      _ZLE_PICKER_LABELS+=("${_USB_PICKER_LABELS[index]}")
    done
  else
    (( ${+functions[_zle_picker_escape_pattern]} )) || return 1
    _zle_picker_escape_pattern "$query"
    literal=$REPLY
    local candidate_pattern=''
    for candidate_pattern in "(#i)${literal}*" "(#i)*${literal}*"; do
      for (( index = 1; index <= ${#_USB_PICKER_VALUES}; ++index )); do
        value=${_USB_PICKER_VALUES[index]}
        (( _ZLE_PICKER_RESULTS[(Ie)$value] )) && continue
        label=${_USB_PICKER_LABELS[index]}
        searchable="${label} ${_USB_PICKER_SEARCH[index]-}"
        [[ $searchable == ${~candidate_pattern} ]] || continue
        _ZLE_PICKER_RESULTS+=("$value") _ZLE_PICKER_LABELS+=("$label")
        (( ${#_ZLE_PICKER_RESULTS} >= limit )) && break 2
      done
    done
    if (( ${#_ZLE_PICKER_RESULTS} < limit )); then
      for character in "${(s::)query}"; do
        _zle_picker_escape_pattern "$character"
        pattern+="${REPLY}*"
      done
      for (( index = 1; index <= ${#_USB_PICKER_VALUES}; ++index )); do
        value=${_USB_PICKER_VALUES[index]}
        (( _ZLE_PICKER_RESULTS[(Ie)$value] )) && continue
        label=${_USB_PICKER_LABELS[index]}
        searchable="${label} ${_USB_PICKER_SEARCH[index]-}"
        [[ $searchable == ${~pattern} ]] || continue
        _ZLE_PICKER_RESULTS+=("$value") _ZLE_PICKER_LABELS+=("$label")
        (( ${#_ZLE_PICKER_RESULTS} >= limit )) && break
      done
    fi
  fi
  for (( index = 1; index <= ${#_ZLE_PICKER_RESULTS}; ++index )); do
    result_index=$index
    (( result_index == 10 )) && result_index=0
    _ZLE_PICKER_RESULT_INDEXES+=($result_index)
  done
}

_usb_choose() {
  emulate -L zsh
  local title=$1 subtitle=$2 query_label=$3
  local -i show_details=${4:-0}
  local -i _ZLE_PICKER_REFRESH_ENABLED=${5:-0}
  local -i show_highlights=${6:-0}
  local refresh_label=${7:-'captured external disks · Ctrl-R refresh'}
  local initial_query=${8:-} initial_value=${9:-}
  local -i start_index=1 start_offset=0
  local _ZLE_PICKER_TITLE=$title _ZLE_PICKER_SUBTITLE=$subtitle
  local _ZLE_PICKER_QUERY_LABEL=$query_label _ZLE_PICKER_INSPECT_TITLE=Details
  local _ZLE_PICKER_INSPECT_ACTION=choose _ZLE_PICKER_CANCEL_LABEL=back
  local _ZLE_PICKER_BROWSE_LABEL='captured choices · no action yet'
  (( _ZLE_PICKER_REFRESH_ENABLED )) &&
    _ZLE_PICKER_BROWSE_LABEL=$refresh_label
  local _ZLE_PICKER_COLLECTOR=_usb_picker_collect
  local -i _ZLE_PICKER_WORKSPACE_ACTIONS=0 _ZLE_PICKER_COPY_ENABLED=0
  local -i _ZLE_PICKER_DIGIT_SELECT=1
  local -A _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -A _ZLE_PICKER_LABEL_HIGHLIGHTS=()
  local -i index=0
  for (( index = 1; index <= ${#_USB_PICKER_VALUES}; ++index )); do
    _ZLE_PICKER_ACCEPT_LABELS[${_USB_PICKER_VALUES[index]}]=choose
    (( show_highlights )) && [[ -n ${_USB_PICKER_HIGHLIGHTS[index]-} ]] &&
      _ZLE_PICKER_LABEL_HIGHLIGHTS[${_USB_PICKER_VALUES[index]}]=${_USB_PICKER_HIGHLIGHTS[index]}
    if (( show_details )); then
      _ZLE_PICKER_INSPECT_TEXTS[${_USB_PICKER_VALUES[index]}]=${_USB_PICKER_DETAILS[index]-}
    fi
  done
  if [[ -n $initial_value ]]; then
    _usb_picker_collect "$initial_query" 501
    start_index=${_ZLE_PICKER_RESULTS[(Ie)$initial_value]}
    (( start_index > 0 )) || start_index=1
    start_offset=$(( start_index - 1 ))
  fi
  _zle_picker_loop "$initial_query" 20 $start_index $start_offset
}

# A first removable-volume access can return once while macOS applies the
# user's permission choice. Keep the established image and screen session so
# the user can retry that explicit provider capture without starting over.
_usb_disks_capture_retry() {
  emulate -L zsh
  local image_size=$1 image_label=$2 back_value=$3 back_label=$4
  local excluded_disk=${5:-}
  local media_kind=${6:-raw-image}
  local error='' selected='' retry_label='' retry_detail='' subtitle=''
  local -i result=0
  while true; do
    _usb_disks_capture "$image_size" "$excluded_disk" "$media_kind" && return 0
    error=${_USB_CAPTURE_ERROR:-'diskutil did not return a usable external-disk snapshot'}
    retry_label='Retry target capture · permission or attachment may have changed'
    retry_detail='Retry target capture'$'\n\n'"$error"$'\n\n''macOS can return once while applying removable-volume permission. Enter performs a fresh read-only diskutil capture.'
    subtitle="DRIVE unavailable · $error"
    if [[ $error == 'no whole external physical disks are attached' ]]; then
      retry_label='Make drive available · connect or replug it, then retry'
      retry_detail='No external disk is currently visible to macOS.'$'\n\n''A drive can remain physically plugged in after macOS ejects it. Ctrl-R cannot reactivate an ejected drive. Unplug and reconnect the drive (or power-cycle its hub), then press Ctrl-R or Enter.'
      subtitle='DRIVE unavailable · no external disk is currently visible to macOS'
    fi
    _USB_PICKER_VALUES=(retry "$back_value")
    _USB_PICKER_LABELS=(
      "$retry_label"
      "$back_label")
    _USB_PICKER_SEARCH=(retry permission disk refresh back image target)
    _USB_PICKER_DETAILS=(
      "$retry_detail"
      "$back_label"$'\n\n''Return without discarding the established image or performing an action.')
    _usb_choose 'Flash USB · Step 2 of 3' "$subtitle" 'Filter choices' 0 1
    result=$?
    (( result == 1 )) && return 1
    (( result == 0 )) || return $result
    [[ $_ZLE_PICKER_ACTION == refresh ]] && continue
    selected=$_ZLE_PICKER_SELECTED_VALUE
    [[ $selected == retry ]] || return 1
  done
}

_usb_target_choose() {
  emulate -L zsh
  local image_size=$1 image_label=$2 back_value=$3 back_label=$4
  local excluded_disk=${5:-} subtitle=${6:-"Image  ›  DRIVE  ›  Flash · $image_label"}
  local media_kind=${7:-raw-image}
  local -i result=0 index=0
  while true; do
    _usb_disks_capture_retry "$image_size" "$image_label" "$back_value" \
      "$back_label" "$excluded_disk" "$media_kind" || return $?
    _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
    for (( index = 1; index <= ${#_USB_DISK_IDS}; ++index )); do
      _USB_PICKER_VALUES+=("$index") _USB_PICKER_LABELS+=("${_USB_DISK_LABELS[index]}")
      _USB_PICKER_SEARCH+=("${_USB_DISK_IDS[index]} ${_USB_DISK_LABELS[index]}")
      _USB_PICKER_DETAILS+=("${_USB_DISK_DETAILS[index]}")
    done
    _usb_choose 'Flash USB · Step 2 of 3' "$subtitle" 'Filter drives' 0 1
    result=$?
    (( result == 0 )) || return $result
    [[ $_ZLE_PICKER_ACTION == refresh ]] && continue
    return 0
  done
}

_usb_image_source_disk_retry() {
  emulate -L zsh
  local image=$1 error='' selected=''
  local -i result=0
  while true; do
    _usb_image_source_disk_capture "$image" && return 0
    error=${_USB_CAPTURE_ERROR:-'macOS did not return a usable image-volume snapshot'}
    _USB_PICKER_VALUES=(retry image)
    _USB_PICKER_LABELS=(
      'Retry image-volume access · permission may have changed'
      'Choose another image')
    _USB_PICKER_SEARCH=(retry permission volume image back)
    _USB_PICKER_DETAILS=(
      'Retry image-volume access'$'\n\n'"$error"$'\n\n''macOS can return once while applying removable-volume permission. Enter resolves the source again so it cannot be selected as the write target.'
      'Choose another image'$'\n\n''Return to the captured image choices without performing an action.')
    _usb_choose 'Flash USB · Step 1 of 3' "IMAGE unavailable · $error" 'Filter choices'
    result=$?
    (( result == 1 )) && return 1
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    [[ $selected == retry ]] || return 1
  done
}

_usb_image_architecture_capture() {
  emulate -L zsh
  _usb_image_architecture_hint "$1"
  _USB_SELECTED_IMAGE_ARCHITECTURE=$REPLY
}

_usb_media_attention_choose() {
  emulate -L zsh
  local image=$1 headline=$2 detail=$3
  local -a _USB_PICKER_VALUES=(back info)
  local -a _USB_PICKER_LABELS=('[ Choose another media ]' "$headline")
  local -a _USB_PICKER_HIGHLIGHTS=('' "0:${#headline}:picker-error")
  local -a _USB_PICKER_SEARCH=(back media unsupported inspect)
  local -a _USB_PICKER_DETAILS=('' "$detail")
  _usb_choose 'Flash USB · Media compatibility' \
    "MEDIA  ›  ${image:t}" 'Choose another media' 1 0 1
}

_usb_macos_review_choose() {
  emulate -L zsh
  local installer=$1 disk_index=$2 disk=${_USB_DISK_IDS[disk_index]}
  local source_label='Source validation · Verified · Apple-signed full installer'
  _USB_PICKER_VALUES=(flash-verify source image target)
  _USB_PICKER_LABELS=(
    '[ Create bootable macOS installer ]'
    "$source_label"
    "Change installer · ${installer:t}"
    "Change drive · ${_USB_DISK_LABELS[disk_index]}")
  _USB_PICKER_HIGHLIGHTS=(
    '' "0:${#source_label}:picker-success" '' '')
  _USB_PICKER_SEARCH=(create apple validation installer drive)
  _USB_PICKER_DETAILS=(
    'Create macOS installer'$'\n\n'"The whole selected external disk is prepared as Mac OS Extended, then the selected app’s Apple createinstallmedia tool builds the bootable installer and the disk is ejected."
    'Apple signature verified'$'\n\n''The full installer application and its createinstallmedia executable passed validation. Their captured filesystem identities are checked again before erasing the drive.'
    "${_USB_IMAGE_DETAILS[${_USB_IMAGE_PATHS[(Ie)$installer]}]}"
    "${_USB_DISK_DETAILS[disk_index]}")
  _usb_choose 'Flash USB · Step 3 of 3' \
    "Media  ›  Drive  ›  CREATE · macOS · ${installer:t} → /dev/$disk" \
    'Filter choices' 0 0 1
}

_usb_step3_checksum_progress() {
  emulate -L zsh
  local image=$1 disk=$2 disk_label=$3 checksum=$4 algorithm=$5 architecture=$6
  local _USB_SELECTED_IMAGE=$image _USB_SELECTED_DISK=$disk
  local _USB_SELECTED_DISK_LABEL=$disk_label _USB_SELECTED_CHECKSUM=$checksum
  local _USB_SELECTED_CHECKSUM_ALGORITHM=$algorithm
  local _USB_SELECTED_IMAGE_INTEGRITY=checking
  local _USB_SELECTED_IMAGE_ARCHITECTURE=$architecture
  _usb_progress_stage "Checking image SHA-$algorithm" \
    info 'Hashing the complete local image before confirmation.' \
    muted "Expected · ${checksum[1,16]}…"
}

_usb_workspace_controller() {
  emulate -L zsh
  local selected='' image='' disk='' source_disk=''
  local image_query='' image_initial_value='' refresh_path=''
  local checksum='' checksum_algorithm='' checksum_subtitle='' architecture_label=''
  local media_kind=raw-image media_error=''
  local checksum_state=not-provided checksum_actual='' integrity_label='' integrity_detail=''
  local integrity_role=''
  local _USB_CHECKSUM_ALGORITHM=''
  local -i image_index=1 disk_index=1 result=0 index=0 refresh_index=0
  local -a _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_HIGHLIGHTS=()
  local -a _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
  local -a previous_disk_ids=() previous_disk_labels=() previous_disk_details=()
  local -a previous_disk_sizes=() previous_disk_fingerprints=()

  while true; do
    _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_HIGHLIGHTS=() _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
    _USB_PICKER_VALUES+=(custom-path)
    _USB_PICKER_LABELS+=('[ Custom path to media… ]')
    _USB_PICKER_HIGHLIGHTS+=('')
    _USB_PICKER_SEARCH+=(custom path browse home finder)
    _USB_PICKER_DETAILS+=('Custom path to media'$'\n\n''Browse from ~/ with Compozsh fuzzy matching. Use Right or Return to enter a folder, Left to return, and choose one ISO, IMG, or full Install macOS application.')
    for (( index = 1; index <= ${#_USB_IMAGE_PATHS}; ++index )); do
      _USB_PICKER_VALUES+=("image:$index") _USB_PICKER_LABELS+=("${_USB_IMAGE_LABELS[index]}")
      _USB_PICKER_HIGHLIGHTS+=("${_USB_IMAGE_HIGHLIGHTS[index]}")
      _USB_PICKER_SEARCH+=("${_USB_IMAGE_PATHS[index]}")
      _USB_PICKER_DETAILS+=("${_USB_IMAGE_DETAILS[index]}")
    done
    _usb_choose 'Flash USB · Step 1 of 3' \
      "MEDIA  ›  Drive  ›  Flash · newest first · ${_USB_IMAGE_CAPTURE_SCOPE}" \
      'Filter media' 1 1 1 'captured media · Ctrl-R refresh Spotlight' \
      "$image_query" "$image_initial_value"
    result=$?
    (( result == 0 )) || return $result
    selected=$_ZLE_PICKER_SELECTED_VALUE
    if [[ $_ZLE_PICKER_ACTION == refresh ]]; then
      image_query=${_ZLE_PICKER_BOOKMARK[1]-}
      refresh_path=''
      [[ $selected == image:<-> ]] && refresh_path=${_USB_IMAGE_PATHS[${selected#image:}]-}
      _usb_images_capture || return $?
      refresh_index=${_USB_IMAGE_PATHS[(Ie)$refresh_path]}
      if [[ -n $refresh_path ]] && (( !refresh_index )); then
        if _usb_media_add "$refresh_path"; then
          _USB_IMAGE_CAPTURE_SCOPE+=' + selected exact path'
          _usb_images_sort_newest
        fi
      fi
      refresh_index=${_USB_IMAGE_PATHS[(Ie)$refresh_path]}
      if [[ -n $refresh_path ]] && (( refresh_index )); then
        image_initial_value="image:$refresh_index"
      else
        image_initial_value=''
      fi
      continue
    fi
    image_query='' image_initial_value=''
    if [[ $selected == custom-path ]]; then
      _usb_browse_image_path
      result=$?
      (( result == 1 )) && continue
      (( result == 0 )) || return $result
      if (( !_USB_IMAGE_PATHS[(Ie)$REPLY] )); then
        _usb_image_from_query "$REPLY" || continue
      fi
      _usb_images_sort_newest
      image_index=${_USB_IMAGE_PATHS[(Ie)$REPLY]}
    else
      image_index=${selected#image:}
    fi
    image=${_USB_IMAGE_PATHS[image_index]}
    media_kind=${_USB_IMAGE_KINDS[image_index]:-raw-image}
    if [[ -e $image ]]; then
      _usb_media_kind_capture "$image"
      result=$?
      if (( result != 0 )); then
        media_error=${_USB_MEDIA_ERROR:-'macOS could not classify the selected media safely'}
        _usb_media_attention_choose "$image" \
          "Media inspection failed · $media_error" \
          "$media_error"
        continue
      fi
      media_kind=$REPLY
    fi
    if [[ $media_kind == windows-installer ]]; then
      _usb_media_attention_choose "$image" \
        'Windows installer detected · Not supported yet' \
        'Compozsh recognized the Windows setup payload before selecting or changing a target. Windows USB creation needs its own filesystem-aware handler; this version refuses it and writes nothing.'
      continue
    fi
    if [[ $media_kind == macos-installer ]] && ! _usb_macos_codesign_verify "$image"; then
      _usb_media_attention_choose "$image" \
        'macOS installer validation failed · Nothing can be written' \
        'The selected application is incomplete or did not pass Apple code-signature validation. Download the full installer again with Software Update, the App Store, or softwareupdate.'
      continue
    fi
    checksum='' checksum_algorithm='' checksum_state=not-provided checksum_actual=''
    _USB_SELECTED_IMAGE_ARCHITECTURE=''
    _usb_image_architecture_capture "$image"

    _usb_image_source_disk_retry "$image"
    result=$?
    (( result == 1 )) && continue
    (( result == 0 )) || return $result
    source_disk=$_USB_IMAGE_SOURCE_DISK

    if [[ $media_kind == macos-installer ]]; then
      _usb_target_choose "${_USB_IMAGE_SIZES[image_index]}" "${image:t}" \
        image 'Choose another installer' "$source_disk" \
        "Media  ›  DRIVE  ›  Create macOS installer · ${image:t}" "$media_kind"
    else
      _usb_target_choose "${_USB_IMAGE_SIZES[image_index]}" "${image:t}" \
        image 'Choose another image' "$source_disk" '' "$media_kind"
    fi
    result=$?
    (( result == 1 )) && continue
    (( result == 0 )) || return $result
    disk_index=$_ZLE_PICKER_SELECTED_VALUE
    disk=${_USB_DISK_IDS[disk_index]}

    if [[ $media_kind == macos-installer ]]; then
      while true; do
        _usb_macos_review_choose "$image" "$disk_index"
        result=$?
        (( result == 1 )) && break
        (( result == 0 )) || return $result
        selected=$_ZLE_PICKER_SELECTED_VALUE
        case $selected in
          (image) break ;;
          (target)
            previous_disk_ids=("${_USB_DISK_IDS[@]}")
            previous_disk_labels=("${_USB_DISK_LABELS[@]}")
            previous_disk_details=("${_USB_DISK_DETAILS[@]}")
            previous_disk_sizes=("${_USB_DISK_SIZES[@]}")
            previous_disk_fingerprints=("${_USB_DISK_FINGERPRINTS[@]}")
            _usb_target_choose "${_USB_IMAGE_SIZES[image_index]}" "${image:t}" \
              target 'Keep current target' "$source_disk" \
              'Media  ›  DRIVE  ›  Create macOS installer · refreshed' "$media_kind"
            result=$?
            if (( result == 1 )); then
              _USB_DISK_IDS=("${previous_disk_ids[@]}")
              _USB_DISK_LABELS=("${previous_disk_labels[@]}")
              _USB_DISK_DETAILS=("${previous_disk_details[@]}")
              _USB_DISK_SIZES=("${previous_disk_sizes[@]}")
              _USB_DISK_FINGERPRINTS=("${previous_disk_fingerprints[@]}")
              continue
            fi
            (( result == 0 )) || return $result
            disk_index=$_ZLE_PICKER_SELECTED_VALUE
            disk=${_USB_DISK_IDS[disk_index]} ;;
          (flash-verify)
            _USB_REQUEST=$selected _USB_SELECTED_IMAGE=$image _USB_SELECTED_DISK=$disk
            _USB_SELECTED_MEDIA_KIND=$media_kind
            _USB_SELECTED_IMAGE_SIZE=${_USB_IMAGE_SIZES[image_index]}
            _USB_SELECTED_IMAGE_FINGERPRINT=${_USB_IMAGE_FINGERPRINTS[image_index]}
            _USB_SELECTED_DISK_FINGERPRINT=${_USB_DISK_FINGERPRINTS[disk_index]}
            _USB_SELECTED_DISK_SIZE=${_USB_DISK_SIZES[disk_index]}
            _USB_SELECTED_DISK_LABEL=${_USB_DISK_LABELS[disk_index]}
            _USB_SELECTED_SOURCE_DISK=$source_disk
            _USB_SELECTED_CHECKSUM='' _USB_SELECTED_CHECKSUM_ALGORITHM=''
            _USB_SELECTED_IMAGE_INTEGRITY=apple-signed
            return 0 ;;
        esac
      done
      continue
    fi

    while true; do
      _USB_PICKER_VALUES=() _USB_PICKER_LABELS=() _USB_PICKER_HIGHLIGHTS=()
      _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
      _USB_PICKER_VALUES+=(flash-verify)
      if [[ -n $checksum && $checksum_state == matched ]]; then
        _USB_PICKER_LABELS+=("[ Start flash & verify · SHA-$checksum_algorithm ]")
      elif [[ -n $checksum ]]; then
        _USB_PICKER_LABELS+=('[ Resolve image integrity check before flashing ]')
      else
        _USB_PICKER_LABELS+=('[ Start flash & verify ]')
      fi
      _USB_PICKER_HIGHLIGHTS+=('')
      _USB_PICKER_SEARCH+=('write verify checksum')
      _USB_PICKER_DETAILS+=(
        'Flash & verify'$'\n\n'"Step 3 validates a provided full-image checksum. After confirmation it revalidates the image and /dev/$disk, writes through /dev/r$disk, compares the full image first with a validated GPT-geometry fallback, and ejects.")
      _USB_PICKER_VALUES+=(checksum)
      case $checksum_state in
        (matched)
          integrity_role=picker-success
          integrity_label="Image integrity · Verified · SHA-$checksum_algorithm matched"
          integrity_detail="Verified local image"$'\n\n'"Expected"$'\n'"$checksum"$'\n\n'"Actual"$'\n'"$checksum_actual"$'\n\n''The complete local image matches the supplied checksum.' ;;
        (mismatch)
          integrity_role=picker-error
          integrity_label="Image integrity · FAILED · SHA-$checksum_algorithm mismatch"
          integrity_detail="Local image checksum mismatch"$'\n\n'"Expected"$'\n'"$checksum"$'\n\n'"Actual"$'\n'"${checksum_actual:-unavailable}"$'\n\n''The drive cannot be flashed until the checksum is corrected, removed, or a valid image is selected.' ;;
        (changed)
          integrity_role=picker-error
          integrity_label='Image integrity · FAILED · image changed during validation'
          integrity_detail='The selected image no longer matches its captured size or filesystem identity. Choose the image again before flashing.' ;;
        (error)
          integrity_role=picker-error
          integrity_label="Image integrity · Could not calculate SHA-$checksum_algorithm"
          integrity_detail='The selected image could not be read completely. Nothing can be written until the integrity check succeeds or the checksum is explicitly removed.' ;;
        (*)
          integrity_role=picker-error
          integrity_label='Image integrity · Not verified · no checksum provided'
          integrity_detail='No checksum was supplied. Flash & verify will still compare the finished drive with the selected local image, but the local image’s origin is not established.' ;;
      esac
      _USB_PICKER_LABELS+=("$integrity_label")
      _USB_PICKER_HIGHLIGHTS+=("0:${#integrity_label}:$integrity_role")
      _USB_PICKER_DETAILS+=("$integrity_detail")
      _USB_PICKER_SEARCH+=('checksum sha256 sha512 integrity')
      if [[ -n $checksum ]]; then
        _USB_PICKER_VALUES+=(remove-checksum)
        _USB_PICKER_LABELS+=('Remove image checksum')
        _USB_PICKER_HIGHLIGHTS+=('')
        _USB_PICKER_SEARCH+=('remove checksum')
        _USB_PICKER_DETAILS+=('Remove checksum'$'\n\n''Continue without trusted-checksum validation. Flash & verify will still perform the native raw-device comparison.')
      fi
      _USB_PICKER_VALUES+=(image target flash-only)
      _USB_PICKER_LABELS+=(
        "Change image · ${image:t}"
        "Change drive · ${_USB_DISK_LABELS[disk_index]}"
        'Flash without verification')
      _USB_PICKER_HIGHLIGHTS+=('' '' '')
      _USB_PICKER_SEARCH+=(image target write)
      _USB_PICKER_DETAILS+=(
        "${_USB_IMAGE_DETAILS[image_index]}"
        "${_USB_DISK_DETAILS[disk_index]}"
        'Flash only'$'\n\n'"Validates a provided checksum before writing, then writes /dev/r$disk and ejects without reading the payload back.")
      _usb_image_architecture_short_label "$_USB_SELECTED_IMAGE_ARCHITECTURE"
      architecture_label=$REPLY
      _usb_choose 'Flash USB · Step 3 of 3' \
        "Image  ›  Drive  ›  FLASH · $architecture_label · ${image:t} → /dev/$disk" \
        'Filter choices' 0 0 1
      result=$?
      (( result == 1 )) && break
      (( result == 0 )) || return $result
      selected=$_ZLE_PICKER_SELECTED_VALUE
      case $selected in
        (image) break ;;
        (checksum)
          checksum_subtitle='Paste one SHA-256 or SHA-512 checksum, then press Return'
          while true; do
            _usb_read_checksum "$checksum_subtitle" "$checksum"
            result=$?
            (( result == 1 )) && break
            (( result == 0 )) || return $result
            if _usb_checksum_parse "$_ZLE_PICKER_SELECTED_VALUE"; then
              checksum=$REPLY checksum_algorithm=$_USB_CHECKSUM_ALGORITHM
              checksum_state=checking checksum_actual=''
              _usb_step3_checksum_progress "$image" "$disk" \
                "${_USB_DISK_LABELS[disk_index]}" "$checksum" "$checksum_algorithm" \
                "$_USB_SELECTED_IMAGE_ARCHITECTURE"
              if ! _usb_image_revalidate "$image" "${_USB_IMAGE_FINGERPRINTS[image_index]}" \
                  "${_USB_IMAGE_SIZES[image_index]}"; then
                checksum_state=changed
              elif _usb_image_checksum "$image" "$checksum_algorithm"; then
                checksum_actual=$REPLY
                [[ $checksum_actual == "$checksum" ]] && checksum_state=matched || checksum_state=mismatch
              else
                checksum_state=error
              fi
              break
            fi
            checksum_subtitle='No single valid SHA-256 or SHA-512 digest was found; paste another'
          done
          continue ;;
        (remove-checksum)
          checksum='' checksum_algorithm='' checksum_state=not-provided checksum_actual=''
          continue ;;
        (target)
          previous_disk_ids=("${_USB_DISK_IDS[@]}")
          previous_disk_labels=("${_USB_DISK_LABELS[@]}")
          previous_disk_details=("${_USB_DISK_DETAILS[@]}")
          previous_disk_sizes=("${_USB_DISK_SIZES[@]}")
          previous_disk_fingerprints=("${_USB_DISK_FINGERPRINTS[@]}")
          _usb_target_choose "${_USB_IMAGE_SIZES[image_index]}" "${image:t}" \
            target 'Keep current target' "$source_disk" \
            'Image  ›  DRIVE  ›  Flash · refreshed' "$media_kind"
          result=$?
          if (( result == 1 )); then
            _USB_DISK_IDS=("${previous_disk_ids[@]}")
            _USB_DISK_LABELS=("${previous_disk_labels[@]}")
            _USB_DISK_DETAILS=("${previous_disk_details[@]}")
            _USB_DISK_SIZES=("${previous_disk_sizes[@]}")
            _USB_DISK_FINGERPRINTS=("${previous_disk_fingerprints[@]}")
            continue
          fi
          (( result == 0 )) || return $result
          disk_index=$_ZLE_PICKER_SELECTED_VALUE
          disk=${_USB_DISK_IDS[disk_index]} ;;
        (flash-verify|flash-only)
          if [[ -n $checksum && $checksum_state != matched ]]; then
            checksum_subtitle='The image integrity check must match before flashing; paste the correct checksum or go back and remove it'
            continue
          fi
          _USB_REQUEST=$selected _USB_SELECTED_IMAGE=$image _USB_SELECTED_DISK=$disk
          _USB_SELECTED_MEDIA_KIND=$media_kind
          _USB_SELECTED_IMAGE_SIZE=${_USB_IMAGE_SIZES[image_index]}
          _USB_SELECTED_IMAGE_FINGERPRINT=${_USB_IMAGE_FINGERPRINTS[image_index]}
          _USB_SELECTED_DISK_FINGERPRINT=${_USB_DISK_FINGERPRINTS[disk_index]}
          _USB_SELECTED_DISK_SIZE=${_USB_DISK_SIZES[disk_index]}
          _USB_SELECTED_DISK_LABEL=${_USB_DISK_LABELS[disk_index]}
          _USB_SELECTED_SOURCE_DISK=$source_disk
          _USB_SELECTED_CHECKSUM=$checksum
          _USB_SELECTED_CHECKSUM_ALGORITHM=$checksum_algorithm
          _USB_SELECTED_IMAGE_INTEGRITY=$checksum_state
          return 0 ;;
      esac
    done
  done
}

_usb_image_revalidate() {
  emulate -L zsh
  local path=$1 expected_fingerprint=$2 expected_size=$3
  _usb_image_fingerprint "$path" || return 1
  [[ $REPLY == "$expected_fingerprint" && $expected_size == <-> ]] || return 1
  [[ ${${REPLY#*:*:}%%:*} == "$expected_size" ]]
}

_usb_target_revalidate() {
  emulate -L zsh
  local identifier=$1 expected_fingerprint=$2 image_size=$3
  _usb_disk_info_capture "$identifier" || return 1
  _usb_info_is_eligible || return 1
  [[ $_USB_INFO_FINGERPRINT == "$expected_fingerprint" ]] || return 1
  (( _USB_INFO_SIZE >= image_size ))
}

_usb_human_duration() {
  emulate -L zsh
  local -i total=${1:-0} hours=0 minutes=0 seconds=0
  (( total < 0 )) && total=0
  hours=$(( total / 3600 ))
  minutes=$(( (total % 3600) / 60 ))
  seconds=$(( total % 60 ))
  if (( hours )); then
    REPLY="${hours}h ${minutes}m ${seconds}s"
  elif (( minutes )); then
    REPLY="${minutes}m ${seconds}s"
  else
    REPLY="${seconds}s"
  fi
}

_usb_progress_bar() {
  emulate -L zsh
  local -i percent=${1:-0} width=${2:-32} filled_count=0
  local filled='' empty=''
  (( percent < 0 )) && percent=0
  (( percent > 100 )) && percent=100
  (( width < 10 )) && width=10
  filled_count=$(( percent * width / 100 ))
  printf -v filled '%*s' $filled_count ''
  printf -v empty '%*s' $(( width - filled_count )) ''
  filled=${filled// /=}
  empty=${empty// /·}
  REPLY="[$filled$empty] ${percent}%"
}

_usb_noop() {
  return 0
}

# Paint one stable stage frame. The caller then performs its synchronous
# effect while that frame remains visible; dd publishes determinate updates.
_usb_progress_stage() {
  emulate -L zsh
  local stage=$1 style='' line='' integrity_status=''
  local image=${_USB_SELECTED_IMAGE:-} disk_label=${_USB_SELECTED_DISK_LABEL:-}
  local -i _ZLE_PICKER_STATUS_VIEW=1
  local _ZLE_PICKER_BUSY_LABEL="● ${stage:u}"
  local -a _ZLE_PICKER_BUSY_LINES=() _ZLE_PICKER_BUSY_STYLES=()
  shift
  (( ${+functions[_zle_picker_capture]} )) || return 0
  if [[ -n $image ]]; then
    if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} == macos-installer ]]; then
      _ZLE_PICKER_BUSY_LINES=(
        '' 'MACOS INSTALLER' "  ${image:t}" "  ${image:h}"
        '' 'TARGET' "  ${disk_label:-/dev/${_USB_SELECTED_DISK}}" ''
        'SOURCE VALIDATION' '  Verified · Apple-signed full installer' '')
      _ZLE_PICKER_BUSY_STYLES=(
        picker-text picker-status-heading picker-status-info picker-status-muted
        picker-text picker-status-heading picker-status-info picker-text
        picker-status-heading picker-status-success picker-text)
    else
      _ZLE_PICKER_BUSY_LINES=(
        '' 'IMAGE' "  ${image:t}" "  ${image:h}"
      '' 'TARGET' "  ${disk_label:-/dev/${_USB_SELECTED_DISK}}" '')
      _ZLE_PICKER_BUSY_STYLES=(
        picker-text picker-status-heading picker-status-info picker-status-muted
        picker-text picker-status-heading picker-status-info picker-text)
      if [[ -n ${_USB_SELECTED_CHECKSUM:-} ]]; then
        integrity_status='Provided · verification pending'
        case ${_USB_SELECTED_IMAGE_INTEGRITY:-} in
          (matched) integrity_status="Verified in Step 3 · SHA-${_USB_SELECTED_CHECKSUM_ALGORITHM} matched" ;;
          (checking) integrity_status="Checking · SHA-${_USB_SELECTED_CHECKSUM_ALGORITHM}" ;;
        esac
        _ZLE_PICKER_BUSY_LINES+=(
          'IMAGE INTEGRITY' "  $integrity_status" '')
        _ZLE_PICKER_BUSY_STYLES+=(
          picker-status-heading picker-status-info picker-text)
      else
        _ZLE_PICKER_BUSY_LINES+=(
          'IMAGE INTEGRITY' '  Not verified · no checksum provided' '')
        _ZLE_PICKER_BUSY_STYLES+=(
          picker-status-heading picker-status-warning picker-text)
      fi
      if [[ -n ${_USB_SELECTED_IMAGE_ARCHITECTURE:-} ]]; then
        _usb_image_architecture_short_label "$_USB_SELECTED_IMAGE_ARCHITECTURE"
        _ZLE_PICKER_BUSY_LINES+=(
          'IMAGE ARCHITECTURE' "  $REPLY" '')
        _ZLE_PICKER_BUSY_STYLES+=(
          picker-status-heading picker-status-info picker-text)
      fi
    fi
  fi
  while (( $# >= 2 )); do
    style=$1 line=$2
    shift 2
    case $style in
      (heading|info|progress|warning|muted) ;;
      (*) style=info ;;
    esac
    _ZLE_PICKER_BUSY_LINES+=("$line")
    _ZLE_PICKER_BUSY_STYLES+=("picker-status-$style")
  done
  _zle_picker_capture 'Flash USB · Step 3 of 3' 'Image  ›  Drive  ›  FLASH' '' _usb_noop
}

_usb_dd_progress_read() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local progress_file=$1 total=$2 started=$3 raw='' line='' byte_text=''
  local -i raw_size=0 bytes=0 percent=0 elapsed=$(( SECONDS - started )) bar_width=32
  local done_label='' total_label=''
  bar_width=$(( (${COLUMNS:-80} - 12) / 2 ))
  (( bar_width < 24 )) && bar_width=24
  (( bar_width > 64 )) && bar_width=64
  _usb_progress_bar 0 $bar_width
  _USB_PROGRESS_BAR=$REPLY
  REPLY='Preparing the first write block…'
  [[ -f $progress_file && $total == <-> ]] || return 0
  raw_size=$(command /usr/bin/stat -f '%z' "$progress_file" 2>/dev/null) || return 0
  (( raw_size > 0 && raw_size <= 1048576 )) || return 0
  raw=$(<"$progress_file")
  raw=${raw//$'\r'/$'\n'}
  for line in "${(f)raw}"; do
    line=${line##[[:space:]]#}
    # Apple dd uses two native status shapes. Periodic status=progress records
    # include human-readable units between "bytes" and "transferred", while
    # the completion record keeps those words adjacent. Accept both without
    # interpreting any other stderr line as progress.
    if [[ $line == <->' bytes '*transferred* ]]; then
      byte_text=${line%% *}
      [[ $byte_text == <-> ]] && bytes=$byte_text
      continue
    fi
    case $line in
      (compozsh-write-stage:*)
        _USB_WRITE_STAGE=${line#compozsh-write-stage:}
        continue ;;
      (''|*' records in'|*' records out') continue ;;
    esac
    if (( ${#line} <= 512 )) && [[ $line != *[[:cntrl:]]* ]]; then
      _USB_WRITE_ERROR=$line
    fi
  done
  (( bytes > _USB_WRITE_BYTES_OBSERVED )) && _USB_WRITE_BYTES_OBSERVED=$bytes
  (( bytes > total )) && bytes=$total
  (( total > 0 )) && percent=$(( bytes * 100 / total ))
  _usb_progress_bar $percent $bar_width
  _USB_PROGRESS_BAR=$REPLY
  _usb_human_size $bytes
  done_label=$REPLY
  _usb_human_size $total
  total_label=$REPLY
  _usb_human_duration $elapsed
  REPLY="$done_label of $total_label · $REPLY elapsed"
}

_usb_authorize() {
  command /usr/bin/sudo -v
}

_usb_authorization_valid() {
  command /usr/bin/sudo -n -v
}

_usb_unmount() {
  command /usr/sbin/diskutil unmountDisk "/dev/$1"
}

_usb_dd_run() {
  command /usr/bin/sudo -n /bin/dd "$@"
}

_usb_raw_write_script_capture() {
  emulate -L zsh
  REPLY='emulate -LR zsh
zmodload zsh/system || exit
local image=$1 device=$2 sector_count=$3 tail_seek=$4 tail_count=$5
local -i tail_byte_offset=0
[[ -f $image && ! -L $image ]] || exit 2
[[ (-c $device || -f $device) && ! -L $device ]] || exit 2
[[ $sector_count == <-> && $tail_seek == <-> && $tail_count == <-> ]] || exit 2
(( sector_count > 0 && tail_seek >= 0 && tail_count >= 0 )) || exit 2
print -u2 -r -- compozsh-write-stage:open
if [[ -c $device ]]; then
  exec 9> "$device" || exit 1
else
  exec 9<> "$device" || exit 1
fi
print -u2 -r -- compozsh-write-stage:image
command /bin/dd if="$image" ibs=512 obs=4m count="$sector_count" \
  conv=notrunc,fsync oflag=direct status=progress >&9 || exit
if (( tail_count > 0 )); then
  print -u2 -r -- compozsh-write-stage:tail
  tail_byte_offset=$(( tail_seek * 512 ))
  sysseek -u 9 "$tail_byte_offset" || exit
  command /bin/dd if=/dev/zero bs=512 count="$tail_count" \
    conv=notrunc,fsync oflag=direct status=none >&9 || exit
fi'
}

_usb_raw_write_session_run() {
  emulate -L zsh
  local image=$1 identifier=$2 sector_count=$3 tail_seek=$4 tail_count=$5
  [[ -f $image && ! -L $image && $identifier == disk<-> ]] || return 2
  [[ $sector_count == <-> && $tail_seek == <-> && $tail_count == <-> ]] || return 2
  (( sector_count > 0 && tail_seek >= 0 && tail_count >= 0 )) || return 2
  # Keep one privileged descriptor open from the first image byte through
  # physical-tail cleanup so Disk Arbitration cannot remount stale partitions
  # between separate raw-device writers.
  _usb_raw_write_script_capture
  command /usr/bin/sudo -n /bin/zsh -fc "$REPLY" compozsh-raw-write \
    "$image" "/dev/r${identifier}" "$sector_count" \
    "$tail_seek" "$tail_count"
}

_usb_write_image() {
  emulate -L zsh
  setopt NO_BG_NICE
  unsetopt MONITOR NOTIFY
  local image=$1 identifier=$2 image_size=$3 target_size=${4:-$3}
  local temp_root=${TMPDIR:-/tmp} progress_file='' progress_text=''
  local -i worker=0 command_status=1 started=$SECONDS sector_count=0
  local -i target_sectors=0 trailing_sectors=0 tail_count=0 tail_seek=0
  _USB_WRITE_BYTES_OBSERVED=0 _USB_WRITE_ERROR='' _USB_WRITE_STAGE=''
  [[ $image_size == <-> && $target_size == <-> ]] || return 2
  (( image_size > 0 && image_size % 512 == 0 )) || return 2
  (( target_size >= image_size && target_size % 512 == 0 )) || return 2
  sector_count=$(( image_size / 512 ))
  target_sectors=$(( target_size / 512 ))
  trailing_sectors=$(( target_sectors - sector_count ))
  if (( trailing_sectors > 0 )); then
    tail_count=$(( trailing_sectors < 33 ? trailing_sectors : 33 ))
    tail_seek=$(( target_sectors - tail_count ))
  fi
  progress_file=$(command /usr/bin/mktemp "${temp_root%/}/compozsh-usb-progress.XXXXXX" 2>/dev/null) || return 1
  {
    _usb_raw_write_session_run "$image" "$identifier" "$sector_count" \
      "$tail_seek" "$tail_count" 2>| "$progress_file" &
    worker=$!
    while builtin kill -0 $worker 2>/dev/null; do
      _usb_dd_progress_read "$progress_file" "$image_size" $started
      progress_text=$REPLY
      _usb_progress_stage 'Writing image' \
        progress "$_USB_PROGRESS_BAR" info "$progress_text" \
        warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
      command /bin/sleep 0.25
    done
    wait $worker
    command_status=$?
    _usb_dd_progress_read "$progress_file" "$image_size" $started
    if (( command_status == 0 && _USB_WRITE_BYTES_OBSERVED != image_size )); then
      command_status=3
    fi
    if (( command_status != 0 )) && [[ $_USB_WRITE_STAGE == tail ]]; then
      command_status=4
    fi
  } always {
    if (( worker )) && builtin kill -0 $worker 2>/dev/null; then
      builtin kill -INT $worker 2>/dev/null
      wait $worker 2>/dev/null
    fi
    if [[ -n $progress_file && ${progress_file:t} == compozsh-usb-progress.* &&
          ${progress_file:h:A} == ${temp_root:A} ]]; then
      command /bin/rm -f -- "$progress_file"
    fi
  }
  return $command_status
}

_usb_dd_read_run() {
  command /usr/bin/sudo -n /bin/dd "$@"
}

_usb_dd_bytes_observed() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local path=$1 raw='' line='' byte_text=''
  local -i raw_size=0 bytes=-1
  [[ -f $path ]] || return 1
  raw_size=$(command /usr/bin/stat -f '%z' "$path" 2>/dev/null) || return 1
  (( raw_size > 0 && raw_size <= 1048576 )) || return 1
  raw=$(<"$path")
  raw=${raw//$'\r'/$'\n'}
  for line in "${(f)raw}"; do
    line=${line##[[:space:]]#}
    [[ $line == <->' bytes '*transferred* ]] || continue
    byte_text=${line%% *}
    [[ $byte_text == <-> ]] && bytes=$byte_text
  done
  (( bytes >= 0 )) || return 1
  REPLY=$bytes
}

_usb_cmp_drain() {
  emulate -L zsh
  local count=$1 target_offset=$2 image_offset=$3 image=$4
  local -i compare_status=2
  command /usr/bin/cmp -n "$count" -i "${target_offset}:${image_offset}" \
    - "$image"
  compare_status=$?
  command /bin/cat >/dev/null
  return $compare_status
}

_usb_cmp_run() {
  emulate -L zsh
  setopt PIPE_FAIL
  local -a arguments=("$@") statuses=()
  local target='' image='' raw_size='' after_size=''
  local temp_root=${TMPDIR:-/tmp} read_log='' block_label=512
  local phase=${_USB_VERIFY_PHASE:-Reading USB}
  local -i count=0 offset=0 block_start=0 intra=0 read_bytes=0 blocks=0
  local -i block_size=512 minimum_raw_bytes=0 owns_read_log=0
  [[ ${arguments[1]:-} == -n && ${arguments[2]:-} == <-> ]] || return 2
  count=${arguments[2]}
  arguments=("${arguments[@]:2}")
  if [[ ${arguments[1]:-} == -i ]]; then
    [[ ${arguments[2]:-} == <-> ]] || return 2
    offset=${arguments[2]}
    arguments=("${arguments[@]:2}")
  fi
  (( ${#arguments} == 2 && count > 0 && offset >= 0 )) || return 2
  target=${arguments[1]} image=${arguments[2]}
  raw_size=$(command /usr/bin/stat -f '%z' "$image" 2>/dev/null) || return 2
  [[ $raw_size == <-> ]] && (( raw_size >= offset + count )) || return 2
  # Tiny structural probes remain sector-sized. Large payload comparisons use
  # aligned 4 MiB reads so an uncached USB scan does hundreds of native reads,
  # rather than millions of 512-byte system calls.
  if (( count >= 4194304 )); then
    block_size=4194304
    block_label=4m
  fi
  block_start=$(( offset / block_size * block_size ))
  intra=$(( offset - block_start ))
  read_bytes=$(( intra + count ))
  blocks=$(( (read_bytes + block_size - 1) / block_size ))
  minimum_raw_bytes=$read_bytes
  if [[ -n ${_USB_VERIFY_PROGRESS_FILE:-} &&
        ${_USB_VERIFY_PROGRESS_FILE:t} == compozsh-usb-verify-progress.* &&
        ${_USB_VERIFY_PROGRESS_FILE:h:A} == ${temp_root:A} ]]; then
    read_log=$_USB_VERIFY_PROGRESS_FILE
  else
    read_log=$(command /usr/bin/mktemp "${temp_root%/}/compozsh-usb-read.XXXXXX" \
      2>/dev/null) || return 2
    owns_read_log=1
  fi
  if [[ -n ${_USB_VERIFY_META_FILE:-} &&
        ${_USB_VERIFY_META_FILE:t} == compozsh-usb-verify-meta.* &&
        ${_USB_VERIFY_META_FILE:h:A} == ${temp_root:A} ]]; then
    builtin printf '%s\t%d\t%d\n' "$phase" "$count" "$intra" \
      >| "$_USB_VERIFY_META_FILE"
  fi
  {
    _usb_dd_read_run "if=$target" "bs=$block_label" \
        skip=$(( block_start / block_size )) count="$blocks" \
        iflag=direct status=progress 2>| "$read_log" |
      _usb_cmp_drain "$count" "$intra" "$offset" "$image"
    statuses=("${pipestatus[@]}")
    _usb_dd_bytes_observed "$read_log" || return 2
    (( statuses[1] == 0 && REPLY >= minimum_raw_bytes )) || return 2
    after_size=$(command /usr/bin/stat -f '%z' "$image" 2>/dev/null) || return 2
    [[ $after_size == "$raw_size" ]] || return 2
    return ${statuses[2]}
  } always {
    (( owns_read_log )) && command /bin/rm -f -- "$read_log"
  }
}

_usb_verify_progress_read() {
  emulate -L zsh
  local progress_file=$1 meta_file=$2 started=$3
  local phase='Preparing raw read' meta='' done_label='' total_label=''
  local -i total=0 intra=0 raw_bytes=0 bytes=0 percent=0
  local -i elapsed=$(( SECONDS - started )) bar_width=32
  bar_width=$(( (${COLUMNS:-80} - 12) / 2 ))
  (( bar_width < 24 )) && bar_width=24
  (( bar_width > 64 )) && bar_width=64
  _usb_progress_bar 0 $bar_width
  _USB_VERIFY_PROGRESS_BAR=$REPLY
  REPLY='Preparing the first raw read block…'
  [[ -f $meta_file ]] || return 0
  meta=$(<"$meta_file")
  IFS=$'\t' read -r phase total intra <<< "$meta"
  [[ $total == <-> && $intra == <-> ]] || return 0
  if _usb_dd_bytes_observed "$progress_file"; then
    raw_bytes=$REPLY
    bytes=$(( raw_bytes > intra ? raw_bytes - intra : 0 ))
    (( bytes > total )) && bytes=$total
  fi
  (( total > 0 )) && percent=$(( bytes * 100 / total ))
  _usb_progress_bar $percent $bar_width
  _USB_VERIFY_PROGRESS_BAR=$REPLY
  _usb_human_size $bytes
  done_label=$REPLY
  _usb_human_size $total
  total_label=$REPLY
  _usb_human_duration $elapsed
  REPLY="$phase · $done_label of $total_label · $REPLY elapsed"
}

_usb_image_checksum_run() {
  local algorithm=$1 image=$2
  command /usr/bin/shasum -a "$algorithm" -b < "$image"
}

_usb_checksum_output_read() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local output=$1 algorithm=$2 digest=${output%%[[:space:]]*}
  digest=${digest:l}
  case $algorithm in
    (256) (( ${#digest} == 64 )) || return 1 ;;
    (512) (( ${#digest} == 128 )) || return 1 ;;
    (*) return 1 ;;
  esac
  [[ $digest == [0-9a-f]## ]] || return 1
  REPLY=$digest
}

_usb_image_checksum() {
  emulate -L zsh
  local image=$1 algorithm=$2 output=''
  output=$(_usb_image_checksum_run "$algorithm" "$image") || return 1
  _usb_checksum_output_read "$output" "$algorithm"
}

_usb_od_uint() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local path=$1 offset=$2 width=$3 output=''
  case $width in
    (4|8) ;;
    (*) return 2 ;;
  esac
  output=$(command /usr/bin/od -An -j "$offset" -N "$width" -t "u${width}" "$path" \
    2>/dev/null) || return 1
  output=${output//[[:space:]]/}
  [[ $output == <-> ]] || return 1
  REPLY=$output
}

_usb_od_hex() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local path=$1 offset=$2 width=$3 output=''
  output=$(command /usr/bin/od -An -j "$offset" -N "$width" -t x1 "$path" \
    2>/dev/null) || return 1
  output=${output//[[:space:]]/}
  (( ${#output} == width * 2 )) || return 1
  [[ $output == [0-9a-f]## ]] || return 1
  REPLY=$output
}

_usb_file_range_digest() {
  emulate -L zsh
  setopt PIPE_FAIL
  local path=$1 offset=$2 count=$3 output=''
  local -i sectors=0
  (( offset >= 0 && count > 0 && offset % 512 == 0 )) || return 2
  sectors=$(( (count + 511) / 512 ))
  output=$(command /bin/dd if="$path" bs=512 skip=$(( offset / 512 )) \
      count="$sectors" status=none 2>/dev/null |
    command /usr/bin/head -c "$count" |
    command /usr/bin/shasum -a 256 -b) || return 1
  _usb_checksum_output_read "$output" 256
}

_usb_crc32_output_read() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local output=$1 expected_size=$2 checksum=${output%%[[:space:]]*}
  local remainder=${output#*[[:space:]]##}
  local size=${remainder%%[[:space:]]*}
  [[ $checksum == <-> && $size == <-> && $size == "$expected_size" ]] || return 1
  REPLY=$checksum
}

_usb_file_range_crc32() {
  emulate -L zsh
  setopt PIPE_FAIL
  local path=$1 offset=$2 count=$3 output=''
  (( offset >= 0 && count > 0 )) || return 2
  output=$(command /bin/dd if="$path" bs=1 skip="$offset" count="$count" \
      status=none 2>/dev/null | command /usr/bin/cksum -o 3) || return 1
  _usb_crc32_output_read "$output" "$count"
}

_usb_gpt_header_crc_validate() {
  emulate -L zsh
  setopt PIPE_FAIL
  local path=$1 offset=$2 header_size=$3 output='' expected=''
  (( offset >= 0 && header_size >= 92 && header_size <= 512 )) || return 2
  _usb_od_uint "$path" $(( offset + 16 )) 4 || return 1
  expected=$REPLY
  output=$(
    {
      command /bin/dd if="$path" bs=1 skip="$offset" count=16 status=none 2>/dev/null
      builtin printf '\0\0\0\0'
      command /bin/dd if="$path" bs=1 skip=$(( offset + 20 )) \
        count=$(( header_size - 20 )) status=none 2>/dev/null
    } | command /usr/bin/cksum -o 3
  ) || return 1
  _usb_crc32_output_read "$output" "$header_size" || return 1
  [[ $REPLY == "$expected" ]]
}

_usb_raw_range_digest() {
  emulate -L zsh
  setopt PIPE_FAIL
  local identifier=$1 offset=$2 count=$3 output=''
  local -i sectors=0
  (( offset >= 0 && count > 0 && offset % 512 == 0 )) || return 2
  sectors=$(( (count + 511) / 512 ))
  output=$(_usb_dd_read_run "if=/dev/r${identifier}" bs=512 \
      skip=$(( offset / 512 )) count="$sectors" iflag=direct status=none 2>/dev/null |
    command /usr/bin/head -c "$count" |
    command /usr/bin/shasum -a 256 -b) || return 1
  _usb_checksum_output_read "$output" 256
}

_usb_raw_sector_capture() {
  emulate -L zsh
  local identifier=$1 lba=$2 destination=$3
  (( lba >= 0 )) || return 2
  _usb_dd_read_run "if=/dev/r${identifier}" bs=512 skip="$lba" count=1 \
    iflag=direct status=none >| "$destination" 2>/dev/null || return 1
  [[ $(command /usr/bin/stat -f '%z' "$destination" 2>/dev/null) == 512 ]]
}

_usb_raw_tail_zero_validate() {
  emulate -L zsh
  setopt PIPE_FAIL
  local identifier=$1 image_size=$2 target_size=$3 output=''
  local -i image_sectors=0 target_sectors=0 trailing_sectors=0 check_sectors=0
  [[ $image_size == <-> && $target_size == <-> ]] || return 2
  (( image_size > 0 && target_size >= image_size )) || return 2
  (( target_size == image_size )) && return 0
  (( image_size % 512 == 0 && target_size % 512 == 0 )) || return 2
  image_sectors=$(( image_size / 512 ))
  target_sectors=$(( target_size / 512 ))
  trailing_sectors=$(( target_sectors - image_sectors ))
  (( trailing_sectors > 0 )) || return 0
  check_sectors=$(( trailing_sectors < 33 ? trailing_sectors : 33 ))
  output=$(
    _usb_dd_read_run "if=/dev/r${identifier}" bs=512 \
        skip=$(( target_sectors - check_sectors )) count="$check_sectors" \
        iflag=direct status=none 2>/dev/null |
      command /usr/bin/od -An -v -t x1 |
      command /usr/bin/tr -d '0[:space:]'
  ) || return 2
  [[ -z $output ]]
}

_usb_gpt_layout_capture() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local image=$1 raw_size=$2
  local primary_signature='' backup_signature=''
  local -i last_lba=0 primary_revision=0 primary_reserved=0
  local -i primary_header_size=0 primary_current=0 primary_backup=0
  local -i first_usable=0 last_usable=0 primary_entry_lba=0 entry_count=0
  local -i entry_size=0 entry_bytes=0 primary_entry_offset=0 primary_entry_end=0
  local -i backup_header_offset=0 backup_revision=0 backup_reserved=0
  local -i backup_header_size=0 backup_current=0
  local -i backup_alternate=0 backup_first_usable=0 backup_last_usable=0
  local -i backup_entry_lba=0 backup_entry_count=0 backup_entry_size=0
  local -i backup_entry_offset=0 entry_storage_bytes=0
  local -i primary_entry_crc=0 backup_entry_crc=0 actual_entry_crc=0
  _USB_GPT_ENTRY_OFFSET=0 _USB_GPT_ENTRY_BYTES=0
  _USB_GPT_STABLE_START=0 _USB_GPT_STABLE_END=0
  _USB_GPT_HEADER_SIZE=0 _USB_GPT_FIRST_USABLE=0 _USB_GPT_LAST_USABLE=0
  _USB_GPT_ENTRY_LBA=0 _USB_GPT_ENTRY_COUNT=0 _USB_GPT_ENTRY_SIZE=0
  _USB_GPT_ENTRY_CRC=0 _USB_GPT_DISK_GUID=''
  [[ $raw_size == <-> ]] && (( raw_size >= 68 * 512 && raw_size % 512 == 0 )) || return 1
  last_lba=$(( raw_size / 512 - 1 ))
  _usb_od_hex "$image" 512 8 || return 1
  primary_signature=$REPLY
  [[ $primary_signature == 4546492050415254 ]] || return 1
  _usb_od_uint "$image" 520 4 || return 1
  primary_revision=$REPLY
  _usb_od_uint "$image" 524 4 || return 1
  primary_header_size=$REPLY
  _usb_od_uint "$image" 532 4 || return 1
  primary_reserved=$REPLY
  _usb_od_uint "$image" 536 8 || return 1
  primary_current=$REPLY
  _usb_od_uint "$image" 544 8 || return 1
  primary_backup=$REPLY
  _usb_od_uint "$image" 552 8 || return 1
  first_usable=$REPLY
  _usb_od_uint "$image" 560 8 || return 1
  last_usable=$REPLY
  _usb_od_uint "$image" 584 8 || return 1
  primary_entry_lba=$REPLY
  _usb_od_uint "$image" 592 4 || return 1
  entry_count=$REPLY
  _usb_od_uint "$image" 596 4 || return 1
  entry_size=$REPLY
  _usb_od_uint "$image" 600 4 || return 1
  primary_entry_crc=$REPLY
  (( primary_revision == 65536 && primary_reserved == 0 )) || return 1
  (( primary_header_size >= 92 && primary_header_size <= 512 )) || return 1
  _usb_gpt_header_crc_validate "$image" 512 "$primary_header_size" || return 1
  (( primary_current == 1 && primary_backup == last_lba )) || return 1
  (( first_usable > primary_entry_lba && first_usable <= last_usable )) || return 1
  (( last_usable < last_lba && primary_entry_lba >= 2 )) || return 1
  (( entry_count > 0 && entry_count <= 4096 )) || return 1
  (( entry_size >= 128 && entry_size <= 4096 && entry_size % 8 == 0 )) || return 1
  entry_bytes=$(( entry_count * entry_size ))
  entry_storage_bytes=$(( (entry_bytes + 511) / 512 * 512 ))
  (( entry_bytes > 0 && entry_bytes <= 16777216 )) || return 1
  primary_entry_offset=$(( primary_entry_lba * 512 ))
  primary_entry_end=$(( primary_entry_offset + entry_bytes ))
  (( primary_entry_end <= first_usable * 512 )) || return 1

  backup_header_offset=$(( last_lba * 512 ))
  _usb_od_hex "$image" "$backup_header_offset" 8 || return 1
  backup_signature=$REPLY
  [[ $backup_signature == 4546492050415254 ]] || return 1
  _usb_od_uint "$image" $(( backup_header_offset + 8 )) 4 || return 1
  backup_revision=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 12 )) 4 || return 1
  backup_header_size=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 20 )) 4 || return 1
  backup_reserved=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 24 )) 8 || return 1
  backup_current=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 32 )) 8 || return 1
  backup_alternate=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 40 )) 8 || return 1
  backup_first_usable=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 48 )) 8 || return 1
  backup_last_usable=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 72 )) 8 || return 1
  backup_entry_lba=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 80 )) 4 || return 1
  backup_entry_count=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 84 )) 4 || return 1
  backup_entry_size=$REPLY
  _usb_od_uint "$image" $(( backup_header_offset + 88 )) 4 || return 1
  backup_entry_crc=$REPLY
  (( backup_revision == primary_revision && backup_reserved == 0 )) || return 1
  (( backup_header_size == primary_header_size )) || return 1
  _usb_gpt_header_crc_validate "$image" "$backup_header_offset" \
    "$backup_header_size" || return 1
  (( backup_header_size >= 92 && backup_header_size <= 512 )) || return 1
  (( backup_current == last_lba && backup_alternate == 1 )) || return 1
  (( backup_first_usable == first_usable && backup_last_usable == last_usable )) || return 1
  (( backup_entry_count == entry_count && backup_entry_size == entry_size )) || return 1
  backup_entry_offset=$(( backup_entry_lba * 512 ))
  (( backup_entry_lba > last_usable )) || return 1
  (( backup_entry_offset + entry_storage_bytes <= backup_header_offset )) || return 1
  _usb_od_hex "$image" 568 16 || return 1
  local primary_disk_guid=$REPLY backup_disk_guid='' primary_entries_digest=''
  _usb_od_hex "$image" $(( backup_header_offset + 56 )) 16 || return 1
  backup_disk_guid=$REPLY
  [[ $backup_disk_guid == "$primary_disk_guid" ]] || return 1
  (( primary_entry_crc == backup_entry_crc )) || return 1
  _usb_file_range_crc32 "$image" "$primary_entry_offset" "$entry_bytes" || return 1
  actual_entry_crc=$REPLY
  (( actual_entry_crc == primary_entry_crc )) || return 1
  _usb_file_range_digest "$image" "$primary_entry_offset" "$entry_bytes" || return 1
  primary_entries_digest=$REPLY
  _usb_file_range_digest "$image" "$backup_entry_offset" "$entry_bytes" || return 1
  [[ $REPLY == "$primary_entries_digest" ]] || return 1
  _USB_GPT_ENTRY_OFFSET=$primary_entry_offset
  _USB_GPT_ENTRY_BYTES=$entry_bytes
  _USB_GPT_STABLE_START=1024
  _USB_GPT_STABLE_END=$backup_entry_offset
  _USB_GPT_HEADER_SIZE=$primary_header_size
  _USB_GPT_FIRST_USABLE=$first_usable _USB_GPT_LAST_USABLE=$last_usable
  _USB_GPT_ENTRY_LBA=$primary_entry_lba _USB_GPT_ENTRY_COUNT=$entry_count
  _USB_GPT_ENTRY_SIZE=$entry_size _USB_GPT_ENTRY_CRC=$primary_entry_crc
  _USB_GPT_DISK_GUID=$primary_disk_guid
}

_usb_source_bounded_gpt_validate() {
  emulate -L zsh
  local image=$1 identifier=$2 image_size=$3
  local -i backup_bytes=0 compare_status=0
  (( image_size > _USB_GPT_STABLE_END )) || return 1
  backup_bytes=$(( image_size - _USB_GPT_STABLE_END ))

  # A raw hybrid image written to larger media may retain its complete GPT
  # inside the image extent. In that layout the extra device capacity is
  # intentionally outside the image; prove both GPT copies exactly instead of
  # requiring macOS to relocate the backup copy to the physical final LBA.
  _USB_VERIFY_PHASE='Checking source-bounded primary GPT'
  _usb_cmp_run -n 512 -i 512 "/dev/r${identifier}" "$image" >/dev/null 2>&1
  compare_status=$?
  case $compare_status in
    (0) ;;
    (1) return 1 ;;
    (*) return 2 ;;
  esac
  _USB_VERIFY_PHASE='Checking source-bounded backup GPT'
  _usb_cmp_run -n "$backup_bytes" -i "$_USB_GPT_STABLE_END" \
    "/dev/r${identifier}" "$image" >/dev/null 2>&1
  compare_status=$?
  case $compare_status in
    (0) return 0 ;;
    (1) return 1 ;;
    (*) return 2 ;;
  esac
}

_usb_target_gpt_layout_validate() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local image=$1 identifier=$2 image_size=$3 target_size=$4
  local temp_root=${TMPDIR:-/tmp} primary_file='' backup_file=''
  local primary_signature='' backup_signature='' primary_guid='' backup_guid=''
  local source_backup_digest='' target_backup_digest=''
  local -i target_last_lba=0 primary_revision=0 primary_header_size=0
  local -i primary_reserved=0 primary_current=0 primary_backup=0
  local -i primary_first_usable=0 primary_last_usable=0 primary_entry_lba=0
  local -i primary_entry_count=0 primary_entry_size=0 primary_entry_crc=0
  local -i backup_revision=0 backup_header_size=0 backup_reserved=0
  local -i backup_current=0 backup_alternate=0 backup_first_usable=0
  local -i backup_last_usable=0 backup_entry_lba=0 backup_entry_count=0
  local -i backup_entry_size=0 backup_entry_crc=0 backup_entry_offset=0
  local -i entry_storage_bytes=0 entry_storage_sectors=0
  [[ $image_size == <-> && $target_size == <-> ]] || return 1
  (( target_size >= image_size && target_size % 512 == 0 )) || return 1
  target_last_lba=$(( target_size / 512 - 1 ))
  entry_storage_bytes=$(( (_USB_GPT_ENTRY_BYTES + 511) / 512 * 512 ))
  entry_storage_sectors=$(( entry_storage_bytes / 512 ))
  (( target_last_lba > _USB_GPT_LAST_USABLE + entry_storage_sectors )) || return 1
  primary_file=$(command /usr/bin/mktemp \
    "${temp_root%/}/compozsh-usb-primary-gpt.XXXXXX" 2>/dev/null) || return 1
  backup_file=$(command /usr/bin/mktemp \
    "${temp_root%/}/compozsh-usb-backup-gpt.XXXXXX" 2>/dev/null) || {
    command /bin/rm -f -- "$primary_file"
    return 1
  }
  {
    _usb_raw_sector_capture "$identifier" 1 "$primary_file" || return 1
    _usb_raw_sector_capture "$identifier" "$target_last_lba" "$backup_file" || return 1

    _usb_od_hex "$primary_file" 0 8 || return 1
    primary_signature=$REPLY
    [[ $primary_signature == 4546492050415254 ]] || return 1
    _usb_od_uint "$primary_file" 8 4 || return 1
    primary_revision=$REPLY
    _usb_od_uint "$primary_file" 12 4 || return 1
    primary_header_size=$REPLY
    _usb_od_uint "$primary_file" 20 4 || return 1
    primary_reserved=$REPLY
    _usb_od_uint "$primary_file" 24 8 || return 1
    primary_current=$REPLY
    _usb_od_uint "$primary_file" 32 8 || return 1
    primary_backup=$REPLY
    _usb_od_uint "$primary_file" 40 8 || return 1
    primary_first_usable=$REPLY
    _usb_od_uint "$primary_file" 48 8 || return 1
    primary_last_usable=$REPLY
    _usb_od_hex "$primary_file" 56 16 || return 1
    primary_guid=$REPLY
    _usb_od_uint "$primary_file" 72 8 || return 1
    primary_entry_lba=$REPLY
    _usb_od_uint "$primary_file" 80 4 || return 1
    primary_entry_count=$REPLY
    _usb_od_uint "$primary_file" 84 4 || return 1
    primary_entry_size=$REPLY
    _usb_od_uint "$primary_file" 88 4 || return 1
    primary_entry_crc=$REPLY
    (( primary_revision == 65536 && primary_header_size == _USB_GPT_HEADER_SIZE )) || return 1
    (( primary_reserved == 0 && primary_current == 1 )) || return 1
    (( primary_backup == target_last_lba )) || return 1
    (( primary_first_usable == _USB_GPT_FIRST_USABLE )) || return 1
    (( primary_last_usable >= _USB_GPT_LAST_USABLE && primary_last_usable < target_last_lba )) || return 1
    [[ $primary_guid == "$_USB_GPT_DISK_GUID" ]] || return 1
    (( primary_entry_lba == _USB_GPT_ENTRY_LBA )) || return 1
    (( primary_entry_count == _USB_GPT_ENTRY_COUNT )) || return 1
    (( primary_entry_size == _USB_GPT_ENTRY_SIZE && primary_entry_crc == _USB_GPT_ENTRY_CRC )) || return 1
    _usb_gpt_header_crc_validate "$primary_file" 0 "$primary_header_size" || return 1

    _usb_od_hex "$backup_file" 0 8 || return 1
    backup_signature=$REPLY
    [[ $backup_signature == 4546492050415254 ]] || return 1
    _usb_od_uint "$backup_file" 8 4 || return 1
    backup_revision=$REPLY
    _usb_od_uint "$backup_file" 12 4 || return 1
    backup_header_size=$REPLY
    _usb_od_uint "$backup_file" 20 4 || return 1
    backup_reserved=$REPLY
    _usb_od_uint "$backup_file" 24 8 || return 1
    backup_current=$REPLY
    _usb_od_uint "$backup_file" 32 8 || return 1
    backup_alternate=$REPLY
    _usb_od_uint "$backup_file" 40 8 || return 1
    backup_first_usable=$REPLY
    _usb_od_uint "$backup_file" 48 8 || return 1
    backup_last_usable=$REPLY
    _usb_od_hex "$backup_file" 56 16 || return 1
    backup_guid=$REPLY
    _usb_od_uint "$backup_file" 72 8 || return 1
    backup_entry_lba=$REPLY
    _usb_od_uint "$backup_file" 80 4 || return 1
    backup_entry_count=$REPLY
    _usb_od_uint "$backup_file" 84 4 || return 1
    backup_entry_size=$REPLY
    _usb_od_uint "$backup_file" 88 4 || return 1
    backup_entry_crc=$REPLY
    (( backup_revision == primary_revision && backup_header_size == primary_header_size )) || return 1
    (( backup_reserved == 0 && backup_current == target_last_lba && backup_alternate == 1 )) || return 1
    (( backup_first_usable == primary_first_usable && backup_last_usable == primary_last_usable )) || return 1
    [[ $backup_guid == "$primary_guid" ]] || return 1
    (( backup_entry_count == primary_entry_count && backup_entry_size == primary_entry_size )) || return 1
    (( backup_entry_crc == primary_entry_crc )) || return 1
    (( backup_entry_lba + entry_storage_sectors <= target_last_lba )) || return 1
    (( backup_entry_lba > backup_last_usable )) || return 1
    _usb_gpt_header_crc_validate "$backup_file" 0 "$backup_header_size" || return 1
    backup_entry_offset=$(( backup_entry_lba * 512 ))
    _usb_file_range_digest "$image" "$_USB_GPT_STABLE_END" \
      "$_USB_GPT_ENTRY_BYTES" || return 1
    source_backup_digest=$REPLY
    _usb_raw_range_digest "$identifier" "$backup_entry_offset" \
      "$_USB_GPT_ENTRY_BYTES" || return 1
    target_backup_digest=$REPLY
    [[ $target_backup_digest == "$source_backup_digest" ]]
  } always {
    command /bin/rm -f -- "$primary_file" "$backup_file"
  }
}

_usb_compare_written_image() {
  emulate -L zsh
  local image=$1 identifier=$2 image_size=$3 target_size=${4:-$3}
  local gpt_mode=''
  local -i compared=0 compare_status=0 source_gpt_status=0 tail_status=0
  local _USB_VERIFY_PHASE='Full image comparison'
  _USB_PAYLOAD_VERIFY_ERROR='' _USB_PAYLOAD_VERIFY_SCOPE=''
  [[ $image_size == <-> ]] && (( image_size > 512 )) || return 2

  # Prefer the strongest result: every image byte, including boot metadata.
  _usb_cmp_run -n "$image_size" "/dev/r${identifier}" "$image" >/dev/null 2>&1
  compare_status=$?
  case $compare_status in
    (0)
      _USB_VERIFY_PHASE='Checking cleared physical tail'
      _usb_raw_tail_zero_validate "$identifier" "$image_size" "$target_size"
      tail_status=$?
      case $tail_status in
        (0) _USB_PAYLOAD_VERIFY_SCOPE=full; return 0 ;;
        (1) _USB_PAYLOAD_VERIFY_ERROR=stale-tail-gpt; return 1 ;;
        (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
      esac ;;
    (1) ;;
    (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
  esac

  # Preserve the real 440-byte MBR boot-code area and its 0x55AA signature.
  # Bytes 440..509 are disk signature and partition geometry.
  _USB_VERIFY_PHASE='Checking MBR boot code'
  _usb_cmp_run -n 440 "/dev/r${identifier}" "$image" >/dev/null 2>&1
  compare_status=$?
  case $compare_status in
    (0) ;;
    (1) _USB_PAYLOAD_VERIFY_ERROR=mismatch; return 1 ;;
    (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
  esac
  _USB_VERIFY_PHASE='Checking boot signature'
  _usb_cmp_run -n 2 -i 510 "/dev/r${identifier}" "$image" >/dev/null 2>&1
  compare_status=$?
  case $compare_status in
    (0) ;;
    (1) _USB_PAYLOAD_VERIFY_ERROR=mismatch; return 1 ;;
    (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
  esac
  if _usb_gpt_layout_capture "$image" "$image_size"; then
    # A GPT fallback may tolerate the four-byte MBR disk identifier at
    # 440..443, which macOS can assign independently. The reserved word and
    # all four hybrid/protective partition records remain boot metadata and
    # must still match the selected image exactly.
    _USB_VERIFY_PHASE='Checking hybrid MBR partition map'
    _usb_cmp_run -n 66 -i 444 "/dev/r${identifier}" "$image" >/dev/null 2>&1
    compare_status=$?
    case $compare_status in
      (0) ;;
      (1) _USB_PAYLOAD_VERIFY_ERROR=mismatch; return 1 ;;
      (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
    esac
    _usb_source_bounded_gpt_validate "$image" "$identifier" "$image_size"
    source_gpt_status=$?
    case $source_gpt_status in
      (0) gpt_mode=source-bounds ;;
      (1)
        _usb_target_gpt_layout_validate "$image" "$identifier" "$image_size" \
          "$target_size" || {
          _USB_PAYLOAD_VERIFY_ERROR=gpt-invalid
          return 1
        }
        gpt_mode=relocated ;;
      (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
    esac
    if [[ $gpt_mode == source-bounds ]]; then
      _USB_VERIFY_PHASE='Checking cleared physical tail'
      _usb_raw_tail_zero_validate "$identifier" "$image_size" "$target_size"
      tail_status=$?
      case $tail_status in
        (0) ;;
        (1) _USB_PAYLOAD_VERIFY_ERROR=stale-tail-gpt; return 1 ;;
        (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
      esac
    fi
    _USB_VERIFY_PHASE='Checking GPT partition entries'
    _usb_cmp_run -n "$_USB_GPT_ENTRY_BYTES" -i "$_USB_GPT_ENTRY_OFFSET" \
      "/dev/r${identifier}" "$image" >/dev/null 2>&1
    compare_status=$?
    case $compare_status in
      (0) ;;
      (1) _USB_PAYLOAD_VERIFY_ERROR=mismatch; return 1 ;;
      (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
    esac
    compared=$(( _USB_GPT_STABLE_END - _USB_GPT_STABLE_START ))
    (( compared > 0 )) || {
      _USB_PAYLOAD_VERIFY_ERROR=image-read-failed
      return 2
    }
    _USB_VERIFY_PHASE='Validated installer comparison'
    _usb_cmp_run -n "$compared" -i "$_USB_GPT_STABLE_START" \
      "/dev/r${identifier}" "$image" >/dev/null 2>&1
    compare_status=$?
    case $compare_status in
      (0)
        _USB_PAYLOAD_VERIFY_SCOPE=boot-and-installer-payload
        if [[ $gpt_mode == source-bounds ]]; then
          _USB_PAYLOAD_VERIFY_ERROR=gpt-source-bounds
        else
          _USB_PAYLOAD_VERIFY_ERROR=gpt-geometry-diff
        fi
        return 0 ;;
      (1) _USB_PAYLOAD_VERIFY_ERROR=mismatch; return 1 ;;
      (*) _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed; return 2 ;;
    esac
  fi
  _USB_PAYLOAD_VERIFY_ERROR=mismatch
  return 1
}

_usb_verify_payload() {
  emulate -L zsh
  setopt NO_BG_NICE
  unsetopt MONITOR NOTIFY
  local image=$1 identifier=$2 image_size=$3 target_size=${4:-$3}
  local temp_root=${TMPDIR:-/tmp} progress_file='' meta_file='' result_file=''
  local progress_text='' result='' line=''
  local _USB_VERIFY_PROGRESS_FILE='' _USB_VERIFY_META_FILE=''
  local -i worker=0 command_status=2 started=$SECONDS result_ready=0
  _USB_PAYLOAD_VERIFY_ERROR=''
  _usb_unmount "$identifier" >/dev/null 2>&1 || {
    _USB_PAYLOAD_VERIFY_ERROR=unmount-failed
    return 2
  }
  progress_file=$(command /usr/bin/mktemp \
    "${temp_root%/}/compozsh-usb-verify-progress.XXXXXX" 2>/dev/null) || return 2
  meta_file=$(command /usr/bin/mktemp \
    "${temp_root%/}/compozsh-usb-verify-meta.XXXXXX" 2>/dev/null) || {
    command /bin/rm -f -- "$progress_file"
    return 2
  }
  result_file=$(command /usr/bin/mktemp \
    "${temp_root%/}/compozsh-usb-verify-result.XXXXXX" 2>/dev/null) || {
    command /bin/rm -f -- "$progress_file" "$meta_file"
    return 2
  }
  _USB_VERIFY_PROGRESS_FILE=$progress_file
  _USB_VERIFY_META_FILE=$meta_file
  {
    (
      _usb_compare_written_image "$image" "$identifier" "$image_size" \
        "$target_size"
      local compare_status=$?
      print -r -- "scope=$_USB_PAYLOAD_VERIFY_SCOPE"
      print -r -- "error=$_USB_PAYLOAD_VERIFY_ERROR"
      exit $compare_status
    ) >| "$result_file" &
    worker=$!
    while builtin kill -0 $worker 2>/dev/null; do
      _usb_verify_progress_read "$progress_file" "$meta_file" $started
      progress_text=$REPLY
      _usb_progress_stage 'Verifying USB against image' \
        progress "$_USB_VERIFY_PROGRESS_BAR" info "$progress_text" \
        warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
      command /bin/sleep 0.25
    done
    wait $worker
    command_status=$?
    result=$(<"$result_file")
    for line in "${(f)result}"; do
      case $line in
        (scope=*) _USB_PAYLOAD_VERIFY_SCOPE=${line#scope=} ;;
        (error=*) _USB_PAYLOAD_VERIFY_ERROR=${line#error=} ;;
      esac
    done
    [[ $result == *$'scope='* && $result == *$'error='* ]] && result_ready=1
    if (( !result_ready )); then
      command_status=2
      _USB_PAYLOAD_VERIFY_SCOPE=''
      _USB_PAYLOAD_VERIFY_ERROR=drive-read-failed
    fi
  } always {
    if (( worker )) && builtin kill -0 $worker 2>/dev/null; then
      builtin kill -INT $worker 2>/dev/null
      wait $worker 2>/dev/null
    fi
    command /bin/rm -f -- "$progress_file" "$meta_file" "$result_file"
  }
  return $command_status
}

_usb_verify_payload_checksum() {
  emulate -L zsh
  _usb_verify_payload "$1" "$2" "$3" "${5:-$3}"
}

_usb_eject() {
  command /usr/sbin/diskutil eject "/dev/$1"
}

_usb_diskutil_erase_run() {
  command /usr/bin/sudo -n /usr/sbin/diskutil "$@"
}

_usb_macos_prepare_volume() {
  emulate -L zsh
  local identifier=$1 name='' mount_point='' plist='' parent=''
  local -i attempts=0
  REPLY=''
  [[ $identifier == disk<-> ]] || return 2
  while (( ++attempts <= 8 )); do
    name="Compozsh-${identifier}-${RANDOM}"
    [[ ! -e "/Volumes/$name" ]] && break
    name=''
  done
  [[ -n $name ]] || return 1
  _usb_diskutil_erase_run eraseDisk JHFS+ "$name" GPT "/dev/$identifier" \
    >/dev/null 2>&1 || return 1
  mount_point="/Volumes/$name"
  [[ -d $mount_point && ! -L $mount_point ]] || return 1
  _usb_diskutil_plist_capture info -plist "$mount_point" || return 1
  plist=$_USB_PLIST
  _usb_plist_optional "$plist" ParentWholeDisk
  parent=$REPLY
  [[ $parent == "$identifier" ]] || return 1
  REPLY=$mount_point
}

_usb_createinstallmedia_progress_read() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local path=$1 raw='' line='' prefix='' latest='Preparing Apple createinstallmedia…'
  local -i raw_size=0 percent=0 bar_width=32
  bar_width=$(( (${COLUMNS:-80} - 12) / 2 ))
  (( bar_width < 24 )) && bar_width=24
  (( bar_width > 64 )) && bar_width=64
  _usb_progress_bar 0 $bar_width
  _USB_PROGRESS_BAR=$REPLY
  REPLY=$latest
  [[ -f $path ]] || return 0
  raw_size=$(command /usr/bin/stat -f '%z' "$path" 2>/dev/null) || return 0
  (( raw_size > 0 && raw_size <= 1048576 )) || return 0
  raw=$(<"$path")
  raw=${raw//$'\r'/$'\n'}
  for line in "${(f)raw}"; do
    line=${line##[[:space:]]#}
    line=${line%%[[:space:]]#}
    [[ -n $line && ${#line} -le 512 && $line != *[[:cntrl:]]* ]] || continue
    latest=$line
    if [[ $line == *%* ]]; then
      prefix=${line%%\%*}
      prefix=${prefix##*[^0-9]}
      [[ $prefix == <-> ]] && percent=$prefix
    fi
  done
  (( percent > 100 )) && percent=100
  _usb_progress_bar $percent $bar_width
  _USB_PROGRESS_BAR=$REPLY
  REPLY=$latest
}

_usb_createinstallmedia_command_run() {
  emulate -L zsh
  setopt PIPE_FAIL
  local installer=$1 volume=$2 tool=''
  local -a arguments=(--volume "$volume")
  _usb_macos_installer_tool "$installer" || return 1
  tool=$REPLY
  [[ ${installer:t} == 'Install OS X El Capitan.app' ]] &&
    arguments+=(--applicationpath "$installer")
  builtin print -r -- Y | command /usr/bin/sudo -n "$tool" "${arguments[@]}"
}

_usb_createinstallmedia_run() {
  emulate -L zsh
  setopt NO_BG_NICE PIPE_FAIL
  unsetopt MONITOR NOTIFY
  local installer=$1 volume=$2 temp_root=${TMPDIR:-/tmp}
  local progress_file='' progress_text=''
  local -i worker=0 command_status=1
  _USB_CREATEINSTALLMEDIA_ERROR=''
  _usb_macos_installer_tool "$installer" >/dev/null || return 1
  [[ -d $volume && ! -L $volume ]] || return 1
  progress_file=$(command /usr/bin/mktemp \
    "${temp_root%/}/compozsh-createinstallmedia.XXXXXX" 2>/dev/null) || return 1
  {
    _usb_createinstallmedia_command_run "$installer" "$volume" \
      >| "$progress_file" 2>&1 &
    worker=$!
    while builtin kill -0 $worker 2>/dev/null; do
      _usb_createinstallmedia_progress_read "$progress_file"
      progress_text=$REPLY
      _usb_progress_stage 'Creating macOS installer' \
        progress "$_USB_PROGRESS_BAR" info "$progress_text" \
        warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
      command /bin/sleep 0.25
    done
    wait $worker
    command_status=$?
    _usb_createinstallmedia_progress_read "$progress_file"
    progress_text=$REPLY
    _usb_progress_stage 'Creating macOS installer' \
      progress "$_USB_PROGRESS_BAR" info "$progress_text" \
      warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
    (( command_status == 0 )) || _USB_CREATEINSTALLMEDIA_ERROR=$progress_text
  } always {
    if (( worker )) && builtin kill -0 $worker 2>/dev/null; then
      builtin kill -INT $worker 2>/dev/null
      wait $worker 2>/dev/null
    fi
    [[ -n $progress_file && ${progress_file:t} == compozsh-createinstallmedia.* &&
       ${progress_file:h:A} == ${temp_root:A} ]] && command /bin/rm -f -- "$progress_file"
  }
  return $command_status
}

_usb_macos_execute() {
  emulate -L zsh
  local installer=$1 identifier=$2 disk_fingerprint=$3 installer_fingerprint=$4
  local minimum_size=$5 request=$6 source_disk=${7:-} authorized=${8:-0}
  local target_size=${11:-$minimum_size} volume=''
  local -i action_status=0 eject_status=0 execution_started=$SECONDS stage_started=0
  _USB_RESULT_OUTCOME='' _USB_RESULT_ERROR='' _USB_RESULT_RATE=''
  _USB_RESULT_VERIFY_REASON='' _USB_RESULT_VERIFY_SCOPE=''
  _USB_RESULT_BYTES=0 _USB_RESULT_SECONDS=0 _USB_RESULT_WRITE_SECONDS=0
  _USB_RESULT_VERIFY_SECONDS=0 _USB_RESULT_VERIFIED=0 _USB_RESULT_EJECTED=0
  _USB_RESULT_STARTED=0 _USB_RESULT_CHECKSUM_VALIDATED=0
  _USB_RESULT_SOURCE_VALIDATED=0
  [[ $minimum_size == <-> && $target_size == <-> ]] || return 2
  (( target_size >= minimum_size )) || return 2
  [[ $request == flash-verify ]] || return 2
  if [[ -n $source_disk && $identifier == "$source_disk" ]]; then
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The selected drive contains the macOS installer source; nothing was written.'
    return 1
  fi
  _usb_progress_stage 'Validating Apple installer and drive' \
    info 'Checking the installer signature, captured identity, and exact external drive.' \
    muted 'No disk data has been changed yet.'
  (( authorized )) || _usb_authorize || {
    _USB_RESULT_OUTCOME=failed _USB_RESULT_ERROR='Administrator authorization failed; nothing was written.'
    return 1
  }
  _usb_macos_installer_revalidate "$installer" "$installer_fingerprint" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The macOS installer changed, is incomplete, or is not Apple-signed; nothing was written.'
    return 1
  }
  _USB_RESULT_SOURCE_VALIDATED=1
  _usb_target_revalidate "$identifier" "$disk_fingerprint" "$minimum_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive changed or is no longer eligible; nothing was written.'
    return 1
  }
  _usb_progress_stage 'Revalidating exact target' \
    info 'Closing the device-identity race immediately before the first erase.' \
    warning 'NO DISK DATA HAS BEEN CHANGED YET'
  _usb_target_revalidate "$identifier" "$disk_fingerprint" "$minimum_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive changed immediately before preparation; nothing was written.'
    return 1
  }
  _USB_RESULT_STARTED=1
  _usb_progress_stage 'Preparing external drive' \
    info 'Creating one temporary Mac OS Extended volume for Apple createinstallmedia.' \
    warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
  _usb_macos_prepare_volume "$identifier"
  action_status=$?
  volume=$REPLY
  if (( action_status )); then
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='macOS could not prepare the selected whole external drive for createinstallmedia.'
  else
    _usb_macos_installer_revalidate "$installer" "$installer_fingerprint" || {
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR='The macOS installer changed while the drive was being prepared; createinstallmedia was not started.'
    }
    if (( action_status == 0 )); then
      stage_started=$SECONDS
      _usb_createinstallmedia_run "$installer" "$volume"
      action_status=$?
      _USB_RESULT_WRITE_SECONDS=$(( SECONDS - stage_started ))
      if (( action_status )); then
        _USB_RESULT_OUTCOME=failed
        _USB_RESULT_ERROR="Apple createinstallmedia failed${_USB_CREATEINSTALLMEDIA_ERROR:+: $_USB_CREATEINSTALLMEDIA_ERROR}"
      else
        _USB_RESULT_VERIFIED=1
        _USB_RESULT_VERIFY_SCOPE=apple-createinstallmedia
      fi
    fi
  fi
  _usb_progress_stage 'Ejecting external drive' \
    info 'Finishing the operation and making the drive safe to remove.'
  _usb_eject "$identifier" >/dev/null 2>&1
  eject_status=$?
  (( eject_status == 0 )) && _USB_RESULT_EJECTED=1
  _USB_RESULT_SECONDS=$(( SECONDS - execution_started ))
  (( action_status )) && return $action_status
  if (( eject_status )); then
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The macOS installer was created, but macOS could not eject the external drive.'
    return $eject_status
  fi
  _USB_RESULT_OUTCOME=complete
}

_usb_media_execute() {
  emulate -L zsh
  local kind=$1
  shift
  case $kind in
    (raw-image) _usb_execute "$@" ;;
    (macos-installer) _usb_macos_execute "$@" ;;
    (windows-installer)
      _USB_RESULT_OUTCOME=failed _USB_RESULT_STARTED=0
      _USB_RESULT_ERROR='Windows installer media is not supported yet; nothing was written.'
      return 1 ;;
    (*)
      _USB_RESULT_OUTCOME=failed _USB_RESULT_STARTED=0
      _USB_RESULT_ERROR='The selected media handler is unavailable; nothing was written.'
      return 2 ;;
  esac
}

_usb_cleanup_eject() {
  emulate -L zsh
  (( ${_USB_RESULT_STARTED:-0} && !${_USB_RESULT_EJECTED:-0} )) || return 0
  [[ ${_USB_SELECTED_DISK:-} == disk<-> ]] || return 0
  _usb_eject "$_USB_SELECTED_DISK" >/dev/null 2>&1 || return 1
  _USB_RESULT_EJECTED=1
}

_usb_execute() {
  emulate -L zsh
  setopt EXTENDED_GLOB NO_BG_NICE
  unsetopt MONITOR NOTIFY
  local image=$1 identifier=$2 disk_fingerprint=$3 image_fingerprint=$4
  local image_size=$5 request=$6 source_disk=${7:-} authorized=${8:-0}
  local checksum_algorithm=${9:-} expected_checksum=${10:-}
  local target_size=${11:-$image_size}
  local -i action_status=0 eject_status=0 execution_started=$SECONDS stage_started=0
  _USB_RESULT_OUTCOME='' _USB_RESULT_ERROR='' _USB_RESULT_RATE=''
  _USB_RESULT_VERIFY_REASON='' _USB_RESULT_VERIFY_SCOPE=''
  _USB_RESULT_CHECKSUM_ALGORITHM=$checksum_algorithm
  _USB_RESULT_EXPECTED_CHECKSUM=$expected_checksum _USB_RESULT_IMAGE_CHECKSUM=''
  _USB_RESULT_BYTES=0 _USB_RESULT_SECONDS=0 _USB_RESULT_WRITE_SECONDS=0
  _USB_RESULT_VERIFY_SECONDS=0 _USB_RESULT_VERIFIED=0 _USB_RESULT_EJECTED=0
  _USB_RESULT_STARTED=0 _USB_RESULT_CHECKSUM_VALIDATED=0
  [[ $image_size == <-> && $target_size == <-> ]] || return 2
  (( target_size >= image_size )) || return 2
  case $request in
    (flash-verify|flash-only) ;;
    (*) return 2 ;;
  esac
  if [[ -n $expected_checksum ]]; then
    case $checksum_algorithm in
      (256) (( ${#expected_checksum} == 64 )) ;;
      (512) (( ${#expected_checksum} == 128 )) ;;
      (*) return 2 ;;
    esac || return 2
    [[ $expected_checksum == [0-9a-f]## ]] || return 2
  elif [[ -n $checksum_algorithm ]]; then
    return 2
  fi
  if [[ -n $source_disk && $identifier == "$source_disk" ]]; then
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The selected drive contains the image source; nothing was written.'
    return 1
  fi
  _usb_progress_stage 'Validating image and drive' \
    info 'Checking the captured image and external-drive identity before writing.' \
    muted 'No disk data has been changed yet.'
  (( authorized )) || _usb_authorize || {
    _USB_RESULT_OUTCOME=failed _USB_RESULT_ERROR='Administrator authorization failed; nothing was written.'
    return 1
  }
  _usb_image_revalidate "$image" "$image_fingerprint" "$image_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The selected image changed after capture; nothing was written.'
    return 1
  }
  if [[ -n $expected_checksum ]]; then
    _usb_progress_stage "Checking image SHA-$checksum_algorithm" \
      info "Hashing the complete image before any external-drive data is changed." \
      muted "Expected · ${expected_checksum[1,16]}…"
    _usb_image_checksum "$image" "$checksum_algorithm" || {
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR="The image SHA-$checksum_algorithm checksum could not be calculated; nothing was written."
      return 1
    }
    _USB_RESULT_IMAGE_CHECKSUM=$REPLY
    if [[ $REPLY != "$expected_checksum" ]]; then
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR="The image SHA-$checksum_algorithm does not match the provided checksum; nothing was written."
      return 1
    fi
    _USB_RESULT_CHECKSUM_VALIDATED=1
  fi
  _usb_target_revalidate "$identifier" "$disk_fingerprint" "$image_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive changed or is no longer eligible; nothing was written.'
    return 1
  }
  if ! _usb_authorization_valid >/dev/null 2>&1; then
    _usb_progress_stage 'Authorization required for writing' \
      info 'Re-enter the administrator password before the external drive is unmounted or changed.' \
      muted 'No disk data has been changed yet.'
    _usb_authorize || {
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR='Administrator authorization expired before writing; nothing was written.'
      return 1
    }
  fi
  _usb_progress_stage 'Unmounting external drive' \
    info 'Preparing the whole external drive for a raw image write.' \
    warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
  _usb_unmount "$identifier" >/dev/null 2>&1 || {
    _USB_RESULT_OUTCOME=failed _USB_RESULT_ERROR='The external drive could not be unmounted; nothing was written.'
    return 1
  }
  _usb_target_revalidate "$identifier" "$disk_fingerprint" "$image_size" || {
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The external drive changed after unmounting; nothing was written.'
    _usb_eject "$identifier" >/dev/null 2>&1 && _USB_RESULT_EJECTED=1
    return 1
  }
  _USB_RESULT_STARTED=1
  _usb_progress_stage 'Writing image' \
    info 'Starting Apple dd with 4 MiB blocks.' \
    warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
  stage_started=$SECONDS
  _usb_write_image "$image" "$identifier" "$image_size" "$target_size"
  action_status=$?
  _USB_RESULT_WRITE_SECONDS=$(( SECONDS - stage_started ))
  if (( action_status == 0 )); then
    _USB_RESULT_BYTES=$image_size
    _usb_human_size $(( image_size / (_USB_RESULT_WRITE_SECONDS > 0 ? _USB_RESULT_WRITE_SECONDS : 1) ))
    _USB_RESULT_RATE="$REPLY/s"
  else
    _USB_RESULT_OUTCOME=failed
    if (( action_status == 3 )); then
      _USB_RESULT_ERROR="Writing stopped after ${_USB_WRITE_BYTES_OBSERVED:-0} of $image_size bytes; the USB contains an incomplete image and must not be used."
    elif (( action_status == 4 )); then
      _USB_RESULT_ERROR='The image write completed, but old physical-tail partition metadata could not be cleared safely; the USB must not be used.'
    elif [[ -n $_USB_WRITE_ERROR ]]; then
      _USB_RESULT_ERROR="Writing failed: $_USB_WRITE_ERROR. The USB may contain an incomplete image and must not be used."
    else
      _USB_RESULT_ERROR='Writing failed; the USB may contain an incomplete image and must not be used.'
    fi
  fi
  if (( action_status == 0 )); then
    _usb_unmount "$identifier" >/dev/null 2>&1 || {
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR='The image was written, but macOS could not immediately unmount the target for verification.'
    }
  fi
  if (( action_status == 0 )); then
    _usb_image_revalidate "$image" "$image_fingerprint" "$image_size" || {
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR='The selected image changed during writing; the USB must not be used.'
    }
  fi
  if (( action_status == 0 )) && [[ -n $expected_checksum ]]; then
    _usb_progress_stage "Rechecking image SHA-$checksum_algorithm" \
      info 'Confirming the complete source image remained unchanged through the write.' \
      warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
    _usb_image_checksum "$image" "$checksum_algorithm" || {
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR="The image could not be reread after writing; the USB must not be used."
    }
    if (( action_status == 0 )) && [[ $REPLY != "$expected_checksum" ]]; then
      action_status=1
      _USB_RESULT_OUTCOME=failed
      _USB_RESULT_ERROR="The image SHA-$checksum_algorithm changed during writing; the USB must not be used."
    fi
  fi
  if (( action_status == 0 )) && [[ $request == flash-verify ]] &&
      ! _usb_authorization_valid >/dev/null 2>&1; then
    _usb_progress_stage 'Authorization required for verification' \
      info 'The write completed. Re-enter the administrator password to read the finished drive.' \
      warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
    _usb_authorize || {
      action_status=1
      _USB_RESULT_OUTCOME=failed _USB_RESULT_VERIFY_REASON=authorization-expired
      _USB_RESULT_ERROR='Administrator authorization expired before USB verification; the write completed but was not verified.'
    }
  fi
  if (( action_status == 0 )) && [[ $request == flash-verify ]]; then
    _usb_progress_stage 'Verifying USB against image' \
      info 'Reading uncached raw bytes: full image first, then validated boot and installer ranges.' \
      warning 'KEEP THE EXTERNAL DRIVE CONNECTED'
    stage_started=$SECONDS
    if [[ -n $expected_checksum ]]; then
      _usb_verify_payload_checksum "$image" "$identifier" "$image_size" \
        "$checksum_algorithm" "$target_size"
      action_status=$?
    else
      _usb_verify_payload "$image" "$identifier" "$image_size" "$target_size"
      action_status=$?
    fi
    _USB_RESULT_VERIFY_REASON=$_USB_PAYLOAD_VERIFY_ERROR
    _USB_RESULT_VERIFY_SCOPE=$_USB_PAYLOAD_VERIFY_SCOPE
    _USB_RESULT_VERIFY_SECONDS=$(( SECONDS - stage_started ))
    (( action_status == 0 )) && _USB_RESULT_VERIFIED=1 || {
      _USB_RESULT_OUTCOME=failed
      case $_USB_RESULT_VERIFY_REASON in
        (mismatch)
          _USB_RESULT_ERROR='The finished USB installer or boot bytes differ from the selected image.' ;;
        (gpt-invalid)
          _USB_RESULT_ERROR='The finished USB GPT layout or backup partition map is invalid; the drive must not be used.' ;;
        (stale-tail-gpt)
          _USB_RESULT_ERROR='Old GPT metadata remains at the physical end of the USB and conflicts with the flashed image layout; the drive must be reflashed.' ;;
        (drive-read-failed)
          _USB_RESULT_ERROR='The image was written, but the finished USB could not be read completely for verification.' ;;
        (image-read-failed)
          _USB_RESULT_ERROR='The image changed or could not be read completely during finished-drive verification.' ;;
        (unmount-failed)
          _USB_RESULT_ERROR='The image was written, but macOS could not unmount the finished USB for verification.' ;;
        (authorization-expired)
          _USB_RESULT_ERROR='Administrator authorization expired before USB verification; the write completed but was not verified.' ;;
        (*)
          _USB_RESULT_ERROR='Finished-drive verification could not complete; the USB must not be used until it is verified.' ;;
      esac
    }
  fi
  _usb_progress_stage 'Ejecting external drive' \
    info 'Finishing the operation and making the drive safe to remove.'
  _usb_eject "$identifier" >/dev/null 2>&1
  eject_status=$?
  (( eject_status == 0 )) && _USB_RESULT_EJECTED=1
  _USB_RESULT_SECONDS=$(( SECONDS - execution_started ))
  (( action_status )) && return $action_status
  if (( eject_status )); then
    _USB_RESULT_OUTCOME=failed
    _USB_RESULT_ERROR='The image was written, but macOS could not eject the external drive.'
    return $eject_status
  fi
  _USB_RESULT_OUTCOME=complete
}

_usb_result_choose() {
  emulate -L zsh
  _usb_choose "$1" "$2" 'Done' 0 0 1
}

_usb_result_screen() {
  emulate -L zsh
  local result_status=${1:-1} size_label='' duration_label=''
  local verification_label='' eject_label=''
  local -a _USB_PICKER_VALUES=() _USB_PICKER_LABELS=()
  local -a _USB_PICKER_HIGHLIGHTS=()
  local -a _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
  if (( result_status == 0 )) && [[ $_USB_RESULT_OUTCOME == complete ]]; then
    _usb_human_size $_USB_RESULT_BYTES
    size_label=$REPLY
    _usb_human_duration $_USB_RESULT_SECONDS
    duration_label=$REPLY
    if (( _USB_RESULT_VERIFIED )) && [[ $_USB_RESULT_VERIFY_SCOPE == full ]]; then
      verification_label='USB verification · Full image byte-for-byte matched'
    elif (( _USB_RESULT_VERIFIED )) && [[ $_USB_RESULT_VERIFY_SCOPE == boot-and-installer-payload ]]; then
      verification_label='USB verification · Boot bytes and installer payload matched'
    elif (( _USB_RESULT_VERIFIED )); then
      verification_label='USB verification · Selected image bytes matched'
    else
      verification_label='USB verification · Not performed · Flash only'
    fi
    eject_label='Safe to remove · external drive ejected'
    _USB_PICKER_VALUES=(done bytes time)
    _USB_PICKER_LABELS=(
      '[ Done ]'
      "Flash complete · $size_label written"
      "Time · $duration_label · ${_USB_RESULT_RATE:-rate unavailable}")
    _USB_PICKER_HIGHLIGHTS=(
      "0:${#_USB_PICKER_LABELS[1]}:picker-success"
      "0:${#_USB_PICKER_LABELS[2]}:picker-success"
      '')
    _USB_PICKER_SEARCH=(done complete time)
    _USB_PICKER_DETAILS=('' '' '')
    _USB_PICKER_VALUES+=(image-checksum)
    if (( _USB_RESULT_CHECKSUM_VALIDATED )); then
      _USB_PICKER_LABELS+=("Image integrity · Verified · SHA-$_USB_RESULT_CHECKSUM_ALGORITHM matched")
      _USB_PICKER_HIGHLIGHTS+=("0:${#_USB_PICKER_LABELS[-1]}:picker-success")
      _USB_PICKER_SEARCH+=('image integrity checksum matched')
      _USB_PICKER_DETAILS+=("Provided checksum matched"$'\n\n'"SHA-$_USB_RESULT_CHECKSUM_ALGORITHM"$'\n'"$_USB_RESULT_IMAGE_CHECKSUM")
    else
      _USB_PICKER_LABELS+=('Image integrity · Not verified · no checksum provided')
      _USB_PICKER_HIGHLIGHTS+=("0:${#_USB_PICKER_LABELS[-1]}:picker-error")
      _USB_PICKER_SEARCH+=('image integrity not verified no checksum')
      _USB_PICKER_DETAILS+=('No checksum was provided. USB verification establishes fidelity to this local image, but does not establish the local image’s origin.')
    fi
    _USB_PICKER_VALUES+=(verify eject)
    _USB_PICKER_LABELS+=("$verification_label" "$eject_label")
    if (( _USB_RESULT_VERIFIED )); then
      _USB_PICKER_HIGHLIGHTS+=("0:${#verification_label}:picker-success")
    else
      _USB_PICKER_HIGHLIGHTS+=('')
    fi
    _USB_PICKER_HIGHLIGHTS+=("0:${#eject_label}:picker-success")
    _USB_PICKER_SEARCH+=(verified safe)
    case $_USB_RESULT_VERIFY_REASON in
      (gpt-geometry-diff)
        _USB_PICKER_DETAILS+=('Source and target GPT headers, CRCs, partition arrays, and relocated backup map were structurally validated. MBR boot code, boot signature, and every compared installer byte matched; only physical-disk GPT geometry differed.' '') ;;
      (gpt-source-bounds)
        _USB_PICKER_DETAILS+=('The complete image-sized primary and backup GPT structures matched at their original image bounds. The physical tail outside the image was cleared and verified, the hybrid MBR partition records matched, and every compared boot and installer byte matched. Extra drive capacity remains intentionally unused.' '') ;;
      (*) _USB_PICKER_DETAILS+=('' '') ;;
    esac
    _usb_result_choose 'Flash USB · Complete' 'Image  ›  Drive  ›  DONE'
  else
    if (( !_USB_RESULT_STARTED )); then
      eject_label='Nothing was written · drive remains mounted'
    elif (( _USB_RESULT_EJECTED )); then
      eject_label='Safe to remove · external drive ejected'
    else
      eject_label='Check the drive before removing it'
    fi
    _USB_PICKER_VALUES=(done error)
    _USB_PICKER_LABELS=(
      '[ Done ]'
      "Flash failed · ${_USB_RESULT_ERROR:-The operation did not complete.}")
    _USB_PICKER_HIGHLIGHTS=(
      ''
      "0:${#_USB_PICKER_LABELS[2]}:picker-error")
    _USB_PICKER_SEARCH=(done failed)
    _USB_PICKER_DETAILS=('' '')
    _USB_PICKER_VALUES+=(image-integrity)
    if (( _USB_RESULT_CHECKSUM_VALIDATED )); then
      _USB_PICKER_LABELS+=("Image integrity · Verified · SHA-$_USB_RESULT_CHECKSUM_ALGORITHM matched")
      _USB_PICKER_HIGHLIGHTS+=("0:${#_USB_PICKER_LABELS[-1]}:picker-success")
      _USB_PICKER_SEARCH+=('image integrity checksum verified matched')
      _USB_PICKER_DETAILS+=("Provided checksum matched before writing"$'\n\n'"Expected"$'\n'"$_USB_RESULT_EXPECTED_CHECKSUM"$'\n\n'"Actual"$'\n'"$_USB_RESULT_IMAGE_CHECKSUM")
    elif [[ -n $_USB_RESULT_EXPECTED_CHECKSUM ]]; then
      _USB_PICKER_LABELS+=("Image integrity · FAILED · SHA-$_USB_RESULT_CHECKSUM_ALGORITHM did not match")
      _USB_PICKER_HIGHLIGHTS+=("0:${#_USB_PICKER_LABELS[-1]}:picker-error")
      _USB_PICKER_SEARCH+=('image integrity checksum failed expected actual')
      _USB_PICKER_DETAILS+=("Expected"$'\n'"$_USB_RESULT_EXPECTED_CHECKSUM"$'\n\n'"Actual"$'\n'"${_USB_RESULT_IMAGE_CHECKSUM:-unavailable}")
    else
      _USB_PICKER_LABELS+=('Image integrity · Not verified · no checksum provided')
      _USB_PICKER_HIGHLIGHTS+=("0:${#_USB_PICKER_LABELS[-1]}:picker-error")
      _USB_PICKER_SEARCH+=('image integrity not verified no checksum')
      _USB_PICKER_DETAILS+=('The selected local image had no provided checksum. Finished-drive comparison can validate the copy, but cannot establish the image’s origin.')
    fi
    if [[ -n $_USB_RESULT_VERIFY_REASON ]]; then
      _USB_PICKER_VALUES+=(verification-error)
      case $_USB_RESULT_VERIFY_REASON in
        (mismatch)
          _USB_PICKER_LABELS+=('USB verification · FAILED · installer or boot bytes differ') ;;
        (gpt-invalid)
          _USB_PICKER_LABELS+=('USB verification · FAILED · GPT layout is invalid') ;;
        (stale-tail-gpt)
          _USB_PICKER_LABELS+=('USB verification · FAILED · old GPT metadata remains at physical tail') ;;
        (drive-read-failed)
          _USB_PICKER_LABELS+=('USB verification · Could not read the finished drive') ;;
        (image-read-failed)
          _USB_PICKER_LABELS+=('USB verification · Could not reread the selected image') ;;
        (unmount-failed)
          _USB_PICKER_LABELS+=('USB verification · Could not unmount the finished drive') ;;
        (authorization-expired)
          _USB_PICKER_LABELS+=('USB verification · Administrator authorization expired') ;;
        (*)
          _USB_PICKER_LABELS+=('USB verification · Could not complete') ;;
      esac
      _USB_PICKER_HIGHLIGHTS+=("0:${#_USB_PICKER_LABELS[-1]}:picker-error")
      _USB_PICKER_SEARCH+=('usb verification read error recovery')
      _USB_PICKER_DETAILS+=("Verification reason"$'\n'"$_USB_RESULT_VERIFY_REASON"$'\n\n'"${_USB_RESULT_ERROR:-No additional diagnostic was retained.}")
    fi
    _USB_PICKER_VALUES+=(eject)
    _USB_PICKER_LABELS+=("$eject_label")
    if (( _USB_RESULT_EJECTED )); then
      _USB_PICKER_HIGHLIGHTS+=("0:${#eject_label}:picker-success")
    elif (( _USB_RESULT_STARTED )); then
      _USB_PICKER_HIGHLIGHTS+=("0:${#eject_label}:picker-error")
    else
      _USB_PICKER_HIGHLIGHTS+=('')
    fi
    _USB_PICKER_SEARCH+=(recovery)
    _USB_PICKER_DETAILS+=('')
    _usb_result_choose 'Flash USB · Couldn’t complete' 'Image  ›  Drive  ›  FAILED'
  fi
}

_usb_macos_result_screen() {
  emulate -L zsh
  local result_status=${1:-1} duration_label='' eject_label='' source_label=''
  local source_style='picker-error'
  local -a _USB_PICKER_VALUES=() _USB_PICKER_LABELS=()
  local -a _USB_PICKER_HIGHLIGHTS=() _USB_PICKER_SEARCH=() _USB_PICKER_DETAILS=()
  _usb_human_duration $_USB_RESULT_SECONDS
  duration_label=$REPLY
  if (( result_status == 0 )) && [[ $_USB_RESULT_OUTCOME == complete ]]; then
    eject_label='Safe to remove · external drive ejected'
    _USB_PICKER_VALUES=(done complete time source eject)
    _USB_PICKER_LABELS=(
      '[ Done ]'
      'macOS installer complete · Apple createinstallmedia succeeded'
      "Time · $duration_label"
      'Source validation · Verified · Apple-signed full installer'
      "$eject_label")
    _USB_PICKER_HIGHLIGHTS=(
      "0:${#_USB_PICKER_LABELS[1]}:picker-success"
      "0:${#_USB_PICKER_LABELS[2]}:picker-success"
      ''
      "0:${#_USB_PICKER_LABELS[4]}:picker-success"
      "0:${#eject_label}:picker-success")
    _USB_PICKER_SEARCH=(done complete time apple safe)
    _USB_PICKER_DETAILS=(
      ''
      'Apple createinstallmedia completed successfully and reported the bootable installer as available.'
      ''
      'The installer application and its createinstallmedia executable passed Apple signature validation before the target was erased.'
      '')
    _usb_result_choose 'Flash USB · Complete' 'Media  ›  Drive  ›  DONE'
    return
  fi
  if (( !_USB_RESULT_STARTED )); then
    eject_label='Nothing was written · drive remains mounted'
  elif (( _USB_RESULT_EJECTED )); then
    eject_label='Safe to remove · external drive ejected'
  else
    eject_label='Check the drive before removing it'
  fi
  if (( _USB_RESULT_SOURCE_VALIDATED )); then
    source_label='Source validation · Verified before preparation · Apple-signed installer'
    source_style=picker-success
  else
    source_label='Source validation · FAILED · installer was not accepted'
  fi
  _USB_PICKER_VALUES=(done error source eject)
  _USB_PICKER_LABELS=(
    '[ Done ]'
    "macOS installer failed · ${_USB_RESULT_ERROR:-The operation did not complete.}"
    "$source_label"
    "$eject_label")
  _USB_PICKER_HIGHLIGHTS=(
    '' "0:${#_USB_PICKER_LABELS[2]}:picker-error"
    "0:${#source_label}:$source_style" '')
  (( _USB_RESULT_EJECTED )) &&
    _USB_PICKER_HIGHLIGHTS[4]="0:${#eject_label}:picker-success"
  (( _USB_RESULT_STARTED && !_USB_RESULT_EJECTED )) &&
    _USB_PICKER_HIGHLIGHTS[4]="0:${#eject_label}:picker-error"
  _USB_PICKER_SEARCH=(done failed source recovery)
  _USB_PICKER_DETAILS=('' "${_USB_RESULT_ERROR:-No additional diagnostic was retained.}" '' '')
  _usb_result_choose 'Flash USB · Couldn’t complete' 'Media  ›  Drive  ›  FAILED'
}

_usb_media_result_screen() {
  case $1 in
    (macos-installer) _usb_macos_result_screen "$2" ;;
    (*) _usb_result_screen "$2" ;;
  esac
}

_usb_progress_controller() {
  emulate -L zsh
  local -i execution_status=0
  _usb_media_execute "${_USB_SELECTED_MEDIA_KIND:-raw-image}" \
    "$_USB_SELECTED_IMAGE" "$_USB_SELECTED_DISK" \
    "$_USB_SELECTED_DISK_FINGERPRINT" "$_USB_SELECTED_IMAGE_FINGERPRINT" \
    "$_USB_SELECTED_IMAGE_SIZE" "$_USB_REQUEST" "$_USB_SELECTED_SOURCE_DISK" 1 \
    "$_USB_SELECTED_CHECKSUM_ALGORITHM" "$_USB_SELECTED_CHECKSUM" \
    "$_USB_SELECTED_DISK_SIZE"
  execution_status=$?
  _usb_media_result_screen "${_USB_SELECTED_MEDIA_KIND:-raw-image}" $execution_status
  return $execution_status
}

_usb_confirmation_prompt() {
  emulate -L zsh
  local expected=$1 color='' style='' reset=$'\e[0m'
  REPLY="Type exactly $expected to continue: "
  [[ -t 0 && -t 2 && -n $TERM && $TERM != dumb && -z ${NO_COLOR:-} ]] || return 0
  zmodload -F zsh/terminfo p:terminfo 2>/dev/null || return 0
  (( ${terminfo[colors]:-0} >= 256 )) || return 0
  if (( ${+functions[_output_color]} )); then
    _output_color warning 221
    color=$REPLY
  elif [[ ${(t)ZSH_OUTPUT_COLORS} == association* &&
          ${ZSH_OUTPUT_COLORS[warning]:-} == <0-255> ]]; then
    color=${ZSH_OUTPUT_COLORS[warning]}
  fi
  [[ $color == <0-255> ]] || {
    REPLY="Type exactly $expected to continue: "
    return 0
  }
  style=$'\e[1;38;5;'"${color}m"
  REPLY="Type exactly ${style}${expected}${reset} to continue: "
}

_usb_confirm() {
  emulate -L zsh
  local image=$1 identifier=$2 disk_label=$3 request=$4
  local checksum_algorithm=${5:-} checksum=${6:-} answer=''
  local expected="ERASE $identifier"
  _USB_CONFIRM_ERROR=''
  if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} == macos-installer ]]; then
    print -r -- "Installer: $image"
  else
    print -r -- "Image:  $image"
  fi
  print -r -- "Target: $disk_label"
  if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} != macos-installer &&
        -n ${_USB_SELECTED_IMAGE_ARCHITECTURE:-} ]]; then
    _usb_image_architecture_short_label "$_USB_SELECTED_IMAGE_ARCHITECTURE"
    print -r -- "Image architecture: $REPLY"
  fi
  if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} == macos-installer ]]; then
    print -r -- 'Source validation: Apple-signed full macOS installer'
    print -r -- 'Action: Prepare the whole drive, run Apple createinstallmedia, and eject'
    print -r -- 'Apple createinstallmedia will erase and format the selected external drive.'
  elif [[ -n $checksum ]]; then
    print -r -- "Checksum: SHA-$checksum_algorithm · $checksum"
  else
    print -r -- 'Checksum: Not provided'
  fi
  if [[ ${_USB_SELECTED_MEDIA_KIND:-raw-image} == macos-installer ]]; then
    :
  elif [[ $request == flash-verify && -n $checksum ]]; then
    print -r -- "Action: Validate image SHA-$checksum_algorithm, flash, verify payload SHA-$checksum_algorithm, and eject"
  elif [[ $request == flash-verify ]]; then
    print -r -- 'Action: Flash, verify payload, and eject'
  elif [[ -n $checksum ]]; then
    print -r -- "Action: Validate image SHA-$checksum_algorithm, flash without read-back verification, and eject"
  else
    print -r -- 'Action: Flash and eject without verification'
  fi
  print -r -- 'This can permanently destroy every existing partition and all data on the selected drive.'
  _usb_confirmation_prompt "$expected"
  IFS= read -r "answer?$REPLY" || {
    _USB_CONFIRM_ERROR='Confirmation was not completed.'
    return 1
  }
  [[ $answer == "$expected" ]] || {
    _USB_CONFIRM_ERROR="Confirmation did not match. Expected exactly: $expected"
    return 1
  }
}

_compozsh_help_flash-usb() {
  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" 'usage: flash-usb [media]' \
    'Open a native workspace that creates bootable external installation media.' \
    '' \
    'Image capture:' \
    '  An explicit path selects one readable regular .iso or .img file, or a' \
    '  full Install macOS application containing Apple createinstallmedia.' \
    '  With no path, Step 1 merges up to 500 Finder-indexed matches beneath ~' \
    '  with shallow current-folder and ~/Downloads captures of up to 200 each.' \
    '  The direct captures help include fresh files Spotlight has not indexed.' \
    '  Results are a bounded snapshot: Spotlight exclusions, indexing delay, or' \
    '  the limit can omit images. Discovery never follows symbolic links.' \
    '  Images are ordered by creation time, newest first, falling back to' \
    '  modification time when creation time is unavailable. Ordering never' \
    '  accepts an image automatically; every run requires explicit selection.' \
    '  Step 1 Ctrl-R replaces the snapshot with a fresh Spotlight capture under' \
    '  ~ plus fresh shallow current-folder and ~/Downloads reads. It retains the' \
    '  active filter and exact selected image while that image remains available.' \
    '  A completed download can therefore appear without restarting flash-usb' \
    '  or waiting for Spotlight to index it.' \
    '  Step 1 keeps Custom path first and shows captured format, size, creation,' \
    '  modification, filename-derived architecture, and exact path details.' \
    '  Recognized AMD64/x86_64 and ARM64/aarch64 names receive equal passive' \
    '  architecture labels in image, review, confirmation, and progress context.' \
    '  No architecture adds an interruption. Unknown names remain explicitly' \
    '  undetected; the Mac writing the USB does not determine installer architecture.' \
    '  Custom path' \
    '  opens a bounded browser at ~/. Left moves to the parent; Right or Return' \
    '  opens a folder, and Return on a visible .iso or .img selects it.' \
    '  Typing refines the current folder with prefix, substring, then in-order' \
    '  fuzzy matching, consistent with Compozsh Tab path navigation.' \
    '  For Finder drag and drop, type flash-usb followed by a space, drop the' \
    '  image into Terminal, and press Return. Custom path also offers a literal' \
    '  drop/paste field for files outside the visible folder.' \
    '  Dropped text is decoded as a path without evaluating shell commands.' \
    '  If macOS asks for Removable Volumes access, granting it keeps the screen' \
    '  context; Enter on Retry performs a fresh read-only source/target capture.' \
    '  Installed macOS installers in /Applications and ~/Applications are also' \
    '  captured. A macOS .dmg or .pkg must first install the full application.' \
    '  ISO selection performs a temporary read-only inspection. Recognized' \
    '  Windows setup media is refused before target selection because Windows' \
    '  requires a filesystem-aware handler that is not shipped yet.' \
    '' \
    'Target capture:' \
    '  diskutil supplies currently attached whole external physical disks.' \
    '  Native plist captures are limited to 1 MiB, 4,096 device entries, and' \
    '  64 whole external-disk candidates per refresh.' \
    '  The workspace excludes internal, virtual, read-only, partition-slice,' \
    '  and undersized targets. USB, Thunderbolt, and other external transports' \
    '  are eligible; protocol, media name, exact /dev/diskN, and size are shown.' \
    '  The parent whole disk containing the selected image is also excluded, so' \
    '  a target can never destroy its own source during dd.' \
    '  Step 2 Ctrl-R performs a fresh target capture without losing the selected' \
    '  image, including after a newly connected drive becomes available.' \
    '  A drive macOS ejected can remain physically plugged in while absent from' \
    '  diskutil. Ctrl-R cannot reactivate it: unplug and reconnect the drive, or' \
    '  power-cycle its hub, then press Ctrl-R or Enter to capture it again.' \
    '' \
    'Actions:' \
    '  Step 2 selects one exact eligible external drive. Step 3 reviews media,' \
    '  drive, optional checksum, and mode; Flash & verify is the default.' \
    '  Add image checksum accepts one SHA-256 or SHA-512 digest as bare hex,' \
    '  standard shasum output, or a BSD SHA line. Step 3 immediately hashes the' \
    '  complete image and shows Verified, mismatch, or read failure; a failed' \
    '  integrity check cannot start flashing. With no checksum, Step 3 says the' \
    '  image is not verified. Selecting another image clears' \
    '  the checksum so it cannot silently carry across image context.' \
    '  The complete integrity row uses the shared bold error red when unverified' \
    '  or failed, and the shared bold success green after a checksum matches.' \
    '  An exact typed' \
    '  ERASE diskN confirmation is required. A mismatch reports the exact' \
    '  expected phrase and writes nothing.' \
    '  Supported 256-color terminals highlight that phrase with the shared' \
    '  warning color; NO_COLOR and unsupported terminals keep it plain.' \
    '  Compozsh then requests sudo, revalidates the image and target identity,' \
    '  unmounts the whole disk, revalidates the target again, and' \
    '  writes through /dev/rdiskN with Apple’s dd using 512-byte input sectors' \
    '  aggregated into 4 MiB output blocks. The captured sector count bounds the' \
    '  read. Before that write, up to 33 final sectors outside the image extent' \
    '  are zeroed so an old whole-disk backup GPT cannot conflict with the new' \
    '  raw-image layout. The final transferred-byte count must equal the captured size.' \
    '  Apple dd supplies exact bytes once per second for a determinate progress' \
    '  bar. Step 3 uses a dedicated status view with no query or bottom footer:' \
    '  the active stage, image, target, progress, and disconnect warning remain' \
    '  together near the top with semantic heading, success, and warning colors.' \
    '  Verification also reports its current comparison pass, bytes read, total,' \
    '  percentage, and elapsed time. Large raw ranges use aligned 4 MiB reads;' \
    '  small structural probes remain sector-precise. Validation, unmount,' \
    '  verification, and eject remain named stages.' \
    '  The raw handler does not pre-format the target.' \
    '  Full macOS installer applications use a separate handler. It validates' \
    '  the Apple code signature, revalidates the installer and target, prepares' \
    '  one Mac OS Extended volume on the selected whole disk, and invokes the' \
    '  installer’s createinstallmedia tool with live native progress. Apple’s' \
    '  tool performs the bootable-media creation; the result is then ejected.' \
    '  The source identity is checked again after writing; a provided full-image' \
    '  digest is also recalculated. If sudo expires during a long write, a named' \
    '  authorization stage appears before noninteractive read-back commands.' \
    '  Flash only skips the read-back comparison. Both actions eject afterward;' \
    '  an eject is also attempted after a write or verification failure.' \
    '  A final screen remains until Done and reports bytes, duration, average' \
    '  write rate, image-integrity status, USB verification scope,' \
    '  and whether the drive is safe to remove.' \
    '' \
    'Verification boundary:' \
    '  Uncached raw reads first compare every image byte, including boot metadata.' \
    '  A hybrid GPT may remain fully source-bounded inside the image extent or use' \
    '  a coherent backup header relocated to the physical final LBA. The fallback' \
    '  validates both source and applicable target primary and backup headers,' \
    '  their CRCs, reciprocal' \
    '  LBAs, disk GUID, bounded entry geometry, and matching partition arrays.' \
    '  Relocated backup entries may end anywhere before their header as GPT permits.' \
    '  Source-bounded layouts additionally require the cleared physical tail to' \
    '  remain zero. MBR boot bytes 0–439, reserved bytes and partition records' \
    '  444–509, the signature at 510–511, and every compared installer byte must' \
    '  match; only the independent four-byte MBR disk identifier may differ.' \
    '  A non-GPT image receives no metadata exemption: any full-image difference' \
    '  fails. The final screen reports the narrower GPT proof without claiming' \
    '  full-image equality. The immediate post-write unmount reduces auto-mount' \
    '  exposure, but stock macOS CLI tools cannot reserve the disk against a mount' \
    '  already in progress. Any resulting filesystem-byte difference fails closed;' \
    '  a mismatch alone does not prove whether media, writing, or mounting caused it.' \
    '  Read errors are never called mismatches.' \
    '' \
    'Requirements and recovery:' \
    '  Requires macOS, an interactive terminal, the .zsh.editor screen peer,' \
    '  and Apple’s diskutil, plutil, hdiutil, codesign, df, mktemp, rmdir, rm,' \
    '  sleep, cat, dd, cmp, cksum, head, od, tr, shasum, stat, and sudo tools.' \
    '  Apple mdfind supplies the indexed home catalog; if it fails, the shallow' \
    '  current-folder and Downloads snapshot plus Custom path remain available.' \
    '  A failed or interrupted write can leave the target unusable until it is' \
    '  rewritten or reformatted. Compozsh cannot roll back overwritten bytes.' \
    '' \
    'Examples:' \
    '  flash-usb                         Choose a captured image and target.' \
    '  flash-usb ~/Downloads/Linux.iso  Select this exact raw image.' \
    '  flash-usb "/Applications/Install macOS Tahoe.app"  Use Apple’s handler.'
}

unalias flash-usb 2>/dev/null
flash-usb() {
  emulate -L zsh
  local explicit=${1:-} picker_status=0 capture_status=0 progress_status=0
  local _USB_REQUEST='' _USB_WORKSPACE_ERROR=''
  local _USB_SELECTED_IMAGE='' _USB_SELECTED_DISK=''
  local _USB_SELECTED_MEDIA_KIND=raw-image
  local _USB_SELECTED_SOURCE_DISK=''
  local _USB_SELECTED_IMAGE_ARCHITECTURE=''
  local _USB_SELECTED_IMAGE_FINGERPRINT='' _USB_SELECTED_DISK_FINGERPRINT=''
  local _USB_SELECTED_DISK_LABEL=''
  local _USB_SELECTED_CHECKSUM='' _USB_SELECTED_CHECKSUM_ALGORITHM=''
  local _USB_RESULT_OUTCOME='' _USB_RESULT_ERROR='' _USB_RESULT_RATE=''
  local _USB_RESULT_CHECKSUM_ALGORITHM='' _USB_RESULT_EXPECTED_CHECKSUM=''
  local _USB_RESULT_IMAGE_CHECKSUM=''
  local -i _USB_RESULT_BYTES=0 _USB_RESULT_SECONDS=0
  local -i _USB_RESULT_WRITE_SECONDS=0 _USB_RESULT_VERIFY_SECONDS=0
  local -i _USB_RESULT_VERIFIED=0 _USB_RESULT_EJECTED=0 _USB_RESULT_STARTED=0
  local -i _USB_RESULT_CHECKSUM_VALIDATED=0
  local -i _USB_RESULT_SOURCE_VALIDATED=0
  local -i _USB_SELECTED_IMAGE_SIZE=0
  local -i _USB_SELECTED_DISK_SIZE=0

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_flash-usb
    return 0
  fi
  (( $# <= 1 )) || {
    print -u2 -r -- 'usage: flash-usb [media]'
    return 2
  }
  {
    [[ $OSTYPE == darwin* ]] || {
      print -u2 -r -- 'flash-usb: this workspace requires macOS'
      return 1
    }
    [[ -x /usr/sbin/diskutil && -x /usr/bin/plutil && -x /bin/df &&
       -x /usr/bin/mktemp && -x /bin/rm && -x /bin/sleep && -x /bin/dd &&
       -x /bin/cat && -x /usr/bin/cmp && -x /usr/bin/cksum &&
       -x /usr/bin/head && -x /usr/bin/od && -x /usr/bin/tr &&
       -x /usr/bin/shasum && -x /usr/bin/stat && -x /usr/bin/sudo &&
       -x /usr/bin/hdiutil && -x /usr/bin/codesign && -x /bin/rmdir ]] || {
      print -u2 -r -- 'flash-usb: required Apple command-line tools are unavailable'
      return 1
    }
    if [[ ! -t 0 || ! -t 1 || $TERM == dumb ]] ||
        (( ! ${+functions[_zle_picker_run]} )); then
      print -u2 -r -- 'flash-usb: an interactive terminal and the .zsh.editor screen peer are required'
      return 1
    fi
    _usb_images_capture "$explicit"
    capture_status=$?
    (( capture_status == 0 )) || {
      print -u2 -r -- "flash-usb: ${_USB_CAPTURE_ERROR:-cannot capture the image}"
      return $capture_status
    }
    _zle_picker_run 20 '' 1 0 _usb_workspace_controller
    picker_status=$?
    (( picker_status == 1 )) && return 0
    if (( picker_status != 0 )); then
      [[ -n $_USB_WORKSPACE_ERROR ]] && print -u2 -r -- "flash-usb: $_USB_WORKSPACE_ERROR"
      return $picker_status
    fi
    _usb_confirm "$_USB_SELECTED_IMAGE" "$_USB_SELECTED_DISK" \
      "$_USB_SELECTED_DISK_LABEL" "$_USB_REQUEST" \
      "$_USB_SELECTED_CHECKSUM_ALGORITHM" "$_USB_SELECTED_CHECKSUM" || {
      [[ -n $_USB_CONFIRM_ERROR ]] && print -r -- "$_USB_CONFIRM_ERROR"
      print -r -- 'Cancelled; nothing was written.'
      return 0
    }
    _usb_authorize || {
      print -u2 -r -- 'flash-usb: administrator authorization failed; nothing was written'
      return 1
    }
    _zle_picker_run 20 '' 1 0 _usb_progress_controller
    progress_status=$?
    return $progress_status
  } always {
    _usb_cleanup_eject
    _USB_IMAGE_PATHS=() _USB_IMAGE_LABELS=() _USB_IMAGE_DETAILS=()
    _USB_IMAGE_HIGHLIGHTS=()
    _USB_IMAGE_SIZES=() _USB_IMAGE_FINGERPRINTS=()
    _USB_IMAGE_CREATED=() _USB_IMAGE_MODIFIED=()
    _USB_IMAGE_KINDS=()
    _USB_DISK_IDS=() _USB_DISK_LABELS=() _USB_DISK_DETAILS=()
    _USB_DISK_SIZES=() _USB_DISK_FINGERPRINTS=()
    _USB_CAPTURE_ERROR='' _USB_PLIST=''
    _USB_CONFIRM_ERROR=''
    _USB_IMAGE_CAPTURE_SCOPE='' _USB_IMAGE_CAPTURE_PARTIAL=0
    _USB_IMAGE_DEVICE='' _USB_IMAGE_SOURCE_DISK=''
    _USB_MEDIA_ERROR='' _USB_INSPECT_DEVICE='' _USB_INSPECT_MOUNT=''
    _USB_CREATEINSTALLMEDIA_ERROR=''
    _USB_RESULT_OUTCOME='' _USB_RESULT_ERROR='' _USB_RESULT_RATE=''
    _USB_RESULT_BYTES=0 _USB_RESULT_SECONDS=0
    _USB_RESULT_WRITE_SECONDS=0 _USB_RESULT_VERIFY_SECONDS=0
    _USB_RESULT_VERIFIED=0 _USB_RESULT_EJECTED=0 _USB_RESULT_STARTED=0
    _USB_RESULT_SOURCE_VALIDATED=0
  }
}
