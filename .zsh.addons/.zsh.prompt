# -----------------------------------------------------------------------------
# Prompt
# -----------------------------------------------------------------------------

zmodload zsh/datetime
zmodload -F zsh/stat b:zstat

# Appearance owns defaults; this consumer preserves explicit public roles.
typeset -gA ZSH_PROMPT_COLORS

# Resolve current public roles without installing defaults. A missing appearance
# peer leaves native text; malformed values never enter prompt expansion.
_prompt_color() {
  emulate -L zsh
  local role=$1 value=''
  if [[ ${(t)ZSH_PROMPT_COLORS} == association* ]]; then
    value=${ZSH_PROMPT_COLORS[$role]-}
  fi
  if [[ $value != <0-255> && ${(t)_COMPOZSH_COLOR_FALLBACKS} == association* ]]; then
    value=${_COMPOZSH_COLOR_FALLBACKS[prompt:$role]-}
  fi
  REPLY=''
  [[ $value == <0-255> ]] || return 1
  REPLY=$value
}

_prompt_color_text() {
  local text=$2
  if _prompt_color "$1"; then
    REPLY="%F{${REPLY}}${text}%f"
  else
    REPLY=$text
  fi
}

# One semantic role for the Interaction capsule header and its connecting rail.
_prompt_interaction_color_role() {
  case $_PROMPT_INTERACTION_KIND in
    caution) REPLY=danger ;;
    ready) REPLY=success ;;
    git) REPLY=git ;;
    navigate) REPLY=path ;;
    environment) REPLY=environment ;;
    build|test) REPLY=tool ;;
    *) REPLY=info ;;
  esac
}

# The active prompt has three presentations of one captured snapshot. Compact
# is the private state behind the live Interaction lens, lens expands Context,
# and transcript is the fixed prefix painted by zle-line-finish immediately
# before acceptance.
_prompt_base() {
  emulate -L zsh
  local symbol=${_PROMPT_SYMBOL_COLOR:-default} frame=''

  [[ $_PROMPT_VIEW == transcript ]] && return 0

  _PROMPT_INPUT_SEGMENT="%F{${symbol}}❯%f "
  RPROMPT=''
  if (( LINES == 1 )); then
    PROMPT=$_PROMPT_INPUT_SEGMENT
    return 0
  fi
  if [[ $_PROMPT_VIEW == lens && -n $_PROMPT_LENS_SEGMENT ]]; then
    PROMPT="${_PROMPT_LENS_SEGMENT}"$'\n'"${_PROMPT_INPUT_SEGMENT}"
  elif (( _PROMPT_INTERACTION_ACTIVE )) &&
       [[ -n $_PROMPT_INTERACTION_SEGMENT ]]; then
    _prompt_interaction_color_role
    _prompt_color_text "$REPLY" '╰─'
    frame=$REPLY
    _PROMPT_INPUT_SEGMENT="${frame} %F{${symbol}}❯%f "
    PROMPT="${_PROMPT_INTERACTION_SEGMENT}"$'\n'"${_PROMPT_INPUT_SEGMENT}"
  else
    PROMPT="${_PROMPT_CONTEXT_SEGMENT}"$'\n'"${_PROMPT_INPUT_SEGMENT}"
  fi
}

if (( ${+_PROMPT_COMMAND_STARTED} )); then
  typeset -gF _PROMPT_COMMAND_STARTED
else
  typeset -gF _PROMPT_COMMAND_STARTED=0
fi
# Legacy segment names remain private compatibility surfaces for focused tests
# and existing internal callers; the unified context renderer composes them.
typeset -g _PROMPT_EXIT_SEGMENT=''
typeset -g _PROMPT_TIME_SEGMENT=''
typeset -g _PROMPT_ENV_SEGMENT=''
typeset -g _PROMPT_ENV_TEXT=''
typeset -g _PROMPT_ENV_KEY=''
typeset -g _PROMPT_GIT_SEGMENT=''
typeset -g _PROMPT_GIT_TEXT=''
typeset -g _PROMPT_GIT_COLOR=''
typeset -g _PROMPT_GIT_BRANCH_TEXT=''
typeset -g _PROMPT_GIT_UPSTREAM_TEXT=''
typeset -g _PROMPT_GIT_OPERATION_TEXT=''
typeset -g _PROMPT_GIT_ATTENTION=''
typeset -g _PROMPT_PATH_SEGMENT=''
typeset -g _PROMPT_PATH_TEXT=''
typeset -g _PROMPT_FULL_PATH_TEXT=''
typeset -g _PROMPT_PROJECT_SEGMENT=''
typeset -g _PROMPT_PROJECT_NAME_TEXT=''
typeset -g _PROMPT_PROJECT_ROOT_TEXT=''
typeset -g _PROMPT_PROJECT_ATTENTION=''
typeset -g _PROMPT_IDENTITY_TEXT=''
typeset -g _PROMPT_SESSION_TEXT=''
typeset -g _PROMPT_JOBS_TEXT=''
typeset -g _PROMPT_SYMBOL_COLOR=''
typeset -g _PROMPT_CONTEXT_SEGMENT=''
typeset -g _PROMPT_LENS_SEGMENT=''
typeset -g _PROMPT_INTERACTION_SEGMENT=''
typeset -g _PROMPT_INPUT_SEGMENT=''
typeset -g _PROMPT_VIEW=compact
typeset -g _PROMPT_LENS_REASON=''
typeset -gi _PROMPT_LENS_PINNED=0
typeset -gi _PROMPT_INTERACTION_ACTIVE=0
typeset -g _PROMPT_INTERACTION_KIND=ready
typeset -ga _PROMPT_INTERACTION_LABELS=()
typeset -ga _PROMPT_INTERACTION_VALUES=()
typeset -ga _PROMPT_INTERACTION_ROLES=()
if (( ${+_PROMPT_LAST_OUTCOME_TEXT} )); then
  typeset -g _PROMPT_LAST_OUTCOME_TEXT
  typeset -g _PROMPT_LAST_OUTCOME_ROLE
else
  typeset -g _PROMPT_LAST_OUTCOME_TEXT=''
  typeset -g _PROMPT_LAST_OUTCOME_ROLE=''
fi
typeset -gi _PROMPT_CONTEXT_READY=0
typeset -g _PROMPT_LAST_PROJECT_ROOT=''
typeset -g _PROMPT_LAST_GIT_BRANCH=''
typeset -g _PROMPT_LAST_ENVIRONMENT=''
typeset -g _PROMPT_LAST_GIT_ATTENTION=''
typeset -g _PROMPT_LAST_PROJECT_ATTENTION=''
typeset -gi _PROMPT_TOP_BASE_WIDTH=0
typeset -ga _PROMPT_PROJECT_ITEMS=()
typeset -ga _PROMPT_PROJECT_ITEM_WIDTHS=()
typeset -gA _PROMPT_RUNTIME_VERSION_CACHE=()
typeset -gA _PROMPT_GIT_DIR_CACHE=()
# Replace terminal control characters before displaying text from paths,
# repositories, tools, or custom hooks.
_prompt_sanitize() {
  REPLY=${1//[[:cntrl:]]/?}
}

# Sanitize dynamic text and preserve it literally through any prompt options the
# user enabled. PROMPT_SUBST would otherwise make draft `$()` or backticks
# executable when ZLE paints the prompt; PROMPT_BANG would rewrite `!`.
_prompt_escape() {
  _prompt_sanitize "$1"
  if [[ -o promptsubst ]]; then
    REPLY=${REPLY//\\/\\\\}
    REPLY=${REPLY//\$/\\\$}
    REPLY=${REPLY//\`/\\\`}
  fi
  [[ -o promptbang ]] && REPLY=${REPLY//\!/!!}
  REPLY=${REPLY//\%/%%}
}

# Abbreviate text to a visible width while preserving useful context at both
# ends. "head" favors the beginning; "tail" favors the end.
_prompt_abbreviate() {
  emulate -L zsh
  setopt localoptions multibyte
  local text=$1 bias=${3:-tail} marker='…'
  local prefix='' suffix='' char=''
  local -i max_width=$2 total_width=${(m)#text}
  local -i content_width=0 left_width=0 right_width=0
  local -i used=0 char_width=0 index=0 char_count=${#text}

  if (( max_width <= 0 )); then
    REPLY=''
    return
  fi
  if (( total_width <= max_width )); then
    REPLY=$text
    return
  fi
  if (( max_width < 5 )); then
    REPLY=$marker
    return
  fi

  content_width=$(( max_width - ${(m)#marker} ))
  if [[ $bias == head ]]; then
    left_width=$(( content_width * 2 / 3 ))
  else
    left_width=$(( content_width / 3 ))
  fi
  right_width=$(( content_width - left_width ))

  for (( index = 1; index <= char_count; index++ )); do
    char=$text[index]
    char_width=${(m)#char}
    (( used + char_width <= left_width )) || break
    prefix+=$char
    (( used += char_width ))
  done

  used=0
  for (( index = char_count; index >= 1; index-- )); do
    char=$text[index]
    char_width=${(m)#char}
    (( used + char_width <= right_width )) || break
    suffix=$char$suffix
    (( used += char_width ))
  done
  # If a wide base character missed the suffix boundary, do not leave its
  # leading zero-width combining marks attached to the ellipsis.
  while [[ -n $suffix ]]; do
    char=$suffix[1]
    (( ${(m)#char} == 0 )) || break
    suffix=$suffix[2,-1]
  done
  REPLY="${prefix}${marker}${suffix}"
}

# Keep only a bounded visible prefix. This is used for an already-painted
# autosuggestion: preserving its distant tail would disclose history text that
# ZLE has not otherwise revealed beside the current BUFFER.
_prompt_prefix_abbreviate() {
  emulate -L zsh
  setopt localoptions multibyte
  local text=$1 marker='…' prefix='' char=''
  local -i max_width=$2 total_width=${(m)#text}
  local -i content_width=0 used=0 char_width=0 index=0

  if (( max_width <= 0 )); then
    REPLY=''
    return
  fi
  if (( total_width <= max_width )); then
    REPLY=$text
    return
  fi
  if (( max_width <= ${(m)#marker} )); then
    REPLY=$marker
    return
  fi

  content_width=$(( max_width - ${(m)#marker} ))
  for (( index = 1; index <= ${#text}; index++ )); do
    char=$text[index]
    char_width=${(m)#char}
    (( used + char_width <= content_width )) || break
    prefix+=$char
    (( used += char_width ))
  done
  REPLY="${prefix}${marker}"
}

# Called by custom project-context functions to append a safe, colored item.
prompt_add_project_segment() {
  emulate -L zsh
  setopt localoptions multibyte
  (( $# >= 1 )) || return 2
  local text=$1 color=${2:-} rendered='' safe_text=''

  # A custom color becomes prompt syntax, so accept only the bounded numeric
  # palette contract and Zsh's fixed basic color names. Malformed extension
  # input falls back through the same validated role as an omitted color.
  if [[ -z $color ||
        $color != (<0-255>|black|red|green|yellow|blue|magenta|cyan|white|default) ]]; then
    _prompt_color tool || :
    color=$REPLY
  fi

  _prompt_escape "$text"
  rendered=$REPLY
  [[ -n $color ]] && rendered="%F{${color}}${rendered}%f"
  _PROMPT_PROJECT_EXTRA_SEGMENTS+=("$rendered")
  _prompt_sanitize "$text"
  safe_text=$REPLY
  _PROMPT_PROJECT_EXTRA_WIDTHS+=("${(m)#safe_text}")
  REPLY=$rendered
}

_prompt_git_operation() {
  local git_dir=$1

  if [[ -f "$git_dir/MERGE_HEAD" ]]; then
    REPLY='merge'
  elif [[ -f "$git_dir/CHERRY_PICK_HEAD" ]]; then
    REPLY='cherry-pick'
  elif [[ -f "$git_dir/REVERT_HEAD" ]]; then
    REPLY='revert'
  elif [[ -f "$git_dir/BISECT_LOG" ]]; then
    REPLY='bisect'
  elif [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]; then
    REPLY='rebase'
  else
    REPLY=''
  fi
}

# Avoid launching Git in ordinary directories. Standard repositories,
# submodules, and linked worktrees all expose a .git directory or file in an
# ancestor; explicit Git environments still defer discovery to Git itself.
_prompt_has_git_context() {
  emulate -L zsh

  [[ -n ${GIT_DIR:-} || -n ${GIT_WORK_TREE:-} ]] && return 0

  local dir=$1
  while [[ -n $dir ]]; do
    [[ -e "$dir/.git" ]] && return 0
    [[ $dir == / ]] && break
    dir=${dir:h}
  done
  return 1
}

# Git status can invoke repository-configured clean/process filters while
# comparing working files. Discover only their names, then override each
# driver for the status invocation without evaluating or changing config.
_prompt_git_filter_config() {
  emulate -L zsh

  local root=$1 packet='' config_output='' tail='' key='' driver=''
  local -A seen=()
  reply=()
  packet=$( {
      GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
        GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
        -C "$root" -c core.fsmonitor=false -c core.untrackedCache=false \
        -c core.hooksPath=/dev/null config --null --name-only \
        --get-regexp '^filter\..*\.(clean|process|required)$' 2>/dev/null
      print -rn -- $'\0'"$?"
    } | {
      local chunk=''
      IFS= read -r -u 0 -k 65539 chunk || :
      print -rn -- "$chunk"
    } )
  (( ${#packet} <= 65538 )) || return 1
  [[ $packet == *$'\0'* ]] || return 1
  tail=${packet##*$'\0'}
  config_output=${packet%$'\0'*}
  [[ $tail == 0 || $tail == 1 ]] || return 1

  while IFS= read -r -d '' key; do
    driver=${${key#filter.}%.*}
    [[ -n $driver && -z ${seen[$driver]-} ]] || continue
    seen[$driver]=1
    reply+=(
      -c "filter.${driver}.clean="
      -c "filter.${driver}.process="
      -c "filter.${driver}.required=false"
    )
  done <<< "$config_output"
}

# Render a compact Git summary. Porcelain v2 gives branch and file state in one
# Git call. The metadata directory is resolved once per working directory so
# operation checks do not require another Git process on every prompt.
_prompt_git() {
  setopt localoptions noglobsubst

  local git_output line branch='' oid='' upstream=''
  local separator=$'\x1f'
  local git_dir operation=''
  local cache_key="${PWD}${separator}${GIT_DIR:-}${separator}${GIT_WORK_TREE:-}"
  local summary=''
  local color=''
  _prompt_color success || :
  color=$REPLY
  local -i staged=0 modified=0 untracked=0 conflicted=0 ahead=0 behind=0 stash=0
  local -i detached=0
  local -a fields indicators filter_config

  REPLY=''
  _PROMPT_GIT_TEXT=''
  _PROMPT_GIT_COLOR=$color
  _PROMPT_GIT_BRANCH_TEXT=''
  _PROMPT_GIT_UPSTREAM_TEXT=''
  _PROMPT_GIT_OPERATION_TEXT=''
  _PROMPT_GIT_ATTENTION=''
  _prompt_has_git_context "$PWD" || return
  _prompt_git_filter_config "$PWD" || return
  filter_config=("${reply[@]}")
  # Prompt rendering is passive: suppress repository-controlled fsmonitor,
  # hook, and content-filter commands as well as lazy network fetches.
  git_output=$(GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
    GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
    -c core.fsmonitor=false -c core.untrackedCache=false \
    -c core.hooksPath=/dev/null "${filter_config[@]}" status \
    --porcelain=v2 --branch --show-stash 2>/dev/null) || return

  while IFS= read -r line; do
    case $line in
      '# branch.oid '*)
        oid=${line#\# branch.oid }
        ;;
      '# branch.head '*)
        branch=${line#\# branch.head }
        ;;
      '# branch.upstream '*)
        upstream=${line#\# branch.upstream }
        ;;
      '# branch.ab '*)
        fields=(${=line})
        ahead=${fields[3]#+}
        behind=${fields[4]#-}
        ;;
      '# stash '*)
        stash=${line#\# stash }
        ;;
      '1 '*|'2 '*)
        [[ ${line[3]} != '.' ]] && (( staged++ ))
        [[ ${line[4]} != '.' ]] && (( modified++ ))
        ;;
      'u '*)
        (( conflicted++ ))
        ;;
      '? '*)
        (( untracked++ ))
        ;;
    esac
  done <<< "$git_output"

  if [[ $branch == '(detached)' ]]; then
    branch="@${oid[1,7]}"
    _prompt_color detached || :
    color=$REPLY
    detached=1
  elif [[ -z $branch ]]; then
    branch='unknown'
  fi

  if (( ${+_PROMPT_GIT_DIR_CACHE[$cache_key]} )) &&
     [[ -d ${_PROMPT_GIT_DIR_CACHE[$cache_key]} ]]; then
    git_dir=${_PROMPT_GIT_DIR_CACHE[$cache_key]}
  else
    git_dir=$(command git rev-parse --absolute-git-dir 2>/dev/null)
    [[ -n $git_dir ]] && _PROMPT_GIT_DIR_CACHE[$cache_key]=$git_dir
  fi
  if [[ -n $git_dir ]]; then
    _prompt_git_operation "$git_dir"
    operation=$REPLY
  fi

  (( staged ))     && indicators+=("+${staged}")
  (( modified ))   && indicators+=("!${modified}")
  (( untracked ))  && indicators+=("?${untracked}")
  (( conflicted )) && indicators+=("x${conflicted}")
  (( stash ))      && indicators+=("≡${stash}")
  (( ahead ))      && indicators+=("⇡${ahead}")
  (( behind ))     && indicators+=("⇣${behind}")
  [[ -n $operation ]] && indicators+=("⚡${operation}")
  (( !detached )) && [[ -z $upstream ]] && indicators+=('no-upstream')

  if (( conflicted )) || [[ -n $operation ]]; then
    _prompt_color danger || :
    color=$REPLY
  elif (( staged || modified || untracked )); then
    _prompt_color warning || :
    color=$REPLY
  elif (( behind )); then
    _prompt_color info || :
    color=$REPLY
  fi

  if (( ${#indicators} == 0 )); then
    summary="${branch} ✓"
  else
    summary="${branch} ${(j: :)indicators}"
  fi

  _PROMPT_GIT_TEXT=$summary
  _PROMPT_GIT_COLOR=$color
  _PROMPT_GIT_BRANCH_TEXT=$branch
  _PROMPT_GIT_UPSTREAM_TEXT=$upstream
  _PROMPT_GIT_OPERATION_TEXT=$operation
  if (( conflicted )) || [[ -n $operation ]]; then
    _PROMPT_GIT_ATTENTION="operation:${operation}|conflict:$(( conflicted > 0 ))"
  fi
  _prompt_escape "$summary"
  REPLY="%F{${color:-default}}${REPLY}%f"
}

# Render sanitized text to a bounded visible width. `reply` returns the styled
# prompt string followed by its plain visible text so callers never count color
# escapes as columns.
_prompt_render_abbreviated() {
  emulate -L zsh
  setopt localoptions multibyte
  local role=$1 text=$2 bias=${4:-tail}
  local -i max_width=$3
  local plain='' styled=''

  _prompt_sanitize "$text"
  plain=$REPLY
  _prompt_abbreviate "$plain" "$max_width" "$bias"
  plain=$REPLY
  _prompt_escape "$plain"
  if [[ $role == git ]]; then
    styled="%F{${_PROMPT_GIT_COLOR:-default}}${REPLY}%f"
  else
    _prompt_color_text "$role" "$REPLY"
    styled=$REPLY
  fi
  reply=("$styled" "$plain")
}

# Return one semantic lens row. Labels and dynamic values are styled only after
# the raw value has been sanitized, abbreviated, and measured.
_prompt_lens_row() {
  emulate -L zsh
  local label=$1 text=$2 role=$3 prefix=''
  local -i value_width=$(( ${4:-80} - 13 ))

  (( value_width > 0 )) || return 1
  _prompt_render_abbreviated "$role" "$text" "$value_width" tail
  [[ -n $reply[2] ]] || return 1
  _prompt_color_text frame "│  ${(r:9:)label}"
  prefix=$REPLY
  REPLY="${prefix} ${reply[1]}"
}

# Project items are already safe prompt strings with separately captured
# visible widths. Fit a prefix of them without reading providers during resize.
_prompt_lens_toolchain_row() {
  emulate -L zsh
  local label=TOOLCHAIN prefix='' row='' separator=''
  local -i line_limit=${1:-80} available=$(( ${1:-80} - 13 ))
  local -i index=0 used=0 item_width=0

  (( available > 0 && ${#_PROMPT_PROJECT_ITEMS} )) || return 1
  for (( index = 1; index <= ${#_PROMPT_PROJECT_ITEMS}; index++ )); do
    item_width=${_PROMPT_PROJECT_ITEM_WIDTHS[index]:-0}
    separator=$(( used > 0 ? 3 : 0 ))
    (( used + separator + item_width <= available )) || break
    (( used > 0 )) && row+=' · '
    row+="${_PROMPT_PROJECT_ITEMS[index]}"
    (( used += separator + item_width ))
  done
  if [[ -z $row ]]; then
    _prompt_color_text tool '…'
    row=$REPLY
  fi
  _prompt_color_text frame "  ${(r:9:)label}"
  prefix=$REPLY
  _prompt_color_text "${2:-frame}" '│'
  REPLY="${REPLY}${prefix} ${row}"
}

# Append one raw Interaction-lens row. Values remain literal/captured data until
# layout sanitizes, bounds, escapes, and styles them.
_prompt_interaction_add() {
  [[ -n $2 ]] || return 1
  _PROMPT_INTERACTION_LABELS+=("$1")
  _PROMPT_INTERACTION_VALUES+=("$2")
  _PROMPT_INTERACTION_ROLES+=("${3:-info}")
}

_prompt_interaction_is_assignment() {
  emulate -L zsh
  local word=${(Q)1}
  [[ $word =~ '^[A-Za-z_][A-Za-z0-9_]*(\[[^]]+\])?(\+)?=' ]]
}

_prompt_interaction_is_redirection() {
  emulate -L zsh
  setopt localoptions extendedglob
  local operator=${1##[0-9]##}
  case $operator in
    '<'|'<>'|'>'|'>|'|'>!'|'>>'|'>>|'|'>>!'|\
    '<<'|'<<-'|'<<<'|'<&'|'>&'|'>&|'|'>&!'|\
    '&>'|'&>|'|'&>!'|'>>&'|'>>&|'|'>>&!'|'&>>'|'&>>|'|'&>>!')
      return 0
      ;;
  esac
  return 1
}

# Return whether one recognized option consumes the following lexical word.
# This is deliberately small and conservative: its only purpose is to avoid
# presenting an option value as a search query or remote endpoint.
_prompt_interaction_option_takes_value() {
  emulate -L zsh
  local command_name=$1 option=$2

  case $command_name in
    rg)
      case $option in
        -A|-B|-C|-E|-e|-f|-g|-j|-M|-m|-r|-t|-T|--after-context|\
        --before-context|--context|--dfa-size-limit|--encoding|--engine|\
        --file|--glob|--iglob|--max-columns|--max-columns-preview|\
        --max-count|--max-depth|--mmap|--path-separator|--pre|--pre-glob|\
        --regex-size-limit|--regexp|--replace|--sort|--sortr|--type|\
        --type-add|--type-clear)
          return 0
          ;;
      esac
      ;;
    grep|egrep|fgrep)
      case $option in
        -A|-B|-C|-D|-d|-e|-f|-m|--after-context|--before-context|\
        --binary-files|--context|--directories|--devices|--exclude|\
        --exclude-from|--exclude-dir|--include|--label|--max-count|\
        --regexp|--file)
          return 0
          ;;
      esac
      ;;
    ssh|sftp)
      case $option in
        -B|-b|-c|-D|-E|-e|-F|-I|-i|-J|-L|-l|-m|-O|-o|-p|-Q|-R|\
        -S|-W|-w)
          return 0
          ;;
      esac
      ;;
    scp)
      case $option in
        -c|-D|-F|-i|-J|-l|-o|-P|-S|-X)
          return 0
          ;;
      esac
      ;;
    rsync)
      case $option in
        -B|-e|-f|-M|-T|--backup-dir|--block-size|--bwlimit|--checksum-choice|\
        --chmod|--compare-dest|--compress-choice|--compress-level|--copy-as|\
        --debug|--exclude|--exclude-from|--files-from|--filter|--groupmap|\
        --iconv|--include|--include-from|--info|--link-dest|--log-file|\
        --log-file-format|--max-alloc|--max-delete|--max-size|--min-size|\
        --modify-window|--out-format|--password-file|--port|--protocol|\
        --remote-option|--rsync-path|--skip-compress|--suffix|--temp-dir|\
        --timeout|--usermap)
          return 0
          ;;
      esac
      ;;
  esac
  return 1
}

# Add the smallest useful captured anchor after operation-specific rows.
_prompt_interaction_add_context() {
  if [[ -n $_PROMPT_PROJECT_NAME_TEXT ]]; then
    _prompt_interaction_add PROJECT "$_PROMPT_PROJECT_NAME_TEXT" project
  elif [[ -n $_PROMPT_FULL_PATH_TEXT ]]; then
    _prompt_interaction_add PATH "$_PROMPT_FULL_PATH_TEXT" path
  fi
  [[ -n $_PROMPT_GIT_TEXT && $_PROMPT_INTERACTION_KIND != git ]] &&
    _prompt_interaction_add GIT "$_PROMPT_GIT_TEXT" git
}

# Derive an interaction model from literal editor text and already-captured
# prompt/editor facts. Zsh's lexer identifies structure without evaluating,
# expanding, resolving, or executing anything from BUFFER.
_prompt_interaction_model() {
  emulate -L zsh
  setopt localoptions extendedglob multibyte

  local buffer=$1 bounded_buffer='' token='' plain=''
  local command_name='' command_lower=''
  local operation='' operation_lower='' first_operand='' last_operand=''
  local query_text='' task_text='' environment_text='' remote_text=''
  local redirect_operator='' redirect_text='' flow_text='' assignment_name=''
  local action='' suggestion='' control_text='' caution_command=''
  local comment_text=''
  local endpoint_scheme='' endpoint_authority=''
  local redirect_label='OUTPUT TEXT'
  local redirect_action='likely redirect command output'
  local -a tokens=() plain_tokens=() flow_heads=() flow_operators=()
  local -i index=0 command_index=0 operation_index=0 token_count=0
  local -i pipe_count=0 chain_count=0 expect_flow=0
  local -i caution=0 is_test=0 is_build=0 skip_next=0 saw_option=0
  local -i precommand_options=0 env_precommand=0

  _PROMPT_INTERACTION_KIND=ready
  _PROMPT_INTERACTION_LABELS=()
  _PROMPT_INTERACTION_VALUES=()
  _PROMPT_INTERACTION_ROLES=()

  # Work from a fixed prefix regardless of paste size. The complete BUFFER
  # remains owned by ZLE and is never copied into interaction state.
  bounded_buffer=${buffer[1,512]}
  if (( ${#buffer} > 512 )) &&
     [[ -z ${bounded_buffer//[[:space:]]/} ]]; then
    _PROMPT_INTERACTION_KIND=run
    _prompt_interaction_add ANALYSIS 'first 512 characters only' warning
    _prompt_interaction_add ACTION \
      'may contain shell structure beyond the lens bound' warning
    _prompt_interaction_add_context
    return 0
  fi
  if [[ -z ${bounded_buffer//[[:space:]]/} ]]; then
    [[ -n $_PROMPT_PROJECT_NAME_TEXT ]] &&
      _prompt_interaction_add PROJECT "$_PROMPT_PROJECT_NAME_TEXT" project
    [[ -n $_PROMPT_FULL_PATH_TEXT ]] &&
      _prompt_interaction_add PATH "$_PROMPT_FULL_PATH_TEXT" path
    [[ -n $_PROMPT_GIT_TEXT ]] &&
      _prompt_interaction_add GIT "$_PROMPT_GIT_TEXT" git
    [[ -n $_PROMPT_ENV_TEXT ]] &&
      _prompt_interaction_add ENV "$_PROMPT_ENV_TEXT" environment
    [[ -n $_PROMPT_LAST_OUTCOME_TEXT ]] &&
      _prompt_interaction_add LAST "$_PROMPT_LAST_OUTCOME_TEXT" \
        "${_PROMPT_LAST_OUTCOME_ROLE:-info}"
    if (( ! ${#_PROMPT_INTERACTION_LABELS} )) &&
       [[ -n $_PROMPT_SESSION_TEXT ]]; then
      _prompt_interaction_add SESSION "$_PROMPT_SESSION_TEXT" identity
    fi
    return 0
  fi

  tokens=("${(@Z+c+)bounded_buffer}") 2>/dev/null
  if (( ! ${#tokens} )); then
    tokens=("${bounded_buffer%%[[:space:]]*}")
  elif (( ${#tokens} > 64 )); then
    tokens=("${tokens[@]:0:64}")
  fi
  token_count=${#tokens}
  for token in "${tokens[@]}"; do
    plain_tokens+=("${(Q)token}")
  done

  if [[ ${tokens[1]} == \#* ]]; then
    _PROMPT_INTERACTION_KIND=comment
    comment_text=${plain_tokens[1]#\#}
    comment_text=${comment_text# }
    _prompt_interaction_add "COMMENT TEXT" \
      "${comment_text:-comment}" info
    _prompt_interaction_add ACTION \
      'likely remain an interactive shell comment' info
    _prompt_interaction_add_context
    return 0
  fi

  # Leading assignments and native precommand modifiers do not define the
  # command. Assignment values are never copied into presentation state.
  for (( index = 1; index <= token_count; index++ )); do
    token=${tokens[index]}
    plain=${plain_tokens[index]}
    if _prompt_interaction_is_assignment "$token"; then
      [[ -z $assignment_name ]] && assignment_name=${plain%%=*}
      continue
    fi
    if (( env_precommand )); then
      if (( skip_next )); then
        skip_next=0
        continue
      fi
      case $plain in
        -u|--unset|-C|--chdir|-S|--split-string)
          skip_next=1
          continue
          ;;
        -*)
          continue
          ;;
      esac
    fi
    case $plain in
      command|builtin|exec|noglob|nocorrect|time)
        precommand_options=1
        continue
        ;;
      env)
        env_precommand=1
        precommand_options=1
        continue
        ;;
      '|'|'|&'|'&&'|'||'|';'|'&')
        continue
        ;;
    esac
    if (( precommand_options )) && [[ $plain == -* ]]; then
      continue
    fi
    command_name=$plain
    command_index=$index
    break
  done

  if (( ! command_index )); then
    _PROMPT_INTERACTION_KIND=environment
    _prompt_interaction_add "ARGUMENT TEXT" \
      "${assignment_name:-shell assignment}" environment
    _prompt_interaction_add ACTION 'likely update shell environment' info
    _prompt_interaction_add_context
    return 0
  fi
  # Command and subcommand names remain case-sensitive, just like Zsh.
  command_lower=$command_name

  # Capture the first semantic word and literal operands without interpreting
  # option values or shell expansions.
  for (( index = command_index + 1; index <= token_count; index++ )); do
    plain=${plain_tokens[index]}
    case $plain in
      '|'|'|&'|'&&'|'||'|';'|'&') continue ;;
    esac
    _prompt_interaction_is_assignment "${tokens[index]}" && continue
    _prompt_interaction_is_redirection "$plain" && continue
    if [[ -z $operation && $plain != -* ]]; then
      operation=$plain
      operation_index=$index
    fi
    if [[ $plain != -* ]]; then
      [[ -z $first_operand ]] && first_operand=$plain
      last_operand=$plain
    fi
  done
  # Git accepts global options before its subcommand. Skip the small native
  # set with separate operands so `git -C repo status` still reads as status.
  if [[ $command_lower == (git|g) ]]; then
    operation=''
    operation_index=0
    skip_next=0
    for (( index = command_index + 1; index <= token_count; index++ )); do
      plain=${plain_tokens[index]}
      if (( skip_next )); then
        skip_next=0
        continue
      fi
      if [[ $plain == --help ||
            ( $command_lower == g && $plain == (--review|--discard-all) &&
              ${plain_tokens[index + 1]:-} == --help ) ]]; then
        operation=help
        operation_index=$index
        break
      fi
      if [[ $command_lower == g && $plain == (--review|--worktree|--discard-all) ]]; then
        operation=${plain#--}
        operation_index=$index
        break
      fi
      case $plain in
        -C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env)
          skip_next=1
          continue
          ;;
        --git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--config-env=*|-*)
          continue
          ;;
        --)
          continue
          ;;
      esac
      operation=$plain
      operation_index=$index
      break
    done
    [[ $command_lower == g && -z $operation ]] && operation=branches
  fi
  operation_lower=$operation

  # Capture command heads and their literal connectors across both pipelines
  # and conditional/sequential chains. Mixed forms retain the whole visible
  # plan instead of dropping everything after the first pipeline.
  flow_heads=("$command_name")
  for (( index = 1; index <= token_count; index++ )); do
    plain=${plain_tokens[index]}
    if [[ $plain == ('|'|'|&') ]]; then
      (( ++pipe_count ))
      flow_operators+=("$plain")
      expect_flow=1
      continue
    fi
    if [[ $plain == ('&&'|'||'|';'|'&') ]]; then
      (( ++chain_count ))
      flow_operators+=("$plain")
      expect_flow=1
      continue
    fi
    if (( expect_flow )); then
      if _prompt_interaction_is_assignment "${tokens[index]}"; then
        continue
      fi
      case $plain in
        command|builtin|exec|noglob|nocorrect|time) continue ;;
        -*|'#'*) continue ;;
      esac
      _prompt_interaction_is_redirection "$plain" && continue
      flow_heads+=("$plain")
      expect_flow=0
    fi
    if _prompt_interaction_is_redirection "$plain"; then
      redirect_operator=$plain
      if (( index < token_count )); then
        redirect_text=${plain_tokens[index + 1]}
      fi
    fi
  done

  if [[ -n $redirect_operator ]]; then
    case ${redirect_operator##[0-9]##} in
      '<&'|'>&'|'>&|'|'>&!')
        redirect_label='DESCRIPTOR TEXT'
        redirect_action='likely duplicate or close a shell file descriptor'
        ;;
      '<'|'<<'|'<<-'|'<<<')
        redirect_label='INPUT TEXT'
        redirect_action='likely redirect command input'
        ;;
      '<>')
        redirect_label='RESOURCE TEXT'
        redirect_action='likely open literal redirection input and output'
        ;;
    esac
  fi

  case $command_lower in
    rm|rmdir|dd|eval|kill|pkill)
      caution=1
      ;;
  esac
  (( caution )) && caution_command=$command_name
  if (( ! caution && ${#flow_heads} > 1 )); then
    for token in "${flow_heads[@]:1}"; do
      case $token in
        rm|rmdir|dd|eval|kill|pkill)
          caution=1
          caution_command=$token
          break
          ;;
      esac
    done
  fi
  if [[ $command_lower == external-device ]] &&
     (( ! ${plain_tokens[(Ie)--help]} )) &&
     (( ${plain_tokens[(Ie)--flash]} || ${plain_tokens[(Ie)--format]} )); then
    caution=1
    caution_command=$command_name
  fi
  if [[ $command_lower == (git|g) ]]; then
    case $operation_lower in
      discard-all) caution=1 ;;
      reset)
        (( ${plain_tokens[(Ie)--hard]} )) && caution=1
        ;;
      clean)
        if (( ! ${plain_tokens[(Ie)-n]} &&
              ! ${plain_tokens[(Ie)--dry-run]} )); then
          caution=1
        fi
        ;;
      push)
        if (( ${plain_tokens[(Ie)-f]} ||
              ${plain_tokens[(Ie)--force]} ||
              ${plain_tokens[(Ie)--force-with-lease]} )); then
          caution=1
        fi
        ;;
      branch)
        (( ${plain_tokens[(Ie)-D]} )) && caution=1
        ;;
    esac
  fi

  if (( caution )); then
    _PROMPT_INTERACTION_KIND=caution
    _prompt_interaction_add "COMMAND TEXT" \
      "${caution_command:-$command_name}" danger
    if [[ ${caution_command:-$command_name} == "$command_name" &&
          $command_lower == (git|g) && -n $operation ]]; then
      _prompt_interaction_add "OPERATION TEXT" "$operation" warning
    fi
    [[ ${caution_command:-$command_name} == "$command_name" &&
       -n $last_operand &&
       ( $command_lower != (git|g) || $last_operand != "$operation" ) ]] &&
      _prompt_interaction_add "ARGUMENT TEXT" "$last_operand" warning
    _prompt_interaction_add ACTION \
      'appears caution-worthy · review literal text before Return' danger
    _prompt_interaction_add_context
  elif (( chain_count )); then
    _PROMPT_INTERACTION_KIND=chain
    flow_text=${(j: → :)flow_heads}
    control_text=${(j: :)flow_operators}
    _prompt_interaction_add FLOW "$flow_text" info
    _prompt_interaction_add STEPS "$(( chain_count + pipe_count + 1 ))" info
    _prompt_interaction_add CONTROL "$control_text" warning
    _prompt_interaction_add ACTION \
      'likely sequence literal shell commands' info
    _prompt_interaction_add_context
  elif (( pipe_count )); then
    _PROMPT_INTERACTION_KIND=pipeline
    flow_text=${(j: → :)flow_heads}
    _prompt_interaction_add FLOW "$flow_text" info
    _prompt_interaction_add STAGES "$(( pipe_count + 1 ))" info
    [[ -n $redirect_text ]] &&
      _prompt_interaction_add "$redirect_label" "$redirect_text" warning
    _prompt_interaction_add ACTION \
      'likely compose literal command output' info
    _prompt_interaction_add_context
  elif [[ -n $redirect_operator ]]; then
    _PROMPT_INTERACTION_KIND=redirect
    _prompt_interaction_add "OPERATOR TEXT" "$redirect_operator" warning
    [[ -n $redirect_text ]] &&
      _prompt_interaction_add "$redirect_label" "$redirect_text" warning
    _prompt_interaction_add ACTION "$redirect_action" info
    _prompt_interaction_add_context
  elif [[ $command_lower == (compozsh|external-device) ]] ||
       { [[ $command_lower == xcode ]] &&
         (( token_count == command_index || ${plain_tokens[(Ie)--export-skills]} || ${plain_tokens[(Ie)--help]} )); }; then
    local task_action='likely open a task workspace' task_operation=''
    _PROMPT_INTERACTION_KIND=run
    if (( ${plain_tokens[(Ie)--help]} )) ||
       [[ $command_lower == compozsh && $first_operand == help ]]; then
      task_action='likely show task help'
      task_operation=help
      (( ${plain_tokens[(Ie)--help]} )) && task_operation=--help
    elif [[ $command_lower == xcode ]] && (( ${plain_tokens[(Ie)--export-skills]} )); then
      _PROMPT_INTERACTION_KIND=environment
      task_operation=--export-skills
      task_action='likely review or export Apple skills for local agents'
    elif [[ $command_lower == compozsh ]] && (( ${plain_tokens[(Ie)--sudo-touch-id]} )); then
      _PROMPT_INTERACTION_KIND=environment
      task_operation=--sudo-touch-id
      task_action='likely inspect or manage Touch ID authentication for sudo'
    elif [[ $command_lower == compozsh ]] && (( ${plain_tokens[(Ie)--refresh]} )); then
      _PROMPT_INTERACTION_KIND=environment
      task_operation=--refresh
      task_action='likely refresh this shell’s cached capabilities'
    elif [[ $command_lower == compozsh ]] && (( ${plain_tokens[(Ie)--list]} )); then
      task_operation=--list
      task_action='likely list loaded Compozsh tools'
    else
      case $command_lower in
        xcode) task_action='likely open the Xcode action workspace' ;;
        external-device) task_action='likely open the external-device task chooser' ;;
        compozsh) task_action='likely explore loaded tools and their help' ;;
      esac
    fi
    _prompt_interaction_add 'COMMAND TEXT' "$command_name" info
    [[ -n $task_operation ]] && _prompt_interaction_add 'OPERATION TEXT' "$task_operation" info
    _prompt_interaction_add ACTION "$task_action" info
    _prompt_interaction_add_context
  elif [[ $command_lower == (ssh|scp|sftp|rsync|curl|wget) ]]; then
    _PROMPT_INTERACTION_KIND=remote
    case $command_lower in
      ssh|sftp)
        skip_next=0
        for (( index = command_index + 1; index <= token_count; index++ )); do
          plain=${plain_tokens[index]}
          if (( skip_next )); then
            skip_next=0
            continue
          fi
          if _prompt_interaction_option_takes_value "$command_lower" "$plain"; then
            skip_next=1
            continue
          fi
          [[ $plain == -- ]] && continue
          [[ $plain == -* ]] && continue
          remote_text=$plain
          break
        done
        ;;
      scp|rsync)
        skip_next=0
        for (( index = command_index + 1; index <= token_count; index++ )); do
          plain=${plain_tokens[index]}
          if (( skip_next )); then
            skip_next=0
            continue
          fi
          if _prompt_interaction_option_takes_value "$command_lower" "$plain"; then
            skip_next=1
            continue
          fi
          [[ $plain == -* ]] && continue
          if [[ $plain == *://* || $plain == [^/]##:* ||
                $plain == *@*:* ]]; then
            remote_text=$plain
            break
          fi
        done
        ;;
      curl|wget)
        saw_option=0
        for (( index = command_index + 1; index <= token_count; index++ )); do
          plain=${plain_tokens[index]}
          if [[ $plain == -* ]]; then
            saw_option=1
            continue
          fi
          if [[ $plain == *://* ]]; then
            remote_text=$plain
            continue
          fi
          (( ! saw_option )) && [[ -z $remote_text ]] && remote_text=$plain
        done
        # Curl and wget have large evolving option grammars. With any option
        # present, omit the excerpt rather than risk repeating a header, token,
        # output file, or other option value under a misleading endpoint label.
        (( saw_option )) && remote_text=''
        ;;
    esac
    if [[ -n $remote_text && $remote_text == *://* ]]; then
      endpoint_scheme=${remote_text%%://*}
      endpoint_authority=${remote_text#*://}
      endpoint_authority=${endpoint_authority%%/*}
      endpoint_authority=${endpoint_authority%%\?*}
      endpoint_authority=${endpoint_authority%%\#*}
      endpoint_authority=${endpoint_authority##*@}
      if [[ -n $endpoint_scheme && -n $endpoint_authority ]]; then
        remote_text="${endpoint_scheme}://${endpoint_authority}"
      else
        remote_text=''
      fi
    elif [[ -n $remote_text && $command_lower == (curl|wget) ]]; then
      remote_text=${remote_text%%\?*}
      remote_text=${remote_text%%\#*}
      remote_text=${remote_text##*@}
      remote_text=${remote_text%%/*}
    fi
    _prompt_interaction_add "COMMAND TEXT" "$command_name" info
    [[ -n $remote_text ]] &&
      _prompt_interaction_add "ENDPOINT TEXT" "$remote_text" warning
    _prompt_interaction_add ACTION \
      'command may contact a remote system' warning
    _prompt_interaction_add_context
  elif [[ $command_lower == (git|g) ]]; then
    _PROMPT_INTERACTION_KIND=git
    _prompt_interaction_add "OPERATION TEXT" \
      "${operation:-repository command}" git
    case $operation_lower in
      branches) action='likely open the local recent-branch workspace' ;;
      help) action='likely show Git or Compozsh Git help' ;;
      review) action='likely open the local Git review workspace' ;;
      worktree) action='likely open local Git worktree actions' ;;
      status) action='likely inspect working tree' ;;
      diff|show|log) action='likely review repository history or changes' ;;
      add) action='likely stage selected changes' ;;
      commit) action='likely record staged changes' ;;
      switch|checkout) action='likely change repository position' ;;
      pull|fetch) action='may contact a remote to update repository data' ;;
      push) action='may contact a remote to publish commits' ;;
      merge|rebase|cherry-pick) action='likely integrate repository history' ;;
      *) action='likely run a Git operation' ;;
    esac
    _prompt_interaction_add ACTION "$action" info
    [[ -n $_PROMPT_GIT_BRANCH_TEXT ]] &&
      _prompt_interaction_add BRANCH "$_PROMPT_GIT_BRANCH_TEXT" git
    [[ -n $_PROMPT_PROJECT_NAME_TEXT ]] &&
      _prompt_interaction_add PROJECT "$_PROMPT_PROJECT_NAME_TEXT" project
  elif [[ $command_lower == (cd|pushd|popd|j|z|mkcd) ]]; then
    _PROMPT_INTERACTION_KIND=navigate
    [[ -n $first_operand ]] &&
      _prompt_interaction_add "DESTINATION TEXT" "$first_operand" path
    _prompt_interaction_add ACTION \
      'likely change shell location · Tab can browse' info
    [[ -n $_PROMPT_FULL_PATH_TEXT ]] &&
      _prompt_interaction_add FROM "$_PROMPT_FULL_PATH_TEXT" path
    _prompt_interaction_add_context
  elif [[ $command_lower == (rg|grep|egrep|fgrep|find|mdfind|ag|ack) ]]; then
    _PROMPT_INTERACTION_KIND=search
    skip_next=0
    if [[ $command_lower == find ]]; then
      for (( index = command_index + 1; index < token_count; index++ )); do
        plain=${plain_tokens[index]}
        if [[ $plain == (-name|-iname|-path|-ipath|-regex|-iregex) ]]; then
          query_text=${plain_tokens[index + 1]}
          break
        fi
      done
    else
      for (( index = command_index + 1; index <= token_count; index++ )); do
        plain=${plain_tokens[index]}
        if (( skip_next )); then
          skip_next=0
          continue
        fi
        if _prompt_interaction_option_takes_value "$command_lower" "$plain"; then
          skip_next=1
          continue
        fi
        [[ $plain == -* ]] && continue
        query_text=$plain
        break
      done
    fi
    [[ -n $query_text ]] &&
      _prompt_interaction_add "QUERY TEXT" "$query_text" info
    _prompt_interaction_add ACTION 'likely search literal local input' info
    if [[ -n $_PROMPT_PROJECT_NAME_TEXT ]]; then
      _prompt_interaction_add SCOPE "$_PROMPT_PROJECT_NAME_TEXT" project
    else
      _prompt_interaction_add SCOPE "$_PROMPT_FULL_PATH_TEXT" path
    fi
    [[ -n $_PROMPT_GIT_TEXT ]] &&
      _prompt_interaction_add GIT "$_PROMPT_GIT_TEXT" git
  elif [[ $command_lower == (conda|pyenv|rbenv|nvm|mise|direnv|export|unset|source|.) ]]; then
    _PROMPT_INTERACTION_KIND=environment
    environment_text=$last_operand
    if [[ $command_lower == (export|unset) && -n $environment_text ]]; then
      environment_text=${environment_text%%=*}
    fi
    [[ -n $environment_text ]] &&
      _prompt_interaction_add "ARGUMENT TEXT" "$environment_text" environment
    _prompt_interaction_add ACTION \
      'likely change the current shell environment' info
    [[ -n $_PROMPT_ENV_TEXT ]] &&
      _prompt_interaction_add CURRENT "$_PROMPT_ENV_TEXT" environment
    _prompt_interaction_add_context
  else
    # Exact high-signal test/build forms. Unknown tools remain the neutral RUN
    # lens rather than receiving a guessed purpose.
    if [[ $command_lower == (pytest|bats|rspec|jest|vitest) ]]; then
      is_test=1
      task_text=${operation:-$command_name}
    elif [[ $operation_lower == test &&
            $command_lower == (swift|cargo|go|npm|pnpm|yarn|bun|make|just|task|gradle|mvn|mix|dotnet|xcodebuild) ]]; then
      is_test=1
      task_text=$operation
    elif [[ $command_lower == zsh ]]; then
      for (( index = command_index + 1; index <= token_count; index++ )); do
        plain=${plain_tokens[index]}
        if [[ $plain == *tests/* || $plain == *test*.zsh ]]; then
          is_test=1
          task_text=$plain
          break
        fi
      done
    fi
    if (( is_test )) && [[ $operation_lower == test ]]; then
      for (( index = operation_index + 1; index < token_count; index++ )); do
        if [[ ${plain_tokens[index]} == (--filter|-F|-t|--test) ]]; then
          task_text=${plain_tokens[index + 1]}
          break
        fi
      done
    fi
    if [[ $operation_lower == build &&
          $command_lower == (swift|cargo|go|npm|pnpm|yarn|bun|gradle|mvn|mix|dotnet|xcodebuild) ]]; then
      is_build=1
      task_text=$operation
    elif [[ $command_lower == (make|cmake|ninja|xcode|xcodebuild) ]] &&
         (( ! is_test )); then
      is_build=1
      task_text=${operation:-build}
    fi

    if (( is_test )); then
      _PROMPT_INTERACTION_KIND=test
      _prompt_interaction_add "TASK TEXT" "${task_text:-test}" tool
      _prompt_interaction_add ACTION 'likely run project tests' info
      (( ${#_PROMPT_PROJECT_ITEMS} )) &&
        _prompt_interaction_add @TOOLCHAIN available tool
      _prompt_interaction_add_context
    elif (( is_build )); then
      _PROMPT_INTERACTION_KIND=build
      _prompt_interaction_add "TASK TEXT" "${task_text:-build}" tool
      _prompt_interaction_add ACTION 'likely build the current project' info
      (( ${#_PROMPT_PROJECT_ITEMS} )) &&
        _prompt_interaction_add @TOOLCHAIN available tool
      _prompt_interaction_add_context
    else
      _PROMPT_INTERACTION_KIND=run
      _prompt_interaction_add "COMMAND TEXT" "$command_name" info
      [[ -n $first_operand ]] &&
        _prompt_interaction_add "ARGUMENT TEXT" "$first_operand" info
      _prompt_interaction_add ACTION 'likely run a shell command' info
      _prompt_interaction_add_context
    fi
  fi

  # Manual metadata is ABOUT the tool, never a prediction of draft effects.
  # Keep owned/specific ACTION cues; replace only the generic filler. This
  # optional lookup does no capture, path resolution or filesystem access.
  if (( ${+functions[_manual_summary_lookup]} )) &&
     _manual_summary_lookup "$command_name"; then
    local manual_summary=$REPLY
    local -i action_index=${_PROMPT_INTERACTION_LABELS[(i)ACTION]}
    if [[ ${_PROMPT_INTERACTION_VALUES[action_index]-} == 'likely run a shell command' ]]; then
      _PROMPT_INTERACTION_LABELS[action_index]=ABOUT
      _PROMPT_INTERACTION_VALUES[action_index]=$manual_summary
      _PROMPT_INTERACTION_ROLES[action_index]=info
      _PROMPT_INTERACTION_LABELS=("${(@)_PROMPT_INTERACTION_LABELS[1,action_index]}" SOURCE "${(@)_PROMPT_INTERACTION_LABELS[action_index+1,-1]}")
      _PROMPT_INTERACTION_VALUES=("${(@)_PROMPT_INTERACTION_VALUES[1,action_index]}" "Local manual · ${_MANUAL_SOURCES[$command_name]}" "${(@)_PROMPT_INTERACTION_VALUES[action_index+1,-1]}")
      _PROMPT_INTERACTION_ROLES=("${(@)_PROMPT_INTERACTION_ROLES[1,action_index]}" frame "${(@)_PROMPT_INTERACTION_ROLES[action_index+1,-1]}")
    elif [[ $_PROMPT_INTERACTION_KIND != (caution|pipeline|chain|redirect) ]]; then
      _prompt_interaction_add ABOUT "$manual_summary" info
    fi
  fi

  # The suffix is already owned and displayed by the editor. Repeat only its
  # bounded visible prefix; never search history or preserve the unseen tail.
  if [[ -n ${_ZLE_AUTOSUGGEST_SUFFIX:-} &&
        ${_ZLE_AUTOSUGGEST_CACHE_BUFFER:-} == "$buffer" &&
        ${POSTDISPLAY:-} == "${_ZLE_AUTOSUGGEST_DISPLAY:-}" ]]; then
    _prompt_sanitize "$_ZLE_AUTOSUGGEST_SUFFIX"
    suggestion=$REPLY
    _prompt_prefix_abbreviate "$suggestion" 36
    [[ -n $REPLY ]] &&
      _prompt_interaction_add SUGGESTION "$REPLY" info
  fi
}

_prompt_interaction_row() {
  emulate -L zsh
  setopt localoptions multibyte
  local label=$1 text=$2 role=$3 prefix_plain='' prefix=''
  local -i line_limit=${4:-80} label_width=${(m)#label}
  local -i slot_width=0 prefix_width=0 value_width=0

  if (( line_limit >= 42 )); then
    slot_width=16
    (( label_width > slot_width )) && slot_width=$label_width
  else
    slot_width=$label_width
  fi
  prefix_plain="│  ${(r:$slot_width:)label}"
  prefix_width=${(m)#prefix_plain}
  value_width=$(( line_limit - prefix_width - 1 ))
  (( value_width > 0 )) || return 1
  _prompt_render_abbreviated "$role" "$text" "$value_width" tail
  [[ -n $reply[2] ]] || return 1
  _prompt_escape "${prefix_plain#│}"
  _prompt_color_text frame "$REPLY"
  prefix=$REPLY
  _prompt_color_text "${5:-frame}" '│'
  REPLY="${REPLY}${prefix} ${reply[1]}"
}

_prompt_interaction_layout() {
  emulate -L zsh
  setopt localoptions multibyte
  local kind=${(U)_PROMPT_INTERACTION_KIND} label='' value='' role=''
  local header_plain="╭─ ${kind}" header='' row='' outline_role=''
  local -a rows=()
  local -i line_limit=$(( COLUMNS > 0 ? COLUMNS : 80 ))
  local -i max_body=$(( LINES > 0 ? LINES - 2 : 5 ))
  local -i index=0

  _PROMPT_INTERACTION_SEGMENT=''
  (( line_limit >= 12 && max_body >= 1 )) || return 0
  (( max_body > 5 )) && max_body=5

  _prompt_interaction_color_role
  outline_role=$REPLY
  _prompt_abbreviate "$header_plain" "$line_limit" head
  _prompt_escape "$REPLY"
  _prompt_color_text "$outline_role" "$REPLY"
  header=$REPLY

  if (( ${+widgets[compozsh-inspect]} && line_limit >= 56 )); then
    local hint='Option-Return inspect draft' padding=''
    local -i gap=$(( line_limit - ${(m)#header_plain} - ${(m)#hint} ))
    if (( gap >= 2 )); then
      padding=${(l:$gap:: :)padding}
      _prompt_color_text frame "$hint"
      header+="$padding$REPLY"
    fi
  fi

  for (( index = 1;
         index <= ${#_PROMPT_INTERACTION_LABELS} &&
         ${#rows} < max_body;
         index++ )); do
    label=${_PROMPT_INTERACTION_LABELS[index]}
    value=${_PROMPT_INTERACTION_VALUES[index]}
    role=${_PROMPT_INTERACTION_ROLES[index]:-info}
    if [[ $label == @TOOLCHAIN ]]; then
      _prompt_lens_toolchain_row "$line_limit" "$outline_role" && rows+=("$REPLY")
    elif _prompt_interaction_row "$label" "$value" "$role" "$line_limit" "$outline_role"; then
      rows+=("$REPLY")
    fi
  done

  _PROMPT_INTERACTION_SEGMENT=$header
  for row in "${rows[@]}"; do
    _PROMPT_INTERACTION_SEGMENT+=$'\n'"$row"
  done
}

# Build the expanded presentation from the same in-memory snapshot as compact.
# Height is bounded so the empty lens cannot push its own header into scrollback
# before ZLE gets a chance to contract it.
_prompt_lens_layout() {
  emulate -L zsh
  setopt localoptions multibyte
  local reason=${_PROMPT_LENS_REASON:-context changed}
  local hint=$(( _PROMPT_LENS_PINNED ? 1 : 0 ))
  local hint_text='' left_plain='' header='' footer='' padding=''
  local git_text='' row=''
  local -a rows priorities selected visible_rows
  local -i line_limit=$(( COLUMNS > 0 ? COLUMNS : 80 ))
  local -i max_body=$(( LINES > 0 ? LINES - 3 : 7 ))
  local -i index=0 priority=0 selected_count=0 left_width=0 padding_width=0
  local -i left_plain_width=0 hint_width=0

  _PROMPT_LENS_SEGMENT=''
  (( line_limit >= 18 && max_body >= 1 )) || return 0

  if (( hint )); then
    hint_text='Option-I close'
  else
    hint_text='Option-I pin'
  fi
  left_plain="╭─ CONTEXT · ${reason}"
  left_plain_width=${(m)#left_plain}
  hint_width=${(m)#hint_text}
  # Optional keys must not crowd out the context identity in a narrow window.
  left_width=$line_limit
  if (( line_limit - hint_width - 2 >= 18 )); then
    left_width=$(( line_limit - hint_width - 2 ))
  else
    hint_text='' hint_width=0
  fi
  if (( left_plain_width > left_width )); then
    _prompt_abbreviate "$left_plain" "$left_width" head
    left_plain=$REPLY
    left_plain_width=${(m)#left_plain}
  fi
  _prompt_escape "$left_plain"
  _prompt_color_text frame "$REPLY"
  header=$REPLY
  if [[ -n $hint_text ]] && (( left_plain_width + 2 + hint_width <= line_limit )); then
    padding_width=$(( line_limit - left_plain_width - hint_width ))
    padding=${(l:$padding_width:: :)padding}
    header+=$padding
    _prompt_escape "$hint_text"
    _prompt_color_text frame "$REPLY"
    header+=$REPLY
  fi

  if [[ -n $_PROMPT_PROJECT_ROOT_TEXT ]]; then
    _prompt_lens_row PROJECT "${_PROMPT_PROJECT_ROOT_TEXT:t}" project "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(3)
    }
  fi
  _prompt_lens_row PATH "$_PROMPT_FULL_PATH_TEXT" path "$line_limit" && {
    rows+=("$REPLY")
    priorities+=(1)
  }
  if [[ -n $_PROMPT_GIT_TEXT ]]; then
    git_text=$_PROMPT_GIT_TEXT
    [[ -n $_PROMPT_GIT_UPSTREAM_TEXT ]] &&
      git_text+=" · tracks ${_PROMPT_GIT_UPSTREAM_TEXT}"
    _prompt_lens_row GIT "$git_text" git "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(2)
    }
  fi
  _prompt_lens_toolchain_row "$line_limit" && {
    rows+=("$REPLY")
    priorities+=(5)
  }
  if [[ -n $_PROMPT_ENV_TEXT ]]; then
    _prompt_lens_row ENV "$_PROMPT_ENV_TEXT" environment "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(4)
    }
  fi
  if [[ -n $_PROMPT_JOBS_TEXT ]]; then
    _prompt_lens_row JOBS "$_PROMPT_JOBS_TEXT" jobs "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(6)
    }
  fi
  if [[ -n $_PROMPT_SESSION_TEXT ]]; then
    _prompt_lens_row SESSION "$_PROMPT_SESSION_TEXT" identity "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(7)
    }
  fi

  # Select rows by information priority, then paint them in stable visual order.
  for priority in {1..7}; do
    (( selected_count < max_body )) || break
    for (( index = 1; index <= ${#rows}; index++ )); do
      if (( priorities[index] == priority )); then
        selected[index]=1
        (( ++selected_count ))
        break
      fi
    done
  done
  for (( index = 1; index <= ${#rows}; index++ )); do
    (( ${selected[index]:-0} )) && visible_rows+=("${rows[index]}")
  done
  (( ${#visible_rows} )) || return 0

  # A pinned Context lens retains its captured disclosure while one compact
  # live section follows the current BUFFER. Reserve space instead of growing
  # beyond the terminal-height budget.
  if (( _PROMPT_LENS_PINNED && _PROMPT_INTERACTION_ACTIVE &&
        max_body >= 3 && ${#_PROMPT_INTERACTION_LABELS} )) &&
     [[ $_PROMPT_INTERACTION_KIND != ready ]]; then
    while (( ${#visible_rows} > max_body - 2 )); do
      visible_rows[-1]=()
    done
    _prompt_escape "├─ ${(U)_PROMPT_INTERACTION_KIND}"
    _prompt_color_text frame "$REPLY"
    visible_rows+=("$REPLY")
    if _prompt_interaction_row \
         "${_PROMPT_INTERACTION_LABELS[1]}" \
         "${_PROMPT_INTERACTION_VALUES[1]}" \
         "${_PROMPT_INTERACTION_ROLES[1]:-info}" \
         "$line_limit"; then
      visible_rows+=("$REPLY")
    fi
  fi

  _prompt_color_text frame '╰─'
  footer=$REPLY
  _PROMPT_LENS_SEGMENT=$header
  for row in "${visible_rows[@]}"; do
    _PROMPT_LENS_SEGMENT+=$'\n'"$row"
  done
  _PROMPT_LENS_SEGMENT+=$'\n'"$footer"
}

# Reflow the captured snapshot without launching Git, language tools, or project
# detection. The compact row always retains path and applicable Git; remaining
# width is assigned to environment, jobs, then project facts by priority.
_prompt_layout() {
  emulate -L zsh
  setopt localoptions multibyte
  local path_text='' git_text='' identity_text=''
  local env_text='' jobs_text=''
  local path_plain='' git_plain='' identity_plain=''
  local path_rendered='' git_rendered='' identity_rendered=''
  local optional='' separator='  ·  ' env_rendered='' jobs_rendered=''
  local -i line_limit=$(( COLUMNS > 0 ? COLUMNS : 80 ))
  local -i path_budget=0 git_budget=0 identity_budget=0 available=0
  local -i mandatory_width=0 used_width=0 index=0 item_width=0 optional_open=1
  local -i path_width=0 git_width=0 identity_width=0 separator_width=0

  _PROMPT_CONTEXT_SEGMENT=''
  _PROMPT_PATH_SEGMENT=''
  _PROMPT_GIT_SEGMENT=''
  _PROMPT_ENV_SEGMENT=''
  _PROMPT_PROJECT_SEGMENT=''

  _prompt_sanitize "$_PROMPT_PATH_TEXT"; path_text=$REPLY
  _prompt_sanitize "$_PROMPT_GIT_TEXT"; git_text=$REPLY
  if (( EUID == 0 )) || [[ -n ${SSH_CONNECTION:-}${SSH_TTY:-} ]]; then
    _prompt_sanitize "$_PROMPT_IDENTITY_TEXT"; identity_text=$REPLY
  fi

  path_width=${(m)#path_text}
  git_width=${(m)#git_text}
  identity_width=${(m)#identity_text}
  separator_width=${(m)#separator}
  mandatory_width=$(( path_width + git_width + identity_width ))
  [[ -n $git_text ]] && (( mandatory_width += 2 ))
  [[ -n $identity_text ]] && (( mandatory_width += 2 ))

  if (( mandatory_width <= line_limit )); then
    path_budget=$path_width
    git_budget=$git_width
    identity_budget=$identity_width
  else
    available=$line_limit
    if [[ -n $identity_text ]] && (( line_limit >= 24 )); then
      identity_budget=$(( identity_width < line_limit / 5 ? identity_width : line_limit / 5 ))
      (( available -= identity_budget + 2 ))
    fi
    if [[ -n $git_text ]]; then
      git_budget=$(( git_width < available / 3 ? git_width : available / 3 ))
      (( git_budget < 1 )) && git_budget=1
      path_budget=$(( available - git_budget - 2 ))
      if (( path_budget < 1 )); then
        path_budget=1
        git_budget=$(( available - 3 ))
      fi
    else
      path_budget=$available
    fi
  fi

  if (( identity_budget > 0 )); then
    _prompt_render_abbreviated identity "$identity_text" "$identity_budget" head
    identity_rendered=$reply[1]
    identity_plain=$reply[2]
  fi
  _prompt_render_abbreviated path "$path_text" "$path_budget" tail
  path_rendered=$reply[1]
  path_plain=$reply[2]
  _PROMPT_PATH_SEGMENT=$path_rendered
  if [[ -n $git_text ]] && (( git_budget > 0 )); then
    _prompt_render_abbreviated git "$git_text" "$git_budget" head
    git_rendered=$reply[1]
    git_plain=$reply[2]
    _PROMPT_GIT_SEGMENT="  ${git_rendered}"
  fi

  [[ -n $identity_rendered ]] && _PROMPT_CONTEXT_SEGMENT+="${identity_rendered}  "
  _PROMPT_CONTEXT_SEGMENT+=$path_rendered
  [[ -n $git_rendered ]] && _PROMPT_CONTEXT_SEGMENT+="  ${git_rendered}"
  used_width=$(( ${(m)#identity_plain} + ${(m)#path_plain} + ${(m)#git_plain} ))
  [[ -n $identity_plain ]] && (( used_width += 2 ))
  [[ -n $git_plain ]] && (( used_width += 2 ))
  _PROMPT_TOP_BASE_WIDTH=$used_width

  if [[ -n $_PROMPT_ENV_TEXT ]]; then
    _prompt_sanitize "$_PROMPT_ENV_TEXT"
    env_text=$REPLY
    _prompt_escape "py:${env_text}"
    _prompt_color_text environment "$REPLY"
    env_rendered=$REPLY
    item_width=$(( 3 + ${(m)#env_text} ))
    if (( used_width + separator_width + item_width <= line_limit )); then
      _PROMPT_ENV_SEGMENT="${separator}${env_rendered}"
      _PROMPT_CONTEXT_SEGMENT+=$_PROMPT_ENV_SEGMENT
      (( used_width += separator_width + item_width ))
    else
      optional_open=0
    fi
  fi
  if (( optional_open )) && [[ -n $_PROMPT_JOBS_TEXT ]]; then
    _prompt_sanitize "$_PROMPT_JOBS_TEXT"
    jobs_text=$REPLY
    _prompt_escape "$jobs_text"
    _prompt_color_text jobs "$REPLY"
    jobs_rendered=$REPLY
    item_width=${(m)#jobs_text}
    if (( used_width + separator_width + item_width <= line_limit )); then
      _PROMPT_CONTEXT_SEGMENT+="${separator}${jobs_rendered}"
      (( used_width += separator_width + item_width ))
    else
      optional_open=0
    fi
  fi
  if (( optional_open )); then
    for (( index = 1; index <= ${#_PROMPT_PROJECT_ITEMS}; index++ )); do
      item_width=${_PROMPT_PROJECT_ITEM_WIDTHS[index]:-0}
      (( used_width + separator_width + item_width <= line_limit )) || break
      optional="${separator}${_PROMPT_PROJECT_ITEMS[index]}"
      _PROMPT_PROJECT_SEGMENT+=$optional
      _PROMPT_CONTEXT_SEGMENT+=$optional
      (( used_width += separator_width + item_width ))
    done
  fi

  if (( _PROMPT_INTERACTION_ACTIVE )); then
    _prompt_interaction_model "${BUFFER:-}"
    _prompt_interaction_layout
  else
    _PROMPT_INTERACTION_SEGMENT=''
  fi

  if [[ $_PROMPT_VIEW == lens ]]; then
    _prompt_lens_layout
  else
    _PROMPT_LENS_SEGMENT=''
  fi
}

# Compatibility entry used by existing resize callers and focused tests.
_prompt_project_layout() {
  _prompt_layout
}

# Optional project and toolchain context for the prompt. All setup is deferred
# until the prompt invokes these helpers, so this peer may load before or after
# the prompt unit without changing the final shell.

typeset -gA _PROMPT_RUNTIME_LABELS=(
  c-cpp 'c/c++'
  objective-c 'objective-c'
  asm asm
  scheme scheme
  racket racket
  lisp lisp
  typescript typescript
  shell shell
  powershell powershell
  gdscript godot
  terraform terraform
  fsharp 'f#'
  visual-basic 'visual-basic'
)

# Public extension points for uncommon or personal project types. The local
# initializer can populate them before this portable detector loads.
typeset -ga PROMPT_PROJECT_MARKERS
typeset -ga PROMPT_PROJECT_CONTEXT_FUNCTIONS
typeset -ga _PROMPT_PROJECT_EXTRA_SEGMENTS=()
typeset -ga _PROMPT_PROJECT_EXTRA_WIDTHS=()

# Exact manifests that establish a project root even when source files live in
# deeper package/module directories. Wildcard project files are handled by the
# resolver; the full detector below attaches their language and tool semantics.
typeset -ga _PROMPT_PROJECT_ROOT_MARKERS=(
  Package.swift package.json tsconfig.json deno.json deno.jsonc
  composer.json composer.lock CMakeLists.txt meson.build configure.ac
  configure.in MODULE.bazel WORKSPACE WORKSPACE.bazel conanfile.py
  conanfile.txt vcpkg.json xmake.lua DESCRIPTION renv.lock build.zig
  project.godot .terraform.lock.hcl JuliaProject.toml Project.toml
  Manifest.toml cpanfile Makefile.PL Build.PL fpm.toml dune-project
  build.sbt build.sc rebar.config gleam.toml pyproject.toml setup.py
  setup.cfg requirements.txt Pipfile poetry.lock pdm.lock hatch.toml
  environment.yml environment.yaml mkdocs.yml mkdocs.yaml uv.lock
  .python-version stack.yaml cabal.project Cargo.toml go.mod go.work Gemfile
  .ruby-version pom.xml build.gradle build.gradle.kts settings.gradle
  settings.gradle.kts global.json pubspec.yaml mix.exs terragrunt.hcl
  Pulumi.yaml Chart.yaml kustomization.yaml kustomization.yml serverless.yml
  serverless.yaml pixi.toml melos.yaml melos.yml _quarto.yml _quarto.yaml
  Makefile makefile GNUmakefile build.ninja buf.yaml buf.gen.yaml Justfile
  justfile Taskfile.yml Taskfile.yaml Dockerfile compose.yaml compose.yml
  docker-compose.yaml docker-compose.yml .devcontainer/devcontainer.json
  flake.nix shell.nix devenv.nix devenv.yaml mise.toml .mise.toml Vagrantfile
  supabase/config.toml
)
typeset -ga _PROMPT_SOURCE_SCAN_LANGUAGES=()
typeset -ga _PROMPT_RESOLVED_SOURCE_LANGUAGES=()
typeset -gi _PROMPT_SOURCE_SCAN_SATURATED=0
typeset -gi _PROMPT_RESOLVED_SOURCE_SCAN_SATURATED=0
typeset -gi _PROMPT_SOURCE_SCAN_UNSAFE=0
typeset -gi _PROMPT_RESOLVED_SOURCE_SCAN_UNSAFE=0
typeset -gi _PROMPT_METADATA_MAX_BYTES=1048576

# Find the nearest native Git ownership boundary without running Git or reading
# project data. Nested package manifests may become the displayed project root,
# but their enclosing repository can still control binaries placed on PATH.
_prompt_repository_boundary() {
  emulate -L zsh

  local dir=${1:a}
  REPLY=''
  while [[ -n $dir && $dir != / ]]; do
    if [[ -e "$dir/.git" || -L "$dir/.git" ]]; then
      REPLY=$dir
      return 0
    fi
    dir=${dir:h}
  done
  return 1
}

# A runtime found through PATH is still untrusted when its lexical path or
# resolved target lives inside the project being rendered or its enclosing Git
# repository. Entering a project must never execute code supplied by that
# project merely to draw the prompt.
_prompt_runtime_binary_is_trusted() {
  emulate -L zsh

  local binary=$1 project_root=$2
  local binary_path=${binary:a} binary_target=${binary:A}
  local root='' root_path=${project_root:a} root_target=${project_root:A}
  local boundary='' boundary_path='' boundary_target=''
  local -a boundaries=()

  [[ $binary_path != "$root_path" && $binary_path != "$root_path"/* &&
     $binary_target != "$root_target" && $binary_target != "$root_target"/* ]] ||
    return 1

  for root in "$root_path" "$root_target"; do
    _prompt_repository_boundary "$root" || continue
    (( ${boundaries[(Ie)$REPLY]} )) || boundaries+=("$REPLY")
  done
  for boundary in "${boundaries[@]}"; do
    boundary_path=${boundary:a}
    boundary_target=${boundary:A}
    [[ $binary_path != "$boundary_path" &&
       $binary_path != "$boundary_path"/* &&
       $binary_target != "$boundary_target" &&
       $binary_target != "$boundary_target"/* ]] || return 1
  done
  return 0
}

# Version metadata is inert text, but it still comes from an untrusted project.
# Reject symlinks, paths escaping the project, and unexpectedly large files
# before any read so prompt rendering cannot disclose arbitrary local content
# or allocate an unbounded line.
_prompt_metadata_file_is_safe() {
  emulate -L zsh

  local project_root=$1 candidate=$2
  local candidate_path=${candidate:a} candidate_target=''
  local root_path=${project_root:a} root_target=${project_root:A}
  local -a facts=()
  REPLY=''

  [[ -f $candidate && ! -L $candidate ]] || return 1
  candidate_target=${candidate:A}
  [[ $candidate_path == "$root_path"/* &&
     $candidate_target == "$root_target"/* ]] || return 1
  zstat -A facts +size -- "$candidate" 2>/dev/null || return 1
  (( ${facts[1]:--1} >= 0 &&
     ${facts[1]} <= _PROMPT_METADATA_MAX_BYTES )) || return 1
  REPLY=$candidate
}

_prompt_select_metadata_file() {
  emulate -L zsh

  local project_root=$1 candidate=''
  shift
  REPLY=''
  for candidate in "$@"; do
    _prompt_metadata_file_is_safe "$project_root" "$candidate" || continue
    return 0
  done
  return 1
}

# Version commands must describe the installed tool, not activate project
# policy. Command substitution already isolates this helper's directory and
# environment changes from the interactive shell, so probes run from `/` and
# common toolchain proxies are explicitly forbidden from auto-installing.
_prompt_version_probe() {
  emulate -L zsh

  local -x GOTOOLCHAIN=local
  local -x RUSTUP_AUTO_INSTALL=0
  local -x CHECKPOINT_DISABLE=1
  local -x DOTNET_CLI_TELEMETRY_OPTOUT=1
  local -x DOTNET_NOLOGO=1
  builtin cd -- / || return 1
  command "$@"
}

# Resolve a runtime once per project and relevant shell environment. Checking
# the cache before executable lookup keeps missing tools cheap too; PATH and
# environment selectors ensure activations and toolchain switches get new keys.
_prompt_runtime_version() {
  setopt localoptions noglobsubst

  local language=$1 project_root=$2
  local binary='' output='' first_line='' version=''
  local separator=$'\x1f'
  local cache_key="${language}${separator}${project_root}${separator}${PATH}"
  local candidate implementation='' token=''
  local -i version_ok=1
  local -a words parts

  # Version-manager shims may keep the same executable path while environment
  # selectors change the implementation behind it. Include only selectors
  # relevant to this runtime so unrelated environment changes do not fragment
  # the per-project cache.
  case $language in
    python)
      cache_key+="${separator}${VIRTUAL_ENV:-}${separator}${CONDA_PREFIX:-}"
      cache_key+="${separator}${PYENV_VERSION:-}"
      ;;
    node|typescript)
      cache_key+="${separator}${NODENV_VERSION:-}"
      ;;
    ruby)
      cache_key+="${separator}${RBENV_VERSION:-}"
      ;;
    java|kotlin|scala|groovy)
      cache_key+="${separator}${JAVA_HOME:-}${separator}${JENV_VERSION:-}"
      ;;
    go)
      cache_key+="${separator}${GOENV_VERSION:-}${separator}${GOTOOLCHAIN:-}"
      ;;
    rust)
      cache_key+="${separator}${RUSTUP_TOOLCHAIN:-}"
      ;;
    terraform)
      cache_key+="${separator}${TFENV_TERRAFORM_VERSION:-}"
      ;;
    php)
      cache_key+="${separator}${PHPENV_VERSION:-}"
      ;;
    perl)
      cache_key+="${separator}${PLENV_VERSION:-}"
      ;;
    c-cpp|objective-c|asm|swift)
      cache_key+="${separator}${DEVELOPER_DIR:-}${separator}${SDKROOT:-}"
      cache_key+="${separator}${TOOLCHAINS:-}"
      ;;
    dotnet|fsharp|visual-basic)
      cache_key+="${separator}${DOTNET_ROOT:-}"
      ;;
  esac

  if (( ${+_PROMPT_RUNTIME_VERSION_CACHE[$cache_key]} )); then
    REPLY=${_PROMPT_RUNTIME_VERSION_CACHE[$cache_key]}
    return
  fi

  case $language in
    zsh)     binary=${commands[zsh]:-} ;;
    c-cpp)
      binary=${commands[c++]:-}
      [[ -z $binary ]] && binary=${commands[clang++]:-}
      [[ -z $binary ]] && binary=${commands[g++]:-}
      ;;
    objective-c)
      binary=${commands[clang]:-}
      [[ -z $binary ]] && binary=${commands[cc]:-}
      ;;
    asm)
      binary=${commands[nasm]:-}
      [[ -z $binary ]] && binary=${commands[cc]:-}
      ;;
    scheme)
      for candidate in mit-scheme guile chezscheme scheme racket; do
        binary=${commands[$candidate]:-}
        if [[ -n $binary ]]; then
          implementation=$candidate
          break
        fi
      done
      ;;
    racket)  binary=${commands[racket]:-} ;;
    lisp)
      for candidate in sbcl ccl clisp ecl; do
        binary=${commands[$candidate]:-}
        if [[ -n $binary ]]; then
          implementation=$candidate
          break
        fi
      done
      ;;
    typescript)  binary=${commands[tsc]:-} ;;
    deno)        binary=${commands[deno]:-} ;;
    php)        binary=${commands[php]:-} ;;
    shell)      binary=${commands[bash]:-} ;;
    powershell) binary=${commands[pwsh]:-} ;;
    kotlin)     binary=${commands[kotlinc]:-} ;;
    lua)
      for candidate in lua lua5.5 lua5.4 lua5.3 luajit; do
        binary=${commands[$candidate]:-}
        [[ -n $binary ]] && break
      done
      ;;
    r)          binary=${commands[R]:-} ;;
    zig)        binary=${commands[zig]:-} ;;
    gdscript)
      binary=${commands[godot]:-}
      [[ -z $binary ]] && binary=${commands[godot4]:-}
      ;;
    terraform)
      binary=${commands[terraform]:-}
      if [[ -n $binary ]]; then
        implementation=terraform
      else
        binary=${commands[tofu]:-}
        [[ -n $binary ]] && implementation=tofu
      fi
      ;;
    julia)      binary=${commands[julia]:-} ;;
    perl)       binary=${commands[perl]:-} ;;
    fortran)
      for candidate in gfortran flang ifx ifort; do
        binary=${commands[$candidate]:-}
        if [[ -n $binary ]]; then
          implementation=$candidate
          break
        fi
      done
      ;;
    ocaml)      binary=${commands[ocamlc]:-} ;;
    scala)
      for candidate in scala-cli scalac scala; do
        binary=${commands[$candidate]:-}
        if [[ -n $binary ]]; then
          implementation=$candidate
          break
        fi
      done
      ;;
    erlang)     binary=${commands[erl]:-} ;;
    gleam)      binary=${commands[gleam]:-} ;;
    groovy)     binary=${commands[groovy]:-} ;;
    fsharp|visual-basic) binary=${commands[dotnet]:-} ;;
    swift)   binary=${commands[swift]:-} ;;
    node)    binary=${commands[node]:-} ;;
    python)
      if [[ -n ${VIRTUAL_ENV:-} ]]; then
        binary=${commands[python]:-}
      fi
      [[ -z $binary ]] && binary=${commands[python3]:-}
      [[ -z $binary ]] && binary=${commands[python]:-}
      ;;
    haskell) binary=${commands[ghc]:-} ;;
    rust)    binary=${commands[rustc]:-} ;;
    go)      binary=${commands[go]:-} ;;
    ruby)    binary=${commands[ruby]:-} ;;
    java)    binary=${commands[java]:-} ;;
    dotnet)  binary=${commands[dotnet]:-} ;;
    dart)    binary=${commands[dart]:-} ;;
    elixir)  binary=${commands[elixir]:-} ;;
  esac

  if [[ -n $binary ]] &&
     ! _prompt_runtime_binary_is_trusted "$binary" "$project_root"; then
    binary=''
  fi

  if [[ -z $binary && $language == kotlin && -x "$project_root/gradlew" ]]; then
    REPLY='gradle-managed'
    _PROMPT_RUNTIME_VERSION_CACHE[$cache_key]=$REPLY
    return
  fi

  if [[ -z $binary ]]; then
    REPLY='not-installed'
    _PROMPT_RUNTIME_VERSION_CACHE[$cache_key]=$REPLY
    return
  fi

  case $language in
    zsh)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[2]}
      ;;
    c-cpp|objective-c|asm)
      if [[ ${binary:t} == nasm ]]; then
        output=$(_prompt_version_probe "$binary" -v 2>&1) || version_ok=0
        words=(${=output})
        version="nasm ${words[3]:-}"
      else
        output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
        first_line=${output%%$'\n'*}
        if [[ $first_line == *'clang version '* ]]; then
          version=${first_line#*clang version }
          version="clang ${version%% *}"
        elif [[ $first_line == *'GCC '* || $first_line == *'gcc '* ]]; then
          words=(${=first_line})
          version="gcc ${words[-1]}"
        else
          words=(${=first_line})
          version="${binary:t} ${words[-1]:-}"
        fi
      fi
      ;;
    scheme)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      words=(${=first_line})
      if [[ $implementation == racket ]]; then
        version=${first_line#*Racket v}
        version="racket ${version%% *}"
      else
        for token in "${words[@]}"; do
          if [[ $token == [0-9]* ]]; then
            version="${implementation} ${token//[\(\),]/}"
            break
          fi
        done
      fi
      ;;
    racket)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      version=${first_line#*Racket v}
      version="${version%% *}"
      ;;
    lisp)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      words=(${=first_line})
      for token in "${words[@]}"; do
        if [[ $token == [0-9]* ]]; then
          version="${implementation} ${token//[\(\),]/}"
          break
        fi
      done
      ;;
    typescript)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[2]}
      ;;
    deno)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      words=(${=first_line})
      version=${words[2]}
      ;;
    php)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      words=(${=first_line})
      version=${words[2]}
      ;;
    shell)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      version=${first_line#*version }
      version=${version%%[^0-9.]*}
      ;;
    powershell)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[2]}
      ;;
    kotlin)
      output=$(_prompt_version_probe "$binary" -version 2>&1) || version_ok=0
      words=(${=output})
      for token in "${words[@]}"; do
        if [[ $token == [0-9]* ]]; then
          version=${token//[\(\),]/}
          break
        fi
      done
      ;;
    lua)
      output=$(_prompt_version_probe "$binary" -v 2>&1) || version_ok=0
      words=(${=output})
      version=${words[2]}
      ;;
    r)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      words=(${=first_line})
      version=${words[3]}
      ;;
    zig)
      version=$(_prompt_version_probe "$binary" version 2>&1) || version_ok=0
      ;;
    gdscript)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      first_line=${first_line%% *}
      parts=(${(s:.:)first_line})
      version="${parts[1]:-}.${parts[2]:-}"
      [[ ${parts[3]:-} == <-> ]] && version+=".${parts[3]}"
      ;;
    terraform)
      output=$(_prompt_version_probe "$binary" version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      words=(${=first_line})
      version=${words[2]#v}
      [[ $implementation == tofu ]] && version+="-tofu"
      ;;
    julia)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[3]}
      ;;
    perl)
      version=$(_prompt_version_probe "$binary" -e 'print $^V' 2>&1) || version_ok=0
      version=${version#v}
      ;;
    fortran)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      words=(${=first_line})
      for token in "${words[@]}"; do
        if [[ $token == [0-9]* ]]; then
          version="${implementation} ${token//[\(\),]/}"
          break
        fi
      done
      ;;
    ocaml)
      version=$(_prompt_version_probe "$binary" -version 2>&1) || version_ok=0
      ;;
    scala)
      if [[ $implementation == scala-cli ]]; then
        output=$(_prompt_version_probe "$binary" version 2>&1) || version_ok=0
      else
        output=$(_prompt_version_probe "$binary" -version 2>&1) || version_ok=0
      fi
      first_line=${output%%$'\n'*}
      words=(${=first_line})
      for token in "${words[@]}"; do
        if [[ $token == [0-9]* ]]; then
          version=${token//[\(\),]/}
          break
        fi
      done
      ;;
    erlang)
      version=$(_prompt_version_probe "$binary" -noshell -eval 'io:format("~s", [erlang:system_info(otp_release)]), halt().' 2>&1) || version_ok=0
      ;;
    gleam)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[2]}
      ;;
    groovy)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[3]}
      ;;
    fsharp|visual-basic)
      version=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      ;;
    swift)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      version=${first_line#*Swift version }
      version=${version%% *}
      ;;
    node)
      version=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      version=${version#v}
      ;;
    python)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      version=${output#Python }
      ;;
    haskell)
      version=$(_prompt_version_probe "$binary" --numeric-version 2>&1) || version_ok=0
      ;;
    rust)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[2]}
      ;;
    go)
      output=$(_prompt_version_probe "$binary" version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[3]#go}
      ;;
    ruby)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[2]}
      ;;
    java)
      output=$(_prompt_version_probe "$binary" -version 2>&1) || version_ok=0
      first_line=${output%%$'\n'*}
      words=(${(z)first_line})
      version=${words[3]}
      ;;
    dotnet)
      version=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      ;;
    dart)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      words=(${=output})
      version=${words[4]}
      ;;
    elixir)
      output=$(_prompt_version_probe "$binary" --version 2>&1) || version_ok=0
      first_line=${output##*$'\n'}
      words=(${=first_line})
      version=${words[2]}
      ;;
  esac

  # A command may exist as a system stub but fail to provide a usable runtime.
  if (( version_ok )); then
    version=${version%%$'\n'*}
    words=(${=version})
    version="${(j: :)words}"
    [[ -z $version ]] && version='unknown'
  else
    version='unavailable'
  fi
  _PROMPT_RUNTIME_VERSION_CACHE[$cache_key]=$version
  REPLY=$version
}

# Read the version requested by common version-manager files. A project-specific
# file wins; .tool-versions is the portable fallback shared by asdf and mise.
_prompt_expected_runtime_version() {
  emulate -L zsh
  setopt localoptions noglobsubst

  local language=$1 project_root=$2 expected='' file='' line=''
  local tool_name=$language wanted rest
  local -a words

  case $language in
    node)
      _prompt_select_metadata_file "$project_root" \
        "$project_root/.nvmrc" "$project_root/.node-version" && file=$REPLY
      tool_name=nodejs
      ;;
    python)
      _prompt_select_metadata_file "$project_root" "$project_root/.python-version" && file=$REPLY
      ;;
    swift)
      _prompt_select_metadata_file "$project_root" "$project_root/.swift-version" && file=$REPLY
      ;;
    typescript)
      _prompt_select_metadata_file "$project_root" "$project_root/.typescript-version" && file=$REPLY
      ;;
    deno)
      _prompt_select_metadata_file "$project_root" "$project_root/.deno-version" && file=$REPLY
      ;;
    php)
      _prompt_select_metadata_file "$project_root" "$project_root/.php-version" && file=$REPLY
      ;;
    shell)
      _prompt_select_metadata_file "$project_root" "$project_root/.bash-version" && file=$REPLY
      tool_name=bash
      ;;
    powershell)
      _prompt_select_metadata_file "$project_root" "$project_root/.powershell-version" && file=$REPLY
      tool_name=powershell-core
      ;;
    kotlin)
      _prompt_select_metadata_file "$project_root" "$project_root/.kotlin-version" && file=$REPLY
      ;;
    lua)
      _prompt_select_metadata_file "$project_root" "$project_root/.lua-version" && file=$REPLY
      ;;
    r)
      _prompt_select_metadata_file "$project_root" "$project_root/.R-version" && file=$REPLY
      tool_name=R
      ;;
    zig)
      _prompt_select_metadata_file "$project_root" "$project_root/.zig-version" && file=$REPLY
      ;;
    gdscript)
      _prompt_select_metadata_file "$project_root" "$project_root/.godot-version" && file=$REPLY
      tool_name=godot
      ;;
    terraform)
      _prompt_select_metadata_file "$project_root" "$project_root/.terraform-version" && file=$REPLY
      ;;
    julia)
      _prompt_select_metadata_file "$project_root" "$project_root/.julia-version" && file=$REPLY
      ;;
    perl)
      _prompt_select_metadata_file "$project_root" "$project_root/.perl-version" && file=$REPLY
      ;;
    fortran)
      _prompt_select_metadata_file "$project_root" "$project_root/.fortran-version" && file=$REPLY
      ;;
    ocaml)
      _prompt_select_metadata_file "$project_root" "$project_root/.ocaml-version" && file=$REPLY
      ;;
    scala)
      _prompt_select_metadata_file "$project_root" "$project_root/.scala-version" && file=$REPLY
      ;;
    erlang)
      _prompt_select_metadata_file "$project_root" "$project_root/.erlang-version" && file=$REPLY
      ;;
    gleam)
      _prompt_select_metadata_file "$project_root" "$project_root/.gleam-version" && file=$REPLY
      ;;
    groovy)
      _prompt_select_metadata_file "$project_root" "$project_root/.groovy-version" && file=$REPLY
      ;;
    haskell)
      _prompt_select_metadata_file "$project_root" "$project_root/.ghc-version" && file=$REPLY
      tool_name=ghc
      ;;
    rust)
      _prompt_select_metadata_file "$project_root" "$project_root/rust-toolchain" && file=$REPLY
      ;;
    go)
      if _prompt_select_metadata_file "$project_root" "$project_root/go.mod"; then
        file=$REPLY
        while read -r line wanted rest; do
          if [[ $line == go ]]; then
            expected=$wanted
            break
          fi
        done < "$file"
        file=''
      fi
      tool_name=golang
      ;;
    ruby)
      _prompt_select_metadata_file "$project_root" "$project_root/.ruby-version" && file=$REPLY
      ;;
    java)
      _prompt_select_metadata_file "$project_root" "$project_root/.java-version" && file=$REPLY
      ;;
    dotnet|fsharp|visual-basic)
      _prompt_select_metadata_file "$project_root" "$project_root/.dotnet-version" && file=$REPLY
      tool_name=dotnet-core
      ;;
    elixir)
      _prompt_select_metadata_file "$project_root" "$project_root/.elixir-version" && file=$REPLY
      ;;
  esac

  if [[ -n $file ]]; then
    IFS= read -r expected < "$file"
  fi

  if [[ -z $expected ]] &&
     _prompt_select_metadata_file "$project_root" "$project_root/.tool-versions"; then
    file=$REPLY
    while read -r line wanted rest; do
      if [[ $line == "$tool_name" ]]; then
        expected=$wanted
        break
      fi
    done < "$file"
  fi

  expected=${expected%%#*}
  words=(${=expected})
  REPLY=${words[1]:-}
}

_prompt_versions_match() {
  setopt localoptions noglobsubst

  local active=${1#v} expected=${2#v}
  local token
  local -a words

  # Named release channels cannot be compared reliably with a numeric version.
  case $expected in
    ''|system|latest|stable|nightly|lts/*) return 0 ;;
  esac
  [[ $expected != [0-9]* ]] && return 0

  # Compiler labels include their implementation (for example
  # "gfortran 15.2.0"). Compare the first numeric token when present, and do
  # not warn for wrapper-managed toolchains that expose no comparable number.
  if [[ $active != [0-9]* ]]; then
    words=(${=active})
    active=''
    for token in "${words[@]}"; do
      if [[ $token == [0-9]* ]]; then
        active=${token//[\(\),]/}
        break
      fi
    done
    [[ -z $active ]] && return 0
  fi

  [[ $active == $expected || $active == ${expected}.* || $active == ${expected}-* ]]
}

# Collect source-language evidence from one directory without invoking the full
# detector. Root resolution uses this while walking upward, then the expensive
# manifest/tool/framework pass runs exactly once at the chosen project root.
_prompt_scan_source_languages() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local dir=$1 scan_dir='' candidate='' file='' language=''
  local -i saw_shell=0
  local -a scan_dirs=() files=()
  typeset -ga _PROMPT_SOURCE_SCAN_LANGUAGES=()
  typeset -gi _PROMPT_SOURCE_SCAN_SATURATED=0
  typeset -gi _PROMPT_SOURCE_SCAN_UNSAFE=0

  scan_dirs+=("$dir")
  for candidate in \
    "$dir"/{src,source,Sources,include,lib,app,public,scripts,modules,bin,R,notebooks} \
    "$dir"/src/{main,test}/{java,kotlin,scala,groovy}; do
    if [[ -L $candidate ]]; then
      _PROMPT_SOURCE_SCAN_UNSAFE=1
    elif [[ -d $candidate ]]; then
      scan_dirs+=("$candidate")
    fi
  done

  for scan_dir in "${scan_dirs[@]}"; do
    # `oN` avoids sorting and `Y129` proves whether the 128-entry evidence
    # budget saturated without enumerating the complete directory.
    files=(
      "$scan_dir"/*.(c|cc|cpp|cxx|hh|hpp|hxx|m|mm|asm|s|S|scm|ss|rkt|lisp|cl|asd|swift|php|ps1|psm1|psd1|kt|kts|lua|R|Rmd|Rproj|zig|tf|jl|pl|pm|f|f90|f95|f03|ml|mli|scala|erl|hrl|groovy|ipynb|java|cs|fs|vb|sh)(NY129oN:t)
      "$scan_dir"/*.tf.json(NY1oN:t)
    )
    if (( ${#files} >= 129 )); then
      _PROMPT_SOURCE_SCAN_SATURATED=1
      files=("${(@)files[1,128]}")
    fi
    for file in "${files[@]}"; do
      language=''
      case $file in
        *.c|*.cc|*.cpp|*.cxx|*.hh|*.hpp|*.hxx) language=c-cpp ;;
        *.m|*.mm)                 language=objective-c ;;
        *.asm|*.s|*.S)           language=asm ;;
        *.scm|*.ss)              language=scheme ;;
        *.rkt)                    language=racket ;;
        *.lisp|*.cl|*.asd)       language=lisp ;;
        Project.swift|Workspace.swift|Tuist.swift) continue ;;
        *.swift)                 language=swift ;;
        *.php)                   language=php ;;
        *.ps1|*.psm1|*.psd1)    language=powershell ;;
        build.gradle.kts)        continue ;;
        *.kt|*.kts)              language=kotlin ;;
        xmake.lua)               continue ;;
        *.lua)                   language=lua ;;
        *.R|*.Rmd|*.Rproj)       language=r ;;
        *.zig)                   language=zig ;;
        *.tf|*.tf.json)          language=terraform ;;
        *.jl)                    language=julia ;;
        *.pl|*.pm)               language=perl ;;
        *.f|*.f90|*.f95|*.f03)  language=fortran ;;
        *.ml|*.mli)              language=ocaml ;;
        *.scala)                 language=scala ;;
        *.erl|*.hrl)             language=erlang ;;
        *.groovy)                language=groovy ;;
        *.ipynb)                 language=python ;;
        *.java)                  language=java ;;
        *.cs)                    language=dotnet ;;
        *.fs)                    language=fsharp ;;
        *.vb)                    language=visual-basic ;;
        *.sh)                    saw_shell=1 ;;
      esac
      [[ -n $language ]] || continue
      (( ${_PROMPT_SOURCE_SCAN_LANGUAGES[(Ie)$language]} )) ||
        _PROMPT_SOURCE_SCAN_LANGUAGES+=("$language")
    done
  done

  (( saw_shell && ! ${#_PROMPT_SOURCE_SCAN_LANGUAGES} )) &&
    _PROMPT_SOURCE_SCAN_LANGUAGES+=(shell)
}

# Resolve ownership separately from project inspection. Source files identify
# the nearest standalone project, while an enclosing manifest or Git root owns
# nested packages and conventional source trees.
_prompt_resolve_project_root() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local dir=$1 marker='' language='' nearest_source_root=''
  local -i root_anchor=0
  local -a nearest_languages=() source_languages=() wildcard_matches=()
  REPLY=''
  typeset -ga _PROMPT_RESOLVED_SOURCE_LANGUAGES=()
  typeset -gi _PROMPT_RESOLVED_SOURCE_SCAN_SATURATED=0
  typeset -gi _PROMPT_RESOLVED_SOURCE_SCAN_UNSAFE=0

  while [[ -n $dir && $dir != / && $dir != $HOME ]]; do
    _prompt_scan_source_languages "$dir"
    (( _PROMPT_SOURCE_SCAN_SATURATED )) &&
      _PROMPT_RESOLVED_SOURCE_SCAN_SATURATED=1
    (( _PROMPT_SOURCE_SCAN_UNSAFE )) &&
      _PROMPT_RESOLVED_SOURCE_SCAN_UNSAFE=1
    if (( ${#_PROMPT_SOURCE_SCAN_LANGUAGES} )); then
      if [[ -z $nearest_source_root ]]; then
        nearest_source_root=$dir
        nearest_languages=("${_PROMPT_SOURCE_SCAN_LANGUAGES[@]}")
      fi
      for language in "${_PROMPT_SOURCE_SCAN_LANGUAGES[@]}"; do
        (( ${source_languages[(Ie)$language]} )) || source_languages+=("$language")
      done
    fi

    root_anchor=0
    if [[ -e "$dir/.git" ]]; then
      root_anchor=1
    else
      for marker in "${_PROMPT_PROJECT_ROOT_MARKERS[@]}"; do
        if [[ -e "$dir/$marker" ]]; then
          root_anchor=1
          break
        fi
      done
    fi

    if (( !root_anchor )); then
      wildcard_matches=(
        "$dir"/*.(xcodeproj|xcworkspace|cabal|gemspec|opam|sln|slnx|csproj|fsproj|vbproj|rockspec|Rproj|asd)(NY1oN)
      )
      (( ${#wildcard_matches} )) && root_anchor=1
    fi

    if (( !root_anchor )); then
      for marker in "${PROMPT_PROJECT_MARKERS[@]}"; do
        if [[ -e "$dir/$marker" ]]; then
          root_anchor=1
          break
        fi
      done
    fi

    if (( root_anchor )); then
      REPLY=$dir
      _PROMPT_RESOLVED_SOURCE_LANGUAGES=("${source_languages[@]}")
      return 0
    fi
    dir=${dir:h}
  done

  if [[ -n $nearest_source_root ]]; then
    if [[ ${nearest_source_root:t} ==
          (src|source|lib|main|test|tests|kotlin|scala|groovy) &&
          ${nearest_source_root:h} != $HOME &&
          ${nearest_source_root:h} != / ]]; then
      nearest_source_root=${nearest_source_root:h}
    fi
    REPLY=$nearest_source_root
    _PROMPT_RESOLVED_SOURCE_LANGUAGES=("${nearest_languages[@]}")
    return 0
  fi
  return 1
}

# Find the nearest project directory and render every runtime identified there.
_prompt_project_context() {
  emulate -L zsh
  setopt localoptions multibyte

  local dir='' project_root=''
  local language version expected color label
  local runtime_text warning_text
  local marker hook
  local -i custom_project=0 large_project=0 index=0
  local -i runtime_width=0 warning_width=0
  local -a languages rendered rendered_widths wildcard_matches root_entries
  local -a tools frameworks environment warnings warning_widths attention

  _PROMPT_PROJECT_SEGMENT=''
  _PROMPT_PROJECT_NAME_TEXT=''
  _PROMPT_PROJECT_ROOT_TEXT=''
  _PROMPT_PROJECT_ATTENTION=''
  _PROMPT_PROJECT_ITEMS=()
  _PROMPT_PROJECT_ITEM_WIDTHS=()

  _prompt_resolve_project_root "$PWD" || return
  project_root=$REPLY
  dir=$project_root

  if [[ -n $dir ]]; then
    languages=()
    custom_project=0

    # Detailed wildcard semantics are useful for ordinary project roots, but
    # repeatedly proving absent patterns in a directory with thousands of
    # generated entries makes latency scale with file count. Detect saturation
    # from an unsorted bounded sample and keep only already-resolved language
    # evidence plus exact manifest markers for that exceptional case.
    large_project=$(( _PROMPT_RESOLVED_SOURCE_SCAN_SATURATED ||
                      _PROMPT_RESOLVED_SOURCE_SCAN_UNSAFE ))
    if (( !large_project )); then
      root_entries=("$dir"/*(DNY129oN))
      (( ${#root_entries} >= 129 )) && large_project=1
    fi
    if (( large_project )); then
      for language in "${_PROMPT_RESOLVED_SOURCE_LANGUAGES[@]}"; do
        [[ $language == shell ]] && continue
        (( ${languages[(Ie)$language]} )) || languages+=("$language")
      done
      [[ -f "$dir/Package.swift" ]] && languages+=(swift)
      [[ -f "$dir/package.json" ]] && languages+=(node)
      [[ -f "$dir/tsconfig.json" ]] && languages+=(typescript)
      [[ -f "$dir/deno.json" || -f "$dir/deno.jsonc" ]] && languages+=(deno)
      [[ -f "$dir/composer.json" || -f "$dir/composer.lock" ]] && languages+=(php)
      [[ -f "$dir/project.godot" ]] && languages+=(gdscript)
      [[ -f "$dir/pyproject.toml" || -f "$dir/setup.py" ||
         -f "$dir/requirements.txt" ]] && languages+=(python)
      [[ -f "$dir/Cargo.toml" ]] && languages+=(rust)
      [[ -f "$dir/go.mod" ]] && languages+=(go)
      [[ -f "$dir/Gemfile" || -f "$dir/.ruby-version" ]] && languages+=(ruby)
      [[ -f "$dir/pubspec.yaml" ]] && languages+=(dart)
      [[ -f "$dir/mix.exs" ]] && languages+=(elixir)
      [[ -f "$dir/global.json" ]] && languages+=(dotnet)
      languages=(${(u)languages})

      for marker in "${_PROMPT_PROJECT_ROOT_MARKERS[@]}" \
                    "${PROMPT_PROJECT_MARKERS[@]}"; do
        if [[ -e "$dir/$marker" ]]; then
          custom_project=1
          break
        fi
      done
      if (( ! ${#languages} && ! custom_project &&
            ${_PROMPT_RESOLVED_SOURCE_LANGUAGES[(Ie)shell]} )); then
        languages+=(shell)
      fi
      (( ${#languages} || custom_project )) || project_root=''
    else

    [[ -f "$dir/.zshrc" && -e "$dir/.git" ]] && languages+=(zsh)

    # Compiled languages expose a toolchain rather than a runtime. Inspect the
    # project root and one conventional source level without recursive searches.
    wildcard_matches=(
      "$dir"/*.c(NY1oN) "$dir"/*.cc(NY1oN) "$dir"/*.cpp(NY1oN) "$dir"/*.cxx(NY1oN)
      "$dir"/*.hh(NY1oN) "$dir"/*.hpp(NY1oN) "$dir"/*.hxx(NY1oN)
      "$dir"/{src,source,Sources,lib,app}/*.c(NY1oN)
      "$dir"/{src,source,Sources,lib,app}/*.cc(NY1oN)
      "$dir"/{src,source,Sources,lib,app}/*.cpp(NY1oN)
      "$dir"/{src,source,Sources,lib,app}/*.cxx(NY1oN)
      "$dir"/{src,source,Sources,include,lib,app}/*.hh(NY1oN)
      "$dir"/{src,source,Sources,include,lib,app}/*.hpp(NY1oN)
      "$dir"/{src,source,Sources,include,lib,app}/*.hxx(NY1oN)
    )
    (( ${#wildcard_matches} )) && languages+=(c-cpp)
    if [[ -f "$dir/CMakeLists.txt" || -f "$dir/meson.build" ||
          -f "$dir/configure.ac" || -f "$dir/configure.in" ||
          -f "$dir/MODULE.bazel" || -f "$dir/WORKSPACE" ||
          -f "$dir/WORKSPACE.bazel" || -f "$dir/conanfile.py" ||
          -f "$dir/conanfile.txt" || -f "$dir/vcpkg.json" ||
          -f "$dir/xmake.lua" ]]; then
      custom_project=1
    fi

    wildcard_matches=(
      "$dir"/*.asm(NY1oN) "$dir"/*.s(NY1oN) "$dir"/*.S(NY1oN)
      "$dir"/{src,source,Sources,lib,app}/*.asm(NY1oN)
      "$dir"/{src,source,Sources,lib,app}/*.s(NY1oN)
      "$dir"/{src,source,Sources,lib,app}/*.S(NY1oN)
    )
    (( ${#wildcard_matches} )) && languages+=(asm)

    wildcard_matches=("$dir"/*.scm(NY1oN) "$dir"/*.ss(NY1oN) "$dir"/{src,source,lib}/*.scm(NY1oN) "$dir"/{src,source,lib}/*.ss(NY1oN))
    (( ${#wildcard_matches} )) && languages+=(scheme)
    wildcard_matches=("$dir"/*.rkt(NY1oN) "$dir"/{src,source,lib}/*.rkt(NY1oN))
    (( ${#wildcard_matches} )) && languages+=(racket)
    wildcard_matches=(
      "$dir"/*.lisp(NY1oN) "$dir"/*.cl(NY1oN) "$dir"/*.asd(NY1oN)
      "$dir"/{src,source,lib}/*.lisp(NY1oN) "$dir"/{src,source,lib}/*.cl(NY1oN)
      "$dir"/{src,source,lib}/*.asd(NY1oN)
    )
    (( ${#wildcard_matches} )) && languages+=(lisp)

    wildcard_matches=("$dir"/*.xcodeproj(NY1oN) "$dir"/*.xcworkspace(NY1oN))
    if (( ${#wildcard_matches} )); then
      custom_project=1
      wildcard_matches=("$dir"/*.m(NY1oN) "$dir"/*.mm(NY1oN))
      (( ${#wildcard_matches} )) && languages+=(objective-c)
    else
      wildcard_matches=("$dir"/*.mm(NY1oN) "$dir"/{src,source,Sources,app}/*.mm(NY1oN))
      (( ${#wildcard_matches} )) && languages+=(objective-c)
    fi

    wildcard_matches=("$dir"/*.swift(NY1oN) "$dir"/{src,source,Sources,app}/*.swift(NY1oN))
    wildcard_matches=(${wildcard_matches:#*/Project.swift})
    wildcard_matches=(${wildcard_matches:#*/Workspace.swift})
    wildcard_matches=(${wildcard_matches:#*/Tuist.swift})
    [[ -f "$dir/Package.swift" || ${#wildcard_matches} -gt 0 ]] && languages+=(swift)

    [[ -f "$dir/package.json" ]] && languages+=(node)
    [[ -f "$dir/tsconfig.json" ]] && languages+=(typescript)
    [[ -f "$dir/deno.json" || -f "$dir/deno.jsonc" ]] && languages+=(deno)

    wildcard_matches=("$dir"/*.php(NY1oN) "$dir"/{src,app,public}/*.php(NY1oN))
    [[ -f "$dir/composer.json" || -f "$dir/composer.lock" ||
       ${#wildcard_matches} -gt 0 ]] && languages+=(php)

    wildcard_matches=(
      "$dir"/*.ps1(NY1oN) "$dir"/*.psm1(NY1oN) "$dir"/*.psd1(NY1oN)
      "$dir"/{src,scripts,modules}/*.ps1(NY1oN)
      "$dir"/{src,scripts,modules}/*.psm1(NY1oN)
      "$dir"/{src,scripts,modules}/*.psd1(NY1oN)
    )
    (( ${#wildcard_matches} )) && languages+=(powershell)

    wildcard_matches=(
      "$dir"/*.kt(NY1oN) "$dir"/*.kts(NY1oN) "$dir"/{src,app}/*.kt(NY1oN)
    )
    wildcard_matches=(${wildcard_matches:#*.gradle.kts})
    (( ${#wildcard_matches} )) && languages+=(kotlin)

    wildcard_matches=("$dir"/*.lua(NY1oN) "$dir"/{src,lua,lib}/*.lua(NY1oN) "$dir"/*.rockspec(NY1oN))
    wildcard_matches=(${wildcard_matches:#*/xmake.lua})
    (( ${#wildcard_matches} )) && languages+=(lua)

    wildcard_matches=(
      "$dir"/*.R(NY1oN) "$dir"/*.Rmd(NY1oN) "$dir"/{R,src,scripts}/*.R(NY1oN)
      "$dir"/notebooks/*.Rmd(NY1oN) "$dir"/*.Rproj(NY1oN)
    )
    [[ -f "$dir/DESCRIPTION" || -f "$dir/renv.lock" ||
       ${#wildcard_matches} -gt 0 ]] && languages+=(r)

    wildcard_matches=("$dir"/*.zig(NY1oN) "$dir"/{src,source}/*.zig(NY1oN))
    [[ -f "$dir/build.zig" || ${#wildcard_matches} -gt 0 ]] && languages+=(zig)

    [[ -f "$dir/project.godot" ]] && languages+=(gdscript)

    wildcard_matches=("$dir"/*.tf(NY1oN) "$dir"/*.tf.json(NY1oN))
    [[ -f "$dir/.terraform.lock.hcl" || ${#wildcard_matches} -gt 0 ]] && languages+=(terraform)

    wildcard_matches=("$dir"/*.jl(NY1oN) "$dir"/{src,scripts}/*.jl(NY1oN))
    [[ -f "$dir/JuliaProject.toml" || -f "$dir/Project.toml" ||
       -f "$dir/Manifest.toml" || ${#wildcard_matches} -gt 0 ]] && languages+=(julia)

    wildcard_matches=("$dir"/*.pl(NY1oN) "$dir"/*.pm(NY1oN) "$dir"/{lib,bin,script,scripts}/*.pl(NY1oN) "$dir"/{lib,bin}/*.pm(NY1oN))
    if [[ -f "$dir/cpanfile" || -f "$dir/Makefile.PL" || -f "$dir/Build.PL" ||
          ${#wildcard_matches} -gt 0 ]]; then
      languages+=(perl)
    fi

    wildcard_matches=(
      "$dir"/*.f(NY1oN) "$dir"/*.f90(NY1oN) "$dir"/*.f95(NY1oN) "$dir"/*.f03(NY1oN)
      "$dir"/{src,source,app}/*.f(NY1oN) "$dir"/{src,source,app}/*.f90(NY1oN)
      "$dir"/{src,source,app}/*.f95(NY1oN) "$dir"/{src,source,app}/*.f03(NY1oN)
    )
    [[ -f "$dir/fpm.toml" || ${#wildcard_matches} -gt 0 ]] && languages+=(fortran)

    wildcard_matches=("$dir"/*.ml(NY1oN) "$dir"/*.mli(NY1oN) "$dir"/{src,lib}/*.ml(NY1oN) "$dir"/{src,lib}/*.mli(NY1oN) "$dir"/*.opam(NY1oN))
    [[ -f "$dir/dune-project" || ${#wildcard_matches} -gt 0 ]] && languages+=(ocaml)

    wildcard_matches=(
      "$dir"/*.scala(NY1oN) "$dir"/{src,app}/*.scala(NY1oN)
    )
    if [[ -f "$dir/build.sbt" || -f "$dir/build.sc" ]]; then
      languages+=(scala)
      custom_project=1
    elif (( ${#wildcard_matches} )); then
      languages+=(scala)
    fi

    wildcard_matches=("$dir"/*.erl(NY1oN) "$dir"/*.hrl(NY1oN) "$dir"/{src,include}/*.erl(NY1oN) "$dir"/{src,include}/*.hrl(NY1oN))
    [[ -f "$dir/rebar.config" || ${#wildcard_matches} -gt 0 ]] && languages+=(erlang)

    [[ -f "$dir/gleam.toml" ]] && languages+=(gleam)

    wildcard_matches=(
      "$dir"/*.groovy(NY1oN) "$dir"/{src,app}/*.groovy(NY1oN)
    )
    (( ${#wildcard_matches} )) && languages+=(groovy)

    wildcard_matches=("$dir"/*.ipynb(NY1oN) "$dir"/notebooks/*.ipynb(NY1oN))
    if [[ -f "$dir/pyproject.toml" || -f "$dir/setup.py" ||
          -f "$dir/setup.cfg" || -f "$dir/requirements.txt" ||
          -f "$dir/Pipfile" || -f "$dir/poetry.lock" ||
          -f "$dir/pdm.lock" || -f "$dir/hatch.toml" ||
          -f "$dir/environment.yml" || -f "$dir/environment.yaml" ||
          -f "$dir/mkdocs.yml" || -f "$dir/mkdocs.yaml" ||
          -f "$dir/uv.lock" || -f "$dir/.python-version" ||
          ${#wildcard_matches} -gt 0 ]]; then
      languages+=(python)
    fi

    wildcard_matches=("$dir"/*.cabal(NY1oN))
    [[ -f "$dir/stack.yaml" || -f "$dir/cabal.project" ||
       ${#wildcard_matches} -gt 0 ]] && languages+=(haskell)

    [[ -f "$dir/Cargo.toml" ]] && languages+=(rust)
    [[ -f "$dir/go.mod" ]] && languages+=(go)

    wildcard_matches=("$dir"/*.gemspec(NY1oN))
    [[ -f "$dir/Gemfile" || -f "$dir/.ruby-version" ||
       ${#wildcard_matches} -gt 0 ]] && languages+=(ruby)

    wildcard_matches=(
      "$dir"/*.java(NY1oN) "$dir"/{src,app}/*.java(NY1oN)
    )
    if (( ${#wildcard_matches} )); then
      languages+=(java)
    fi

    if [[ -f "$dir/pom.xml" || -f "$dir/build.gradle" ||
          -f "$dir/build.gradle.kts" ||
          -f "$dir/settings.gradle" || -f "$dir/settings.gradle.kts" ]]; then
      custom_project=1
    fi

    wildcard_matches=("$dir"/*.csproj(NY1oN))
    (( ${#wildcard_matches} )) && languages+=(dotnet)
    wildcard_matches=("$dir"/*.fsproj(NY1oN) "$dir"/*.fs(NY1oN) "$dir"/{src,app}/*.fs(NY1oN))
    (( ${#wildcard_matches} )) && languages+=(fsharp)
    wildcard_matches=("$dir"/*.vbproj(NY1oN) "$dir"/*.vb(NY1oN) "$dir"/{src,app}/*.vb(NY1oN))
    (( ${#wildcard_matches} )) && languages+=(visual-basic)
    wildcard_matches=("$dir"/*.sln(NY1oN) "$dir"/*.slnx(NY1oN))
    if (( ${#wildcard_matches} )) &&
       (( ! ${languages[(I)dotnet]} && ! ${languages[(I)fsharp]} &&
          ! ${languages[(I)visual-basic]} )); then
      languages+=(dotnet)
    fi
    if [[ -f "$dir/global.json" ]] &&
       (( ! ${languages[(I)dotnet]} && ! ${languages[(I)fsharp]} &&
          ! ${languages[(I)visual-basic]} )); then
      languages+=(dotnet)
    fi

    [[ -f "$dir/pubspec.yaml" ]] && languages+=(dart)
    [[ -f "$dir/mix.exs" ]] && languages+=(elixir)

    # Infrastructure-only and cross-language repositories may not contain a
    # source file at their root, but these manifests still define a project.
    if [[ -f "$dir/terragrunt.hcl" || -f "$dir/Pulumi.yaml" ||
          -f "$dir/Chart.yaml" || -f "$dir/kustomization.yaml" ||
          -f "$dir/kustomization.yml" || -f "$dir/serverless.yml" ||
          -f "$dir/serverless.yaml" || -f "$dir/pixi.toml" ||
          -f "$dir/melos.yaml" || -f "$dir/melos.yml" ||
          -f "$dir/_quarto.yml" || -f "$dir/_quarto.yaml" ||
          -f "$dir/Makefile" || -f "$dir/makefile" ||
          -f "$dir/GNUmakefile" || -f "$dir/build.ninja" ||
          -f "$dir/buf.yaml" || -f "$dir/buf.gen.yaml" ||
          -f "$dir/Justfile" ||
          -f "$dir/justfile" || -f "$dir/Taskfile.yml" ||
          -f "$dir/Taskfile.yaml" || -f "$dir/Dockerfile" ||
          -f "$dir/compose.yaml" || -f "$dir/compose.yml" ||
          -f "$dir/docker-compose.yaml" || -f "$dir/docker-compose.yml" ||
          -f "$dir/.devcontainer/devcontainer.json" ||
          -f "$dir/flake.nix" || -f "$dir/shell.nix" ||
          -f "$dir/devenv.nix" || -f "$dir/devenv.yaml" ||
          -f "$dir/mise.toml" || -f "$dir/.mise.toml" ||
          -f "$dir/Vagrantfile" || -f "$dir/supabase/config.toml" ]]; then
      custom_project=1
    fi

    for marker in "${PROMPT_PROJECT_MARKERS[@]}"; do
      if [[ -e "$dir/$marker" ]]; then
        custom_project=1
        break
      fi
    done

    # Shell scripts are ubiquitous in polyglot repos, so identify them only
    # when no stronger built-in or locally extended project has been found.
    if (( ! ${#languages} && ! custom_project )); then
      wildcard_matches=("$dir"/*.sh(NY1oN) "$dir"/{bin,scripts,src}/*.sh(NY1oN))
      (( ${#wildcard_matches} )) && languages+=(shell)
    fi

    # Preserve language evidence found between the current directory and its
    # owning root, including source trees deeper than the conventional levels
    # inspected above.
    for language in "${_PROMPT_RESOLVED_SOURCE_LANGUAGES[@]}"; do
      [[ $language == shell ]] && continue
      (( ${languages[(Ie)$language]} )) || languages+=("$language")
    done
    if (( ! ${#languages} && ! custom_project &&
          ${_PROMPT_RESOLVED_SOURCE_LANGUAGES[(Ie)shell]} )); then
      languages+=(shell)
    fi

    # A bare Git directory with no recognizable project signal should not add
    # an otherwise empty context row.
    (( ${#languages} || custom_project )) || project_root=''
    fi
  fi

  [[ -z $project_root ]] && return
  _PROMPT_PROJECT_ROOT_TEXT=$project_root

  for language in "${languages[@]}"; do
    _prompt_runtime_version "$language" "$project_root"
    version=$REPLY
    label=${_PROMPT_RUNTIME_LABELS[$language]:-$language}
    _prompt_color tool || :
    color=$REPLY
    if [[ $version == not-installed || $version == unavailable ||
          $version == unknown ]]; then
      _prompt_color danger || :
      color=$REPLY
      attention+=("runtime:${label}:${version}")
    fi
    runtime_text="${label} ${version}"
    _prompt_sanitize "$runtime_text"
    runtime_width=${(m)#REPLY}
    _prompt_escape "$runtime_text"
    rendered+=("%F{${color:-default}}${REPLY}%f")
    rendered_widths+=("$runtime_width")

    _prompt_expected_runtime_version "$language" "$project_root"
    expected=$REPLY
    if [[ -n $expected && $version != not-installed &&
          $version != unavailable && $version != unknown ]] &&
       ! _prompt_versions_match "$version" "$expected"; then
      warning_text="⚠ ${label} wants ${expected}"
      _prompt_sanitize "$warning_text"
      warning_width=${(m)#REPLY}
      _prompt_escape "$warning_text"
      _prompt_color_text danger "$REPLY"
      warnings+=("$REPLY")
      warning_widths+=("$warning_width")
      attention+=("mismatch:${label}:${expected}")
    fi
  done

  if (( large_project )); then
    # Keep custom extension hooks and mismatch warnings, but omit the optional
    # wildcard-derived tool/framework decoration that would rescan a saturated
    # root. Exact manifests and bounded source evidence still identify it.
    _PROMPT_PROJECT_EXTRA_SEGMENTS=()
    _PROMPT_PROJECT_EXTRA_WIDTHS=()
    for hook in "${PROMPT_PROJECT_CONTEXT_FUNCTIONS[@]}"; do
      (( ${+functions[$hook]} )) && "$hook" "$project_root"
    done
    for (( index = 1; index <= ${#_PROMPT_PROJECT_EXTRA_SEGMENTS}; index++ )); do
      rendered+=("${_PROMPT_PROJECT_EXTRA_SEGMENTS[index]}")
      rendered_widths+=("${_PROMPT_PROJECT_EXTRA_WIDTHS[index]:-0}")
    done
    rendered+=("${warnings[@]}")
    rendered_widths+=("${warning_widths[@]}")
    _PROMPT_PROJECT_NAME_TEXT=${project_root:t}
    _PROMPT_PROJECT_ITEMS=("${rendered[@]}")
    _PROMPT_PROJECT_ITEM_WIDTHS=("${rendered_widths[@]}")
    _PROMPT_PROJECT_ATTENTION="${(j:|:)attention}"
    return 0
  fi

  # Package managers and build systems. Lockfiles take precedence when several
  # Node or Python artifacts coexist after a migration.
  if [[ -f "$project_root/bun.lock" || -f "$project_root/bun.lockb" ]]; then
    tools+=(bun)
  elif [[ -f "$project_root/pnpm-lock.yaml" ]]; then
    tools+=(pnpm)
  elif [[ -f "$project_root/yarn.lock" ]]; then
    tools+=(yarn)
  elif [[ -f "$project_root/package-lock.json" ]]; then
    tools+=(npm)
  fi
  [[ -f "$project_root/turbo.json" ]] && tools+=(turbo)
  [[ -f "$project_root/nx.json" ]] && tools+=(nx)
  [[ -f "$project_root/lerna.json" ]] && tools+=(lerna)
  [[ -f "$project_root/rush.json" ]] && tools+=(rush)
  [[ -f "$project_root/composer.json" || -f "$project_root/composer.lock" ]] && tools+=(composer)

  [[ -f "$project_root/Package.swift" ]] && tools+=(swiftpm)
  wildcard_matches=("$project_root"/*.xcodeproj(NY1oN) "$project_root"/*.xcworkspace(NY1oN))
  if (( ${#wildcard_matches} )); then
    tools+=(xcode)

    wildcard_matches=("$project_root"/*.xcworkspace(NY1oN))
    (( ${#wildcard_matches} )) && tools+=(xcworkspace)
    [[ -f "$project_root/Podfile" || -f "$project_root/Podfile.lock" ]] && tools+=(cocoapods)
    [[ -f "$project_root/Cartfile" || -f "$project_root/Cartfile.resolved" ]] && tools+=(carthage)
    if [[ -f "$project_root/Tuist.swift" || -f "$project_root/Project.swift" ||
          -f "$project_root/Workspace.swift" || -d "$project_root/Tuist" ]]; then
      tools+=(tuist)
    fi
    if [[ -f "$project_root/project.yml" || -f "$project_root/project.yaml" ]]; then
      tools+=(xcodegen)
    fi
    [[ -f "$project_root/.swiftlint.yml" ||
       -f "$project_root/.swiftlint.yaml" ]] && tools+=(swiftlint)
    [[ -f "$project_root/.swiftformat" ]] && tools+=(swiftformat)
    [[ -f "$project_root/Fastfile" ||
       -f "$project_root/fastlane/Fastfile" ]] && tools+=(fastlane)
    [[ -f "$project_root/Mintfile" ]] && tools+=(mint)
  fi

  if [[ -f "$project_root/uv.lock" ]]; then
    tools+=(uv)
  elif [[ -f "$project_root/poetry.lock" ]]; then
    tools+=(poetry)
  elif [[ -f "$project_root/pdm.lock" ]]; then
    tools+=(pdm)
  elif [[ -f "$project_root/pixi.toml" || -f "$project_root/pixi.lock" ]]; then
    tools+=(pixi)
  elif [[ -f "$project_root/hatch.toml" ]]; then
    tools+=(hatch)
  elif [[ -f "$project_root/Pipfile" ]]; then
    tools+=(pipenv)
  elif [[ -f "$project_root/environment.yml" ||
          -f "$project_root/environment.yaml" ]]; then
    tools+=(conda)
  elif [[ -f "$project_root/requirements.txt" ]]; then
    tools+=(pip)
  fi

  [[ -f "$project_root/Cargo.toml" ]] && tools+=(cargo)
  [[ -f "$project_root/go.mod" ]] && tools+=('go-modules')
  [[ -f "$project_root/buf.yaml" || -f "$project_root/buf.gen.yaml" ]] && tools+=(buf)
  [[ -f "$project_root/stack.yaml" ]] && tools+=(stack)
  wildcard_matches=("$project_root"/*.cabal(NY1oN))
  [[ -f "$project_root/cabal.project" || ${#wildcard_matches} -gt 0 ]] && tools+=(cabal)
  if (( ${languages[(I)haskell]} )) && [[ -f "$project_root/package.yaml" ]]; then
    tools+=(hpack)
  fi
  [[ -f "$project_root/Gemfile" ]] && tools+=(bundler)
  [[ -f "$project_root/pom.xml" ]] && tools+=(maven)
  [[ -f "$project_root/build.gradle" || -f "$project_root/build.gradle.kts" ||
     -f "$project_root/settings.gradle" ||
     -f "$project_root/settings.gradle.kts" ]] && tools+=(gradle)
  [[ -f "$project_root/build.sc" || -f "$project_root/mill-build/build.sc" ]] && tools+=(mill)
  wildcard_matches=("$project_root"/*.sln(NY1oN) "$project_root"/*.slnx(NY1oN))
  (( ${#wildcard_matches} )) && tools+=(solution)
  [[ -f "$project_root/packages.lock.json" ||
     -f "$project_root/Directory.Packages.props" ]] && tools+=(nuget)
  [[ -f "$project_root/pubspec.yaml" ]] && tools+=(pub)
  [[ -f "$project_root/melos.yaml" || -f "$project_root/melos.yml" ]] && tools+=(melos)
  [[ -f "$project_root/mix.exs" ]] && tools+=(mix)
  [[ -f "$project_root/renv.lock" ]] && tools+=(renv)
  [[ -f "$project_root/pak.lock" ]] && tools+=(pak)
  wildcard_matches=("$project_root"/*.rockspec(NY1oN))
  (( ${#wildcard_matches} )) && tools+=(luarocks)
  [[ -f "$project_root/cpanfile" || -f "$project_root/Makefile.PL" ||
     -f "$project_root/Build.PL" ]] && tools+=(cpan)
  [[ -f "$project_root/cpanfile.snapshot" ]] && tools+=(carton)
  [[ -f "$project_root/dist.ini" ]] && tools+=(dzil)
  [[ -f "$project_root/fpm.toml" ]] && tools+=(fpm)
  [[ -f "$project_root/dune-project" ]] && tools+=(dune)
  wildcard_matches=("$project_root"/*.opam(NY1oN))
  (( ${#wildcard_matches} )) && tools+=(opam)
  [[ -f "$project_root/build.sbt" ]] && tools+=(sbt)
  [[ -f "$project_root/rebar.config" ]] && tools+=(rebar3)

  [[ -f "$project_root/CMakeLists.txt" ]] && tools+=(cmake)
  [[ -f "$project_root/meson.build" ]] && tools+=(meson)
  [[ -f "$project_root/configure.ac" || -f "$project_root/configure.in" ]] && tools+=(autotools)
  [[ -f "$project_root/MODULE.bazel" || -f "$project_root/WORKSPACE" ||
     -f "$project_root/WORKSPACE.bazel" ]] && tools+=(bazel)
  [[ -f "$project_root/conanfile.py" || -f "$project_root/conanfile.txt" ]] && tools+=(conan)
  [[ -f "$project_root/vcpkg.json" ]] && tools+=(vcpkg)
  [[ -f "$project_root/xmake.lua" ]] && tools+=(xmake)
  [[ -f "$project_root/Makefile" || -f "$project_root/makefile" ||
     -f "$project_root/GNUmakefile" ]] && tools+=(make)
  [[ -f "$project_root/build.ninja" ]] && tools+=(ninja)
  [[ -f "$project_root/Justfile" || -f "$project_root/justfile" ]] && tools+=(just)
  [[ -f "$project_root/Taskfile.yml" || -f "$project_root/Taskfile.yaml" ]] && tools+=(task)
  [[ -f "$project_root/terragrunt.hcl" ]] && tools+=(terragrunt)
  [[ -f "$project_root/.tflint.hcl" ]] && tools+=(tflint)
  [[ -f "$project_root/Pulumi.yaml" ]] && tools+=(pulumi)
  [[ -f "$project_root/Chart.yaml" ]] && tools+=(helm)
  [[ -f "$project_root/kustomization.yaml" ||
     -f "$project_root/kustomization.yml" ]] && tools+=(kustomize)
  [[ -f "$project_root/serverless.yml" ||
     -f "$project_root/serverless.yaml" ]] && tools+=(serverless)
  wildcard_matches=("$project_root"/*.asd(NY1oN))
  (( ${#wildcard_matches} )) && tools+=(asdf)

  # Frameworks use distinctive config files rather than parsing arbitrary source.
  wildcard_matches=("$project_root"/next.config.*(NY1oN))
  (( ${#wildcard_matches} )) && frameworks+=(next)
  wildcard_matches=("$project_root"/nuxt.config.*(NY1oN))
  (( ${#wildcard_matches} )) && frameworks+=(nuxt)
  wildcard_matches=("$project_root"/vite.config.*(NY1oN))
  (( ${#wildcard_matches} )) && frameworks+=(vite)
  wildcard_matches=("$project_root"/astro.config.*(NY1oN))
  (( ${#wildcard_matches} )) && frameworks+=(astro)
  wildcard_matches=("$project_root"/remix.config.*(NY1oN))
  (( ${#wildcard_matches} )) && frameworks+=(remix)
  wildcard_matches=("$project_root"/gatsby-config.*(NY1oN))
  (( ${#wildcard_matches} )) && frameworks+=(gatsby)
  [[ -f "$project_root/angular.json" ]] && frameworks+=(angular)
  [[ -f "$project_root/svelte.config.js" ]] && frameworks+=(sveltekit)
  [[ -f "$project_root/expo-env.d.ts" ]] && frameworks+=(expo)
  [[ -f "$project_root/react-native.config.js" ]] && frameworks+=('react-native')
  wildcard_matches=(
    "$project_root"/forge.config.*(NY1oN)
    "$project_root"/electron-builder.{yml,yaml,json,json5,js,ts}(NY1oN)
  )
  (( ${#wildcard_matches} )) && frameworks+=(electron)
  wildcard_matches=("$project_root"/.storybook/main.*(NY1oN))
  (( ${#wildcard_matches} )) && frameworks+=(storybook)
  [[ -f "$project_root/prisma/schema.prisma" ]] && frameworks+=(prisma)
  [[ -f "$project_root/manage.py" ]] && frameworks+=(django)
  [[ -f "$project_root/mkdocs.yml" || -f "$project_root/mkdocs.yaml" ]] && frameworks+=(mkdocs)
  [[ -f "$project_root/config/application.rb" && -f "$project_root/bin/rails" ]] && frameworks+=(rails)
  wildcard_matches=("$project_root"/lib/*_web/router.ex(NY1oN))
  (( ${#wildcard_matches} )) && frameworks+=(phoenix)
  [[ -f "$project_root/src-tauri/tauri.conf.json" ||
     -f "$project_root/src-tauri/tauri.conf.json5" ]] && frameworks+=(tauri)
  if [[ -f "$project_root/pubspec.yaml" && -d "$project_root/lib" &&
        ( -d "$project_root/android" || -d "$project_root/ios" ) ]]; then
    frameworks+=(flutter)
  fi
  [[ -f "$project_root/artisan" ]] && frameworks+=(laravel)
  [[ -f "$project_root/symfony.lock" ]] && frameworks+=(symfony)
  [[ -f "$project_root/wp-config.php" ]] && frameworks+=(wordpress)
  [[ -f "$project_root/core/lib/Drupal.php" ]] && frameworks+=(drupal)
  [[ -f "$project_root/app/src/main/AndroidManifest.xml" ]] && frameworks+=(android)
  [[ -f "$project_root/_quarto.yml" || -f "$project_root/_quarto.yaml" ]] && frameworks+=(quarto)
  [[ -f "$project_root/lazy-lock.json" && -d "$project_root/lua" ]] && frameworks+=(neovim)
  [[ -f "$project_root/supabase/config.toml" ]] && frameworks+=(supabase)

  wildcard_matches=("$project_root"/*.ipynb(NY1oN) "$project_root"/notebooks/*.ipynb(NY1oN))
  (( ${#wildcard_matches} )) && tools+=(jupyter)

  # Workspace and development-environment signals are intentionally compact.
  if [[ -f "$project_root/pnpm-workspace.yaml" || -f "$project_root/turbo.json" ||
        -f "$project_root/nx.json" || -f "$project_root/lerna.json" ||
        -f "$project_root/rush.json" || -f "$project_root/melos.yaml" ||
        -f "$project_root/melos.yml" || -f "$project_root/go.work" ]]; then
    environment+=(workspace)
  fi
  if [[ -f "$project_root/Dockerfile" || -f "$project_root/compose.yaml" ||
        -f "$project_root/compose.yml" || -f "$project_root/docker-compose.yaml" ||
        -f "$project_root/docker-compose.yml" ]]; then
    environment+=(docker)
  fi
  [[ -f "$project_root/.devcontainer/devcontainer.json" ]] && environment+=(devcontainer)
  [[ -f "$project_root/flake.nix" || -f "$project_root/shell.nix" ]] && environment+=(nix)
  [[ -f "$project_root/devenv.nix" || -f "$project_root/devenv.yaml" ]] && environment+=(devenv)
  [[ -f "$project_root/mise.toml" || -f "$project_root/.mise.toml" ]] && environment+=(mise)
  [[ -f "$project_root/.envrc" ]] && environment+=(direnv)
  [[ -f "$project_root/Vagrantfile" ]] && environment+=(vagrant)

  # Custom hooks run after built-in detection and append through the safe helper.
  _PROMPT_PROJECT_EXTRA_SEGMENTS=()
  _PROMPT_PROJECT_EXTRA_WIDTHS=()
  for hook in "${PROMPT_PROJECT_CONTEXT_FUNCTIONS[@]}"; do
    (( ${+functions[$hook]} )) && "$hook" "$project_root"
  done

  for language in "${tools[@]}"; do
    _prompt_color_text tool "$language"
    rendered+=("$REPLY")
    rendered_widths+=("${(m)#language}")
  done
  for language in "${frameworks[@]}"; do
    _prompt_color_text framework "$language"
    rendered+=("$REPLY")
    rendered_widths+=("${(m)#language}")
  done
  for language in "${environment[@]}"; do
    _prompt_color_text container "$language"
    rendered+=("$REPLY")
    rendered_widths+=("${(m)#language}")
  done
  for (( index = 1; index <= ${#_PROMPT_PROJECT_EXTRA_SEGMENTS}; index++ )); do
    rendered+=("${_PROMPT_PROJECT_EXTRA_SEGMENTS[index]}")
    rendered_widths+=("${_PROMPT_PROJECT_EXTRA_WIDTHS[index]:-0}")
  done
  rendered+=("${warnings[@]}")
  rendered_widths+=("${warning_widths[@]}")

  _PROMPT_PROJECT_NAME_TEXT=${project_root:t}
  _PROMPT_PROJECT_ITEMS=("${rendered[@]}")
  _PROMPT_PROJECT_ITEM_WIDTHS=("${rendered_widths[@]}")
  _PROMPT_PROJECT_ATTENTION="${(j:|:)attention}"
}

# Compare only canonical high-signal facts. Rendered colors, width-dependent
# abbreviations, and routine Git dirt counts deliberately stay out of this
# fingerprint so repaint and ordinary work never make the lens bloom.
_prompt_context_observe() {
  emulate -L zsh
  local reason=''

  [[ $_PROMPT_VIEW == transcript ]] && _PROMPT_VIEW=compact
  # Expanded prompt presentation is useful only when the editor peer can
  # contract it, finish it into a transcript, and expose its manual control.
  # Resolve this optional capability at prompt time so peer source order is
  # irrelevant and prompt-only installations retain a truthful compact view.
  if (( ! ${+functions[_zle_prompt_pre_redraw]} ||
        ! ${+functions[_zle_prompt_line_finish]} ||
        ! ${+functions[_zle_prompt_toggle_widget]} )); then
    _PROMPT_INTERACTION_ACTIVE=0
    _PROMPT_VIEW=compact
    _PROMPT_LENS_PINNED=0
    _PROMPT_LAST_PROJECT_ROOT=$_PROMPT_PROJECT_ROOT_TEXT
    _PROMPT_LAST_GIT_BRANCH=$_PROMPT_GIT_BRANCH_TEXT
    _PROMPT_LAST_ENVIRONMENT=$_PROMPT_ENV_KEY
    _PROMPT_LAST_GIT_ATTENTION=$_PROMPT_GIT_ATTENTION
    _PROMPT_LAST_PROJECT_ATTENTION=$_PROMPT_PROJECT_ATTENTION
    return 0
  fi
  _PROMPT_INTERACTION_ACTIVE=1
  if (( !_PROMPT_CONTEXT_READY )); then
    if [[ -n $_PROMPT_PROJECT_ROOT_TEXT ]]; then
      reason='entered project'
    elif [[ -n $_PROMPT_GIT_BRANCH_TEXT ]]; then
      reason='entered repository'
    fi
    _PROMPT_CONTEXT_READY=1
  elif [[ -n $_PROMPT_PROJECT_ROOT_TEXT &&
          $_PROMPT_PROJECT_ROOT_TEXT != $_PROMPT_LAST_PROJECT_ROOT ]]; then
    reason='project changed'
  elif [[ -n $_PROMPT_GIT_BRANCH_TEXT &&
          $_PROMPT_GIT_BRANCH_TEXT != $_PROMPT_LAST_GIT_BRANCH ]]; then
    reason='branch changed'
  elif [[ $_PROMPT_ENV_KEY != $_PROMPT_LAST_ENVIRONMENT ]]; then
    if [[ -z $_PROMPT_ENV_KEY ]]; then
      reason='environment cleared'
    elif [[ -z $_PROMPT_LAST_ENVIRONMENT ]]; then
      reason='environment activated'
    else
      reason='environment changed'
    fi
  elif [[ $_PROMPT_GIT_ATTENTION != $_PROMPT_LAST_GIT_ATTENTION ]]; then
    if [[ -n $_PROMPT_GIT_ATTENTION ]]; then
      reason='Git needs attention'
    else
      reason='Git attention cleared'
    fi
  elif [[ $_PROMPT_PROJECT_ATTENTION != $_PROMPT_LAST_PROJECT_ATTENTION ]]; then
    if [[ -n $_PROMPT_PROJECT_ATTENTION ]]; then
      reason='runtime needs attention'
    else
      reason='runtime attention cleared'
    fi
  fi

  _PROMPT_LAST_PROJECT_ROOT=$_PROMPT_PROJECT_ROOT_TEXT
  _PROMPT_LAST_GIT_BRANCH=$_PROMPT_GIT_BRANCH_TEXT
  _PROMPT_LAST_ENVIRONMENT=$_PROMPT_ENV_KEY
  _PROMPT_LAST_GIT_ATTENTION=$_PROMPT_GIT_ATTENTION
  _PROMPT_LAST_PROJECT_ATTENTION=$_PROMPT_PROJECT_ATTENTION

  if [[ -n $reason ]]; then
    _PROMPT_VIEW=lens
    _PROMPT_LENS_PINNED=0
    _PROMPT_LENS_REASON=$reason
  fi
  return 0
}

# The first actual edit consumes an automatic lens. Erasing that draft does not
# recreate it; only the next captured high-signal change may do so.
_prompt_interaction_update() {
  emulate -L zsh
  local buffer=${1:-${BUFFER:-}}
  local old_prompt=$PROMPT old_segment=$_PROMPT_INTERACTION_SEGMENT
  local old_lens=$_PROMPT_LENS_SEGMENT old_view=$_PROMPT_VIEW
  local old_kind=$_PROMPT_INTERACTION_KIND

  _PROMPT_INTERACTION_ACTIVE=1
  if [[ $_PROMPT_VIEW == lens && $_PROMPT_LENS_PINNED -eq 0 &&
        -n ${buffer//[[:space:]]/} ]]; then
    _PROMPT_VIEW=compact
  elif [[ $_PROMPT_VIEW == transcript ]]; then
    _PROMPT_VIEW=compact
  fi
  _prompt_layout
  _prompt_base
  [[ $PROMPT != "$old_prompt" ||
     $_PROMPT_INTERACTION_SEGMENT != "$old_segment" ||
     $_PROMPT_LENS_SEGMENT != "$old_lens" ||
     $_PROMPT_VIEW != "$old_view" ||
     $_PROMPT_INTERACTION_KIND != "$old_kind" ]]
}

_prompt_editing_started() {
  _prompt_interaction_update "${BUFFER:-}"
  return $?
}

# Manual disclosure has three intuitive states: automatic becomes pinned,
# pinned closes, and compact opens pinned. It changes presentation only.
_prompt_toggle_lens() {
  emulate -L zsh
  if [[ $_PROMPT_VIEW == lens ]]; then
    if (( _PROMPT_LENS_PINNED )); then
      _PROMPT_VIEW=compact
      _PROMPT_LENS_PINNED=0
    else
      _PROMPT_LENS_PINNED=1
    fi
  else
    _PROMPT_VIEW=lens
    _PROMPT_LENS_PINNED=1
    _PROMPT_LENS_REASON='pinned context'
  fi
  _PROMPT_INTERACTION_ACTIVE=1
  _prompt_layout
  _prompt_base
  return 0
}

# Prepare only an inert prefix. Native ZLE paints the unchanged BUFFER beside
# it, avoiding prompt expansion of command text and preserving shell semantics.
_prompt_prepare_transcript() {
  emulate -L zsh
  [[ -n ${BUFFER//[[:space:]]/} ]] || return 1
  _PROMPT_VIEW=transcript
  _PROMPT_LENS_PINNED=0
  _PROMPT_INTERACTION_KIND=ready
  _PROMPT_INTERACTION_SEGMENT=''
  _PROMPT_INTERACTION_LABELS=()
  _PROMPT_INTERACTION_VALUES=()
  _PROMPT_INTERACTION_ROLES=()
  PROMPT='%D{%H:%M} › '
  RPROMPT=''
  return 0
}

# Print a compact post-command result only for failures and existing slow-command
# threshold. The strings contain trusted numeric state only.
_prompt_capture_outcome() {
  emulate -L zsh
  local -i command_status=$1 milliseconds=0
  local -F 3 elapsed=$2
  local duration=''

  if (( elapsed < 1.0 )); then
    milliseconds=$(( elapsed * 1000 + 0.5 ))
    (( milliseconds < 0 )) && milliseconds=0
    duration="${milliseconds}ms"
  else
    local -F 1 rounded=$elapsed
    duration="${rounded}s"
  fi

  if (( command_status == 0 )); then
    _PROMPT_LAST_OUTCOME_TEXT="✓ ${duration}"
    _PROMPT_LAST_OUTCOME_ROLE=success
  else
    _PROMPT_LAST_OUTCOME_TEXT="× exit ${command_status} · ${duration}"
    _PROMPT_LAST_OUTCOME_ROLE=danger
  fi
}

_prompt_outcome_receipt() {
  emulate -L zsh
  local -i command_status=$1
  local -F 1 elapsed=$2
  local text='' role=''

  if (( command_status != 0 )); then
    text="× exit ${command_status}"
    role=danger
    (( elapsed >= 2.0 )) && text+=" · ${elapsed}s"
  elif (( elapsed >= 2.0 )); then
    text="✓ ${elapsed}s"
    role=success
  else
    return 1
  fi
  _prompt_color_text "$role" "$text"
  print -P -r -- "$REPLY"
}

_prompt_update() {
  local last_status=$?
  emulate -L zsh

  local -F 3 elapsed=0
  local env_name='' prompt_identity='' prompt_path='' title_path=''
  local -i job_count=0

  _PROMPT_EXIT_SEGMENT=''
  _PROMPT_TIME_SEGMENT=''
  _prompt_color symbol || :
  _PROMPT_SYMBOL_COLOR=$REPLY
  if (( last_status != 0 )); then
    _prompt_color danger || :
    _PROMPT_SYMBOL_COLOR=$REPLY
  fi

  if (( _PROMPT_COMMAND_STARTED > 0 )); then
    elapsed=$(( EPOCHREALTIME - _PROMPT_COMMAND_STARTED ))
    _prompt_capture_outcome "$last_status" "$elapsed"
    # Receipts are terminal presentation, never stdout protocol. A deliberately
    # forced interactive shell with redirected output remains byte-clean.
    [[ -t 1 ]] && _prompt_outcome_receipt "$last_status" "$elapsed" || :
  fi
  _PROMPT_COMMAND_STARTED=0

  # One bounded manual snapshot before ordinary interactive editing. Repaint
  # never calls this provider, and redirected/noninteractive shells skip it.
  if [[ -t 0 && -t 1 ]] && (( ${+functions[_manual_prompt_capture]} )); then
    _manual_prompt_capture
  fi

  _PROMPT_ENV_TEXT=''
  _PROMPT_ENV_KEY=''
  if [[ -n ${VIRTUAL_ENV:-} ]]; then
    env_name=${VIRTUAL_ENV:t}
    _PROMPT_ENV_KEY="venv:${VIRTUAL_ENV}"
  elif [[ -n ${CONDA_DEFAULT_ENV:-} && ${CONDA_DEFAULT_ENV} != base ]]; then
    env_name=$CONDA_DEFAULT_ENV
    _PROMPT_ENV_KEY="conda:${CONDA_DEFAULT_ENV}"
  fi
  _PROMPT_ENV_TEXT=$env_name

  _prompt_git
  prompt_identity=${(%):-%n@%m}
  prompt_path=${(%):-%4~}
  _PROMPT_IDENTITY_TEXT=$prompt_identity
  _PROMPT_SESSION_TEXT="${prompt_identity} · zsh ${ZSH_VERSION}"
  _PROMPT_PATH_TEXT=$prompt_path
  _PROMPT_FULL_PATH_TEXT=${(%):-%~}
  job_count=${#jobstates}
  if (( job_count == 1 )); then
    _PROMPT_JOBS_TEXT='1 job'
  elif (( job_count > 1 )); then
    _PROMPT_JOBS_TEXT="${job_count} jobs"
  else
    _PROMPT_JOBS_TEXT=''
  fi

  if (( ${+functions[_prompt_project_context]} )); then
    _prompt_project_context
  else
    _PROMPT_PROJECT_NAME_TEXT=''
    _PROMPT_PROJECT_ROOT_TEXT=''
    _PROMPT_PROJECT_ATTENTION=''
    _PROMPT_PROJECT_ITEMS=()
    _PROMPT_PROJECT_ITEM_WIDTHS=()
    _PROMPT_PROJECT_SEGMENT=''
  fi

  _prompt_context_observe
  _prompt_layout
  _prompt_base

  # Keep the window/tab title useful without printing anything in the terminal.
  if [[ $TERM != dumb && -t 1 ]]; then
    title_path=${(%):-%~}
    _prompt_sanitize "${prompt_identity}: ${title_path}"
    print -rn -- $'\e]0;'"${REPLY}"$'\a'
  fi
}

_prompt_command_started() {
  emulate -L zsh

  _PROMPT_COMMAND_STARTED=$EPOCHREALTIME

  if [[ $TERM != dumb && -t 1 ]]; then
    local command_name=${1%% *} title_identity=''
    title_identity=${(%):-%n@%m}
    _prompt_sanitize "${title_identity}: ${command_name[1,60]}"
    print -rn -- $'\e]0;'"${REPLY}"$'\a'
  fi
}

# SIGWINCH is sent when the window or font size changes. Preserve an existing
# initializer/vendor handler before installing the prompt's composable wrapper.
# If a later owner has wrapped or replaced that installed body, a re-source
# leaves its chain intact: wrapping it again could make a saved copy of our old
# body call back through the new shared predecessor and recurse.
typeset _prompt_existing_TRAPWINCH=${functions[TRAPWINCH]:-}
typeset -i _prompt_install_TRAPWINCH=1
if [[ -n ${_PROMPT_TRAPWINCH_BODY:-} &&
      -n $_prompt_existing_TRAPWINCH &&
      $_prompt_existing_TRAPWINCH != $_PROMPT_TRAPWINCH_BODY ]]; then
  _prompt_install_TRAPWINCH=0
elif [[ -n $_prompt_existing_TRAPWINCH &&
        $_prompt_existing_TRAPWINCH != ${_PROMPT_TRAPWINCH_BODY:-} ]]; then
  functions[_prompt_previous_TRAPWINCH]=$_prompt_existing_TRAPWINCH
elif [[ -z $_prompt_existing_TRAPWINCH ]]; then
  unfunction _prompt_previous_TRAPWINCH 2>/dev/null
fi

# Redraw only the layout of cached facts; do not rerun Git or project/toolchain
# detection while a window edge is being dragged.
if (( _prompt_install_TRAPWINCH )); then
  TRAPWINCH() {
    local -i previous_status=0
    if (( ${+functions[_prompt_previous_TRAPWINCH]} )); then
      _prompt_previous_TRAPWINCH "$@" || previous_status=$?
    fi
    zle || return $previous_status
    emulate -L zsh

    if (( (${_ZLE_PICKER_ACTIVE:-0} || ${_ZLE_PICKER_SCREEN_ACTIVE:-0}) && ${+functions[_zle_picker_redraw]} )); then
      # ZLE parameters are read-only in traps; the editor owns the writable
      # widget context as well as the cached picker layout and painting.
      zle compozsh-picker-redraw
      return $previous_status
    fi
    _prompt_layout
    _prompt_base
    zle reset-prompt
    zle -R
    return $previous_status
  }
  typeset -g _PROMPT_TRAPWINCH_BODY=${functions[TRAPWINCH]}
fi
unset _prompt_existing_TRAPWINCH _prompt_install_TRAPWINCH

# Re-sourcing the file should not stack duplicate hooks.
precmd_functions=("${precmd_functions[@]-}")
preexec_functions=("${preexec_functions[@]-}")
precmd_functions=(${precmd_functions:#_prompt_update})
precmd_functions+=(_prompt_update)
preexec_functions=(${preexec_functions:#_prompt_command_started})
preexec_functions+=(_prompt_command_started)

# The first precmd captures the complete snapshot. Until then, leave a useful
# native two-line fallback that has no dependency on another peer or palette.
PROMPT='%4~
❯ '
RPROMPT=''

:
