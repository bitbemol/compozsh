# -----------------------------------------------------------------------------
# Prompt
# -----------------------------------------------------------------------------

zmodload zsh/datetime
zmodload -F zsh/stat b:zstat

# Appearance owns defaults; this consumer preserves explicit public roles.
typeset -gA ZSH_PROMPT_COLORS

_prompt_color_text() {
  local text=$2
  if (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt "$1"; then
    REPLY="%F{${REPLY}}${text}%f"
  else
    REPLY=$text
  fi
}

# One semantic role for the Interaction capsule header and its connecting rail.
_prompt_interaction_color_role() {
  case $_PROMPT_INTERACTION_KIND in
    caution) REPLY=danger ;;
    ready) REPLY=success ;;
    git) REPLY=git ;;
    navigate) REPLY=path ;;
    environment) REPLY=environment ;;
    build|test) REPLY=tool ;;
    *) REPLY=info ;;
  esac
}

# The active prompt has three presentations of one captured snapshot. Compact
# is the private state behind the live Interaction lens, lens expands Context,
# and transcript is the fixed prefix painted by zle-line-finish immediately
# before acceptance.
_prompt_base() {
  emulate -L zsh
  local symbol=${_PROMPT_SYMBOL_COLOR:-default} frame=''

  [[ $_PROMPT_VIEW == transcript ]] && return 0

  _PROMPT_INPUT_SEGMENT="%F{${symbol}}❯%f "
  RPROMPT=''
  if (( LINES == 1 )); then
    PROMPT=$_PROMPT_INPUT_SEGMENT
    return 0
  fi
  if [[ $_PROMPT_VIEW == lens && -n $_PROMPT_LENS_SEGMENT ]]; then
    PROMPT="${_PROMPT_LENS_SEGMENT}"$'\n'"${_PROMPT_INPUT_SEGMENT}"
  elif (( _PROMPT_INTERACTION_ACTIVE )) &&
       [[ -n $_PROMPT_INTERACTION_SEGMENT ]]; then
    _prompt_interaction_color_role
    _prompt_color_text "$REPLY" '╰─'
    frame=$REPLY
    _PROMPT_INPUT_SEGMENT="${frame} %F{${symbol}}❯%f "
    PROMPT="${_PROMPT_INTERACTION_SEGMENT}"$'\n'"${_PROMPT_INPUT_SEGMENT}"
  else
    PROMPT="${_PROMPT_CONTEXT_SEGMENT}"$'\n'"${_PROMPT_INPUT_SEGMENT}"
  fi
}

# A reload keeps a running command's start time. Discard anything else of the
# same name, such as inherited environment text, unread: float conversion
# evaluates arithmetic, including $(...) in a subscript.
if [[ ${(t)_PROMPT_COMMAND_STARTED} != float* ]]; then
  unset -- _PROMPT_COMMAND_STARTED
  typeset -gF _PROMPT_COMMAND_STARTED=0
fi
# Prompt state: facts captured at precmd (*_TEXT, *_KEY, *_ATTENTION, project
# items), the segments _prompt_layout renders from them (with the width the
# context row was laid out for), and view and lens state. _prompt_base composes
# PROMPT from the context, lens, interaction and input segments only.
typeset -g _PROMPT_ENV_TEXT=''
typeset -g _PROMPT_ENV_KEY=''
typeset -g _PROMPT_GIT_TEXT=''
typeset -g _PROMPT_GIT_COLOR=''
typeset -g _PROMPT_GIT_BRANCH_TEXT=''
typeset -g _PROMPT_GIT_UPSTREAM_TEXT=''
typeset -g _PROMPT_GIT_OPERATION_TEXT=''
typeset -g _PROMPT_GIT_ATTENTION=''
typeset -g _PROMPT_PATH_TEXT=''
typeset -g _PROMPT_FULL_PATH_TEXT=''
typeset -g _PROMPT_PROJECT_NAME_TEXT=''
typeset -g _PROMPT_PROJECT_ROOT_TEXT=''
typeset -g _PROMPT_PROJECT_ATTENTION=''
typeset -g _PROMPT_IDENTITY_TEXT=''
typeset -g _PROMPT_SESSION_TEXT=''
typeset -g _PROMPT_JOBS_TEXT=''
typeset -g _PROMPT_SYMBOL_COLOR=''
typeset -g _PROMPT_CONTEXT_SEGMENT=''
typeset -gi _PROMPT_CONTEXT_COLUMNS=0
typeset -g _PROMPT_LENS_SEGMENT=''
typeset -g _PROMPT_INTERACTION_SEGMENT=''
typeset -g _PROMPT_INPUT_SEGMENT=''
typeset -g _PROMPT_VIEW=compact
typeset -g _PROMPT_LENS_REASON=''
typeset -gi _PROMPT_LENS_PINNED=0
typeset -gi _PROMPT_INTERACTION_ACTIVE=0
typeset -g _PROMPT_INTERACTION_KIND=ready
typeset -ga _PROMPT_INTERACTION_LABELS=()
typeset -ga _PROMPT_INTERACTION_VALUES=()
typeset -ga _PROMPT_INTERACTION_ROLES=()
if (( ${+_PROMPT_LAST_OUTCOME_TEXT} )); then
  typeset -g _PROMPT_LAST_OUTCOME_TEXT
  typeset -g _PROMPT_LAST_OUTCOME_ROLE
else
  typeset -g _PROMPT_LAST_OUTCOME_TEXT=''
  typeset -g _PROMPT_LAST_OUTCOME_ROLE=''
fi
typeset -gi _PROMPT_CONTEXT_READY=0
typeset -g _PROMPT_LAST_PROJECT_ROOT=''
typeset -g _PROMPT_LAST_GIT_BRANCH=''
typeset -g _PROMPT_LAST_ENVIRONMENT=''
typeset -g _PROMPT_LAST_GIT_ATTENTION=''
typeset -g _PROMPT_LAST_PROJECT_ATTENTION=''
typeset -ga _PROMPT_PROJECT_ITEMS=()
typeset -ga _PROMPT_PROJECT_ITEM_WIDTHS=()
typeset -gA _PROMPT_GIT_DIR_CACHE=()
# Sanitize dynamic text and preserve it literally through any prompt options the
# user enabled. PROMPT_SUBST would otherwise make draft `$()` or backticks
# executable when ZLE paints the prompt; PROMPT_BANG would rewrite `!`.
_prompt_escape() {
  (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$1" || REPLY=${(V)1}
  if [[ -o promptsubst ]]; then
    REPLY=${REPLY//\\/\\\\}
    REPLY=${REPLY//\$/\\\$}
    REPLY=${REPLY//\`/\\\`}
  fi
  [[ -o promptbang ]] && REPLY=${REPLY//\!/!!}
  REPLY=${REPLY//\%/%%}
}

# Keep only a bounded visible prefix. This is used for an already-painted
# autosuggestion: preserving its distant tail would disclose history text that
# ZLE has not otherwise revealed beside the current BUFFER.
_prompt_prefix_abbreviate() {
  emulate -L zsh
  setopt localoptions multibyte
  local text=$1 marker='…'
  local -i max_width=$2 total_width=${(m)#text}

  if (( max_width <= 0 )); then
    REPLY=''
    return
  fi
  if (( total_width <= max_width )); then
    REPLY=$text
    return
  fi
  if (( max_width <= ${(m)#marker} )); then
    REPLY=$marker
    return
  fi

  REPLY=''
  (( $+functions[_compozsh_cell_prefix] )) &&
    _compozsh_cell_prefix "$text" $(( max_width - ${(m)#marker} ))
  REPLY+=$marker
}

# Called by custom project-context functions to append a safe, colored item.
unalias prompt_add_project_segment 2>/dev/null
prompt_add_project_segment() {
  emulate -L zsh
  setopt localoptions multibyte
  (( $# >= 1 )) || return 2
  local text=$1 color=${2:-} rendered='' safe_text=''

  # A custom color becomes prompt syntax, so accept only the bounded numeric
  # palette contract and Zsh's fixed basic color names. Malformed extension
  # input falls back through the same validated role as an omitted color.
  if [[ -z $color ||
        $color != (<0-255>|black|red|green|yellow|blue|magenta|cyan|white|default) ]]; then
    REPLY=''
    (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt tool || :
    color=$REPLY
  fi

  _prompt_escape "$text"
  rendered=$REPLY
  [[ -n $color ]] && rendered="%F{${color}}${rendered}%f"
  _PROMPT_PROJECT_EXTRA_SEGMENTS+=("$rendered")
  (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$text" || REPLY=${(V)text}
  safe_text=$REPLY
  _PROMPT_PROJECT_EXTRA_WIDTHS+=("${(m)#safe_text}")
  REPLY=$rendered
}


# Avoid launching Git in ordinary directories. Standard repositories,
# submodules, and linked worktrees all expose a .git directory or file in an
# ancestor; explicit Git environments still defer discovery to Git itself.
# REPLY names the nearest .git marker, or is empty for an explicit environment.
_prompt_has_git_context() {
  emulate -L zsh

  REPLY=''
  [[ -n ${GIT_DIR:-} || -n ${GIT_WORK_TREE:-} ]] && return 0

  local dir=$1
  while [[ -n $dir ]]; do
    if [[ -e "$dir/.git" ]]; then
      REPLY="$dir/.git"
      return 0
    fi
    [[ $dir == / ]] && break
    dir=${dir:h}
  done
  return 1
}

# Render a compact Git summary. Porcelain v2 gives branch and file state in one
# Git call. The metadata directory is resolved once per working directory and
# nearest .git marker, so operation checks do not require another Git process
# on every prompt, and a repository initialized inside a visited folder is not
# served the enclosing repository's metadata.
_prompt_git() {
  setopt localoptions noglobsubst

  local git_output line branch='' oid='' upstream=''
  local separator=$'\x1f'
  local git_dir operation='' cache_key=''
  local summary=''
  local color=''
  REPLY=''
  (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt success || :
  color=$REPLY
  local -i staged=0 modified=0 untracked=0 conflicted=0 ahead=0 behind=0 stash=0
  local -i detached=0
  local -a fields indicators filter_config
  local ahead_text='' behind_text='' stash_text=''

  REPLY=''
  _PROMPT_GIT_TEXT=''
  _PROMPT_GIT_COLOR=$color
  _PROMPT_GIT_BRANCH_TEXT=''
  _PROMPT_GIT_UPSTREAM_TEXT=''
  _PROMPT_GIT_OPERATION_TEXT=''
  _PROMPT_GIT_ATTENTION=''
  _prompt_has_git_context "$PWD" || return
  # Keep PWD as well: a relative GIT_DIR or GIT_WORK_TREE resolves against it.
  cache_key="${PWD}${separator}${REPLY}${separator}${GIT_DIR:-}${separator}${GIT_WORK_TREE:-}"
  (( ${+functions[_compozsh_git_filter_config]} &&
     ${+functions[_compozsh_git_operation]} )) || return
  _compozsh_git_filter_config "$PWD" clean || return
  filter_config=("${reply[@]}")
  # Prompt rendering is passive: suppress repository-controlled fsmonitor,
  # hook, and content-filter commands as well as lazy network fetches.
  git_output=$(GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
    GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
    -c core.fsmonitor=false -c core.untrackedCache=false \
    -c core.hooksPath=/dev/null "${filter_config[@]}" status \
    --porcelain=v2 --branch --show-stash 2>/dev/null) || return

  # Split in memory: Zsh backs here-strings with temporary files, and this
  # output names changed and untracked paths.
  for line in "${(@f)git_output}"; do
    case $line in
      '# branch.oid '*)
        oid=${line#\# branch.oid }
        ;;
      '# branch.head '*)
        branch=${line#\# branch.head }
        ;;
      '# branch.upstream '*)
        upstream=${line#\# branch.upstream }
        ;;
      '# branch.ab '*)
        # Validate Git's counts as text: integer assignment evaluates
        # arithmetic, including $(...) in a subscript.
        fields=(${(s: :)line})
        ahead_text=${fields[3]-} behind_text=${fields[4]-}
        if [[ $ahead_text == +<-> && ${#ahead_text} -le 19 &&
              $behind_text == -<-> && ${#behind_text} -le 19 ]]; then
          ahead=${ahead_text#+} behind=${behind_text#-}
        fi
        ;;
      '# stash '*)
        stash_text=${line#\# stash }
        [[ $stash_text == <-> && ${#stash_text} -le 18 ]] && stash=$stash_text
        ;;
      '1 '*|'2 '*)
        [[ ${line[3]} != '.' ]] && (( staged++ ))
        [[ ${line[4]} != '.' ]] && (( modified++ ))
        ;;
      'u '*)
        (( conflicted++ ))
        ;;
      '? '*)
        (( untracked++ ))
        ;;
    esac
  done

  if [[ $branch == '(detached)' ]]; then
    branch="@${oid[1,7]}"
    REPLY=''
    (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt detached || :
    color=$REPLY
    detached=1
  elif [[ -z $branch ]]; then
    branch='unknown'
  fi

  if (( ${+_PROMPT_GIT_DIR_CACHE[$cache_key]} )) &&
     [[ -d ${_PROMPT_GIT_DIR_CACHE[$cache_key]} ]]; then
    git_dir=${_PROMPT_GIT_DIR_CACHE[$cache_key]}
  else
    git_dir=$(GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
      GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
      -c core.fsmonitor=false -c core.hooksPath=/dev/null \
      rev-parse --absolute-git-dir 2>/dev/null)
    [[ -n $git_dir ]] && _PROMPT_GIT_DIR_CACHE[$cache_key]=$git_dir
  fi
  if [[ -n $git_dir ]]; then
    _compozsh_git_operation "$git_dir" 0
    operation=$REPLY
  fi

  (( staged ))     && indicators+=("+${staged}")
  (( modified ))   && indicators+=("!${modified}")
  (( untracked ))  && indicators+=("?${untracked}")
  (( conflicted )) && indicators+=("x${conflicted}")
  (( stash ))      && indicators+=("≡${stash}")
  (( ahead ))      && indicators+=("⇡${ahead}")
  (( behind ))     && indicators+=("⇣${behind}")
  [[ -n $operation ]] && indicators+=("⚡${operation}")
  (( !detached )) && [[ -z $upstream ]] && indicators+=('no-upstream')

  if (( conflicted )) || [[ -n $operation ]]; then
    REPLY=''
    (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt danger || :
    color=$REPLY
  elif (( staged || modified || untracked )); then
    REPLY=''
    (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt warning || :
    color=$REPLY
  elif (( behind )); then
    REPLY=''
    (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt info || :
    color=$REPLY
  fi

  if (( ${#indicators} == 0 )); then
    summary="${branch} ✓"
  else
    summary="${branch} ${(j: :)indicators}"
  fi

  _PROMPT_GIT_TEXT=$summary
  _PROMPT_GIT_COLOR=$color
  _PROMPT_GIT_BRANCH_TEXT=$branch
  _PROMPT_GIT_UPSTREAM_TEXT=$upstream
  _PROMPT_GIT_OPERATION_TEXT=$operation
  if (( conflicted )) || [[ -n $operation ]]; then
    _PROMPT_GIT_ATTENTION="operation:${operation}|conflict:$(( conflicted > 0 ))"
  fi
  _prompt_escape "$summary"
  REPLY="%F{${color:-default}}${REPLY}%f"
}

# Render sanitized text to a bounded visible width. `reply` returns the styled
# prompt string followed by its plain visible text so callers never count color
# escapes as columns.
_prompt_render_abbreviated() {
  emulate -L zsh
  setopt localoptions multibyte
  local role=$1 text=$2 bias=${4:-tail}
  local -i max_width=$3
  local plain='' styled=''

  (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$text" || REPLY=${(V)text}
  plain=$REPLY
  REPLY=$plain
  if (( ${+functions[_zle_picker_abbreviate]} )); then
    _zle_picker_abbreviate "$plain" "$max_width" "$bias"
  elif (( max_width <= 0 )); then
    REPLY=''
  elif (( ${(m)#plain} > max_width )); then
    REPLY=…
  fi
  plain=$REPLY
  _prompt_escape "$plain"
  if [[ $role == git ]]; then
    styled="%F{${_PROMPT_GIT_COLOR:-default}}${REPLY}%f"
  else
    _prompt_color_text "$role" "$REPLY"
    styled=$REPLY
  fi
  reply=("$styled" "$plain")
}

# Return one semantic lens row. Labels and dynamic values are styled only after
# the raw value has been sanitized, abbreviated, and measured.
_prompt_lens_row() {
  emulate -L zsh
  local label=$1 text=$2 role=$3 prefix=''
  local -i value_width=$(( ${4:-80} - 13 ))

  (( value_width > 0 )) || return 1
  _prompt_render_abbreviated "$role" "$text" "$value_width" tail
  [[ -n $reply[2] ]] || return 1
  _prompt_color_text frame "│  ${(r:9:)label}"
  prefix=$REPLY
  REPLY="${prefix} ${reply[1]}"
}

# Project items are already safe prompt strings with separately captured
# visible widths. Fit a prefix of them without reading providers during resize.
_prompt_lens_toolchain_row() {
  emulate -L zsh
  local label=TOOLCHAIN prefix='' row='' separator=''
  local -i line_limit=${1:-80} label_width=${3:-9}
  local -i available=$(( line_limit - label_width - 4 ))
  local -i index=0 used=0 item_width=0

  (( available > 0 && ${#_PROMPT_PROJECT_ITEMS} )) || return 1
  for (( index = 1; index <= ${#_PROMPT_PROJECT_ITEMS}; index++ )); do
    item_width=${_PROMPT_PROJECT_ITEM_WIDTHS[index]:-0}
    separator=$(( used > 0 ? 3 : 0 ))
    (( used + separator + item_width <= available )) || break
    (( used > 0 )) && row+=' · '
    row+="${_PROMPT_PROJECT_ITEMS[index]}"
    (( used += separator + item_width ))
  done
  if [[ -z $row ]]; then
    _prompt_color_text tool '…'
    row=$REPLY
  fi
  _prompt_color_text frame "  ${(r:$label_width:)label}"
  prefix=$REPLY
  _prompt_color_text "${2:-frame}" '│'
  REPLY="${REPLY}${prefix} ${row}"
}

# Append one raw Interaction-lens row. Values remain literal/captured data until
# layout sanitizes, bounds, escapes, and styles them.
_prompt_interaction_add() {
  [[ -n $2 ]] || return 1
  _PROMPT_INTERACTION_LABELS+=("$1")
  _PROMPT_INTERACTION_VALUES+=("$2")
  _PROMPT_INTERACTION_ROLES+=("${3:-info}")
}



# Return whether one recognized option consumes the following lexical word.
# This is deliberately small and conservative: its only purpose is to avoid
# presenting an option value as a search query or remote endpoint.
_prompt_interaction_option_takes_value() {
  emulate -L zsh
  local command_name=$1 option=$2

  case $command_name in
    rg)
      case $option in
        -A|-B|-C|-E|-e|-f|-g|-j|-M|-m|-r|-t|-T|--after-context|\
        --before-context|--context|--dfa-size-limit|--encoding|--engine|\
        --file|--glob|--iglob|--max-columns|--max-columns-preview|\
        --max-count|--max-depth|--mmap|--path-separator|--pre|--pre-glob|\
        --regex-size-limit|--regexp|--replace|--sort|--sortr|--type|\
        --type-add|--type-clear)
          return 0
          ;;
      esac
      ;;
    grep|egrep|fgrep)
      case $option in
        -A|-B|-C|-D|-d|-e|-f|-m|--after-context|--before-context|\
        --binary-files|--context|--directories|--devices|--exclude|\
        --exclude-from|--exclude-dir|--include|--label|--max-count|\
        --regexp|--file)
          return 0
          ;;
      esac
      ;;
    ssh|sftp)
      case $option in
        -B|-b|-c|-D|-E|-e|-F|-I|-i|-J|-L|-l|-m|-O|-o|-p|-Q|-R|\
        -S|-W|-w)
          return 0
          ;;
      esac
      ;;
    scp)
      case $option in
        -c|-D|-F|-i|-J|-l|-o|-P|-S|-X)
          return 0
          ;;
      esac
      ;;
    rsync)
      case $option in
        -B|-e|-f|-M|-T|--backup-dir|--block-size|--bwlimit|--checksum-choice|\
        --chmod|--compare-dest|--compress-choice|--compress-level|--copy-as|\
        --debug|--exclude|--exclude-from|--files-from|--filter|--groupmap|\
        --iconv|--include|--include-from|--info|--link-dest|--log-file|\
        --log-file-format|--max-alloc|--max-delete|--max-size|--min-size|\
        --modify-window|--out-format|--password-file|--port|--protocol|\
        --remote-option|--rsync-path|--skip-compress|--suffix|--temp-dir|\
        --timeout|--usermap)
          return 0
          ;;
      esac
      ;;
  esac
  return 1
}

# Add the smallest useful captured anchor after operation-specific rows.
_prompt_interaction_add_context() {
  if [[ -n $_PROMPT_PROJECT_NAME_TEXT ]]; then
    _prompt_interaction_add PROJECT "$_PROMPT_PROJECT_NAME_TEXT" project
  elif [[ -n $_PROMPT_FULL_PATH_TEXT ]]; then
    _prompt_interaction_add PATH "$_PROMPT_FULL_PATH_TEXT" path
  fi
  [[ -n $_PROMPT_GIT_TEXT && $_PROMPT_INTERACTION_KIND != git ]] &&
    _prompt_interaction_add GIT "$_PROMPT_GIT_TEXT" git
}

# Return bounded alias observations as token-index/name/kind/definition tuples.
# Positions follow literal shell structure; definitions are never evaluated or
# recursively substituted into the draft. Quoting and native suppression win.
_prompt_alias_expansions() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local token='' plain='' kind='' definition='' suffix='' last=''
  local -i index=0 expected=1 suppressed=0 redirect=0 trailing=0 skip_word=0
  reply=()
  for token in "$@"; do
    (( ++index ))
    (( $#reply < 32 )) || break
    plain=${(Q)token}
    case $token in
      '|'|'|&'|'&&'|'||'|';'|'&'|'('|')'|'{'|'}'|$'\n')
        expected=1 suppressed=0 redirect=0 trailing=0 skip_word=0
        continue ;;
      \#*) continue ;;
    esac
    if _compozsh_is_redirection "$token"; then
      # Here-document bodies are literal input, not command positions.
      [[ $token == *'<<'* ]] && break
      redirect=1
      continue
    fi
    if (( skip_word )); then
      skip_word=0
      continue
    fi
    if (( expected && !redirect )) && _compozsh_is_assignment "$token"; then
      continue
    fi
    kind='' definition='' last=''
    if [[ $token == "$plain" ]]; then
      if (( !redirect && !suppressed && (expected || trailing) && ${+aliases[$plain]} )); then
        kind='Shell alias' definition=${aliases[$plain][1,241]} last=${aliases[$plain][-1]}
      elif (( ${+galiases[$plain]} )); then
        kind='Shell global alias' definition=${galiases[$plain][1,241]} last=${galiases[$plain][-1]}
      elif (( expected && !redirect && !suppressed )); then
        suffix=${plain:e}
        if [[ -n $suffix ]] && (( ${+saliases[$suffix]} )); then
          kind='Shell suffix alias' definition=${saliases[$suffix][1,241]}
        fi
      fi
    fi
    trailing=0
    if [[ -n $kind ]]; then
      [[ $last == [[:blank:]] ]] && trailing=1
      [[ -n $definition ]] && (( !redirect )) && expected=0
      (( ${#definition} > 240 )) && definition="${definition[1,239]}…"
      reply+=("$index" "$plain" "$kind" "${definition:-\"\"}")
    elif (( expected && !redirect )) && [[ $token == "$plain" ]]; then
      case $plain in
        if|then|elif|else|do|while|until|time|coproc|'!') continue ;;
        repeat|function) skip_word=1; continue ;;
        command|builtin|exec|noglob|nocorrect) suppressed=1; continue ;;
        -*) (( suppressed )) && continue ;;
      esac
      expected=0
    elif (( !redirect )); then
      expected=0
    fi
    redirect=0
  done
}

# Return each pipeline or chain command's head word index in order, 0 when a
# command has none. Leading assignments, native precommand modifiers (env with
# its options and NAME=value operands included) and their options, redirections
# with their targets, and comments never name the command. Pure: lexer words
# in, reply out; nothing is expanded, resolved or evaluated.
_prompt_command_heads() {
  emulate -L zsh
  local word='' plain=''
  local -i index=0 head=0 precommand=0 env_options=0 skip_word=0
  reply=()
  for word in "$@"; do
    (( ++index ))
    plain=${(Q)word}
    case $plain in
      '|'|'|&'|'&&'|'||'|';'|'&')
        reply+=("$head")
        head=0 precommand=0 env_options=0 skip_word=0
        continue
        ;;
    esac
    (( head )) && continue
    if (( skip_word )); then
      skip_word=0
      continue
    fi
    [[ $word == \#* ]] && continue
    # Cheap literal guards keep predicate calls off most keystroke words.
    if [[ $plain == *[\<\>]* ]] && _compozsh_is_redirection "$plain"; then
      skip_word=1
      continue
    fi
    [[ $word == *=* ]] && _compozsh_is_assignment "$word" && continue
    if (( env_options )); then
      case $plain in
        -u|--unset|-C|--chdir|-S|--split-string)
          skip_word=1
          continue
          ;;
      esac
    fi
    case $plain in
      command|builtin|exec|noglob|nocorrect|time)
        precommand=1
        continue
        ;;
      env)
        precommand=1 env_options=1
        continue
        ;;
    esac
    (( precommand )) && [[ $plain == -* ]] && continue
    head=$index
  done
  reply+=("$head")
}

# Derive an interaction model from literal editor text and already-captured
# prompt/editor facts. Zsh's lexer identifies structure without evaluating,
# expanding, resolving, or executing anything from BUFFER.
#
# The model runs as ordered steps — lex, heads, classify, rows, enrich — that
# share the facts declared here through Zsh's dynamic scope instead of copying
# tokens between calls. Each step reads only facts earlier steps captured,
# writes only the facts it owns (named in its comment) and keeps its scratch
# words local. Like the model, every step is provider-free.
_prompt_interaction_model() {
  local alias_enabled=${_prompt_alias_enabled:-${options[aliases]}}
  emulate -L zsh
  setopt localoptions extendedglob multibyte

  local buffer=$1 bounded_buffer='' interaction_view=''
  # Lexical facts (lex).
  local -a tokens=() plain_tokens=() alias_records=()
  local -i token_count=0 autocd=0
  # Head facts (heads).
  local command_name='' command_lower='' assignment_name=''
  local operation='' operation_lower='' first_operand='' last_operand=''
  local redirect_operator='' redirect_text=''
  local redirect_label='OUTPUT TEXT'
  local redirect_action='likely redirect command output'
  local -a command_heads=() flow_heads=() flow_operators=()
  local -i command_index=0 operation_index=0 pipe_count=0 chain_count=0
  # View facts (classify).
  local comment_text='' caution_command='' action='' task_operation=''
  local task_text='' query_text='' remote_text='' environment_text=''
  [[ -n ${_ZLE_AUTOCD_BUFFER:-} &&
     ${_ZLE_AUTOCD_BUFFER:-} == "$buffer" &&
     ${_ZLE_AUTOCD_PWD:-} == "$PWD" ]] && autocd=1

  _PROMPT_INTERACTION_KIND=ready
  _PROMPT_INTERACTION_LABELS=()
  _PROMPT_INTERACTION_VALUES=()
  _PROMPT_INTERACTION_ROLES=()

  # Work from a fixed prefix regardless of paste size. The complete BUFFER
  # remains owned by ZLE and is never copied into interaction state.
  bounded_buffer=${buffer[1,512]}
  if (( ${#buffer} > 512 )) &&
     [[ -z ${bounded_buffer//[[:space:]]/} ]]; then
    _PROMPT_INTERACTION_KIND=run interaction_view=overflow
  elif [[ -z ${bounded_buffer//[[:space:]]/} ]]; then
    interaction_view=ready
  elif (( ! ${+functions[_compozsh_is_assignment]} ||
          ! ${+functions[_compozsh_is_redirection]} )); then
    # Without lexical support, do not misidentify assignment values as
    # commands or disclose arguments whose role cannot be established.
    _PROMPT_INTERACTION_KIND=run interaction_view=unavailable
  else
    _prompt_interaction_lex
    _prompt_interaction_heads
    _prompt_interaction_classify
  fi
  _prompt_interaction_rows
  # Only a draft that names a command gains descriptions and editor rows.
  case $interaction_view in
    overflow|ready|unavailable|comment|assignment) ;;
    *) _prompt_interaction_enrich ;;
  esac
  return 0
}

# Lex step: split the bounded draft into at most 64 literal words, their
# unquoted plain forms and the current alias references among them.
# Writes tokens, plain_tokens, token_count and alias_records.
_prompt_interaction_lex() {
  emulate -L zsh
  setopt localoptions extendedglob multibyte

  tokens=("${(@Z+c+)bounded_buffer}") 2>/dev/null
  if (( ! ${#tokens} )); then
    tokens=("${bounded_buffer%%[[:space:]]*}")
  elif (( ${#tokens} > 64 )); then
    tokens=("${tokens[@]:0:64}")
  fi
  token_count=${#tokens}
  plain_tokens=("${(@Q)tokens}")
  alias_records=()
  if [[ $alias_enabled == on ]]; then
    _prompt_alias_expansions "${tokens[@]}"
    alias_records=("${reply[@]}")
  fi
}

# Heads step: find the command each pipeline or chain stage names, the
# draft's own head, its first semantic word and literal operands, the visible
# connectors and the last literal redirection. Writes the head facts; a draft
# of assignments alone keeps command_index 0 and records only the first
# assignment's name.
_prompt_interaction_heads() {
  emulate -L zsh
  setopt localoptions extendedglob multibyte
  local plain=''
  local -i index=0 skip_next=0

  # Every pipeline and chain command finds its head by the same lexical rule.
  # The first head names the draft. Assignment values are never copied into
  # presentation state.
  _prompt_command_heads "${tokens[@]}"
  command_heads=("${reply[@]}")
  plain=${plain_tokens[1]}
  # A literal alias named env/command/etc. is the head itself, not evidence
  # that the draft uses the native precommand form. Enrich reads its definition.
  if [[ $alias_enabled == on && ${tokens[1]} == "$plain" ]] &&
     (( ${+aliases[$plain]} || ${+galiases[$plain]} )); then
    command_index=1
  else
    for index in "${command_heads[@]}"; do
      (( index )) || continue
      command_index=$index
      break
    done
  fi
  # Without a head, a draft other than assignments alone keeps its first
  # literal word (such as a bare redirection) as the command.
  for (( index = 1; !command_index && index <= token_count; index++ )); do
    plain=${plain_tokens[index]}
    if _compozsh_is_assignment "${tokens[index]}"; then
      [[ -z $assignment_name ]] && assignment_name=${plain%%=*}
      continue
    fi
    [[ $plain == ('|'|'|&'|'&&'|'||'|';'|'&') ]] || command_index=$index
  done
  (( command_index )) || return 0
  command_name=${plain_tokens[command_index]}
  # Command and subcommand names remain case-sensitive, just like Zsh.
  command_lower=$command_name
  # An observed directory is not an executable with a familiar tool name.
  (( autocd )) && command_lower=''

  # Capture the first semantic word and literal operands without interpreting
  # option values or shell expansions.
  for (( index = command_index + 1; index <= token_count; index++ )); do
    plain=${plain_tokens[index]}
    case $plain in
      '|'|'|&'|'&&'|'||'|';'|'&') continue ;;
    esac
    _compozsh_is_assignment "${tokens[index]}" && continue
    _compozsh_is_redirection "$plain" && continue
    if [[ -z $operation && $plain != -* ]]; then
      operation=$plain
      operation_index=$index
    fi
    if [[ $plain != -* ]]; then
      [[ -z $first_operand ]] && first_operand=$plain
      last_operand=$plain
    fi
  done
  # Git accepts global options before its subcommand. Skip the small native
  # set with separate operands so `git -C repo status` still reads as status.
  if [[ $command_lower == (git|g) ]]; then
    operation=''
    operation_index=0
    skip_next=0
    for (( index = command_index + 1; index <= token_count; index++ )); do
      plain=${plain_tokens[index]}
      if (( skip_next )); then
        skip_next=0
        continue
      fi
      if [[ $plain == --help ||
            ( $command_lower == g && $plain == (--review|--discard-all) &&
              ${plain_tokens[index + 1]:-} == --help ) ]]; then
        operation=help
        operation_index=$index
        break
      fi
      if [[ $command_lower == g && $plain == (--review|--worktree|--discard-all) ]]; then
        operation=${plain#--}
        operation_index=$index
        break
      fi
      case $plain in
        -C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env)
          skip_next=1
          continue
          ;;
        --git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--config-env=*|-*)
          continue
          ;;
        --)
          continue
          ;;
      esac
      operation=$plain
      operation_index=$index
      break
    done
    [[ $command_lower == g && -z $operation ]] && operation=branches
  fi
  operation_lower=$operation

  # Capture command heads and their literal connectors across both pipelines
  # and conditional/sequential chains. Mixed forms retain the whole visible
  # plan instead of dropping everything after the first pipeline.
  flow_heads=("$command_name")
  for index in "${command_heads[@]:1}"; do
    (( index )) && flow_heads+=("${plain_tokens[index]}")
  done
  for (( index = 1; index <= token_count; index++ )); do
    plain=${plain_tokens[index]}
    if [[ $plain == ('|'|'|&') ]]; then
      (( ++pipe_count ))
      flow_operators+=("$plain")
      continue
    fi
    if [[ $plain == ('&&'|'||'|';'|'&') ]]; then
      (( ++chain_count ))
      flow_operators+=("$plain")
      continue
    fi
    if [[ $plain == *[\<\>]* ]] && _compozsh_is_redirection "$plain"; then
      redirect_operator=$plain
      if (( index < token_count )); then
        redirect_text=${plain_tokens[index + 1]}
      fi
    fi
  done

  if [[ -n $redirect_operator ]]; then
    case ${redirect_operator##[0-9]##} in
      '<&'|'>&'|'>&|'|'>&!')
        redirect_label='DESCRIPTOR TEXT'
        redirect_action='likely duplicate or close a shell file descriptor'
        ;;
      '<'|'<<'|'<<-'|'<<<')
        redirect_label='INPUT TEXT'
        redirect_action='likely redirect command input'
        ;;
      '<>')
        redirect_label='RESOURCE TEXT'
        redirect_action='likely open literal redirection input and output'
        ;;
    esac
  fi
}

# Classify step: the first matcher in this ordered list that accepts the
# draft names its kind — the engineering/prompt.md "Adding an Interaction
# kind" precedence; RUN accepts every draft. Alias handling follows in the
# enrich step. Writes _PROMPT_INTERACTION_KIND, interaction_view (the row
# shape) and the literal view facts those rows show, all through the
# accepting matcher.
#
# A matcher reads the lex and heads facts, inherits this step's emulation and
# keeps its scratch words local. It accepts (status 0) only when the draft
# carries its kind's evidence, and then writes the kind, the view and its own
# view facts; it declines with status 1 and writes nothing, so one matcher can
# be added, moved or tested alone. Precedence lives only in this list: a
# matcher needn't repeat the evidence of the matchers above it.
_prompt_interaction_classify() {
  emulate -L zsh
  setopt localoptions extendedglob multibyte

  _prompt_interaction_match_comment ||
    _prompt_interaction_match_assignment ||
    _prompt_interaction_match_caution ||
    _prompt_interaction_match_chain ||
    _prompt_interaction_match_pipeline ||
    _prompt_interaction_match_redirect ||
    _prompt_interaction_match_task ||
    _prompt_interaction_match_remote ||
    _prompt_interaction_match_git ||
    _prompt_interaction_match_navigate ||
    _prompt_interaction_match_search ||
    _prompt_interaction_match_environment ||
    _prompt_interaction_match_test ||
    _prompt_interaction_match_build ||
    _prompt_interaction_match_run
  return 0
}

# A leading comment word. Writes comment_text.
_prompt_interaction_match_comment() {
  [[ ${tokens[1]} == \#* ]] || return 1
  _PROMPT_INTERACTION_KIND=comment interaction_view=comment
  comment_text=${plain_tokens[1]#\#}
  comment_text=${comment_text# }
}

# Assignments alone: no stage names a command head.
_prompt_interaction_match_assignment() {
  (( ! command_index )) || return 1
  _PROMPT_INTERACTION_KIND=environment interaction_view=assignment
}

# A few recognizable, high-confidence destructive forms in any stage. Writes
# caution_command when a named head or owned destructive mode carries the cue.
_prompt_interaction_match_caution() {
  local token='' cue_command=''
  local -i caution=0

  case $command_lower in
    rm|rmdir|dd|eval|kill|pkill)
      caution=1 cue_command=$command_name
      ;;
  esac
  if (( ! caution && ${#flow_heads} > 1 )); then
    for token in "${flow_heads[@]:1}"; do
      case $token in
        rm|rmdir|dd|eval|kill|pkill)
          caution=1 cue_command=$token
          break
          ;;
      esac
    done
  fi
  if [[ $command_lower == external-device ]] &&
     (( ! ${plain_tokens[(Ie)--help]} )) &&
     (( ${plain_tokens[(Ie)--flash]} || ${plain_tokens[(Ie)--format]} )); then
    caution=1 cue_command=$command_name
  fi
  if [[ $command_lower == (git|g) ]]; then
    case $operation_lower in
      discard-all) caution=1 ;;
      reset)
        (( ${plain_tokens[(Ie)--hard]} )) && caution=1
        ;;
      clean)
        if (( ! ${plain_tokens[(Ie)-n]} &&
              ! ${plain_tokens[(Ie)--dry-run]} )); then
          caution=1
        fi
        ;;
      push)
        if (( ${plain_tokens[(Ie)-f]} ||
              ${plain_tokens[(Ie)--force]} ||
              ${plain_tokens[(Ie)--force-with-lease]} )); then
          caution=1
        fi
        ;;
      branch)
        (( ${plain_tokens[(Ie)-D]} )) && caution=1
        ;;
    esac
  fi
  (( caution )) || return 1
  _PROMPT_INTERACTION_KIND=caution interaction_view=caution
  caution_command=$cue_command
}

# A conditional or sequential connector between stages.
_prompt_interaction_match_chain() {
  (( chain_count )) || return 1
  _PROMPT_INTERACTION_KIND=chain interaction_view=chain
}

# A pipe between stages.
_prompt_interaction_match_pipeline() {
  (( pipe_count )) || return 1
  _PROMPT_INTERACTION_KIND=pipeline interaction_view=pipeline
}

# A literal redirection operator.
_prompt_interaction_match_redirect() {
  [[ -n $redirect_operator ]] || return 1
  _PROMPT_INTERACTION_KIND=redirect interaction_view=redirect
}

# Owned task entries share the run kind unless they change environment; bare
# xcode is a task entry, not a build. Writes action and task_operation.
_prompt_interaction_match_task() {
  [[ $command_lower == (compozsh|external-device) ]] ||
    { [[ $command_lower == xcode ]] &&
      (( token_count == command_index || ${plain_tokens[(Ie)--export-skills]} || ${plain_tokens[(Ie)--help]} )); } ||
    return 1
  _PROMPT_INTERACTION_KIND=run interaction_view=task
  action='likely open a task workspace' task_operation=''
  if (( ${plain_tokens[(Ie)--help]} )) ||
     [[ $command_lower == compozsh && $first_operand == help ]]; then
    action='likely show task help'
    task_operation=help
    (( ${plain_tokens[(Ie)--help]} )) && task_operation=--help
  elif [[ $command_lower == xcode ]] && (( ${plain_tokens[(Ie)--export-skills]} )); then
    _PROMPT_INTERACTION_KIND=environment
    task_operation=--export-skills
    action='likely review or export Apple skills for local agents'
  elif [[ $command_lower == compozsh ]] && (( ${plain_tokens[(Ie)--sudo-touch-id]} )); then
    _PROMPT_INTERACTION_KIND=environment
    task_operation=--sudo-touch-id
    action='likely inspect or manage Touch ID authentication for sudo'
  elif [[ $command_lower == compozsh ]] && (( ${plain_tokens[(Ie)--refresh]} )); then
    _PROMPT_INTERACTION_KIND=environment
    task_operation=--refresh
    action='likely refresh this shell’s cached capabilities'
  elif [[ $command_lower == compozsh ]] && (( ${plain_tokens[(Ie)--list]} )); then
    task_operation=--list
    action='likely list loaded Compozsh tools'
  else
    case $command_lower in
      xcode) action='likely open the Xcode action workspace' ;;
      external-device) action='likely open the external-device task chooser' ;;
      compozsh) action='likely explore loaded tools and their help' ;;
    esac
  fi
  return 0
}

# A familiar remote client. Writes remote_text: the first literal target,
# reduced to scheme://host for a URL, never an option value.
_prompt_interaction_match_remote() {
  [[ $command_lower == (ssh|scp|sftp|rsync|curl|wget) ]] || return 1
  local plain='' endpoint_scheme='' endpoint_authority=''
  local -i index=0 skip_next=0 saw_option=0

  _PROMPT_INTERACTION_KIND=remote interaction_view=remote
  case $command_lower in
    ssh|sftp)
      for (( index = command_index + 1; index <= token_count; index++ )); do
        plain=${plain_tokens[index]}
        if (( skip_next )); then
          skip_next=0
          continue
        fi
        if _prompt_interaction_option_takes_value "$command_lower" "$plain"; then
          skip_next=1
          continue
        fi
        [[ $plain == -- ]] && continue
        [[ $plain == -* ]] && continue
        remote_text=$plain
        break
      done
      ;;
    scp|rsync)
      for (( index = command_index + 1; index <= token_count; index++ )); do
        plain=${plain_tokens[index]}
        if (( skip_next )); then
          skip_next=0
          continue
        fi
        if _prompt_interaction_option_takes_value "$command_lower" "$plain"; then
          skip_next=1
          continue
        fi
        [[ $plain == -* ]] && continue
        if [[ $plain == *://* || $plain == [^/]##:* ||
              $plain == *@*:* ]]; then
          remote_text=$plain
          break
        fi
      done
      ;;
    curl|wget)
      for (( index = command_index + 1; index <= token_count; index++ )); do
        plain=${plain_tokens[index]}
        if [[ $plain == -* ]]; then
          saw_option=1
          continue
        fi
        if [[ $plain == *://* ]]; then
          remote_text=$plain
          continue
        fi
        (( ! saw_option )) && [[ -z $remote_text ]] && remote_text=$plain
      done
      # Curl and wget have large evolving option grammars. With any option
      # present, omit the excerpt rather than risk repeating a header, token,
      # output file, or other option value under a misleading endpoint label.
      (( saw_option )) && remote_text=''
      ;;
  esac
  if [[ -n $remote_text && $remote_text == *://* ]]; then
    endpoint_scheme=${remote_text%%://*}
    endpoint_authority=${remote_text#*://}
    endpoint_authority=${endpoint_authority%%/*}
    endpoint_authority=${endpoint_authority%%\?*}
    endpoint_authority=${endpoint_authority%%\#*}
    endpoint_authority=${endpoint_authority##*@}
    if [[ -n $endpoint_scheme && -n $endpoint_authority ]]; then
      remote_text="${endpoint_scheme}://${endpoint_authority}"
    else
      remote_text=''
    fi
  elif [[ -n $remote_text && $command_lower == (curl|wget) ]]; then
    remote_text=${remote_text%%\?*}
    remote_text=${remote_text%%\#*}
    remote_text=${remote_text##*@}
    remote_text=${remote_text%%/*}
  fi
  return 0
}

# Git or the g workspace entry. Writes action.
_prompt_interaction_match_git() {
  [[ $command_lower == (git|g) ]] || return 1
  _PROMPT_INTERACTION_KIND=git interaction_view=git
  case $operation_lower in
    branches) action='likely open the local recent-branch workspace' ;;
    help) action='likely show Git or Compozsh Git help' ;;
    review) action='likely open the local Git review workspace' ;;
    worktree) action='likely open local Git worktree actions' ;;
    status) action='likely inspect working tree' ;;
    diff|show|log) action='likely review repository history or changes' ;;
    add) action='likely stage selected changes' ;;
    commit) action='likely record staged changes' ;;
    switch|checkout) action='likely change repository position' ;;
    pull|fetch) action='may contact a remote to update repository data' ;;
    push) action='may contact a remote to publish commits' ;;
    merge|rebase|cherry-pick) action='likely integrate repository history' ;;
    *) action='likely run a Git operation' ;;
  esac
  return 0
}

# A directory-changing command or the highlighter's matching AUTO_CD
# observation. Writes action and, for AUTO_CD, first_operand.
_prompt_interaction_match_navigate() {
  [[ $command_lower == (cd|pushd|popd|j|z|mkcd) || $autocd == 1 ]] || return 1
  _PROMPT_INTERACTION_KIND=navigate interaction_view=navigate
  action='likely change shell location · Tab can browse'
  if (( autocd )); then
    first_operand=$command_name
    action='likely change shell location via AUTO_CD · Tab can browse'
  fi
  return 0
}

# A familiar search tool. Writes query_text: find's name or path pattern, or
# another tool's first operand that is not an option value.
_prompt_interaction_match_search() {
  [[ $command_lower == (rg|grep|egrep|fgrep|find|mdfind|ag|ack) ]] || return 1
  local plain=''
  local -i index=0 skip_next=0

  _PROMPT_INTERACTION_KIND=search interaction_view=search
  if [[ $command_lower == find ]]; then
    for (( index = command_index + 1; index < token_count; index++ )); do
      plain=${plain_tokens[index]}
      if [[ $plain == (-name|-iname|-path|-ipath|-regex|-iregex) ]]; then
        query_text=${plain_tokens[index + 1]}
        break
      fi
    done
    return 0
  fi
  for (( index = command_index + 1; index <= token_count; index++ )); do
    plain=${plain_tokens[index]}
    if (( skip_next )); then
      skip_next=0
      continue
    fi
    if _prompt_interaction_option_takes_value "$command_lower" "$plain"; then
      skip_next=1
      continue
    fi
    [[ $plain == -* ]] && continue
    query_text=$plain
    break
  done
  return 0
}

# An environment manager or shell environment builtin. Writes
# environment_text: the last operand, without an export or unset value.
_prompt_interaction_match_environment() {
  [[ $command_lower == (conda|pyenv|rbenv|nvm|mise|direnv|export|unset|source|.) ]] ||
    return 1
  _PROMPT_INTERACTION_KIND=environment interaction_view=environment
  environment_text=$last_operand
  if [[ $command_lower == (export|unset) && -n $environment_text ]]; then
    environment_text=${environment_text%%=*}
  fi
  return 0
}

# Exact high-signal test forms. Writes task_text: the test operation, a
# filter after it, or the test script.
_prompt_interaction_match_test() {
  local plain='' text=''
  local -i index=0

  if [[ $command_lower == (pytest|bats|rspec|jest|vitest) ]]; then
    text=${operation:-$command_name}
  elif [[ $operation_lower == test &&
          $command_lower == (swift|cargo|go|npm|pnpm|yarn|bun|make|just|task|gradle|mvn|mix|dotnet|xcodebuild) ]]; then
    text=$operation
  elif [[ $command_lower == zsh ]]; then
    for (( index = command_index + 1; index <= token_count; index++ )); do
      plain=${plain_tokens[index]}
      if [[ $plain == *tests/* || $plain == *test*.zsh ]]; then
        text=$plain
        break
      fi
    done
    [[ -n $text ]] || return 1
  else
    return 1
  fi
  if [[ $operation_lower == test ]]; then
    for (( index = operation_index + 1; index < token_count; index++ )); do
      if [[ ${plain_tokens[index]} == (--filter|-F|-t|--test) ]]; then
        text=${plain_tokens[index + 1]}
        break
      fi
    done
  fi
  _PROMPT_INTERACTION_KIND=test interaction_view=test
  task_text=$text
}

# Exact high-signal build forms; TEST above keeps `make test`. Writes
# task_text.
_prompt_interaction_match_build() {
  if [[ $operation_lower == build &&
        $command_lower == (swift|cargo|go|npm|pnpm|yarn|bun|gradle|mvn|mix|dotnet|xcodebuild) ]]; then
    task_text=$operation
  elif [[ $command_lower == (make|cmake|ninja|xcode|xcodebuild) ]]; then
    task_text=${operation:-build}
  else
    return 1
  fi
  _PROMPT_INTERACTION_KIND=build interaction_view=build
}

# Every other draft. Unknown tools remain the neutral RUN lens rather than
# receiving a guessed purpose.
_prompt_interaction_match_run() {
  _PROMPT_INTERACTION_KIND=run interaction_view=run
}

# Rows step: append the classified view's rows, most specific first, then the
# smallest useful captured anchor. Reads the shared facts; writes only rows.
_prompt_interaction_rows() {
  emulate -L zsh
  setopt localoptions extendedglob multibyte

  case $interaction_view in
    overflow)
      _prompt_interaction_add ANALYSIS 'first 512 characters only' warning
      _prompt_interaction_add ACTION \
        'may contain shell structure beyond the lens bound' warning
      ;;
    ready)
      [[ -n $_PROMPT_PROJECT_NAME_TEXT ]] &&
        _prompt_interaction_add PROJECT "$_PROMPT_PROJECT_NAME_TEXT" project
      [[ -n $_PROMPT_FULL_PATH_TEXT ]] &&
        _prompt_interaction_add PATH "$_PROMPT_FULL_PATH_TEXT" path
      [[ -n $_PROMPT_GIT_TEXT ]] &&
        _prompt_interaction_add GIT "$_PROMPT_GIT_TEXT" git
      (( ${#_PROMPT_PROJECT_ITEMS} )) &&
        _prompt_interaction_add @TOOLCHAIN available tool
      [[ -n $_PROMPT_ENV_TEXT ]] &&
        _prompt_interaction_add ENV "$_PROMPT_ENV_TEXT" environment
      [[ -n $_PROMPT_LAST_OUTCOME_TEXT ]] &&
        _prompt_interaction_add LAST "$_PROMPT_LAST_OUTCOME_TEXT" \
          "${_PROMPT_LAST_OUTCOME_ROLE:-info}"
      if (( ! ${#_PROMPT_INTERACTION_LABELS} )) &&
         [[ -n $_PROMPT_SESSION_TEXT ]]; then
        _prompt_interaction_add SESSION "$_PROMPT_SESSION_TEXT" identity
      fi
      return 0
      ;;
    unavailable)
      _prompt_interaction_add ANALYSIS 'Draft details unavailable' muted
      ;;
    comment)
      _prompt_interaction_add "COMMENT TEXT" \
        "${comment_text:-comment}" info
      _prompt_interaction_add ACTION \
        'likely remain an interactive shell comment' info
      ;;
    assignment)
      _prompt_interaction_add "ARGUMENT TEXT" \
        "${assignment_name:-shell assignment}" environment
      _prompt_interaction_add ACTION 'likely update shell environment' info
      ;;
    caution)
      _prompt_interaction_add "COMMAND TEXT" \
        "${caution_command:-$command_name}" danger
      if [[ ${caution_command:-$command_name} == "$command_name" &&
            $command_lower == (git|g) && -n $operation ]]; then
        _prompt_interaction_add "OPERATION TEXT" "$operation" warning
      fi
      [[ ${caution_command:-$command_name} == "$command_name" &&
         -n $last_operand &&
         ( $command_lower != (git|g) || $last_operand != "$operation" ) ]] &&
        _prompt_interaction_add "ARGUMENT TEXT" "$last_operand" warning
      _prompt_interaction_add ACTION \
        'appears caution-worthy · review literal text before Return' danger
      ;;
    chain)
      _prompt_interaction_add FLOW "${(j: → :)flow_heads}" info
      _prompt_interaction_add STEPS "$(( chain_count + pipe_count + 1 ))" info
      _prompt_interaction_add CONTROL "${(j: :)flow_operators}" warning
      _prompt_interaction_add ACTION \
        'likely sequence literal shell commands' info
      ;;
    pipeline)
      _prompt_interaction_add FLOW "${(j: → :)flow_heads}" info
      _prompt_interaction_add STAGES "$(( pipe_count + 1 ))" info
      [[ -n $redirect_text ]] &&
        _prompt_interaction_add "$redirect_label" "$redirect_text" warning
      _prompt_interaction_add ACTION \
        'likely compose literal command output' info
      ;;
    redirect)
      _prompt_interaction_add "OPERATOR TEXT" "$redirect_operator" warning
      [[ -n $redirect_text ]] &&
        _prompt_interaction_add "$redirect_label" "$redirect_text" warning
      _prompt_interaction_add ACTION "$redirect_action" info
      ;;
    task)
      _prompt_interaction_add 'COMMAND TEXT' "$command_name" info
      [[ -n $task_operation ]] &&
        _prompt_interaction_add 'OPERATION TEXT' "$task_operation" info
      _prompt_interaction_add ACTION "$action" info
      ;;
    remote)
      _prompt_interaction_add "COMMAND TEXT" "$command_name" info
      [[ -n $remote_text ]] &&
        _prompt_interaction_add "ENDPOINT TEXT" "$remote_text" warning
      _prompt_interaction_add ACTION \
        'command may contact a remote system' warning
      ;;
    git)
      _prompt_interaction_add "OPERATION TEXT" \
        "${operation:-repository command}" git
      _prompt_interaction_add ACTION "$action" info
      [[ -n $_PROMPT_GIT_BRANCH_TEXT ]] &&
        _prompt_interaction_add BRANCH "$_PROMPT_GIT_BRANCH_TEXT" git
      [[ -n $_PROMPT_PROJECT_NAME_TEXT ]] &&
        _prompt_interaction_add PROJECT "$_PROMPT_PROJECT_NAME_TEXT" project
      return 0
      ;;
    navigate)
      [[ -n $first_operand ]] &&
        _prompt_interaction_add "DESTINATION TEXT" "$first_operand" path
      _prompt_interaction_add ACTION "$action" info
      [[ -n $_PROMPT_FULL_PATH_TEXT ]] &&
        _prompt_interaction_add FROM "$_PROMPT_FULL_PATH_TEXT" path
      ;;
    search)
      [[ -n $query_text ]] &&
        _prompt_interaction_add "QUERY TEXT" "$query_text" info
      _prompt_interaction_add ACTION 'likely search literal local input' info
      if [[ -n $_PROMPT_PROJECT_NAME_TEXT ]]; then
        _prompt_interaction_add SCOPE "$_PROMPT_PROJECT_NAME_TEXT" project
      else
        _prompt_interaction_add SCOPE "$_PROMPT_FULL_PATH_TEXT" path
      fi
      [[ -n $_PROMPT_GIT_TEXT ]] &&
        _prompt_interaction_add GIT "$_PROMPT_GIT_TEXT" git
      return 0
      ;;
    environment)
      [[ -n $environment_text ]] &&
        _prompt_interaction_add "ARGUMENT TEXT" "$environment_text" environment
      _prompt_interaction_add ACTION \
        'likely change the current shell environment' info
      [[ -n $_PROMPT_ENV_TEXT ]] &&
        _prompt_interaction_add CURRENT "$_PROMPT_ENV_TEXT" environment
      ;;
    test)
      _prompt_interaction_add "TASK TEXT" "${task_text:-test}" tool
      _prompt_interaction_add ACTION 'likely run project tests' info
      (( ${#_PROMPT_PROJECT_ITEMS} )) &&
        _prompt_interaction_add @TOOLCHAIN available tool
      ;;
    build)
      _prompt_interaction_add "TASK TEXT" "${task_text:-build}" tool
      _prompt_interaction_add ACTION 'likely build the current project' info
      (( ${#_PROMPT_PROJECT_ITEMS} )) &&
        _prompt_interaction_add @TOOLCHAIN available tool
      ;;
    *)
      _prompt_interaction_add "COMMAND TEXT" "$command_name" info
      [[ -n $first_operand ]] &&
        _prompt_interaction_add "ARGUMENT TEXT" "$first_operand" info
      _prompt_interaction_add ACTION 'likely run a shell command' info
      ;;
  esac
  _prompt_interaction_add_context
}

# Enrich step: alias handling (last in the kind precedence), same-source help,
# captured manual summaries, the visible autosuggestion prefix and alias
# expansions. Reads the shared facts; may replace the kind and rows only as
# alias handling documents. Every lookup is optional and provider-free.
_prompt_interaction_enrich() {
  emulate -L zsh
  setopt localoptions extendedglob multibyte
  local alias_text='' alias_kind='' alias_summary='' suggestion=''
  local description_label='' description_text=''
  local manual_summary='' manual_source=''
  local -i index=0 description_index=0 action_index=0

  # Same-source help and current alias definitions enrich only a simple literal
  # command. Preserve structural views and do not inspect ghost text.
  if [[ $_PROMPT_INTERACTION_KIND != (pipeline|chain|redirect) ]] &&
     (( !autocd && command_index == 1 && ${#buffer} <= 512 && token_count < 64 )) &&
     [[ ${tokens[1]} == "$command_name" ]]; then
    description_index=${_PROMPT_INTERACTION_LABELS[(Ie)ACTION]}
    if [[ ${alias_records[1]-} == 1 ]]; then
      alias_kind=$alias_records[3] alias_text=$alias_records[4]
    fi
    if [[ -n $alias_kind ]]; then
      (( ${#alias_text} > 240 )) && alias_text="${alias_text[1,239]}…"
      [[ -n $alias_text ]] || alias_text='""'
      if [[ $_PROMPT_INTERACTION_KIND == caution ]]; then
        : # Retain the warning; every alias definition is appended below.
      elif [[ $alias_kind == 'Shell alias' ]] &&
         (( ${+functions[_navigation_alias_description]} )) &&
         _navigation_alias_description "$command_name" &&
         [[ ${aliases[$command_name]} == "$reply[1]" ]]; then
        description_label=ABOUT description_text=$reply[2]
        [[ $reply[1] == 'cd '* ]] && _PROMPT_INTERACTION_KIND=navigate
      else
        # A familiar name does not establish the meaning of a custom alias.
        _PROMPT_INTERACTION_KIND=run
        _PROMPT_INTERACTION_LABELS=() _PROMPT_INTERACTION_VALUES=() _PROMPT_INTERACTION_ROLES=()
        _prompt_interaction_add "COMMAND TEXT" "$command_name" info
        _prompt_interaction_add_context
        description_index=0
        description_label=ABOUT description_text="$alias_kind · custom definition"
      fi
    elif [[ $_PROMPT_INTERACTION_KIND != (caution|remote) ]] &&
         (( ${+functions[_compozsh_prompt_description]} )) &&
         _compozsh_prompt_description "$command_name" "${(@)plain_tokens[2,-1]}"; then
      description_label=$reply[1] description_text=$reply[2]
      _prompt_interaction_add SOURCE "Compozsh help · $command_name" frame
    fi
    if [[ -n $description_label ]]; then
      if [[ $description_label == ABOUT && $command_name == g &&
            -n $operation_lower && $operation_lower != (branches|review|worktree|help) ]]; then
        _prompt_interaction_add ABOUT "$description_text" info
      elif (( description_index )); then
        _PROMPT_INTERACTION_LABELS[description_index]=$description_label
        _PROMPT_INTERACTION_VALUES[description_index]=$description_text
      else
        _prompt_interaction_add "$description_label" "$description_text" info
      fi
    fi
  fi

  # Prepare one definition row for every alias shape. Append it after all other
  # details so stock, custom and compound previews share the same bottom anchor.
  if (( $#alias_records )); then
    if [[ -n $alias_kind ]] && (( $#alias_records == 4 )); then
      alias_summary=$alias_text
    else
      for (( index = 1; index <= $#alias_records; index += 4 )); do
        [[ -n $alias_summary ]] && alias_summary+=' · '
        alias_summary+="${alias_records[index+1]} → ${alias_records[index+3]}"
      done
    fi
  fi

  # Manual metadata is ABOUT the tool, never a prediction of draft effects.
  # Keep owned/specific ACTION cues; replace only the generic filler. This
  # optional lookup does no capture, path resolution or filesystem access.
  reply=()
  if [[ -z ${alias_kind:-} ]] &&
     (( !autocd && ${+functions[_manual_summary_lookup]} )) &&
     _manual_summary_lookup "$command_name"; then
    manual_summary=$REPLY manual_source=${reply[2]:-${_MANUAL_SOURCES[$command_name]}}
    action_index=${_PROMPT_INTERACTION_LABELS[(i)ACTION]}
    if [[ ${_PROMPT_INTERACTION_VALUES[action_index]-} == 'likely run a shell command' ]]; then
      _PROMPT_INTERACTION_LABELS[action_index]=ABOUT
      _PROMPT_INTERACTION_VALUES[action_index]=$manual_summary
      _PROMPT_INTERACTION_ROLES[action_index]=info
      _PROMPT_INTERACTION_LABELS=("${(@)_PROMPT_INTERACTION_LABELS[1,action_index]}" SOURCE "${(@)_PROMPT_INTERACTION_LABELS[action_index+1,-1]}")
      _PROMPT_INTERACTION_VALUES=("${(@)_PROMPT_INTERACTION_VALUES[1,action_index]}" "Local manual · $manual_source" "${(@)_PROMPT_INTERACTION_VALUES[action_index+1,-1]}")
      _PROMPT_INTERACTION_ROLES=("${(@)_PROMPT_INTERACTION_ROLES[1,action_index]}" frame "${(@)_PROMPT_INTERACTION_ROLES[action_index+1,-1]}")
    elif [[ $_PROMPT_INTERACTION_KIND != (caution|pipeline|chain|redirect) ]]; then
      _prompt_interaction_add ABOUT "$manual_summary" info
    fi
  fi

  # The suffix is already owned and displayed by the editor. Repeat only its
  # bounded visible prefix; never search history or preserve the unseen tail.
  if [[ -n ${_ZLE_AUTOSUGGEST_SUFFIX:-} &&
        ${_ZLE_AUTOSUGGEST_CACHE_BUFFER:-} == "$buffer" &&
        ${POSTDISPLAY:-} == "${_ZLE_AUTOSUGGEST_DISPLAY:-}" ]]; then
    (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$_ZLE_AUTOSUGGEST_SUFFIX" || REPLY=${(V)_ZLE_AUTOSUGGEST_SUFFIX}
    suggestion=$REPLY
    _prompt_prefix_abbreviate "$suggestion" 36
    [[ -n $REPLY ]] &&
      _prompt_interaction_add SUGGESTION "$REPLY" info
  fi
  if (( $#alias_records )); then
    _prompt_interaction_add EXPANSION "$alias_summary" info
  fi
}

_prompt_interaction_row() {
  emulate -L zsh
  setopt localoptions multibyte
  local label=$1 text=$2 role=$3 prefix_plain='' prefix=''
  local -i line_limit=${4:-80} label_width=${(m)#label}
  local -i slot_width=0 prefix_width=0 value_width=0

  if (( line_limit >= 42 )); then
    slot_width=16
    (( label_width > slot_width )) && slot_width=$label_width
  else
    slot_width=$label_width
  fi
  prefix_plain="│  ${(r:$slot_width:)label}"
  prefix_width=${(m)#prefix_plain}
  value_width=$(( line_limit - prefix_width - 1 ))
  (( value_width > 0 )) || return 1
  _prompt_render_abbreviated "$role" "$text" "$value_width" tail
  [[ -n $reply[2] ]] || return 1
  _prompt_escape "${prefix_plain#│}"
  _prompt_color_text frame "$REPLY"
  prefix=$REPLY
  _prompt_color_text "${5:-frame}" '│'
  REPLY="${REPLY}${prefix} ${reply[1]}"
}

_prompt_interaction_layout() {
  emulate -L zsh
  setopt localoptions multibyte
  local kind=${(U)_PROMPT_INTERACTION_KIND} label='' value='' role=''
  local header_plain="╭─ ${kind}" header='' row='' outline_role=''
  local -a rows=()
  local -i line_limit=$(( COLUMNS > 0 ? COLUMNS : 80 ))
  local -i max_body=$(( LINES > 0 ? LINES - 2 : 5 ))
  local -i index=0 body_cap=5
  local -i expansion_index=${_PROMPT_INTERACTION_LABELS[(Ie)EXPANSION]}
  local -i warning_index=0 body_limit=0
  local expansion_row=''

  _PROMPT_INTERACTION_SEGMENT=''
  (( line_limit >= 12 && max_body >= 1 )) || return 0
  # READY retains toolchain alongside the existing environment and outcome.
  [[ $_PROMPT_INTERACTION_KIND == ready ]] && body_cap=6
  (( max_body > body_cap )) && max_body=$body_cap
  [[ $_PROMPT_INTERACTION_KIND == caution ]] &&
    warning_index=${_PROMPT_INTERACTION_LABELS[(Ie)ACTION]}

  _prompt_interaction_color_role
  outline_role=$REPLY
  REPLY=$header_plain
  if (( ${+functions[_zle_picker_abbreviate]} )); then
    _zle_picker_abbreviate "$header_plain" "$line_limit" head
  elif (( line_limit <= 0 )); then
    REPLY=''
  elif (( ${(m)#header_plain} > line_limit )); then
    REPLY=…
  fi
  _prompt_escape "$REPLY"
  _prompt_color_text "$outline_role" "$REPLY"
  header=$REPLY

  if (( ${+widgets[compozsh-inspect]} && line_limit >= 56 )); then
    local hint='Option-Return inspect draft' padding=''
    local -i gap=$(( line_limit - ${(m)#header_plain} - ${(m)#hint} ))
    if (( gap >= 2 )); then
      padding=${(l:$gap:: :)padding}
      _prompt_color_text frame "$hint"
      header+="$padding$REPLY"
    fi
  fi

  # Reserve the last visible row for the definition. In a one-row caution view,
  # the warning is the only detail; otherwise it survives above the expansion.
  if (( expansion_index && !(warning_index && max_body == 1) )); then
    _prompt_interaction_row EXPANSION "${_PROMPT_INTERACTION_VALUES[expansion_index]}" \
      "${_PROMPT_INTERACTION_ROLES[expansion_index]:-info}" "$line_limit" "$outline_role" &&
      expansion_row=$REPLY
  fi
  body_limit=$max_body
  [[ -n $expansion_row ]] && (( --body_limit ))
  for (( index = 1;
         index <= ${#_PROMPT_INTERACTION_LABELS} &&
         ${#rows} < body_limit;
         index++ )); do
    (( index == expansion_index )) && continue
    if (( expansion_index && warning_index > index && ${#rows} == body_limit - 1 )); then
      index=$warning_index
    fi
    label=${_PROMPT_INTERACTION_LABELS[index]}
    value=${_PROMPT_INTERACTION_VALUES[index]}
    role=${_PROMPT_INTERACTION_ROLES[index]:-info}
    if [[ $label == @TOOLCHAIN ]]; then
      _prompt_lens_toolchain_row "$line_limit" "$outline_role" \
        "$(( line_limit >= 42 ? 16 : 9 ))" && rows+=("$REPLY")
    elif _prompt_interaction_row "$label" "$value" "$role" "$line_limit" "$outline_role"; then
      rows+=("$REPLY")
    fi
  done
  [[ -n $expansion_row ]] && rows+=("$expansion_row")

  _PROMPT_INTERACTION_SEGMENT=$header
  for row in "${rows[@]}"; do
    _PROMPT_INTERACTION_SEGMENT+=$'\n'"$row"
  done
}

# Build the expanded presentation from the same in-memory snapshot as compact.
# Height is bounded so the empty lens cannot push its own header into scrollback
# before ZLE gets a chance to contract it.
_prompt_lens_layout() {
  emulate -L zsh
  setopt localoptions multibyte
  local reason=${_PROMPT_LENS_REASON:-context changed}
  local hint=$(( _PROMPT_LENS_PINNED ? 1 : 0 ))
  local hint_text='' left_plain='' header='' footer='' padding=''
  local git_text='' row=''
  local -a rows priorities selected visible_rows
  local -i line_limit=$(( COLUMNS > 0 ? COLUMNS : 80 ))
  local -i max_body=$(( LINES > 0 ? LINES - 3 : 7 ))
  local -i index=0 priority=0 selected_count=0 left_width=0 padding_width=0
  local -i left_plain_width=0 hint_width=0

  _PROMPT_LENS_SEGMENT=''
  (( line_limit >= 18 && max_body >= 1 )) || return 0

  if (( hint )); then
    hint_text='Option-I close'
  else
    hint_text='Option-I pin'
  fi
  left_plain="╭─ CONTEXT · ${reason}"
  left_plain_width=${(m)#left_plain}
  hint_width=${(m)#hint_text}
  # Optional keys must not crowd out the context identity in a narrow window.
  left_width=$line_limit
  if (( line_limit - hint_width - 2 >= 18 )); then
    left_width=$(( line_limit - hint_width - 2 ))
  else
    hint_text='' hint_width=0
  fi
  if (( left_plain_width > left_width )); then
    REPLY=$left_plain
    if (( ${+functions[_zle_picker_abbreviate]} )); then
      _zle_picker_abbreviate "$left_plain" "$left_width" head
    elif (( left_width <= 0 )); then
      REPLY=''
    elif (( ${(m)#left_plain} > left_width )); then
      REPLY=…
    fi
    left_plain=$REPLY
    left_plain_width=${(m)#left_plain}
  fi
  _prompt_escape "$left_plain"
  _prompt_color_text frame "$REPLY"
  header=$REPLY
  if [[ -n $hint_text ]] && (( left_plain_width + 2 + hint_width <= line_limit )); then
    padding_width=$(( line_limit - left_plain_width - hint_width ))
    padding=${(l:$padding_width:: :)padding}
    header+=$padding
    _prompt_escape "$hint_text"
    _prompt_color_text frame "$REPLY"
    header+=$REPLY
  fi

  if [[ -n $_PROMPT_PROJECT_ROOT_TEXT ]]; then
    _prompt_lens_row PROJECT "${_PROMPT_PROJECT_ROOT_TEXT:t}" project "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(3)
    }
  fi
  _prompt_lens_row PATH "$_PROMPT_FULL_PATH_TEXT" path "$line_limit" && {
    rows+=("$REPLY")
    priorities+=(1)
  }
  if [[ -n $_PROMPT_GIT_TEXT ]]; then
    git_text=$_PROMPT_GIT_TEXT
    [[ -n $_PROMPT_GIT_UPSTREAM_TEXT ]] &&
      git_text+=" · tracks ${_PROMPT_GIT_UPSTREAM_TEXT}"
    _prompt_lens_row GIT "$git_text" git "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(2)
    }
  fi
  _prompt_lens_toolchain_row "$line_limit" && {
    rows+=("$REPLY")
    priorities+=(5)
  }
  if [[ -n $_PROMPT_ENV_TEXT ]]; then
    _prompt_lens_row ENV "$_PROMPT_ENV_TEXT" environment "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(4)
    }
  fi
  if [[ -n $_PROMPT_JOBS_TEXT ]]; then
    _prompt_lens_row JOBS "$_PROMPT_JOBS_TEXT" jobs "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(6)
    }
  fi
  if [[ -n $_PROMPT_SESSION_TEXT ]]; then
    _prompt_lens_row SESSION "$_PROMPT_SESSION_TEXT" identity "$line_limit" && {
      rows+=("$REPLY")
      priorities+=(7)
    }
  fi

  # Select rows by information priority, then paint them in stable visual order.
  for priority in {1..7}; do
    (( selected_count < max_body )) || break
    for (( index = 1; index <= ${#rows}; index++ )); do
      if (( priorities[index] == priority )); then
        selected[index]=1
        (( ++selected_count ))
        break
      fi
    done
  done
  for (( index = 1; index <= ${#rows}; index++ )); do
    (( ${selected[index]:-0} )) && visible_rows+=("${rows[index]}")
  done
  (( ${#visible_rows} )) || return 0

  # A pinned Context lens retains its captured disclosure while one compact
  # live section follows the current BUFFER. Reserve space instead of growing
  # beyond the terminal-height budget.
  if (( _PROMPT_LENS_PINNED && _PROMPT_INTERACTION_ACTIVE &&
        max_body >= 3 && ${#_PROMPT_INTERACTION_LABELS} )) &&
     [[ $_PROMPT_INTERACTION_KIND != ready ]]; then
    while (( ${#visible_rows} > max_body - 2 )); do
      visible_rows[-1]=()
    done
    _prompt_escape "├─ ${(U)_PROMPT_INTERACTION_KIND}"
    _prompt_color_text frame "$REPLY"
    visible_rows+=("$REPLY")
    if _prompt_interaction_row \
         "${_PROMPT_INTERACTION_LABELS[1]}" \
         "${_PROMPT_INTERACTION_VALUES[1]}" \
         "${_PROMPT_INTERACTION_ROLES[1]:-info}" \
         "$line_limit"; then
      visible_rows+=("$REPLY")
    fi
  fi

  _prompt_color_text frame '╰─'
  footer=$REPLY
  _PROMPT_LENS_SEGMENT=$header
  for row in "${visible_rows[@]}"; do
    _PROMPT_LENS_SEGMENT+=$'\n'"$row"
  done
  _PROMPT_LENS_SEGMENT+=$'\n'"$footer"
}

# Lay out the compact context row from the captured snapshot for the current
# width. It always retains path and applicable Git; remaining width is assigned
# to environment, jobs, then project facts by priority. Its other inputs change
# only at capture or load, so it records the width it laid the row out for.
_prompt_context_layout() {
  emulate -L zsh
  setopt localoptions multibyte
  local path_text='' git_text='' identity_text=''
  local env_text='' jobs_text=''
  local path_plain='' git_plain='' identity_plain=''
  local path_rendered='' git_rendered='' identity_rendered=''
  local optional='' separator='  ·  ' env_rendered='' jobs_rendered=''
  local -i line_limit=$(( COLUMNS > 0 ? COLUMNS : 80 ))
  local -i path_budget=0 git_budget=0 identity_budget=0 available=0
  local -i mandatory_width=0 used_width=0 index=0 item_width=0 optional_open=1
  local -i path_width=0 git_width=0 identity_width=0 separator_width=0

  _PROMPT_CONTEXT_SEGMENT=''

  (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$_PROMPT_PATH_TEXT" || REPLY=${(V)_PROMPT_PATH_TEXT}; path_text=$REPLY
  (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$_PROMPT_GIT_TEXT" || REPLY=${(V)_PROMPT_GIT_TEXT}; git_text=$REPLY
  if (( EUID == 0 )) || [[ -n ${SSH_CONNECTION:-}${SSH_TTY:-} ]]; then
    (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$_PROMPT_IDENTITY_TEXT" || REPLY=${(V)_PROMPT_IDENTITY_TEXT}; identity_text=$REPLY
  fi

  path_width=${(m)#path_text}
  git_width=${(m)#git_text}
  identity_width=${(m)#identity_text}
  separator_width=${(m)#separator}
  mandatory_width=$(( path_width + git_width + identity_width ))
  [[ -n $git_text ]] && (( mandatory_width += 2 ))
  [[ -n $identity_text ]] && (( mandatory_width += 2 ))

  if (( mandatory_width <= line_limit )); then
    path_budget=$path_width
    git_budget=$git_width
    identity_budget=$identity_width
  else
    available=$line_limit
    if [[ -n $identity_text ]] && (( line_limit >= 24 )); then
      identity_budget=$(( identity_width < line_limit / 5 ? identity_width : line_limit / 5 ))
      (( available -= identity_budget + 2 ))
    fi
    if [[ -n $git_text ]]; then
      git_budget=$(( git_width < available / 3 ? git_width : available / 3 ))
      (( git_budget < 1 )) && git_budget=1
      path_budget=$(( available - git_budget - 2 ))
      if (( path_budget < 1 )); then
        path_budget=1
        git_budget=$(( available - 3 ))
      fi
    else
      path_budget=$available
    fi
  fi

  if (( identity_budget > 0 )); then
    _prompt_render_abbreviated identity "$identity_text" "$identity_budget" head
    identity_rendered=$reply[1]
    identity_plain=$reply[2]
  fi
  _prompt_render_abbreviated path "$path_text" "$path_budget" tail
  path_rendered=$reply[1]
  path_plain=$reply[2]
  if [[ -n $git_text ]] && (( git_budget > 0 )); then
    _prompt_render_abbreviated git "$git_text" "$git_budget" head
    git_rendered=$reply[1]
    git_plain=$reply[2]
  fi

  [[ -n $identity_rendered ]] && _PROMPT_CONTEXT_SEGMENT+="${identity_rendered}  "
  _PROMPT_CONTEXT_SEGMENT+=$path_rendered
  [[ -n $git_rendered ]] && _PROMPT_CONTEXT_SEGMENT+="  ${git_rendered}"
  used_width=$(( ${(m)#identity_plain} + ${(m)#path_plain} + ${(m)#git_plain} ))
  [[ -n $identity_plain ]] && (( used_width += 2 ))
  [[ -n $git_plain ]] && (( used_width += 2 ))

  if [[ -n $_PROMPT_ENV_TEXT ]]; then
    (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$_PROMPT_ENV_TEXT" || REPLY=${(V)_PROMPT_ENV_TEXT}
    env_text=$REPLY
    _prompt_escape "py:${env_text}"
    _prompt_color_text environment "$REPLY"
    env_rendered=$REPLY
    item_width=$(( 3 + ${(m)#env_text} ))
    if (( used_width + separator_width + item_width <= line_limit )); then
      _PROMPT_CONTEXT_SEGMENT+="${separator}${env_rendered}"
      (( used_width += separator_width + item_width ))
    else
      optional_open=0
    fi
  fi
  if (( optional_open )) && [[ -n $_PROMPT_JOBS_TEXT ]]; then
    (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$_PROMPT_JOBS_TEXT" || REPLY=${(V)_PROMPT_JOBS_TEXT}
    jobs_text=$REPLY
    _prompt_escape "$jobs_text"
    _prompt_color_text jobs "$REPLY"
    jobs_rendered=$REPLY
    item_width=${(m)#jobs_text}
    if (( used_width + separator_width + item_width <= line_limit )); then
      _PROMPT_CONTEXT_SEGMENT+="${separator}${jobs_rendered}"
      (( used_width += separator_width + item_width ))
    else
      optional_open=0
    fi
  fi
  if (( optional_open )); then
    for (( index = 1; index <= ${#_PROMPT_PROJECT_ITEMS}; index++ )); do
      item_width=${_PROMPT_PROJECT_ITEM_WIDTHS[index]:-0}
      (( used_width + separator_width + item_width <= line_limit )) || break
      optional="${separator}${_PROMPT_PROJECT_ITEMS[index]}"
      _PROMPT_CONTEXT_SEGMENT+=$optional
      (( used_width += separator_width + item_width ))
    done
  fi
  _PROMPT_CONTEXT_COLUMNS=$line_limit
}

# Lay out the segments that follow BUFFER and the view: the Interaction and
# Context lenses. Editing and Option-I reuse the context row laid out at
# capture or resize, and relay it out only if the width changed without a
# resize relayout, such as under a WINCH handler installed later.
_prompt_live_layout() {
  local _prompt_alias_enabled=${_prompt_alias_enabled:-${options[aliases]}}
  emulate -L zsh

  (( _PROMPT_CONTEXT_COLUMNS == (COLUMNS > 0 ? COLUMNS : 80) )) ||
    _prompt_context_layout

  if (( _PROMPT_INTERACTION_ACTIVE )); then
    _prompt_interaction_model "${BUFFER:-}"
    _prompt_interaction_layout
  else
    _PROMPT_INTERACTION_SEGMENT=''
  fi

  if [[ $_PROMPT_VIEW == lens ]]; then
    _prompt_lens_layout
  else
    _PROMPT_LENS_SEGMENT=''
  fi
}

# Reflow the whole captured snapshot without launching Git, language tools, or
# project detection. Capture and resize run it; edits run only the live part.
_prompt_layout() {
  local _prompt_alias_enabled=${_prompt_alias_enabled:-${options[aliases]}}
  emulate -L zsh
  _prompt_context_layout
  _prompt_live_layout
}

# Project discovery stays at prompt capture; optional runtime capabilities are
# resolved there after peer loading, independent of traversal order.
# Public extension points for uncommon or personal project types. The local
# initializer can populate them before this portable detector loads.
typeset -ga PROMPT_PROJECT_MARKERS
typeset -ga PROMPT_PROJECT_CONTEXT_FUNCTIONS
typeset -ga _PROMPT_PROJECT_EXTRA_SEGMENTS=()
typeset -ga _PROMPT_PROJECT_EXTRA_WIDTHS=()

# Exact manifests that establish a project root even when source files live in
# deeper package/module directories. Wildcard project files are handled by the
# resolver; the full detector below attaches their language and tool semantics.
typeset -ga _PROMPT_PROJECT_ROOT_MARKERS=(
  Package.swift package.json tsconfig.json deno.json deno.jsonc
  composer.json composer.lock CMakeLists.txt meson.build configure.ac
  configure.in MODULE.bazel WORKSPACE WORKSPACE.bazel conanfile.py
  conanfile.txt vcpkg.json xmake.lua DESCRIPTION renv.lock build.zig
  project.godot .terraform.lock.hcl JuliaProject.toml Project.toml
  Manifest.toml cpanfile Makefile.PL Build.PL fpm.toml dune-project
  build.sbt build.sc rebar.config gleam.toml pyproject.toml setup.py
  setup.cfg requirements.txt Pipfile poetry.lock pdm.lock hatch.toml
  environment.yml environment.yaml mkdocs.yml mkdocs.yaml uv.lock
  .python-version stack.yaml cabal.project Cargo.toml go.mod go.work Gemfile
  .ruby-version pom.xml build.gradle build.gradle.kts settings.gradle
  settings.gradle.kts global.json pubspec.yaml mix.exs terragrunt.hcl
  Pulumi.yaml Chart.yaml kustomization.yaml kustomization.yml serverless.yml
  serverless.yaml pixi.toml melos.yaml melos.yml _quarto.yml _quarto.yaml
  Makefile makefile GNUmakefile build.ninja buf.yaml buf.gen.yaml Justfile
  justfile Taskfile.yml Taskfile.yaml Dockerfile compose.yaml compose.yml
  docker-compose.yaml docker-compose.yml .devcontainer/devcontainer.json
  flake.nix shell.nix devenv.nix devenv.yaml mise.toml .mise.toml Vagrantfile
  supabase/config.toml
)
typeset -ga _PROMPT_SOURCE_SCAN_LANGUAGES=()
typeset -ga _PROMPT_RESOLVED_SOURCE_LANGUAGES=()
typeset -gi _PROMPT_SOURCE_SCAN_SATURATED=0
typeset -gi _PROMPT_RESOLVED_SOURCE_SCAN_SATURATED=0
typeset -gi _PROMPT_SOURCE_SCAN_UNSAFE=0
typeset -gi _PROMPT_RESOLVED_SOURCE_SCAN_UNSAFE=0


# Collect source-language evidence from one directory without invoking the full
# detector. Root resolution uses this while walking upward, then the expensive
# manifest/tool/framework pass runs exactly once at the chosen project root.
_prompt_scan_source_languages() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local dir=$1 scan_dir='' candidate='' file='' language=''
  local -i saw_shell=0
  local -a scan_dirs=() files=()
  typeset -ga _PROMPT_SOURCE_SCAN_LANGUAGES=()
  typeset -gi _PROMPT_SOURCE_SCAN_SATURATED=0
  typeset -gi _PROMPT_SOURCE_SCAN_UNSAFE=0

  scan_dirs+=("$dir")
  for candidate in \
    "$dir"/{src,source,Sources,include,lib,app,public,scripts,modules,bin,R,notebooks} \
    "$dir"/src/{main,test}/{java,kotlin,scala,groovy}; do
    if [[ -L $candidate ]]; then
      _PROMPT_SOURCE_SCAN_UNSAFE=1
    elif [[ -d $candidate ]]; then
      scan_dirs+=("$candidate")
    fi
  done

  for scan_dir in "${scan_dirs[@]}"; do
    # `oN` avoids sorting and `Y129` proves whether the 128-entry evidence
    # budget saturated without enumerating the complete directory.
    files=(
      "$scan_dir"/*.(c|cc|cpp|cxx|hh|hpp|hxx|m|mm|asm|s|S|scm|ss|rkt|lisp|cl|asd|swift|php|ps1|psm1|psd1|kt|kts|lua|R|Rmd|Rproj|zig|tf|jl|pl|pm|f|f90|f95|f03|ml|mli|scala|erl|hrl|groovy|ipynb|java|cs|fs|vb|sh)(NY129oN:t)
      "$scan_dir"/*.tf.json(NY1oN:t)
    )
    if (( ${#files} >= 129 )); then
      _PROMPT_SOURCE_SCAN_SATURATED=1
      files=("${(@)files[1,128]}")
    fi
    for file in "${files[@]}"; do
      language=''
      case $file in
        *.c|*.cc|*.cpp|*.cxx|*.hh|*.hpp|*.hxx) language=c-cpp ;;
        *.m|*.mm)                 language=objective-c ;;
        *.asm|*.s|*.S)           language=asm ;;
        *.scm|*.ss)              language=scheme ;;
        *.rkt)                    language=racket ;;
        *.lisp|*.cl|*.asd)       language=lisp ;;
        Project.swift|Workspace.swift|Tuist.swift) continue ;;
        *.swift)                 language=swift ;;
        *.php)                   language=php ;;
        *.ps1|*.psm1|*.psd1)    language=powershell ;;
        build.gradle.kts)        continue ;;
        *.kt|*.kts)              language=kotlin ;;
        xmake.lua)               continue ;;
        *.lua)                   language=lua ;;
        *.R|*.Rmd|*.Rproj)       language=r ;;
        *.zig)                   language=zig ;;
        *.tf|*.tf.json)          language=terraform ;;
        *.jl)                    language=julia ;;
        *.pl|*.pm)               language=perl ;;
        *.f|*.f90|*.f95|*.f03)  language=fortran ;;
        *.ml|*.mli)              language=ocaml ;;
        *.scala)                 language=scala ;;
        *.erl|*.hrl)             language=erlang ;;
        *.groovy)                language=groovy ;;
        *.ipynb)                 language=python ;;
        *.java)                  language=java ;;
        *.cs)                    language=dotnet ;;
        *.fs)                    language=fsharp ;;
        *.vb)                    language=visual-basic ;;
        *.sh)                    saw_shell=1 ;;
      esac
      [[ -n $language ]] || continue
      (( ${_PROMPT_SOURCE_SCAN_LANGUAGES[(Ie)$language]} )) ||
        _PROMPT_SOURCE_SCAN_LANGUAGES+=("$language")
    done
  done

  (( saw_shell && ! ${#_PROMPT_SOURCE_SCAN_LANGUAGES} )) &&
    _PROMPT_SOURCE_SCAN_LANGUAGES+=(shell)
}

# Resolve ownership separately from project inspection. Source files identify
# the nearest standalone project, while an enclosing manifest or Git root owns
# nested packages and conventional source trees.
_prompt_resolve_project_root() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local dir=$1 marker='' language='' nearest_source_root=''
  local -i root_anchor=0
  local -a nearest_languages=() source_languages=() wildcard_matches=()
  REPLY=''
  typeset -ga _PROMPT_RESOLVED_SOURCE_LANGUAGES=()
  typeset -gi _PROMPT_RESOLVED_SOURCE_SCAN_SATURATED=0
  typeset -gi _PROMPT_RESOLVED_SOURCE_SCAN_UNSAFE=0

  while [[ -n $dir && $dir != / && $dir != $HOME ]]; do
    _prompt_scan_source_languages "$dir"
    (( _PROMPT_SOURCE_SCAN_SATURATED )) &&
      _PROMPT_RESOLVED_SOURCE_SCAN_SATURATED=1
    (( _PROMPT_SOURCE_SCAN_UNSAFE )) &&
      _PROMPT_RESOLVED_SOURCE_SCAN_UNSAFE=1
    if (( ${#_PROMPT_SOURCE_SCAN_LANGUAGES} )); then
      if [[ -z $nearest_source_root ]]; then
        nearest_source_root=$dir
        nearest_languages=("${_PROMPT_SOURCE_SCAN_LANGUAGES[@]}")
      fi
      for language in "${_PROMPT_SOURCE_SCAN_LANGUAGES[@]}"; do
        (( ${source_languages[(Ie)$language]} )) || source_languages+=("$language")
      done
    fi

    root_anchor=0
    if [[ -e "$dir/.git" ]]; then
      root_anchor=1
    else
      for marker in "${_PROMPT_PROJECT_ROOT_MARKERS[@]}"; do
        if [[ -e "$dir/$marker" ]]; then
          root_anchor=1
          break
        fi
      done
    fi

    if (( !root_anchor )); then
      wildcard_matches=(
        "$dir"/*.(xcodeproj|xcworkspace|cabal|gemspec|opam|sln|slnx|csproj|fsproj|vbproj|rockspec|Rproj|asd)(NY1oN)
      )
      (( ${#wildcard_matches} )) && root_anchor=1
    fi

    if (( !root_anchor )); then
      for marker in "${PROMPT_PROJECT_MARKERS[@]}"; do
        if [[ -e "$dir/$marker" ]]; then
          root_anchor=1
          break
        fi
      done
    fi

    if (( root_anchor )); then
      REPLY=$dir
      _PROMPT_RESOLVED_SOURCE_LANGUAGES=("${source_languages[@]}")
      return 0
    fi
    dir=${dir:h}
  done

  if [[ -n $nearest_source_root ]]; then
    if [[ ${nearest_source_root:t} ==
          (src|source|lib|main|test|tests|kotlin|scala|groovy) &&
          ${nearest_source_root:h} != $HOME &&
          ${nearest_source_root:h} != / ]]; then
      nearest_source_root=${nearest_source_root:h}
    fi
    REPLY=$nearest_source_root
    _PROMPT_RESOLVED_SOURCE_LANGUAGES=("${nearest_languages[@]}")
    return 0
  fi
  return 1
}

# Project marker rules, in display order. Each row is `kind:value:evidence`,
# where evidence holds space-separated alternatives and each alternative joins
# `+`-separated tokens that must all hold. The capture tests `f:` (regular
# file), `d:` (directory), `e:` (any entry) and `g:` (a bounded wildcard,
# relative to the project root); `l:` and `t:` name a language or tool this
# classification already chose, and `!` negates a token. Kinds: `language`,
# `custom` (identifies a project without a language), `fallback` (only for an
# otherwise unidentified folder), `tool`, `framework` and `environment` apply
# to ordinary roots; `manifest` rows are the exact-manifest subset a saturated
# root keeps. A `kind/group` row is skipped once an earlier row of its group
# matched, so the first lockfile wins after a migration.
typeset -ga _PROMPT_PROJECT_RULES=(
  'language:zsh f:.zshrc+e:.git'
  'language:c-cpp g:*.(c|cc|cpp|cxx|hh|hpp|hxx) g:src/*.(c|cc|cpp|cxx|hh|hpp|hxx) g:source/*.(c|cc|cpp|cxx|hh|hpp|hxx) g:Sources/*.(c|cc|cpp|cxx|hh|hpp|hxx) g:lib/*.(c|cc|cpp|cxx|hh|hpp|hxx) g:app/*.(c|cc|cpp|cxx|hh|hpp|hxx) g:include/*.(hh|hpp|hxx)'
  'custom: f:CMakeLists.txt f:meson.build f:configure.ac f:configure.in f:MODULE.bazel f:WORKSPACE f:WORKSPACE.bazel f:conanfile.py f:conanfile.txt f:vcpkg.json f:xmake.lua'
  'language:asm g:*.(asm|s|S) g:src/*.(asm|s|S) g:source/*.(asm|s|S) g:Sources/*.(asm|s|S) g:lib/*.(asm|s|S) g:app/*.(asm|s|S)'
  'language:scheme g:*.(scm|ss) g:src/*.(scm|ss) g:source/*.(scm|ss) g:lib/*.(scm|ss)'
  'language:racket g:*.rkt g:src/*.rkt g:source/*.rkt g:lib/*.rkt'
  'language:lisp g:*.(lisp|cl|asd) g:src/*.(lisp|cl|asd) g:source/*.(lisp|cl|asd) g:lib/*.(lisp|cl|asd)'
  'custom: g:*.(xcodeproj|xcworkspace)'
  'language:objective-c g:*.(xcodeproj|xcworkspace)+g:*.(m|mm) g:*.mm !g:*.(xcodeproj|xcworkspace)+g:src/*.mm !g:*.(xcodeproj|xcworkspace)+g:source/*.mm !g:*.(xcodeproj|xcworkspace)+g:Sources/*.mm !g:*.(xcodeproj|xcworkspace)+g:app/*.mm'
  'language:swift f:Package.swift g:*.swift~*/(Project|Workspace|Tuist).swift g:src/*.swift~*/(Project|Workspace|Tuist).swift g:source/*.swift~*/(Project|Workspace|Tuist).swift g:Sources/*.swift~*/(Project|Workspace|Tuist).swift g:app/*.swift~*/(Project|Workspace|Tuist).swift'
  'language:node f:package.json'
  'language:typescript f:tsconfig.json'
  'language:deno f:deno.json f:deno.jsonc'
  'language:php f:composer.json f:composer.lock g:*.php g:src/*.php g:app/*.php g:public/*.php'
  'language:powershell g:*.(ps1|psm1|psd1) g:src/*.(ps1|psm1|psd1) g:scripts/*.(ps1|psm1|psd1) g:modules/*.(ps1|psm1|psd1)'
  'language:kotlin g:*.kt g:*.kts~*.gradle.kts g:src/*.kt g:app/*.kt'
  'language:lua g:*.lua~*/xmake.lua g:src/*.lua~*/xmake.lua g:lua/*.lua~*/xmake.lua g:lib/*.lua~*/xmake.lua g:*.rockspec'
  'language:r f:DESCRIPTION f:renv.lock g:*.(R|Rmd|Rproj) g:R/*.R g:src/*.R g:scripts/*.R g:notebooks/*.Rmd'
  'language:zig f:build.zig g:*.zig g:src/*.zig g:source/*.zig'
  'language:gdscript f:project.godot'
  'language:terraform f:.terraform.lock.hcl g:*.(tf|tf.json)'
  'language:julia f:JuliaProject.toml f:Project.toml f:Manifest.toml g:*.jl g:src/*.jl g:scripts/*.jl'
  'language:perl f:cpanfile f:Makefile.PL f:Build.PL g:*.(pl|pm) g:lib/*.(pl|pm) g:bin/*.(pl|pm) g:script/*.pl g:scripts/*.pl'
  'language:fortran f:fpm.toml g:*.(f|f90|f95|f03) g:src/*.(f|f90|f95|f03) g:source/*.(f|f90|f95|f03) g:app/*.(f|f90|f95|f03)'
  'language:ocaml f:dune-project g:*.(ml|mli|opam) g:src/*.(ml|mli) g:lib/*.(ml|mli)'
  'custom: f:build.sbt f:build.sc'
  'language:scala f:build.sbt f:build.sc g:*.scala g:src/*.scala g:app/*.scala'
  'language:erlang f:rebar.config g:*.(erl|hrl) g:src/*.(erl|hrl) g:include/*.(erl|hrl)'
  'language:gleam f:gleam.toml'
  'language:groovy g:*.groovy g:src/*.groovy g:app/*.groovy'
  'language:python f:pyproject.toml f:setup.py f:setup.cfg f:requirements.txt f:Pipfile f:poetry.lock f:pdm.lock f:hatch.toml f:environment.yml f:environment.yaml f:mkdocs.yml f:mkdocs.yaml f:uv.lock f:.python-version g:*.ipynb g:notebooks/*.ipynb'
  'language:haskell f:stack.yaml f:cabal.project g:*.cabal'
  'language:rust f:Cargo.toml'
  'language:go f:go.mod f:go.work'
  'language:ruby f:Gemfile f:.ruby-version g:*.gemspec'
  'language:java g:*.java g:src/*.java g:app/*.java'
  'custom: f:pom.xml f:build.gradle f:build.gradle.kts f:settings.gradle f:settings.gradle.kts'
  'language:dotnet g:*.csproj'
  'language:fsharp g:*.(fsproj|fs) g:src/*.fs g:app/*.fs'
  'language:visual-basic g:*.(vbproj|vb) g:src/*.vb g:app/*.vb'
  'language:dotnet g:*.(sln|slnx)+!l:dotnet+!l:fsharp+!l:visual-basic f:global.json+!l:dotnet+!l:fsharp+!l:visual-basic'
  'language:dart f:pubspec.yaml'
  'language:elixir f:mix.exs'
  # Infrastructure-only and cross-language repositories may not contain a
  # source file at their root, but these manifests still define a project.
  'custom: f:terragrunt.hcl f:Pulumi.yaml f:Chart.yaml f:kustomization.yaml f:kustomization.yml f:serverless.yml f:serverless.yaml f:pixi.toml f:melos.yaml f:melos.yml f:_quarto.yml f:_quarto.yaml f:Makefile f:makefile f:GNUmakefile f:build.ninja f:buf.yaml f:buf.gen.yaml f:Justfile f:justfile f:Taskfile.yml f:Taskfile.yaml f:Dockerfile f:compose.yaml f:compose.yml f:docker-compose.yaml f:docker-compose.yml f:.devcontainer/devcontainer.json f:flake.nix f:shell.nix f:devenv.nix f:devenv.yaml f:mise.toml f:.mise.toml f:Vagrantfile f:supabase/config.toml'
  # Shell scripts are ubiquitous in polyglot repos, so identify them only when
  # no stronger built-in or locally extended project has been found.
  'fallback:shell g:*.sh g:bin/*.sh g:scripts/*.sh g:src/*.sh'
  'manifest:swift f:Package.swift'
  'manifest:node f:package.json'
  'manifest:typescript f:tsconfig.json'
  'manifest:deno f:deno.json f:deno.jsonc'
  'manifest:php f:composer.json f:composer.lock'
  'manifest:gdscript f:project.godot'
  'manifest:python f:pyproject.toml f:setup.py f:requirements.txt'
  'manifest:rust f:Cargo.toml'
  'manifest:go f:go.mod f:go.work'
  'manifest:ruby f:Gemfile f:.ruby-version'
  'manifest:dart f:pubspec.yaml'
  'manifest:elixir f:mix.exs'
  'manifest:dotnet f:global.json'
  # Package managers and build systems.
  'tool/node:bun f:bun.lock f:bun.lockb'
  'tool/node:pnpm f:pnpm-lock.yaml'
  'tool/node:yarn f:yarn.lock'
  'tool/node:npm f:package-lock.json'
  'tool:turbo f:turbo.json'
  'tool:nx f:nx.json'
  'tool:lerna f:lerna.json'
  'tool:rush f:rush.json'
  'tool:composer f:composer.json f:composer.lock'
  'tool:swiftpm f:Package.swift'
  'tool:xcode g:*.(xcodeproj|xcworkspace)'
  'tool:xcworkspace g:*.xcworkspace'
  'tool:cocoapods t:xcode+f:Podfile t:xcode+f:Podfile.lock'
  'tool:carthage t:xcode+f:Cartfile t:xcode+f:Cartfile.resolved'
  'tool:tuist t:xcode+f:Tuist.swift t:xcode+f:Project.swift t:xcode+f:Workspace.swift t:xcode+d:Tuist'
  'tool:xcodegen t:xcode+f:project.yml t:xcode+f:project.yaml'
  'tool:swiftlint t:xcode+f:.swiftlint.yml t:xcode+f:.swiftlint.yaml'
  'tool:swiftformat t:xcode+f:.swiftformat'
  'tool:fastlane t:xcode+f:Fastfile t:xcode+f:fastlane/Fastfile'
  'tool:mint t:xcode+f:Mintfile'
  'tool/python:uv f:uv.lock'
  'tool/python:poetry f:poetry.lock'
  'tool/python:pdm f:pdm.lock'
  'tool/python:pixi f:pixi.toml f:pixi.lock'
  'tool/python:hatch f:hatch.toml'
  'tool/python:pipenv f:Pipfile'
  'tool/python:conda f:environment.yml f:environment.yaml'
  'tool/python:pip f:requirements.txt'
  'tool:cargo f:Cargo.toml'
  'tool:go-modules f:go.mod'
  'tool:buf f:buf.yaml f:buf.gen.yaml'
  'tool:stack f:stack.yaml'
  'tool:cabal f:cabal.project g:*.cabal'
  'tool:hpack l:haskell+f:package.yaml'
  'tool:bundler f:Gemfile'
  'tool:maven f:pom.xml'
  'tool:gradle f:build.gradle f:build.gradle.kts f:settings.gradle f:settings.gradle.kts'
  'tool:mill f:build.sc f:mill-build/build.sc'
  'tool:solution g:*.(sln|slnx)'
  'tool:nuget f:packages.lock.json f:Directory.Packages.props'
  'tool:pub f:pubspec.yaml'
  'tool:melos f:melos.yaml f:melos.yml'
  'tool:mix f:mix.exs'
  'tool:renv f:renv.lock'
  'tool:pak f:pak.lock'
  'tool:luarocks g:*.rockspec'
  'tool:cpan f:cpanfile f:Makefile.PL f:Build.PL'
  'tool:carton f:cpanfile.snapshot'
  'tool:dzil f:dist.ini'
  'tool:fpm f:fpm.toml'
  'tool:dune f:dune-project'
  'tool:opam g:*.opam'
  'tool:sbt f:build.sbt'
  'tool:rebar3 f:rebar.config'
  'tool:cmake f:CMakeLists.txt'
  'tool:meson f:meson.build'
  'tool:autotools f:configure.ac f:configure.in'
  'tool:bazel f:MODULE.bazel f:WORKSPACE f:WORKSPACE.bazel'
  'tool:conan f:conanfile.py f:conanfile.txt'
  'tool:vcpkg f:vcpkg.json'
  'tool:xmake f:xmake.lua'
  'tool:make f:Makefile f:makefile f:GNUmakefile'
  'tool:ninja f:build.ninja'
  'tool:just f:Justfile f:justfile'
  'tool:task f:Taskfile.yml f:Taskfile.yaml'
  'tool:terragrunt f:terragrunt.hcl'
  'tool:tflint f:.tflint.hcl'
  'tool:pulumi f:Pulumi.yaml'
  'tool:helm f:Chart.yaml'
  'tool:kustomize f:kustomization.yaml f:kustomization.yml'
  'tool:serverless f:serverless.yml f:serverless.yaml'
  'tool:asdf g:*.asd'
  'tool:jupyter g:*.ipynb g:notebooks/*.ipynb'
  # Frameworks use distinctive config files rather than parsing arbitrary source.
  'framework:next g:next.config.*'
  'framework:nuxt g:nuxt.config.*'
  'framework:vite g:vite.config.*'
  'framework:astro g:astro.config.*'
  'framework:remix g:remix.config.*'
  'framework:gatsby g:gatsby-config.*'
  'framework:angular f:angular.json'
  'framework:sveltekit f:svelte.config.js'
  'framework:expo f:expo-env.d.ts'
  'framework:react-native f:react-native.config.js'
  'framework:electron g:forge.config.* g:electron-builder.yml g:electron-builder.yaml g:electron-builder.json g:electron-builder.json5 g:electron-builder.js g:electron-builder.ts'
  'framework:storybook g:.storybook/main.*'
  'framework:prisma f:prisma/schema.prisma'
  'framework:django f:manage.py'
  'framework:mkdocs f:mkdocs.yml f:mkdocs.yaml'
  'framework:rails f:config/application.rb+f:bin/rails'
  'framework:phoenix g:lib/*_web/router.ex'
  'framework:tauri f:src-tauri/tauri.conf.json f:src-tauri/tauri.conf.json5'
  'framework:flutter f:pubspec.yaml+d:lib+d:android f:pubspec.yaml+d:lib+d:ios'
  'framework:laravel f:artisan'
  'framework:symfony f:symfony.lock'
  'framework:wordpress f:wp-config.php'
  'framework:drupal f:core/lib/Drupal.php'
  'framework:android f:app/src/main/AndroidManifest.xml'
  'framework:quarto f:_quarto.yml f:_quarto.yaml'
  'framework:neovim f:lazy-lock.json+d:lua'
  'framework:supabase f:supabase/config.toml'
  # Workspace and development-environment signals are intentionally compact.
  'environment:workspace f:pnpm-workspace.yaml f:turbo.json f:nx.json f:lerna.json f:rush.json f:melos.yaml f:melos.yml f:go.work'
  'environment:docker f:Dockerfile f:compose.yaml f:compose.yml f:docker-compose.yaml f:docker-compose.yml'
  'environment:devcontainer f:.devcontainer/devcontainer.json'
  'environment:nix f:flake.nix f:shell.nix'
  'environment:devenv f:devenv.nix f:devenv.yaml'
  'environment:mise f:mise.toml f:.mise.toml'
  'environment:direnv f:.envrc'
  'environment:vagrant f:Vagrantfile'
)

# Capture tokens derived once per shell from the constant rules above, for
# ordinary and saturated roots; re-sourcing resets them with the table.
typeset -ga _PROMPT_PROJECT_TOKENS=() _PROMPT_PROJECT_MANIFEST_TOKENS=()

# List the distinct evidence tokens (`f:`, `d:`, `e:`, `g:`) that the rules in
# the named array mention, negated ones included, in `reply`. Pure.
_prompt_project_rule_tokens() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local rules_name=$1
  reply=()
  [[ $rules_name == [A-Za-z_][A-Za-z0-9_]# ]] || return 1
  reply=(
    ${(u)${(M)${${(s:+:)${(j:+:)${(s: :)${(j: :)${(@P)rules_name}#* }}}}#!}:#[fdeg]:*}}
  )
}

# Classify one project root from captured marker evidence. Pure: it reads only
# the rule table, the present evidence tokens and the resolver's source
# languages named by its validated arguments, plus the saturated (`1`) and
# custom-marker (`1`) flags, and returns `kind:value` entries (`language`,
# `tool`, `framework`, `environment`) in `reply`. REPLY is `project` when a
# language or project marker identified the folder, otherwise empty. A
# saturated root keeps resolved languages first, then its manifest subset; an
# ordinary root follows rule order and appends resolved languages before its
# tools, frameworks and environment signals are decided.
_prompt_project_classify() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local rules_name=$1 evidence_name=$2 resolved_name=$3 large=$4 custom=$5
  REPLY=''
  reply=()
  [[ $rules_name == [A-Za-z_][A-Za-z0-9_]# &&
     $evidence_name == [A-Za-z_][A-Za-z0-9_]# &&
     $resolved_name == [A-Za-z_][A-Za-z0-9_]# &&
     $large == [01] && $custom == [01] ]] || return 1

  local -a evidence=("${(@P)evidence_name}")
  local -a resolved=("${(@P)resolved_name}")
  local row='' kind='' group='' value='' alt='' token='' pattern='' language=''
  local -i custom_project=$custom held=0 matched=0 merged=0
  local -a candidates=() languages=() tools=() frameworks=() environment=()
  local -a groups=()

  # Every alternative needs at least one present evidence token, so only rows
  # naming one can match; filtering keeps rule order and skips the rest.
  if (( ${#evidence} )); then
    pattern="*[ +!](${(j:|:)${(@b)evidence}})(|[ +]*)"
    candidates=(${(M)${(@P)rules_name}:#$~pattern})
  fi
  if (( large )); then
    candidates=(${(M)candidates:#manifest:*})
    for language in "${resolved[@]}"; do
      [[ $language == shell ]] && continue
      (( ${languages[(Ie)$language]} )) || languages+=("$language")
    done
  else
    candidates=(${candidates:#manifest:*})
  fi
  # A sentinel ends the identity rows, so the resolved merge below always runs
  # before tools, frameworks and environment signals are decided.
  candidates+=('merge:')

  for row in "${candidates[@]}"; do
    kind=${${row%% *}%%:*}
    value=${${row%% *}#*:}
    row=${row#* }
    group=''
    if [[ $kind == */* ]]; then
      group=${kind#*/}
      kind=${kind%%/*}
    fi
    if (( !merged )) && [[ $kind == (tool|framework|environment|merge) ]]; then
      merged=1
      # Preserve language evidence found between the current directory and
      # its owning root, including source trees deeper than the rules inspect.
      for language in "${resolved[@]}"; do
        [[ $language == shell ]] && continue
        (( ${languages[(Ie)$language]} )) || languages+=("$language")
      done
      if (( ! ${#languages} && ! custom_project &&
            ${resolved[(Ie)shell]} )); then
        languages+=(shell)
      fi
    fi
    [[ $kind == merge ]] && continue
    [[ $kind == fallback ]] && (( ${#languages} || custom_project )) && continue
    [[ -n $group ]] && (( ${groups[(Ie)$group]} )) && continue

    matched=0
    for alt in ${(s: :)row}; do
      matched=1
      for token in ${(s:+:)alt}; do
        case ${token#!} in
          (l:*) held=${languages[(Ie)${token#*:}]} ;;
          (t:*) held=${tools[(Ie)${token#*:}]} ;;
          (*) held=${evidence[(Ie)${token#!}]} ;;
        esac
        [[ $token == !* ]] && held=$(( !held ))
        if (( !held )); then
          matched=0
          break
        fi
      done
      (( matched )) && break
    done
    (( matched )) || continue

    [[ -n $group ]] && groups+=("$group")
    case $kind in
      (language|manifest|fallback)
        (( ${languages[(Ie)$value]} )) || languages+=("$value") ;;
      (custom) custom_project=1 ;;
      (tool) tools+=("$value") ;;
      (framework) frameworks+=("$value") ;;
      (environment) environment+=("$value") ;;
    esac
  done

  # A bare Git directory with no recognizable project signal should not add
  # an otherwise empty context row.
  (( ${#languages} || custom_project )) && REPLY=project
  reply=(
    ${languages/#/language:} ${tools/#/tool:}
    ${frameworks/#/framework:} ${environment/#/environment:}
  )
}

# Find the nearest project directory and render every runtime identified there.
_prompt_project_context() {
  emulate -L zsh
  setopt localoptions multibyte EXTENDED_GLOB

  local dir='' project_root=''
  local language version expected color label
  local runtime_text warning_text
  local marker hook token
  local -i large_project=0 custom_marker=0 index=0
  local -i runtime_width=0 warning_width=0
  local -a languages rendered rendered_widths matches root_entries markers
  local -a rules tokens marker_evidence reply=()
  local -a tools frameworks environment warnings warning_widths attention

  _PROMPT_PROJECT_NAME_TEXT=''
  _PROMPT_PROJECT_ROOT_TEXT=''
  _PROMPT_PROJECT_ATTENTION=''
  _PROMPT_PROJECT_ITEMS=()
  _PROMPT_PROJECT_ITEM_WIDTHS=()

  _prompt_resolve_project_root "$PWD" || return
  project_root=$REPLY
  dir=$project_root
  [[ -n $dir ]] || return

  # Detailed wildcard semantics are useful for ordinary project roots, but
  # repeatedly proving absent patterns in a directory with thousands of
  # generated entries makes latency scale with file count. Detect saturation
  # from an unsorted bounded sample and keep only already-resolved language
  # evidence plus exact manifest markers for that exceptional case.
  large_project=$(( _PROMPT_RESOLVED_SOURCE_SCAN_SATURATED ||
                    _PROMPT_RESOLVED_SOURCE_SCAN_UNSAFE ))
  if (( !large_project )); then
    root_entries=("$dir"/*(DNY129oN))
    (( ${#root_entries} >= 129 )) && large_project=1
  fi

  # Capture every marker token the applicable rules name, testing each once
  # with an exact check or a bounded wildcard; classification below is pure.
  # The token lists derive from the constant rule table once per shell.
  if (( large_project )); then
    if (( ! ${#_PROMPT_PROJECT_MANIFEST_TOKENS} )); then
      rules=(${(M)_PROMPT_PROJECT_RULES:#manifest:*})
      _prompt_project_rule_tokens rules
      _PROMPT_PROJECT_MANIFEST_TOKENS=("${reply[@]}")
    fi
    tokens=("${_PROMPT_PROJECT_MANIFEST_TOKENS[@]}")
  else
    if (( ! ${#_PROMPT_PROJECT_TOKENS} )); then
      rules=(${_PROMPT_PROJECT_RULES:#manifest:*})
      _prompt_project_rule_tokens rules
      _PROMPT_PROJECT_TOKENS=("${reply[@]}")
    fi
    tokens=("${_PROMPT_PROJECT_TOKENS[@]}")
  fi
  for token in "${tokens[@]}"; do
    case $token in
      (f:*) [[ -f $dir/${token#f:} ]] ;;
      (d:*) [[ -d $dir/${token#d:} ]] ;;
      (e:*) [[ -e $dir/${token#e:} ]] ;;
      (g:*)
        matches=("$dir"/${~token#g:}(NY1oN))
        (( ${#matches} )) ;;
    esac && marker_evidence+=("$token")
  done
  markers=("${PROMPT_PROJECT_MARKERS[@]}")
  (( large_project )) &&
    markers=("${_PROMPT_PROJECT_ROOT_MARKERS[@]}" "${markers[@]}")
  for marker in "${markers[@]}"; do
    if [[ -e "$dir/$marker" ]]; then
      custom_marker=1
      break
    fi
  done

  _prompt_project_classify _PROMPT_PROJECT_RULES marker_evidence \
    _PROMPT_RESOLVED_SOURCE_LANGUAGES "$large_project" "$custom_marker" || return
  [[ $REPLY == project ]] || return
  languages=(${${(M)reply:#language:*}#language:})
  tools=(${${(M)reply:#tool:*}#tool:})
  frameworks=(${${(M)reply:#framework:*}#framework:})
  environment=(${${(M)reply:#environment:*}#environment:})
  _PROMPT_PROJECT_ROOT_TEXT=$project_root

  for language in "${languages[@]}"; do
    # Runtime support is an optional peer resolved at capture time, never load
    # time. Without it, project identity and tool markers still work.
    (( ${+functions[_prompt_runtime_version]} )) || continue
    _prompt_runtime_version "$language" "$project_root"
    version=$REPLY
    label=${_PROMPT_RUNTIME_LABELS[$language]:-$language}
    REPLY=''
    (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt tool || :
    color=$REPLY
    if [[ $version == not-installed || $version == unavailable ||
          $version == unknown ]]; then
      REPLY=''
      (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt danger || :
      color=$REPLY
      attention+=("runtime:${label}:${version}")
    fi
    runtime_text="${label} ${version}"
    (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$runtime_text" || REPLY=${(V)runtime_text}
    runtime_width=${(m)#REPLY}
    _prompt_escape "$runtime_text"
    rendered+=("%F{${color:-default}}${REPLY}%f")
    rendered_widths+=("$runtime_width")

    (( ${+functions[_prompt_expected_runtime_version]} &&
       ${+functions[_runtime_version_relation]} )) || continue
    local _RUNTIME_REQUIREMENT_KIND=pin _RUNTIME_REQUIREMENT_SOURCE=''
    local relation='' warning_role='' requirement_word='' comparable=''
    _prompt_expected_runtime_version "$language" "$project_root"
    expected=$REPLY
    if [[ -n $expected && $version != not-installed &&
          $version != unavailable && $version != unknown ]]; then
      _runtime_comparable_version "$language" "$version"
      comparable=$REPLY
      _runtime_version_relation "$comparable" "$expected" "$_RUNTIME_REQUIREMENT_KIND"
      relation=$REPLY
      [[ $relation == match ]] && continue
      warning_role=warning
      [[ $relation == older || $relation == outside ]] && warning_role=danger
      requirement_word=wants
      [[ $_RUNTIME_REQUIREMENT_KIND == minimum ]] && requirement_word='requires ≥'
      [[ $_RUNTIME_REQUIREMENT_KIND == range ]] && requirement_word=requires
      [[ $relation == unknown ]] && relation=unverified
      [[ $relation == outside ]] && relation='outside range'
      warning_text="⚠ ${label} ${requirement_word} ${expected} · using ${version} — ${relation}"
      (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$warning_text" || REPLY=${(V)warning_text}
      warning_width=${(m)#REPLY}
      _prompt_escape "$warning_text"
      _prompt_color_text "$warning_role" "$REPLY"
      warnings+=("$REPLY")
      warning_widths+=("$warning_width")
      attention+=("mismatch:${label}:${expected}:${version}:${relation}")
    fi
  done

  # Custom hooks run after built-in detection and append through the safe helper.
  _PROMPT_PROJECT_EXTRA_SEGMENTS=()
  _PROMPT_PROJECT_EXTRA_WIDTHS=()
  for hook in "${PROMPT_PROJECT_CONTEXT_FUNCTIONS[@]}"; do
    (( ${+functions[$hook]} )) && "$hook" "$project_root"
  done

  for language in "${tools[@]}"; do
    _prompt_color_text tool "$language"
    rendered+=("$REPLY")
    rendered_widths+=("${(m)#language}")
  done
  for language in "${frameworks[@]}"; do
    _prompt_color_text framework "$language"
    rendered+=("$REPLY")
    rendered_widths+=("${(m)#language}")
  done
  for language in "${environment[@]}"; do
    _prompt_color_text container "$language"
    rendered+=("$REPLY")
    rendered_widths+=("${(m)#language}")
  done
  for (( index = 1; index <= ${#_PROMPT_PROJECT_EXTRA_SEGMENTS}; index++ )); do
    rendered+=("${_PROMPT_PROJECT_EXTRA_SEGMENTS[index]}")
    rendered_widths+=("${_PROMPT_PROJECT_EXTRA_WIDTHS[index]:-0}")
  done
  rendered+=("${warnings[@]}")
  rendered_widths+=("${warning_widths[@]}")

  _PROMPT_PROJECT_NAME_TEXT=${project_root:t}
  _PROMPT_PROJECT_ITEMS=("${rendered[@]}")
  _PROMPT_PROJECT_ITEM_WIDTHS=("${rendered_widths[@]}")
  _PROMPT_PROJECT_ATTENTION="${(j:|:)attention}"
}

# Compare only canonical high-signal facts. Rendered colors, width-dependent
# abbreviations, and routine Git dirt counts deliberately stay out of this
# fingerprint so repaint and ordinary work never make the lens bloom.
_prompt_context_observe() {
  emulate -L zsh
  local reason=''

  [[ $_PROMPT_VIEW == transcript ]] && _PROMPT_VIEW=compact
  # Expanded prompt presentation is useful only when the editor peer can
  # contract it, finish it into a transcript, and expose its manual control.
  # Resolve this optional capability at prompt time so peer source order is
  # irrelevant and prompt-only installations retain a truthful compact view.
  if (( ! ${+functions[_zle_prompt_pre_redraw]} ||
        ! ${+functions[_zle_prompt_line_finish]} ||
        ! ${+functions[_zle_prompt_toggle_widget]} )); then
    _PROMPT_INTERACTION_ACTIVE=0
    _PROMPT_VIEW=compact
    _PROMPT_LENS_PINNED=0
    _PROMPT_LAST_PROJECT_ROOT=$_PROMPT_PROJECT_ROOT_TEXT
    _PROMPT_LAST_GIT_BRANCH=$_PROMPT_GIT_BRANCH_TEXT
    _PROMPT_LAST_ENVIRONMENT=$_PROMPT_ENV_KEY
    _PROMPT_LAST_GIT_ATTENTION=$_PROMPT_GIT_ATTENTION
    _PROMPT_LAST_PROJECT_ATTENTION=$_PROMPT_PROJECT_ATTENTION
    return 0
  fi
  _PROMPT_INTERACTION_ACTIVE=1
  if (( !_PROMPT_CONTEXT_READY )); then
    if [[ -n $_PROMPT_PROJECT_ROOT_TEXT ]]; then
      reason='entered project'
    elif [[ -n $_PROMPT_GIT_BRANCH_TEXT ]]; then
      reason='entered repository'
    fi
    _PROMPT_CONTEXT_READY=1
  elif [[ -n $_PROMPT_PROJECT_ROOT_TEXT &&
          $_PROMPT_PROJECT_ROOT_TEXT != $_PROMPT_LAST_PROJECT_ROOT ]]; then
    reason='project changed'
  elif [[ -n $_PROMPT_GIT_BRANCH_TEXT &&
          $_PROMPT_GIT_BRANCH_TEXT != $_PROMPT_LAST_GIT_BRANCH ]]; then
    reason='branch changed'
  elif [[ $_PROMPT_ENV_KEY != $_PROMPT_LAST_ENVIRONMENT ]]; then
    if [[ -z $_PROMPT_ENV_KEY ]]; then
      reason='environment cleared'
    elif [[ -z $_PROMPT_LAST_ENVIRONMENT ]]; then
      reason='environment activated'
    else
      reason='environment changed'
    fi
  elif [[ $_PROMPT_GIT_ATTENTION != $_PROMPT_LAST_GIT_ATTENTION ]]; then
    if [[ -n $_PROMPT_GIT_ATTENTION ]]; then
      reason='Git needs attention'
    else
      reason='Git attention cleared'
    fi
  elif [[ $_PROMPT_PROJECT_ATTENTION != $_PROMPT_LAST_PROJECT_ATTENTION ]]; then
    if [[ -n $_PROMPT_PROJECT_ATTENTION ]]; then
      reason='runtime needs attention'
    else
      reason='runtime attention cleared'
    fi
  fi

  _PROMPT_LAST_PROJECT_ROOT=$_PROMPT_PROJECT_ROOT_TEXT
  _PROMPT_LAST_GIT_BRANCH=$_PROMPT_GIT_BRANCH_TEXT
  _PROMPT_LAST_ENVIRONMENT=$_PROMPT_ENV_KEY
  _PROMPT_LAST_GIT_ATTENTION=$_PROMPT_GIT_ATTENTION
  _PROMPT_LAST_PROJECT_ATTENTION=$_PROMPT_PROJECT_ATTENTION

  # A manual pin already shows Context and is the user's choice: a trigger,
  # such as an in-widget directory change, never turns it automatic.
  if [[ -n $reason ]] && (( !_PROMPT_LENS_PINNED )); then
    _PROMPT_VIEW=lens
    _PROMPT_LENS_REASON=$reason
  fi
  return 0
}

# The first actual edit consumes an automatic lens. Erasing that draft does not
# recreate it; only the next captured high-signal change may do so.
_prompt_interaction_update() {
  # Keep the shell option across layout helpers that use local emulation.
  local _prompt_alias_enabled=${_prompt_alias_enabled:-${options[aliases]}}
  emulate -L zsh
  local buffer=${1:-${BUFFER:-}}
  local old_prompt=$PROMPT old_segment=$_PROMPT_INTERACTION_SEGMENT
  local old_lens=$_PROMPT_LENS_SEGMENT old_view=$_PROMPT_VIEW
  local old_kind=$_PROMPT_INTERACTION_KIND

  _PROMPT_INTERACTION_ACTIVE=1
  if [[ $_PROMPT_VIEW == lens && $_PROMPT_LENS_PINNED -eq 0 &&
        -n ${buffer//[[:space:]]/} ]]; then
    _PROMPT_VIEW=compact
  elif [[ $_PROMPT_VIEW == transcript ]]; then
    _PROMPT_VIEW=compact
  fi
  _prompt_live_layout
  _prompt_base
  [[ $PROMPT != "$old_prompt" ||
     $_PROMPT_INTERACTION_SEGMENT != "$old_segment" ||
     $_PROMPT_LENS_SEGMENT != "$old_lens" ||
     $_PROMPT_VIEW != "$old_view" ||
     $_PROMPT_INTERACTION_KIND != "$old_kind" ]]
}

# Manual disclosure has three intuitive states: automatic becomes pinned,
# pinned closes, and compact opens pinned. It changes presentation only.
_prompt_toggle_lens() {
  local _prompt_alias_enabled=${_prompt_alias_enabled:-${options[aliases]}}
  emulate -L zsh
  if [[ $_PROMPT_VIEW == lens ]]; then
    if (( _PROMPT_LENS_PINNED )); then
      _PROMPT_VIEW=compact
      _PROMPT_LENS_PINNED=0
    else
      _PROMPT_LENS_PINNED=1
    fi
  else
    _PROMPT_VIEW=lens
    _PROMPT_LENS_PINNED=1
    _PROMPT_LENS_REASON='pinned context'
  fi
  _PROMPT_INTERACTION_ACTIVE=1
  _prompt_live_layout
  _prompt_base
  return 0
}

# Prepare only an inert prefix. Native ZLE paints the unchanged BUFFER beside
# it, avoiding prompt expansion of command text and preserving shell semantics.
# Empty submissions retire the active frame through this same receipt path.
_prompt_prepare_transcript() {
  emulate -L zsh
  _PROMPT_VIEW=transcript
  _PROMPT_LENS_PINNED=0
  _PROMPT_INTERACTION_KIND=ready
  _PROMPT_INTERACTION_SEGMENT=''
  _PROMPT_INTERACTION_LABELS=()
  _PROMPT_INTERACTION_VALUES=()
  _PROMPT_INTERACTION_ROLES=()
  PROMPT='%D{%H:%M} › '
  RPROMPT=''
  return 0
}

# Print a compact post-command result only for failures and existing slow-command
# threshold. The strings contain trusted numeric state only.
_prompt_capture_outcome() {
  emulate -L zsh
  local -i command_status=$1 milliseconds=0
  local -F 3 elapsed=$2
  local duration=''

  if (( elapsed < 1.0 )); then
    milliseconds=$(( elapsed * 1000 + 0.5 ))
    (( milliseconds < 0 )) && milliseconds=0
    duration="${milliseconds}ms"
  else
    local -F 1 rounded=$elapsed
    duration="${rounded}s"
  fi

  if (( command_status == 0 )); then
    _PROMPT_LAST_OUTCOME_TEXT="✓ ${duration}"
    _PROMPT_LAST_OUTCOME_ROLE=success
  else
    _PROMPT_LAST_OUTCOME_TEXT="× exit ${command_status} · ${duration}"
    _PROMPT_LAST_OUTCOME_ROLE=danger
  fi
}

_prompt_outcome_receipt() {
  emulate -L zsh
  local -i command_status=$1
  local -F 1 elapsed=$2
  local text='' role=''

  if (( command_status != 0 )); then
    text="× exit ${command_status}"
    role=danger
    (( elapsed >= 2.0 )) && text+=" · ${elapsed}s"
  elif (( elapsed >= 2.0 )); then
    text="✓ ${elapsed}s"
    role=success
  else
    return 1
  fi
  _prompt_color_text "$role" "$text"
  print -P -r -- "$REPLY"
}

_prompt_update() {
  local last_status=$?
  local _prompt_alias_enabled=${_prompt_alias_enabled:-${options[aliases]}}
  emulate -L zsh

  local -F 3 elapsed=0

  REPLY=''
  (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt symbol || :
  _PROMPT_SYMBOL_COLOR=$REPLY
  if (( last_status != 0 )); then
    REPLY=''
    (( ${+functions[_compozsh_palette_color]} )) && _compozsh_palette_color prompt danger || :
    _PROMPT_SYMBOL_COLOR=$REPLY
  fi

  if (( _PROMPT_COMMAND_STARTED > 0 )); then
    elapsed=$(( EPOCHREALTIME - _PROMPT_COMMAND_STARTED ))
    _prompt_capture_outcome "$last_status" "$elapsed"
    # Receipts are terminal presentation, never stdout protocol. A deliberately
    # forced interactive shell with redirected output remains byte-clean.
    [[ -t 1 ]] && _prompt_outcome_receipt "$last_status" "$elapsed" || :
  fi
  _PROMPT_COMMAND_STARTED=0

  # Optional manual capture starts outside editing and returns immediately;
  # its owner validates and delivers a complete snapshot independently.
  if [[ -t 0 && -t 1 ]] && (( ${+functions[_manual_prompt_request]} )); then
    _manual_prompt_request
  fi
  if [[ -t 0 && -t 1 ]] && (( ${+functions[_compozsh_prompt_capture]} )); then
    _compozsh_prompt_capture
  fi

  _prompt_capture_context
}

# Capture the local facts the prompt presents for the current folder and
# environment: env, Git, identity and path, live jobs, project and runtime
# context, the Context trigger, the layout and the window title. precmd runs it
# through _prompt_update; the editor runs it after an explicit in-widget
# directory change, so the snapshot never describes the previous folder.
# Outcomes, receipts and the manual and help capture requests stay in precmd.
_prompt_capture_context() {
  local _prompt_alias_enabled=${_prompt_alias_enabled:-${options[aliases]}}
  emulate -L zsh

  local env_name='' prompt_identity='' prompt_path='' title_path=''
  local -i job_count=0

  _PROMPT_ENV_TEXT=''
  _PROMPT_ENV_KEY=''
  if [[ -n ${VIRTUAL_ENV:-} ]]; then
    env_name=${VIRTUAL_ENV:t}
    _PROMPT_ENV_KEY="venv:${VIRTUAL_ENV}"
  elif [[ -n ${CONDA_DEFAULT_ENV:-} && ${CONDA_DEFAULT_ENV} != base ]]; then
    env_name=$CONDA_DEFAULT_ENV
    _PROMPT_ENV_KEY="conda:${CONDA_DEFAULT_ENV}"
  fi
  _PROMPT_ENV_TEXT=$env_name

  _prompt_git
  prompt_identity=${(%):-%n@%m}
  prompt_path=${(%):-%4~}
  _PROMPT_IDENTITY_TEXT=$prompt_identity
  _PROMPT_SESSION_TEXT="${prompt_identity} · zsh ${ZSH_VERSION}"
  _PROMPT_PATH_TEXT=$prompt_path
  _PROMPT_FULL_PATH_TEXT=${(%):-%~}
  # Completed jobs can remain in Zsh's table until their notification is read.
  # Observe live jobs only; prompt capture must not consume user job notices.
  local job_state=''
  for job_state in "${(@v)jobstates}"; do
    [[ $job_state == running:* || $job_state == suspended:* ]] &&
      (( ++job_count ))
  done
  if (( job_count == 1 )); then
    _PROMPT_JOBS_TEXT='1 job'
  elif (( job_count > 1 )); then
    _PROMPT_JOBS_TEXT="${job_count} jobs"
  else
    _PROMPT_JOBS_TEXT=''
  fi

  if (( ${+functions[_prompt_project_context]} )); then
    _prompt_project_context
  else
    _PROMPT_PROJECT_NAME_TEXT=''
    _PROMPT_PROJECT_ROOT_TEXT=''
    _PROMPT_PROJECT_ATTENTION=''
    _PROMPT_PROJECT_ITEMS=()
    _PROMPT_PROJECT_ITEM_WIDTHS=()
  fi

  _prompt_context_observe
  _prompt_layout
  _prompt_base

  # Keep the window/tab title useful without printing anything in the terminal.
  if [[ $TERM != dumb && -t 1 ]]; then
    title_path=${(%):-%~}
    REPLY="${prompt_identity}: ${title_path}"
    (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$REPLY" || REPLY=${(V)REPLY}
    print -rn -- $'\e]0;'"${REPLY}"$'\a'
  fi
}

_prompt_command_started() {
  emulate -L zsh

  # zsh/datetime cannot load over an inherited EPOCHREALTIME, which then stays
  # plain text. Time commands only with the module's float, never that text.
  [[ ${(t)EPOCHREALTIME} == float*special ]] &&
    _PROMPT_COMMAND_STARTED=$EPOCHREALTIME

  if [[ $TERM != dumb && -t 1 ]]; then
    # Title the command word from bounded lexical structure, never a leading
    # assignment value. An array assignment's values follow its opener as
    # separate words, so it fails closed to the identity alone, as do a
    # missing predicate and a first command without a word.
    local command_name='' word='' title_identity=${(%):-%n@%m}
    local -a words=()
    if (( ${+functions[_compozsh_is_assignment]} )); then
      words=("${(@Z+C+)${1[1,512]}}") 2>/dev/null
      for word in "${words[@]}"; do
        if _compozsh_is_assignment "$word"; then
          [[ $word == *=\( ]] && break
          continue
        fi
        [[ $word == [\;\&\|]* ]] || command_name=${(Q)word}
        break
      done
    fi
    REPLY=$title_identity
    [[ -n $command_name ]] && REPLY+=": ${command_name[1,60]}"
    (( ${+functions[_compozsh_sanitize]} )) && _compozsh_sanitize "$REPLY" || REPLY=${(V)REPLY}
    print -rn -- $'\e]0;'"${REPLY}"$'\a'
  fi
}

# SIGWINCH is sent when the window or font size changes. Preserve an existing
# initializer/vendor handler before installing the prompt's composable wrapper.
# If a later owner has wrapped or replaced that installed body, a re-source
# leaves its chain intact: wrapping it again could make a saved copy of our old
# body call back through the new shared predecessor and recurse.
typeset _prompt_existing_TRAPWINCH=${functions[TRAPWINCH]:-}
typeset -i _prompt_install_TRAPWINCH=1
if [[ -n ${_PROMPT_TRAPWINCH_BODY:-} &&
      -n $_prompt_existing_TRAPWINCH &&
      $_prompt_existing_TRAPWINCH != $_PROMPT_TRAPWINCH_BODY ]]; then
  _prompt_install_TRAPWINCH=0
elif [[ -n $_prompt_existing_TRAPWINCH &&
        $_prompt_existing_TRAPWINCH != ${_PROMPT_TRAPWINCH_BODY:-} ]]; then
  functions[_prompt_previous_TRAPWINCH]=$_prompt_existing_TRAPWINCH
elif [[ -z $_prompt_existing_TRAPWINCH ]]; then
  unfunction _prompt_previous_TRAPWINCH 2>/dev/null
fi

# Redraw only the layout of cached facts; do not rerun Git or project/toolchain
# detection while a window edge is being dragged.
if (( _prompt_install_TRAPWINCH )); then
  TRAPWINCH() {
    local _prompt_alias_enabled=${_prompt_alias_enabled:-${options[aliases]}}
    local -i previous_status=0
    if (( ${+functions[_prompt_previous_TRAPWINCH]} )); then
      _prompt_previous_TRAPWINCH "$@" || previous_status=$?
    fi
    zle || return $previous_status
    emulate -L zsh

    # Picker flags belong to the shared UI; compare text so a same-named
    # inherited variable is never evaluated as arithmetic.
    if [[ ${_ZLE_PICKER_ACTIVE-} == 1 || ${_ZLE_PICKER_SCREEN_ACTIVE-} == 1 ]] &&
        (( ${+functions[_zle_picker_redraw]} )); then
      # ZLE parameters are read-only in traps; the editor owns the writable
      # widget context as well as the cached picker layout and painting.
      zle compozsh-picker-redraw
      return $previous_status
    fi
    _prompt_layout
    _prompt_base
    zle reset-prompt
    zle -R
    return $previous_status
  }
  typeset -g _PROMPT_TRAPWINCH_BODY=${functions[TRAPWINCH]}
fi
unset _prompt_existing_TRAPWINCH _prompt_install_TRAPWINCH

# Re-sourcing the file should not stack duplicate hooks.
precmd_functions=("${precmd_functions[@]-}")
preexec_functions=("${preexec_functions[@]-}")
precmd_functions=(${precmd_functions:#_prompt_update})
precmd_functions+=(_prompt_update)
preexec_functions=(${preexec_functions:#_prompt_command_started})
preexec_functions+=(_prompt_command_started)

# The first precmd captures the complete snapshot. Until then, leave a useful
# native two-line fallback that has no dependency on another peer or palette.
PROMPT='%4~
❯ '
RPROMPT=''

:
