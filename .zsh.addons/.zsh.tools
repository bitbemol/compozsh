# Small commands and the optional guarded discard capability for g.
# Remove the former owned entry when re-sourcing; g is the only public route.
unfunction git-discard-all 2>/dev/null
unfunction _compozsh_help_git-discard-all 2>/dev/null
unalias git-discard-all 2>/dev/null
unfunction prompt-refresh _compozsh_help_prompt-refresh 2>/dev/null
unalias prompt-refresh 2>/dev/null

_tools_print_help() {
  emulate -L zsh

  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" "usage: $1" "${@:2}"
}

_compozsh_template_mkcd() { REPLY=directory; }

_compozsh_help_mkcd() {
  _tools_print_help 'mkcd [--] <directory>' \
    'Create a directory and change into it.' \
    '' \
    'Arguments:' \
    '  <directory>  Exact directory path to create and enter; quote spaces.' \
    '  --  Optional separator; the following path is always literal.' \
    '' \
    'Behavior:' \
    '  Accepts exactly one path. Missing parent directories are created with' \
    '  mkdir -p; an existing directory is entered without replacing it.' \
    '  Quote paths containing spaces. Creation of relative paths starts at' \
    '  your current directory; cd still honors normal CDPATH lookup. Prefix' \
    '  with ./ to keep it local. Use ./--help for a directory named --help.' \
    '  A creation failure prevents cd. If cd fails afterward, any directories' \
    '  already created remain. Permissions and normal cd rules still apply.' \
    '  --help shows this guide without creating or entering anything.' \
    '' \
    'Compose a directory:' \
    '  Option-Return on mkcd offers Compose this command when .zsh.compose is enabled.' \
    '  Compose example in terminal help opens the same literal Directory field.' \
    '  Its preview updates while typing. Enter absolute or ./relative paths;' \
    '  variables and ~ are literal in this form. Fields are limited to 4,096 characters.' \
    '  Replace draft inserts a quoted command after cleanup; it never creates or enters.' \
    '  Escape preserves the original draft and cursor.' \
    '' \
    'Examples:' \
    '  mkcd ~/Projects/example-app' \
    '  mkcd "notes/draft ideas"' \
    '  mkcd ./--help'
}

_compozsh_help_cpdir() {
  _tools_print_help 'cpdir' \
    'Copy the exact current directory to the local macOS clipboard.' \
    '' \
    'Behavior:' \
    '  Copies the logical absolute path in $PWD, preserving symlink spelling' \
    '  and spaces, without a trailing newline. The value is not shell-quoted;' \
    '  quote or escape it appropriately when pasting into a shell command.' \
    '  Replaces clipboard contents and prints a confirmation on success.' \
    '  The confirmation uses the prompt path color on supported terminals.' \
    '  NO_COLOR, redirected output, or a missing palette keeps it plain.' \
    '  Requires pbcopy on PATH. Missing or failed clipboard access returns 1.' \
    '  In SSH, pbcopy runs on the remote host; it does not transfer the path' \
    '  to your client clipboard. No directory argument is accepted.' \
    '  --help shows this guide without accessing the clipboard.' \
    '' \
    'Examples:' \
    '  cpdir       Copy this directory, then paste in an editor or file dialog.'
}

mkcd() {
  emulate -L zsh

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    local -a help=(_compozsh_help_mkcd)
    (( ${+functions[_compozsh_help_show]} )) && help=(_compozsh_help_show "${help[@]}")
    "${help[@]}"
    return 0
  fi
  (( $# == 2 )) && [[ $1 == -- ]] && shift
  (( $# == 1 )) || { print -u2 'usage: mkcd [--] <directory>'; return 2; }
  command mkdir -p -- "$1" && builtin cd -- "$1"
}

# Copy the exact logical working directory to the local macOS clipboard.
cpdir() {
  emulate -L zsh
  setopt PIPE_FAIL

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    local -a help=(_compozsh_help_cpdir)
    (( ${+functions[_compozsh_help_show]} )) && help=(_compozsh_help_show "${help[@]}")
    "${help[@]}"
    return 0
  fi
  (( $# == 0 )) || {
    print -u2 'usage: cpdir'
    return 2
  }

  local clipboard_command=${commands[pbcopy]:-} display_path=''
  [[ -n $clipboard_command ]] || {
    print -u2 'cpdir: pbcopy is unavailable on this machine'
    return 1
  }

  print -rn -- "$PWD" | "$clipboard_command" || {
    print -u2 'cpdir: could not copy the current directory'
    return 1
  }

  _tools_sanitize "$PWD"
  display_path=$REPLY
  # Resolve the shared path role at invocation, independent of peer load order.
  # Raw SGR around sanitized text avoids evaluating path data as prompt syntax.
  local path_color=''
  [[ ${(t)ZSH_PROMPT_COLORS} == association* ]] &&
    path_color=${ZSH_PROMPT_COLORS[path]:-}
  if [[ $path_color != <0-255> && ${(t)_COMPOZSH_COLOR_FALLBACKS} == association* ]]; then
    path_color=${_COMPOZSH_COLOR_FALLBACKS[prompt:path]-}
  fi
  if [[ -t 1 && -n $TERM && $TERM != dumb && -z ${NO_COLOR:-} &&
        $path_color == <0-255> ]] &&
     zmodload -F zsh/terminfo p:terminfo 2>/dev/null &&
     (( ${terminfo[colors]:-0} >= 256 )); then
    display_path=$'\e[38;5;'"${path_color}m${display_path}"$'\e[39m'
  fi
  print -r -- "Copied ${display_path} to the clipboard."
}

_tools_sanitize() {
  REPLY=${1//[[:cntrl:]]/?}
}

_tools_git_operation() {
  emulate -L zsh

  local git_dir=$1
  REPLY=''
  if [[ -f "$git_dir/MERGE_HEAD" ]]; then
    REPLY='merge'
  elif [[ -f "$git_dir/CHERRY_PICK_HEAD" ]]; then
    REPLY='cherry-pick'
  elif [[ -f "$git_dir/REVERT_HEAD" ]]; then
    REPLY='revert'
  elif [[ -f "$git_dir/BISECT_LOG" ]]; then
    REPLY='bisect'
  elif [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]; then
    REPLY='rebase'
  elif [[ -d "$git_dir/sequencer" ]]; then
    # --no-commit sequences can stop without CHERRY_PICK_HEAD or REVERT_HEAD.
    REPLY='cherry-pick/revert'
  fi
}

# Git status and restore can invoke repository-configured content filters.
# Discover bounded driver names, then override each one for a single command;
# repository and user configuration remain untouched.
_tools_git_filter_config() {
  emulate -L zsh

  local root=$1 packet='' config_output='' tail='' key='' driver=''
  local -A seen=()
  reply=()
  packet=$( {
      GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
        GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
        -C "$root" -c core.fsmonitor=false -c core.untrackedCache=false \
        -c core.hooksPath=/dev/null config --null --name-only \
        --get-regexp '^filter\..*\.(clean|smudge|process|required)$' 2>/dev/null
      print -rn -- $'\0'"$?"
    } | {
      local chunk=''
      IFS= read -r -u 0 -k 65539 chunk || :
      print -rn -- "$chunk"
    } )
  (( ${#packet} <= 65538 )) || return 1
  [[ $packet == *$'\0'* ]] || return 1
  tail=${packet##*$'\0'}
  config_output=${packet%$'\0'*}
  [[ $tail == 0 || $tail == 1 ]] || return 1

  while IFS= read -r -d '' key; do
    driver=${${key#filter.}%.*}
    [[ -n $driver && -z ${seen[$driver]-} ]] || continue
    seen[$driver]=1
    reply+=(
      -c "filter.${driver}.clean="
      -c "filter.${driver}.smudge="
      -c "filter.${driver}.process="
      -c "filter.${driver}.required=false"
    )
  done <<< "$config_output"
}

# Restore the entire repository to HEAD and remove untracked files after an
# explicit preview and confirmation. Ignored files, stashes, and commits stay.
_tools_discard_confirm() {
  _zle_ui_view query _tools_discard_confirm_view "$@"
}

_tools_discard_confirm_view() {
  emulate -L zsh
  local -a _ZLE_PICKER_DISPLAY=() _ZLE_PICKER_BOOKMARK=()
  local _ZLE_PICKER_SELECTED_VALUE=''
  _ZLE_PICKER_TITLE='Git / Discard confirmation' _ZLE_PICKER_SUBTITLE=$1
  _ZLE_PICKER_QUERY_LABEL='Discard everything listed above? [y/N]'
  _ZLE_PICKER_QUERY_EMPTY_CANCEL=1
  _ZLE_PICKER_INSPECT_ACTION=confirm _ZLE_PICKER_CANCEL_LABEL=cancel
  _ZLE_PICKER_BROWSE_LABEL='Destructive · y or Y confirms · empty input cancels'
  _ZLE_PICKER_EMPTY_LINES=(
    'Permanently discard staged and unstaged tracked changes.'
    'Delete untracked files and directories across this repository.'
    'Ignored files, stashes, commits, and nested repositories are preserved.'
    '' 'The complete status was printed before this screen.'
    'After closing, repository state is revalidated before any write.')
  _ZLE_PICKER_INSPECT_TITLE='Captured status'
  _ZLE_PICKER_INSPECT_FIXED_KEY=changes
  _ZLE_PICKER_INSPECT_TEXTS=(changes "${2[1,32768]}")
  (( ${#2} > 32768 )) && _ZLE_PICKER_INSPECT_TEXTS[changes]+=$'\n[Preview limited to 32,768 characters; full status is in scrollback.]'
  _zle_picker_run 10 '' || return 1
  [[ $_ZLE_PICKER_SELECTED_VALUE == [yY] ]]
}

_tools_git_discard_all() {
  emulate -L zsh

  (( $# == 0 )) || {
    print -u2 'usage: g [git-arguments ...]'
    return 2
  }

  # Even the initial HEAD validation can fetch missing promisor objects.
  # Scope the local-only boundary around every read and mutation in this action.
  local -x GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0
  local -x GIT_ALLOW_PROTOCOL=''
  local root='' confirmed_root='' display_root='' git_dir='' confirmed_git_dir=''
  local operation='' head='' confirmed_head=''
  local changes='' confirmed_changes='' remaining='' answer=''
  local -a filter_config=() confirmed_filter_config=()
  local -i filter_config_changed=0 index=0

  root=$(command git rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 'g --discard-all: not inside a Git working tree'
    return 1
  }
  head=$(command git -C "$root" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) || {
    print -u2 'g --discard-all: this repository has no commit to restore'
    return 1
  }

  git_dir=$(command git -C "$root" rev-parse --absolute-git-dir 2>/dev/null) || {
    print -u2 'g --discard-all: could not inspect repository state'
    return 1
  }
  _tools_git_operation "$git_dir"
  operation=$REPLY
  if [[ -n $operation ]]; then
    print -u2 -- "g --discard-all: refusing during an active ${operation} operation"
    print -u2 'Finish or abort that operation explicitly first.'
    return 1
  fi

  _tools_git_filter_config "$root" || {
    print -u2 'g --discard-all: could not validate repository content filters'
    return 1
  }
  filter_config=("${reply[@]}")
  changes=$(GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
    GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
    -C "$root" -c core.fsmonitor=false -c core.untrackedCache=false \
    -c core.hooksPath=/dev/null "${filter_config[@]}" status \
    --porcelain=v1 --untracked-files=all) || {
    print -u2 'g --discard-all: could not inspect the working tree'
    return 1
  }
  if [[ -z $changes ]]; then
    print -- 'Nothing to discard; the working tree is already clean.'
    return 0
  fi

  print -r -- "$changes"
  print
  print -u2 'This permanently discards staged and unstaged tracked changes'
  print -u2 'and deletes untracked files and directories across the repository.'
  print -u2 'Ignored files, stashes, commits, and nested repositories are preserved.'

  if [[ -t 0 && -t 1 && $TERM != dumb ]] &&
     (( ${+functions[_zle_ui_view]} && ${+functions[_zle_picker_run]} )); then
    _tools_discard_confirm "$root" "$changes" && answer=y
  else
    read -r "answer?Discard everything listed above? [y/N] "
  fi
  if [[ $answer != [yY] ]]; then
    print -- 'Cancelled; nothing was changed.'
    return 1
  fi

  confirmed_root=$(command git -C "$root" rev-parse --show-toplevel 2>/dev/null) &&
    confirmed_head=$(command git -C "$root" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) &&
    confirmed_git_dir=$(command git -C "$root" rev-parse --absolute-git-dir 2>/dev/null) || {
      print -u2 'g --discard-all: could not revalidate the repository after confirmation; nothing was discarded'
      return 1
    }
  _tools_git_operation "$confirmed_git_dir"
  operation=$REPLY
  _tools_git_filter_config "$root" || {
    print -u2 'g --discard-all: repository filter configuration changed after the preview; nothing was discarded'
    return 1
  }
  confirmed_filter_config=("${reply[@]}")
  if (( ${#confirmed_filter_config} != ${#filter_config} )); then
    filter_config_changed=1
  else
    for (( index = 1; index <= ${#filter_config}; ++index )); do
      [[ ${confirmed_filter_config[index]} == "${filter_config[index]}" ]] || {
        filter_config_changed=1
        break
      }
    done
  fi
  confirmed_changes=$(GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
    GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
    -C "$root" -c core.fsmonitor=false -c core.untrackedCache=false \
    -c core.hooksPath=/dev/null "${confirmed_filter_config[@]}" status \
    --porcelain=v1 --untracked-files=all) || {
    print -u2 'g --discard-all: could not revalidate the working tree; nothing was discarded'
    return 1
  }
  if [[ $confirmed_root != "$root" || $confirmed_git_dir != "$git_dir" ||
        $confirmed_head != "$head" || -n $operation ||
        $filter_config_changed != 0 ||
        $confirmed_changes != "$changes" ]]; then
    print -u2 'g --discard-all: repository state changed after the preview; nothing was discarded'
    return 1
  fi

  GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
    GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
    -C "$root" -c core.fsmonitor=false -c core.untrackedCache=false \
    -c core.hooksPath=/dev/null "${confirmed_filter_config[@]}" \
    restore --source="$confirmed_head" --staged --worktree --no-recurse-submodules -- . || {
    print -u2 'g --discard-all: failed while restoring tracked files'
    return 1
  }
  GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
    GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
    -C "$root" -c core.fsmonitor=false -c core.untrackedCache=false \
    -c core.hooksPath=/dev/null "${confirmed_filter_config[@]}" \
    clean -fdq -- . || {
    print -u2 'g --discard-all: tracked files were restored, but cleaning failed'
    return 1
  }

  remaining=$(GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 \
    GIT_ALLOW_PROTOCOL='' command git --no-pager --no-replace-objects \
    -C "$root" -c core.fsmonitor=false -c core.untrackedCache=false \
    -c core.hooksPath=/dev/null "${confirmed_filter_config[@]}" status \
    --porcelain=v1 --untracked-files=all) || {
    print -u2 'g --discard-all: changes were applied, but verification failed'
    return 1
  }
  if [[ -n $remaining ]]; then
    print -u2 'Some changes remain, usually inside a submodule or nested repository:'
    print -ru2 -- "$remaining"
    return 1
  fi

  _tools_sanitize "$root"
  display_root=$REPLY
  print -- "Discarded all working-tree changes in ${display_root}."
}

# Refresh cached executable versions and capabilities after installing or
# upgrading a tool without starting a new shell. The next use rebuilds them.
_tools_refresh() {
  emulate -L zsh
  (( ${+functions[_manual_summary_reset]} )) && _manual_summary_reset
  (( ${+parameters[_PROMPT_RUNTIME_VERSION_CACHE]} )) &&
    _PROMPT_RUNTIME_VERSION_CACHE=()
  (( ${+parameters[_PROMPT_GIT_DIR_CACHE]} )) &&
    _PROMPT_GIT_DIR_CACHE=()
  (( ${+parameters[_GREP_SUPPORTS_COLOR]} )) &&
    _GREP_SUPPORTS_COLOR=-1
  (( ${+parameters[_GREP_COLOR_BINARY]} )) &&
    _GREP_COLOR_BINARY=''
  rehash
}

:
