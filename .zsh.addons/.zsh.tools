# Small commands and safe Git cleanup.

_tools_print_help() {
  emulate -L zsh

  local -a printer=(print -rl --)
  (( ${+functions[_output_print_help]} )) && printer=(_output_print_help)
  "${printer[@]}" "usage: $1" "${@:2}"
}

_compozsh_help_mkcd() {
  _tools_print_help 'mkcd <directory>' \
    'Create a directory and change into it.' \
    '' \
    'Behavior:' \
    '  Accepts exactly one path. Missing parent directories are created with' \
    '  mkdir -p; an existing directory is entered without replacing it.' \
    '  Quote paths containing spaces. Creation of relative paths starts at' \
    '  your current directory; cd still honors normal CDPATH lookup. Prefix' \
    '  with ./ to keep it local. Use ./--help for a directory named --help.' \
    '  A creation failure prevents cd. If cd fails afterward, any directories' \
    '  already created remain. Permissions and normal cd rules still apply.' \
    '  --help shows this guide without creating or entering anything.' \
    '' \
    'Examples:' \
    '  mkcd ~/Projects/example-app' \
    '  mkcd "notes/draft ideas"' \
    '  mkcd ./--help'
}

_compozsh_help_cpdir() {
  _tools_print_help 'cpdir' \
    'Copy the exact current directory to the local macOS clipboard.' \
    '' \
    'Behavior:' \
    '  Copies the logical absolute path in $PWD, preserving symlink spelling' \
    '  and spaces, without a trailing newline. The value is not shell-quoted;' \
    '  quote or escape it appropriately when pasting into a shell command.' \
    '  Replaces clipboard contents and prints a confirmation on success.' \
    '  The confirmation uses the prompt path color on supported terminals.' \
    '  NO_COLOR, redirected output, or a missing palette keeps it plain.' \
    '  Requires pbcopy on PATH. Missing or failed clipboard access returns 1.' \
    '  In SSH, pbcopy runs on the remote host; it does not transfer the path' \
    '  to your client clipboard. No directory argument is accepted.' \
    '  --help shows this guide without accessing the clipboard.' \
    '' \
    'Examples:' \
    '  cpdir       Copy this directory, then paste in an editor or file dialog.'
}

_compozsh_help_git-discard-all() {
  _tools_print_help 'git-discard-all' \
    'Preview and discard staged, unstaged, and untracked working-tree changes.' \
    '' \
    'Scope and confirmation:' \
    '  Operates from the repository root even when called in a subfolder.' \
    '  Restores tracked files and the index to HEAD, discarding both staged' \
    '  and unstaged edits, then deletes untracked files and directories.' \
    '  Prints Git status before asking [y/N]; only y or Y confirms.' \
    '  Enter or any other answer cancels. No force/yes option is provided.' \
    '  A clean working tree needs no confirmation and returns success.' \
    '' \
    'Safety and limitations:' \
    '  Keeps ignored files, commits, stashes, nested repositories, and' \
    '  submodule contents. Refuses a repository with no HEAD commit or an' \
    '  active merge, rebase, cherry-pick, revert, or bisect operation.' \
    '  Discarded work has no automatic backup or rollback. If a later step' \
    '  fails, earlier changes can already have been applied; inspect status.' \
    '  Remaining nested-repository/submodule changes are reported as failure.' \
    '  Requires Git. Cancellation or failure returns nonzero.' \
    '  --help shows this guide without inspecting or modifying a repository.' \
    '' \
    'Examples:' \
    '  git-discard-all              Preview and confirm repository-wide loss.' \
    '  git stash --include-untracked  Use instead to save work for later.'
}

_compozsh_help_prompt-refresh() {
  _tools_print_help 'prompt-refresh' \
    'Clear in-memory prompt and tool caches, then refresh command lookup.' \
    '' \
    'Behavior:' \
    '  Clears cached runtime versions, Git-directory information, and grep' \
    '  color-capability detection in the current shell, then runs rehash.' \
    '  Relevant caches are rebuilt on their next use. No tools are installed' \
    '  or upgraded, and other terminal sessions are unchanged.' \
    '  Use after installing/upgrading a tool or changing PATH in this shell.' \
    '  This does not reload add-ons or your initializer. Use exec zsh to load' \
    '  configuration changes into a fresh shell.' \
    '  Takes no arguments; --help shows this guide without clearing caches.' \
    '' \
    'Examples:' \
    '  prompt-refresh    Refresh lookup after a tool installation.' \
    '  exec zsh          Reload configuration after editing your add-ons.'
}

mkcd() {
  emulate -L zsh

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_mkcd
    return 0
  fi
  (( $# == 1 )) || { print -u2 'usage: mkcd <directory>'; return 2; }
  command mkdir -p -- "$1" && builtin cd -- "$1"
}

# Copy the exact logical working directory to the local macOS clipboard.
cpdir() {
  emulate -L zsh
  setopt PIPE_FAIL

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_cpdir
    return 0
  fi
  (( $# == 0 )) || {
    print -u2 'usage: cpdir'
    return 2
  }

  local clipboard_command=${commands[pbcopy]:-} display_path=''
  [[ -n $clipboard_command ]] || {
    print -u2 'cpdir: pbcopy is unavailable on this machine'
    return 1
  }

  print -rn -- "$PWD" | "$clipboard_command" || {
    print -u2 'cpdir: could not copy the current directory'
    return 1
  }

  _tools_sanitize "$PWD"
  display_path=$REPLY
  # Resolve the shared path role at invocation, independent of peer load order.
  # Raw SGR around sanitized text avoids evaluating path data as prompt syntax.
  local path_color=''
  [[ ${(t)ZSH_PROMPT_COLORS} == association* ]] &&
    path_color=${ZSH_PROMPT_COLORS[path]:-}
  if [[ -t 1 && -n $TERM && $TERM != dumb && -z ${NO_COLOR:-} &&
        $path_color == <0-255> ]] &&
     zmodload -F zsh/terminfo p:terminfo 2>/dev/null &&
     (( ${terminfo[colors]:-0} >= 256 )); then
    display_path=$'\e[38;5;'"${path_color}m${display_path}"$'\e[39m'
  fi
  print -r -- "Copied ${display_path} to the clipboard."
}

_tools_sanitize() {
  REPLY=${1//[[:cntrl:]]/?}
}

_tools_git_operation() {
  emulate -L zsh

  local git_dir=$1
  REPLY=''
  if [[ -f "$git_dir/MERGE_HEAD" ]]; then
    REPLY='merge'
  elif [[ -f "$git_dir/CHERRY_PICK_HEAD" ]]; then
    REPLY='cherry-pick'
  elif [[ -f "$git_dir/REVERT_HEAD" ]]; then
    REPLY='revert'
  elif [[ -f "$git_dir/BISECT_LOG" ]]; then
    REPLY='bisect'
  elif [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]; then
    REPLY='rebase'
  fi
}

# Restore the entire repository to HEAD and remove untracked files after an
# explicit preview and confirmation. Ignored files, stashes, and commits stay.
git-discard-all() {
  emulate -L zsh

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_git-discard-all
    return 0
  fi
  (( $# == 0 )) || {
    print -u2 'usage: git-discard-all'
    return 2
  }

  local root='' display_root='' git_dir='' operation=''
  local changes='' remaining='' answer=''

  root=$(command git rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 'git-discard-all: not inside a Git working tree'
    return 1
  }
  command git -C "$root" rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1 || {
    print -u2 'git-discard-all: this repository has no commit to restore'
    return 1
  }

  git_dir=$(command git -C "$root" rev-parse --absolute-git-dir 2>/dev/null) || {
    print -u2 'git-discard-all: could not inspect repository state'
    return 1
  }
  _tools_git_operation "$git_dir"
  operation=$REPLY
  if [[ -n $operation ]]; then
    print -u2 -- "git-discard-all: refusing during an active ${operation} operation"
    print -u2 'Finish or abort that operation explicitly first.'
    return 1
  fi

  changes=$(command git -C "$root" -c core.fsmonitor=false status \
    --porcelain=v1 --untracked-files=all) || {
    print -u2 'git-discard-all: could not inspect the working tree'
    return 1
  }
  if [[ -z $changes ]]; then
    print -- 'Nothing to discard; the working tree is already clean.'
    return 0
  fi

  print -r -- "$changes"
  print
  print -u2 'This permanently discards staged and unstaged tracked changes'
  print -u2 'and deletes untracked files and directories across the repository.'
  print -u2 'Ignored files, stashes, commits, and nested repositories are preserved.'

  read -r "answer?Discard everything listed above? [y/N] "
  if [[ $answer != [yY] ]]; then
    print -- 'Cancelled; nothing was changed.'
    return 1
  fi

  command git -C "$root" restore --source=HEAD --staged --worktree -- . || {
    print -u2 'git-discard-all: failed while restoring tracked files'
    return 1
  }
  command git -C "$root" clean -fdq -- . || {
    print -u2 'git-discard-all: tracked files were restored, but cleaning failed'
    return 1
  }

  remaining=$(command git -C "$root" -c core.fsmonitor=false status \
    --porcelain=v1 --untracked-files=all) || {
    print -u2 'git-discard-all: changes were applied, but verification failed'
    return 1
  }
  if [[ -n $remaining ]]; then
    print -u2 'Some changes remain, usually inside a submodule or nested repository:'
    print -ru2 -- "$remaining"
    return 1
  fi

  _tools_sanitize "$root"
  display_root=$REPLY
  print -- "Discarded all working-tree changes in ${display_root}."
}

# Refresh cached executable versions and capabilities after installing or
# upgrading a tool without starting a new shell. The next use rebuilds them.
prompt-refresh() {
  emulate -L zsh

  if (( $# == 1 )) && [[ $1 == --help ]]; then
    _compozsh_help_prompt-refresh
    return 0
  fi
  (( $# == 0 )) || {
    print -u2 'usage: prompt-refresh'
    return 2
  }
  (( ${+parameters[_PROMPT_RUNTIME_VERSION_CACHE]} )) &&
    _PROMPT_RUNTIME_VERSION_CACHE=()
  (( ${+parameters[_PROMPT_GIT_DIR_CACHE]} )) &&
    _PROMPT_GIT_DIR_CACHE=()
  (( ${+parameters[_GREP_SUPPORTS_COLOR]} )) &&
    _GREP_SUPPORTS_COLOR=-1
  (( ${+parameters[_GREP_COLOR_BINARY]} )) &&
    _GREP_COLOR_BINARY=''
  rehash
}

:
