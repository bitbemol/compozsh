# -----------------------------------------------------------------------------
# Native completion and line editing
# -----------------------------------------------------------------------------

autoload -Uz compinit
# Preserve compinit's full ownership/permission audit on a fresh shell, but do
# not repeat the same initialization when this file is sourced again.
if (( ! ${+_comps} )) || [[ ${(t)_comps} != association* ]]; then
  compinit
fi

zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' squeeze-slashes true
zstyle ':completion:*' matcher-list \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*'
zstyle ':completion:*:descriptions' format '%F{cyan}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}no matches%f'
if [[ -n ${LS_COLORS:-} ]]; then
  typeset -gi _COMPOZSH_COMPLETION_COLORS_CUSTOM=1
  zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
else
  if (( !${#_COMPOZSH_COMPLETION_LIST_COLORS} )); then
    typeset -ga _COMPOZSH_COMPLETION_LIST_COLORS=(
      'di=1;38;5;39' 'ln=38;5;207' 'so=38;5;44' 'pi=38;5;220'
      'ex=1;38;5;83' 'bd=1;38;5;203' 'cd=38;5;209'
      'or=1;4;38;5;203' 'mi=1;38;5;196'
      'su=1;38;5;229;48;5;203' 'sg=1;38;5;229;48;5;176'
      'tw=38;5;16;48;5;220' 'ow=38;5;16;48;5;203'
      'st=38;5;16;48;5;215' 'ca=1;38;5;221'
    )
  fi
  typeset -gi _COMPOZSH_COMPLETION_COLORS_CUSTOM=0
  zstyle ':completion:*' list-colors "${_COMPOZSH_COMPLETION_LIST_COLORS[@]}"
fi

# Apple keyboards omit dedicated Home, End, and forward-Delete keys. Use Zsh's
# Emacs map as the primary, portable macOS editing layer; keep terminal escape
# sequences below as optional aliases for full-size and Fn/Globe key chords.
bindkey -e
KEYTIMEOUT=${KEYTIMEOUT:-10}
zmodload zsh/terminfo
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search edit-command-line
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
zle -N edit-command-line

_bind_zle_keys() {
  local widget=$1 key=''
  shift
  for key in "$@"; do
    [[ -n $key ]] && bindkey "$key" "$widget"
  done
}

# Bind both terminfo capabilities and the normal/application sequences emitted
# by Terminal, iTerm2, and common SSH terminals. Duplicate bindings are benign.
_bind_zle_keys up-line-or-beginning-search \
  '^P' "${terminfo[kcuu1]:-}" $'\e[A' $'\eOA'
_bind_zle_keys down-line-or-beginning-search \
  '^N' "${terminfo[kcud1]:-}" $'\e[B' $'\eOB'
_bind_zle_keys backward-char \
  '^B' "${terminfo[kcub1]:-}" $'\e[D' $'\eOD'
_bind_zle_keys forward-char \
  '^F' "${terminfo[kcuf1]:-}" $'\e[C' $'\eOC'
_bind_zle_keys beginning-of-line \
  '^A' "${terminfo[khome]:-}" $'\e[H' $'\eOH' $'\e[1~'
_bind_zle_keys end-of-line \
  '^E' "${terminfo[kend]:-}" $'\e[F' $'\eOF' $'\e[4~'
_bind_zle_keys delete-char \
  "${terminfo[kdch1]:-}" $'\e[3~'
_bind_zle_keys backward-word \
  $'\eb' $'\e[1;3D'
_bind_zle_keys forward-word \
  $'\ef' $'\e[1;3C'
_bind_zle_keys backward-kill-word \
  $'\e\x7f' $'\e\b'
_bind_zle_keys reverse-menu-complete \
  "${terminfo[kcbt]:-}" $'\e[Z'
_bind_zle_keys edit-command-line '^X^E'

# Keep keyed fallback lookups safe when the optional highlighting peer is absent.
typeset -gA ZSH_HIGHLIGHT_STYLES

# Shared state for the native history and navigation pickers. Collection stays
# feature-specific; rendering, input, resize, and cleanup use this one contract.
typeset -ga _ZLE_PICKER_RESULTS=()
typeset -ga _ZLE_PICKER_LABELS=()
# Optional secondary labels, keyed by the unchanged action value.
typeset -gA _ZLE_PICKER_CONTEXTS=()
# Optional zero-based, end-exclusive label spans keyed by the unchanged action
# value. Each `start:end:picker-role` token describes presentation metadata;
# labels remain plain text and retain exact width and matching semantics.
typeset -gA _ZLE_PICKER_LABEL_HIGHLIGHTS=()
typeset -ga _ZLE_PICKER_RESULT_INDEXES=()
typeset -ga _ZLE_PICKER_DISPLAY=()
typeset -ga _ZLE_PICKER_DISPLAY_STYLES=()
typeset -ga _ZLE_PICKER_DISPLAY_INDEX_ENDS=()
typeset -ga _ZLE_PICKER_DISPLAY_HIGHLIGHTS=()
typeset -g _ZLE_PICKER_TITLE=''
# Optional caller-owned location, separate from the title and editable filter.
typeset -g _ZLE_PICKER_SUBTITLE=''
typeset -g _ZLE_PICKER_SUBTITLE_ROW=''
typeset -g _ZLE_PICKER_BROWSE_LABEL='items'
typeset -g _ZLE_PICKER_EMPTY_LABEL='no matches'
# Optional informational rows; never added to the selectable result array.
typeset -ga _ZLE_PICKER_EMPTY_LINES=()
# Optional passive rows shown after selectable results. They consume body space
# but never receive selection indexes, matching, navigation, or actions.
typeset -ga _ZLE_PICKER_PASSIVE_LINES=()
typeset -ga _ZLE_PICKER_PASSIVE_STYLES=()
typeset -gi _ZLE_PICKER_GUIDE_ACTIVE=0
typeset -gi _ZLE_PICKER_GUIDE_OFFSET=0
typeset -gi _ZLE_PICKER_GUIDE_PAGE=1
typeset -g _ZLE_PICKER_CANCEL_LABEL=''
typeset -g _ZLE_PICKER_COLLECTOR=''
typeset -g _ZLE_PICKER_HEADER=''
typeset -g _ZLE_PICKER_TITLEBAR=''
typeset -gi _ZLE_PICKER_TITLEBAR_META_START=-1
typeset -g _ZLE_PICKER_QUERY_ROW=''
typeset -gi _ZLE_PICKER_QUERY_START=0
typeset -gi _ZLE_PICKER_QUERY_END=0
typeset -g _ZLE_PICKER_POSTDISPLAY=''
typeset -g _ZLE_PICKER_QUERY=''
typeset -gi _ZLE_PICKER_SELECTED=0
typeset -g _ZLE_PICKER_SELECTED_VALUE=''
# A caller can return from a secondary picker using this accepted position.
typeset -ga _ZLE_PICKER_BOOKMARK=()
typeset -gi _ZLE_PICKER_BOOKMARK_FOCUS=0
typeset -gA _ZLE_PICKER_ACCEPT_LABELS=()
typeset -gi _ZLE_PICKER_ACTIVE=0
typeset -gi _ZLE_PICKER_ACCEPTED=0
typeset -gi _ZLE_PICKER_DIGIT_SELECT=0
typeset -gi _ZLE_PICKER_COPY_ENABLED=0
typeset -gi _ZLE_PICKER_HIERARCHY_ENABLED=0
typeset -gi _ZLE_PICKER_REFRESH_ENABLED=0
typeset -gi _ZLE_PICKER_STATUS_VIEW=0
typeset -ga _ZLE_PICKER_BUSY_STYLES=()
# Optional folder-workspace capabilities: 1 browser, 2 recent locations.
typeset -gi _ZLE_PICKER_DIRECTORY_ACTIONS=0
typeset -ga _ZLE_PICKER_TRAIL=()
typeset -ga _ZLE_PICKER_DISPLAY_PREFIX_ENDS=()
typeset -g _ZLE_PICKER_ACTION='select'
typeset -gi _ZLE_PICKER_INDEXES_VISIBLE=0
typeset -gi _ZLE_PICKER_VISIBLE_COUNT=0
typeset -gi _ZLE_PICKER_VIEW_LIMIT=20
typeset -gi _ZLE_PICKER_VIEW_OFFSET=0
typeset -gi _ZLE_PICKER_HAS_MORE=0
typeset -ga _ZLE_PICKER_VISIBLE_KEYS=()
typeset -g _ZLE_PICKER_BOOTSTRAP=''
typeset -gi _ZLE_PICKER_RUN_LIMIT=10

# Optional, caller-owned snapshot. Rendering and input never invoke providers.
typeset -gA _ZLE_PICKER_INSPECT_TEXTS=()
# Optional snapshot key used when the caller has context but no selected row.
typeset -g _ZLE_PICKER_INSPECT_FALLBACK=''
typeset -g _ZLE_PICKER_INSPECT_TITLE=Details
typeset -g _ZLE_PICKER_INSPECT_ACTION=select
typeset -gi _ZLE_PICKER_INSPECT_FOCUS=0
typeset -gi _ZLE_PICKER_INSPECT_OFFSET=0
typeset -gi _ZLE_PICKER_INSPECT_WIDTH=0
typeset -gi _ZLE_PICKER_INSPECT_PAGE=1
typeset -g _ZLE_PICKER_INSPECT_KEY=''
# A caller may request more reading room for one explicitly loaded snapshot.
typeset -g _ZLE_PICKER_INSPECT_EXPAND_KEY=''
typeset -ga _ZLE_PICKER_INSPECT_LINES=()
typeset -ga _ZLE_PICKER_INSPECT_ROLES=()
# A document is the primary reading surface; providers remain caller-owned.
typeset -gi _ZLE_PICKER_DOCUMENT=0
typeset -g _ZLE_PICKER_DOCUMENT_MODE=''
typeset -gi _ZLE_PICKER_DOCUMENT_REFRESH=0
typeset -g _ZLE_PICKER_DOCUMENT_KEY=''
typeset -g _ZLE_PICKER_DOCUMENT_TITLE=''
typeset -gi _ZLE_PICKER_DOCUMENT_PENDING=0
# Document workspaces may let list selection outrun expensive preview capture.
# Zero preserves immediate controller handoff; Git review opts into a small
# input-idle settlement measured in the loop's native 30 ms ticks.
typeset -gi _ZLE_PICKER_DOCUMENT_SETTLE_TICKS=0
typeset -ga _ZLE_PICKER_DOCUMENT_LINES=() _ZLE_PICKER_DOCUMENT_ROLES=()
typeset -gA _ZLE_PICKER_DOCUMENT_SYNTAX=()
# The renderer publishes the source-row interval currently visible in the
# document reader. Providers may use this captured geometry to prepare bounded
# presentation metadata; they must never run from the renderer itself.
typeset -gi _ZLE_PICKER_DOCUMENT_VISIBLE_FIRST=0
typeset -gi _ZLE_PICKER_DOCUMENT_VISIBLE_LAST=0
typeset -ga _ZLE_PICKER_INSPECT_SYNTAX=() _ZLE_PICKER_DISPLAY_RIGHT_SYNTAX=()
typeset -gA _ZLE_PICKER_DOCUMENT_OFFSETS=()
# Source-row mapping lets a caller preserve meaning when document content changes.
typeset -gA _ZLE_PICKER_DOCUMENT_ROWS=()
typeset -ga _ZLE_PICKER_INSPECT_SOURCE_LINES=()
typeset -gi _ZLE_PICKER_DOCUMENT_TARGET_ROW=0
typeset -ga _ZLE_PICKER_DISPLAY_LEFT_ENDS=()
typeset -ga _ZLE_PICKER_DISPLAY_RIGHT_ROLES=()
typeset -ga _ZLE_PICKER_DISPLAY_CONTEXT_STARTS=()
typeset -ga _ZLE_PICKER_DISPLAY_MATCH_STARTS=()

# Native prompt truncation understands terminal cell widths. Literal percent
# signs are escaped; prompt substitution is disabled by emulate.
_zle_picker_fit() {
  emulate -L zsh
  local text=$1 marker='…'
  local -i width=$2
  if (( width <= 0 )); then
    REPLY=''
    return
  fi
  if (( ${(m)#text} > width )); then
    (( ${(m)#marker} > width )) && marker='.'
    REPLY="%${width}>${marker}>${text//\%/%%}%>>"
    text=${(%)REPLY}
    text=${text%$marker}
    # Native truncation can straddle a double-cell character at the boundary.
    while (( ${(m)#text} + ${(m)#marker} > width )); do
      text=${text[1,-2]}
    done
    text+=$marker
  fi
  REPLY=${(mr:$width:: :)text}
}

_zle_picker_document_bookmark() {
  if (( _ZLE_PICKER_DOCUMENT )) && [[ -n $_ZLE_PICKER_INSPECT_KEY && $_ZLE_PICKER_INSPECT_KEY == "$_ZLE_PICKER_DOCUMENT_KEY" ]]; then
    _ZLE_PICKER_DOCUMENT_OFFSETS[$_ZLE_PICKER_INSPECT_KEY]=$_ZLE_PICKER_INSPECT_OFFSET
    _ZLE_PICKER_DOCUMENT_ROWS[$_ZLE_PICKER_INSPECT_KEY]=${_ZLE_PICKER_INSPECT_SOURCE_LINES[_ZLE_PICKER_INSPECT_OFFSET+1]:-0}
  fi
  return 0
}

# Wrap only when the selected item or pane width changes, never on scroll.
# Information previews retain 256 visual lines; primary documents retain
# 20,000. No ANSI or prompt syntax is evaluated as input.
_zle_picker_inspect_prepare() {
  emulate -L zsh
  local name=$1 line='' part='' words='' role='' text=''
  local -i width=$2 first=1 max_lines=256 source_index=0 character_offset=0 document_pending=0
  local -a source_lines=() reply=() syntax=()
  (( _ZLE_PICKER_DOCUMENT )) && max_lines=20000
  if [[ $name == "$_ZLE_PICKER_INSPECT_KEY" ]] &&
     (( width == _ZLE_PICKER_INSPECT_WIDTH )); then
    return
  fi
  if [[ $name != "$_ZLE_PICKER_INSPECT_KEY" ]]; then
    if (( _ZLE_PICKER_DOCUMENT )); then
      _zle_picker_document_bookmark
      _ZLE_PICKER_INSPECT_OFFSET=${_ZLE_PICKER_DOCUMENT_OFFSETS[$name]:-0}
    else
      _ZLE_PICKER_INSPECT_OFFSET=0
    fi
  fi
  _ZLE_PICKER_INSPECT_KEY=$name
  _ZLE_PICKER_INSPECT_WIDTH=$width
  _ZLE_PICKER_INSPECT_LINES=()
  _ZLE_PICKER_INSPECT_ROLES=()
  _ZLE_PICKER_INSPECT_SOURCE_LINES=()
  _ZLE_PICKER_INSPECT_SYNTAX=()
  if [[ -z $name ]]; then
    text='No matching selection.'
  else
    text=${_ZLE_PICKER_INSPECT_TEXTS[$name]-'Details unavailable in this snapshot.'}
  fi
  source_lines=("${(@f)text}")
  if (( _ZLE_PICKER_DOCUMENT )); then
    if [[ -n $name && $name == "$_ZLE_PICKER_DOCUMENT_KEY" ]]; then
      if (( _ZLE_PICKER_DOCUMENT_PENDING )); then
        document_pending=1
        # Preserve one prepared row per source row while optional presentation
        # metadata is pending. Replacing the document with a single notice row
        # destroys the source-coordinate viewport that the asynchronous
        # provider needs to finish the request. The renderer therefore keeps
        # the geometry but never exposes an unhighlighted source intermediate.
        source_lines=("${_ZLE_PICKER_DOCUMENT_LINES[@]}")
      else
        source_lines=("${_ZLE_PICKER_DOCUMENT_LINES[@]}")
      fi
    elif [[ -n $name ]]; then
      source_lines=('Reading selected file…')
    fi
  fi
  for line in "${source_lines[@]}"; do
    (( ++source_index ))
    syntax=() character_offset=0
    if (( _ZLE_PICKER_DOCUMENT )) && [[ $name == "$_ZLE_PICKER_DOCUMENT_KEY" && -n ${_ZLE_PICKER_DOCUMENT_SYNTAX[$source_index]-} ]]; then
      _zle_picker_syntax_prepare "$line" "${_ZLE_PICKER_DOCUMENT_SYNTAX[$source_index]}"
      syntax=("${reply[@]}")
    fi
    if (( document_pending )); then
      # Keep wrapping and source-row maps stable without painting plain code.
      # One short notice at the first source row makes the state explicit;
      # remaining rows are intentionally blank placeholders.
      [[ $source_index == 1 ]] && line='Preparing highlighted preview…' || line=''
    fi
    (( _ZLE_PICKER_DOCUMENT )) && line=${line//$'\t'/    }
    line=${(V)line}
    role=text
    if (( _ZLE_PICKER_DOCUMENT )); then
      if (( document_pending )); then
        role=info
      elif [[ $name == "$_ZLE_PICKER_DOCUMENT_KEY" ]]; then
        role=${_ZLE_PICKER_DOCUMENT_ROLES[source_index]:-text}
      fi
    elif (( first == 1 )); then
      role=heading
    elif (( first == 2 )); then
      role=info
    elif [[ $line != ' '* && -n $line ]]; then
      role=heading
      case $line in
        (Safety*|Limits*|Unavailable:*|*recovery:) role=warning ;;
      esac
    fi
    (( ++first ))
    while (( ${(m)#line} > width )); do
      part="%${width}>.>${line//\%/%%}%>>"
      part=${(%)part}
      part=${part%.}
      [[ -n $part ]] || break
      words=${part% *}
      if (( !_ZLE_PICKER_DOCUMENT )) && [[ $words != "$part" && -n ${words// /} ]]; then
        part=$words
      fi
      _ZLE_PICKER_INSPECT_LINES+=("$part")
      _ZLE_PICKER_INSPECT_ROLES+=("$role")
      REPLY=''
      (( ${#syntax} )) && _zle_picker_syntax_slice $character_offset $(( character_offset + ${#part} )) "${syntax[@]}"
      _ZLE_PICKER_INSPECT_SYNTAX+=("$REPLY")
      (( character_offset += ${#part} ))
      (( _ZLE_PICKER_DOCUMENT )) && _ZLE_PICKER_INSPECT_SOURCE_LINES+=($source_index)
      line=${line[$(( ${#part} + 1 )),-1]}
      (( _ZLE_PICKER_DOCUMENT )) || line=${line# }
      (( ${#_ZLE_PICKER_INSPECT_LINES} >= max_lines - 1 )) && break
    done
    _ZLE_PICKER_INSPECT_LINES+=("$line")
    _ZLE_PICKER_INSPECT_ROLES+=("$role")
    REPLY=''
    (( ${#syntax} )) && _zle_picker_syntax_slice $character_offset $(( character_offset + ${#line} )) "${syntax[@]}"
    _ZLE_PICKER_INSPECT_SYNTAX+=("$REPLY")
    (( _ZLE_PICKER_DOCUMENT )) && _ZLE_PICKER_INSPECT_SOURCE_LINES+=($source_index)
    if (( ${#_ZLE_PICKER_INSPECT_LINES} >= max_lines )); then
      _ZLE_PICKER_INSPECT_LINES[max_lines]='[Preview truncated.]'
      (( _ZLE_PICKER_DOCUMENT )) && _ZLE_PICKER_INSPECT_LINES[max_lines]='Limits: 20,000 wrapped lines; use Git for the remaining text.'
      _ZLE_PICKER_INSPECT_ROLES[max_lines]=warning
      _ZLE_PICKER_INSPECT_SYNTAX[max_lines]=''
      break
    fi
  done
  if (( _ZLE_PICKER_DOCUMENT && _ZLE_PICKER_DOCUMENT_TARGET_ROW > 0 )) &&
     [[ $name == "$_ZLE_PICKER_DOCUMENT_KEY" ]]; then
    _ZLE_PICKER_INSPECT_OFFSET=$(( ${_ZLE_PICKER_INSPECT_SOURCE_LINES[(i)$_ZLE_PICKER_DOCUMENT_TARGET_ROW]} - 1 ))
    _ZLE_PICKER_DOCUMENT_TARGET_ROW=0
  fi
  return 0
}

# Convert raw character offsets through the same tab/control sanitization as
# document text, then clip to each wrapped row. Token metadata never contains
# styles or escape codes. Both operations are pure and run only during wrapping.
_zle_picker_syntax_prepare() {
  emulate -L zsh
  local raw=$1 span='' prefix='' role=''
  local -a fields=()
  local -i start=0 end=0
  reply=()
  for span in ${=2}; do
    fields=("${(@s.:.)span}")
    start=$fields[1] end=$fields[2] role=$fields[3]
    prefix=''
    (( start )) && prefix=${raw[1,start]}
    prefix=${prefix//$'\t'/    }
    prefix=${(V)prefix} start=${#prefix}
    prefix=${raw[1,end]}
    prefix=${prefix//$'\t'/    }
    prefix=${(V)prefix} end=${#prefix}
    reply+=("$start:$end:$role")
  done
}

_zle_picker_syntax_slice() {
  emulate -L zsh
  local -i first=$1 last=$2 start=0 end=0
  shift 2
  local span=''
  local -a fields=()
  REPLY=''
  for span in "$@"; do
    fields=("${(@s.:.)span}")
    start=$fields[1] end=$fields[2]
    (( end > first && start < last )) || continue
    (( start < first )) && start=$first
    (( end > last )) && end=$last
    REPLY+="$(( start - first )):$(( end - first )):$fields[3] "
  done
}

# Review tokens are deliberately lighter than command-line comments: they
# must stay legible on both diff backgrounds. All roles remain customizable
# through the shared palette; standalone editor sourcing has safe defaults.
_zle_picker_review_style() {
  local role=$1 fallback='fg=252'
  case $role in
    (added) fallback='fg=252,bg=22' ;;
    (removed) fallback='fg=252,bg=52' ;;
    (keyword) fallback='fg=222,bold' ;;
    (string) fallback='fg=186' ;;
    (number) fallback='fg=216' ;;
    (comment) fallback='fg=250' ;;
    (type|variable) fallback='fg=153' ;;
    (function) fallback='fg=117' ;;
  esac
  REPLY=${ZSH_HIGHLIGHT_STYLES[review-$role]:-$fallback}
}

# Compose the existing result rows with an optional help pane. The same ZLE
# display owns both panes, including cleanup, colors, and resize behavior.
_zle_picker_inspect_render() {
  emulate -L zsh
  local -i selected=$1 width=$2 left_width=$3
  local name=${_ZLE_PICKER_RESULTS[selected]:-$_ZLE_PICKER_INSPECT_FALLBACK} left='' right='' title='' role=''
  local -i rows=${#_ZLE_PICKER_DISPLAY} height=6 index=0 line_index=0 right_width=$width
  local -a display=() styles=() indexes=() highlights=() left_ends=() right_roles=() context_starts=() match_starts=() right_syntax=()
  _zle_picker_body_height
  local -i body_height=$REPLY
  (( left_width )) && right_width=$(( width - left_width - 3 ))
  _zle_picker_inspect_prepare "$name" $right_width
  # Passive details stay compact beside short lists. Deliberate focus grants
  # more reading room; terminal height still bounds the shared display.
  (( _ZLE_PICKER_INSPECT_FOCUS )) && height=12
  if (( ${_ZLE_PICKER_SCREEN_ACTIVE:-0} && LINES >= 8 )) &&
     { (( _ZLE_PICKER_INSPECT_FOCUS || _ZLE_PICKER_DOCUMENT )) || [[ -n $name && $name == "$_ZLE_PICKER_INSPECT_EXPAND_KEY" ]]; }; then
    height=$body_height
  else
    (( LINES > 0 && height > LINES / 2 )) && height=$(( LINES / 2 ))
  fi
  (( ${#_ZLE_PICKER_INSPECT_LINES} + 1 < height )) && height=$(( ${#_ZLE_PICKER_INSPECT_LINES} + 1 ))
  (( rows - 1 > height )) && height=$(( rows - 1 ))
  (( LINES > 0 && height > body_height )) && height=$body_height
  (( height < 2 )) && height=2
  _ZLE_PICKER_INSPECT_PAGE=$(( height - 1 ))
  local -i max_offset=$(( ${#_ZLE_PICKER_INSPECT_LINES} - _ZLE_PICKER_INSPECT_PAGE ))
  (( max_offset < 0 )) && max_offset=0
  (( _ZLE_PICKER_INSPECT_OFFSET > max_offset )) && _ZLE_PICKER_INSPECT_OFFSET=$max_offset
  (( _ZLE_PICKER_INSPECT_OFFSET < 0 )) && _ZLE_PICKER_INSPECT_OFFSET=0
  _ZLE_PICKER_DOCUMENT_VISIBLE_FIRST=0
  _ZLE_PICKER_DOCUMENT_VISIBLE_LAST=0
  if (( _ZLE_PICKER_DOCUMENT )) && [[ -n $name && $name == "$_ZLE_PICKER_DOCUMENT_KEY" ]]; then
    _ZLE_PICKER_DOCUMENT_VISIBLE_FIRST=${_ZLE_PICKER_INSPECT_SOURCE_LINES[_ZLE_PICKER_INSPECT_OFFSET+1]:-0}
    # The shared pane may be taller than a short document because the file list
    # establishes the workspace height. Clamp the source-map lookup to the last
    # prepared row; indexing the unused pane space would publish zero geometry
    # and prevent the syntax provider from ever receiving this document.
    local -i document_last_display=$((_ZLE_PICKER_INSPECT_OFFSET + _ZLE_PICKER_INSPECT_PAGE))
    (( document_last_display > ${#_ZLE_PICKER_INSPECT_SOURCE_LINES} )) &&
      document_last_display=${#_ZLE_PICKER_INSPECT_SOURCE_LINES}
    _ZLE_PICKER_DOCUMENT_VISIBLE_LAST=${_ZLE_PICKER_INSPECT_SOURCE_LINES[document_last_display]:-0}
  fi
  (( left_width || _ZLE_PICKER_INSPECT_FOCUS )) || return
  title=${(V)_ZLE_PICKER_INSPECT_TITLE}
  if (( _ZLE_PICKER_DOCUMENT )) && [[ -n $name ]]; then
    title=${(V)_ZLE_PICKER_LABELS[selected]}
    [[ $name == "$_ZLE_PICKER_DOCUMENT_KEY" && -n $_ZLE_PICKER_DOCUMENT_TITLE ]] && title=${(V)_ZLE_PICKER_DOCUMENT_TITLE}
  fi
  (( _ZLE_PICKER_INSPECT_FOCUS )) && title="▸ $title"
  # The body already identifies the selection. A counter is useful only when
  # there is more content to scroll, so short details stay quiet.
  if (( max_offset )); then
    title+=" · $(( _ZLE_PICKER_INSPECT_OFFSET + 1 ))/${#_ZLE_PICKER_INSPECT_LINES}"
  fi
  for (( index=1; index<=height; ++index )); do
    if (( index == 1 )); then
      right=$title
      role=heading
    else
      line_index=$(( index - 1 + _ZLE_PICKER_INSPECT_OFFSET ))
      right=${_ZLE_PICKER_INSPECT_LINES[line_index]-}
      role=${_ZLE_PICKER_INSPECT_ROLES[line_index]:-text}
    fi
    if (( !_ZLE_PICKER_INSPECT_FOCUS )) && [[ $role == heading ]]; then
      role=info
      (( index == 1 )) && role=muted
    fi
    _zle_picker_fit "$right" $right_width
    right=$REPLY
    if (( left_width )); then
      left=''
      (( index < rows )) && left=${_ZLE_PICKER_DISPLAY[index]}
      _zle_picker_fit "$left" $left_width
      left=$REPLY
      if (( _ZLE_PICKER_INSPECT_FOCUS )); then
        display+=("${left} ┃ ${right}")
      else
        display+=("${left} │ ${right}")
      fi
      left_ends+=(${#left})
      if (( _ZLE_PICKER_INSPECT_FOCUS )) &&
         [[ ${_ZLE_PICKER_DISPLAY_STYLES[index]:-picker-text} == picker-selected ]]; then
        styles+=(picker-selected-inactive)
      else
        styles+=("${_ZLE_PICKER_DISPLAY_STYLES[index]:-picker-text}")
      fi
      indexes+=("${_ZLE_PICKER_DISPLAY_INDEX_ENDS[index]:-0}")
      _zle_picker_highlights_shift "${_ZLE_PICKER_DISPLAY_HIGHLIGHTS[index]-}" 0 ${#left}
      highlights+=("$REPLY")
      context_starts+=("${_ZLE_PICKER_DISPLAY_CONTEXT_STARTS[index]:-0}")
      match_starts+=("${_ZLE_PICKER_DISPLAY_MATCH_STARTS[index]:--1}")
    else
      display+=("$right")
      left_ends+=(0)
      styles+=(picker-text)
      indexes+=(0)
      highlights+=('')
      context_starts+=(0)
      match_starts+=(-1)
      _ZLE_PICKER_INDEXES_VISIBLE=0
    fi
    right_roles+=("$role")
    if (( _ZLE_PICKER_DOCUMENT && index > 1 )); then
      right_syntax+=("${_ZLE_PICKER_INSPECT_SYNTAX[line_index]-}")
    else
      right_syntax+=('')
    fi
  done
  display+=("${_ZLE_PICKER_DISPLAY[-1]}")
  styles+=(picker-muted)
  indexes+=(0)
  highlights+=('')
  left_ends+=(-1)
  right_roles+=('')
  right_syntax+=('')
  context_starts+=(0)
  match_starts+=(-1)
  _ZLE_PICKER_DISPLAY=("${display[@]}")
  _ZLE_PICKER_DISPLAY_STYLES=("${styles[@]}")
  _ZLE_PICKER_DISPLAY_INDEX_ENDS=("${indexes[@]}")
  _ZLE_PICKER_DISPLAY_HIGHLIGHTS=("${highlights[@]}")
  _ZLE_PICKER_DISPLAY_LEFT_ENDS=("${left_ends[@]}")
  _ZLE_PICKER_DISPLAY_RIGHT_ROLES=("${right_roles[@]}")
  _ZLE_PICKER_DISPLAY_RIGHT_SYNTAX=("${right_syntax[@]}")
  _ZLE_PICKER_DISPLAY_CONTEXT_STARTS=("${context_starts[@]}")
  _ZLE_PICKER_DISPLAY_MATCH_STARTS=("${match_starts[@]}")
}

# Native fuzzy history search. The public result limit may be established by
# the local initializer; the widget also caps it to the terminal height.
typeset -g ZSH_HISTORY_SEARCH_MAX_RESULTS=${ZSH_HISTORY_SEARCH_MAX_RESULTS:-8}
typeset -ga _HISTORY_SEARCH_RESULTS=()
typeset -g ZSH_DIRECTORY_PICKER_MAX_RESULTS=${ZSH_DIRECTORY_PICKER_MAX_RESULTS:-10}
typeset -ga _DIRECTORY_PICKER_VALUES=()
# Counts are directories/files/other entries in the captured visibility scope.
# Keep only eight non-directory names for the informational empty-list view.
typeset -ga _DIRECTORY_PICKER_CONTENT_COUNTS=(0 0 0)
typeset -ga _DIRECTORY_PICKER_FILE_SAMPLE=()
typeset -gi _DIRECTORY_PICKER_SHOW_HIDDEN=-1
typeset -ga _DIRECTORY_PICKER_QUERIES=()
typeset -ga _DIRECTORY_PICKER_SELECTIONS=()
typeset -ga _DIRECTORY_PICKER_OFFSETS=()
typeset -ga _DIRECTORY_PICKER_RESUME=('' 1 0)
typeset -ga _DIRECTORY_PICKER_LABELS=()
typeset -ga _DIRECTORY_PICKER_STACK=()
typeset -g _DIRECTORY_PICKER_PATH_QUERY=''
typeset -g _DIRECTORY_PICKER_LOCATION=''
typeset -g _DIRECTORY_PICKER_INPUT=''
zmodload -F zsh/parameter p:history

_zle_picker_escape_pattern() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local MATCH
  REPLY=${1//(#m)[\][|()\\*?#<>~^]/\\$MATCH}
}

# Keep picker layout independent from the prompt add-on. Both features use the
# same small width rule, but neither should require the other to be loaded.
_zle_picker_abbreviate() {
  emulate -L zsh
  local text=$1 head='' tail=''
  local -i max_width=$2 left_width=0 right_width=0

  if (( max_width <= 0 )); then
    REPLY=''
    return
  fi
  if (( ${(m)#text} <= max_width )); then
    REPLY=$text
    return
  fi
  if (( max_width < 5 )); then
    REPLY='…'
    return
  fi

  left_width=$(( (max_width - 1) / 3 ))
  right_width=$(( max_width - 1 - left_width ))
  text=${text//\%/%%}
  head="%$(( left_width + 1 ))>.>${text}%>>"
  tail="%$(( right_width + 1 ))<.<${text}%<<"
  head=${(%)head}
  tail=${(%)tail}
  head=${head%.}
  tail=${tail#.}
  while (( ${(m)#head} > left_width )); do head=${head[1,-2]}; done
  while (( ${(m)#tail} > right_width )); do tail=${tail[2,-1]}; done
  REPLY="${head}…${tail}"
}

# Resolve picker colors when drawing rather than copying legacy overrides at
# bootstrap time. This preserves initializer-defined legacy roles without
# creating a peer add-on ordering dependency.
_zle_picker_style() {
  local role=$1 fallback=$2 legacy="history-search-${1#picker-}"

  if (( ${+ZSH_HIGHLIGHT_STYLES[$legacy]} )); then
    REPLY=${ZSH_HIGHLIGHT_STYLES[$legacy]}
  else
    REPLY=${ZSH_HIGHLIGHT_STYLES[$role]:-$fallback}
  fi
}

# Consume the optional output peer's validator when available, while retaining
# an independently useful adaptive palette when only appearance and editor are
# enabled. Treat malformed public overrides as absent in either path.
_zle_picker_output_color() {
  emulate -L zsh

  local role=$1 fallback=$2 value='' fallback_key="output:$1"
  if [[ ${(t)_COMPOZSH_COLOR_FALLBACKS} == association* ]] &&
     (( ${+_COMPOZSH_COLOR_FALLBACKS[$fallback_key]} )); then
    fallback=${_COMPOZSH_COLOR_FALLBACKS[$fallback_key]}
  fi
  if (( ${+functions[_output_color]} )); then
    _output_color "$role" "$fallback"
    return
  fi
  if [[ ${(t)ZSH_OUTPUT_COLORS} == association* ]] &&
     (( ${+ZSH_OUTPUT_COLORS[$role]} )); then
    value=${ZSH_OUTPUT_COLORS[$role]}
  fi
  [[ $value == <0-255> ]] && REPLY=$value || REPLY=$fallback
}

# Zero-based character ranges within visible text, never executable patterns.
# Emphasis is bounded independently of searching; long queries still match in
# the collectors. The caller declares reply locally to retain these ranges.
_zle_picker_match_spans() {
  emulate -L zsh
  local text=${1:l} query=${2:l} fragment='' before='' remaining='' character=''
  local IFS=$' \t\n'
  local -a fragments=( ${=query} ) spans=()
  local -i position=0 next=0 start=-1 last=-1
  reply=()
  (( ${#query} && ${#query} <= 256 && ${#fragments} <= 16 )) || return 0
  for fragment in "${fragments[@]}"; do
    if [[ $text == *"$fragment"* ]]; then
      before=${text%%"$fragment"*}
      reply+=("${#before} $(( ${#before} + ${#fragment} ))")
      continue
    fi
    spans=() next=1 start=-1 last=-1 position=0 remaining=$text
    # Native prefix matching skips gaps without a shell iteration per column.
    for character in "${(s::)fragment}"; do
      [[ $remaining == *"$character"* ]] || break
      before=${remaining%%"$character"*}
      (( position += ${#before} + 1 ))
      remaining=${remaining#*"$character"}
      if (( start >= 0 && position != last + 1 )); then
        spans+=("$start $last")
        start=-1
      fi
      (( start < 0 )) && start=$(( position - 1 ))
      last=$position
      (( ++next > ${#fragment} )) && break
    done
    if (( next > ${#fragment} )); then
      spans+=("$start $last")
      reply+=("${spans[@]}")
    fi
  done
}

# Shift and clip validated label-highlight spans without interpreting their
# contents as patterns or styles. The renderer owns role resolution.
_zle_picker_highlights_shift() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local specifications=$1 token='' role=''
  local -i shift=${2:-0} limit=${3:-0} start=0 end=0
  local -a fields=()
  REPLY=''
  (( limit > 0 )) || return 0
  for token in ${=specifications}; do
    fields=( "${(@s.:.)token}" )
    (( ${#fields} == 3 )) || continue
    [[ ${fields[1]} == <-> && ${fields[2]} == <-> ]] || continue
    role=${fields[3]}
    [[ $role == picker-[A-Za-z0-9_-]## ]] || continue
    start=${fields[1]} end=${fields[2]}
    (( start >= 0 && end > start && start < limit )) || continue
    (( end > limit )) && end=$limit
    REPLY+="$(( start + shift )):$(( end + shift )):$role "
  done
  REPLY=${REPLY% }
}

# Semantic label colors keep the selected-row background and replace only its
# foreground. This makes metadata distinct without weakening selection focus.
_zle_picker_label_highlight_style() {
  emulate -L zsh
  local role=$1 selected=${2:-0} row_style=${3:-} fallback='fg=111'
  local selected_role="${role}-selected"
  local -a row_attributes=() role_attributes=()
  case $role in
    (picker-architecture) fallback='fg=117,bold' ;;
    (picker-size) fallback='fg=221' ;;
    (picker-error) fallback='fg=203,bold' ;;
    (picker-success) fallback='fg=71,bold' ;;
  esac
  if (( selected )); then
    case $role in
      (picker-architecture) fallback='fg=231,bold' ;;
      (picker-size) fallback='fg=229,bold' ;;
      (picker-error) fallback='fg=224,bold' ;;
      (picker-success) fallback='fg=120,bold' ;;
    esac
    _zle_picker_style "$selected_role" "$fallback"
    role_attributes=( "${(@s:,:)REPLY}" )
    role_attributes=( "${(@)role_attributes:#bg=*}" )
    row_attributes=( "${(@s:,:)row_style}" )
    row_attributes=( "${(@)row_attributes:#fg=*}" )
    REPLY="${(j:,:)row_attributes}${row_attributes:+,}${(j:,:)role_attributes}"
  else
    _zle_picker_style "$role" "$fallback"
  fi
}

# One shared height budget keeps collection, layout, and footer anchoring in
# agreement when a caller provides a location row. Tiny windows omit that row.
_zle_picker_body_height() {
  REPLY=$(( LINES - 6 - (${#_ZLE_PICKER_SUBTITLE} > 0 && LINES >= 10) ))
  (( REPLY < 1 )) && REPLY=1
  return 0
}

# Stable chrome belongs to the owned screen only. Empty rows are represented
# by newlines, keeping padding cheap and leaving ZLE in charge of painting.
_zle_picker_workspace() {
  emulate -L zsh
  (( ${_ZLE_PICKER_SCREEN_ACTIVE:-0} && LINES >= 8 )) || return 0
  _zle_picker_body_height
  local -i gap=$(( REPLY - (${#_ZLE_PICKER_DISPLAY} - 1) )) width=$(( COLUMNS - 1 ))
  local separator=''
  local -a padding=()
  # Inline rows need no pane metadata. Supply it before inserting spacer rows
  # so every parallel array continues to describe the same physical row.
  if (( !${#_ZLE_PICKER_DISPLAY_LEFT_ENDS} )); then
    _ZLE_PICKER_DISPLAY_LEFT_ENDS=("${_ZLE_PICKER_DISPLAY[@]/*/-1}")
    _ZLE_PICKER_DISPLAY_RIGHT_ROLES=("${_ZLE_PICKER_DISPLAY[@]/*/}")
  fi
  if (( !${#_ZLE_PICKER_DISPLAY_RIGHT_SYNTAX} )); then
    _ZLE_PICKER_DISPLAY_RIGHT_SYNTAX=("${_ZLE_PICKER_DISPLAY[@]/*/}")
  fi
  (( gap < 0 )) && gap=0
  (( width < 1 )) && width=1
  separator=${(l:$width::─:)separator}
  repeat $gap; do padding+=(''); done
  _ZLE_PICKER_DISPLAY=("$separator" "${_ZLE_PICKER_DISPLAY[@][1,-2]}" "${padding[@]}" "${_ZLE_PICKER_DISPLAY[-1]}")
  _ZLE_PICKER_DISPLAY_STYLES=(picker-muted "${_ZLE_PICKER_DISPLAY_STYLES[@][1,-2]}" "${padding[@]}" picker-muted)
  _ZLE_PICKER_DISPLAY_INDEX_ENDS=(0 "${_ZLE_PICKER_DISPLAY_INDEX_ENDS[@][1,-2]}" "${padding[@]}" 0)
  _ZLE_PICKER_DISPLAY_HIGHLIGHTS=('' "${_ZLE_PICKER_DISPLAY_HIGHLIGHTS[@][1,-2]}" "${padding[@]}" '')
  _ZLE_PICKER_DISPLAY_LEFT_ENDS=(-1 "${_ZLE_PICKER_DISPLAY_LEFT_ENDS[@][1,-2]}" "${padding[@]}" -1)
  _ZLE_PICKER_DISPLAY_RIGHT_ROLES=('' "${_ZLE_PICKER_DISPLAY_RIGHT_ROLES[@][1,-2]}" "${padding[@]}" '')
  _ZLE_PICKER_DISPLAY_RIGHT_SYNTAX=('' "${_ZLE_PICKER_DISPLAY_RIGHT_SYNTAX[@][1,-2]}" "${padding[@]}" '')
  _ZLE_PICKER_DISPLAY_CONTEXT_STARTS=(0 "${_ZLE_PICKER_DISPLAY_CONTEXT_STARTS[@][1,-2]}" "${padding[@]}" 0)
  _ZLE_PICKER_DISPLAY_MATCH_STARTS=(-1 "${_ZLE_PICKER_DISPLAY_MATCH_STARTS[@][1,-2]}" "${padding[@]}" -1)
}

# A quiet captured location trail precedes the existing list/details layout.
# It disappears first on narrow screens; all action indexes still address the
# central list. This composes rows, never starts another terminal renderer.
_zle_picker_trail_render() {
  emulate -L zsh
  local -i width=$1 index=0 prefix_end=0 first=1 trail_index=0 row_visible_width=0
  local left='' row=''
  _ZLE_PICKER_DISPLAY_PREFIX_ENDS=("${_ZLE_PICKER_DISPLAY[@]/*/0}")
  (( width )) || return 0
  # Retain the nearest ancestors if the trail is taller than the body.
  first=$(( ${#_ZLE_PICKER_TRAIL} - (${#_ZLE_PICKER_DISPLAY} - 3) ))
  (( first < 2 )) && first=2
  for (( index=2; index<${#_ZLE_PICKER_DISPLAY}; ++index )); do
    trail_index=$(( first + index - 3 ))
    left=${_ZLE_PICKER_TRAIL[trail_index]-}
    (( index == 2 )) && left=${_ZLE_PICKER_TRAIL[1]}
    row=${_ZLE_PICKER_DISPLAY[index]}
    [[ -n $left || -n $row ]] || continue
    _zle_picker_fit "${(V)left}" $width
    left="$REPLY │ " prefix_end=${#left}
    _zle_picker_fit "$row" $(( COLUMNS - width - 4 ))
    row_visible_width=${#REPLY}
    _ZLE_PICKER_DISPLAY[index]="$left$REPLY"
    _zle_picker_highlights_shift "${_ZLE_PICKER_DISPLAY_HIGHLIGHTS[index]-}" $prefix_end $row_visible_width
    _ZLE_PICKER_DISPLAY_HIGHLIGHTS[index]=$REPLY
    _ZLE_PICKER_DISPLAY_PREFIX_ENDS[index]=$prefix_end
    (( _ZLE_PICKER_DISPLAY_LEFT_ENDS[index] >= 0 )) && (( _ZLE_PICKER_DISPLAY_LEFT_ENDS[index] += prefix_end ))
    (( _ZLE_PICKER_DISPLAY_INDEX_ENDS[index] )) && (( _ZLE_PICKER_DISPLAY_INDEX_ENDS[index] += prefix_end ))
    (( _ZLE_PICKER_DISPLAY_CONTEXT_STARTS[index] )) && (( _ZLE_PICKER_DISPLAY_CONTEXT_STARTS[index] += prefix_end ))
    (( _ZLE_PICKER_DISPLAY_MATCH_STARTS[index] >= 0 )) && (( _ZLE_PICKER_DISPLAY_MATCH_STARTS[index] += prefix_end ))
  done
  return 0
}

# Append newest-first matches for one native Zsh pattern, optionally requiring
# additional patterns. The first pattern should be the most selective one so a
# fragment search does not scan the complete history in shell code.
_history_search_append_matches() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local seed_pattern=$1 raw_limit=$2
  shift 2
  local event='' entry='' required_pattern=''
  local -i limit=$raw_limit matched=0
  local -a required_patterns=("$@")
  local -a events=( ${(kOn)_history_search_source[(R)${~seed_pattern}]} )

  for event in "${events[@]}"; do
    entry=${_history_search_source[$event]}
    [[ -n $entry ]] || continue
    matched=1
    for required_pattern in "${required_patterns[@]}"; do
      [[ $required_pattern == "$seed_pattern" ]] && continue
      if [[ $entry != ${~required_pattern} ]]; then
        matched=0
        break
      fi
    done
    (( matched )) || continue
    [[ -n ${_history_search_seen[$entry]-} ]] && continue
    _history_search_seen[$entry]=1
    _HISTORY_SEARCH_RESULTS[$(( ++_history_search_count ))]=$entry
    (( _history_search_count >= limit )) && return 0
  done
}

# Rank full literal matches first. Multi-fragment queries then require every
# whitespace-separated fragment but allow them to appear in any order. If no
# literal-fragment result exists, each fragment falls back to ordered-character
# fuzzy matching. Every tier remains newest-first.
_history_search_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local query=$1 raw_limit=$2 literal='' pattern='' fragment=''
  local character='' seed_pattern='' longest_fragment=''
  local -i limit=8 index=0 seed_index=1 previous_count=0
  local -a fragments=() literal_patterns=() fuzzy_patterns=()
  local -A _history_search_seen=()
  local -i _history_search_count=0
  if (( ! ${+_history_search_source} )); then
    local -A _history_search_source=( "${(@kv)history}" )
  fi
  typeset -ga _HISTORY_SEARCH_RESULTS=()

  [[ $raw_limit == <-> ]] && limit=$raw_limit
  (( limit < 1 )) && limit=1

  if [[ -z $query ]]; then
    _history_search_append_matches '*' $limit
    return 0
  fi

  _zle_picker_escape_pattern "$query"
  literal=$REPLY
  _history_search_append_matches "(#i)${literal}*" $limit
  (( ${#_HISTORY_SEARCH_RESULTS} >= limit )) && return 0
  # Exclude stronger tiers natively instead of walking the same large result
  # set repeatedly in shell code when the user reaches the end of history.
  _history_search_append_matches "(#i)(*${literal}*~${literal}*)" $limit
  (( ${#_HISTORY_SEARCH_RESULTS} >= limit )) && return 0

  fragments=( ${=query} )
  (( ${#fragments} )) || return 0

  if (( ${#fragments} == 1 )); then
    pattern='(#i)*'
    for character in "${(s::)fragments[1]}"; do
      _zle_picker_escape_pattern "$character"
      pattern+="${REPLY}*"
    done
    _history_search_append_matches "(#i)(${pattern#\(#i\)}~*${literal}*)" $limit
    return 0
  fi

  for fragment in "${fragments[@]}"; do
    _zle_picker_escape_pattern "$fragment"
    literal_patterns+=("(#i)*${REPLY}*")
    if (( ${#fragment} > ${#longest_fragment} )); then
      longest_fragment=$fragment
      seed_index=${#literal_patterns}
      seed_pattern=${literal_patterns[-1]}
    fi
  done

  previous_count=${#_HISTORY_SEARCH_RESULTS}
  _history_search_append_matches "(#i)(${seed_pattern#\(#i\)}~*${literal}*)" $limit "${literal_patterns[@]}"
  (( ${#_HISTORY_SEARCH_RESULTS} >= limit )) && return 0
  # Exact fragments are more useful than broader fuzzy approximations. Only
  # fall back when the unordered literal tier contributed nothing new.
  (( ${#_HISTORY_SEARCH_RESULTS} > previous_count )) && return 0

  for fragment in "${fragments[@]}"; do
    pattern='(#i)*'
    index=0
    for character in "${(s::)fragment}"; do
      _zle_picker_escape_pattern "$character"
      (( index++ )) && pattern+='[^[:space:]]#'
      pattern+=$REPLY
    done
    pattern+='*'
    fuzzy_patterns+=("$pattern")
  done
  _history_search_append_matches "(#i)(${fuzzy_patterns[seed_index]#\(#i\)}~*${literal}*)" $limit \
    "${fuzzy_patterns[@]}"
}

# Dedicated identity for the owned screen. Use the existing first blank row;
# status, location, search and result capacity keep their established positions.
# Optional metadata never displaces the tool name or makes provider calls.
_zle_picker_titlebar() {
  emulate -L zsh
  local -i width=$1 title_width=0
  local title=${(V)${_ZLE_PICKER_TITLE:-Picker}} meta='' focus=Results
  local value=${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-} action=''
  _ZLE_PICKER_TITLEBAR_META_START=-1
  (( _ZLE_PICKER_INSPECT_FOCUS )) && focus=${(V)_ZLE_PICKER_INSPECT_TITLE}
  if (( ${_ZLE_PICKER_BUSY:-0} )); then
    (( _ZLE_PICKER_STATUS_VIEW )) && meta='In progress' ||
      meta=${_ZLE_PICKER_BUSY_LABEL:-Searching…}
  elif (( _ZLE_PICKER_GUIDE_ACTIVE )); then
    meta='Keyboard guide'
  elif [[ -n $value ]]; then
    action=${_ZLE_PICKER_ACCEPT_LABELS[$value]:-$_ZLE_PICKER_INSPECT_ACTION}
    meta="Enter: ${(V)action} · $focus"
  elif (( _ZLE_PICKER_INSPECT_FOCUS )); then
    meta=$focus
  else
    meta='No selection'
  fi
  (( ${(m)#title} + 11 <= width )) && title="Compozsh / $title"
  if (( ${(m)#title} + ${(m)#meta} + 2 <= width )); then
    title_width=$(( width - ${(m)#meta} ))
    title=${(mr:$title_width:: :)title}
    _ZLE_PICKER_TITLEBAR_META_START=${#title}
    _ZLE_PICKER_TITLEBAR="$title$meta"
  else
    _zle_picker_fit "$title" $width
    _ZLE_PICKER_TITLEBAR=$REPLY
  fi
}

# Shared by key dispatch and hints. Empty mode means a single reading level;
# empty reply means the current boundary has no further disclosure.
_zle_picker_document_direction() {
  REPLY=''
  case "$1:$2:$3" in
    (right:0:full|left:1:full) REPLY=focused ;;
    (right:0:*) REPLY=read ;;
    (right:1:focused) REPLY=full ;;
    (left:1:*) REPLY=files ;;
  esac
  return 0
}

# Shared chrome is built from capabilities, never caller-written key strings.
# Keep the action, escape route and keyboard guide before optional hints. Add
# only whole hints so a narrow screen cannot conceal half a key sequence.
_zle_picker_footer() {
  emulate -L zsh
  local -i width=$1
  local query=$2 value=${_ZLE_PICKER_RESULTS[_ZLE_PICKER_SELECTED]-}
  local action=${_ZLE_PICKER_ACCEPT_LABELS[$value]:-$_ZLE_PICKER_INSPECT_ACTION}
  local cancel=${_ZLE_PICKER_CANCEL_LABEL:-cancel} hint='' options_label=options direction='' arrow=''
  local -a hints=()
  if (( ${_ZLE_PICKER_BUSY:-0} )); then
    _zle_picker_fit "${_ZLE_PICKER_BUSY_LABEL:-Waiting for the search source…}" $width
    return 0
  fi
  action=${(V)action} cancel=${(V)cancel}
  if (( _ZLE_PICKER_GUIDE_ACTIVE )); then
    REPLY='Esc back'
    hints=('↑↓ scroll' 'Fn/⌥ ↑↓ page' '^K keys')
  else
    REPLY="⏎ ${action} · Esc ${cancel}"
    (( ${(m)#REPLY} > width )) && REPLY='⏎ apply · Esc'
    hints=('^K keys')
    (( (_ZLE_PICKER_DOCUMENT && _ZLE_PICKER_DOCUMENT_REFRESH) ||
       _ZLE_PICKER_REFRESH_ENABLED )) && hints+=('^R refresh')
    # Put the available disclosure steps ahead of convenience shortcuts.
    if (( _ZLE_PICKER_DOCUMENT )) && [[ -n $value ]]; then
      local footer=$REPLY
      for direction in right left; do
        [[ $direction == right ]] && arrow=→ || arrow=←
        _zle_picker_document_direction "$direction" "$_ZLE_PICKER_INSPECT_FOCUS" "$_ZLE_PICKER_DOCUMENT_MODE"
        case $REPLY in
          (read|files) hints+=("$arrow $REPLY") ;;
          (focused) hints+=("$arrow focused diff") ;;
          (full) hints+=("$arrow full file") ;;
        esac
      done
      REPLY=$footer
    elif (( !_ZLE_PICKER_DOCUMENT &&
            (_ZLE_PICKER_DIRECTORY_ACTIONS == 1 || ${_ZLE_PICKER_WORKSPACE_ACTIONS:-0}) )); then
      [[ ${_ZLE_PICKER_OPTIONS_KIND:-} == git ]] && options_label=review
      hints+=("^X $options_label")
    fi
    [[ -n ${_ZLE_PICKER_SEARCH_ACTION:-} ]] && hints+=('^F search')
    if (( _ZLE_PICKER_DIRECTORY_ACTIONS == 1 )); then
      hints+=('^O preview')
    elif (( _ZLE_PICKER_DIRECTORY_ACTIONS == 2 )); then
      hints+=('^O browse')
    fi
    (( _ZLE_PICKER_COPY_ENABLED )) && hints+=('^Y copy')
    if (( _ZLE_PICKER_INSPECT_FOCUS )); then
      hints+=('↑↓ scroll')
      (( _ZLE_PICKER_HIERARCHY_ENABLED )) && hints+=('^B list') || hints+=('Tab list')
    else
      hints+=('↑↓ move')
    fi
    if (( _ZLE_PICKER_HIERARCHY_ENABLED )); then
      hints+=('→ open / ← back' '^T hidden')
      (( ${#_ZLE_PICKER_INSPECT_TEXTS} && !_ZLE_PICKER_INSPECT_FOCUS )) && hints+=('^E details')
    elif (( ${#_ZLE_PICKER_INSPECT_TEXTS} && !_ZLE_PICKER_INSPECT_FOCUS )); then
      hints+=('Tab details')
    fi
    if (( _ZLE_PICKER_DIGIT_SELECT && _ZLE_PICKER_INDEXES_VISIBLE && !_ZLE_PICKER_INSPECT_FOCUS )) && [[ -z $query ]]; then
      hints+=("0–9 ${action}")
    fi
    hints+=('Fn/⌥ ↑↓ page')
    if (( !_ZLE_PICKER_INSPECT_FOCUS )); then
      (( ${_ZLE_PICKER_QUERY_SUBMIT:-0} )) && hints+=('type query') || hints+=('type filter')
      hints+=('^U clear')
    fi
  fi
  for hint in "${hints[@]}"; do
    (( ${(m)#REPLY} + ${(m)#hint} + 3 <= width )) && REPLY+=" · ${hint}"
  done
  if (( ${(m)#REPLY} > width )); then
    REPLY='⏎ · Esc'
    (( ${(m)#REPLY} > width )) && REPLY=${REPLY[1,$width]}
  fi
  return 0
}

# The keyboard guide is another view of this session, not a nested picker.
# Selection, filter, focus and viewport are untouched; no provider is called.
_zle_picker_guide_render() {
  emulate -L zsh
  local -i width=$1 height=0 max_offset=0 index=0
  local row='' role=''
  local -a lines=(
    'Type                 Filter results; punctuation stays searchable'
    '↑ / ↓ or Ctrl-P/N    Move selection; stop at either end'
    'Enter                Apply the action shown in the footer'
    'Escape / Ctrl-G      Cancel; go back from a secondary view'
    'Ctrl-C               Abort the picker'
    'Ctrl-U               Clear filter'
    'Backspace            Delete one character'
    'Ctrl-W               Delete the last word'
    'Fn/Option-Up/Down    Page up/down in the focused pane; one-line overlap'
    'Ctrl-V / Ctrl-D      Page down/up without Option-as-Meta'
    'Ctrl-L               Redraw'
    'Ctrl-K               Show or close this keyboard guide'
  )
  (( ${_ZLE_PICKER_QUERY_SUBMIT:-0} )) &&
    lines[1]='Type                 Enter discovery fragments; Return starts search'
  (( _ZLE_PICKER_DIGIT_SELECT )) && lines+=(
    '0–9                  Apply a visible slot only with an empty filter')
  (( _ZLE_PICKER_COPY_ENABLED )) && lines+=(
    'Ctrl-Y               Copy the selection and close the picker')
  (( _ZLE_PICKER_REFRESH_ENABLED )) && lines+=(
    'Ctrl-R               Refresh the current captured choices')
  [[ -n ${_ZLE_PICKER_SEARCH_ACTION:-} ]] && lines+=(
    'Ctrl-F               Search descendants of the displayed folder'
    'Return               Submit discovery query; typing never starts a scan')
  if (( _ZLE_PICKER_DIRECTORY_ACTIONS == 1 )); then
    lines+=('Ctrl-O               Preview selected folder, or current if none'
            'Ctrl-X               Options: folder actions, including current folder'
            'Ctrl-E / Ctrl-B      Focus preview / return to folder list')
  elif (( _ZLE_PICKER_DIRECTORY_ACTIONS == 2 )); then
    lines+=('Ctrl-O               Browse inside the selected recent location')
  fi
  if (( ${_ZLE_PICKER_WORKSPACE_ACTIONS:-0} )) && [[ ${_ZLE_PICKER_OPTIONS_KIND:-} == git ]]; then
    lines+=('Ctrl-X               Review: working changes or selected branch commits'
            'Review               Read-only; select files to read their continuous diff'
            'Scope                Working changes belong to the current worktree'
            'History              The selected branch is inspected without switching')
  elif (( _ZLE_PICKER_DOCUMENT )); then
    lines+=('Right                Files → focused diff → full-file context'
            'Left                 Full-file context → focused diff → files'
            'Disclosure           Untracked files and metadata have one reading level'
            'Selection            Load one file; recently read snapshots are reused'
            'Tab / Shift-Tab      Switch panes directly, preserving context mode'
            'Ctrl-E / Ctrl-B      Focus diff reader / file navigator'
            'Line numbers         Old file on the left; new file on the right'
            'Reading              Scroll stays within this file; Escape returns'
            'Snapshot             Read-only; staged and unstaged are separate rows')
    (( _ZLE_PICKER_DOCUMENT_REFRESH )) && lines+=(
      'Ctrl-R               Refresh file list and diff; also works with no results'
      'Refresh              Retains filter, file/change kind and source area when available'
      'Updates              Manual snapshots; refresh while another tool edits files')
  elif (( ${_ZLE_PICKER_WORKSPACE_ACTIONS:-0} )); then
    lines+=(
    'Ctrl-X               Options: actions, sources, Browse and Recents'
    'Action groups        Selected folder / Current folder / Go to'
    'Go to                Independent navigation to this shell Recents'
    'Browse               Children of the displayed folder; Enter inserts'
    'Search               Submit fragments to search below this folder'
    'Recents              Enter inserts a path; submit at the prompt to cd'
    'Sources              Filesystem walk, Git files, or Spotlight index'
    'Limits               Walk: 20,000 entries; captured matches: 2,000'
    'Coverage             Git ignores untracked ignored files and empty dirs'
    'Spotlight            Filename seed; unindexed/excluded paths may be absent'
    'Refinement           Typing filters captured paths; discovery is explicit'
    'Source choice        Ctrl-X selects Filesystem, Git files, or Spotlight')
  fi
  if (( _ZLE_PICKER_HIERARCHY_ENABLED )); then
    lines+=('Right / Tab          Enter selected folder'
            'Left / Shift-Tab     Go back, restoring filter and selection'
            'Ctrl-T               Toggle hidden folders')
  elif (( ${#_ZLE_PICKER_INSPECT_TEXTS} && !_ZLE_PICKER_DOCUMENT )); then
    lines+=('Tab / Shift-Tab      Switch between list and details'
            'Right / Ctrl-E       Focus details'
            'Left / Ctrl-B        Focus list')
  fi
  lines+=('Control shortcuts apply only inside this picker.'
          'Escape cancels; it is not a command prefix.'
          'Fn-Up/Down and Option-Up/Down page; optional Meta key Option-V pages up,'
          'Option-Delete deletes a word; Option-W copies where available.')
  _zle_picker_body_height
  height=$REPLY
  (( height < 2 )) && height=2
  _ZLE_PICKER_GUIDE_PAGE=$(( height - 1 ))
  max_offset=$(( ${#lines} - _ZLE_PICKER_GUIDE_PAGE ))
  (( max_offset < 0 )) && max_offset=0
  (( _ZLE_PICKER_GUIDE_OFFSET > max_offset )) && _ZLE_PICKER_GUIDE_OFFSET=$max_offset
  (( _ZLE_PICKER_GUIDE_OFFSET < 0 )) && _ZLE_PICKER_GUIDE_OFFSET=0
  _ZLE_PICKER_DISPLAY=() _ZLE_PICKER_DISPLAY_STYLES=() _ZLE_PICKER_DISPLAY_HIGHLIGHTS=()
  for (( index=0; index<height; ++index )); do
    if (( index == 0 )); then
      row="Keyboard guide · $(( _ZLE_PICKER_GUIDE_OFFSET + 1 ))/${#lines}"
      role=picker-header
    else
      row=${lines[index + _ZLE_PICKER_GUIDE_OFFSET]-}
      role=picker-text
    fi
    _zle_picker_fit "$row" $width
    _ZLE_PICKER_DISPLAY+=("$REPLY")
    _ZLE_PICKER_DISPLAY_STYLES+=("$role")
    _ZLE_PICKER_DISPLAY_HIGHLIGHTS+=('')
  done
  _zle_picker_footer $width ""
  _ZLE_PICKER_DISPLAY+=("${(mr:$width:: :)REPLY}")
  _ZLE_PICKER_DISPLAY_STYLES+=(picker-muted)
  _ZLE_PICKER_DISPLAY_HIGHLIGHTS+=('')
  _ZLE_PICKER_DISPLAY_INDEX_ENDS=("${_ZLE_PICKER_DISPLAY[@]/*/0}")
  _ZLE_PICKER_DISPLAY_LEFT_ENDS=("${_ZLE_PICKER_DISPLAY[@]/*/-1}")
  _ZLE_PICKER_DISPLAY_RIGHT_ROLES=("${_ZLE_PICKER_DISPLAY[@]/*/}")
  _ZLE_PICKER_DISPLAY_RIGHT_SYNTAX=()
  _ZLE_PICKER_DISPLAY_CONTEXT_STARTS=("${_ZLE_PICKER_DISPLAY[@]/*/0}")
  _ZLE_PICKER_DISPLAY_MATCH_STARTS=("${_ZLE_PICKER_DISPLAY[@]/*/-1}")
  _ZLE_PICKER_INDEXES_VISIBLE=0
  _zle_picker_workspace
}

_zle_picker_render() {
  emulate -L zsh

  local query=$1
  local -i selected=$2 columns=${COLUMNS:-80} row_width content_width
  _zle_picker_body_height
  local -i body_height=$REPLY
  local -i query_width=0
  local -i context_width=0 context_start=0 name_width=0 detail_width=0
  local -i full_width=0 left_width=0 inspector=${#_ZLE_PICKER_INSPECT_TEXTS}
  local -i index=0 count=${#_ZLE_PICKER_RESULTS} index_width=2 index_end=0
  local -i total=$count view_limit=$_ZLE_PICKER_VIEW_LIMIT first=1 last=0 position=0
  local -i zero_based=0 trail_width=0 label_width=0 label_start=0
  local -i passive_count=${#_ZLE_PICKER_PASSIVE_LINES} passive_limit=0
  local shown_query='' shown_title='' shown_browse='' shown_empty=''
  local query_label="${(V)${_ZLE_PICKER_QUERY_LABEL:-Search}} " query_open='‹' query_close='›'
  local label='' row='' footer='' result_index='' context='' value='' accept_label='' highlight_specs=''
  typeset -ga _ZLE_PICKER_DISPLAY=()
  typeset -ga _ZLE_PICKER_DISPLAY_STYLES=()
  typeset -ga _ZLE_PICKER_DISPLAY_INDEX_ENDS=()
  typeset -ga _ZLE_PICKER_DISPLAY_HIGHLIGHTS=()
  _ZLE_PICKER_DISPLAY_LEFT_ENDS=()
  _ZLE_PICKER_DISPLAY_RIGHT_ROLES=()
  _ZLE_PICKER_DISPLAY_RIGHT_SYNTAX=()
  _ZLE_PICKER_DISPLAY_CONTEXT_STARTS=()
  _ZLE_PICKER_DISPLAY_MATCH_STARTS=()
  _ZLE_PICKER_DISPLAY_PREFIX_ENDS=()
  _ZLE_PICKER_QUERY_ROW=''
  _ZLE_PICKER_SUBTITLE_ROW=''
  _ZLE_PICKER_QUERY_START=0
  _ZLE_PICKER_QUERY_END=0
  _ZLE_PICKER_INDEXES_VISIBLE=0
  _ZLE_PICKER_VISIBLE_KEYS=()

  (( columns < 4 )) && columns=4
  (( view_limit < 1 )) && view_limit=1
  if (( _ZLE_PICKER_DOCUMENT )); then
    view_limit=$body_height
  else
    (( view_limit > 20 )) && view_limit=20
    if (( passive_count )); then
      (( passive_count >= body_height )) && passive_count=$(( body_height - 1 ))
      (( passive_count < 0 )) && passive_count=0
      (( view_limit > body_height - passive_count )) &&
        view_limit=$(( body_height - passive_count ))
    fi
  fi
  (( LINES > 6 && view_limit > body_height )) && view_limit=$body_height
  (( selected > total )) && selected=$total
  (( selected < 1 && total )) && selected=1
  (( total == 0 )) && selected=0
  if (( selected > _ZLE_PICKER_VIEW_OFFSET + view_limit )); then
    _ZLE_PICKER_VIEW_OFFSET=$(( selected - view_limit ))
  elif (( selected <= _ZLE_PICKER_VIEW_OFFSET )); then
    _ZLE_PICKER_VIEW_OFFSET=$(( selected - 1 ))
  fi
  (( _ZLE_PICKER_VIEW_OFFSET > total - view_limit )) && _ZLE_PICKER_VIEW_OFFSET=$(( total - view_limit ))
  (( _ZLE_PICKER_VIEW_OFFSET < 0 )) && _ZLE_PICKER_VIEW_OFFSET=0
  first=$(( _ZLE_PICKER_VIEW_OFFSET + 1 ))
  last=$(( _ZLE_PICKER_VIEW_OFFSET + view_limit ))
  (( last > total )) && last=$total
  count=$(( last - first + 1 ))
  _ZLE_PICKER_SELECTED=$selected
  _ZLE_PICKER_QUERY=$query
  _ZLE_PICKER_VISIBLE_COUNT=$count
  row_width=$(( columns - 1 ))
  full_width=$row_width
  shown_query=${(V)query}
  shown_title=${(V)_ZLE_PICKER_TITLE}
  shown_browse=${(V)_ZLE_PICKER_BROWSE_LABEL}
  shown_empty=${(V)_ZLE_PICKER_EMPTY_LABEL}

  _ZLE_PICKER_TITLEBAR=''
  _ZLE_PICKER_TITLEBAR_META_START=-1
  if (( ${_ZLE_PICKER_SCREEN_ACTIVE:-0} )); then
    _zle_picker_titlebar $row_width
    _ZLE_PICKER_HEADER=$shown_browse
  else
    _ZLE_PICKER_HEADER="${shown_title} · ${shown_browse}"
  fi
  if (( ${_ZLE_PICKER_BUSY:-0} )); then
    : # Capture has no result count yet.
  elif (( _ZLE_PICKER_HAS_MORE )); then
    _ZLE_PICKER_HEADER+=" · ${first}–${last} · more ↓"
  elif (( total > count )); then
    _ZLE_PICKER_HEADER+=" · ${first}–${last} of ${total}"
  else
    _ZLE_PICKER_HEADER+=" · ${count} shown"
  fi
  if (( ${(m)#_ZLE_PICKER_HEADER} > row_width )); then
    _zle_picker_fit "$_ZLE_PICKER_HEADER" $row_width
    _ZLE_PICKER_HEADER=$REPLY
  fi

  if [[ -n $_ZLE_PICKER_SUBTITLE ]] && (( LINES >= 10 )); then
    _zle_picker_abbreviate "${(V)_ZLE_PICKER_SUBTITLE}" $row_width
    _ZLE_PICKER_SUBTITLE_ROW=$REPLY
  fi

  # A status view has no editable input. Other views retain a stable dedicated
  # query row so filtering never shifts the body.
  if (( _ZLE_PICKER_STATUS_VIEW )); then
    _ZLE_PICKER_QUERY_ROW=''
    _ZLE_PICKER_QUERY_START=0 _ZLE_PICKER_QUERY_END=0
  else
    query_width=$(( row_width - ${(m)#query_label} - ${#query_open} - ${#query_close} ))
    if (( query_width > 0 )); then
      _zle_picker_abbreviate "$shown_query" $query_width
      shown_query=$REPLY
      _ZLE_PICKER_QUERY_ROW="${query_label}${query_open}${shown_query}${query_close}"
      _ZLE_PICKER_QUERY_START=${#query_label}
      _ZLE_PICKER_QUERY_END=${#_ZLE_PICKER_QUERY_ROW}
    else
      query_label='› '
      query_width=$(( row_width - ${#query_label} ))
      _zle_picker_abbreviate "$shown_query" $query_width
      _ZLE_PICKER_QUERY_ROW="${query_label}${REPLY}"
      _ZLE_PICKER_QUERY_START=0
      _ZLE_PICKER_QUERY_END=${#_ZLE_PICKER_QUERY_ROW}
    fi
  fi

  if (( ${#_ZLE_PICKER_TRAIL} && columns >= 120 && ${_ZLE_PICKER_SCREEN_ACTIVE:-0} && LINES >= 10 && !_ZLE_PICKER_INSPECT_FOCUS )); then
    trail_width=$(( columns / 7 ))
    (( trail_width > 24 )) && trail_width=24
    (( row_width -= trail_width + 3 ))
    full_width=$row_width
  fi
  # An explicitly focused fallback has no selected row to sit beside. Give
  # that context the workspace; list focus restores the informational summary.
  if (( !count )) && [[ -n $_ZLE_PICKER_INSPECT_FALLBACK ]]; then
    (( _ZLE_PICKER_INSPECT_FOCUS )) || inspector=0
  fi
  if (( inspector && _ZLE_PICKER_DOCUMENT && columns >= 90 )); then
    # The document is primary; information panels retain their list-first policy.
    left_width=$(( (row_width - 3) / 3 ))
    (( left_width > 42 )) && left_width=42
    row_width=$left_width
  elif (( inspector && !_ZLE_PICKER_DOCUMENT && columns >= 100 && (count || !_ZLE_PICKER_INSPECT_FOCUS) )); then
    # Keep results primary in every tool. The information pane gets one third
    # of the usable width, capped at a readable 48 cells on large terminals.
    detail_width=$(( (row_width - 3) / 3 ))
    (( detail_width > 48 )) && detail_width=48
    left_width=$(( row_width - 3 - detail_width ))
    row_width=$left_width
  fi
  [[ ${_ZLE_PICKER_RESULT_INDEXES[1]-} == 0 && -z $query ]] && zero_based=1
  (( count && row_width >= index_width + 7 )) && _ZLE_PICKER_INDEXES_VISIBLE=1

  if (( count == 0 )); then
    if (( ${#_ZLE_PICKER_EMPTY_LINES} )); then
      # Captured empty-state context uses the main body without fake rows,
      # digit shortcuts, path actions, or provider calls during rendering.
      for row in "${_ZLE_PICKER_EMPTY_LINES[@][1,$body_height]}"; do
        _zle_picker_fit "${(V)row}" $row_width
        _ZLE_PICKER_DISPLAY+=("$REPLY")
        (( ++index ))
        if (( _ZLE_PICKER_STATUS_VIEW )) && [[ -n ${_ZLE_PICKER_BUSY_STYLES[index]-} ]]; then
          _ZLE_PICKER_DISPLAY_STYLES+=("${_ZLE_PICKER_BUSY_STYLES[index]}")
        elif (( index == 1 )); then
          _ZLE_PICKER_DISPLAY_STYLES+=(picker-header)
        else
          _ZLE_PICKER_DISPLAY_STYLES+=(picker-text)
        fi
      done
    else
      _zle_picker_fit "[--]   ${shown_empty}" $row_width
      _ZLE_PICKER_DISPLAY+=("$REPLY")
      _ZLE_PICKER_DISPLAY_STYLES+=(picker-empty)
    fi
    _ZLE_PICKER_DISPLAY_INDEX_ENDS=("${_ZLE_PICKER_DISPLAY[@]/*/0}")
    _ZLE_PICKER_DISPLAY_HIGHLIGHTS=("${_ZLE_PICKER_DISPLAY[@]/*/}")
    _ZLE_PICKER_DISPLAY_CONTEXT_STARTS=("${_ZLE_PICKER_DISPLAY[@]/*/0}")
    _ZLE_PICKER_DISPLAY_MATCH_STARTS=("${_ZLE_PICKER_DISPLAY[@]/*/-1}")
  else
    for label in "${_ZLE_PICKER_LABELS[@][$first,$last]}"; do
      (( ++index ))
      position=$(( _ZLE_PICKER_VIEW_OFFSET + index ))
      label=${label//$'\n'/ ↵ }
      label=${label//$'\t'/ ⇥ }
      label=${(V)label}
      result_index=$(( index - zero_based ))
      (( _ZLE_PICKER_DIGIT_SELECT && !zero_based && index == 10 )) && result_index=0
      _ZLE_PICKER_VISIBLE_KEYS+=("$result_index")
      content_width=$(( row_width - 2 ))
      (( _ZLE_PICKER_INDEXES_VISIBLE )) && content_width=$(( row_width - index_width - 5 ))
      value=${_ZLE_PICKER_RESULTS[position]}
      highlight_specs=${_ZLE_PICKER_LABEL_HIGHLIGHTS[$value]-}
      context=${_ZLE_PICKER_CONTEXTS[$value]-}
      context_start=0
      if [[ -n $context ]] && (( content_width >= 24 )); then
        context=${(V)context}
        context_width=$(( content_width / 3 ))
        (( context_width > 24 )) && context_width=24
        name_width=$(( content_width - context_width - 2 ))
        REPLY=$label
        (( ${(m)#label} > name_width )) && _zle_picker_abbreviate "$label" $name_width
        label=${(mr:$name_width:: :)REPLY}
        context_start=$(( row_width - content_width + ${#label} + 2 ))
        REPLY=$context
        (( ${(m)#context} > context_width )) && _zle_picker_abbreviate "$context" $context_width
        label+="  $REPLY"
      elif (( ${(m)#label} > content_width )); then
        # Context labels denote structured rows: preserve filename extensions
        # and distinctive suffixes even when there is no room for the parent.
        if [[ -n $context ]]; then
          _zle_picker_abbreviate "$label" $content_width
          label=$REPLY
        else
          label="${label[1,$(( content_width - 1 ))]}…"
        fi
      fi
      if (( _ZLE_PICKER_INDEXES_VISIBLE )); then
        if (( position == selected )); then
          row="[${(l:$index_width:: :)result_index}] ● ${label}"
          _ZLE_PICKER_DISPLAY_STYLES+=(picker-selected)
          index_end=0
        else
          row="[${(l:$index_width:: :)result_index}]   ${label}"
          _ZLE_PICKER_DISPLAY_STYLES+=(picker-text)
          index_end=$(( index_width + 2 ))
        fi
      else
        if (( position == selected )); then
          row="● ${label}"
          _ZLE_PICKER_DISPLAY_STYLES+=(picker-selected)
        else
          row="· ${label}"
          _ZLE_PICKER_DISPLAY_STYLES+=(picker-text)
        fi
        index_end=0
      fi
      label_width=${#label}
      label_start=$(( _ZLE_PICKER_INDEXES_VISIBLE ? index_width + 5 : 2 ))
      _zle_picker_highlights_shift "$highlight_specs" $label_start $label_width
      _ZLE_PICKER_DISPLAY_HIGHLIGHTS+=("$REPLY")
      if (( ${(m)#row} > row_width )); then
        _zle_picker_fit "$row" $row_width
        row=$REPLY
      fi
      _ZLE_PICKER_DISPLAY+=("${(mr:$row_width:: :)row}")
      _ZLE_PICKER_DISPLAY_INDEX_ENDS+=($index_end)
      _ZLE_PICKER_DISPLAY_CONTEXT_STARTS+=($context_start)
      _ZLE_PICKER_DISPLAY_MATCH_STARTS+=($(( _ZLE_PICKER_INDEXES_VISIBLE ? index_width + 5 : 2 )))
    done
  fi

  # Passive context belongs to the current view, not its candidate set. Keep
  # it visibly adjacent while excluding it from indexes and keyboard actions.
  if (( passive_count )); then
    passive_limit=$(( body_height - ${#_ZLE_PICKER_DISPLAY} ))
    (( passive_limit > passive_count )) && passive_limit=$passive_count
    for (( index = 1; index <= passive_limit; ++index )); do
      row=${_ZLE_PICKER_PASSIVE_LINES[index]}
      _zle_picker_fit "${(V)row}" $row_width
      _ZLE_PICKER_DISPLAY+=("$REPLY")
      _ZLE_PICKER_DISPLAY_STYLES+=("${_ZLE_PICKER_PASSIVE_STYLES[index]:-picker-text}")
      _ZLE_PICKER_DISPLAY_INDEX_ENDS+=(0)
      _ZLE_PICKER_DISPLAY_HIGHLIGHTS+=('')
      _ZLE_PICKER_DISPLAY_CONTEXT_STARTS+=(0)
      _ZLE_PICKER_DISPLAY_MATCH_STARTS+=(-1)
    done
  fi

  (( _ZLE_PICKER_GUIDE_ACTIVE )) && { _zle_picker_guide_render $(( columns - 1 )); return; }
  row_width=$full_width
  if (( _ZLE_PICKER_STATUS_VIEW )); then
    local separator=${(l:$(( columns - 1 ))::─:)}
    _ZLE_PICKER_DISPLAY=("$separator" "${_ZLE_PICKER_DISPLAY[@]}")
    _ZLE_PICKER_DISPLAY_STYLES=(picker-muted "${_ZLE_PICKER_DISPLAY_STYLES[@]}")
    _ZLE_PICKER_DISPLAY_INDEX_ENDS=(0 "${_ZLE_PICKER_DISPLAY_INDEX_ENDS[@]}")
    _ZLE_PICKER_DISPLAY_HIGHLIGHTS=('' "${_ZLE_PICKER_DISPLAY_HIGHLIGHTS[@]}")
    _ZLE_PICKER_DISPLAY_CONTEXT_STARTS=(0 "${_ZLE_PICKER_DISPLAY_CONTEXT_STARTS[@]}")
    _ZLE_PICKER_DISPLAY_MATCH_STARTS=(-1 "${_ZLE_PICKER_DISPLAY_MATCH_STARTS[@]}")
  else
    _zle_picker_footer $(( columns - 1 )) "$query"
    footer=$REPLY
    _ZLE_PICKER_DISPLAY+=("${(mr:$(( columns - 1 )):: :)footer}")
    _ZLE_PICKER_DISPLAY_STYLES+=(picker-muted)
    _ZLE_PICKER_DISPLAY_INDEX_ENDS+=(0)
    _ZLE_PICKER_DISPLAY_HIGHLIGHTS+=('')
    _ZLE_PICKER_DISPLAY_CONTEXT_STARTS+=(0)
    _ZLE_PICKER_DISPLAY_MATCH_STARTS+=(-1)
    (( inspector )) && _zle_picker_inspect_render $selected $full_width $left_width
    _zle_picker_workspace
    _zle_picker_trail_render $trail_width
  fi
  return 0
}

# Draw every selector through POSTDISPLAY so native region_highlight provides
# color without embedding escape sequences or corrupting width calculations.
_zle_picker_show() {
  emulate -L zsh

  local previous_postdisplay=$POSTDISPLAY
  local row='' style_key='' style='' index_style='' query_style=''
  local -i index=0 index_end=0 left_end=0 row_end=0 right_start=0 context_start=0
  local role='' color='' token_base='' highlight_style=''
  local match_style='' span=''
  local -a reply=() bounds=() attributes=() fields=()
  local -i span_start=0 span_end=0 selected_row=0
  local -i match_start=0 match_end=0
  local -i offset=$(( ${#PREDISPLAY} + ${#BUFFER} + 1 )) end=0

  region_highlight=("${(@)region_highlight:#*memo=my-zsh-picker}")
  POSTDISPLAY=''
  if (( _ZLE_PICKER_SCREEN_ACTIVE )) && [[ -n $_ZLE_PICKER_TITLEBAR ]]; then
    POSTDISPLAY=$_ZLE_PICKER_TITLEBAR
    _zle_picker_style picker-header 'fg=75,bold'
    end=$(( offset - 1 + ${#_ZLE_PICKER_TITLEBAR} ))
    region_highlight+=("P$(( offset - 1 )) ${end} ${REPLY} memo=my-zsh-picker")
    if (( _ZLE_PICKER_TITLEBAR_META_START >= 0 )); then
      _zle_picker_style picker-muted 'fg=242'
      region_highlight+=("P$(( offset - 1 + _ZLE_PICKER_TITLEBAR_META_START )) ${end} none,${REPLY} memo=my-zsh-picker")
    fi
    (( offset = end + 1 ))
  fi
  POSTDISPLAY+=$'\n'"$_ZLE_PICKER_HEADER"

  if (( _ZLE_PICKER_STATUS_VIEW )); then
    _zle_picker_style picker-status-heading 'fg=75,bold'
  elif (( _ZLE_PICKER_SCREEN_ACTIVE )); then
    _zle_picker_style picker-muted 'fg=242'
  else
    _zle_picker_style picker-header 'fg=75,bold'
  fi
  style=$REPLY
  end=$(( offset + ${#_ZLE_PICKER_HEADER} ))
  region_highlight+=("P${offset} ${end} ${style} memo=my-zsh-picker")
  (( offset = end + 1 ))

  if [[ -n $_ZLE_PICKER_SUBTITLE_ROW ]]; then
    POSTDISPLAY+=$'\n'"$_ZLE_PICKER_SUBTITLE_ROW"
    _zle_picker_style picker-location 'fg=39'
    end=$(( offset + ${#_ZLE_PICKER_SUBTITLE_ROW} ))
    region_highlight+=("P${offset} ${end} ${REPLY} memo=my-zsh-picker")
    (( offset = end + 1 ))
  fi

  if (( !_ZLE_PICKER_STATUS_VIEW )); then
    POSTDISPLAY+=$'\n'"$_ZLE_PICKER_QUERY_ROW"
    _zle_picker_style picker-muted 'fg=242'
    style=$REPLY
    end=$(( offset + ${#_ZLE_PICKER_QUERY_ROW} ))
    region_highlight+=("P${offset} ${end} ${style} memo=my-zsh-picker")
    if (( _ZLE_PICKER_QUERY_END > _ZLE_PICKER_QUERY_START )); then
      _zle_picker_style picker-query 'fg=16,bg=44,bold'
      query_style=$REPLY
      region_highlight+=(
        "P$(( offset + _ZLE_PICKER_QUERY_START )) $(( offset + _ZLE_PICKER_QUERY_END )) ${query_style} memo=my-zsh-picker"
      )
    fi
    (( offset = end + 1 ))
  fi

  for (( index = 1; index <= ${#_ZLE_PICKER_DISPLAY}; ++index )); do
    row=${_ZLE_PICKER_DISPLAY[index]}
    POSTDISPLAY+=$'\n'"$row"
    if [[ -z $row ]]; then
      (( ++offset ))
      continue
    fi
    style_key=${_ZLE_PICKER_DISPLAY_STYLES[index]}
    if [[ $style_key == picker-selected-inactive ]]; then
      _zle_picker_style "$style_key" 'fg=252,bg=238'
    elif [[ $style_key == picker-status-* ]]; then
      local status_role=${style_key#picker-status-} status_color=252 status_attributes=''
      case $status_role in
        (heading) status_color=75 status_attributes=bold ;;
        (info) status_color=111 ;;
        (progress) status_role=success status_color=71 status_attributes=bold ;;
        (warning) status_color=221 status_attributes=bold ;;
        (muted) status_color=242 ;;
      esac
      _zle_picker_output_color "$status_role" "$status_color"
      status_color=$REPLY
      _zle_picker_style "$style_key" "fg=$status_color${status_attributes:+,$status_attributes}"
    else
      _zle_picker_style "$style_key" 'fg=252'
    fi
    style=$REPLY
    index_end=${_ZLE_PICKER_DISPLAY_INDEX_ENDS[index]}
    end=$(( offset + ${#row} ))
    row_end=$end
    left_end=${_ZLE_PICKER_DISPLAY_LEFT_ENDS[index]:--1}
    if (( left_end >= 0 )); then
      end=$(( offset + left_end ))
      right_start=$end
      if (( left_end )); then
        if (( _ZLE_PICKER_INSPECT_FOCUS )); then
          _zle_picker_style picker-focus 'fg=75,bold'
        else
          _zle_picker_style picker-muted 'fg=242'
        fi
        region_highlight+=("P${end} $(( end + 3 )) ${REPLY} memo=my-zsh-picker")
        right_start=$(( end + 3 ))
      fi
      role=${_ZLE_PICKER_DISPLAY_RIGHT_ROLES[index]:-text}
      case $role in
        (heading) color=75 ;;
        (info) color=111 ;;
        (muted) color=242 ;;
        (warning) color=221 ;;
        (success) color=71 ;;
        (error) color=203 ;;
        (*) color=252 ;;
      esac
      _zle_picker_output_color "$role" "$color"
      color=$REPLY
      color="fg=$color"
      [[ $role == heading || $role == warning ]] && color+=',bold'
      if (( _ZLE_PICKER_DOCUMENT )); then
        case $role in
          (success) _zle_picker_review_style added; color=$REPLY ;;
          (error) _zle_picker_review_style removed; color=$REPLY ;;
        esac
      fi
      region_highlight+=("P${right_start} ${row_end} ${color} memo=my-zsh-picker")
      if (( _ZLE_PICKER_DOCUMENT )); then
        # ZLE bitwise-combines repeated fg= fields within a style specification.
        # Retain row background/attributes, replacing its foreground exactly once.
        attributes=("${(@s:,:)color}")
        attributes=("${(@)attributes:#fg=*}")
        token_base=${(j:,:)attributes}
        for span in ${=_ZLE_PICKER_DISPLAY_RIGHT_SYNTAX[index]}; do
          bounds=("${(@s.:.)span}")
          _zle_picker_review_style "$bounds[3]"
          # Repeat the row style so a token never erases its diff background.
          region_highlight+=("P$(( right_start + bounds[1] )) $(( right_start + bounds[2] )) ${token_base:+$token_base,}${REPLY} memo=my-zsh-picker")
        done
      fi
    fi
    if (( index_end )); then
      _zle_picker_style picker-index 'fg=44,bold'
      index_style=$REPLY
      region_highlight+=(
        "P${offset} $(( offset + index_end )) ${index_style} memo=my-zsh-picker"
        "P$(( offset + index_end )) ${end} ${style} memo=my-zsh-picker"
      )
    else
      region_highlight+=("P${offset} ${end} ${style} memo=my-zsh-picker")
    fi
    selected_row=0
    [[ $style_key == picker-selected* ]] && selected_row=1
    for span in ${=_ZLE_PICKER_DISPLAY_HIGHLIGHTS[index]}; do
      fields=( "${(@s.:.)span}" )
      (( ${#fields} == 3 )) || continue
      [[ ${fields[1]} == <-> && ${fields[2]} == <-> ]] || continue
      span_start=${fields[1]} span_end=${fields[2]} role=${fields[3]}
      (( span_start >= 0 && span_end > span_start && span_end <= end - offset )) || continue
      _zle_picker_label_highlight_style "$role" $selected_row "$style"
      highlight_style=$REPLY
      region_highlight+=("P$(( offset + span_start )) $(( offset + span_end )) ${highlight_style} memo=my-zsh-picker")
    done
    context_start=${_ZLE_PICKER_DISPLAY_CONTEXT_STARTS[index]:-0}
    if (( context_start && offset + context_start < end )) && [[ $style_key != picker-selected ]]; then
      _zle_picker_style picker-muted 'fg=242'
      region_highlight+=("P$(( offset + context_start )) ${end} ${REPLY} memo=my-zsh-picker")
    fi
    match_start=${_ZLE_PICKER_DISPLAY_MATCH_STARTS[index]:--1}
    match_end=$(( end - offset ))
    if [[ -n $_ZLE_PICKER_QUERY ]] && (( match_start >= 0 && match_start < match_end )); then
      _zle_picker_match_spans "${row[$(( match_start + 1 )),$match_end]}" "$_ZLE_PICKER_QUERY"
      if (( ${#reply} )); then
        if [[ $style_key == picker-selected ]]; then
          match_style="${style},underline"
        else
          _zle_picker_style picker-match 'fg=81,bold,underline'
          match_style=$REPLY
        fi
        for span in "${reply[@]}"; do
          bounds=( "${(@s: :)span}" )
          region_highlight+=("P$(( offset + match_start + bounds[1] )) $(( offset + match_start + bounds[2] )) ${match_style} memo=my-zsh-picker")
        done
      fi
    fi
    if (( ${_ZLE_PICKER_DISPLAY_PREFIX_ENDS[index]:-0} )); then
      _zle_picker_style picker-muted 'fg=242'
      region_highlight+=("P${offset} $(( offset + _ZLE_PICKER_DISPLAY_PREFIX_ENDS[index] )) none,${REPLY} memo=my-zsh-picker")
    fi
    (( offset = row_end + 1 ))
  done

  _ZLE_PICKER_POSTDISPLAY=$POSTDISPLAY
  {
    zle -R
  } always {
    # Zsh 5.9 refreshes before TRAPWINCH. Leave the painted frame on screen,
    # but do not leave its width-dependent text in the next automatic refresh:
    # shrinking the window would wrap/scroll it before our resize widget runs.
    # The widget paints a fresh frame from the captured results. Restoring these
    # parameters alone emits nothing and preserves the caller's editor state.
    POSTDISPLAY=$previous_postdisplay
    region_highlight=("${(@)region_highlight:#*memo=my-zsh-picker}")
  }
}

# A signal trap sees read-only ZLE parameters. Enter this registered widget
# before changing POSTDISPLAY or region_highlight during a live resize.
_zle_picker_redraw() {
  emulate -L zsh
  (( _ZLE_PICKER_ACTIVE || ${_ZLE_PICKER_BUSY:-0} )) || return 0
  # Terminal.app reflows existing cells before SIGWINCH. The picker owns this
  # temporary screen, so discard its old geometry without touching scrollback.
  (( ${_ZLE_PICKER_SCREEN_ACTIVE:-0} )) && zle .clear-screen
  _zle_picker_render "$_ZLE_PICKER_QUERY" $_ZLE_PICKER_SELECTED
  _zle_picker_show
}

# ZLE enables bracketed paste in modern terminals. Consume its complete closing
# marker here so pasted filter text cannot leak into the normal command buffer.
_zle_picker_read_bracketed_paste() {
  emulate -L zsh

  local character='' pasted='' marker=$'\e[201~'
  local -i content_length=0 max_length=1048576
  REPLY=''

  # A malformed or interrupted terminal sequence must not trap the editor in
  # an unbounded read or grow memory forever.
  while IFS= read -r -t 1 -k 1 character; do
    pasted+=$character
    (( ${#pasted} <= max_length )) || return 1
    if (( ${#pasted} >= ${#marker} )) && [[ $pasted[-${#marker},-1] == $marker ]]; then
      content_length=$(( ${#pasted} - ${#marker} ))
      (( content_length > 0 )) && REPLY=${pasted[1,$content_length]}
      return 0
    fi
  done
  return 1
}

# Adapt the history-specific collector to the reusable picker result contract.
_history_search_picker_collect() {
  emulate -L zsh

  _history_search_collect "$1" "$2"
  typeset -ga _ZLE_PICKER_RESULTS=("${_HISTORY_SEARCH_RESULTS[@]}")
  typeset -ga _ZLE_PICKER_LABELS=("${_HISTORY_SEARCH_RESULTS[@]}")
  typeset -ga _ZLE_PICKER_RESULT_INDEXES=()
  _HISTORY_SEARCH_RESULTS=()
}

# Run one searchable selector inside the active line editor. Collection is a
# narrow callback; input parsing, layout, color, cancellation, and cleanup stay
# centralized so every picker has identical ergonomics and safety behavior.
_zle_picker_step() {
  local -i delta=$1 selected=$2 count=$3
  REPLY=$selected
  if (( _ZLE_PICKER_GUIDE_ACTIVE )); then
    (( _ZLE_PICKER_GUIDE_OFFSET += delta ))
  elif (( _ZLE_PICKER_INSPECT_FOCUS )); then
    (( _ZLE_PICKER_INSPECT_OFFSET += delta ))
  elif (( count )); then
    REPLY=$(( selected + delta ))
    (( REPLY < 1 )) && REPLY=1
    (( REPLY > count && !_ZLE_PICKER_HAS_MORE )) && REPLY=$count
  else
    zle beep
  fi
  return 0
}

_zle_picker_page() {
  local -i page_size=$_ZLE_PICKER_VISIBLE_COUNT
  if (( _ZLE_PICKER_INSPECT_FOCUS )); then
    page_size=$_ZLE_PICKER_INSPECT_PAGE
    # Preserve one visual landmark between reader pages. The stride follows
    # the current rendered height, so resize/font changes need no stale cache.
    (( page_size > 1 )) && (( --page_size ))
  elif (( _ZLE_PICKER_GUIDE_ACTIVE )); then
    page_size=$_ZLE_PICKER_GUIDE_PAGE
    (( page_size > 1 )) && (( --page_size ))
  fi
  _zle_picker_step $(( $1 * page_size )) $2 $3
}

# Own the display for one interaction, which may contain several picker views.
# Callers return a choice; filesystem/application actions run after restoration.
_zle_picker_screen_session() {
  emulate -L zsh
  local -i _ZLE_PICKER_SESSION=1 _ZLE_PICKER_SCREEN_ACTIVE=0 result=0
  local saved_postdisplay=$POSTDISPLAY saved_buffer=$BUFFER saved_predisplay=$PREDISPLAY
  local saved_prompt=$PROMPT saved_rprompt=$RPROMPT
  local PROMPT=$PROMPT RPROMPT=$RPROMPT screen_exit=''
  local -i saved_cursor=$CURSOR saved_mark=$MARK
  local -i saved_suspended=${_ZLE_AUTOSUGGEST_SUSPENDED:-0}
  local -a saved_highlights=()

  if (( ! ${+functions[TRAPWINCH]} )); then
    setopt LOCAL_TRAPS
    TRAPWINCH() { zle compozsh-picker-redraw }
  fi
  _ZLE_AUTOSUGGEST_SUSPENDED=1
  region_highlight=("${(@)region_highlight:#*memo=my-zsh-autosuggestion}")
  if [[ -n ${_ZLE_AUTOSUGGEST_DISPLAY:-} && $POSTDISPLAY == "$_ZLE_AUTOSUGGEST_DISPLAY" ]]; then
    saved_postdisplay=''
    POSTDISPLAY=''
  fi
  _ZLE_AUTOSUGGEST_SUFFIX='' _ZLE_AUTOSUGGEST_DISPLAY=''
  {
    if [[ -t 1 && -n ${terminfo[smcup]} && -n ${terminfo[rmcup]} ]]; then
      saved_highlights=("${region_highlight[@]}")
      screen_exit=$terminfo[rmcup]
      print -rn -- "$terminfo[smcup]"
      _ZLE_PICKER_SCREEN_ACTIVE=1
      BUFFER='' CURSOR=0 PREDISPLAY='' POSTDISPLAY=''
      PROMPT='' RPROMPT='' region_highlight=()
      zle reset-prompt
      zle .clear-screen
    fi
    "$@"
    result=$?
  } always {
    _ZLE_PICKER_ACTIVE=0
    _ZLE_AUTOSUGGEST_SUSPENDED=$saved_suspended
    region_highlight=("${(@)region_highlight:#*memo=my-zsh-picker}")
    POSTDISPLAY=$saved_postdisplay
    if (( _ZLE_PICKER_SCREEN_ACTIVE )); then
      BUFFER=$saved_buffer CURSOR=$saved_cursor MARK=$saved_mark
      PREDISPLAY=$saved_predisplay
      PROMPT=$saved_prompt RPROMPT=$saved_rprompt
      region_highlight=("${saved_highlights[@]}")
      zle reset-prompt
    fi
    zle -R -c
    if (( _ZLE_PICKER_SCREEN_ACTIVE )); then
      print -rn -- "$screen_exit"
      _ZLE_PICKER_SCREEN_ACTIVE=0
      zle .redisplay
      zle -R -c
    fi
  }
  return $result
}

_zle_picker_loop() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local query=$1 raw_limit=$2 key='' sequence='' suffix='' collected_query=''
  local collector=$_ZLE_PICKER_COLLECTOR
  local -i configured_limit=8 limit=8 selected=1 count=0 direct_position=0
  local -i accepted=0 cancelled=0 aborted=0 copy_requested=0
  local -i collected=0 request_limit=0 wanted=0
  local -i read_columns=0 read_lines=0
  local -i start_index=1 start_offset=0
  local -i meta_sequence=0 idle_repaint=0 idle_result=1 idle_prepaint=0
  local -i document_preview_pending=0 document_settle_ticks=${_ZLE_PICKER_DOCUMENT_SETTLE_TICKS:-0}
  local -i document_ticks_left=0
  local document_target=''

  [[ $raw_limit == <-> ]] && configured_limit=$raw_limit
  (( configured_limit < 1 )) && configured_limit=1
  (( configured_limit > 20 )) && configured_limit=20
  (( ${+functions[$collector]} )) || return 2
  [[ ${3:-} == <-> ]] && (( $3 > 0 )) && start_index=$3
  [[ ${4:-} == <-> ]] && start_offset=$4

  if (( !${_ZLE_PICKER_SESSION:-0} )); then
    _zle_picker_screen_session _zle_picker_loop "$@"
    return $?
  fi

  _ZLE_PICKER_SELECTED_VALUE=''
  _ZLE_PICKER_BOOKMARK=()
  _ZLE_PICKER_BOOKMARK_FOCUS=0
  _ZLE_PICKER_ACCEPTED=0
  _ZLE_PICKER_ACTION='select'
  _ZLE_PICKER_GUIDE_ACTIVE=0
  _ZLE_PICKER_GUIDE_OFFSET=0
  _ZLE_PICKER_ACTIVE=1
  _ZLE_PICKER_VIEW_LIMIT=$configured_limit
  _ZLE_PICKER_VIEW_OFFSET=0
  _ZLE_PICKER_HAS_MORE=0
  _ZLE_PICKER_INSPECT_FOCUS=${_zle_picker_start_focus:-0}
  _ZLE_PICKER_INSPECT_OFFSET=0
  _ZLE_PICKER_INSPECT_KEY=''
  _ZLE_PICKER_INSPECT_WIDTH=0
  [[ -n ${_ZLE_PICKER_IDLE_CALLBACK:-} &&
     ${+functions[$_ZLE_PICKER_IDLE_CALLBACK]} == 1 ]] && idle_prepaint=1
  {
    while (( !accepted && !cancelled && !aborted )); do
      limit=$configured_limit
      _zle_picker_body_height
      (( _ZLE_PICKER_DOCUMENT )) && limit=$REPLY
      (( LINES > 0 && limit > REPLY )) && limit=$REPLY
      (( limit < 1 )) && limit=1
      # Retain a ranked prefix for this query. Grow it geometrically only when
      # the viewport reaches its edge; providers remain captured outside ZLE.
      wanted=$(( _ZLE_PICKER_VIEW_OFFSET + limit ))
      (( selected > wanted )) && wanted=$selected
      (( ++wanted ))
      if (( !collected )) || [[ $query != "$collected_query" ]]; then
        request_limit=$(( limit + 1 ))
        selected=1
        _ZLE_PICKER_VIEW_OFFSET=0
        if (( !collected && start_index )); then
          selected=$start_index
          _ZLE_PICKER_VIEW_OFFSET=$start_offset
          (( request_limit < selected + 1 )) && request_limit=$(( selected + 1 ))
          (( request_limit < start_offset + limit + 1 )) && request_limit=$(( start_offset + limit + 1 ))
          start_index=0
        fi
        collected=0
      elif (( _ZLE_PICKER_HAS_MORE && wanted > ${#_ZLE_PICKER_RESULTS} )); then
        (( request_limit *= 2 ))
        (( request_limit < wanted )) && request_limit=$wanted
        collected=0
      fi
      if (( !collected )); then
        "$collector" "$query" $request_limit
        _ZLE_PICKER_HAS_MORE=$(( ${#_ZLE_PICKER_RESULTS} >= request_limit ))
        collected_query=$query
        collected=1
      fi
      count=${#_ZLE_PICKER_RESULTS}
      (( count == 0 )) && selected=0
      (( count > 0 && selected < 1 )) && selected=1
      (( selected > count )) && selected=$count

      _ZLE_PICKER_QUERY=$query
      _ZLE_PICKER_SELECTED=$selected
      document_preview_pending=0
      # Terminal.app supplies input bytes, not key-release events. Never flush
      # repeated arrows: every complete sequence updates selection. A document
      # workspace may nevertheless defer its expensive preview until selection
      # is quiet. Intermediate rows paint the existing loading state inside
      # this input loop; only the latest exact target reaches the controller.
      if (( _ZLE_PICKER_DOCUMENT && count )) &&
         [[ ${_ZLE_PICKER_RESULTS[selected]} != "$_ZLE_PICKER_DOCUMENT_KEY" ]]; then
        if (( document_settle_ticks > 0 )); then
          document_preview_pending=1
          if [[ $document_target != ${_ZLE_PICKER_RESULTS[selected]} ]]; then
            document_target=${_ZLE_PICKER_RESULTS[selected]}
            document_ticks_left=$document_settle_ticks
          fi
        else
          _ZLE_PICKER_ACTION=inspect
          accepted=1
          continue
        fi
      fi
      key=''
      _zle_picker_render "$query" $selected
      if (( idle_prepaint )); then
        # Layout has now published the exact document viewport. Consume one
        # already-queued byte before touching optional presentation work: a
        # held-key stream owns the UI thread, even when a completed syntax
        # packet is ready. Unlike fd readability, `read -t 0 -k 1` succeeds
        # only when Zsh can actually return a byte, so a readable PTY without a
        # complete key does not starve the callback.
        if ! IFS= read -r -t 0 -k 1 key; then
          # With input idle, one nonblocking callback handoff may publish
          # completed metadata or schedule the current viewport. Provider
          # startup, requests and completion waits must never occur here.
          if "$_ZLE_PICKER_IDLE_CALLBACK"; then
            idle_result=0
          else
            idle_result=$?
          fi
          if (( idle_result == 0 )); then
            _zle_picker_render "$query" $selected
          fi
        fi
      fi
      _zle_picker_show

      read_columns=$COLUMNS
      read_lines=$LINES
      idle_repaint=0
      if (( document_preview_pending )); then
        # Consume input throughout the quiet window. Every received key resets
        # settlement; no preview provider, syntax callback or document parse
        # runs for an intermediate selection. Four ticks gives Git review a
        # 120 ms window, longer than the observed 83 ms held-key cadence while
        # keeping a single tap visibly responsive.
        if [[ -z $key ]]; then
          while ! IFS= read -r -t 0.03 -k 1 key; do
            if (( COLUMNS != read_columns || LINES != read_lines )); then
              idle_repaint=1
              break
            fi
            if (( --document_ticks_left <= 0 )); then
              _ZLE_PICKER_ACTION=inspect
              accepted=1
              break
            fi
          done
        fi
        if [[ -n $key ]]; then
          document_ticks_left=$document_settle_ticks
        fi
        (( idle_repaint || accepted )) && continue
      elif [[ -n ${_ZLE_PICKER_IDLE_CALLBACK:-} && ${+functions[$_ZLE_PICKER_IDLE_CALLBACK]} == 1 ]]; then
        # Optional caller work is polled only while input is idle. The short
        # timed read gives terminal bytes priority; callbacks may publish
        # already-computed metadata, schedule work without waiting and request
        # a repaint. Input still receives priority before every callback.
        if [[ -z $key ]]; then
          while ! IFS= read -r -t 0.03 -k 1 key; do
            if (( COLUMNS != read_columns || LINES != read_lines )); then
              idle_repaint=1
              break
            fi
            if "$_ZLE_PICKER_IDLE_CALLBACK"; then
              idle_result=0
            else
              idle_result=$?
            fi
            if (( idle_result == 0 )); then
              idle_repaint=1
              break
            elif (( idle_result == 2 )); then
              # The caller has no pending work for this frame. Return to a true
              # blocking read until the next key or resize changes the viewport.
              if ! IFS= read -r -k 1 key; then
                if (( COLUMNS != read_columns || LINES != read_lines )); then
                  idle_repaint=1
                else
                  cancelled=1
                fi
              fi
              break
            fi
          done
        fi
        (( idle_repaint )) && continue
        (( cancelled )) && break
      elif [[ -z $key ]] && ! IFS= read -r -k 1 key; then
        # A terminal resize may interrupt read before ZLE's resize callback can
        # repaint. Keep the selection and redraw the cached viewport next turn.
        (( COLUMNS != read_columns || LINES != read_lines )) && continue
        cancelled=1
        break
      fi

      # A resize can redraw while read waits. Only currently visible rows may
      # be accepted by index, and the highlighted row remains the selected one.
      selected=$_ZLE_PICKER_SELECTED
      count=${#_ZLE_PICKER_RESULTS}

      # A guide never applies a result or edits the hidden filter. Only its
      # scrolling, dismissal and whole-session abort keys remain active.
      if (( _ZLE_PICKER_GUIDE_ACTIVE )); then
        case $key in
          ($'\r'|$'\n'|$'\x07'|$'\x0b') _ZLE_PICKER_GUIDE_ACTIVE=0; continue ;;
          ($'\e'|$'\x03'|$'\x0c'|$'\x10'|$'\x0e'|$'\x16'|$'\x04') ;;
          (*) zle beep; continue ;;
        esac
      fi
      case $key in
        ($'\x0b')
          _ZLE_PICKER_GUIDE_ACTIVE=1
          _ZLE_PICKER_GUIDE_OFFSET=0
          ;;
        ($'\x0f')
          if (( _ZLE_PICKER_DIRECTORY_ACTIONS == 1 )); then
            _ZLE_PICKER_ACTION=preview
            accepted=1
          elif (( _ZLE_PICKER_DIRECTORY_ACTIONS == 2 && count )); then
            _ZLE_PICKER_ACTION=browse
            accepted=1
          else
            zle beep
          fi
          ;;
        ($'\x18')
          if (( !_ZLE_PICKER_DOCUMENT &&
                (_ZLE_PICKER_DIRECTORY_ACTIONS == 1 || ${_ZLE_PICKER_WORKSPACE_ACTIONS:-0}) )); then
            _ZLE_PICKER_ACTION=actions
            accepted=1
          else
            zle beep
          fi
          ;;
        ($'\x14')
          if (( _ZLE_PICKER_HIERARCHY_ENABLED )); then
            _ZLE_PICKER_ACTION=toggle-hidden
            accepted=1
          else
            zle beep
          fi
          ;;
        ($'\x06')
          if [[ -n ${_ZLE_PICKER_SEARCH_ACTION:-} ]]; then
            _ZLE_PICKER_ACTION=$_ZLE_PICKER_SEARCH_ACTION
            accepted=1
          else
            zle beep
          fi
          ;;
        ($'\x05'|$'\x02')
          if (( ${#_ZLE_PICKER_INSPECT_TEXTS} )); then
            [[ $key == $'\x05' ]] && _ZLE_PICKER_INSPECT_FOCUS=1 || _ZLE_PICKER_INSPECT_FOCUS=0
          else
            zle beep
          fi
          ;;
        ($'\x16'|$'\x04')
          [[ $key == $'\x16' ]] && _zle_picker_page 1 $selected $count ||
            _zle_picker_page -1 $selected $count
          selected=$REPLY
          ;;
        ($'\r'|$'\n')
          if (( ${_ZLE_PICKER_QUERY_SUBMIT:-0} )) && [[ -n ${query//[[:space:]]/} ]]; then
            _ZLE_PICKER_ACTION=query
            accepted=1
          elif (( count )); then
            accepted=1
          else
            zle beep
          fi
          ;;
        ($'\x03')
          aborted=1
          ;;
        ($'\x07')
          cancelled=1
          ;;
        ($'\x7f'|$'\x08')
          _ZLE_PICKER_INSPECT_FOCUS=0
          if [[ -n $query ]]; then
            query=${query[1,-2]}
            selected=1
          else
            zle beep
          fi
          ;;
        ($'\x15')
          _ZLE_PICKER_INSPECT_FOCUS=0
          query=''
          selected=1
          ;;
        ($'\x19')
          if (( _ZLE_PICKER_COPY_ENABLED && count )); then
            copy_requested=1
            accepted=1
          else
            zle beep
          fi
          ;;
        ($'\x17')
          _ZLE_PICKER_INSPECT_FOCUS=0
          query=${query%%[[:space:]]#}
          query=${query%%[^[:space:]]#}
          selected=1
          ;;
        ($'\x0c')
          zle clear-screen
          ;;
        ($'\x12')
          if (( _ZLE_PICKER_DOCUMENT )); then
            if (( _ZLE_PICKER_DOCUMENT_REFRESH )); then
              _ZLE_PICKER_ACTION=document-refresh
              accepted=1
            else
              zle beep
            fi
          elif (( _ZLE_PICKER_REFRESH_ENABLED )); then
            _ZLE_PICKER_ACTION=refresh
            accepted=1
          else
            _zle_picker_step 1 $selected $count
            selected=$REPLY
          fi
          ;;
        ($'\x0e'|$'\t')
          if (( ${#_ZLE_PICKER_INSPECT_TEXTS} && !_ZLE_PICKER_HIERARCHY_ENABLED )) && [[ $key == $'\t' ]]; then
            (( _ZLE_PICKER_INSPECT_FOCUS = !_ZLE_PICKER_INSPECT_FOCUS ))
          elif (( _ZLE_PICKER_HIERARCHY_ENABLED )) && [[ $key == $'\t' ]]; then
            if (( count )); then
              _ZLE_PICKER_ACTION='descend'
              accepted=1
            else
              zle beep
            fi
          else
            _zle_picker_step 1 $selected $count
            selected=$REPLY
          fi
          ;;
        ($'\x10')
          _zle_picker_step -1 $selected $count
          selected=$REPLY
          ;;
        ($'\e')
          sequence=''
          meta_sequence=0
          # Only allow transport time for arrows, paste and optional Meta keys.
          # No human Escape-then-letter commands: cancellation stays responsive.
          if ! IFS= read -r -t 0.02 -k 1 sequence; then
            if (( _ZLE_PICKER_GUIDE_ACTIVE )); then
              _ZLE_PICKER_GUIDE_ACTIVE=0
            else
              cancelled=1
            fi
            continue
          fi
          # Terminal.app can represent Option-arrow by prefixing the ordinary
          # cursor sequence with a second Escape. Accept only cursor transport
          # after that prefix; it never creates a human Escape chord.
          if [[ $sequence == $'\e' ]]; then
            meta_sequence=1
            suffix=''
            if ! IFS= read -r -t 0.1 -k 1 suffix || [[ $suffix != ('['|O) ]]; then
              cancelled=1
              continue
            fi
            sequence=$suffix
          fi
          if (( _ZLE_PICKER_GUIDE_ACTIVE )) && [[ $sequence != (v|'['|O) ]]; then
            zle beep
            continue
          fi
          case $sequence in
            ('v')
              _zle_picker_page -1 $selected $count
              selected=$REPLY
              ;;
            ('w'|'W')
              if (( _ZLE_PICKER_COPY_ENABLED && count )); then
                copy_requested=1
                accepted=1
              else
                zle beep
              fi
              ;;
            ($'\x7f'|$'\x08')
              _ZLE_PICKER_INSPECT_FOCUS=0
              query=${query%%[[:space:]]#}
              query=${query%%[^[:space:]]#}
              selected=1
              ;;
            ('['|'O')
              suffix=''
              if ! IFS= read -r -t 0.1 -k 1 suffix; then
                cancelled=1
                continue
              fi
              sequence+=$suffix
              if (( _ZLE_PICKER_GUIDE_ACTIVE )) && [[ $sequence != ('[A'|'OA'|'[B'|'OB'|'[5'|'[6'|'[2'|'[1') ]]; then
                zle beep
                continue
              fi
              case $sequence in
                ('[A'|'OA')
                  if (( meta_sequence )); then
                    _zle_picker_page -1 $selected $count
                  else
                    _zle_picker_step -1 $selected $count
                  fi
                  selected=$REPLY
                  ;;
                ('[Z')
                  if (( ${#_ZLE_PICKER_INSPECT_TEXTS} && !_ZLE_PICKER_HIERARCHY_ENABLED )); then
                    (( _ZLE_PICKER_INSPECT_FOCUS = !_ZLE_PICKER_INSPECT_FOCUS ))
                  elif (( _ZLE_PICKER_HIERARCHY_ENABLED )); then
                    _ZLE_PICKER_ACTION='parent'
                    accepted=1
                  else
                    _zle_picker_step -1 $selected $count
                    selected=$REPLY
                  fi
                  ;;
                ('[C'|'OC'|'[D'|'OD')
                  if (( meta_sequence )); then
                    zle beep
                    continue
                  fi
                  if (( _ZLE_PICKER_DOCUMENT )); then
                    if (( !count )); then zle beep; continue; fi
                    local direction=right
                    [[ $sequence == ('[D'|'OD') ]] && direction=left
                    _zle_picker_document_direction "$direction" "$_ZLE_PICKER_INSPECT_FOCUS" "$_ZLE_PICKER_DOCUMENT_MODE"
                    case $REPLY in
                      (read) _ZLE_PICKER_INSPECT_FOCUS=1 ;;
                      (files) _ZLE_PICKER_INSPECT_FOCUS=0 ;;
                      (focused|full)
                        _ZLE_PICKER_INSPECT_FOCUS=1
                        _ZLE_PICKER_ACTION="document-$REPLY"
                        accepted=1 ;;
                      (*) zle beep ;;
                    esac
                  elif (( ${#_ZLE_PICKER_INSPECT_TEXTS} && !_ZLE_PICKER_HIERARCHY_ENABLED )); then
                    [[ $sequence == ('[C'|'OC') ]] && _ZLE_PICKER_INSPECT_FOCUS=1 || _ZLE_PICKER_INSPECT_FOCUS=0
                  elif (( _ZLE_PICKER_HIERARCHY_ENABLED )); then
                    if [[ $sequence == ('[D'|'OD') ]]; then
                      _ZLE_PICKER_ACTION=parent
                      accepted=1
                    elif (( count )); then
                      _ZLE_PICKER_ACTION=descend
                      accepted=1
                    else
                      zle beep
                    fi
                  else
                    cancelled=1
                  fi
                  ;;
                ('[B'|'OB')
                  if (( meta_sequence )); then
                    _zle_picker_page 1 $selected $count
                  else
                    _zle_picker_step 1 $selected $count
                  fi
                  selected=$REPLY
                  ;;
                ('[5'|'[6')
                  suffix=''
                  if IFS= read -r -t 0.1 -k 1 suffix && [[ $suffix == '~' ]]; then
                    if [[ $sequence == '[6' ]]; then
                      _zle_picker_page 1 $selected $count
                    else
                      _zle_picker_page -1 $selected $count
                    fi
                    selected=$REPLY
                  else
                    zle beep
                  fi
                  ;;
                ('[1')
                  # Option-Up/Down with Terminal.app's Option-as-Meta setting.
                  # xterm names these kUP3/kDN3: ESC [ 1 ; 3 A/B.
                  suffix=''
                  if IFS= read -r -t 0.1 -k 3 suffix && [[ $suffix == (';3A'|';3B') ]]; then
                    [[ $suffix == ';3B' ]] && _zle_picker_page 1 $selected $count ||
                      _zle_picker_page -1 $selected $count
                    selected=$REPLY
                  else
                    zle beep
                  fi
                  ;;
                ('[3')
                  suffix=''
                  IFS= read -r -t 0.1 -k 1 suffix
                  if [[ $suffix == '~' && -n $query ]]; then
                    _ZLE_PICKER_INSPECT_FOCUS=0
                    query=${query[1,-2]}
                    selected=1
                  fi
                  ;;
                ('[2')
                  suffix=''
                  if IFS= read -r -t 0.1 -k 3 suffix && [[ $suffix == '00~' ]] &&
                     _zle_picker_read_bracketed_paste; then
                    # Consume the whole paste even in the guide: its payload
                    # may contain Enter, digits or Escape, never action keys.
                    if (( !_ZLE_PICKER_GUIDE_ACTIVE )); then
                      _ZLE_PICKER_INSPECT_FOCUS=0
                      query+=$REPLY
                      selected=1
                    fi
                  else
                    cancelled=1
                  fi
                  ;;
                (*)
                  cancelled=1
                  ;;
              esac
              ;;
            (*)
              cancelled=1
              ;;
          esac
          ;;
        ([0-9])
          # Shortcuts identify currently visible slots, never hidden results.
          # Exact result values are indexed only after applying the viewport.
          direct_position=0
          if (( _ZLE_PICKER_DIGIT_SELECT && _ZLE_PICKER_INDEXES_VISIBLE && !_ZLE_PICKER_INSPECT_FOCUS )) &&
             [[ -z $query ]]; then
            direct_position=${_ZLE_PICKER_VISIBLE_KEYS[(Ie)$key]}
          fi
          if (( direct_position )); then
            if (( direct_position > _ZLE_PICKER_VISIBLE_COUNT )); then
              zle beep
              continue
            fi
            selected=$(( _ZLE_PICKER_VIEW_OFFSET + direct_position ))
            accepted=1
          else
            _ZLE_PICKER_INSPECT_FOCUS=0
            query+=$key
            selected=1
          fi
          ;;
        (*)
          if [[ $key == [[:print:]] ]]; then
            _ZLE_PICKER_INSPECT_FOCUS=0
            query+=$key
            selected=1
          else
            zle beep
          fi
          ;;
      esac
    done

    if (( accepted )); then
      _ZLE_PICKER_ACCEPTED=1
      _ZLE_PICKER_SELECTED_VALUE=${_ZLE_PICKER_RESULTS[selected]-}
      [[ $_ZLE_PICKER_ACTION == query ]] && _ZLE_PICKER_SELECTED_VALUE=$query
      _ZLE_PICKER_BOOKMARK=("$query" "$selected" "$_ZLE_PICKER_VIEW_OFFSET")
      _ZLE_PICKER_BOOKMARK_FOCUS=$_ZLE_PICKER_INSPECT_FOCUS
      (( copy_requested )) && _ZLE_PICKER_ACTION='copy'
    fi
  } always {
    _ZLE_PICKER_ACTIVE=0
    _zle_picker_document_bookmark
    region_highlight=("${(@)region_highlight:#*memo=my-zsh-picker}")
    _ZLE_PICKER_POSTDISPLAY=''
    _ZLE_PICKER_QUERY=''
    _ZLE_PICKER_GUIDE_ACTIVE=0
    _ZLE_PICKER_GUIDE_OFFSET=0
    _ZLE_PICKER_QUERY_ROW=''
    _ZLE_PICKER_TITLEBAR=''
    _ZLE_PICKER_TITLEBAR_META_START=-1
    _ZLE_PICKER_SUBTITLE_ROW=''
    _ZLE_PICKER_QUERY_START=0
    _ZLE_PICKER_QUERY_END=0
    _ZLE_PICKER_SELECTED=0
    _ZLE_PICKER_DIGIT_SELECT=0
    _ZLE_PICKER_COPY_ENABLED=0
    _ZLE_PICKER_HIERARCHY_ENABLED=0
    _ZLE_PICKER_REFRESH_ENABLED=0
    _ZLE_PICKER_DIRECTORY_ACTIONS=0
    _ZLE_PICKER_INDEXES_VISIBLE=0
    _ZLE_PICKER_VIEW_LIMIT=20
    _ZLE_PICKER_VIEW_OFFSET=0
    _ZLE_PICKER_HAS_MORE=0
    _ZLE_PICKER_VISIBLE_KEYS=()
    _ZLE_PICKER_RESULTS=()
    _ZLE_PICKER_LABELS=()
    _ZLE_PICKER_RESULT_INDEXES=()
    _ZLE_PICKER_INSPECT_FOCUS=0
    _ZLE_PICKER_INSPECT_OFFSET=0
    _ZLE_PICKER_INSPECT_KEY=''
    _ZLE_PICKER_INSPECT_WIDTH=0
    _ZLE_PICKER_INSPECT_LINES=()
    _ZLE_PICKER_INSPECT_ROLES=()
    _ZLE_PICKER_INSPECT_SOURCE_LINES=()
  }

  if (( aborted )); then
    zle .send-break
    return 130
  fi
  (( accepted ))
}

# Public commands launch the same picker through a short-lived nested ZLE.
# The editor owns this lifecycle so navigation and search peers can detect it
# at runtime without depending on each other or duplicating terminal handling.
_zle_picker_widget() {
  if [[ -n ${_zle_picker_session_callback:-} ]]; then
    _zle_picker_screen_session "$_zle_picker_session_callback"
    _zle_picker_session_status=$?
  else
    _zle_picker_loop "${_zle_picker_start_query:-}" "${_ZLE_PICKER_RUN_LIMIT:-10}" \
      "${_zle_picker_start_index:-1}" "${_zle_picker_start_offset:-0}"
  fi
}

_zle_picker_line_init() {
  emulate -L zsh

  [[ $_ZLE_PICKER_BOOTSTRAP == compozsh-picker ]] || return 0
  _ZLE_PICKER_BOOTSTRAP=''
  zle compozsh-picker
  zle .accept-line
}

_zle_picker_run() {
  emulate -L zsh

  local raw_limit=${1:-10} picker_buffer=''
  local _zle_picker_start_query=${2:-} _zle_picker_start_index=${3:-1}
  local _zle_picker_start_offset=${4:-0}
  # Optional internal controller for several views in one nested editor.
  # Scoped here so it cannot leak into a final cd/chpwd or application action.
  local _zle_picker_session_callback=${5:-}
  local -i _zle_picker_session_status=1
  [[ $raw_limit == <-> ]] || raw_limit=10
  (( raw_limit < 1 )) && raw_limit=1
  (( raw_limit > 20 )) && raw_limit=20

  _ZLE_PICKER_RUN_LIMIT=$raw_limit
  _ZLE_PICKER_BOOTSTRAP='compozsh-picker'
  if ! vared picker_buffer; then
    _ZLE_PICKER_BOOTSTRAP=''
    return 2
  fi
  _ZLE_PICKER_BOOTSTRAP=''
  [[ -n ${_zle_picker_session_callback:-} ]] && return $_zle_picker_session_status
  (( _ZLE_PICKER_ACCEPTED )) && return 0
  return 1
}

zle -N compozsh-picker _zle_picker_widget
zle -N compozsh-picker-redraw _zle_picker_redraw

_history_fuzzy_search_widget() {
  emulate -L zsh

  local original_buffer=$BUFFER
  local _ZLE_PICKER_INSPECT_ACTION=insert _ZLE_PICKER_CANCEL_LABEL=''
  local _ZLE_PICKER_SUBTITLE='Commands from this shell history'
  # Capture once: direct reads of the special history parameter become costly
  # deep in a large history. Native associative lookups keep paging predictable.
  local -A _history_search_source=( "${(@kv)history}" )
  _ZLE_PICKER_TITLE='History'
  _ZLE_PICKER_BROWSE_LABEL='recent commands'
  _ZLE_PICKER_EMPTY_LABEL='no matches'
  _ZLE_PICKER_COLLECTOR='_history_search_picker_collect'
  _ZLE_PICKER_DIGIT_SELECT=0

  if _zle_picker_loop "$original_buffer" \
       "${ZSH_HISTORY_SEARCH_MAX_RESULTS:-8}"; then
    BUFFER=$_ZLE_PICKER_SELECTED_VALUE
    CURSOR=${#BUFFER}
  fi
  zle redisplay
}

zle -N history-fuzzy-search _history_fuzzy_search_widget
bindkey '^R' history-fuzzy-search

# Match immediate child directories through the shared picker without scanning
# recursively or invoking external commands. The path fragment already present
# in the command buffer remains a required filter; the picker's own query can
# refine that set further while its empty state keeps direct digits available.
_directory_picker_label_matches() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local label=$1 query=$2 literal='' pattern='(#i)*' character=''
  [[ -n $query ]] || return 0

  _zle_picker_escape_pattern "$query"
  literal=$REPLY
  [[ $label == (#i)${~literal}* || $label == (#i)*${~literal}* ]] && return 0

  for character in "${(s::)query}"; do
    _zle_picker_escape_pattern "$character"
    pattern+="${REPLY}*"
  done
  [[ $label == ${~pattern} ]]
}

_directory_picker_append_matches() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local pattern=$1 required_query=$2
  local -i limit=$3 index=0
  local value='' label=''

  for (( index = 1; index <= ${#_DIRECTORY_PICKER_VALUES}; ++index )); do
    label=${_DIRECTORY_PICKER_LABELS[index]}
    [[ $label == ${~pattern} ]] || continue
    _directory_picker_label_matches "$label" "$required_query" || continue
    value=${_DIRECTORY_PICKER_VALUES[index]}
    (( ${_ZLE_PICKER_RESULTS[(Ie)$value]} )) && continue
    _ZLE_PICKER_RESULTS+=("$value")
    _ZLE_PICKER_LABELS+=("$label")
    (( ${#_ZLE_PICKER_RESULTS} >= limit )) && return 0
  done
}

_directory_picker_collect() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local query=$1 raw_limit=$2 required_query=$_DIRECTORY_PICKER_PATH_QUERY
  local literal='' pattern='(#i)*' character=''
  local -i limit=10 index=0 result_index=0
  typeset -ga _ZLE_PICKER_RESULTS=()
  typeset -ga _ZLE_PICKER_LABELS=()
  typeset -ga _ZLE_PICKER_RESULT_INDEXES=()

  [[ $raw_limit == <-> ]] && limit=$raw_limit
  (( limit < 1 )) && limit=1

  # With no interactive query, rank the path fragment already typed by the
  # user. This keeps the picker query row empty, so visible digits stay direct.
  if [[ -z $query && -n $required_query ]]; then
    query=$required_query
    required_query=''
  fi

  if [[ -z $query ]]; then
    for (( index = 1; index <= ${#_DIRECTORY_PICKER_VALUES}; ++index )); do
      _ZLE_PICKER_RESULTS+=("${_DIRECTORY_PICKER_VALUES[index]}")
      _ZLE_PICKER_LABELS+=("${_DIRECTORY_PICKER_LABELS[index]}")
      (( ${#_ZLE_PICKER_RESULTS} >= limit )) && break
    done
  else
    _zle_picker_escape_pattern "$query"
    literal=$REPLY
    _directory_picker_append_matches "(#i)${literal}*" "$required_query" $limit
    if (( ${#_ZLE_PICKER_RESULTS} < limit )); then
      _directory_picker_append_matches "(#i)*${literal}*" "$required_query" $limit
    fi
    if (( ${#_ZLE_PICKER_RESULTS} < limit )); then
      for character in "${(s::)query}"; do
        _zle_picker_escape_pattern "$character"
        pattern+="${REPLY}*"
      done
      _directory_picker_append_matches "$pattern" "$required_query" $limit
    fi
  fi

  for (( index = 1; index <= ${#_ZLE_PICKER_RESULTS}; ++index )); do
    result_index=$index
    (( result_index == 10 )) && result_index=0
    _ZLE_PICKER_RESULT_INDEXES+=($result_index)
  done
}

# Parse only the exact context where a path is Zsh's command-position AUTO_CD
# candidate. Every ambiguous context returns nonzero so Tab can delegate to the
# native completion widget unchanged.
_directory_picker_prepare() {
  local autocd_enabled=${options[autocd]:-off}
  local internal_navigation=${3:-0}
  local allow_empty=${4:-0}
  emulate -L zsh
  setopt EXTENDED_GLOB

  local buffer=$1 raw_cursor=$2 token='' input_path='' resolved=''
  local base='' insertion_prefix='' entry='' name=''
  local -i cursor=0 prefix_length=0
  local -a words=() entries=()
  _DIRECTORY_PICKER_VALUES=()
  _DIRECTORY_PICKER_LABELS=()
  _DIRECTORY_PICKER_CONTENT_COUNTS=(0 0 0)
  _DIRECTORY_PICKER_FILE_SAMPLE=()
  _DIRECTORY_PICKER_PATH_QUERY=''
  _DIRECTORY_PICKER_LOCATION=''

  [[ ( $autocd_enabled == on || $internal_navigation == 1 ) &&
     $raw_cursor == <-> ]] || return 1
  cursor=$raw_cursor
  (( cursor == ${#buffer} )) || return 1
  [[ -n $buffer && $buffer[1] != [[:space:]] ]] || return 1

  words=( ${(z)buffer} )
  (( ${#words} == 1 )) || return 1
  token=${words[1]}
  input_path=${(Q)token}
  [[ -n $input_path && $input_path != -* &&
     $input_path != *[[:cntrl:]]* ]] || return 1

  # An exact alias, function, builtin, reserved word, or executable wins over a
  # same-named directory, matching Zsh's normal command resolution.
  if [[ $input_path != */* && $input_path != '~' ]]; then
    whence -w -- "$input_path" >/dev/null 2>&1 && return 1
  fi

  if [[ $input_path == '~' ]]; then
    resolved=$HOME
  elif [[ $input_path == '~/'* ]]; then
    resolved=$HOME
    (( ${#input_path} > 2 )) && resolved+="/${input_path[3,-1]}"
  elif [[ $input_path == '~'* ]]; then
    return 1
  else
    resolved=$input_path
  fi

  # A final bare dot is a hidden-name prefix unless the user already typed a
  # trailing slash. Treat `~/.` like native completion, not as `$HOME` itself.
  if [[ -d $resolved && ( $input_path == */ || ${input_path:t} != . ) ]]; then
    base=$resolved
    insertion_prefix="${input_path%/}/"
  else
    base=${resolved:h}
    _DIRECTORY_PICKER_PATH_QUERY=${input_path:t}
    prefix_length=$(( ${#input_path} - ${#_DIRECTORY_PICKER_PATH_QUERY} ))
    (( prefix_length > 0 )) &&
      insertion_prefix=${input_path[1,prefix_length]}
  fi

  [[ -d $base && -r $base && -x $base ]] || return 1
  _DIRECTORY_PICKER_LOCATION=$insertion_prefix

  if (( ${_DIRECTORY_PICKER_SHOW_HIDDEN:--1} == 1 )); then
    entries=("$base"/*(ND))
  elif (( ${_DIRECTORY_PICKER_SHOW_HIDDEN:--1} < 0 )) && [[ $_DIRECTORY_PICKER_PATH_QUERY == .* ]]; then
    entries=("$base"/.*(N))
  else
    entries=("$base"/*(N))
  fi
  for entry in "${entries[@]}"; do
    if [[ -d $entry ]]; then
      name=${entry:t}
      [[ $name != . && $name != .. ]] || continue
      (( ++_DIRECTORY_PICKER_CONTENT_COUNTS[1] ))
      [[ $name != *[[:cntrl:]]* ]] || continue
      _DIRECTORY_PICKER_VALUES+=("${insertion_prefix}${name}/")
      _DIRECTORY_PICKER_LABELS+=("${name}/")
    else
      if [[ -f $entry ]]; then
        (( ++_DIRECTORY_PICKER_CONTENT_COUNTS[2] ))
      else
        (( ++_DIRECTORY_PICKER_CONTENT_COUNTS[3] ))
      fi
      if (( ${#_DIRECTORY_PICKER_FILE_SAMPLE} < 8 )); then
        name=${entry:t}
        [[ -L $entry ]] && _DIRECTORY_PICKER_FILE_SAMPLE+=("  ↗ $name") ||
          _DIRECTORY_PICKER_FILE_SAMPLE+=("  · $name")
      fi
    fi
  done
  (( allow_empty )) && return 0
  (( ${#_DIRECTORY_PICKER_VALUES} )) || return 1

  _directory_picker_collect '' 1
  (( ${#_ZLE_PICKER_RESULTS} ))
}

# Breadcrumbs are presentation only: split on real path separators, retain
# literal component text, and let the shared renderer sanitize and fit it.
_directory_picker_breadcrumb() {
  local location=${1%/}
  [[ -n $location ]] || { REPLY=/; return; }
  REPLY=${location//\// › }
}

# Reconcile the selected value with the freshly captured level. An ordinal can
# change when a sibling is created; a missing selection falls back to row one.
_directory_picker_restore() {
  emulate -L zsh
  local query=$1 selected=$2
  local -i offset=${3:-0} index=0 limit=$(( offset + 11 ))
  if (( ${_DIRECTORY_PICKER_VALUES[(Ie)$selected]} )); then
    # Start with the previously visible prefix. Usually this is one page;
    # only a moved selection needs more ranking of already captured children.
    while true; do
      _directory_picker_collect "$query" $limit
      index=${_ZLE_PICKER_RESULTS[(Ie)$selected]}
      (( index || ${#_ZLE_PICKER_RESULTS} < limit || limit >= ${#_DIRECTORY_PICKER_VALUES} )) && break
      (( limit *= 2 ))
    done
  fi
  (( index )) || { index=1; offset=0; }
  _DIRECTORY_PICKER_RESUME=("$query" "$index" "$offset")
}

# Move between already selected levels without recursively discovering paths.
# A failed transition rebuilds the last usable level so an empty, unreadable,
# or concurrently removed directory cannot strand the active picker.
_directory_picker_transition() {
  emulate -L zsh

  local action=$1 selected_path=$2
  local previous_input=$_DIRECTORY_PICKER_INPUT target=''
  local notice='' selected_name=''
  local query=${_ZLE_PICKER_BOOKMARK[1]-}
  local -i offset=${_ZLE_PICKER_BOOKMARK[3]:-0} transition_status=1
  local -i previous_hidden=${_DIRECTORY_PICKER_SHOW_HIDDEN:--1} allow_empty=0
  REPLY=''

  case $action in
    (descend)
      [[ -n $selected_path ]] || return 1
      _directory_picker_quote "$selected_path"
      target=$REPLY
      allow_empty=1
      ;;
    (parent)
      if (( ! ${#_DIRECTORY_PICKER_STACK} )); then
        _directory_picker_restore "$query" "$selected_path" $offset
        REPLY='already at the starting level'
        return 1
      fi
      target=${_DIRECTORY_PICKER_STACK[-1]}
      allow_empty=1
      ;;
    (toggle-hidden)
      target=$previous_input
      _DIRECTORY_PICKER_SHOW_HIDDEN=$(( previous_hidden != 1 ))
      allow_empty=1
      ;;
    (*)
      REPLY='unsupported directory-picker action'
      return 2
      ;;
  esac

  if _directory_picker_prepare "$target" ${#target} 1 $allow_empty; then
    if [[ $action == descend ]]; then
      _DIRECTORY_PICKER_STACK+=("$previous_input")
      _DIRECTORY_PICKER_QUERIES+=("$query")
      _DIRECTORY_PICKER_SELECTIONS+=("$selected_path")
      _DIRECTORY_PICKER_OFFSETS+=($offset)
      _DIRECTORY_PICKER_RESUME=('' 1 0)
    elif [[ $action == parent ]]; then
      _directory_picker_restore "${_DIRECTORY_PICKER_QUERIES[-1]-}" \
        "${_DIRECTORY_PICKER_SELECTIONS[-1]-}" "${_DIRECTORY_PICKER_OFFSETS[-1]:-0}"
      _DIRECTORY_PICKER_STACK[-1]=()
      _DIRECTORY_PICKER_QUERIES[-1]=()
      _DIRECTORY_PICKER_SELECTIONS[-1]=()
      _DIRECTORY_PICKER_OFFSETS[-1]=()
    else
      _directory_picker_restore "$query" "$selected_path" $offset
    fi
    _DIRECTORY_PICKER_INPUT=$target
    REPLY=''
    return 0
  fi

  _DIRECTORY_PICKER_SHOW_HIDDEN=$previous_hidden
  if [[ $action == descend ]]; then
    selected_name=${${selected_path%/}:t}
    notice="no visible child directories in ${selected_name}/"
  else
    notice='the previous directory level is unavailable'
  fi
  _directory_picker_prepare "$previous_input" ${#previous_input} 1 ||
    transition_status=2
  _directory_picker_restore "$query" "$selected_path" $offset
  REPLY=$notice
  return $transition_status
}

_directory_picker_quote() {
  emulate -L zsh

  local input_path=$1 remainder=''
  if [[ $input_path == '~/'* ]]; then
    if (( ${#input_path} > 2 )); then
      remainder=${input_path[3,-1]}
      REPLY="~/${(q)remainder}"
    else
      REPLY='~/'
    fi
  else
    REPLY=${(q)input_path}
  fi
}

# Expand only our literal home spelling, never shell source or named dirs.
_directory_browser_absolute() {
  local value=${1:-.}
  [[ $value == '~/'* ]] && value="$HOME/${value[3,-1]}"
  [[ $value == '~' ]] && value=$HOME
  [[ $value == /* ]] || value="$PWD/$value"
  REPLY=${value:a}
}

# Explicit Ctrl-O snapshot. Y stops enumeration at 41 directory entries before
# sorting; the first 40 filesystem-order names are a sample, never a count of
# the whole folder. No file content is opened and no descendant is traversed.
_directory_browser_preview() {
  emulate -L zsh
  local value=$1 entry='' name='' kind=''
  local -a entries=() lines=('Contents snapshot' 'One level · names only' '')
  local -i count=0
  _directory_browser_absolute "$value"
  value=$REPLY
  if [[ ! -d $value || ! -r $value || ! -x $value ]]; then
    REPLY=$'Contents snapshot\n\nUnavailable: cannot read this folder.'
    return 0
  fi
  if (( _DIRECTORY_PICKER_SHOW_HIDDEN == 1 )); then
    entries=("$value"/*(NDY41))
  else
    entries=("$value"/*(NY41))
  fi
  for entry in "${entries[@][1,40]}"; do
    name=${entry:t} kind='·'
    if [[ -L $entry ]]; then
      kind='↗'
    elif [[ -d $entry ]]; then
      kind='▸' name+=/
    fi
    lines+=("  $kind ${(V)name}")
    (( ++count ))
  done
  (( count )) || lines+=('  No visible entries.')
  (( ${#entries} > 40 )) && lines+=('' 'Limits: first 40 entries; use → to browse.')
  REPLY=${(F)lines}
}

# The right pane changes from captured text only. Highlight movement and
# filtering never call the filesystem preview provider.
_directory_browser_collect() {
  _directory_picker_collect "$@"
  local value='' name='' summary='' label=''
  local -i index=0 remaining=0
  _ZLE_PICKER_EMPTY_LINES=()
  _ZLE_PICKER_INSPECT_FALLBACK=''
  _ZLE_PICKER_INSPECT_TEXTS=()
  if (( !${#_ZLE_PICKER_RESULTS} )); then
    local -a nouns=(directory file 'other entry') plurals=(directories files 'other entries')
    for index in 1 2 3; do
      (( index == 3 && !_DIRECTORY_PICKER_CONTENT_COUNTS[index] )) && continue
      label=$nouns[index]
      (( _DIRECTORY_PICKER_CONTENT_COUNTS[index] == 1 )) || label=$plurals[index]
      [[ -n $summary ]] && summary+=' · '
      summary+="${_DIRECTORY_PICKER_CONTENT_COUNTS[index]} $label"
    done
    if [[ -n $1 || -n $_DIRECTORY_PICKER_PATH_QUERY ]]; then
      label='No directories match this filter'
    elif (( _DIRECTORY_PICKER_CONTENT_COUNTS[1] )); then
      label='No selectable directories'
    elif (( _DIRECTORY_PICKER_CONTENT_COUNTS[2] + _DIRECTORY_PICKER_CONTENT_COUNTS[3] )); then
      label='No child directories'
    else
      label='No visible entries'
    fi
    _ZLE_PICKER_EMPTY_LINES=("$label" "Visible contents · $summary" '')
    if (( ${#_DIRECTORY_PICKER_FILE_SAMPLE} )); then
      label='Files here · names only'
      (( _DIRECTORY_PICKER_CONTENT_COUNTS[3] )) && label='Files / other entries here · names only'
      _ZLE_PICKER_EMPTY_LINES+=("$label" "${_DIRECTORY_PICKER_FILE_SAMPLE[@]}")
      remaining=$(( _DIRECTORY_PICKER_CONTENT_COUNTS[2] + _DIRECTORY_PICKER_CONTENT_COUNTS[3] - ${#_DIRECTORY_PICKER_FILE_SAMPLE} ))
      (( remaining )) && _ZLE_PICKER_EMPTY_LINES+=("  … $remaining more")
      _ZLE_PICKER_EMPTY_LINES+=('')
    fi
    if [[ -n $1 ]]; then
      _ZLE_PICKER_EMPTY_LINES+=('Clear Search with Ctrl-U to see directories.')
    elif [[ -n $_DIRECTORY_PICKER_PATH_QUERY ]]; then
      _ZLE_PICKER_EMPTY_LINES+=('The typed path prefix also filters directories.')
    fi
    _ZLE_PICKER_EMPTY_LINES+=('Ctrl-O previews this folder · Ctrl-X actions')
    value=${_DIRECTORY_PICKER_LOCATION:-./}
    if [[ $value == "$_directory_browser_preview_value" ]]; then
      _ZLE_PICKER_INSPECT_FALLBACK=$value
      _ZLE_PICKER_INSPECT_TEXTS[$value]=$_directory_browser_preview_text
    fi
  fi
  for value in "${_ZLE_PICKER_RESULTS[@]}"; do
    name=${${value%/}:t}
    if [[ $value == "$_directory_browser_preview_value" ]]; then
      _ZLE_PICKER_INSPECT_TEXTS[$value]=$_directory_browser_preview_text
    else
      _ZLE_PICKER_INSPECT_TEXTS[$value]="${(V)name}/"$'\nFolder\n\n  Ctrl-O  Preview contents\n  → / Tab Enter folder\n  Ctrl-X  Folder actions'
    fi
  done
}

_directory_browser_pick() {
  local limit=$1
  shift
  _zle_picker_loop "${1:-}" "$limit" "${2:-1}" "${3:-0}"
}

_directory_browser_actions_collect() {
  local query=$1 value='' label=''
  local -i limit=$2 index=0
  _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
  for value in "${_directory_action_values[@]}"; do
    (( ++index ))
    label=${_directory_action_labels[index]}
    _directory_picker_label_matches "$label" "$query" || continue
    _ZLE_PICKER_RESULTS+=("$value") _ZLE_PICKER_LABELS+=("$label")
    _ZLE_PICKER_RESULT_INDEXES+=(${#_ZLE_PICKER_RESULTS})
    (( ${#_ZLE_PICKER_RESULTS} >= limit )) && break
  done
  return 0
}

_directory_browser_actions() {
  emulate -L zsh
  local _ZLE_PICKER_SEARCH_ACTION='' _ZLE_PICKER_QUERY_LABEL='Filter actions'
  local -i _zle_picker_start_focus=0
  local target=$1 mode=$2 current=${_DIRECTORY_PICKER_LOCATION:-./} target_kind=${3:-directory}
  local selected_group='Selected folder' target_path=''
  local primary_label='Insert path' action='' group='' action_target=''
  local -i index=0
  [[ $mode == cd ]] && primary_label='Change directory'
  local _ZLE_PICKER_TITLE='Folder actions' _ZLE_PICKER_SUBTITLE="Current: $current"
  if [[ -n $target && $target_kind != directory ]]; then
    _ZLE_PICKER_TITLE='Path actions'
    selected_group='Selected file'
    [[ $target_kind == link ]] && selected_group='Selected link'
  fi
  local _ZLE_PICKER_BROWSE_LABEL='Grouped by target · Go to changes context' _ZLE_PICKER_EMPTY_LABEL='no matching actions'
  local _ZLE_PICKER_INSPECT_ACTION=apply _ZLE_PICKER_CANCEL_LABEL=back
  local _ZLE_PICKER_INSPECT_TITLE=Action
  local _ZLE_PICKER_COLLECTOR=_directory_browser_actions_collect
  local -i _ZLE_PICKER_DIRECTORY_ACTIONS=0 _ZLE_PICKER_HIERARCHY_ENABLED=0
  local -i _ZLE_PICKER_DIGIT_SELECT=1 _ZLE_PICKER_COPY_ENABLED=0
  local -i _ZLE_PICKER_WORKSPACE_ACTIONS=0
  local -a _ZLE_PICKER_TRAIL=() _directory_action_values=() _directory_action_labels=()
  local -a _ZLE_PICKER_EMPTY_LINES=()
  local _ZLE_PICKER_INSPECT_FALLBACK=''
  local -A _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  # Keep each group contiguous. Prefixes travel with filtered/paged rows; they
  # are ordinary captured labels, never fake selectable section headings.
  if [[ -n $target ]]; then
    _ZLE_PICKER_SUBTITLE+=" · Selected: $target"
    if [[ $target_kind == directory ]]; then
      _directory_action_values+=(select) _directory_action_labels+=("$primary_label")
      if [[ $mode != insert ]]; then
        _directory_action_values+=(insert) _directory_action_labels+=('Insert path into command line')
      else
        _directory_action_values+=(cd) _directory_action_labels+=('Change directory')
      fi
    else
      _directory_action_values+=(insert) _directory_action_labels+=('Insert path into command line')
      if [[ $target_kind == link ]]; then
        _directory_browser_absolute "$target"
        target_path=$REPLY
        if [[ -d $target_path ]] && (( ${+functions[_file_search_apply]} )); then
          _directory_action_values+=(enter-link) _directory_action_labels+=('Enter linked directory')
        fi
      fi
    fi
    if [[ -n $_directory_browser_clipboard ]]; then
      _directory_action_values+=(copy) _directory_action_labels+=('Copy absolute path')
    fi
    if [[ -n $_directory_browser_open ]]; then
      if (( ${+functions[_file_search_apply]} )) &&
         [[ $target_kind != link || -f $target_path || -d $target_path ]]; then
        _directory_action_values+=(open) _directory_action_labels+=('Open with default app')
      fi
      _directory_action_values+=(reveal) _directory_action_labels+=('Reveal in Finder')
    fi
  fi
  _directory_action_values+=(current) _directory_action_labels+=("$primary_label")
  if [[ $mode == insert ]]; then
    _directory_action_values+=(current-cd) _directory_action_labels+=('Change directory')
  fi
  if [[ -z $target ]]; then
    target=$current
    if [[ $mode != insert ]]; then
      _directory_action_values+=(insert) _directory_action_labels+=('Insert path into command line')
    fi
    if [[ -n $_directory_browser_clipboard ]]; then
      _directory_action_values+=(copy) _directory_action_labels+=('Copy absolute path')
    fi
    if [[ -n $_directory_browser_open ]]; then
      if (( ${+functions[_file_search_apply]} )); then
        _directory_action_values+=(open) _directory_action_labels+=('Open with default app')
      fi
      _directory_action_values+=(reveal) _directory_action_labels+=('Reveal in Finder')
    fi
  fi
  if (( ${_FILES_WORKSPACE:-0} )); then
    _directory_action_values+=(view-browse) _directory_action_labels+=('Browse children')
    if (( ${+functions[_file_search_choose]} )); then
      _directory_action_values+=(search-local) _directory_action_labels+=('Search filesystem below this folder')
      if (( ${+commands[git]} )); then
        _directory_action_values+=(search-git) _directory_action_labels+=('Search Git files below this folder')
      fi
      if [[ $OSTYPE == darwin* ]] && (( ${+commands[mdfind]} )); then
        _directory_action_values+=(search-spotlight) _directory_action_labels+=('Search Spotlight index below this folder')
      fi
    fi
    if (( ${+functions[_directory_recents_choose]} )); then
      _directory_action_values+=(view-recents) _directory_action_labels+=('Recent directories (this shell)')
    fi
  fi
  for action in "${_directory_action_values[@]}"; do
    (( ++index ))
    group='Current folder' action_target=$current
    case $action in
      (view-recents) group='Go to' ;;
      (select|insert|cd|copy|open|reveal|enter-link)
        [[ -n $1 ]] && { group=$selected_group; action_target=$target; } ;;
    esac
    _ZLE_PICKER_INSPECT_TEXTS[$action]="$group"$'\n\n'"$action_target"
    case $action in
      (open) _ZLE_PICKER_INSPECT_TEXTS[$action]+=$'\n\nOpen with the registered macOS app. This may launch an app; open only items you trust.' ;;
      (reveal) _ZLE_PICKER_INSPECT_TEXTS[$action]+=$'\n\nSelect this exact item in Finder.' ;;
      (enter-link) _ZLE_PICKER_INSPECT_TEXTS[$action]+=$'\n\nFollow this symbolic link and change directory.' ;;
    esac
    if [[ $action == view-recents ]]; then
      _ZLE_PICKER_INSPECT_TEXTS[$action]=$'Go to\n\nVisited locations from this shell directory stack.\nChoosing this view does not change directory.'
    fi
    _directory_action_labels[index]="$group · ${_directory_action_labels[index]}"
  done
  _directory_browser_pick 10 || return $?
  _ZLE_PICKER_ACTION=$_ZLE_PICKER_SELECTED_VALUE
  [[ $_ZLE_PICKER_ACTION == current ]] && target=$current
  [[ $_ZLE_PICKER_ACTION == current ]] && _ZLE_PICKER_ACTION=select
  if [[ $_ZLE_PICKER_ACTION == current-cd ]]; then
    target=$current
    _ZLE_PICKER_ACTION=cd
  fi
  _ZLE_PICKER_SELECTED_VALUE=$target
}

# Called by path Tab or the Recents widget. Capture between input loops while the
# shared screen remains owned, then dispatch the final action after cleanup.
_directory_browser_session() {
  local entry=$1 mode=$2 runner=$3
  local argument_prefix=${5:-}
  local _FILES_ORIGIN=${4:-browse} _FILES_VIEW=${4:-browse}
  local -a _FILES_RECENTS_BOOKMARK=('' 1 0)
  local -i _FILES_WORKSPACE=1 _ZLE_PICKER_WORKSPACE_ACTIONS=1
  # Per-invocation state never becomes a persistent directory index or a
  # dependency for another picker. -1 preserves native dot-prefix discovery.
  local -i _DIRECTORY_PICKER_SHOW_HIDDEN=-1
  local -a _DIRECTORY_PICKER_QUERIES=() _DIRECTORY_PICKER_SELECTIONS=() _DIRECTORY_PICKER_OFFSETS=()
  local -a _DIRECTORY_PICKER_RESUME=('' 1 0)
  local -a _DIRECTORY_PICKER_VALUES=() _DIRECTORY_PICKER_LABELS=() _DIRECTORY_PICKER_STACK=()
  local -a _DIRECTORY_PICKER_CONTENT_COUNTS=(0 0 0) _DIRECTORY_PICKER_FILE_SAMPLE=()
  local _DIRECTORY_PICKER_INPUT='' _DIRECTORY_PICKER_LOCATION='' _DIRECTORY_PICKER_PATH_QUERY=''
  local _ZLE_PICKER_SUBTITLE='' _ZLE_PICKER_INSPECT_ACTION=$mode _ZLE_PICKER_CANCEL_LABEL=''
  local _ZLE_PICKER_INSPECT_TITLE='Preview'
  local _ZLE_PICKER_INSPECT_EXPAND_KEY=''
  local -a _ZLE_PICKER_TRAIL=() _ZLE_PICKER_EMPTY_LINES=()
  local _ZLE_PICKER_INSPECT_FALLBACK=''
  local -A _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  # Inspect AUTO_CD before `emulate` localizes the widget's option state.
  # Explicit path arguments and internal navigation do not require AUTO_CD.
  local -i internal=0
  [[ $runner == command || -n $argument_prefix ]] && internal=1
  if [[ $_FILES_ORIGIN != recents ]] && ! _directory_picker_prepare "$entry" ${#entry} $internal 1; then
    return 3
  fi
  if [[ -n $argument_prefix && -n $_DIRECTORY_PICKER_PATH_QUERY ]]; then
    # Existing files and prefixes with no directory matches keep native file
    # completion. An exact empty directory remains a usable Browse scope.
    _directory_browser_absolute "${(Q)entry}"
    [[ -e $REPLY || -L $REPLY ]] && return 3
    _directory_picker_collect '' 1
    (( ${#_ZLE_PICKER_RESULTS} )) || return 3
  fi
  emulate -L zsh

  local _directory_browser_clipboard=${commands[pbcopy]:-} selected_path=''
  local _directory_browser_open=''
  local -i result=0
  [[ $OSTYPE == darwin* ]] && _directory_browser_open=${commands[open]:-}
  local -i result_limit=10

  [[ ${ZSH_DIRECTORY_PICKER_MAX_RESULTS:-10} == <-> ]] &&
    result_limit=${ZSH_DIRECTORY_PICKER_MAX_RESULTS:-10}
  (( result_limit < 1 )) && result_limit=1
  (( result_limit > 10 )) && result_limit=10

  _DIRECTORY_PICKER_INPUT=$entry
  _DIRECTORY_PICKER_STACK=()
  [[ $_DIRECTORY_PICKER_PATH_QUERY == .* ]] && _DIRECTORY_PICKER_SHOW_HIDDEN=1 || _DIRECTORY_PICKER_SHOW_HIDDEN=0
  if [[ $runner == widget ]]; then
    _zle_picker_screen_session _files_workspace_choose
  else
    # One nested line editor for the complete journey, including action menus.
    _zle_picker_run $result_limit '' 1 0 _files_workspace_choose
  fi
  result=$?
  (( result == 0 )) || return $result

  _directory_browser_absolute "$_ZLE_PICKER_SELECTED_VALUE"
  selected_path=$REPLY
  case $_ZLE_PICKER_ACTION in
    (cd)
      builtin cd -- "$selected_path"
      result=$?
      [[ $runner == widget ]] && zle reset-prompt
      return $result ;;
    (open|enter-link)
      (( ${+functions[_file_search_apply]} )) || return 4
      _file_search_apply "$_ZLE_PICKER_ACTION" "$selected_path" "$_directory_browser_clipboard" "$_directory_browser_open"
      result=$?
      [[ $runner == widget && $_ZLE_PICKER_ACTION == enter-link ]] && zle reset-prompt
      return $result ;;
    (copy)
      [[ -x $_directory_browser_clipboard ]] &&
        print -rn -- "$selected_path" | command "$_directory_browser_clipboard" || return 4
      [[ $runner == widget ]] && zle -M 'Copied path.'
      return 0 ;;
    (reveal)
      [[ -x $_directory_browser_open && ( -e $selected_path || -L $selected_path ) ]] || return 4
      command "$_directory_browser_open" -R -- "$selected_path"
      return $? ;;
    (insert|select)
      if [[ $mode == cd && $_ZLE_PICKER_ACTION == select ]]; then
        builtin cd -- "$selected_path"
        return $?
      fi
      _directory_picker_quote "$_ZLE_PICKER_SELECTED_VALUE"
      if [[ $runner == widget ]]; then
        BUFFER="${argument_prefix}${REPLY}" CURSOR=${#BUFFER}
      else
        print -zr -- "$REPLY"
      fi
      return 0 ;;
  esac
}

# Uses the invoking browser's scoped snapshots and bookmarks. Every view runs
# in the same ZLE/screen session; only the chosen final action leaves it.
_directory_browser_choose() {
  local notice='' location='' component='' indent='' file_label=''
  local _ZLE_PICKER_QUERY_LABEL='Filter folders' _ZLE_PICKER_SEARCH_ACTION=''
  (( ${+functions[_file_search_choose]} )) && _ZLE_PICKER_SEARCH_ACTION=search-auto
  local _directory_browser_preview_value='' _directory_browser_preview_text=''
  local -a components=() bookmark=()
  local -i result=0 transition_status=0 _zle_picker_start_focus=0 return_focus=0
  while true; do
    _ZLE_PICKER_TITLE='Directory browser'
    _directory_browser_absolute "${_DIRECTORY_PICKER_LOCATION:-.}"
    location=$REPLY
    [[ $location == "$HOME" || $location == "$HOME/"* ]] && location="~${location#$HOME}"
    _directory_picker_breadcrumb "$location"
    _ZLE_PICKER_SUBTITLE=$REPLY
    if [[ -n $_DIRECTORY_PICKER_PATH_QUERY ]]; then
      _ZLE_PICKER_BROWSE_LABEL="matches for ${_DIRECTORY_PICKER_PATH_QUERY}"
    else
      _ZLE_PICKER_BROWSE_LABEL='child directories'
    fi
    [[ -n $notice ]] && _ZLE_PICKER_BROWSE_LABEL=$notice
    if (( _DIRECTORY_PICKER_SHOW_HIDDEN )); then
      _ZLE_PICKER_BROWSE_LABEL='Hidden: on · '"$_ZLE_PICKER_BROWSE_LABEL"
    else
      _ZLE_PICKER_BROWSE_LABEL='Hidden: off · '"$_ZLE_PICKER_BROWSE_LABEL"
    fi
    # File facts came from the same level capture as the directory candidates.
    file_label=files
    (( _DIRECTORY_PICKER_CONTENT_COUNTS[2] == 1 )) && file_label=file
    _ZLE_PICKER_BROWSE_LABEL+=" · ${_DIRECTORY_PICKER_CONTENT_COUNTS[2]} $file_label"
    _ZLE_PICKER_EMPTY_LABEL='no matching directories'
    _ZLE_PICKER_COLLECTOR='_directory_browser_collect'
    _ZLE_PICKER_DIGIT_SELECT=1
    _ZLE_PICKER_COPY_ENABLED=0
    if [[ -n $_directory_browser_clipboard ]]; then
      _ZLE_PICKER_COPY_ENABLED=1
    fi
    _ZLE_PICKER_HIERARCHY_ENABLED=1
    _ZLE_PICKER_DIRECTORY_ACTIONS=1
    _ZLE_PICKER_TRAIL=(Location)
    components=("${(@s:/:)location}")
    indent=''
    for component in "${components[@]}"; do
      [[ -n $component ]] || component=/
      _ZLE_PICKER_TRAIL+=("$indent$component")
      (( ${#indent} < 6 )) && indent+='  '
    done

    _directory_browser_pick $result_limit "${_DIRECTORY_PICKER_RESUME[@]}"
    result=$?
    return_focus=${_ZLE_PICKER_BOOKMARK_FOCUS:-0}
    _zle_picker_start_focus=0
    (( result == 0 )) || return $result
    _DIRECTORY_PICKER_RESUME=("${_ZLE_PICKER_BOOKMARK[@]}")
    if [[ $_ZLE_PICKER_ACTION == preview ]]; then
      _directory_browser_preview_value=${_ZLE_PICKER_SELECTED_VALUE:-${_DIRECTORY_PICKER_LOCATION:-./}}
      _ZLE_PICKER_INSPECT_EXPAND_KEY=$_directory_browser_preview_value
      _directory_browser_preview "$_directory_browser_preview_value"
      _directory_browser_preview_text=$REPLY
      # Narrow windows and empty lists have no useful side-by-side reading
      # context: open the captured preview directly in the main workspace.
      # The input loop resets focus at entry; use its optional start focus.
      _zle_picker_start_focus=$(( COLUMNS < 100 || !${#_ZLE_PICKER_SELECTED_VALUE} ))
      continue
    elif [[ $_ZLE_PICKER_ACTION == actions ]]; then
      bookmark=("${_ZLE_PICKER_BOOKMARK[@]}")
      _DIRECTORY_PICKER_RESUME=("${bookmark[@]}")
      _directory_browser_actions "$_ZLE_PICKER_SELECTED_VALUE" "$mode"
      result=$?
      if (( result == 1 )); then
        _DIRECTORY_PICKER_RESUME=("${bookmark[@]}")
        _zle_picker_start_focus=$return_focus
        continue
      fi
      (( result == 0 )) || return $result
    fi
    if [[ $_ZLE_PICKER_ACTION == search-* ]]; then
      # Discovery specializes the displayed folder, not its highlighted child.
      # Keep this view alive so Back retains its captured preview and bookmark.
      (( ${+functions[_file_search_choose]} )) || return 4
      _directory_browser_absolute "${_DIRECTORY_PICKER_LOCATION:-./}"
      _file_search_choose "$REPLY" '' "${_ZLE_PICKER_ACTION#search-}"
      result=$?
      if (( result == 1 )); then
        _zle_picker_start_focus=$return_focus
        continue
      fi
      return $result
    fi
    if [[ $_ZLE_PICKER_ACTION == descend ||
          $_ZLE_PICKER_ACTION == parent || $_ZLE_PICKER_ACTION == toggle-hidden ]]; then
      _directory_picker_transition "$_ZLE_PICKER_ACTION" \
        "$_ZLE_PICKER_SELECTED_VALUE"
      transition_status=$?
      if (( transition_status == 0 )); then
        notice=''
        _directory_browser_preview_value='' _directory_browser_preview_text=''
        _ZLE_PICKER_INSPECT_EXPAND_KEY=''
        continue
      elif (( transition_status == 1 )); then
        notice=$REPLY
        continue
      fi
      return 1
    fi

    return 0
  done
}

# A small explicit view switch, not a registration/lifecycle framework. Optional
# providers are detected at invocation; no mode performs work during sourcing.
_files_workspace_choose() {
  local -i result=0
  local root='' target=''
  while true; do
    _ZLE_PICKER_WORKSPACE_ACTIONS=1
    case $_FILES_VIEW in
      (browse)
        if [[ -z $_DIRECTORY_PICKER_LOCATION ]]; then
          _directory_picker_prepare "$_DIRECTORY_PICKER_INPUT" ${#_DIRECTORY_PICKER_INPUT} 1 1 || return 4
        fi
        _directory_browser_choose ;;
      (recents)
        (( ${+functions[_directory_recents_choose]} )) || return 4
        _directory_recents_choose ;;
      (search-*)
        (( ${+functions[_file_search_choose]} )) || return 4
        _directory_browser_absolute "${_DIRECTORY_PICKER_LOCATION:-./}"
        root=$REPLY
        _file_search_choose "$root" '' "${_FILES_VIEW#search-}" ;;
    esac
    result=$?
    if (( result == 1 )) && [[ $_FILES_VIEW != $_FILES_ORIGIN ]]; then
      _FILES_VIEW=$_FILES_ORIGIN
      continue
    fi
    (( result == 0 )) || return $result
    case $_ZLE_PICKER_ACTION in
      (view-recents) _FILES_VIEW=recents ;;
      (view-browse) _FILES_VIEW=browse ;;
      (search-*) _FILES_VIEW=$_ZLE_PICKER_ACTION ;;
      (browse)
        target="${_ZLE_PICKER_SELECTED_VALUE%/}/"
        _directory_picker_quote "$target"
        target=$REPLY
        _directory_picker_prepare "$target" ${#target} 1 1 || return 4
        _DIRECTORY_PICKER_INPUT=$target
        _DIRECTORY_PICKER_STACK=() _DIRECTORY_PICKER_QUERIES=()
        _DIRECTORY_PICKER_SELECTIONS=() _DIRECTORY_PICKER_OFFSETS=()
        _DIRECTORY_PICKER_RESUME=('' 1 0)
        _FILES_VIEW=browse ;;
      (*) return 0 ;;
    esac
  done
}

# Paint once before a synchronous capture, keeping cached status resizeable.
# No extra input loop, timer, worker or screen session. Provider work remains
# outside the active picker; caller-owned cleanup also covers interruptions.
_zle_picker_capture() {
  emulate -L zsh
  if ! zle; then
    shift 3
    "$@"
    return $?
  fi
  local _ZLE_PICKER_TITLE=$1 _ZLE_PICKER_SUBTITLE=$2 _ZLE_PICKER_QUERY=$3
  shift 3
  local _ZLE_PICKER_QUERY_LABEL=Query _ZLE_PICKER_BROWSE_LABEL=${_ZLE_PICKER_BUSY_LABEL:-Searching…}
  local _ZLE_PICKER_INSPECT_FALLBACK=''
  local -i _ZLE_PICKER_BUSY=1 _ZLE_PICKER_ACTIVE=0 _ZLE_PICKER_GUIDE_ACTIVE=0
  local -i _ZLE_PICKER_SELECTED=0 _ZLE_PICKER_INSPECT_FOCUS=0
  local -i _ZLE_PICKER_VIEW_OFFSET=0 _ZLE_PICKER_VIEW_LIMIT=10 _ZLE_PICKER_HAS_MORE=0
  local -a _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
  local -a _ZLE_PICKER_TRAIL=() _ZLE_PICKER_EMPTY_LINES=(
    'Waiting for the selected source to return results'
    'The scope and query above remain unchanged.'
    'Search is synchronous; protected folders or mounted drives may delay it.')
  (( ${#_ZLE_PICKER_BUSY_LINES} )) && _ZLE_PICKER_EMPTY_LINES=("${_ZLE_PICKER_BUSY_LINES[@]}")
  local -A _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  _zle_picker_render "$_ZLE_PICKER_QUERY" 0
  _zle_picker_show || return $?
  "$@"
}

# Query entry uses the same editor and renderer. Enter submits literal text;
# movement, typing and resize cannot trigger discovery.
_zle_picker_query_collect() {
  _ZLE_PICKER_RESULTS=() _ZLE_PICKER_LABELS=() _ZLE_PICKER_RESULT_INDEXES=()
}

_zle_picker_read_query() {
  local _ZLE_PICKER_TITLE=$1 _ZLE_PICKER_SUBTITLE=$2
  local _ZLE_PICKER_QUERY_LABEL='Search descendants' _ZLE_PICKER_SEARCH_ACTION=''
  local -i _zle_picker_start_focus=0
  local _ZLE_PICKER_INSPECT_ACTION=search _ZLE_PICKER_CANCEL_LABEL=back
  local _ZLE_PICKER_BROWSE_LABEL='Enter fragments, then press Return to search'
  local _ZLE_PICKER_COLLECTOR=_zle_picker_query_collect
  local _ZLE_PICKER_INSPECT_FALLBACK=''
  local -i _ZLE_PICKER_QUERY_SUBMIT=1 _ZLE_PICKER_WORKSPACE_ACTIONS=0
  local -i _ZLE_PICKER_DIRECTORY_ACTIONS=0 _ZLE_PICKER_HIERARCHY_ENABLED=0
  local -i _ZLE_PICKER_COPY_ENABLED=0 _ZLE_PICKER_DIGIT_SELECT=0
  local -A _ZLE_PICKER_INSPECT_TEXTS=() _ZLE_PICKER_CONTEXTS=() _ZLE_PICKER_ACCEPT_LABELS=()
  local -a _ZLE_PICKER_TRAIL=() _ZLE_PICKER_EMPTY_LINES=(
    'Search descendants of the displayed folder'
    'Space-separated fragments may match in any order, case-insensitively.'
    'Each fragment may abbreviate characters in order. Example: net cli'
    'Spotlight seeds filenames with the longest fragment; use recognizable text.'
    'Filesystem: 20,000 inspected entries; all sources: 2,000 captured matches.'
    'Unreadable/unindexed locations may be absent. Mounted drives may be slow.'
    'After capture, Filter results refines that snapshot. Ctrl-F edits the search.'
    'Ctrl-X in Browse or results chooses another discovery source.')
  _zle_picker_loop "${3:-}" 10
}

_files_recents_widget() {
  if (( ! ${+functions[_directory_recents_choose]} )); then
    zle -M 'Recents unavailable: enable the navigation add-on.'
    return 1
  fi
  _directory_browser_session ./ insert widget recents
  local result=$?
  (( result > 1 )) && zle -M 'Files: the requested action could not be completed.'
  zle redisplay
}

zle -N files-recents _files_recents_widget
# Pair path-led Tab with recall-led Option-Tab (Meta-Tab on the wire).
# Terminal.app needs Option as Meta; Ctrl-Tab belongs to its tab navigation.
# This is a prompt binding only: modal Tab and Escape keep their own meanings.
bindkey '^[^I' files-recents

# Return the untouched command prefix for an explicit path argument, or an
# empty prefix for the session's lone-path parser. This parses text only.
_directory_completion_prefix() {
  emulate -L zsh
  local buffer=$1 token='' input_path='' word=''
  local -a words=( ${(z)buffer} )
  REPLY=''
  (( ${#words} > 1 )) || return 0
  token=${words[-1]}
  input_path=${(Q)token}
  [[ $buffer == *"$token" &&
     $input_path == (/*|./*|../*|'~/'*) &&
     $token != *['$`*?[]{}']* &&
     ( $input_path != '~/'* || $token == '~/'* ) ]] || return 1
  # Operators can put the last word in command/redirection position. Leave
  # those contexts to Zsh rather than inferring an argument from word count.
  for word in "${words[@]}"; do
    [[ $word == [';&|<>()']* ]] && return 1
  done
  REPLY=${buffer[1,$(( ${#buffer} - ${#token} ))]}
  [[ $REPLY == *[[:blank:]] ]]
}

_directory_context_complete_widget() {
  # Preserve caller options for AUTO_CD detection and native completion. The
  # parser localizes its own options; command text stays outside Browse state.
  # Use compinit's expand-or-complete registration: the dotted builtin bypasses
  # its command-specific completion functions.
  (( CURSOR == ${#BUFFER} )) || { zle expand-or-complete; return; }
  local REPLY='' entry=$BUFFER argument_prefix=''
  _directory_completion_prefix "$BUFFER" || { zle expand-or-complete; return; }
  argument_prefix=$REPLY
  [[ -n $argument_prefix ]] && entry=${BUFFER[$(( ${#argument_prefix} + 1 )),-1]}
  _directory_browser_session "$entry" insert widget browse "$argument_prefix"
  local result=$?
  if (( result == 3 )); then
    zle expand-or-complete
  elif (( result > 1 )); then
    zle -M 'Directory browser: the requested action could not be completed.'
  fi
  zle redisplay
}

zle -N directory-context-complete _directory_context_complete_widget
bindkey '^I' directory-context-complete

# Treat / as a word boundary so Option-Backspace edits paths naturally.
WORDCHARS=${WORDCHARS//\//}

# -----------------------------------------------------------------------------
# Native history autosuggestions
# -----------------------------------------------------------------------------

# Suggestions are derived from the live Zsh history and displayed outside the
# editable buffer. They are never part of a command until explicitly accepted.
typeset -g ZSH_AUTOSUGGEST_ENABLED=${ZSH_AUTOSUGGEST_ENABLED:-1}
typeset -gi _ZLE_AUTOSUGGEST_SUSPENDED=0
typeset -g _ZLE_AUTOSUGGEST_CACHE_BUFFER=''
typeset -g _ZLE_AUTOSUGGEST_CACHE_HISTORY=''
typeset -g _ZLE_AUTOSUGGEST_CACHE_FULL=''
typeset -g _ZLE_AUTOSUGGEST_SUFFIX=''
typeset -g _ZLE_AUTOSUGGEST_DISPLAY=''

_zle_autosuggest_find() {
  emulate -L zsh

  local prefix=$1 entry=''
  local -i event=${HISTCMD:-0} inspected=0
  typeset -g _ZLE_AUTOSUGGEST_CACHE_FULL=''

  # Inspect a fixed recent window without materializing or sorting every
  # matching history key. Numeric attempts are bounded even with sparse keys.
  for (( --event; event > 0 && inspected < 512; --event, ++inspected )); do
    entry=${history[$event]-}
    [[ $entry == "$prefix"* && $entry != "$prefix" ]] || continue
    # Tabs, newlines, escapes, and other control bytes are valid history, but
    # writing them to POSTDISPLAY could alter the terminal rather than its UI.
    [[ $entry == *[[:cntrl:]]* ]] && continue
    _ZLE_AUTOSUGGEST_CACHE_FULL=$entry
    return 0
  done
  return 1
}

_zle_autosuggest_update() {
  emulate -L zsh

  # Remove only this feature's previous highlight and display. If another
  # widget owns POSTDISPLAY, leave it untouched and stand down for this redraw.
  region_highlight=("${(@)region_highlight:#*memo=my-zsh-autosuggestion}")
  if [[ -n $_ZLE_AUTOSUGGEST_DISPLAY &&
        $POSTDISPLAY == "$_ZLE_AUTOSUGGEST_DISPLAY" ]]; then
    POSTDISPLAY=''
  elif [[ -n $POSTDISPLAY ]]; then
    _ZLE_AUTOSUGGEST_DISPLAY=''
    _ZLE_AUTOSUGGEST_SUFFIX=''
    return 0
  fi
  _ZLE_AUTOSUGGEST_DISPLAY=''
  _ZLE_AUTOSUGGEST_SUFFIX=''

  [[ $ZSH_AUTOSUGGEST_ENABLED == 1 ]] || return 0
  (( !_ZLE_AUTOSUGGEST_SUSPENDED )) || return 0
  (( ${ZLE_RECURSIVE:-0} == 0 && ${REGION_ACTIVE:-0} == 0 &&
     ${SUFFIX_ACTIVE:-0} == 0 && CURSOR == ${#BUFFER} )) || return 0
  [[ -n $BUFFER && $BUFFER != ' '* && $BUFFER != *[[:cntrl:]]* ]] || return 0

  local history_token="${HISTCMD:-0}:${HISTNO:-0}"
  local full='' style=${ZSH_HIGHLIGHT_STYLES[autosuggestion]:-'fg=242'}
  local -i start=0 end=0

  if [[ $history_token == $_ZLE_AUTOSUGGEST_CACHE_HISTORY ]]; then
    if [[ $BUFFER == $_ZLE_AUTOSUGGEST_CACHE_BUFFER ]]; then
      full=$_ZLE_AUTOSUGGEST_CACHE_FULL
    elif [[ $BUFFER == "$_ZLE_AUTOSUGGEST_CACHE_BUFFER"* ]]; then
      if [[ -z $_ZLE_AUTOSUGGEST_CACHE_FULL ]]; then
        full=''
      elif [[ $_ZLE_AUTOSUGGEST_CACHE_FULL == "$BUFFER"* &&
              $_ZLE_AUTOSUGGEST_CACHE_FULL != "$BUFFER" ]]; then
        full=$_ZLE_AUTOSUGGEST_CACHE_FULL
      else
        _zle_autosuggest_find "$BUFFER"
        full=$_ZLE_AUTOSUGGEST_CACHE_FULL
      fi
    else
      _zle_autosuggest_find "$BUFFER"
      full=$_ZLE_AUTOSUGGEST_CACHE_FULL
    fi
  else
    _zle_autosuggest_find "$BUFFER"
    full=$_ZLE_AUTOSUGGEST_CACHE_FULL
  fi

  _ZLE_AUTOSUGGEST_CACHE_BUFFER=$BUFFER
  _ZLE_AUTOSUGGEST_CACHE_HISTORY=$history_token
  _ZLE_AUTOSUGGEST_CACHE_FULL=$full
  [[ -n $full && $full == "$BUFFER"* && $full != "$BUFFER" ]] || return 0

  _ZLE_AUTOSUGGEST_SUFFIX=${full[$(( ${#BUFFER} + 1 )),-1]}
  _ZLE_AUTOSUGGEST_DISPLAY=$_ZLE_AUTOSUGGEST_SUFFIX
  POSTDISPLAY=$_ZLE_AUTOSUGGEST_DISPLAY
  start=$(( ${#PREDISPLAY} + ${#BUFFER} ))
  end=$(( start + ${#POSTDISPLAY} ))
  region_highlight+=(
    "P${start} ${end} ${style} memo=my-zsh-autosuggestion"
  )
}

_zle_autosuggest_reset() {
  emulate -L zsh

  region_highlight=("${(@)region_highlight:#*memo=my-zsh-autosuggestion}")
  if [[ -n $_ZLE_AUTOSUGGEST_DISPLAY &&
        $POSTDISPLAY == "$_ZLE_AUTOSUGGEST_DISPLAY" ]]; then
    POSTDISPLAY=''
  fi
  _ZLE_AUTOSUGGEST_SUSPENDED=0
  _ZLE_AUTOSUGGEST_CACHE_BUFFER=''
  _ZLE_AUTOSUGGEST_CACHE_HISTORY=''
  _ZLE_AUTOSUGGEST_CACHE_FULL=''
  _ZLE_AUTOSUGGEST_SUFFIX=''
  _ZLE_AUTOSUGGEST_DISPLAY=''
}

_zle_autosuggest_is_active() {
  [[ -n $_ZLE_AUTOSUGGEST_SUFFIX &&
     $_ZLE_AUTOSUGGEST_CACHE_BUFFER == "$BUFFER" &&
     $POSTDISPLAY == "$_ZLE_AUTOSUGGEST_DISPLAY" ]] &&
    (( CURSOR == ${#BUFFER} ))
}

_zle_autosuggest_accept_character() {
  if _zle_autosuggest_is_active; then
    BUFFER+="${_ZLE_AUTOSUGGEST_SUFFIX[1]}"
    CURSOR=${#BUFFER}
  else
    zle .forward-char
  fi
}

_zle_autosuggest_accept_word() {
  if _zle_autosuggest_is_active; then
    BUFFER+=$_ZLE_AUTOSUGGEST_SUFFIX
    zle .forward-word
    BUFFER=${BUFFER[1,CURSOR]}
    CURSOR=${#BUFFER}
  else
    zle .forward-word
  fi
}

_zle_autosuggest_accept_all() {
  if _zle_autosuggest_is_active; then
    BUFFER+=$_ZLE_AUTOSUGGEST_SUFFIX
    CURSOR=${#BUFFER}
  else
    zle .end-of-line
  fi
}

zle -N autosuggest-accept-character _zle_autosuggest_accept_character
zle -N autosuggest-accept-word _zle_autosuggest_accept_word
zle -N autosuggest-accept-all _zle_autosuggest_accept_all
_bind_zle_keys autosuggest-accept-character \
  '^F' "${terminfo[kcuf1]:-}" $'\e[C' $'\eOC'
_bind_zle_keys autosuggest-accept-word \
  $'\ef' $'\e[1;3C'
_bind_zle_keys autosuggest-accept-all \
  '^E' "${terminfo[kend]:-}" $'\e[F' $'\eOF' $'\e[4~'
unfunction _bind_zle_keys

autoload -Uz add-zle-hook-widget
add-zle-hook-widget -d line-init _zle_autosuggest_reset 2>/dev/null
add-zle-hook-widget -d line-init _zle_picker_line_init 2>/dev/null
add-zle-hook-widget line-init _zle_autosuggest_reset
(( ${+functions[_zle_picker_line_init]} )) &&
  add-zle-hook-widget line-init _zle_picker_line_init

add-zle-hook-widget -d line-pre-redraw _zle_syntax_highlight 2>/dev/null
add-zle-hook-widget -d line-pre-redraw _zle_autosuggest_update 2>/dev/null
(( ${+functions[_zle_syntax_highlight]} )) &&
  add-zle-hook-widget line-pre-redraw _zle_syntax_highlight
add-zle-hook-widget line-pre-redraw _zle_autosuggest_update

:
